@* A signed-out page: one 22rem column on the page's middle line. The app's mark, the title (the page's h1)
   and its description are centered as one header; the form and anything else under it start at the
   column's edge. End with an AccountFoot for the centered line under it all, such as the way back to sign in. *@
<Container Size="ContainerSize.Xs" MaxWidth="Length.Rem(22)" Gutters="false" MarginTop="new() { Base = 8, Md = 16 }" MarginBottom="new() { Base = 10, Md = 16 }">
    <Column Gap="6">
        <PageHeader Title="@(Title ?? "")" Description="@Description" Size="ControlSize.Lg" Centered>
            <PageHeaderMedia>
                <Anchor Href="" aria-label="Izzy CRM"><Icon Name="Lucide.Handshake" Size="IconSize.Xl2" /></Anchor>
            </PageHeaderMedia>
        </PageHeader>
        @ChildContent
    </Column>
</Container>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
