@page "/Account/AccessDenied"
@* Signed in, so the app shell: the sidebar and your account stay in reach. *@
@layout {{RootNamespace}}.Components.Layout.MainLayout
@inject UserManager<ApplicationUser> Users

<PageTitle>Access denied</PageTitle>

@* Where the app sends someone whose role doesn't cover the page they asked for (the policies are in
   Security/Policies.cs). It says what the page needs and names the admin to ask. *@
<PageCrumbs><BreadcrumbItem>Access denied</BreadcrumbItem></PageCrumbs>

<Column Gap="6">
    <PageHeader Title="Access denied" Description="This area is restricted." />
    <Card>
        <EmptyState Icon="Lucide.ShieldCheck" Status="Status.Warning" TitleLevel="2"
                    Title="@(ForAdmins ? "You need workspace admin access" : "You need access to change records")"
                    Description="@($"Contact {_admin} if you need to {(ForAdmins ? "manage team access or workspace settings" : "add or update customer records")}.")">
            <EmptyStateActions>
                <Button Href="">Back to my day</Button>
            </EmptyStateActions>
        </EmptyState>
    </Card>
</Column>

@code {
    // The page asked for, as the sign-in cookie's redirect gives it.
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    // Settings & team is for admins; the other pages a role can be refused are for people who edit records.
    private bool ForAdmins => ReturnUrl is null || ReturnUrl.StartsWith("/settings", StringComparison.OrdinalIgnoreCase);

    // Who to ask: the workspace's admin by name, or "a workspace admin" when there are several.
    private string _admin = "a workspace admin";

    protected override async Task OnInitializedAsync()
    {
        // Admins who can sign in: not deactivated, and past their invitation.
        var admins = (await Users.GetUsersInRoleAsync(Roles.Admin))
            .Where(u => u.LockoutEnd != DateTimeOffset.MaxValue && u.PasswordHash is not null).ToList();
        if (admins is [{ Name: { Length: > 0 } name }]) _admin = name;
    }
}
