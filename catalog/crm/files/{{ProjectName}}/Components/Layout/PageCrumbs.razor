@* A page's breadcrumbs: in the header on wide screens, at the top of the page on phones, where the
   header has no room for them. Put it first on the page:
   <PageCrumbs><BreadcrumbItem Href="admin/users">Users</BreadcrumbItem><BreadcrumbItem>Maya Chen</BreadcrumbItem></PageCrumbs> *@
<SectionContent SectionName="@Section">
    <Breadcrumb>@ChildContent</Breadcrumb>
</SectionContent>
<Breadcrumb HiddenFrom="Breakpoint.Md">@ChildContent</Breadcrumb>

@code {
    /// <summary>The header's place for them (MainLayout's SectionOutlet).</summary>
    public const string Section = "page-crumbs";

    /// <summary>The BreadcrumbItems, the current page last.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
