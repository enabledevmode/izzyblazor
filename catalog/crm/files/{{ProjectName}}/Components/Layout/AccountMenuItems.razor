@* The account menu's items, under the header avatar on a phone (AccountMenu) and the sidebar's account row on
   wider screens (MainLayout): headed by your email, Settings & team for admins, your account, and Log out,
   which posts AccountMenu's form. *@
<AuthorizeView>
    <MenuGroup Label="@(context.User.Identity?.Name ?? NameClaim.Shown(context.User) ?? "Account")">
        <AuthorizeView Policy="@Policies.ManageUsers" Context="admin">
            <MenuItem Href="settings" Icon="Lucide.Settings2">Settings &amp; team</MenuItem>
        </AuthorizeView>
        <MenuItem Href="Account/Manage" Icon="Lucide.User">Manage account</MenuItem>
    </MenuGroup>
    <MenuDivider />
    <MenuItem Submit Form="logout-form" Icon="Lucide.LogOut">Log out</MenuItem>
</AuthorizeView>
