@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@inject IConfiguration Configuration
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider Auth

@* The CRM's shell: a sidebar the full height of the window, with the brand and the workspace's name at its
   top and the pages under them, each with its count. On wide screens it collapses to an icon rail (the button
   at its top, remembered in a cookie); on phones it's a drawer behind the menu button. The header holds the
   page's breadcrumbs (PageCrumbs) and the color scheme; your account is the row at the sidebar's foot, or the
   header's avatar on a phone. Only the main area scrolls, as in an
   app: the header and sidebar stay where they are. *@
<AppShell ScrollMode="ShellScroll.Main">
    <AppHeader>
        <SidebarToggle HiddenFrom="Breakpoint.Md" />
        <AppBrand Href="" Icon="Lucide.Handshake" Label="Izzy CRM" HiddenFrom="Breakpoint.Md" />
        <Box VisibleFrom="Breakpoint.Md">
            <SectionOutlet SectionName="@PageCrumbs.Section" />
        </Box>
        <Spacer />
        <ColorSchemeSwitch />
        <AccountMenu />
    </AppHeader>

    <AppSidebar FullHeight Collapsible CollapseButton="true" CollapseButtonPosition="VerticalPosition.Top">
        <SidebarHeader>
            <AppBrand Href="" Icon="Lucide.Handshake" Label="Izzy CRM" Description="@_workspace" />
        </SidebarHeader>
        <NavMenu>
            <AuthorizeView Policy="@Policies.ViewRecords">
                <NavLabel>Workspace</NavLabel>
                <NavItem Href="" Match="NavLinkMatch.All" Icon="Lucide.Sun" Badge="@Count(_due)" BadgeVariant="BadgeVariant.Plain">My day</NavItem>
                <NavItem Href="contacts" Icon="Lucide.Users" Badge="@Count(_contacts)" BadgeVariant="BadgeVariant.Plain">Contacts</NavItem>
                <NavItem Href="companies" Icon="Lucide.Building" Badge="@Count(_companies)" BadgeVariant="BadgeVariant.Plain">Companies</NavItem>
                <NavItem Href="deals" Icon="Lucide.Columns3" Badge="@Count(_deals)" BadgeVariant="BadgeVariant.Plain">Deal pipeline</NavItem>
                <NavItem Href="activities" Icon="Lucide.CalendarDays">Activities</NavItem>
                <NavItem Href="reports" Icon="Lucide.ChartNoAxesCombined">Reports</NavItem>
            </AuthorizeView>
        </NavMenu>
        <SidebarFooter>
            <AuthorizeView>
                @* Your account, from Md up; on a phone the header's avatar opens the same menu. *@
                <SidebarAccount Name="@(NameClaim.Shown(context.User) ?? "")"
                                Description="@(context.User.IsInRole(Roles.Admin) ? "Workspace admin" : null)"
                                VisibleFrom="Breakpoint.Md">
                    <AccountMenuItems />
                </SidebarAccount>
            </AuthorizeView>
        </SidebarFooter>
    </AppSidebar>

    @* The page: up to 80rem wide, in the middle of the space beside the sidebar, so on a wide screen it isn't held
       against one edge. The centered column has a 16px gutter each side, so the sides add only what's left of the
       design's 24px from 768px up (16px on a phone). A list page fills the main area (its top element has Grow), and its grid scrolls its own rows. *@
    <AppMain ContentWidth="Length.Rem(80)" PaddingY="new() { Base = 4, Md = 6 }" PaddingX="new() { Base = 0, Md = 2 }">
        <ErrorGuard ShowDetails="DetailedErrors">
            @Body
        </ErrorGuard>
    </AppMain>
</AppShell>

<ToastRegion />

@code {
    private string? _workspace;
    private int _due, _contacts, _companies, _deals;

    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");

    // The counts beside the links: what you have due by the end of today, everyone's contacts and
    // companies, and the deals still open. No count shows for zero.
    protected override async Task OnInitializedAsync()
    {
        var workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        _workspace = workspace?.Name;
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (!user.IsInRole(Roles.Admin) && !user.IsInRole(Roles.Manager) && !user.IsInRole(Roles.Viewer)) return;

        var me = user.UserId();
        var tomorrow = Clock.Today(workspace).AddDays(1).ToDateTime(TimeOnly.MinValue);
        _due = await Db.Activities.CountAsync(a => a.Type == ActivityType.Task && a.Completed == null && a.AssignedToId == me && a.Start < tomorrow);
        _contacts = await Db.Contacts.CountAsync();
        _companies = await Db.Companies.CountAsync();
        _deals = await Db.Deals.CountAsync(d => d.Stage != DealStage.Won && d.Stage != DealStage.Lost);
    }

    private static string? Count(int count) => count == 0 ? null : count.ToString("N0");
}
