@* Settings & team's top, shared by its three pages: the title and the sections, each with its own address
   (/settings, /settings/workspace, /settings/audit). Put it first in the page's column:

   <SettingsHeader />                         Team members
   <SettingsHeader Section="Workspace" />     a section below it: named in the breadcrumbs *@
@if (Section is null)
{
    <PageCrumbs><BreadcrumbItem>Settings &amp; team</BreadcrumbItem></PageCrumbs>
}
else
{
    <PageCrumbs Trail>
        <BreadcrumbItem Href="settings">Settings &amp; team</BreadcrumbItem>
        <BreadcrumbItem>@Section</BreadcrumbItem>
    </PageCrumbs>
}
<PageHeader Title="Settings & team" Description="Manage your workspace and access." />
<TabNav Label="Settings sections">
    <TabLink Href="settings" Label="Team members" Match="NavLinkMatch.All" />
    <TabLink Href="settings/workspace" Label="Workspace" />
    <TabLink Href="settings/audit" Label="Audit log" />
</TabNav>

@code {
    /// <summary>The section's name, on a page below Team members: "Workspace", "Audit log".</summary>
    [Parameter] public string? Section { get; set; }
}
