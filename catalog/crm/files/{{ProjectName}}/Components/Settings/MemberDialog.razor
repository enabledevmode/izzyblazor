@using Microsoft.EntityFrameworkCore
@inject UserAdmin Admin
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject IWebHostEnvironment Environment

@* The team member form, in a dialog over Settings & team: ?dialog=invite-member invites someone by email, and
   ?dialog=edit-member&member={id} changes a member's name, email, role or monthly target. Admin/UserAdmin.cs does
   the work and writes the audit log. It saves and comes back to the list, without the ?dialog. *@
@if (Input is not null && Opened is not null)
{
    var inviting = Opened == InviteId;
    <Dialog Id="@Opened" Title="@(inviting ? "Invite a team member" : $"Edit {_shown}")" CloseOnBackdrop="false">
        <Form Model="Input" FormName="member" OnValidSubmit="SaveAsync">
            @if (inviting)
            {
                <TextBlock Color="Color.Muted">Give a colleague access to @(_workspace?.Name ?? "your workspace").</TextBlock>
            }
            else
            {
                <TextField @bind-Value="Input.Name" Label="Name" autocomplete="off" />
            }
            <TextField @bind-Value="Input.Email" Label="Work email" Type="TextFieldType.Email" autocomplete="off" />
            <RadioGroup @bind-Value="Input.Role" Label="Workspace role" ItemDescription="role => Roles.Summary(role.ToString())" />
            @if (inviting)
            {
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">The invitation gives access to this workspace only.</TextBlock>
            }
            else
            {
                <NumberField @bind-Value="Input.MonthlyTarget" Label="Monthly target" Min="0" Step="1000" StepButtons="StepButtons.None"
                             Hint="What they aim to win each month. Reports measures the team against it.">
                    <StartAddon>@_workspace?.CurrencySymbol</StartAddon>
                </NumberField>
            }
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <Button Submit>@(inviting ? "Create invitation" : "Save changes")</Button>
            </DialogFooter>
        </Form>
    </Dialog>
}

@code {
    /// <summary>The dialogs' ids, for links: <c>?dialog=invite-member</c>, <c>?dialog=edit-member&amp;member={id}</c>.</summary>
    public const string InviteId = "invite-member", EditId = "edit-member";

    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }

    [SupplyParameterFromQuery(Name = "member")] private string? Member { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The member as the form shows them, and as it posts.
    [SupplyParameterFromForm(FormName = "member")] private UserRow? Input { get; set; }

    private Workspace? _workspace;

    // The member's name as the list has it, for the dialog's title.
    private string? _shown;

    // Which of the two the address opens, if either: edit only with a member.
    private string? Opened => Dialog == InviteId ? InviteId : Dialog == EditId && !string.IsNullOrEmpty(Member) ? EditId : null;

    protected override async Task OnParametersSetAsync()
    {
        if (Opened is null) return;
        _workspace ??= await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        var current = Opened == EditId ? (await Admin.ListAsync()).FirstOrDefault(u => u.Id == Member) : null;
        _shown = current?.Shown;

        // A post brings the form's own values; otherwise the member as they are, or a new Viewer.
        Input ??= Opened == EditId ? current : new UserRow();
    }

    private async Task SaveAsync(EditContext form)
    {
        if (Input is null) return;
        if (Opened == InviteId)
        {
            var (link, error) = await Admin.InviteAsync(Input);
            if (error is not null)
            {
                Fail(form, nameof(Input.Email), error);
                return;
            }
            // In development no mail is sent (IdentityNoOpEmailSender), so the toast offers the link itself.
            Toasts.Success($"{Input.Email.Trim()} will get an email with a link to join. It expires in a day.", "Invitation created",
                Environment.IsDevelopment() && link is not null ? new("Open the link", link) : null);
        }
        else
        {
            var me = UserManager.GetUserId((await AuthState).User);
            if (await UserManager.FindByIdAsync(Member ?? "") is not { } user)
            {
                Fail(form, nameof(Input.Email), "This member isn’t here any more.");
                return;
            }
            if (await Admin.UpdateAsync(user, Input, me) is { } why)
            {
                Fail(form, why.Contains("email", StringComparison.OrdinalIgnoreCase) ? nameof(Input.Email) : nameof(Input.Role), why);
                return;
            }
            Toasts.Success($"{Input.Shown} is up to date.", "Member saved");
        }
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["dialog"] = null, ["member"] = null }));
    }

    private static void Fail(EditContext form, string field, string message)
    {
        new ValidationMessageStore(form).Add(form.Field(field), message);
        form.NotifyValidationStateChanged();
    }
}
