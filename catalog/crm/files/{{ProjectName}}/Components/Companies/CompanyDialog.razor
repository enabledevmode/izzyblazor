@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ToastService Toasts

@* The company form, in a dialog over the page that asked for it: a link to that page's own address with
   ?dialog=new-company adds one, and with ?dialog=edit-company edits the page's company. Put one on a page that
   has such a link:

   <CompanyDialog CanEdit="_canEdit" />                     Companies: add
   <CompanyDialog CanEdit="_canEdit" Company="Id" />        a company: edit

   It saves and comes back to the page, without the ?dialog. The fields are checked against Company's attributes,
   which hold the messages (Data/Company.cs); the logo is a PNG or JPG of 2 MB at most (Data/CompanyLogo.cs). *@
@if (CanEdit && Input is not null && Opened is not null)
{
    var adding = Opened == NewId;
    <Dialog Id="@Opened" Title="@(adding ? "New company" : "Edit company")" Size="DialogSize.Lg" CloseOnBackdrop="false">
        <Form Model="Input" FormName="company" Columns="2" OnValidSubmit="SaveAsync">
            @if (adding)
            {
                <TextBlock Color="Color.Muted">Create a shared account for related people and deals.</TextBlock>
            }
            @* The file posts with the form, and SaveAsync reads it from the request. *@
            <Stack ColSpan="GridSpan.Full" Gap="2">
                <FileUpload Name="Logo" Label="Logo" Size="ControlSize.Sm" Accept=".png,.jpg,.jpeg" AcceptText="PNG or JPG · up to 2 MB" MaxFileSize="CompanyLogo.MaxBytes" Errors="_logoProblems">
                    <Preview><Avatar Src="@_logoSrc" Icon="Lucide.BuildingComplex" Size="AvatarSize.Lg" Accent="Accent.Neutral" Square Decorative /></Preview>
                </FileUpload>
                @if (_logoSrc is not null)
                {
                    <Checkbox @bind-Value="_removeLogo" name="RemoveLogo" Label="Remove the logo" />
                }
            </Stack>
            @* autocomplete: a company's name, so the browser doesn't offer the user's own contact details. *@
            <TextField @bind-Value="Input.Name" Label="Company name" autocomplete="organization" />
            <TextField @bind-Value="Input.Website" Label="Website" Placeholder="https://" />
            <Select @bind-Value="Input.Industry" Label="Industry" />
            <Select @bind-Value="Input.Size" Label="Company size" />
            <TextField @bind-Value="Input.City" Label="City" />
            <Select @bind-Value="Input.Country" Label="Country" Items="Data.Company.Countries" />
            <Select @bind-Value="Input.OwnerId" Label="Account owner" Items="_ownerIds" ItemText="id => _owners[id!]" />
            <Select @bind-Value="Input.Status" Label="Status" />
            <TextArea @bind-Value="Input.Notes" Label="Background" Placeholder="Goals, preferences, or background…" ColSpan="GridSpan.Full" />
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <Button Submit>@(adding ? "Create company" : "Save changes")</Button>
            </DialogFooter>
        </Form>
    </Dialog>
}

@code {
    /// <summary>The dialogs' ids, for links: <c>?dialog=new-company</c>, <c>?dialog=edit-company</c>.</summary>
    public const string NewId = "new-company", EditId = "edit-company";

    /// <summary>Whether the reader can add and edit (Policies.EditRecords). Without it there's no dialog.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The company <c>?dialog=edit-company</c> edits: the page's own.</summary>
    [Parameter] public int? Company { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The request: the form posts the logo's file with it.
    [CascadingParameter] private HttpContext? Http { get; set; }

    // The company as the form shows it, and as it posts.
    [SupplyParameterFromForm(FormName = "company")] private Company? Input { get; set; }

    // The logo the company has now, and whether to take it away.
    private string? _logoSrc;
    private bool _removeLogo;

    // The choice of owner: every team member, by name.
    private Dictionary<string, string> _owners = [];
    private List<string?> _ownerIds = [];

    // Which of the two the address opens, if either: edit only on a page with a company.
    private string? Opened => Dialog == NewId ? NewId : Dialog == EditId && Company is not null ? EditId : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!CanEdit || Opened is null) return;
        _owners = (await Db.Users.AsNoTracking().ToListAsync()).ToDictionary(u => u.Id, u => u.Name ?? u.Email ?? "");
        _ownerIds = _owners.OrderBy(o => o.Value).Select(o => (string?)o.Key).ToList();
        var current = Opened == EditId ? await Db.Companies.AsNoTracking().FirstOrDefaultAsync(c => c.Id == Company) : null;
        _logoSrc = current?.LogoSrc;

        // A post brings the form's own values; otherwise the company as it is, or a new one: yours, a prospect,
        // with the first of each list chosen.
        if (Input is not null) return;
        if (Opened == EditId)
        {
            Input = current;
        }
        else
        {
            var me = (await AuthState).User.UserId();
            Input = new Company
            {
                OwnerId = me, Status = CompanyStatus.Prospect, Industry = Industry.DesignTechnology, Size = CompanySize.UpTo10,
                Country = Data.Company.Countries[0],
            };
        }
    }

    // What's wrong with the chosen logo, shown under its field.
    private IReadOnlyList<string>? _logoProblems;

    private async Task SaveAsync(EditContext form)
    {
        if (!CanEdit || Input is null) return;
        var adding = Opened == NewId;

        // The logo, when a file came with the form.
        var posted = Http?.Request.HasFormContentType == true ? Http.Request.Form : null;
        CompanyLogo? logo = null;
        if (posted?.Files["Logo"] is { Length: > 0 } file)
        {
            (logo, var problem) = await CompanyLogo.ReadAsync(file);
            if (problem is not null)
            {
                _logoProblems = [problem];
                return;
            }
        }

        var saved = adding ? new Company() : await Db.Companies.Include(c => c.Logo).FirstOrDefaultAsync(c => c.Id == Company);
        if (saved is null)
        {
            Fail(form, nameof(Input.Name), "This company isn’t here any more.");
            return;
        }

        // The form's fields and nothing else.
        (saved.Name, saved.Website, saved.City) = (Input.Name.Trim(), Blank(Input.Website), Blank(Input.City));
        (saved.Industry, saved.Size, saved.Country) = (Input.Industry, Input.Size, Blank(Input.Country));
        (saved.OwnerId, saved.Status, saved.Notes) = (Blank(Input.OwnerId), Input.Status, Blank(Input.Notes));
        if (adding)
        {
            saved.Added = DateOnly.FromDateTime(Clock.Now(await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync()));
            Db.Companies.Add(saved);
        }

        // A new file takes the old one's place; "Remove the logo" leaves the building.
        if (logo is not null)
        {
            if (saved.Logo is { } old) (old.ContentType, old.Data) = (logo.ContentType, logo.Data);
            else saved.Logo = logo;
            saved.LogoUpdated = DateTime.UtcNow;
        }
        else if (!adding && posted?["RemoveLogo"].Contains("true") == true)
        {
            saved.Logo = null;
            saved.LogoUpdated = null;
        }

        // The audit log records it as it saves (Auditing/AuditInterceptor.cs).
        await Db.SaveChangesAsync();
        if (adding) Toasts.Success($"{saved.Name} is in your companies.", "Company created");
        else Toasts.Success($"{saved.Name} is up to date.", "Company saved");
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("dialog", (string?)null));
    }
}
