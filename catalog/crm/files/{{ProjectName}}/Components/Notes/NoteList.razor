@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ToastService Toasts

@* A record's notes, in one card: a box to write one, then the team's notes, newest first. A quick note is its
   text, cut to four lines with Show more. A note given a title (in Edit) is a document: its row is the title, a
   link to its own page (Pages/Notes/Detail.razor), over how it opens. Under each: who wrote it and when, and
   the other records it's on. People who can edit records get the box and a menu on each note: Edit opens a
   dialog (?dialog=edit-note&note=5 on the page's address) and Delete asks first (?dialog=delete-note&note=5).
   Everything posts here and goes back to the page, so a page shows notes by loading them and writing:

   <NoteList Notes="_notes" CanEdit="_canEdit" Href="@($"contacts/{Id}/notes")" On="@($"contacts/{Id}")"
             New="@(() => new Note { ContactId = Id })" About="@contact.Name" Workspace="_workspace" Today="_today" />

   Load each note's Author, Contact, Deal, Company and Activity. DialogsOnly leaves the card out, for a page
   that shows one note itself. *@
@if (!DialogsOnly)
{
    var adding = CanEdit && New is not null;
    <Card>
        @if (adding)
        {
            <CardBody>
                <Form Model="Draft" FormName="add-note" OnValidSubmit="AddAsync" RequiredMark="RequiredMark.None">
                    <TextArea @bind-Value="Draft!.Body" Label="Note" Rows="2" AutoGrow Placeholder="Goals, decisions, and next steps…" />
                    <FormActions>
                        <Button Submit>Add note</Button>
                    </FormActions>
                </Form>
            </CardBody>
        }
        @if (Notes.Count > 0)
        {
            <CardBody Flush>
                <ListView Items="Notes" ItemKey="n => n.Id.ToString()" ItemLabel="Name" Label="Notes" Context="note">
                    <ChildContent>
                        <Column Gap="1">
                            @if (note.Title is { Length: > 0 } title)
                            {
                                <Heading Level="3" Size="TextSize.Sm"><Anchor Href="@($"notes/{note.Id}")" InheritColor Underline="AnchorUnderline.Hover">@title</Anchor></Heading>
                                <TextBlock Color="Color.Muted" LineClamp="2">@Lead(note)</TextBlock>
                            }
                            else
                            {
                                @* The note itself: its text is Markdown, so a list or a link in it shows as one. *@
                                <ShowMore Lines="4">
                                    <Markdown Text="@note.Body" TopHeading="4" Size="ProseSize.Sm" />
                                </ShowMore>
                            }
                            <Column Gap="0">
                                <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Byline(note)</TextBlock>
                                @WrittenOn(note)
                            </Column>
                        </Column>
                    </ChildContent>
                    <ItemMenu>
                        @if (CanEdit)
                        {
                            <MenuItem Href="@($"{Href}?dialog=edit-note&note={note.Id}")" Icon="Lucide.Pencil">Edit</MenuItem>
                            <MenuItem Href="@($"{Href}?dialog=delete-note&note={note.Id}")" Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
                        }
                    </ItemMenu>
                </ListView>
            </CardBody>
        }
        else if (!adding)
        {
            <EmptyState Icon="Lucide.NotebookPen" Size="ControlSize.Sm" Title="No notes yet" Description="@(About is null ? null : $"Notes about {About} show here.")" />
        }
    </Card>
}

@if (CanEdit && Edit is not null && Notes.Any(n => n.Id == NoteId))
{
    <Dialog Id="edit-note" Title="Edit note" CloseOnBackdrop="false">
        <Form Model="Edit" FormName="edit-note" OnValidSubmit="SaveAsync" RequiredMark="RequiredMark.None">
            <input type="hidden" name="Edit.Id" value="@NoteId" />
            <TextField @bind-Value="Edit.Title" Label="Title" Hint="Optional. A note with a title has a page of its own." autocomplete="off" />
            <TextArea @bind-Value="Edit.Body" Label="Note" Rows="6" AutoGrow autofocus />
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <Button Submit>Save note</Button>
            </DialogFooter>
        </Form>
    </Dialog>
}

@if (CanEdit && !DialogsOnly && Notes.FirstOrDefault(n => n.Id == NoteId) is { } doomed)
{
    <Dialog Id="delete-note" Title="Delete this note?" Size="DialogSize.Sm">
        <Form Model="Delete" FormName="delete-note" OnValidSubmit="DeleteAsync">
            <input type="hidden" name="Delete.Id" value="@doomed.Id" />
            <TextBlock Color="Color.Muted">@(doomed.Title ?? doomed.Opening)</TextBlock>
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <Button Submit Accent="Accent.Danger">Delete</Button>
            </DialogFooter>
        </Form>
    </Dialog>
}

@code {
    /// <summary>The notes, newest first, each with its Author, Contact, Deal, Company and Activity.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<Note> Notes { get; set; } = [];

    /// <summary>Whether the reader can write and change them (Policies.EditRecords).</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The address of the page they're on, such as "contacts/7/notes": where the dialogs open and where a save goes back to.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    /// <summary>The page's own record, such as "contacts/7": left out of each note's "Written on".</summary>
    [Parameter] public string? On { get; set; }

    /// <summary>A new note for this page, with the records it's about set: with it, there's a box to write one. The text, the author and the time are added here.</summary>
    [Parameter] public Func<Note>? New { get; set; }

    /// <summary>Who or what the page is about, for the words: "It’s on Olivia Chen’s page for the whole team."</summary>
    [Parameter] public string? About { get; set; }

    [Parameter] public Workspace? Workspace { get; set; }

    /// <summary>The workspace's today (Clock).</summary>
    [Parameter] public DateOnly Today { get; set; }

    /// <summary>Only the edit dialog, for a page that shows a note itself.</summary>
    [Parameter] public bool DialogsOnly { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>The note the edit or delete dialog is about (?note=5).</summary>
    [SupplyParameterFromQuery(Name = "note")] private int? NoteId { get; set; }

    // The note being written in the box.
    [SupplyParameterFromForm(FormName = "add-note")] private NoteDraft? Draft { get; set; }

    // The note being changed in the edit dialog.
    [SupplyParameterFromForm(FormName = "edit-note")] private NoteEdit? Edit { get; set; }

    // The note the delete dialog posted.
    [SupplyParameterFromForm(FormName = "delete-note")] private NoteRef? Delete { get; set; }

    private sealed class NoteDraft
    {
        [Required(ErrorMessage = "Enter a note."), StringLength(20000, ErrorMessage = "Use 20,000 characters or fewer.")]
        public string? Body { get; set; }
    }

    private sealed class NoteEdit
    {
        public int Id { get; set; }

        [StringLength(120, ErrorMessage = "Use 120 characters or fewer.")] public string? Title { get; set; }

        [Required(ErrorMessage = "Enter a note."), StringLength(20000, ErrorMessage = "Use 20,000 characters or fewer.")]
        public string? Body { get; set; }
    }

    private sealed class NoteRef
    {
        public int Id { get; set; }
    }

    protected override void OnParametersSet()
    {
        Draft ??= new();
        Delete ??= new();
        // The edit dialog starts with the note as it is; a post that came back keeps what was typed.
        if (Edit is null && Notes.FirstOrDefault(n => n.Id == NoteId) is { } editing) Edit = new NoteEdit { Id = editing.Id, Title = editing.Title, Body = editing.Body };
    }

    // How a titled note opens: its first paragraph, which the row cuts to two lines.
    private static string Lead(Note note) =>
        note.Body.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault(line => !line.StartsWith('#')) ?? "";

    // A note's name for its menu: its title, or "note from Nov 14, 12:10 PM".
    private string Name(Note note) => note.Title ?? $"note from {Written(note.Created)}";

    // "Jamie Davis · Nov 14, 12:10 PM", and that it was changed since.
    private string Byline(Note note) =>
        $"{note.Author?.Name ?? "Someone"} · {Written(note.Created)}{(note.Edited > note.Created ? " · Edited" : "")}";

    /// <summary>When a note was written, as the app writes it: "Nov 14, 12:10 PM".</summary>
    public static string Written(DateTime utc, Workspace? workspace, DateOnly today)
    {
        var at = When.Local(utc, workspace);
        return $"{When.Day(DateOnly.FromDateTime(at), today)}, {When.Time(at)}";
    }

    private string Written(DateTime utc) => Written(utc, Workspace, Today);

    /// <summary>The records a note is on, as (what kind, its icon, its address, its name): a contact, a deal, a company, an activity.</summary>
    public static IEnumerable<(string Kind, IconData Icon, string Href, string Name)> Records(Note note)
    {
        if (note.Contact is { } contact) yield return ("contact", Lucide.User, $"contacts/{contact.Id}", contact.Name);
        if (note.Deal is { } deal) yield return ("deal", Lucide.Handshake, $"deals/{deal.Id}", deal.Name);
        if (note.Company is { } company) yield return ("company", Lucide.BuildingComplex, $"companies/{company.Id}", company.Name);
        if (note.Activity is { } activity) yield return ("activity", Lucide.CalendarDays, $"activities/{activity.Id}", activity.Title);
    }

    // "Written on" and a link to each record the note is on, other than this page's.
    private RenderFragment WrittenOn(Note note) => __builder =>
    {
        var records = Records(note).Where(r => r.Href != On).ToList();
        if (records.Count > 0)
        {
            <Row Gap="2" Align="Align.Center" Wrap>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Written on</TextBlock>
                @foreach (var record in records)
                {
                    <TextBlock As="span" Size="TextSize.Sm">
                        <Anchor Href="@record.Href" title="@(char.ToUpperInvariant(record.Kind[0]) + record.Kind[1..])"><Icon Name="record.Icon" Size="IconSize.Sm" /> <VisuallyHidden>@record.Kind </VisuallyHidden>@record.Name</Anchor>
                    </TextBlock>
                }
            </Row>
        }
    };

    // A note written in the box: about what the page says, yours, now.
    private async Task AddAsync()
    {
        if (!CanEdit || New is null) return;
        var now = DateTime.UtcNow;
        var note = New();
        (note.Body, note.Created, note.Edited) = (Draft!.Body!.Trim(), now, now);
        note.AuthorId = (await AuthState).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        Db.Notes.Add(note);
        // Writing about someone is being in touch with them.
        if (note.ContactId is { } id && await Db.Contacts.FirstOrDefaultAsync(c => c.Id == id) is { } contact) contact.LastActivity = now;
        await Db.SaveChangesAsync();
        Toasts.Success(About is null ? "The whole team can read it." : $"It’s on {About}’s page for the whole team.", "Note added");
        Navigation.NavigateTo(Href);
    }

    // Only a note this page shows can be changed from it.
    private async Task SaveAsync()
    {
        if (!CanEdit) return;
        var title = string.IsNullOrWhiteSpace(Edit!.Title) ? null : Edit.Title.Trim();
        if (Notes.Any(n => n.Id == Edit.Id) && await Db.Notes.FirstOrDefaultAsync(n => n.Id == Edit.Id) is { } note
            && (note.Body != Edit.Body!.Trim() || note.Title != title))
        {
            (note.Title, note.Body, note.Edited) = (title, Edit.Body.Trim(), DateTime.UtcNow);
            await Db.SaveChangesAsync();
            Toasts.Success("Everyone sees the change.", "Note saved");
        }

        Navigation.NavigateTo(Href);
    }

    private async Task DeleteAsync()
    {
        if (!CanEdit) return;
        if (Notes.Any(n => n.Id == Delete!.Id) && await Db.Notes.FirstOrDefaultAsync(n => n.Id == Delete!.Id) is { } note)
        {
            Db.Notes.Remove(note);
            await Db.SaveChangesAsync();
            Toasts.Success("The note is gone for everyone.", "Note deleted");
        }

        Navigation.NavigateTo(Href);
    }
}
