@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ToastService Toasts

@* The note form, in a dialog over the page that asked for it: ?dialog=new-note writes one, ?dialog=edit-note
   with &note=5 changes one. It also deletes: a note's Delete posts DeleteForm with the note's id, after a
   ConfirmDialog here has asked. Put one on a page that has such links (a feed's Add menu and its notes' menus:
   Components/Activities/ActivityFeed.razor):

   <NoteDialog CanEdit="_canEdit" Contact="Id" />                        a contact: a new note is about them
   <NoteDialog CanEdit="_canEdit" Deal="Id" Contact="deal.ContactId" />  a deal: about it and its contact
   <NoteDialog CanEdit="_canEdit" Company="Id" />                        a company
   <NoteDialog CanEdit="_canEdit" Activity="Id" Contact="…" Deal="…" />  an activity: what a meeting decided
   <NoteDialog CanEdit="_canEdit" />                                     a note's own page: edit

   A note is its text, which is Markdown; a title is optional, and gives it a page of its own. It saves and comes
   back to the page, without the ?dialog. *@
@if (CanEdit && Input is not null && Opened is NewId or EditId)
{
    var adding = Opened == NewId;
    <Dialog Id="@Opened" Title="@(adding ? "New note" : "Edit note")" CloseOnBackdrop="false">
        <Form Model="Input" FormName="note" OnValidSubmit="SaveAsync">
            @if (adding)
            {
                <TextBlock Color="Color.Muted">Keep customer context where the whole team can find it.</TextBlock>
            }
            <TextField @bind-Value="Input.Title" Label="Title" autocomplete="off" />
            @* A Grid, not the form's Columns: a dialog this narrow is under the width at which a form splits in two. *@
            <Grid Columns="@(new() { Base = 1, Sm = 2 })" Gap="4">
                <Select @bind-Value="Input.ContactId" Label="Related contact" Items="_contactIds" ItemText="id => _contacts[id!.Value].Name"
                        ItemGroup="id => _contacts[id!.Value].Company" Placeholder="No one" />
                <Select @bind-Value="Input.DealId" Label="Related deal" Items="_dealIds" ItemText="id => _deals[id!.Value].Name"
                        ItemGroup="id => _deals[id!.Value].Company" Placeholder="No deal" />
            </Grid>
            <TextArea @bind-Value="Input.Body" Label="Note" Placeholder="Goals, decisions, and next steps…" Rows="6" AutoGrow />
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <Button Submit>Save note</Button>
            </DialogFooter>
        </Form>
    </Dialog>
}

@if (CanEdit)
{
    @* A note's Delete posts this form (DeleteForm, with the note's id), once the one dialog for all of them
       has asked: it's for everything with DeleteClass, and names the note by its data-confirm. *@
    <form id="@DeleteForm" method="post" @formname="@DeleteForm" @onsubmit="DeleteAsync">
        <AntiforgeryToken />
    </form>
    <ConfirmDialog For="@($".{DeleteClass}")" Title="Delete this note?" Message="{0}" ConfirmText="Delete" Accent="Accent.Danger" />
}

@code {
    /// <summary>The dialogs' ids, for links: <c>?dialog=new-note</c>, <c>?dialog=edit-note&amp;note=5</c>.</summary>
    public const string NewId = "new-note", EditId = "edit-note";

    /// <summary>
    /// What a note's Delete needs: <c>Submit Form="@NoteDialog.DeleteForm" Name="note" Value="5"</c> to post, and
    /// <c>Class="@NoteDialog.DeleteClass"</c> with <c>data-confirm</c> (the note's title) so it asks first.
    /// </summary>
    public const string DeleteForm = "delete-note", DeleteClass = "delete-note";

    /// <summary>Whether the reader can write and change notes (Policies.EditRecords). Without it there's no dialog.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The person a new note starts with: the page's own, or its record's.</summary>
    [Parameter] public int? Contact { get; set; }

    /// <summary>The deal a new note starts with.</summary>
    [Parameter] public int? Deal { get; set; }

    /// <summary>The company a new note is about: a company's page.</summary>
    [Parameter] public int? Company { get; set; }

    /// <summary>The activity a new note is written on: an activity's page.</summary>
    [Parameter] public int? Activity { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }

    /// <summary>The note the edit dialog is about (?note=5).</summary>
    [SupplyParameterFromQuery(Name = "note")] private int? NoteId { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The note as the form shows it, and as it posts.
    [SupplyParameterFromForm(FormName = "note")] private NoteInput? Input { get; set; }

    // The note a Delete posted.
    [SupplyParameterFromForm(FormName = DeleteForm, Name = "note")] private int? Doomed { get; set; }

    private sealed class NoteInput
    {
        [StringLength(120, ErrorMessage = "Use 120 characters or fewer.")] public string? Title { get; set; }

        public int? ContactId { get; set; }

        public int? DealId { get; set; }

        [Required(ErrorMessage = "Enter a note."), StringLength(20000, ErrorMessage = "Use 20,000 characters or fewer.")]
        public string? Body { get; set; }
    }

    // The dialog's choices: every contact and every deal, each under its company, by name.
    private Dictionary<int, (string Name, string? Company)> _contacts = [];
    private List<int?> _contactIds = [];
    private Dictionary<int, (string Name, string? Company)> _deals = [];
    private List<int?> _dealIds = [];

    // Which dialog the address opens, if any: edit needs a note.
    private string? Opened => Dialog == NewId ? NewId : Dialog == EditId && NoteId is not null ? Dialog : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!CanEdit || Opened is null) return;

        // Under their companies, A to Z; those without a company last.
        _contacts = (await Db.Contacts.AsNoTracking().Include(c => c.Company).ToListAsync()).ToDictionary(c => c.Id, c => (c.Name, c.Company?.Name));
        _contactIds = _contacts.OrderBy(c => c.Value.Company ?? "￿").ThenBy(c => c.Value.Name).Select(c => (int?)c.Key).ToList();
        _deals = (await Db.Deals.AsNoTracking().Include(d => d.Company).ToListAsync()).ToDictionary(d => d.Id, d => (d.Name, d.Company?.Name));
        _dealIds = _deals.OrderBy(d => d.Value.Company ?? "￿").ThenBy(d => d.Value.Name).Select(d => (int?)d.Key).ToList();

        // A post brings the form's own values; otherwise the note as it is, or a new one about the page's records.
        if (Input is not null) return;
        if (Opened == EditId)
        {
            if (await Db.Notes.AsNoTracking().FirstOrDefaultAsync(n => n.Id == NoteId) is { } note)
                Input = new NoteInput { Title = note.Title, ContactId = note.ContactId, DealId = note.DealId, Body = note.Body };
        }
        else
        {
            Input = new NoteInput
            {
                ContactId = Contact is { } person && _contacts.ContainsKey(person) ? Contact : null,
                DealId = Deal is { } deal && _deals.ContainsKey(deal) ? Deal : null,
            };
        }
    }

    private async Task SaveAsync(EditContext form)
    {
        if (!CanEdit || Input is null) return;
        var adding = Opened == NewId;
        var now = DateTime.UtcNow;
        var saved = adding ? new Note { Created = now, CompanyId = Company, ActivityId = Activity } : await Db.Notes.FirstOrDefaultAsync(n => n.Id == NoteId);
        if (saved is null)
        {
            Fail(form, nameof(Input.Body), "This note isn’t here any more.");
            return;
        }

        // Only what the lists offer.
        if (Input.ContactId is { } contact && !_contacts.ContainsKey(contact)) { Fail(form, nameof(Input.ContactId), "Choose a contact, or no one."); return; }
        if (Input.DealId is { } deal && !_deals.ContainsKey(deal)) { Fail(form, nameof(Input.DealId), "Choose a deal, or no deal."); return; }

        (saved.Title, saved.ContactId, saved.DealId, saved.Body, saved.Edited) =
            (string.IsNullOrWhiteSpace(Input.Title) ? null : Input.Title.Trim(), Input.ContactId, Input.DealId, Input.Body!.Trim(), now);
        if (adding)
        {
            saved.AuthorId = (await AuthState).User.UserId();
            Db.Notes.Add(saved);
            // Writing about someone is being in touch with them.
            await Db.TouchContactAsync(saved.ContactId, now);
        }

        await Db.SaveChangesAsync();
        Toasts.Success(adding ? "The whole team can read it." : "Everyone sees the change.", adding ? "Note added" : "Note saved");
        Navigation.NavigateTo(Back);
    }

    private async Task DeleteAsync()
    {
        if (!CanEdit) return;
        if (await Db.Notes.FirstOrDefaultAsync(n => n.Id == Doomed) is { } note)
        {
            Db.Notes.Remove(note);
            await Db.SaveChangesAsync();
            Toasts.Success("The note is gone for everyone.", "Note deleted");
        }

        Navigation.NavigateTo(Back);
    }

    // The page as it was: without the dialog and its note.
    private string Back => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["dialog"] = null, ["note"] = null });
}
