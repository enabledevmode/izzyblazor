@page "/"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider Auth

<PageTitle>My day</PageTitle>

@* My day: where you start. The pipeline in three figures, the tasks you have due (tick one and it's done), your
   next meeting, and what the team last did. Everything is yours: tasks and meetings assigned to you. *@
<PageCrumbs><BreadcrumbItem>My day</BreadcrumbItem></PageCrumbs>

<Column Gap="6">
    <PageHeader Title="@($"{Greeting}, {_firstName}")" Description="@($"{_now:dddd, MMMM d} · Here’s where to focus today.")">
        <PageHeaderActions>
            <AuthorizeView Policy="@Policies.EditRecords">
                <Button Href="contacts?add=1" StartIcon="Lucide.Plus" FloatBelow="Breakpoint.Sm">New contact</Button>
            </AuthorizeView>
        </PageHeaderActions>
    </PageHeader>

    <Grid Columns="new() { Base = 1, Md = 3 }" Gap="4">
        <Card><Stat Label="Open pipeline" Value="@Money(_open.Sum(d => d.Value))" Description="@($"{Count(_open.Count, "deal")} across {Count(_open.Select(d => d.Stage).Distinct().Count(), "stage")}")" /></Card>
        <Card><Stat Label="Follow-ups due" Value="@_due.ToString("N0")" Description="@(_overdue == 0 ? null : $"{_overdue:N0} {(_overdue == 1 ? "needs" : "need")} your attention")" /></Card>
        <Card><Stat Label="Closing this month" Value="@Money(_closing.Sum(d => d.Value))" Description="@($"{Count(_closing.Count, "deal")} in proposal or negotiation")" /></Card>

        <Column Gap="4" ColSpan="new() { Md = 2 }" AlignSelf="Align.Start">
            <Card Title="Your next moves" TitleLevel="2" Size="ControlSize.Sm">
                <CardActions><TextBlock As="span" Size="TextSize.Sm"><Anchor Href="activities/tasks">View all</Anchor></TextBlock></CardActions>
                <CardBody Flush>
                    @if (_tasks.Count > 0)
                    {
                        <TaskList Tasks="_tasks.Take(Shown).ToList()" Today="_today" Label="Your next moves" />
                    }
                    else
                    {
                        <EmptyState Icon="Lucide.CircleCheck" Size="ControlSize.Sm" Title="[Copy needed: nothing due title]" Description="[Copy needed: nothing due line]" />
                    }
                </CardBody>
            </Card>

            @if (_meeting is not null)
            {
                <Card Title="Upcoming meeting" TitleLevel="2" Size="ControlSize.Sm">
                    <CardActions><Badge Accent="Accent.Primary">@When.Day(DateOnly.FromDateTime(_meeting.Start), _today)</Badge></CardActions>
                    <CardBody Flush>
                        <ListView Items="@(new[] { _meeting })" ItemKey="m => m.Id.ToString()" Label="Upcoming meeting"
                                  ItemIcon="_ => Lucide.Video" ItemText="m => m.Title"
                                  ItemDescription="@(m => string.Join(" · ", new[] { m.Contact?.Name, When.Hours(m.Start, m.End) }.Where(s => s is not null)))" Context="meeting">
                            <ItemActions>
                                @if (meeting.ContactId is { } contact)
                                {
                                    <TextBlock As="span" Size="TextSize.Sm"><Anchor Href="@($"contacts/{contact}")">View contact</Anchor></TextBlock>
                                }
                            </ItemActions>
                        </ListView>
                    </CardBody>
                </Card>
            }
        </Column>

        <Card Title="Recent activity" TitleLevel="2" Size="ControlSize.Sm" AlignSelf="Align.Start">
            <Timeline TimePlacement="TimelinePlacement.Below" Size="ControlSize.Sm">
                @foreach (var item in _recent)
                {
                    <TimelineItem Title="@item.Title" Time="@($"{item.By} · {When.Happened(item.When, _today)}")" DateTime="@item.When.ToString("yyyy-MM-ddTHH:mm")">
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">@item.About</TextBlock>
                    </TimelineItem>
                }
            </Timeline>
        </Card>
    </Grid>
</Column>

@code {
    /// <summary>The tasks just ticked here, which stay in the list: "4,7".</summary>
    [SupplyParameterFromQuery] private string? Done { get; set; }

    // Your next moves lists this many, the most overdue first; View all has the rest.
    private const int Shown = 5;

    private Workspace? _workspace;
    private DateTime _now;
    private DateOnly _today;
    private string? _firstName;
    private List<Deal> _open = [], _closing = [];
    private List<Activity> _tasks = [];
    private Activity? _meeting;
    private int _due, _overdue;
    private List<Happened> _recent = [];

    // Something the team did, for Recent activity: what, what it was about, who and when (the workspace's time).
    private sealed record Happened(string Title, string About, string? By, DateTime When);

    private string Greeting => _now.Hour switch { < 12 => "Good morning", < 18 => "Good afternoon", _ => "Good evening" };

    protected override async Task OnInitializedAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        _now = Clock.Now(_workspace);
        _today = DateOnly.FromDateTime(_now);
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        var me = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _firstName = NameClaim.Shown(user)?.Split(' ', '@')[0];

        // The pipeline: every open deal, and those in the last two stages expected to close this month.
        _open = await Db.Deals.AsNoTracking().Where(d => d.Stage != DealStage.Won && d.Stage != DealStage.Lost).ToListAsync();
        var month = new DateOnly(_today.Year, _today.Month, 1);
        _closing = _open.Where(d => d.Stage is DealStage.Proposal or DealStage.Negotiation && d.ExpectedClose >= month && d.ExpectedClose < month.AddMonths(1)).ToList();

        // Your tasks due by the end of today, and those just ticked (?done=, from TaskCheck), which stay in sight.
        var (start, end) = (_today.ToDateTime(TimeOnly.MinValue), _today.AddDays(1).ToDateTime(TimeOnly.MinValue));
        var ticked = TaskCheck.Ids(Done);
        _tasks = await Db.Activities.AsNoTracking()
            .Include(a => a.Contact!.Company).Include(a => a.Deal!.Company)
            .Where(a => a.Type == ActivityType.Task && a.AssignedToId == me && ((a.Completed == null && a.Start < end) || (a.Completed != null && ticked.Contains(a.Id))))
            .OrderBy(a => a.Start).ToListAsync();
        _due = _tasks.Count(t => t.Completed is null);
        _overdue = _tasks.Count(t => t.Completed is null && t.Start < start);

        // Your next meeting that hasn't ended.
        _meeting = await Db.Activities.AsNoTracking().Include(a => a.Contact)
            .Where(a => a.Type == ActivityType.Meeting && a.AssignedToId == me && a.Completed == null && a.Start >= start)
            .OrderBy(a => a.Start).ToListAsync() is var meetings ? meetings.FirstOrDefault(m => m.End > _now) : null;

        // The last three things anyone did: activities finished, and deals moved to another stage (from the audit log).
        var nowUtc = DateTime.UtcNow;
        var done = await Db.Activities.AsNoTracking()
            .Include(a => a.Contact!.Company).Include(a => a.Deal!.Company).Include(a => a.AssignedTo)
            .Where(a => a.Completed != null && a.Completed <= nowUtc).OrderByDescending(a => a.Completed).Take(3).ToListAsync();
        var moved = await Db.AuditEvents.AsNoTracking()
            .Where(e => e.Action == AuditActions.StageChanged && e.EntityType == nameof(Deal) && e.Time <= nowUtc).OrderByDescending(e => e.Time).Take(3).ToListAsync();
        var movedIds = moved.Select(e => int.TryParse(e.EntityId, out var id) ? id : 0).ToList();
        var movedDeals = await Db.Deals.AsNoTracking().Include(d => d.Company).Where(d => movedIds.Contains(d.Id)).ToDictionaryAsync(d => d.Id);
        _recent = done.Select(a => new Happened(
                a.Type == ActivityType.Task ? a.Title : $"{a.Title} completed",
                About((a.Deal?.Company ?? a.Contact?.Company)?.Name, a.Deal?.Name ?? a.Contact?.Name),
                a.AssignedTo?.Name, When.Local(a.Completed!.Value, _workspace)))
            .Concat(moved.Select(e => new Happened(
                $"Deal moved to {e.ReadChanges().FirstOrDefault(c => c.Field == "Stage")?.After?.ToLowerInvariant()}",
                About(movedDeals.GetValueOrDefault(int.TryParse(e.EntityId, out var id) ? id : 0)?.Company?.Name, e.EntityName),
                e.ActorName, When.Local(e.Time, _workspace))))
            .OrderByDescending(h => h.When).Take(3).ToList();
    }

    private string Money(decimal amount) => (_workspace ?? new Workspace()).Money(amount);

    private static string Count(int count, string noun) => $"{count:N0} {noun}{(count == 1 ? "" : "s")}";

    private static string About(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
}
