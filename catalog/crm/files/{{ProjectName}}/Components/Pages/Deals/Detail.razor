@page "/deals/{Id:int}"
@page "/deals/{Id:int}/{Section}"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject Audit Audit
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization
@inject ToastService Toasts

<PageTitle>@(_deal?.Name ?? "Deal")</PageTitle>

@* A deal: where it is in the pipeline, what it's worth, what's next and what's been done. The stage strip follows
   the deal's stage, which changes from the header: Mark as won, or the arrow beside it for another stage (or
   lost). Each posts here, writes "Changed stage" in the audit log and comes back with a toast. On a phone the
   same actions float in the corner, with the next stage in place of the menu. Activity and Notes are tabs with
   an address each (/deals/3, /deals/3/notes). Notes are the team's own about the deal
   (Components/Notes/NoteList.razor), and its files are in the database (Components/Deals/DealAttachments.razor).
   People who can't edit records (Viewers) read everything and see no buttons. *@
@if (_deal is { } deal)
{
    <Column Gap="6">
        @* In the column, so on a phone the trail has the page's gap above the title. *@
        <PageCrumbs Trail>
            <BreadcrumbItem Href="deals">Deal pipeline</BreadcrumbItem>
            <BreadcrumbItem>@deal.Name</BreadcrumbItem>
        </PageCrumbs>
        @* The day it was created follows the owner where there's room; on a phone it's with the facts below. *@
        <PageHeader Title="@deal.Name">
            <TextBlock Color="Color.Muted">
                @About(deal.Company?.Name, deal.Owner is { } owner ? $"Owned by {owner.Name}" : null)<TextBlock As="span" VisibleFrom="Breakpoint.Sm"> · Created @When.Date(deal.Created, _today)</TextBlock>
            </TextBlock>
            @if (_canEdit)
            {
                <PageHeaderActions>
                    @if (deal.IsOpen)
                    {
                        <Button Href="@EditHref" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Pencil" VisibleFrom="Breakpoint.Sm">Edit deal</Button>
                        <SplitButton Label="Mark as won" StartIcon="Lucide.Trophy" Submit Form="deal-action" Name="stage" Value="@nameof(DealStage.Won)"
                                     MenuLabel="More stages" VisibleFrom="Breakpoint.Sm">
                            <MenuGroup Label="Move to stage">
                                @foreach (var stage in Pipeline)
                                {
                                    <MenuItem Submit Form="deal-action" Name="stage" Value="@stage.ToString()" Checked="@(stage == deal.Stage)">@stage</MenuItem>
                                }
                            </MenuGroup>
                            <MenuDivider />
                            <MenuItem Submit Form="deal-action" Name="stage" Value="@nameof(DealStage.Lost)" Icon="Lucide.CircleX" Accent="Accent.Danger">Mark as lost</MenuItem>
                        </SplitButton>
                    }
                    else
                    {
                        <Button Href="@EditHref" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Pencil" FloatBelow="Breakpoint.Sm">Edit deal</Button>
                    }
                </PageHeaderActions>
            }
        </PageHeader>

        <Column Gap="4">
            @* The pipeline's stages, then Won: a won deal has finished them all. A lost one left the pipeline. Small,
               so the five fit a phone with the current stage's name beside its marker. *@
            @if (deal.Stage == DealStage.Lost)
            {
                <Alert Status="Status.Neutral" Title="Deal lost">@(deal.Closed is { } lost ? $"Closed {lost.ToString(_workspace!.DateFormat)}." : "It’s out of the pipeline.")</Alert>
            }
            else
            {
                <Card>
                    <Stepper Current="@((int)deal.Stage + (deal.Stage == DealStage.Won ? 2 : 1))" Label="Deal stage" Size="ControlSize.Sm">
                        <Step Label="Discovery" />
                        <Step Label="Qualified" />
                        <Step Label="Proposal" />
                        <Step Label="Negotiation" />
                        <Step Label="Won" />
                    </Stepper>
                </Card>
            }

            <Card>
                <DescriptionList Orientation="Orientation.Vertical" Columns="4">
                    <DescriptionItem Term="Deal value">@($"{_workspace!.Money(deal.Value)} {_workspace.Currency}")</DescriptionItem>
                    @if (deal.Closed is { } closed)
                    {
                        <DescriptionItem Term="Closed">@closed.ToString(_workspace.DateFormat)</DescriptionItem>
                    }
                    else
                    {
                        <DescriptionItem Term="Expected close">@deal.ExpectedClose.ToString(_workspace.DateFormat)</DescriptionItem>
                    }
                    <DescriptionItem Term="Primary contact">
                        @if (deal.Contact is { } contact)
                        {
                            <Anchor Href="@($"contacts/{contact.Id}")">@contact.Name</Anchor>
                        }
                        else
                        {
                            <text>No one yet</text>
                        }
                    </DescriptionItem>
                    <DescriptionItem Term="Source">@(deal.Source is { } source ? Names.Of(source) : "Not set")</DescriptionItem>
                    <DescriptionItem Term="Created" HiddenFrom="Breakpoint.Sm">@deal.Created.ToString(_workspace.DateFormat)</DescriptionItem>
                </DescriptionList>
            </Card>

            @* What's happening, and beside it from 1024px the scope and files: under it on smaller screens. *@
            <Grid Template="@(new() { Base = "minmax(0, 1fr)", Lg = "minmax(0, 1fr) 20rem" })" Gap="4" Align="Align.Start">
                <Column Gap="4">
                    <Card Title="Next step" TitleLevel="2">
                        <CardBody Gap="3" Align="Align.Start">
                            @if (_next is { } next)
                            {
                                <Column Gap="0">
                                    <Heading Level="3" Size="TextSize.Sm">@next.Title</Heading>
                                    <TextBlock Color="Color.Muted">@About(When.Day(DateOnly.FromDateTime(next.Start), _today), When.Time(next.Start), next.Contact?.Name)</TextBlock>
                                </Column>
                            }
                            else
                            {
                                <TextBlock Color="Color.Muted">Nothing scheduled.</TextBlock>
                            }
                            @if (_canEdit)
                            {
                                <Button Href="@NewActivityHref">Schedule follow-up</Button>
                            }
                        </CardBody>
                    </Card>

                    <TabNav Label="Deal sections">
                        <TabLink Href="@($"deals/{Id}")" Label="Activity" Match="NavLinkMatch.All" />
                        <TabLink Href="@($"deals/{Id}/notes")" Label="Notes" />
                    </TabNav>

                    @switch (Section)
                    {
                        case null:
                            <Card Title="Deal activity" TitleLevel="2">
                                @if (_canEdit)
                                {
                                    <CardActions>
                                        <Button Href="@NewActivityHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Plus">Log activity</Button>
                                    </CardActions>
                                }
                                <Timeline TimePlacement="TimelinePlacement.Below" Size="ControlSize.Sm">
                                    @foreach (var item in _history)
                                    {
                                        <TimelineItem Title="@item.Title" Time="@item.Time" DateTime="@item.When.ToString("yyyy-MM-ddTHH:mm")">
                                            @if (!string.IsNullOrWhiteSpace(item.About))
                                            {
                                                <TextBlock Size="TextSize.Sm" Color="Color.Muted">@item.About</TextBlock>
                                            }
                                        </TimelineItem>
                                    }
                                </Timeline>
                            </Card>
                            break;

                        @* As a contact's Notes: a box to write one about the deal, then the notes, newest first. *@
                        case "notes":
                            <NoteList Notes="_notes" CanEdit="_canEdit" Href="@($"deals/{Id}/notes")" On="@($"deals/{Id}")"
                                      New="@(() => new Note { DealId = Id })" About="@deal.Name" Workspace="_workspace" Today="_today" />
                            break;
                    }
                </Column>

                <Column Gap="4">
                    @* What's included: the deal's own Scope field, edited with the rest. *@
                    @if (deal.Scope?.Trim() is { Length: > 0 } scope)
                    {
                        <Card Title="Scope" TitleLevel="2">
                            @if (_canEdit)
                            {
                                <CardActions>
                                    <Button Href="@EditHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Pencil" aria-label="Edit scope">Edit</Button>
                                </CardActions>
                            }
                            @* Three lines, the rest behind Show more: a long one doesn't push the files down. *@
                            <ShowMore Lines="3">
                                <TextBlock Color="Color.Muted" KeepLines>@scope</TextBlock>
                            </ShowMore>
                        </Card>
                    }

                    <DealAttachments Deal="Id" CanEdit="_canEdit" Href="@Here" Workspace="_workspace" Today="_today" />
                </Column>
            </Grid>
        </Column>
    </Column>

    @if (_canEdit)
    {
        @* On a phone the open deal's actions float in the corner, the main one nearest the thumb: the next stage
           stands in for the menu. *@
        @if (deal.IsOpen)
        {
            <SpeedDial Label="Deal actions" HiddenFrom="Breakpoint.Sm">
                <SpeedDialAction Icon="Lucide.Trophy" Label="Mark as won" Submit Form="deal-action" Name="stage" Value="@nameof(DealStage.Won)" />
                @if (deal.Stage < DealStage.Negotiation)
                {
                    <SpeedDialAction Icon="Lucide.ArrowRight" Label="@($"Move to {deal.Stage + 1}")" Submit Form="deal-action" Name="stage" Value="@((deal.Stage + 1).ToString())" />
                }
                <SpeedDialAction Icon="Lucide.Pencil" Label="Edit deal" Href="@EditHref" />
            </SpeedDial>
        }

        @* The stage buttons post this: each names the stage it moves the deal to. *@
        <form id="deal-action" method="post" @formname="deal-action" @onsubmit="MoveAsync">
            <AntiforgeryToken />
        </form>
    }

    <DealDialog CanEdit="_canEdit" Deal="Id" />
    <ActivityDialog CanEdit="_canEdit" Deal="Id" />
}

@code {
    /// <summary>The deal.</summary>
    [Parameter] public int Id { get; set; }

    /// <summary>The tab: none for Activity, or "notes".</summary>
    [Parameter] public string? Section { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The stage a button posted: a DealStage's name.
    [SupplyParameterFromForm(FormName = "deal-action", Name = "stage")] private string? StagePost { get; set; }



    // The stages a deal moves through while it's open, in order.
    private static readonly DealStage[] Pipeline = [DealStage.Discovery, DealStage.Qualified, DealStage.Proposal, DealStage.Negotiation];

    // Deal activity lists this many, the newest first.
    private const int Shown = 20;

    private Workspace? _workspace;
    private DateOnly _today;
    private Deal? _deal;
    private Activity? _next;
    private List<Happened> _history = [];
    private List<Note> _notes = [];
    private bool _canEdit;
    private string? _me;

    // This tab's address: where the file dialogs open and come back to.
    private string Here => Section is null ? $"deals/{Id}" : $"deals/{Id}/{Section}";

    // Edit opens the deal form over this tab.
    private string EditHref => $"{Here}?dialog={DealDialog.EditId}";

    // Schedule follow-up opens the activity form over this tab, with the deal and its primary contact chosen.
    private string NewActivityHref => $"{Here}?dialog={ActivityDialog.NewId}";

    // Something in the deal's history: what, more about it, "who · when" as written, and when (the workspace's time).
    private sealed record Happened(string Title, string? About, string Time, DateTime When);

    protected override async Task OnParametersSetAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync() ?? new Workspace();
        var now = Clock.Now(_workspace);
        _today = DateOnly.FromDateTime(now);
        var user = (await AuthState).User;
        _me = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _canEdit = (await Authorization.AuthorizeAsync(user, Policies.EditRecords)).Succeeded;

        _deal = await Db.Deals.AsNoTracking().Include(d => d.Company).Include(d => d.Contact).Include(d => d.Owner).FirstOrDefaultAsync(d => d.Id == Id);
        if (_deal is null || Section is not (null or "notes"))
        {
            _deal = null;
            Navigation.NotFound();
            return;
        }

        // What's next on the calendar about it: the first open activity that hasn't started.
        _next = await Db.Activities.AsNoTracking().Include(a => a.Contact)
            .Where(a => a.DealId == Id && a.Completed == null && a.Start >= now).OrderBy(a => a.Start).FirstOrDefaultAsync();

        if (Section is null) await LoadHistoryAsync(_deal);
        else
            _notes = await Db.Notes.AsNoTracking().Include(n => n.Author).Include(n => n.Contact).Include(n => n.Deal).Include(n => n.Company).Include(n => n.Activity)
                .Where(n => n.DealId == Id).OrderByDescending(n => n.Created).ToListAsync();
    }

    // Moves the deal to the stage a button named. Won or Lost closes it today; back in the pipeline, it's open again.
    private async Task MoveAsync()
    {
        if (_canEdit && Enum.TryParse<DealStage>(StagePost, out var to) && Enum.IsDefined(to)
            && await Db.Deals.FirstOrDefaultAsync(d => d.Id == Id) is { } deal && deal.Stage != to)
        {
            var from = deal.Stage;
            deal.Stage = to;
            deal.Closed = to is DealStage.Won or DealStage.Lost ? _today : null;
            // A stage change is its own line in the audit log, not an ordinary change.
            Db.Auditing = false;
            await Db.SaveChangesAsync();
            Db.Auditing = true;
            await Audit.RecordAsync(AuditActions.StageChanged, nameof(Deal), deal.Id.ToString(), deal.Name, [new AuditChange("Stage", from.ToString(), to.ToString())]);
            switch (to)
            {
                case DealStage.Won: Toasts.Success($"{deal.Name} · {_workspace!.Money(deal.Value)}", "Deal won"); break;
                case DealStage.Lost: Toasts.Success($"{deal.Name} is out of the pipeline.", "Deal marked as lost"); break;
                default: Toasts.Success($"{deal.Name} is now in {to}.", "Stage changed"); break;
            }
        }

        Navigation.NavigateTo(Here);
    }


    // The timeline, newest first: what's been finished, the calls and meetings put on the calendar, each move to
    // another stage, then the day the deal was created. Who scheduled, moved or created comes from the audit log.
    private async Task LoadHistoryAsync(Deal deal)
    {
        var done = await Db.Activities.AsNoTracking().Include(a => a.AssignedTo)
            .Where(a => a.DealId == Id && a.Completed != null).OrderByDescending(a => a.Completed).Take(Shown).ToListAsync();
        _history = done.Select(a =>
        {
            var at = When.Local(a.Completed!.Value, _workspace);
            return new Happened(a.Type == ActivityType.Task ? a.Title : $"{a.Title} completed", a.Agenda, About(a.AssignedTo?.Name, When.Happened(at, _today)), at);
        }).ToList();

        var ahead = await Db.Activities.AsNoTracking().Include(a => a.Contact)
            .Where(a => a.DealId == Id && a.Completed == null && a.Type != ActivityType.Task).ToDictionaryAsync(a => a.Id.ToString());
        var scheduled = await Db.AuditEvents.AsNoTracking()
            .Where(e => e.Action == AuditActions.Created && e.EntityType == nameof(Activity) && ahead.Keys.Contains(e.EntityId!))
            .OrderByDescending(e => e.Time).Take(Shown).ToListAsync();
        _history.AddRange(scheduled.Select(e =>
        {
            var (a, at) = (ahead[e.EntityId!], When.Local(e.Time, _workspace));
            return new Happened($"{a.Title} scheduled",
                About(When.Day(DateOnly.FromDateTime(a.Start), _today), When.Hours(a.Start, a.End), a.Contact?.Name),
                About(e.ActorName, When.Happened(at, _today)), at);
        }));

        var id = Id.ToString();
        var moved = await Db.AuditEvents.AsNoTracking()
            .Where(e => e.Action == AuditActions.StageChanged && e.EntityType == nameof(Deal) && e.EntityId == id)
            .OrderByDescending(e => e.Time).Take(Shown).ToListAsync();
        _history.AddRange(moved.Select(e =>
        {
            var at = When.Local(e.Time, _workspace);
            var stage = e.ReadChanges().FirstOrDefault(c => c.Field == "Stage")?.After;
            return new Happened(stage switch { nameof(DealStage.Won) => "Deal won", nameof(DealStage.Lost) => "Deal lost", _ => $"Moved to {stage}" },
                null, About(e.ActorName, When.Happened(at, _today)), at);
        }));
        _history = _history.OrderByDescending(h => h.When).Take(Shown).ToList();

        // Who created it, from the audit log; the day is the deal's own.
        if (_history.Count < Shown)
        {
            var created = await Db.AuditEvents.AsNoTracking()
                .Where(e => e.Action == AuditActions.Created && e.EntityType == nameof(Deal) && e.EntityId == id).OrderBy(e => e.Time).FirstOrDefaultAsync();
            _history.Add(new Happened("Deal created", null, About(created?.ActorName, When.Day(deal.Created, _today)), deal.Created.ToDateTime(TimeOnly.MinValue)));
        }
    }

    private static string About(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
}
