@page "/reports"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>Sales overview</PageTitle>

@* Sales overview: what the team won this month, quarter or year (?period=), against the one before and against
   each person's target (ApplicationUser.MonthlyTarget), and where the open pipeline stands today: its value by
   stage, the deals that need attention and the ones due to close next. Won and lost come from a deal's Closed
   day; expected revenue is the open deals by the month they're due to close. *@
<PageCrumbs><BreadcrumbItem>Reports</BreadcrumbItem></PageCrumbs>

<Column Gap="6">
    <PageHeader Title="Sales overview" Description="@($"{_name} · Team performance")">
        <PageHeaderActions>
            <TabNav Label="Report period" Variant="TabsVariant.Segmented" Size="ControlSize.Sm">
                <TabLink Href="reports" Label="This month" Current="@(_period == "month")" />
                <TabLink Href="reports?period=quarter" Label="This quarter" Current="@(_period == "quarter")" />
                <TabLink Href="reports?period=year" Label="This year" Current="@(_period == "year")" />
            </TabNav>
        </PageHeaderActions>
    </PageHeader>

    <Column Gap="4">
        @* Four figures, each against the period before, over a line of the last three periods. *@
        <Grid Columns="new() { Base = 2, Lg = 4 }" Gap="4">
            @foreach (var figure in _figures)
            {
                <Card>
                    <Stat Label="@figure.Label" Value="@figure.Value" Change="@figure.Change" Trend="figure.Trend"
                          ChangeStatus="@(figure.Trend == StatTrend.Down ? Status.Danger : Status.Success)" Description="@figure.Against"
                          Sparkline="figure.History" SparklineType="SparklineType.Area" SparklineFormat="@figure.Format" SparklineLabel="@figure.HistoryLabel" />
                </Card>
            }
        </Grid>

        <Grid Columns="new() { Base = 1, Lg = 2 }" Gap="4">
            <Card Title="Won and expected revenue" TitleLevel="2" TitleId="report-revenue">
                <Chart Items="_months" Argument="m => m.Month" TitledBy="report-revenue" Stacking="ChartStacking.Normal" Legend="ChartLegend.Top" Height="Length.Rem(14)">
                    <ChartValueAxis Format="@_format" />
                    <ChartBarSeries Value="m => m.Won" Name="Won" />
                    @* Expected is the same measure not yet won: the same color, lighter. It's the top series, so
                       it labels each column with the month's total, past the stack's end. *@
                    <ChartBarSeries Value="m => m.Expected" Name="Expected to close" Color="var(--ib-color-primary)" Opacity="0.5"
                                    Labels="ChartLabels.Outside" LabelText="m => m.Total" />
                    @if (_target > 0)
                    {
                        <ChartReferenceLine Value="(double)_target" Label="Monthly target" InLegend />
                    }
                </Chart>
            </Card>

            <Card Title="Open value by stage" TitleLevel="2" TitleId="report-stages">
                <CardActions><Button Href="deals" Variant="ButtonVariant.Ghost" Size="ControlSize.Sm" EndIcon="Lucide.ArrowRight">View pipeline</Button></CardActions>
                @if (_open.Count > 0)
                {
                    @* As tall as the revenue chart beside it with its legend, so the two cards end together. *@
                    <Chart Items="_stages" Argument="s => s.Stage" TitledBy="report-stages" Orientation="Orientation.Horizontal" Height="Length.Rem(18.875)" BarWidth="0.5">
                        <ChartValueAxis HideLabels GridLines="false" />
                        <ChartBarSeries Value="s => s.Value" Name="Open value" LabelText="s => s.Label" />
                    </Chart>
                }
                else
                {
                    <EmptyState Icon="Lucide.Handshake" Size="ControlSize.Sm" Title="No open deals" Description="Deals in the pipeline show here by stage." />
                }
            </Card>
        </Grid>

        <Grid Columns="new() { Base = 1, Lg = 2 }" Gap="4">
            <Card Title="@($"Team vs {_targetName} target")" TitleLevel="2">
                @if (_team.Count > 0)
                {
                    @* A gauge each: what they won of their target above the bar, the target a tick across it, and
                       the ranges behind it, named beside the value. *@
                    <Column Gap="4">
                        @foreach (var person in _team)
                        {
                            <LinearGauge Label="@person.Name" Value="person.Won" Max="person.Max" Target="person.Target" HideScale
                                         ValueFormat="@($"{_format}' of {Money((decimal)person.Target)}'")">
                                <GaugeBand From="0" To="person.Target * 0.5" Label="Under 50%" />
                                <GaugeBand From="person.Target * 0.5" To="person.Target * 0.9" Label="50–90%" />
                                <GaugeBand From="person.Target * 0.9" To="person.Max" Label="90% or more" />
                            </LinearGauge>
                        }
                    </Column>
                }
                else
                {
                    <EmptyState Icon="Lucide.Target" Size="ControlSize.Sm" Title="No targets yet" Description="Give a team member a monthly target to measure what they win against it." />
                }
            </Card>

            <Card Title="Deals at risk" TitleLevel="2">
                <CardBody Flush>
                    @if (_risks.Count > 0)
                    {
                        <ListView Items="_risks" ItemKey="r => r.Deal.Id.ToString()" ItemLabel="r => r.Deal.Name" Label="Deals at risk" Context="risk">
                            <ChildContent>
                                <Column Gap="1">
                                    <Column Gap="0">
                                        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium"><Anchor Href="@($"deals/{risk.Deal.Id}")" InheritColor Underline="AnchorUnderline.Hover">@risk.Deal.Name</Anchor></TextBlock>
                                        <TextBlock Size="TextSize.Xs" Color="Color.Muted">@About(risk.Deal.Company?.Name, risk.Deal.Owner?.Name)</TextBlock>
                                    </Column>
                                    @* A phone has the reason under the deal, a wider screen beside its value. *@
                                    <Row HiddenFrom="Breakpoint.Sm"><Badge Status="Status.Warning">@risk.Reason</Badge></Row>
                                </Column>
                            </ChildContent>
                            <ItemActions>
                                <Row Gap="3" Align="Align.Center">
                                    <Row VisibleFrom="Breakpoint.Sm"><Badge Status="Status.Warning">@risk.Reason</Badge></Row>
                                    <TextBlock As="span" Size="TextSize.Sm" Weight="FontWeight.Semibold" TabularNums>@Money(risk.Deal.Value)</TextBlock>
                                </Row>
                            </ItemActions>
                        </ListView>
                    }
                    else
                    {
                        <EmptyState Icon="Lucide.CircleCheck" Size="ControlSize.Sm" Title="Nothing at risk" Description="Every open deal has a next step and recent activity." />
                    }
                </CardBody>
            </Card>
        </Grid>

        <Grid Columns="new() { Base = 1, Lg = 2 }" Gap="4">
            <Card Title="Deals closing next" TitleLevel="2">
                <CardBody Flush>
                    @if (_next.Count > 0)
                    {
                        <ListView Items="_next" ItemKey="d => d.Id.ToString()" ItemLabel="d => d.Name" Label="Deals closing next" Context="deal">
                            <ChildContent>
                                <Column Gap="1">
                                    <Column Gap="0">
                                        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium"><Anchor Href="@($"deals/{deal.Id}")" InheritColor Underline="AnchorUnderline.Hover">@deal.Name</Anchor></TextBlock>
                                        <TextBlock Size="TextSize.Xs" Color="Color.Muted">
                                            @About(deal.Company?.Name, deal.Owner?.Name) ·
                                            <TextBlock As="span" Color="@(deal.ExpectedClose < _today ? Color.DangerText : Color.Muted)">@Closes(deal.ExpectedClose)</TextBlock>
                                        </TextBlock>
                                    </Column>
                                    <Row HiddenFrom="Breakpoint.Sm"><Badge Status="Tones.Of(deal.Stage)">@deal.Stage</Badge></Row>
                                </Column>
                            </ChildContent>
                            <ItemActions>
                                <Row Gap="3" Align="Align.Center">
                                    <Row VisibleFrom="Breakpoint.Sm"><Badge Status="Tones.Of(deal.Stage)">@deal.Stage</Badge></Row>
                                    <TextBlock As="span" Size="TextSize.Sm" Weight="FontWeight.Semibold" TabularNums>@Money(deal.Value)</TextBlock>
                                </Row>
                            </ItemActions>
                        </ListView>
                    }
                    else
                    {
                        <EmptyState Icon="Lucide.Handshake" Size="ControlSize.Sm" Title="No open deals" Description="The deals due to close soonest show here." />
                    }
                </CardBody>
            </Card>

            <Card Title="Won by source" TitleLevel="2" TitleId="report-sources">
                @if (_sources.Count > 0)
                {
                    <Chart Items="_sources" Argument="s => s.Source" TitledBy="report-sources" Orientation="Orientation.Horizontal" Height="Length.Rem(12)" BarWidth="0.5">
                        <ChartValueAxis HideLabels GridLines="false" />
                        <ChartBarSeries Value="s => s.Value" Name="Won" Labels="ChartLabels.Auto" LabelFormat="@_format" />
                    </Chart>
                }
                else
                {
                    <EmptyState Icon="Lucide.Trophy" Size="ControlSize.Sm" Title="Nothing won yet" Description="@($"Deals won in {_short} show here by where they came from.")" />
                }
            </Card>
        </Grid>
    </Column>
</Column>

@code {
    /// <summary>The period reported: "quarter", "year", or the month without it.</summary>
    [SupplyParameterFromQuery] private string? Period { get; set; }

    // An open deal is at risk when nothing has happened on it for this many days.
    private const int QuietDays = 14;

    // Deals closing next lists this many.
    private const int Shown = 4;

    private Workspace _workspace = new();
    private DateOnly _today;
    private string _period = "month", _name = "", _short = "", _before = "", _targetName = "monthly", _format = "";
    private List<Figure> _figures = [];
    private decimal _target;
    private List<Deal> _won = [], _open = [], _next = [];
    private List<MonthRevenue> _months = [];
    private List<StageValue> _stages = [];
    private List<Seller> _team = [];
    private List<Risk> _risks = [];
    private List<SourceValue> _sources = [];

    // A figure at the top: its value, how it changed from the period before, and its last three periods as a line.
    private sealed record Figure(string Label, string Value, string? Change, StatTrend Trend, string Against, double?[] History, string Format, string HistoryLabel);

    // A month of the revenue chart: what was won in it, and what open deals are due to close in it.
    private sealed record MonthRevenue(string Month, decimal? Won, decimal? Expected, string? Total);

    // A stage's open deals, with the bar's label: "$24,000 · 2 deals".
    private sealed record StageValue(string Stage, decimal Value, string Label);

    // Someone with a target: what they won in the period, the period's target, and where their bar's scale ends.
    private sealed record Seller(string Name, double Won, double Target, double Max);

    private sealed record Risk(Deal Deal, string Reason);

    private sealed record SourceValue(string Source, decimal Value);

    protected override async Task OnParametersSetAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync() ?? new Workspace();
        _today = Clock.Today(_workspace);
        _format = _workspace.CurrencySymbol + "#,##0";

        // The period: its first day, how many months it has, and what it and the one before are called.
        _period = Period is "quarter" or "year" ? Period : "month";
        var month = new DateOnly(_today.Year, _today.Month, 1);
        var (start, length) = _period switch
        {
            "quarter" => (new DateOnly(_today.Year, (_today.Month - 1) / 3 * 3 + 1, 1), 3),
            "year" => (new DateOnly(_today.Year, 1, 1), 12),
            _ => (month, 1),
        };
        var end = start.AddMonths(length);
        string Named(DateOnly from, bool full) => _period switch
        {
            "quarter" => full || from.Year != start.Year ? $"Q{(from.Month + 2) / 3} {from.Year}" : $"Q{(from.Month + 2) / 3}",
            "year" => from.Year.ToString(),
            _ => from.ToString(full || from.Year != start.Year ? "MMMM yyyy" : "MMMM"),
        };
        (_name, _short, _before) = (Named(start, true), Named(start, false), Named(start.AddMonths(-length), false));
        _targetName = _period switch { "quarter" => "quarterly", "year" => "yearly", _ => "monthly" };

        // Every deal, with who it's with and whose it is: a small team's pipeline is a few hundred rows, and SQLite
        // can't add up decimals itself.
        var deals = await Db.Deals.AsNoTracking().Include(d => d.Company).Include(d => d.Owner).ToListAsync();
        _open = deals.Where(d => d.IsOpen).ToList();
        List<Deal> WonIn(DateOnly from, DateOnly to) => deals.Where(d => d.Stage == DealStage.Won && d.Closed >= from && d.Closed < to).ToList();
        _won = WonIn(start, end);

        // The four figures, for this period and the two before it. The pipeline is read as it stood at each
        // period's end: the deals made by then and not yet closed, at today's values.
        var periods = Enumerable.Range(0, 3).Select(i => (From: start.AddMonths(-length * (2 - i)), To: start.AddMonths(-length * (1 - i)))).ToArray();
        int Lost(DateOnly from, DateOnly to) => deals.Count(d => d.Stage == DealStage.Lost && d.Closed >= from && d.Closed < to);
        double? Rate(DateOnly from, DateOnly to) => WonIn(from, to).Count is var won && won + Lost(from, to) is > 0 and var closed ? won / (double)closed : null;
        double? Average(DateOnly from, DateOnly to) => WonIn(from, to) is { Count: > 0 } won ? (double)Math.Round(won.Average(d => d.Value)) : null;
        double? OpenAt(DateOnly day) => (double)deals.Where(d => d.Created <= day && (d.Closed is null || d.Closed > day)).Sum(d => d.Value);
        var lastDay = start.AddDays(-1);
        var percent = "0%";
        Figure Of(string label, Func<DateOnly, DateOnly, double?> measure, string format, string none, bool points = false, string? against = null)
        {
            double?[] history = [.. periods.Select(p => measure(p.From, p.To))];
            var (now, before) = (history[2], history[1]);
            var value = now is { } v ? v.ToString(format) : "—";
            // A share changes by points, an amount by a share of what it was.
            var (change, trend) = now is not { } a || before is not { } b || (!points && b == 0) ? (null, StatTrend.None)
                : (points ? $"{Math.Abs(Math.Round((a - b) * 100)):N0} pts" : Math.Abs((a - b) / b).ToString("P0"), a > b ? StatTrend.Up : a < b ? StatTrend.Down : StatTrend.Flat);
            return new(label, value, change, trend, change is null ? none : $"vs {against ?? _before}", history, format, $"{label}, last 3 {_period}s");
        }

        _figures =
        [
            Of($"Won this {_period}", (from, to) => (double)WonIn(from, to).Sum(d => d.Value), _format, $"Nothing won in {_before}"),
            Of("Open pipeline", (_, to) => OpenAt(to > _today ? _today : to.AddDays(-1)), _format, $"Nothing open on {When.Date(lastDay, _today)}", against: When.Date(lastDay, _today)),
            Of("Win rate", Rate, percent, $"No deals closed in {_before}", points: true),
            Of("Average won deal", Average, _format, $"Nothing won in {_before}"),
        ];

        // Revenue by month: this month with two each side, or the quarter's or year's months. An open deal past its
        // close date is expected this month.
        var (first, count) = _period == "month" ? (month.AddMonths(-2), 5) : (start, length);
        _months = Enumerable.Range(0, count).Select(i => first.AddMonths(i)).Select(m =>
        {
            var won = WonIn(m, m.AddMonths(1)).Sum(d => d.Value);
            var expected = _open.Where(d => (d.ExpectedClose < month ? month : d.ExpectedClose) is var due && due >= m && due < m.AddMonths(1)).Sum(d => d.Value);
            return new MonthRevenue(m.ToString("MMM"), won, expected, won + expected == 0 ? null : Money(won + expected));
        }).ToList();

        // Open value by stage, in the pipeline's order.
        _stages = _open.GroupBy(d => d.Stage).OrderBy(g => g.Key)
            .Select(g => new StageValue(g.Key.ToString(), g.Sum(d => d.Value), $"{Money(g.Sum(d => d.Value))} · {Count(g.Count(), "deal")}")).ToList();

        // Each person with a target: the period's is their monthly one times its months. The team's is the chart's line.
        var sellers = await Db.Users.AsNoTracking().Where(u => u.MonthlyTarget != null).ToListAsync();
        sellers = sellers.Where(u => u.MonthlyTarget > 0).OrderBy(u => u.Name ?? u.Email).ToList();
        _target = sellers.Sum(u => u.MonthlyTarget!.Value);
        _team = sellers.Select(u =>
        {
            var (won, target) = ((double)_won.Where(d => d.OwnerId == u.Id).Sum(d => d.Value), (double)u.MonthlyTarget!.Value * length);
            return new Seller(u.Name ?? u.Email ?? "", won, target, Math.Max(target * 1.25, won));
        }).ToList();

        // At risk: past its close date, with nothing ahead on the calendar, or quiet for two weeks. A deal's last
        // activity is the latest of when it was created or changed, an activity on it finished, or a note written.
        var openIds = _open.Select(d => d.Id).ToList();
        var activities = await Db.Activities.AsNoTracking().Where(a => a.DealId != null && openIds.Contains(a.DealId.Value))
            .Select(a => new { DealId = a.DealId!.Value, a.Completed }).ToListAsync();
        var notes = await Db.Notes.AsNoTracking().Where(n => n.DealId != null && openIds.Contains(n.DealId.Value))
            .Select(n => new { DealId = n.DealId!.Value, n.Created }).ToListAsync();
        var keys = openIds.Select(id => id.ToString()).ToList();
        var changes = await Db.AuditEvents.AsNoTracking().Where(e => e.EntityType == nameof(Deal) && keys.Contains(e.EntityId!))
            .Select(e => new { e.EntityId, e.Time }).ToListAsync();
        DateOnly Local(DateTime utc) => DateOnly.FromDateTime(When.Local(utc, _workspace));
        _risks = _open.OrderByDescending(d => d.Value).Select(d =>
        {
            var last = new[] { d.Created }
                .Concat(activities.Where(a => a.DealId == d.Id && a.Completed != null).Select(a => Local(a.Completed!.Value)))
                .Concat(notes.Where(n => n.DealId == d.Id).Select(n => Local(n.Created)))
                .Concat(changes.Where(e => e.EntityId == d.Id.ToString()).Select(e => Local(e.Time)))
                .Max();
            var quiet = _today.DayNumber - last.DayNumber;
            var reason = d.ExpectedClose < _today ? "Close date passed"
                : !activities.Any(a => a.DealId == d.Id && a.Completed == null) ? "No next step"
                : quiet >= QuietDays ? $"No activity in {quiet:N0} days"
                : null;
            return reason is null ? null : new Risk(d, reason);
        }).OfType<Risk>().ToList();

        _next = _open.OrderBy(d => d.ExpectedClose).ThenByDescending(d => d.Value).Take(Shown).ToList();

        _sources = _won.GroupBy(d => d.Source).Select(g => new SourceValue(g.Key is { } source ? Names.Of(source) : "Not recorded", g.Sum(d => d.Value)))
            .OrderByDescending(s => s.Value).ToList();
    }

    // "Closes tomorrow", "Closes Nov 27"; "Was due Nov 12" once the day has passed.
    private string Closes(DateOnly day) => day < _today ? $"Was due {When.Date(day, _today)}"
        : $"Closes {(day.DayNumber - _today.DayNumber <= 1 ? When.Day(day, _today).ToLowerInvariant() : When.Date(day, _today))}";

    private string Money(decimal amount) => _workspace.Money(amount);

    private static string Count(int count, string noun) => $"{count:N0} {noun}{(count == 1 ? "" : "s")}";

    private static string About(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
}
