@page "/contacts/import"
@attribute [Authorize(Policy = Policies.EditRecords)]
@using Microsoft.AspNetCore.Http
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation

<PageTitle>Import contacts</PageTitle>

@* Import contacts, step one: a CSV file and what to do with it. Preview import reads the file, keeps it
   (Data/ContactImport.cs) and goes to its preview (ImportPreview.razor), where nothing has been imported yet. A
   file that can't be imported at all, such as one with no email column, is refused here, under the upload. *@
<Column Gap="6" MaxWidth="Length.Rem(48)">
    <PageCrumbs Trail>
        <BreadcrumbItem Href="contacts">Contacts</BreadcrumbItem>
        <BreadcrumbItem>Import contacts</BreadcrumbItem>
    </PageCrumbs>
    <PageHeader Title="Import contacts" Description="Bring existing relationships into your workspace." />

    <Form Model="Input" FormName="import-contacts" OnSubmit="PreviewAsync">
        <Card Dividers>
            <CardBody>
                <Fieldset Label="Upload a CSV" Description="Expected columns: first_name, last_name, email, company, phone.">
                    <FileUpload Name="File" Label="Choose CSV file" Accept=".csv" MaxFileSize="ContactImport.MaxBytes" Required Errors="_problems"
                                Hint="One contact per row. The first row should contain column names." />
                </Fieldset>
            </CardBody>
            <CardBody>
                <Fieldset Label="Import options" Description="Choose how to handle matching contacts." Columns="2">
                    <RadioGroup @bind-Value="Input!.Match" Label="When an email already exists" ColSpan="GridSpan.Full" />
                    <Select @bind-Value="Input!.OwnerId" Label="Owner for new contacts" Items="_ownerIds" ItemText="id => _owners[id!]" />
                </Fieldset>
            </CardBody>
            <CardFooter Justify="Justify.End">
                <Button Href="contacts" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Cancel</Button>
                <Button Submit>Preview import</Button>
            </CardFooter>
        </Card>
    </Form>
</Column>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    [CascadingParameter] private HttpContext? Http { get; set; }

    // The options; the file itself is read from the request.
    [SupplyParameterFromForm(FormName = "import-contacts")] private Options? Input { get; set; }

    private sealed class Options
    {
        public ImportMatch Match { get; set; }
        public string? OwnerId { get; set; }
    }

    // The team, by name: who the new contacts can belong to.
    private Dictionary<string, string> _owners = [];
    private List<string?> _ownerIds = [];
    private string? _me;
    private IReadOnlyList<string>? _problems;

    protected override async Task OnInitializedAsync()
    {
        _owners = (await Db.Users.AsNoTracking().ToListAsync()).ToDictionary(u => u.Id, u => u.Name ?? u.Email ?? "");
        _ownerIds = _owners.OrderBy(o => o.Value).Select(o => (string?)o.Key).ToList();
        _me = (await AuthState).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        // Yours, unless you say otherwise.
        Input ??= new() { OwnerId = _me };
    }

    private async Task PreviewAsync()
    {
        var file = Http?.Request.HasFormContentType == true ? Http.Request.Form.Files["File"] : null;
        var (import, problem) = await ContactImport.ReadAsync(file);
        if (import is null)
        {
            _problems = [problem!];
            return;
        }

        (import.Match, import.OwnerId) = (Input!.Match, Input.OwnerId is { } owner && _owners.ContainsKey(owner) ? owner : _me);
        (import.CreatedById, import.Created) = (_me, DateTime.UtcNow);
        // Uploads nobody imported are cleared out after a day.
        var old = DateTime.UtcNow.AddDays(-1);
        await Db.ContactImports.Where(i => i.Created < old).ExecuteDeleteAsync();
        Db.ContactImports.Add(import);
        await Db.SaveChangesAsync();
        Navigation.NavigateTo($"contacts/import/{import.Id}");
    }
}
