@page "/contacts"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation

<PageTitle>Contacts</PageTitle>

@* Contacts: everyone the team knows, the one last heard from first. The grid searches, filters by status, sorts
   and pages in the database. Add contact opens the contact form over the list (Components/Contacts/ContactDialog.razor,
   ?dialog=new-contact) and Import contacts the import's (Components/Imports/ImportDialog.razor,
   ?dialog=import-contacts); a contact's own page has Edit. People who can't edit records (Viewers) see the list alone.
   With no contacts at all the page is its first-use state: the two ways to add them, in a card. *@
<PageCrumbs><BreadcrumbItem>Contacts</BreadcrumbItem></PageCrumbs>

@if (_none)
{
    @* First use: no contacts yet, so the page is the way to add the first. *@
    <Column Gap="6">
        <PageHeader Title="Contacts" Description="Start building your customer relationships." />
        <Card>
            @if (_canEdit)
            {
                <EmptyState Icon="Lucide.Users" Accent="Accent.Primary" Title="Your first relationship starts here" TitleLevel="2"
                            Description="Add a contact to keep their details, conversations, and follow-ups together.">
                    <EmptyStateActions>
                        <Button Href="@Navigation.GetUriWithQueryParameter("dialog", ContactDialog.NewId)" StartIcon="Lucide.Plus">Add your first contact</Button>
                        <Button Href="@Navigation.GetUriWithQueryParameter("dialog", ImportDialog.IdOf(ImportKind.Contacts))" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Upload">Import a CSV</Button>
                    </EmptyStateActions>
                </EmptyState>
            }
            else
            {
                <EmptyState Icon="Lucide.Users" Accent="Accent.Primary" Title="No contacts yet" TitleLevel="2" Description="Contacts your team adds show here." />
            }
        </Card>
    </Column>
}
else
{
    @* A list page: it fills the main area, so the grid scrolls its rows under its header and its pages stay in view. *@
    <Column Gap="6" Grow>
        <PageHeader Title="Contacts" Description="The people behind your relationships.">
            @* On a phone the two float in the corner, behind one button. *@
            @if (_canEdit)
            {
                <PageHeaderActions FloatLabel="Add contacts">
                    <Button Href="@Navigation.GetUriWithQueryParameter("dialog", ImportDialog.IdOf(ImportKind.Contacts))" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Upload" FloatBelow="Breakpoint.Sm">Import contacts</Button>
                    <Button Href="@Navigation.GetUriWithQueryParameter("dialog", ContactDialog.NewId)" StartIcon="Lucide.Plus" FloatBelow="Breakpoint.Sm">Add contact</Button>
                </PageHeaderActions>
            }
        </PageHeader>

        <DataGrid id="contacts" TItem="Contact" ItemsProvider="FindAsync" ItemKey="c => c.Id.ToString()" RowLabel="c => c.Name" Caption="Contacts"
                  PageSize="25" InitialSort="-lastactivity" Searchable SearchLabel="Search contacts…" SmallScreen="DataGridSmallScreen.HideColumns" Grow>
            <ToolbarContent>
                <DataGridSearch />
                <DataGridFilter Column="status" />
                <DataGridFilter Column="owner" />
            </ToolbarContent>
            <NoMatchesContent>
                <EmptyState TitleLevel="2" Icon="Lucide.SearchX" Title="No matching contacts" Description="Try a different name, company, or email address. Your other contacts are still here." />
            </NoMatchesContent>
            <Columns>
                <TemplateColumn Title="Name" SortKey="name" SortBy="c => c.FirstName" Sortable Context="contact">
                    <Row Gap="3" Align="Align.Center">
                        <Avatar Name="@contact.Name" Size="AvatarSize.Sm" Decorative />
                        <Stack Gap="0" Grow>
                            <TextBlock Weight="FontWeight.Medium" Truncate><Anchor Href="@($"contacts/{contact.Id}")" InheritColor Underline="AnchorUnderline.Hover">@contact.Name</Anchor></TextBlock>
                            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Truncate>@contact.Email</TextBlock>
                        </Stack>
                    </Row>
                </TemplateColumn>
                <TemplateColumn Title="Company" SortKey="company" SortBy="c => c.Company!.Name" Sortable Context="contact">
                    @contact.Company?.Name
                </TemplateColumn>
                <PropertyColumn Property="c => c.Status" Width="Length.Rem(7)" Priority="1" Sortable Filterable Context="contact">
                    <Badge Status="Tones.Of(contact.Status)">@contact.Status</Badge>
                </PropertyColumn>
                <TemplateColumn Title="Owner" SortKey="owner" SortBy="c => c.Owner!.Name" FilterBy="c => c.OwnerId" Sortable Filterable
                                FilterText="@(values => values[0] is { } id && _team.TryGetValue(id, out var name) ? (id == _me ? "Me" : name) : "")" Context="contact">
                    <FilterTemplate Context="filter">
                        <Select TValue="string" Label="Owner" HideLabel Items="_teamIds" ItemText="@(id => id == _me ? "Me" : _team[id])" Placeholder="All owners"
                                Value="@filter.Value" ValueChanged="filter.SetAsync" ValueExpression="() => filter.Value" @attributes="filter.Attributes" />
                    </FilterTemplate>
                    <ChildContent>@contact.Owner?.Name</ChildContent>
                </TemplateColumn>
                <PropertyColumn Property="c => c.LastActivity" Title="Last activity" Width="Length.Rem(9)" Sortable Context="contact">
                    @(contact.LastActivity is { } at ? When.Day(DateOnly.FromDateTime(When.Local(at, _workspace)), _today) : null)
                </PropertyColumn>
            </Columns>
        </DataGrid>
    </Column>
}

<ContactDialog CanEdit="_canEdit" />
<ImportDialog Kind="ImportKind.Contacts" CanEdit="_canEdit" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Who may add: the EditRecords policy.
    private bool _canEdit;

    // No contacts at all yet: the first-use page.
    private bool _none;
    private Workspace? _workspace;
    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        _canEdit = (await Authorization.AuthorizeAsync((await AuthState).User, Policies.EditRecords)).Succeeded;
        await LoadTeamAsync((await AuthState).User);
        _none = !await Db.Contacts.AnyAsync();
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        _today = DateOnly.FromDateTime(Clock.Now(_workspace));
    }

    // The grid's page of contacts, from the database. Its search looks in names, emails and company names.
    private async ValueTask<DataResult<Contact>> FindAsync(DataRequest<Contact> request)
    {
        var query = Db.Contacts.AsNoTracking().Include(c => c.Company).Include(c => c.Owner).AsQueryable();
        // Lower case on both sides, so "olivia" finds Olivia in any database.
        if (request.Search?.Trim().ToLower() is { Length: > 0 } search)
        {
            query = query.Where(c => (c.FirstName + " " + c.LastName).ToLower().Contains(search) || (c.Email != null && c.Email.ToLower().Contains(search)) || c.Company!.Name.ToLower().Contains(search));
        }
        return await (request with { Search = null }).ToResultAsync(query, (q, ct) => q.CountAsync(ct), (q, ct) => q.ToListAsync(ct));
    }

    // The Owner filter's choices: you, then the rest of the team by name.
    private string? _me;
    private Dictionary<string, string> _team = [];
    private List<string> _teamIds = [];

    private async Task LoadTeamAsync(System.Security.Claims.ClaimsPrincipal user)
    {
        _me = user.UserId();
        _team = (await Db.Users.AsNoTracking().ToListAsync()).ToDictionary(u => u.Id, u => u.Name ?? u.Email ?? "");
        _teamIds = [.. _team.OrderBy(u => u.Key != _me).ThenBy(u => u.Value).Select(u => u.Key)];
    }
}
