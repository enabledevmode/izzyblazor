@page "/contacts/{Id:int}"
@page "/contacts/{Id:int}/{Section}"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization

<PageTitle>@(_contact?.Name ?? "Contact")</PageTitle>

@* A contact: who they are, and everything the team has done with them. Its sections are tabs with an address
   each (/contacts/7, /contacts/7/deals, /tasks), so each loads only its own data, can be linked to, and
   Back works. Beside every section: what's next on the calendar, the contact's details and their background
   (Edit opens the contact form over the page: Components/Contacts/ContactDialog.razor). On a phone Email and Call are a row under the header, New deal floats in the
   corner, and what's next comes before the sections. Activity is one feed of what happened and the team's notes (Components/Activities/ActivityFeed.razor). People who can't edit records (Viewers)
   read everything and can email or call, and see no other buttons. *@
@if (_contact is { } contact)
{
    <Column Gap="6">
        @* In the column, so on a phone the trail has the page's gap above the title. *@
        <PageCrumbs Trail>
            <BreadcrumbItem Href="contacts">Contacts</BreadcrumbItem>
            <BreadcrumbItem>@contact.Name</BreadcrumbItem>
        </PageCrumbs>
        <PageHeader Title="@contact.Name" Description="@Summary(contact)">
            <PageHeaderMedia><Avatar Name="@contact.Name" Size="AvatarSize.Lg" Decorative /></PageHeaderMedia>
            @* On a phone Email and Call are a row under the header, and New deal floats in the corner. *@
            <PageHeaderActions>
                <Button Href="@($"mailto:{contact.Email}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Mail" VisibleFrom="Breakpoint.Sm">Email</Button>
                @if (Tel(contact) is { } tel)
                {
                    <Button Href="@tel" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Phone" VisibleFrom="Breakpoint.Sm">Call</Button>
                }
                @if (_canEdit)
                {
                    <Button Href="@NewDealHref" StartIcon="Lucide.Plus" FloatBelow="Breakpoint.Sm">New deal</Button>
                }
            </PageHeaderActions>
        </PageHeader>

        <Grid Columns="2" Gap="3" HiddenFrom="Breakpoint.Sm">
            <Button Href="@($"mailto:{contact.Email}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Mail" FullWidth>Email</Button>
            @if (Tel(contact) is { } phone)
            {
                <Button Href="@phone" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Phone" FullWidth>Call</Button>
            }
        </Grid>

        @* Above the sections until the side column shows (1024px). *@
        <Box HiddenFrom="Breakpoint.Lg">@NextFollowUp</Box>

        <TabNav Label="Contact sections">
            <TabLink Href="@($"contacts/{Id}")" Label="Activity" Match="NavLinkMatch.All" />
            <TabLink Href="@($"contacts/{Id}/deals")" Label="Deals" />
            <TabLink Href="@($"contacts/{Id}/tasks")" Label="Tasks" />
        </TabNav>

        @* The section, and beside it from 1024px the details: under it on smaller screens. *@
        <Grid Template="@(new() { Base = "minmax(0, 1fr)", Lg = "minmax(0, 1fr) 20rem" })" Gap="4" Align="Align.Start">
            <Column Gap="4">
                @switch (Section)
                {
                    case null:
                        <ActivityFeed Title="Relationship timeline" Items="_history" Href="@($"contacts/{Id}")" On="@($"contacts/{Id}")" CanEdit="_canEdit" />
                        break;

                    case "deals":
                        @if (_deals.Count > 0)
                        {
                            <ListView Items="_deals" ItemKey="d => d.Id.ToString()" Label="@($"Deals with {contact.FirstName}")" Bordered
                                      ItemText="d => d.Name" ItemHref="@(d => $"deals/{d.Id}")"
                                      ItemDescription="@(d => $"{_workspace!.Money(d.Value)} · {(d.IsOpen ? "Expected" : "Closed")} {When.Date(d.Closed ?? d.ExpectedClose, _today)}")" Context="deal">
                                <ItemActions><Badge Status="Tones.Of(deal.Stage)">@deal.Stage</Badge></ItemActions>
                            </ListView>
                        }
                        else
                        {
                            <Card><EmptyState TitleLevel="2" Icon="Lucide.Handshake" Size="ControlSize.Sm" Title="No deals" Description="@($"Deals with {contact.FirstName} show here.")" /></Card>
                        }
                        break;

                    case "tasks":
                        <Card>
                            <CardBody Flush>
                                @if (_tasks.Count > 0)
                                {
                                    <TaskList Tasks="_tasks" Today="_today" Label="@($"Tasks for {contact.FirstName}")" />
                                }
                                else
                                {
                                    <EmptyState Icon="Lucide.CircleCheck" Size="ControlSize.Sm" Title="No open tasks" Description="@($"Tasks for {contact.FirstName} show here.")" />
                                }
                            </CardBody>
                        </Card>
                        break;
                }
            </Column>

            <Column Gap="4">
                <Box VisibleFrom="Breakpoint.Lg">@NextFollowUp</Box>

                <Card Title="Contact details" TitleLevel="2">
                    @if (_canEdit)
                    {
                        <CardActions>
                            <Button Href="@EditHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Pencil">Edit</Button>
                        </CardActions>
                    }
                    <DescriptionList Orientation="Orientation.Vertical">
                        <DescriptionItem Term="Email"><Anchor Href="@($"mailto:{contact.Email}")">@contact.Email</Anchor></DescriptionItem>
                        @if (Tel(contact) is { } tel)
                        {
                            <DescriptionItem Term="Phone"><Anchor Href="@tel">@contact.Phone</Anchor></DescriptionItem>
                        }
                        @if (contact.Company is { } company)
                        {
                            <DescriptionItem Term="Company"><Anchor Href="@($"companies/{company.Id}")">@company.Name</Anchor></DescriptionItem>
                        }
                        @if (contact.Owner is { } owner)
                        {
                            <DescriptionItem Term="Relationship owner">@owner.Name</DescriptionItem>
                        }
                        <DescriptionItem Term="Status"><Badge Status="Tones.Of(contact.Status)">@contact.Status</Badge></DescriptionItem>
                    </DescriptionList>
                </Card>

                @* What's worth knowing about them: the contact's own Background field, edited with the rest. *@
                @if (contact.Notes?.Trim() is { Length: > 0 } background)
                {
                    <Card Title="Background" TitleLevel="2">
                        @if (_canEdit)
                        {
                            <CardActions>
                                <Button Href="@EditHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Pencil" aria-label="Edit background">Edit</Button>
                            </CardActions>
                        }
                        @* Three lines, the rest behind Show more: a long one doesn't push the page down. *@
                        <ShowMore Lines="3">
                            <TextBlock Color="Color.Muted" KeepLines>@background</TextBlock>
                        </ShowMore>
                    </Card>
                }
            </Column>
        </Grid>
    </Column>

    <ContactDialog CanEdit="_canEdit" Contact="Id" />
    <DealDialog CanEdit="_canEdit" Contact="Id" />
    <ActivityDialog CanEdit="_canEdit" Contact="Id" />
    <NoteDialog CanEdit="_canEdit" Contact="Id" />
}

@code {
    /// <summary>The contact.</summary>
    [Parameter] public int Id { get; set; }

    /// <summary>The tab: none for Activity, or "deals", "tasks".</summary>
    [Parameter] public string? Section { get; set; }

    /// <summary>The tasks just ticked here, which stay in the list: "4,7".</summary>
    [SupplyParameterFromQuery] private string? Done { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Workspace? _workspace;
    private DateOnly _today;
    private Contact? _contact;
    private Activity? _next;
    private List<FeedItem> _history = [];
    private List<Deal> _deals = [];
    private List<Activity> _tasks = [];
    private bool _canEdit;

    // This tab's address, without its query.
    private string Here => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];

    // Edit opens the contact form over this tab.
    private string EditHref => $"{Here}?dialog={ContactDialog.EditId}";

    // New deal opens the deal form over this tab, with the contact and their company chosen.
    private string NewDealHref => $"{Here}?dialog={DealDialog.NewId}";

    // Schedule activity opens the activity form over this tab, with the contact chosen.
    private string NewActivityHref => $"{Here}?dialog={ActivityDialog.NewId}";

    // What's next on the calendar with them: beside the sections on a wide screen, above them on a small one.
    private RenderFragment NextFollowUp => __builder =>
    {
        <Card Title="Next follow-up" TitleLevel="2">
            <CardBody Gap="3" Align="Align.Start">
                @if (_next is { } next)
                {
                    <Column Gap="0">
                        <Heading Level="3" Size="TextSize.Sm">@next.Title</Heading>
                        <TextBlock Color="Color.Muted">@($"{When.Day(DateOnly.FromDateTime(next.Start), _today)} · {When.Time(next.Start)}")</TextBlock>
                    </Column>
                }
                else
                {
                    <TextBlock Color="Color.Muted">Nothing scheduled.</TextBlock>
                }
                @if (_canEdit)
                {
                    <Button Href="@NewActivityHref" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Schedule activity</Button>
                }
            </CardBody>
        </Card>
    };

    protected override async Task OnParametersSetAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        var now = Clock.Now(_workspace);
        _today = DateOnly.FromDateTime(now);
        var user = (await AuthState).User;
        _canEdit = (await Authorization.AuthorizeAsync(user, Policies.EditRecords)).Succeeded;

        _contact = await Db.Contacts.AsNoTracking().Include(c => c.Company).Include(c => c.Owner).FirstOrDefaultAsync(c => c.Id == Id);
        if (_contact is null || Section is not (null or "deals" or "tasks"))
        {
            _contact = null;
            Navigation.NotFound();
            return;
        }

        // What's next on the calendar with them: the first open activity that hasn't started.
        _next = await Db.Activities.AsNoTracking()
            .Where(a => a.ContactId == Id && a.Completed == null && a.Start >= now).OrderBy(a => a.Start).FirstOrDefaultAsync();

        switch (Section)
        {
            case null:
                await LoadHistoryAsync(_contact);
                break;
            case "deals":
                // The open ones by when they should close, then won and lost, the latest first.
                var deals = await Db.Deals.AsNoTracking().Where(d => d.ContactId == Id).ToListAsync();
                _deals = [.. deals.Where(d => d.IsOpen).OrderBy(d => d.ExpectedClose), .. deals.Where(d => !d.IsOpen).OrderByDescending(d => d.Closed)];
                break;
            case "tasks":
                // Their open tasks, and those just ticked (?done=, from TaskCheck), which stay in sight.
                var ticked = TaskCheck.Ids(Done);
                _tasks = await Db.Activities.AsNoTracking()
                    .Include(a => a.Contact!.Company).Include(a => a.Deal!.Company)
                    .Where(a => a.Type == ActivityType.Task && a.ContactId == Id && (a.Completed == null || ticked.Contains(a.Id)))
                    .OrderBy(a => a.Start).ToListAsync();
                break;
        }
    }

    // The number as a link that calls: its digits, a leading + kept. Null without one.
    private static string? Tel(Contact contact) =>
        string.IsNullOrWhiteSpace(contact.Phone) ? null : $"tel:{new string(contact.Phone.Where(c => char.IsDigit(c) || c == '+').ToArray())}";

    // The feed, newest first: every activity with them that's finished, the notes about them, then the day they
    // were added.
    private async Task LoadHistoryAsync(Contact contact)
    {
        var done = await Db.Activities.AsNoTracking().Include(a => a.AssignedTo)
            .Where(a => a.ContactId == Id && a.Completed != null).OrderByDescending(a => a.Completed).ToListAsync();
        _history = done.Select(a =>
        {
            var at = When.Local(a.Completed!.Value, _workspace);
            return new FeedItem(FeedItem.KindOf(a),
                a.Type switch
                {
                    ActivityType.Call => $"Call logged · {a.Duration} minutes",
                    ActivityType.Meeting => $"Meeting held · {a.Duration} minutes",
                    _ => a.Title,
                },
                a.Agenda, a.AssignedTo?.Name, When.At(at, _today), at);
        }).ToList();

        var notes = await Db.Notes.AsNoTracking().Include(n => n.Author).Include(n => n.Contact).Include(n => n.Deal).Include(n => n.Company).Include(n => n.Activity)
            .Where(n => n.ContactId == Id).ToListAsync();
        _history.AddRange(notes.Select(n => FeedItem.Of(n, _workspace, _today)));
        _history = _history.OrderByDescending(h => h.When).ToList();

        // Who added them, from the audit log; the day is the contact's own.
        var id = Id.ToString();
        var added = await Db.AuditEvents.AsNoTracking()
            .Where(e => e.Action == AuditActions.Created && e.EntityType == nameof(Contact) && e.EntityId == id).OrderBy(e => e.Time).FirstOrDefaultAsync();
        _history.Add(new FeedItem(FeedKind.Event, "Contact added", null, added?.ActorName, When.Day(contact.Added, _today), contact.Added.ToDateTime(TimeOnly.MinValue)));
    }

    // Under the name: "Marketing director · Acme Co.". Without a job title, the status takes its place after the
    // company ("Acme Co. · Customer"); all three wrap on a phone, and the status is in Contact details.
    private static string Summary(Contact contact) => string.IsNullOrWhiteSpace(contact.JobTitle)
        ? About(contact.Company?.Name, contact.Status.ToString())
        : About(contact.JobTitle, contact.Company?.Name);

    private static string About(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
}
