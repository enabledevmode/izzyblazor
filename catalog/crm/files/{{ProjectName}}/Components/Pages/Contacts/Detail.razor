@page "/contacts/{Id:int}"
@page "/contacts/{Id:int}/{Section}"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization
@inject ToastService Toasts

<PageTitle>@(_contact?.Name ?? "Contact")</PageTitle>

@* A contact: who they are, and everything the team has done with them. Its sections are tabs with an address
   each (/contacts/7, /contacts/7/deals, /tasks, /notes), so each loads only its own data, can be linked to, and
   Back works. Beside every section: what's next on the calendar, the contact's details and their background
   (Edit opens the Contacts grid's dialog and comes back here). On a phone the header's buttons float in the
   corner, and what's next comes before the sections. Notes are the team's own, newest first: a short one is written here and
   shows whole; a titled one shows how it opens and links to the rest. People who can't edit records (Viewers)
   read everything and can email or call, and see no other buttons. *@
@if (_contact is { } contact)
{
    <Column Gap="6">
        @* In the column, so on a phone the trail has the page's gap above the title. *@
        <PageCrumbs Trail>
            <BreadcrumbItem Href="contacts">Contacts</BreadcrumbItem>
            <BreadcrumbItem>@contact.Name</BreadcrumbItem>
        </PageCrumbs>
        <PageHeader Title="@contact.Name" Description="@Summary(contact)">
            <PageHeaderMedia><Avatar Name="@contact.Name" Size="AvatarSize.Lg" Decorative /></PageHeaderMedia>
            @* On a phone all four float in the corner, behind one button: one place for what you can do. *@
            <PageHeaderActions FloatLabel="Contact actions">
                <Button Href="@($"mailto:{contact.Email}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Mail" FloatBelow="Breakpoint.Sm">Email</Button>
                @if (Tel(contact) is { } tel)
                {
                    <Button Href="@tel" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Phone" FloatBelow="Breakpoint.Sm">Call</Button>
                }
                @if (_canEdit)
                {
                    <Button Href="@($"activities/new?contact={Id}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.CalendarPlus" FloatBelow="Breakpoint.Sm">Log activity</Button>
                    <Button Href="@($"deals/new?contact={Id}")" StartIcon="Lucide.Plus" FloatBelow="Breakpoint.Sm">New deal</Button>
                }
            </PageHeaderActions>
        </PageHeader>

        @* Above the sections until the side column shows (1024px). *@
        <Box HiddenFrom="Breakpoint.Lg">@NextFollowUp</Box>

        <TabNav Label="Contact sections">
            <TabLink Href="@($"contacts/{Id}")" Label="Activity" Match="NavLinkMatch.All" />
            <TabLink Href="@($"contacts/{Id}/deals")" Label="Deals" />
            <TabLink Href="@($"contacts/{Id}/tasks")" Label="Tasks" />
            <TabLink Href="@($"contacts/{Id}/notes")" Label="Notes" />
        </TabNav>

        @* The section, and beside it from 1024px the details: under it on smaller screens. *@
        <Grid Template="@(new() { Base = "minmax(0, 1fr)", Lg = "minmax(0, 1fr) 20rem" })" Gap="4" Align="Align.Start">
            <Column Gap="4">
                @switch (Section)
                {
                    case null:
                        <Card Title="Relationship timeline" TitleLevel="2">
                            <CardActions><Badge>All activity</Badge></CardActions>
                            <Timeline TimePlacement="TimelinePlacement.Below" Size="ControlSize.Sm">
                                @foreach (var item in _history)
                                {
                                    <TimelineItem Title="@item.Title" Time="@item.Time" DateTime="@item.When.ToString("yyyy-MM-ddTHH:mm")">
                                        @if (!string.IsNullOrWhiteSpace(item.About))
                                        {
                                            <TextBlock Size="TextSize.Sm" Color="Color.Muted">@item.About</TextBlock>
                                        }
                                    </TimelineItem>
                                }
                            </Timeline>
                        </Card>
                        break;

                    case "deals":
                        @if (_deals.Count > 0)
                        {
                            <ListView Items="_deals" ItemKey="d => d.Id.ToString()" Label="@($"Deals with {contact.FirstName}")" Bordered
                                      ItemText="d => d.Name" ItemHref="@(d => $"deals/{d.Id}")"
                                      ItemDescription="@(d => $"{_workspace!.Money(d.Value)} · Expected {When.Date(d.ExpectedClose, _today)}")" Context="deal">
                                <ItemActions><Badge Status="Tones.Of(deal.Stage)">@deal.Stage</Badge></ItemActions>
                            </ListView>
                        }
                        else
                        {
                            <Card><EmptyState Icon="Lucide.Handshake" Size="ControlSize.Sm" Title="No open deals" Description="@($"Deals with {contact.FirstName} show here.")" /></Card>
                        }
                        break;

                    case "tasks":
                        <Card>
                            <CardBody Flush>
                                @if (_tasks.Count > 0)
                                {
                                    <TaskList Tasks="_tasks" Today="_today" Label="@($"Tasks for {contact.FirstName}")" />
                                }
                                else
                                {
                                    <EmptyState Icon="Lucide.CircleCheck" Size="ControlSize.Sm" Title="No open tasks" Description="@($"Tasks for {contact.FirstName} show here.")" />
                                }
                            </CardBody>
                        </Card>
                        break;

                    case "notes":
                        @if (_canEdit)
                        {
                            <Card>
                                <Form Model="Draft" FormName="add-note" OnValidSubmit="AddNoteAsync" RequiredMark="RequiredMark.None">
                                    <TextArea @bind-Value="Draft!.Body" Label="Note" Rows="3" AutoGrow Placeholder="Goals, decisions, and next steps…" />
                                    <FormActions>
                                        <Button Submit>Add note</Button>
                                    </FormActions>
                                </Form>
                            </Card>
                        }
                        @foreach (var note in _notes)
                        {
                            <Card @key="note.Id">
                                <Comment Author="@(note.Author?.Name ?? "Someone")" Time="When.Zoned(note.Created, _workspace)" TimeText="@Written(note.Created)" Text="@note.Summary" HeadingLevel="3">
                                    <Extra>
                                        @if (_canEdit)
                                        {
                                            <Menu Placement="Placement.BottomEnd">
                                                <Trigger>
                                                    <IconButton Label="Note options" Icon="Lucide.Ellipsis" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" @attributes="context" />
                                                </Trigger>
                                                <ChildContent>
                                                    <MenuItem Href="@($"notes/{note.Id}/edit")" Icon="Lucide.Pencil">Edit</MenuItem>
                                                    <MenuItem Href="@($"contacts/{Id}/notes?dialog=delete-note&note={note.Id}")" Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
                                                </ChildContent>
                                            </Menu>
                                        }
                                    </Extra>
                                    <Actions>
                                        @if (note.Title.Length > 0)
                                        {
                                            <Row Gap="2" Align="Align.Center">
                                                <Icon Name="Lucide.FileText" Size="IconSize.Sm" />
                                                <TextBlock As="span" Size="TextSize.Sm"><Anchor Href="@($"notes/{note.Id}")">@note.Title</Anchor></TextBlock>
                                            </Row>
                                        }
                                    </Actions>
                                </Comment>
                            </Card>
                        }
                        @if (_notes.Count == 0 && !_canEdit)
                        {
                            <Card><EmptyState Icon="Lucide.NotebookPen" Size="ControlSize.Sm" Title="No notes yet" Description="@($"Notes about {contact.FirstName} show here.")" /></Card>
                        }

                        @* Delete asks first: the menu's link opens this (?dialog=delete-note&note=5). *@
                        @if (_canEdit && _notes.FirstOrDefault(n => n.Id == Note) is { } doomed)
                        {
                            <Dialog Id="delete-note" Title="Delete this note?" Size="DialogSize.Sm">
                                <Form Model="Delete" FormName="delete-note" OnValidSubmit="DeleteNoteAsync">
                                    <input type="hidden" name="Delete.Id" value="@doomed.Id" />
                                    <TextBlock Color="Color.Muted">@(doomed.Title.Length > 0 ? doomed.Title : doomed.Summary)</TextBlock>
                                    <DialogFooter>
                                        <DialogClose>Cancel</DialogClose>
                                        <Button Submit Accent="Accent.Danger">Delete</Button>
                                    </DialogFooter>
                                </Form>
                            </Dialog>
                        }
                        break;
                }
            </Column>

            <Column Gap="4">
                <Box VisibleFrom="Breakpoint.Lg">@NextFollowUp</Box>

                <Card Title="Contact details" TitleLevel="2">
                    @if (_canEdit)
                    {
                        <CardActions>
                            <Button Href="@EditHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Pencil">Edit</Button>
                        </CardActions>
                    }
                    <DescriptionList Orientation="Orientation.Vertical">
                        <DescriptionItem Term="Email"><Anchor Href="@($"mailto:{contact.Email}")">@contact.Email</Anchor></DescriptionItem>
                        @if (Tel(contact) is { } tel)
                        {
                            <DescriptionItem Term="Phone"><Anchor Href="@tel">@contact.Phone</Anchor></DescriptionItem>
                        }
                        @if (contact.Company is { } company)
                        {
                            <DescriptionItem Term="Company"><Anchor Href="@($"companies/{company.Id}")">@company.Name</Anchor></DescriptionItem>
                        }
                        @if (contact.Owner is { } owner)
                        {
                            <DescriptionItem Term="Relationship owner">@owner.Name</DescriptionItem>
                        }
                        <DescriptionItem Term="Status"><Badge Status="Tones.Of(contact.Status)">@contact.Status</Badge></DescriptionItem>
                    </DescriptionList>
                </Card>

                @* What's worth knowing about them: the contact's own Background field, edited with the rest. *@
                @if (Paragraphs(contact.Notes) is { Length: > 0 } background)
                {
                    <Card Title="Background" TitleLevel="2">
                        @if (_canEdit)
                        {
                            <CardActions>
                                <Button Href="@EditHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Pencil" aria-label="Edit background">Edit</Button>
                            </CardActions>
                        }
                        <CardBody Gap="3">
                            @foreach (var paragraph in background)
                            {
                                <TextBlock Color="Color.Muted">@paragraph</TextBlock>
                            }
                        </CardBody>
                    </Card>
                }
            </Column>
        </Grid>
    </Column>
}

@code {
    /// <summary>The contact.</summary>
    [Parameter] public int Id { get; set; }

    /// <summary>The tab: none for Activity, or "deals", "tasks", "notes".</summary>
    [Parameter] public string? Section { get; set; }

    /// <summary>The tasks just ticked here, which stay in the list: "4,7".</summary>
    [SupplyParameterFromQuery] private string? Done { get; set; }

    /// <summary>The note the delete dialog asks about (?dialog=delete-note&amp;note=5).</summary>
    [SupplyParameterFromQuery] private int? Note { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The note being written on the Notes tab.
    [SupplyParameterFromForm(FormName = "add-note")] private NoteDraft? Draft { get; set; }

    // The note the delete dialog posted.
    [SupplyParameterFromForm(FormName = "delete-note")] private NoteRef? Delete { get; set; }

    private sealed class NoteDraft
    {
        [Required(ErrorMessage = "Enter a note."), StringLength(20000)] public string? Body { get; set; }
    }

    private sealed class NoteRef
    {
        public int Id { get; set; }
    }

    private Workspace? _workspace;
    private DateOnly _today;
    private Contact? _contact;
    private Activity? _next;
    private List<Happened> _history = [];
    private List<Deal> _deals = [];
    private List<Activity> _tasks = [];
    private List<Note> _notes = [];
    private bool _canEdit;
    private string? _me;

    // Edit opens the Contacts grid's dialog, which comes back to this tab.
    private string EditHref => $"contacts?edit={Id}&return=/{Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0]}";

    // What's next on the calendar with them: beside the sections on a wide screen, above them on a small one.
    private RenderFragment NextFollowUp => __builder =>
    {
        <Card Title="Next follow-up" TitleLevel="2">
            <CardBody Gap="3" Align="Align.Start">
                @if (_next is { } next)
                {
                    <Column Gap="0">
                        <Heading Level="3" Size="TextSize.Sm">@next.Title</Heading>
                        <TextBlock Color="Color.Muted">@($"{When.Day(DateOnly.FromDateTime(next.Start), _today)} · {When.Time(next.Start)}")</TextBlock>
                    </Column>
                }
                else
                {
                    <TextBlock Color="Color.Muted">Nothing scheduled.</TextBlock>
                }
                @if (_canEdit)
                {
                    <Button Href="@($"activities/new?contact={Id}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Schedule activity</Button>
                }
            </CardBody>
        </Card>
    };

    // Something in the contact's history: what, more about it, "who · when" as written, and when (the workspace's time).
    private sealed record Happened(string Title, string? About, string Time, DateTime When);

    protected override async Task OnParametersSetAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        var now = Clock.Now(_workspace);
        _today = DateOnly.FromDateTime(now);
        var user = (await AuthState).User;
        _me = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _canEdit = (await Authorization.AuthorizeAsync(user, Policies.EditRecords)).Succeeded;
        Draft ??= new();
        Delete ??= new();

        _contact = await Db.Contacts.AsNoTracking().Include(c => c.Company).Include(c => c.Owner).FirstOrDefaultAsync(c => c.Id == Id);
        if (_contact is null || Section is not (null or "deals" or "tasks" or "notes"))
        {
            _contact = null;
            Navigation.NotFound();
            return;
        }

        // What's next on the calendar with them: the first open activity that hasn't started.
        _next = await Db.Activities.AsNoTracking()
            .Where(a => a.ContactId == Id && a.Completed == null && a.Start >= now).OrderBy(a => a.Start).FirstOrDefaultAsync();

        switch (Section)
        {
            case null:
                await LoadHistoryAsync(_contact);
                break;
            case "deals":
                _deals = await Db.Deals.AsNoTracking()
                    .Where(d => d.ContactId == Id && d.Stage != DealStage.Won && d.Stage != DealStage.Lost).OrderBy(d => d.ExpectedClose).ToListAsync();
                break;
            case "tasks":
                // Their open tasks, and those just ticked (?done=, from TaskCheck), which stay in sight.
                var ticked = TaskCheck.Ids(Done);
                _tasks = await Db.Activities.AsNoTracking()
                    .Include(a => a.Contact!.Company).Include(a => a.Deal!.Company)
                    .Where(a => a.Type == ActivityType.Task && a.ContactId == Id && (a.Completed == null || ticked.Contains(a.Id)))
                    .OrderBy(a => a.Start).ToListAsync();
                break;
            case "notes":
                _notes = await Db.Notes.AsNoTracking().Include(n => n.Author)
                    .Where(n => n.ContactId == Id).OrderByDescending(n => n.Created).ToListAsync();
                break;
        }
    }

    // A short note, written on the page: no title, linked to the contact, yours.
    private async Task AddNoteAsync()
    {
        if (!_canEdit) return;
        var now = DateTime.UtcNow;
        Db.Notes.Add(new Note { ContactId = Id, Body = Draft!.Body!.Trim(), AuthorId = _me, Created = now, Edited = now });
        if (await Db.Contacts.FirstOrDefaultAsync(c => c.Id == Id) is { } contact) contact.LastActivity = now;
        await Db.SaveChangesAsync();
        Toasts.Success($"It’s on {_contact!.Name}’s page for the whole team.", "Note added");
        Navigation.NavigateTo($"contacts/{Id}/notes");
    }

    private async Task DeleteNoteAsync()
    {
        if (!_canEdit) return;
        if (await Db.Notes.FirstOrDefaultAsync(n => n.Id == Delete!.Id && n.ContactId == Id) is { } note)
        {
            Db.Notes.Remove(note);
            await Db.SaveChangesAsync();
            Toasts.Success(note.Title.Length > 0 ? note.Title : "The note is gone for everyone.", "Note deleted");
        }

        Navigation.NavigateTo($"contacts/{Id}/notes");
    }

    // When a note was written, as the app writes it: "Nov 14 · 12:10 PM".
    private string Written(DateTime utc)
    {
        var at = When.Local(utc, _workspace);
        return $"{When.Date(DateOnly.FromDateTime(at), _today)} · {When.Time(at)}";
    }

    // The number as a link that calls: its digits, a leading + kept. Null without one.
    private static string? Tel(Contact contact) =>
        string.IsNullOrWhiteSpace(contact.Phone) ? null : $"tel:{new string(contact.Phone.Where(c => char.IsDigit(c) || c == '+').ToArray())}";

    // The timeline, newest first: every activity with them that's finished, then the day they were added.
    private async Task LoadHistoryAsync(Contact contact)
    {
        var done = await Db.Activities.AsNoTracking().Include(a => a.AssignedTo)
            .Where(a => a.ContactId == Id && a.Completed != null).OrderByDescending(a => a.Completed).ToListAsync();
        _history = done.Select(a =>
        {
            var at = When.Local(a.Completed!.Value, _workspace);
            return new Happened(
                a.Type switch
                {
                    ActivityType.Call => $"Call logged · {a.Duration} minutes",
                    ActivityType.Meeting => $"Meeting held · {a.Duration} minutes",
                    _ => a.Title,
                },
                a.Agenda, About(a.AssignedTo?.Name, When.At(at, _today)), at);
        }).ToList();

        // Who added them, from the audit log; the day is the contact's own.
        var id = Id.ToString();
        var added = await Db.AuditEvents.AsNoTracking()
            .Where(e => e.Action == AuditActions.Created && e.EntityType == nameof(Contact) && e.EntityId == id).OrderBy(e => e.Time).FirstOrDefaultAsync();
        _history.Add(new Happened("Contact added", null, About(added?.ActorName, When.Day(contact.Added, _today)), contact.Added.ToDateTime(TimeOnly.MinValue)));
    }

    // Under the name: "Marketing director · Acme Co.". Without a job title, the status takes its place after the
    // company ("Acme Co. · Customer"); all three wrap on a phone, and the status is in Contact details.
    private static string Summary(Contact contact) => string.IsNullOrWhiteSpace(contact.JobTitle)
        ? About(contact.Company?.Name, contact.Status.ToString())
        : About(contact.JobTitle, contact.Company?.Name);

    private static string[] Paragraphs(string? text) =>
        (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string About(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
}
