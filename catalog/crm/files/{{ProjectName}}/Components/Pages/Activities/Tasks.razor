@page "/activities"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation

<PageTitle>Tasks</PageTitle>

@* Tasks, where Activities opens: yours (or, from the menu in the view strip, everyone's, a team member's or
   those assigned to no one: Components/Activities/AssigneeMenu.razor) that are still open, by when they're due: overdue, today, then what's ahead. Ticking one marks it
   done (Components/Activities/TaskCheck.razor) and it stays in sight, struck through, until you leave the page.
   Completed tasks (?status=completed) lists the finished ones, the latest first, where clearing a box
   reopens one. New task opens the activity form over the page, as a task
   (Components/Activities/ActivityDialog.razor). The calendar is the same activities by week (Week.razor, /activities/week). *@
<PageCrumbs><BreadcrumbItem>Activities</BreadcrumbItem></PageCrumbs>

<Column Gap="6">
    <PageHeader Title="Tasks" Description="Your commitments, organized by due date.">
        @* On a phone it floats in the corner. *@
        @if (_canEdit)
        {
            <PageHeaderActions>
                <Button Href="@Navigation.GetUriWithQueryParameter("dialog", ActivityDialog.NewId)" StartIcon="Lucide.Plus" FloatBelow="Breakpoint.Sm">New task</Button>
            </PageHeaderActions>
        }
    </PageHeader>

    @* The view strip: the switch, what the list covers, and the way to the other half at the end. *@
    <Row Gap="3" Align="Align.Center" Wrap>
        <TabNav Label="Activities view" Variant="TabsVariant.Segmented" Size="ControlSize.Sm">
            <TabLink Href="activities" Label="Tasks" Icon="Lucide.List" Current />
            <TabLink Href="activities/week" Label="Week" Icon="Lucide.CalendarDays" />
        </TabNav>
        <AssigneeMenu />
        <Tag>@(Completed ? "Completed" : "Open")</Tag>
        <Spacer />
        @if (Completed)
        {
            <Button Href="@Half(null)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm">Open tasks</Button>
        }
        else
        {
            <Button Href="@Half("completed")" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm">Completed tasks</Button>
        }
    </Row>

    <Column Gap="4">
        @if (Completed)
        {
            <Card Title="Completed" TitleLevel="2">
                @if (_tasks.Count > 0)
                {
                    <CardActions><Badge>@Count(_tasks.Count)</Badge></CardActions>
                }
                <CardBody Flush>
                    @if (_tasks.Count > 0)
                    {
                        <TaskList Tasks="_tasks" Today="_today" Label="Completed" ShowDeal ShowAssignee="!Mine" />
                    }
                    else
                    {
                        <EmptyState Icon="Lucide.ListChecks" Size="ControlSize.Sm" Title="Nothing completed yet" Description="@(Mine ? "Tasks you finish show here." : "Finished tasks show here.")" />
                    }
                </CardBody>
            </Card>
        }
        else if (_tasks.Count == 0)
        {
            <Card><EmptyState TitleLevel="2" Icon="Lucide.CircleCheck" Size="ControlSize.Sm" Title="@(Mine ? "You’re all caught up" : "No open tasks")" Description="@(Mine ? "You have no open tasks." : "Nothing here is waiting to be done.")" /></Card>
        }
        else
        {
            @if (Group(t => Day(t) < _today) is { Count: > 0 } overdue)
            {
                <Card Title="Overdue" TitleLevel="2">
                    <CardActions><Badge Status="Status.Warning">@Count(overdue.Count)</Badge></CardActions>
                    <CardBody Flush><TaskList Tasks="overdue" Today="_today" Label="Overdue" ShowDeal ShowAssignee="!Mine" Due="@(t => When.Date(Day(t), _today))" /></CardBody>
                </Card>
            }
            @if (Group(t => Day(t) == _today) is { Count: > 0 } today)
            {
                <Card Title="Today" TitleLevel="2">
                    <CardActions><Badge>@Count(today.Count)</Badge></CardActions>
                    <CardBody Flush><TaskList Tasks="today" Today="_today" Label="Today" ShowDeal ShowAssignee="!Mine" Due="@(t => When.Time(t.Start))" /></CardBody>
                </Card>
            }
            @if (Group(t => Day(t) > _today) is { Count: > 0 } upcoming)
            {
                <Card Title="Upcoming" TitleLevel="2">
                    <CardBody Flush><TaskList Tasks="upcoming" Today="_today" Label="Upcoming" ShowDeal ShowAssignee="!Mine" Due="@(t => When.Day(Day(t), _today))" /></CardBody>
                </Card>
            }
        }
    </Column>
</Column>

<ActivityDialog CanEdit="_canEdit" Type="ActivityType.Task" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>"completed" lists the finished tasks in place of the open ones.</summary>
    [SupplyParameterFromQuery(Name = "status")] private string? Which { get; set; }

    /// <summary>The tasks just ticked here, which stay in the list: "4,7".</summary>
    [SupplyParameterFromQuery] private string? Done { get; set; }

    // Completed tasks show this many, the latest first.
    private const int Shown = 50;

    /// <summary>Whose tasks: yours with none (Components/Activities/AssigneeMenu.razor).</summary>
    [SupplyParameterFromQuery] private string? Who { get; set; }

    private bool Completed => Which == "completed";

    // Your own list: the others say whose each task is.
    private bool Mine => string.IsNullOrEmpty(Who);

    // This list's open or completed half.
    private string Half(string? status) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["status"] = status, ["done"] = null });

    // Who may add: the EditRecords policy.
    private bool _canEdit;
    private DateOnly _today;
    private List<Activity> _tasks = [];

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        _canEdit = (await Authorization.AuthorizeAsync(user, Policies.EditRecords)).Succeeded;
        var me = user.UserId();
        _today = Clock.Today(await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync());

        // Yours, or whose the address asks for, with who each is with. A task just ticked or cleared here (?done=, from TaskCheck) stays where it was.
        var ticked = TaskCheck.Ids(Done);
        var mine = AssigneeMenu.Of(Db.Activities.AsNoTracking(), Who, me)
            .Include(a => a.Contact!.Company).Include(a => a.Deal!.Company).Include(a => a.AssignedTo)
            .Where(a => a.Type == ActivityType.Task);
        _tasks = Completed
            ? await mine.Where(a => a.Completed != null).OrderByDescending(a => a.Completed).Take(Shown).ToListAsync()
            : await mine.Where(a => a.Completed == null || ticked.Contains(a.Id)).OrderBy(a => a.Start).ToListAsync();
    }

    private static DateOnly Day(Activity task) => DateOnly.FromDateTime(task.Start);

    private List<Activity> Group(Func<Activity, bool> due) => _tasks.Where(due).ToList();

    // "1 task", "2 tasks".
    private static string Count(int tasks) => tasks == 1 ? "1 task" : $"{tasks:N0} tasks";
}
