@page "/activities/{Id:int}"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject Audit Audit
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization
@inject ToastService Toasts

<PageTitle>@(_activity?.Title ?? "Activity")</PageTitle>

@* An activity: a meeting, a call or a task, to read. When, where and with whom, its agenda, and the notes written
   on it (what was decided), which are also about its contact and deal, so they show on those pages too. The
   header's actions follow its state: Mark complete while it's open (it posts here and writes "Completed" in the
   audit log); Join call beside it when its location is a link; Schedule follow-up once it's done. Edit activity
   opens the activity form over the page (Components/Activities/ActivityDialog.razor). On a phone the actions
   float in the corner, and Join call is a button under the header. People who can't edit records (Viewers) read
   everything and see only Join call. *@
@if (_activity is { } activity)
{
    var done = activity.Completed is not null;
    var link = Link(activity.Location);
    <Column Gap="6">
        @* In the column, so on a phone the trail has the page's gap above the title. *@
        <PageCrumbs Trail>
            <BreadcrumbItem Href="activities">Activities</BreadcrumbItem>
            <BreadcrumbItem>@activity.Title</BreadcrumbItem>
        </PageCrumbs>
        <PageHeader Title="@activity.Title" Badge="@Status(activity).Text" BadgeStatus="@Status(activity).Tone" Description="@Summary(activity)">
            <PageHeaderActions>
                @if (_canEdit)
                {
                    <Button Href="@EditHref" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Pencil" VisibleFrom="Breakpoint.Sm">Edit activity</Button>
                    @if (done)
                    {
                        <Button Href="@FollowUpHref" StartIcon="Lucide.CalendarPlus" VisibleFrom="Breakpoint.Sm">Schedule follow-up</Button>
                    }
                    else
                    {
                        @* The main action until there's a call to join. *@
                        <Button Submit Form="activity-action" StartIcon="Lucide.Check" VisibleFrom="Breakpoint.Sm"
                                Variant="@(link is null ? ButtonVariant.Solid : ButtonVariant.Outline)" Accent="@(link is null ? Accent.Primary : Accent.Neutral)">Mark complete</Button>
                    }
                }
                @if (link is not null && !done)
                {
                    <Button Href="@link.Value.Href" StartIcon="Lucide.Video" VisibleFrom="Breakpoint.Sm">Join call</Button>
                }
            </PageHeaderActions>
        </PageHeader>

        @* On a phone the call is one press away, the width of the page. *@
        @if (link is not null && !done)
        {
            <Button Href="@link.Value.Href" StartIcon="Lucide.Video" FullWidth HiddenFrom="Breakpoint.Sm">Join call</Button>
        }

        @* What it is and what was said, and beside it from 1024px what it's linked to: under it on smaller screens. *@
        <Grid Template="@(new() { Base = "minmax(0, 1fr)", Lg = "minmax(0, 1fr) 20rem" })" Gap="4" Align="Align.Start">
            <Column Gap="4">
                <Card Title="@($"{activity.Type} details")" TitleLevel="2">
                    <DescriptionList Orientation="Orientation.Horizontal">
                        <DescriptionItem Term="@(activity.Type == ActivityType.Task ? "Due" : "When")">@Time(activity)</DescriptionItem>
                        @if (activity.Type != ActivityType.Task || activity.Location is not null)
                        {
                            <DescriptionItem Term="Where">
                                @if (link is not null)
                                {
                                    <text>Video call · <Anchor Href="@link.Value.Href">@link.Value.Shown</Anchor></text>
                                }
                                else
                                {
                                    @* Somewhere, or nothing yet: either way there's no link to join by. *@
                                    <Row Gap="3" Align="Align.Center" Wrap>
                                        <TextBlock As="span">@(activity.Location ?? "Link to be added")</TextBlock>
                                        @if (_canEdit && !done)
                                        {
                                            <Button Href="@EditHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Link">Add link</Button>
                                        }
                                    </Row>
                                }
                            </DescriptionItem>
                        }
                        <DescriptionItem Term="Who">
                            @if (activity.Contact is { } contact)
                            {
                                <Anchor Href="@($"contacts/{contact.Id}")">@contact.Name</Anchor>
                                @if (contact.Company is { } employer)
                                {
                                    <text> (@employer.Name)</text>
                                }
                                @if (activity.AssignedTo is not null)
                                {
                                    <text> · </text>
                                }
                            }
                            @(activity.AssignedTo?.Name ?? (activity.Contact is null ? "No one yet" : null))
                        </DescriptionItem>
                    </DescriptionList>
                </Card>

                @* The agenda as written: Markdown, so a list in it shows as one. *@
                @if (activity.Agenda is { Length: > 0 } agenda)
                {
                    <Card Title="Agenda" TitleLevel="2">
                        <Markdown Text="@agenda" TopHeading="3" />
                    </Card>
                }

                @* What was decided: notes written here, which are also about its contact and deal. *@
                <ActivityFeed Title="Notes" Items="_notes" Href="@Here" On="@Here" CanEdit="_canEdit" NotesOnly />
            </Column>

            <Column Gap="4">
                @if (activity.Deal is not null || Company(activity) is not null)
                {
                    <Card Title="Related" TitleLevel="2">
                        <DescriptionList Orientation="Orientation.Vertical">
                            @if (activity.Deal is { } deal)
                            {
                                <DescriptionItem Term="Deal"><Anchor Href="@($"deals/{deal.Id}")">@deal.Name</Anchor></DescriptionItem>
                            }
                            @if (Company(activity) is { } company)
                            {
                                <DescriptionItem Term="Company"><Anchor Href="@($"companies/{company.Id}")">@company.Name</Anchor></DescriptionItem>
                            }
                        </DescriptionList>
                    </Card>
                }

                <Card Title="Activity ownership" TitleLevel="2">
                    <DescriptionList Orientation="Orientation.Vertical">
                        <DescriptionItem Term="Assigned to">@(activity.AssignedTo?.Name ?? "No one yet")</DescriptionItem>
                        <DescriptionItem Term="Reminder">@(activity.Reminder switch { null => "No reminder", >= 1440 => "1 day before", var minutes => $"{minutes} minutes before" })</DescriptionItem>
                        @if (activity.CreatedBy is { } creator)
                        {
                            <DescriptionItem Term="Created by">@creator.Name</DescriptionItem>
                        }
                        @if (activity.Completed is { } completed)
                        {
                            <DescriptionItem Term="Completed">@When.At(When.Local(completed, _workspace), _today)</DescriptionItem>
                        }
                    </DescriptionList>
                </Card>
            </Column>
        </Grid>
    </Column>

    @if (_canEdit)
    {
        @* On a phone the actions float in the corner, the main one nearest the thumb. *@
        <SpeedDial Label="Activity actions" HiddenFrom="Breakpoint.Sm">
            @if (done)
            {
                <SpeedDialAction Icon="Lucide.CalendarPlus" Label="Schedule follow-up" Href="@FollowUpHref" />
            }
            else
            {
                <SpeedDialAction Icon="Lucide.Check" Label="Mark complete" Submit Form="activity-action" />
            }
            <SpeedDialAction Icon="Lucide.Pencil" Label="Edit activity" Href="@EditHref" />
        </SpeedDial>

        @* Mark complete posts this. *@
        <form id="activity-action" method="post" @formname="activity-action" @onsubmit="CompleteAsync">
            <AntiforgeryToken />
        </form>
    }

    @* Edit is this activity; a follow-up is a new one with the same person and deal. *@
    <ActivityDialog CanEdit="_canEdit" Activity="Id" Contact="activity.ContactId" Deal="activity.DealId" />
    <NoteDialog CanEdit="_canEdit" Activity="Id" Contact="activity.ContactId" Deal="activity.DealId" />
}

@code {
    /// <summary>The activity.</summary>
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;



    private Activity? _activity;
    private List<FeedItem> _notes = [];
    private Workspace? _workspace;
    private DateOnly _today;
    private bool _canEdit;
    private string? _me;

    // This page's address: where the dialogs open and come back to.
    private string Here => $"activities/{Id}";

    private string EditHref => $"{Here}?dialog={ActivityDialog.EditId}";

    private string FollowUpHref => $"{Here}?dialog={ActivityDialog.NewId}";

    protected override async Task OnParametersSetAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync() ?? new Workspace();
        _today = Clock.Today(_workspace);
        var user = (await AuthState).User;
        _me = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _canEdit = (await Authorization.AuthorizeAsync(user, Policies.EditRecords)).Succeeded;

        _activity = await Db.Activities.AsNoTracking()
            .Include(a => a.Contact!.Company).Include(a => a.Deal!.Company).Include(a => a.AssignedTo).Include(a => a.CreatedBy)
            .FirstOrDefaultAsync(a => a.Id == Id);
        if (_activity is null)
        {
            Navigation.NotFound();
            return;
        }

        _notes = (await Db.Notes.AsNoTracking().Include(n => n.Author).Include(n => n.Contact).Include(n => n.Deal).Include(n => n.Company).Include(n => n.Activity)
            .Where(n => n.ActivityId == Id).OrderByDescending(n => n.Created).ToListAsync()).Select(n => FeedItem.Of(n, _workspace, _today)).ToList();
    }

    // Marks it done, now. Its own line in the audit log, as a task ticked on a list is.
    private async Task CompleteAsync()
    {
        if (_canEdit && await Db.Activities.FirstOrDefaultAsync(a => a.Id == Id && a.Completed == null) is { } activity)
        {
            activity.Completed = DateTime.UtcNow;
            Db.Auditing = false;
            await Db.SaveChangesAsync();
            Db.Auditing = true;
            await Audit.RecordAsync(AuditActions.Completed, nameof(Activity), activity.Id.ToString(), activity.Title, [new AuditChange("Status", null, "Completed")]);
            Toasts.Success(activity.Title, $"{activity.Type} completed");
        }

        Navigation.NavigateTo(Here);
    }


    // The badge beside the title: done, a task past its day, or still ahead.
    private (string Text, Status Tone) Status(Activity activity) =>
        activity.Completed is not null ? ("Completed", IzzyBlazor.Status.Success)
        : activity.Type == ActivityType.Task
            ? DateOnly.FromDateTime(activity.Start) < _today ? ("Overdue", IzzyBlazor.Status.Danger) : ("Open", IzzyBlazor.Status.Info)
        : ("Scheduled", IzzyBlazor.Status.Info);

    // "Meeting with Olivia Chen · Acme Co.", under the title.
    private static string Summary(Activity activity) => string.Join(" · ", new[]
    {
        activity.Contact is { } contact ? $"{activity.Type} with {contact.Name}" : activity.Type.ToString(),
        Company(activity)?.Name,
    }.Where(part => !string.IsNullOrEmpty(part)));

    // The contact's company, or the deal's.
    private static Company? Company(Activity activity) => activity.Contact?.Company ?? activity.Deal?.Company;

    // "Thursday, Nov 19 · 10:00–10:30 AM EST"; a task has only the time it's due.
    private string Time(Activity activity)
    {
        var day = activity.Start.ToString(activity.Start.Year == _today.Year ? "dddd, MMM d" : "dddd, MMM d, yyyy", System.Globalization.CultureInfo.CurrentCulture);
        var hours = activity.Type == ActivityType.Task ? When.Time(activity.Start) : When.Hours(activity.Start, activity.End);
        return $"{day} · {hours} {When.Zone(activity.Start, _workspace)}";
    }

    // A location that's a link, typed with or without "https://": where it goes, and how it reads without the scheme.
    private static (string Href, string Shown)? Link(string? location)
    {
        if (location?.Trim() is not { Length: > 0 } text || text.Contains(' ')) return null;
        var address = text.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || text.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ? text : $"https://{text}";
        if (!Uri.TryCreate(address, UriKind.Absolute, out var uri) || !uri.Host.Contains('.')) return null;
        return (address, address[(address.IndexOf("://", StringComparison.Ordinal) + 3)..].TrimEnd('/'));
    }
}
