@page "/settings/workspace"
@attribute [Authorize(Policy = Policies.ManageUsers)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Workspace settings</PageTitle>

@* Settings & team, Workspace: the workspace's name and the defaults every page shares (Data/Workspace.cs, one
   row). The fields are checked against Workspace's attributes; a save is written to the audit log as it's made
   (Auditing/AuditInterceptor.cs). For admins only. *@
<Column Gap="6">
    <SettingsHeader Section="Workspace" />

    @if (Input is not null)
    {
        <Column Gap="6" MaxWidth="Length.Rem(48)">
            <PageHeader Title="Workspace settings" Description="Shared defaults for your team." TitleLevel="2" Size="ControlSize.Sm" />

            <Form Model="Input" FormName="workspace" OnValidSubmit="SaveAsync">
                <Card Dividers>
                    <CardBody>
                        <Fieldset Label="Workspace" Description="These details appear throughout the CRM." Columns="2">
                            <TextField @bind-Value="Input.Name" Label="Workspace name" autocomplete="organization" />
                            <TextField @bind-Value="Input.Website" Label="Workspace website" Placeholder="https://" />
                        </Fieldset>
                    </CardBody>
                    <CardBody>
                        <Fieldset Label="Regional defaults" Description="Keep dates, amounts, and schedules consistent." Columns="2">
                            @* A list with no empty choice always has a value, so these carry no required mark. *@
                            <Select @bind-Value="Input.Currency" Label="Currency" Required="false" Items="Workspace.Currencies.Select(c => c.Code)"
                                    ItemText="@(code => $"{code} — {Workspace.Currencies.First(c => c.Code == code).Name}")" />
                            <Select @bind-Value="Input.TimeZone" Label="Time zone" Required="false" Items="Workspace.TimeZones" />
                            <Select @bind-Value="Input.WeekStart" Label="Week starts on" Items="Workspace.WeekStarts" />
                            @* Each format, as it writes today. *@
                            <Select @bind-Value="Input.DateFormat" Label="Date format" Required="false" Items="Workspace.DateFormats" ItemText="format => _today.ToString(format)" />
                        </Fieldset>
                    </CardBody>
                    <CardFooter Justify="Justify.End">
                        <Button Submit>Save changes</Button>
                    </CardFooter>
                </Card>
            </Form>
        </Column>
    }
</Column>

@code {
    // The workspace as the form shows it, and as it posts.
    [SupplyParameterFromForm(FormName = "workspace")] private Workspace? Input { get; set; }

    private DateOnly _today;

    protected override async Task OnInitializedAsync()
    {
        var current = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();
        _today = Clock.Today(current);
        Input ??= current;
    }

    private async Task SaveAsync(EditContext form)
    {
        if (Input is null || await Db.Workspaces.FirstOrDefaultAsync() is not { } saved) return;
        // Only what the lists offer.
        if (Workspace.Currencies.All(c => c.Code != Input.Currency) || !Workspace.TimeZones.Contains(Input.TimeZone)
            || !Workspace.WeekStarts.Contains(Input.WeekStart) || !Workspace.DateFormats.Contains(Input.DateFormat)) return;

        // The form's fields and nothing else.
        (saved.Name, saved.Website) = (Input.Name.Trim(), string.IsNullOrWhiteSpace(Input.Website) ? null : Input.Website.Trim());
        (saved.Currency, saved.TimeZone, saved.WeekStart, saved.DateFormat) = (Input.Currency, Input.TimeZone, Input.WeekStart, Input.DateFormat);
        await Db.SaveChangesAsync();
        Toasts.Success($"{saved.Name} is up to date.", "Workspace saved");
        // Back to the page with no post to repeat on a reload, and the new name in the sidebar.
        Navigation.NavigateTo("settings/workspace");
    }
}
