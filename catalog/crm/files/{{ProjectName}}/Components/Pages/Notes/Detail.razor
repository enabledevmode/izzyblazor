@page "/notes/{Id:int}"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject IAuthorizationService Authorization

<PageTitle>@(_note?.Title ?? "Note")</PageTitle>

@* A note, to read: its title, who wrote it and when, the records it's on, and its text at a reading width. A
   note with a title links here from every list it's in. Edit note opens the note form over the page
   (Components/Notes/NoteDialog.razor), where the title is set. *@
@if (_note is { } note)
{
    var records = FeedItem.Records(note).ToList();
    <Column Gap="6" MaxWidth="Length.Rem(48)">
        @* Under the first record it's on. In the column, so on a phone the trail has the page's gap above the title. *@
        <PageCrumbs Trail>
            @if (records.Count > 0)
            {
                <BreadcrumbItem Href="@records[0].Href">@records[0].Name</BreadcrumbItem>
            }
            <BreadcrumbItem>@(note.Title ?? "Note")</BreadcrumbItem>
        </PageCrumbs>
        <PageHeader Title="@(note.Title ?? "Note")">
            <Column Gap="0">
                <TextBlock Color="Color.Muted">@(note.Author?.Name ?? "Someone") · @FeedItem.Written(note.Created, _workspace, _today)@(note.Edited > note.Created ? " · Edited" : "")</TextBlock>
                @if (records.Count > 0)
                {
                    <Row Gap="2" Align="Align.Center" Wrap>
                        <TextBlock As="span" Color="Color.Muted">Related to</TextBlock>
                        @foreach (var record in records)
                        {
                            <Anchor Href="@record.Href" title="@(char.ToUpperInvariant(record.Kind[0]) + record.Kind[1..])"><Icon Name="record.Icon" Size="IconSize.Sm" /> <VisuallyHidden>@record.Kind </VisuallyHidden>@record.Name</Anchor>
                        }
                    </Row>
                }
            </Column>
            @if (_canEdit)
            {
                <PageHeaderActions>
                    <Button Href="@($"notes/{Id}?dialog={NoteDialog.EditId}&note={Id}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Pencil" FloatBelow="Breakpoint.Sm">Edit note</Button>
                </PageHeaderActions>
            }
        </PageHeader>

        @* The note: its text is Markdown, so its headings, lists and links show as such. *@
        <Card>
            <Markdown Text="@note.Body" TopHeading="3" />
        </Card>
    </Column>

    <NoteDialog CanEdit="_canEdit" />
}

@code {
    /// <summary>The note.</summary>
    [Parameter] public int Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Note? _note;
    private Workspace? _workspace;
    private DateOnly _today;
    private bool _canEdit;

    protected override async Task OnParametersSetAsync()
    {
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync() ?? new Workspace();
        _today = Clock.Today(_workspace);
        _canEdit = (await Authorization.AuthorizeAsync((await AuthState).User, Policies.EditRecords)).Succeeded;
        _note = await Db.Notes.AsNoTracking()
            .Include(n => n.Author).Include(n => n.Contact).Include(n => n.Deal).Include(n => n.Company).Include(n => n.Activity)
            .FirstOrDefaultAsync(n => n.Id == Id);
        if (_note is null) Navigation.NotFound();
    }
}
