@page "/search"
@attribute [Authorize(Policy = Policies.ViewRecords)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db

<PageTitle>Search</PageTitle>

@* Search: one box over contacts, companies, deals and notes. What's typed is in the address (?q=), so a search
   can be linked to and Back returns to it; the lists follow as you type (FilterForm). Each list shows its first
   matches, by name: a contact by name, email, phone or job title, a company by name, website or city, a deal by
   its name or its company's, a note by its title or text. The lists themselves search further (Contacts,
   Companies, Deal pipeline). *@
<PageCrumbs><BreadcrumbItem>Search</BreadcrumbItem></PageCrumbs>

<Column Gap="6">
    <PageHeader Title="Search" Description="Find a contact, company, deal, or note." />

    <FilterForm Label="Search everything">
        <FilterSearch Label="Search everything" Placeholder="Search contacts, companies, deals, and notes…" autofocus />
    </FilterForm>

    @if (_query is null)
    {
        <Card><EmptyState TitleLevel="2" Icon="Lucide.Search" Size="ControlSize.Sm" Title="Search your workspace" Description="Type a name, an email address, or a few words from a note." /></Card>
    }
    else if (_contacts.Count + _companies.Count + _deals.Count + _notes.Count == 0)
    {
        <Card><EmptyState TitleLevel="2" Icon="Lucide.SearchX" Size="ControlSize.Sm" Title="No matches" Description="@($"Nothing matches “{_query}”. Try fewer letters or another word.")" /></Card>
    }
    else
    {
        <Column Gap="4">
            @if (_contacts.Count > 0)
            {
                <Card Title="Contacts" TitleLevel="2">
                    <CardActions><Badge>@Found(_contacts.Count)</Badge></CardActions>
                    <CardBody Flush>
                        <ListView Items="_contacts" ItemKey="c => c.Id.ToString()" Label="Contacts" ItemText="c => c.Name" ItemHref="@(c => $"contacts/{c.Id}")"
                                  ItemDescription="c => About(c.JobTitle, c.Company?.Name, c.Email)" Context="person">
                            <ItemMedia><Avatar Name="@person.Name" Size="AvatarSize.Sm" Decorative /></ItemMedia>
                        </ListView>
                    </CardBody>
                </Card>
            }
            @if (_companies.Count > 0)
            {
                <Card Title="Companies" TitleLevel="2">
                    <CardActions><Badge>@Found(_companies.Count)</Badge></CardActions>
                    <CardBody Flush>
                        <ListView Items="_companies" ItemKey="c => c.Id.ToString()" Label="Companies" ItemText="c => c.Name" ItemHref="@(c => $"companies/{c.Id}")"
                                  ItemDescription="c => About(c.City, c.Website)" Context="company">
                            <ItemMedia><Avatar Src="@company.LogoSrc" Icon="Lucide.BuildingComplex" Size="AvatarSize.Sm" Accent="Accent.Neutral" Square Decorative /></ItemMedia>
                        </ListView>
                    </CardBody>
                </Card>
            }
            @if (_deals.Count > 0)
            {
                <Card Title="Deals" TitleLevel="2">
                    <CardActions><Badge>@Found(_deals.Count)</Badge></CardActions>
                    <CardBody Flush>
                        <ListView Items="_deals" ItemKey="d => d.Id.ToString()" Label="Deals" ItemText="d => d.Name" ItemHref="@(d => $"deals/{d.Id}")"
                                  ItemDescription="@(d => About(d.Company?.Name, _workspace?.Money(d.Value)))" Context="deal">
                            <ItemActions><Badge Status="Tones.Of(deal.Stage)">@deal.Stage</Badge></ItemActions>
                        </ListView>
                    </CardBody>
                </Card>
            }
            @if (_notes.Count > 0)
            {
                @* A note opens where it was written: its own page with a title, else its contact, deal or company. *@
                <Card Title="Notes" TitleLevel="2">
                    <CardActions><Badge>@Found(_notes.Count)</Badge></CardActions>
                    <CardBody Flush>
                        <ListView Items="_notes" ItemKey="n => n.Id.ToString()" Label="Notes" ItemText="n => n.Title ?? n.Opening" ItemHref="Where"
                                  ItemDescription="@(n => About(n.Contact?.Name, n.Deal?.Name, n.Company?.Name, n.Author?.Name))" />
                    </CardBody>
                </Card>
            }
        </Column>
    }
</Column>

@code {
    /// <summary>What's being searched for.</summary>
    [SupplyParameterFromQuery] private string? Q { get; set; }

    // Each list shows this many, by name.
    private const int Shown = 8;

    private string? _query;
    private Workspace? _workspace;
    private List<Contact> _contacts = [];
    private List<Company> _companies = [];
    private List<Deal> _deals = [];
    private List<Note> _notes = [];

    protected override async Task OnParametersSetAsync()
    {
        _query = string.IsNullOrWhiteSpace(Q) ? null : Q.Trim();
        (_contacts, _companies, _deals, _notes) = ([], [], [], []);
        if (_query is null) return;
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync();

        // Lower case on both sides, so "acme" finds Acme Co. in any database.
        var q = _query.ToLower();
        _contacts = await Db.Contacts.AsNoTracking().Include(c => c.Company)
            .Where(c => (c.FirstName + " " + c.LastName).ToLower().Contains(q) || (c.Email != null && c.Email.ToLower().Contains(q))
                || (c.Phone != null && c.Phone.Contains(q)) || (c.JobTitle != null && c.JobTitle.ToLower().Contains(q)))
            .OrderBy(c => c.FirstName).ThenBy(c => c.LastName).Take(Shown).ToListAsync();
        _companies = await Db.Companies.AsNoTracking()
            .Where(c => c.Name.ToLower().Contains(q) || (c.Website != null && c.Website.ToLower().Contains(q)) || (c.City != null && c.City.ToLower().Contains(q)))
            .OrderBy(c => c.Name).Take(Shown).ToListAsync();
        _deals = await Db.Deals.AsNoTracking().Include(d => d.Company)
            .Where(d => d.Name.ToLower().Contains(q) || d.Company!.Name.ToLower().Contains(q))
            .OrderBy(d => d.Name).Take(Shown).ToListAsync();
        _notes = await Db.Notes.AsNoTracking().Include(n => n.Contact).Include(n => n.Deal).Include(n => n.Company).Include(n => n.Author)
            .Where(n => (n.Title != null && n.Title.ToLower().Contains(q)) || n.Body.ToLower().Contains(q))
            .OrderByDescending(n => n.Edited).Take(Shown).ToListAsync();
    }

    // "8 or more" when the list is cut short.
    private static string Found(int count) => count >= Shown ? $"First {Shown}" : count == 1 ? "1 match" : $"{count} matches";

    private static string Where(Note note) =>
        note.Title is not null ? $"notes/{note.Id}"
        : note.ContactId is { } contact ? $"contacts/{contact}"
        : note.DealId is { } deal ? $"deals/{deal}"
        : note.CompanyId is { } company ? $"companies/{company}/activity"
        : note.ActivityId is { } activity ? $"activities/{activity}" : $"notes/{note.Id}";

    private static string About(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
}
