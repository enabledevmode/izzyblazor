@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject {{RootNamespace}}.Email.Mailer Mailer

@* The activity form, in a dialog over the page that asked for it: a link to that page's own address with
   ?dialog=new-activity schedules one, and with ?dialog=edit-activity edits the page's activity. Put one on a page
   that has such a link:

   <ActivityDialog CanEdit="_canEdit" />                  the calendar or the task list: schedule
   <ActivityDialog CanEdit="_canEdit" Contact="Id" />     a contact: schedule, with them chosen
   <ActivityDialog CanEdit="_canEdit" Deal="Id" />        a deal: schedule, with it and its primary contact chosen
   <ActivityDialog CanEdit="_canEdit" Type="ActivityType.Task" />   the task list: a new one starts as a task
   <ActivityDialog CanEdit="_canEdit" Activity="Id" />    an activity: edit

   ?dialog=log-activity records one that has already happened, a call just made (&as=call): it's saved as done,
   at the time given, and counts as being in touch with its contact.

   It saves and comes back to the page, without the ?dialog. A meeting, a call or a task: a task's date and time
   are when it's due. Times are the workspace's own (Workspace.TimeZone), as the calendar shows them. *@
@if (CanEdit && Input is not null && Opened is not null)
{
    var (adding, logging) = (Opened != EditId, Opened == LogId);
    <Dialog Id="@Opened" Title="@(logging ? "Log activity" : adding ? "Schedule activity" : "Edit activity")" Size="DialogSize.Lg" CloseOnBackdrop="false">
        <Form Model="Input" FormName="activity" OnValidSubmit="SaveAsync">
            @if (logging)
            {
                <TextBlock Color="Color.Muted">Record a call or a meeting that has already happened.</TextBlock>
            }
            else if (adding)
            {
                <TextBlock Color="Color.Muted">Put the next step on the calendar and link it to a relationship.</TextBlock>
            }
            <Fieldset Label="Activity" Description="Choose the type and give it a clear purpose." Columns="2">
                <Select @bind-Value="Input.Type" Label="Type" />
                <TextField @bind-Value="Input.Title" Label="Title" autocomplete="off" />
                <Select @bind-Value="Input.ContactId" Label="Related contact" Items="_contactIds" ItemText="id => _contacts[id!.Value].Name"
                        ItemGroup="id => _contacts[id!.Value].Company" Placeholder="No one" />
                <Select @bind-Value="Input.DealId" Label="Related deal" Items="_dealIds" ItemText="id => _deals[id!.Value].Name"
                        ItemGroup="id => _deals[id!.Value].Company" Placeholder="No deal" />
            </Fieldset>
            <Fieldset Label="@(logging ? "When" : "Schedule")" Description="@($"Times are shown in {_workspace?.TimeZone}.")" Columns="2">
                <DateField @bind-Value="Input.Date" Label="Date" />
                <TimeField @bind-Value="Input.StartTime" Label="Start time" Step="TimeSpan.FromMinutes(15)" />
                <Select @bind-Value="Input.Duration" Label="Duration" Items="_durations" ItemText="@(minutes => $"{minutes} minutes")" />
                <Select @bind-Value="Input.AssignedToId" Label="Assigned to" Items="_teamIds" ItemText="id => _team[id!]" />
                @if (!logging)
                {
                    <Select @bind-Value="Input.Reminder" Label="Reminder" Items="Reminders" ItemText="Before" Placeholder="No reminder"
                            Hint="@(Mailer.Sends ? "Emailed to whoever it’s assigned to." : "Emailed once email is set up.")" />
                }
                <TextField @bind-Value="Input.Location" Label="Location or meeting link" autocomplete="off" />
            </Fieldset>
            <TextArea @bind-Value="Input.Agenda" Label="@(logging ? "What happened" : "Agenda")" Placeholder="@(logging ? "What was said, and what comes next?" : "What should you cover?")" Rows="4" />
            @* Editing, Delete is at the footer's other end: it asks first (the ConfirmDialog below). *@
            <DialogFooter Justify="@(adding ? Justify.End : Justify.Between)">
                @if (!adding)
                {
                    <Button Submit Form="@DeleteForm" Variant="ButtonVariant.Ghost" Accent="Accent.Danger" StartIcon="Lucide.Trash" Class="@DeleteForm" data-confirm="@Input.Title">Delete</Button>
                }
                <Row Gap="2">
                    <DialogClose>Cancel</DialogClose>
                    <Button Submit>@(logging ? "Log activity" : adding ? "Save activity" : "Save changes")</Button>
                </Row>
            </DialogFooter>
        </Form>
    </Dialog>
}

@if (CanEdit && Opened == EditId)
{
    @* Delete posts this form, once the dialog has asked. *@
    <form id="@DeleteForm" method="post" @formname="@DeleteForm" @onsubmit="DeleteAsync">
        <AntiforgeryToken />
    </form>
    <ConfirmDialog For="@($".{DeleteForm}")" Title="Delete {0}?" Message="This can’t be undone." ConfirmText="Delete" Accent="Accent.Danger" />
}

@code {
    /// <summary>The form the edit dialog's Delete posts, and the class the confirmation is for.</summary>
    public const string DeleteForm = "delete-activity";
    /// <summary>The dialogs' ids, for links: <c>?dialog=new-activity</c>, <c>?dialog=edit-activity</c>, <c>?dialog=log-activity</c>.</summary>
    public const string NewId = "new-activity", EditId = "edit-activity", LogId = "log-activity";

    /// <summary>Whether the reader can schedule and edit (Policies.EditRecords). Without it there's no dialog.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The activity <c>?dialog=edit-activity</c> edits: the page's own.</summary>
    [Parameter] public int? Activity { get; set; }

    /// <summary>What a new activity starts as: a meeting, unless the page is about another kind.</summary>
    [Parameter] public ActivityType Type { get; set; } = ActivityType.Meeting;

    /// <summary>The person a new activity starts with: the page's own.</summary>
    [Parameter] public int? Contact { get; set; }

    /// <summary>The deal a new activity starts with, and so its primary contact: the page's own.</summary>
    [Parameter] public int? Deal { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }

    /// <summary>What a new one starts as, from a link: <c>&amp;as=call</c>. It wins over <see cref="Type"/>.</summary>
    [SupplyParameterFromQuery(Name = "as")] private string? Asked { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The activity as the form shows it, and as it posts.
    [SupplyParameterFromForm(FormName = "activity")] private ActivityInput? Input { get; set; }

    // The form's fields. The date and the time are two fields here and one value (Start) on the activity.
    private sealed class ActivityInput
    {
        public ActivityType Type { get; set; }

        [Required(ErrorMessage = "Enter a title."), StringLength(120, ErrorMessage = "Use 120 characters or fewer.")]
        public string? Title { get; set; }

        public int? ContactId { get; set; }

        public int? DealId { get; set; }

        [Required(ErrorMessage = "Choose a date.")] public DateOnly? Date { get; set; }

        [Required(ErrorMessage = "Choose a start time.")] public TimeOnly? StartTime { get; set; }

        public int Duration { get; set; } = 30;

        public string? AssignedToId { get; set; }

        public int? Reminder { get; set; }

        [StringLength(300, ErrorMessage = "Use 300 characters or fewer.")] public string? Location { get; set; }

        [StringLength(4000, ErrorMessage = "Use 4,000 characters or fewer.")] public string? Agenda { get; set; }
    }

    // The reminders offered; none is the list's empty choice.
    private static readonly List<int?> Reminders = Data.Activity.Reminders.Select(minutes => (int?)minutes).ToList();

    // "30 minutes before", "1 day before".
    private static string Before(int? minutes) => minutes >= 1440 ? "1 day before" : $"{minutes} minutes before";

    // The dialog's choices: every contact and every deal (each under its company) and every team member, by name.
    private Dictionary<int, (string Name, string? Company)> _contacts = [];
    private List<int?> _contactIds = [];
    private Dictionary<int, (string Name, string? Company, int? ContactId)> _deals = [];
    private List<int?> _dealIds = [];
    private Dictionary<string, string> _team = [];
    private List<string?> _teamIds = [];
    private List<int> _durations = [];
    private Workspace? _workspace;

    // Which of the three the address opens, if any: edit only on a page with an activity.
    private string? Opened => Dialog is NewId or LogId ? Dialog : Dialog == EditId && Activity is not null ? EditId : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!CanEdit || Opened is null) return;
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync() ?? new Workspace();
        // Under their companies, A to Z; those without a company last.
        _contacts = (await Db.Contacts.AsNoTracking().Include(c => c.Company).ToListAsync()).ToDictionary(c => c.Id, c => (c.Name, c.Company?.Name));
        _contactIds = _contacts.OrderBy(c => c.Value.Company ?? "￿").ThenBy(c => c.Value.Name).Select(c => (int?)c.Key).ToList();
        _deals = (await Db.Deals.AsNoTracking().Include(d => d.Company).ToListAsync()).ToDictionary(d => d.Id, d => (d.Name, d.Company?.Name, d.ContactId));
        _dealIds = _deals.OrderBy(d => d.Value.Company ?? "￿").ThenBy(d => d.Value.Name).Select(d => (int?)d.Key).ToList();
        _team = (await Db.Users.AsNoTracking().ToListAsync()).ToDictionary(u => u.Id, u => u.Name ?? u.Email ?? "");
        _teamIds = _team.OrderBy(t => t.Value).Select(t => (string?)t.Key).ToList();
        _durations = [.. Data.Activity.Durations];

        // A post brings the form's own values; otherwise the activity as it is, or a new one: a half-hour meeting of
        // yours today, at the next half hour, with the page's person or deal.
        if (Input is null)
        {
            if (Opened == EditId)
            {
                if (await Db.Activities.AsNoTracking().FirstOrDefaultAsync(a => a.Id == Activity) is { } activity)
                    Input = new ActivityInput
                    {
                        Type = activity.Type, Title = activity.Title, ContactId = activity.ContactId, DealId = activity.DealId,
                        Date = DateOnly.FromDateTime(activity.Start), StartTime = TimeOnly.FromDateTime(activity.Start), Duration = activity.Duration,
                        AssignedToId = activity.AssignedToId, Reminder = activity.Reminder, Location = activity.Location, Agenda = activity.Agenda,
                    };
            }
            else
            {
                var now = Clock.Now(_workspace);
                // One being logged has just happened: a call, at the quarter hour before now, with no reminder.
                var logging = Opened == LogId;
                var next = logging ? now.Date.AddMinutes(Math.Floor(now.TimeOfDay.TotalMinutes / 15) * 15) : now.Date.AddMinutes(Math.Ceiling((now.TimeOfDay.TotalMinutes + 1) / 30) * 30);
                var about = Deal is { } deal && _deals.ContainsKey(deal) ? Deal : null;
                var with = Contact is { } person && _contacts.ContainsKey(person) ? Contact : about is { } chosen ? _deals[chosen].ContactId : null;
                Input = new ActivityInput
                {
                    Type = Enum.TryParse<ActivityType>(Asked, ignoreCase: true, out var asked) && Enum.IsDefined(asked) ? asked : logging ? ActivityType.Call : Type,
                    ContactId = with, DealId = about, Reminder = logging ? null : 30,
                    Date = DateOnly.FromDateTime(next), StartTime = TimeOnly.FromDateTime(next),
                    AssignedToId = (await AuthState).User.UserId(),
                };
            }
        }

        // A length the form doesn't offer (one logged as 25 minutes) stays a choice for that activity.
        if (Input is not null && !_durations.Contains(Input.Duration) && Input.Duration is > 0 and <= 1440) _durations.Add(Input.Duration);
    }

    private async Task SaveAsync(EditContext form)
    {
        if (!CanEdit || Input is null) return;
        var (adding, logging) = (Opened != EditId, Opened == LogId);
        var saved = adding ? new Data.Activity() : await Db.Activities.FirstOrDefaultAsync(a => a.Id == Activity);
        if (saved is null)
        {
            Fail(form, nameof(Input.Title), "This activity isn’t here any more.");
            return;
        }

        // Only what the lists offer.
        if (!Enum.IsDefined(Input.Type)) { Fail(form, nameof(Input.Type), "Choose a type."); return; }
        if (Input.ContactId is { } contact && !_contacts.ContainsKey(contact)) { Fail(form, nameof(Input.ContactId), "Choose a contact, or no one."); return; }
        if (Input.DealId is { } deal && !_deals.ContainsKey(deal)) { Fail(form, nameof(Input.DealId), "Choose a deal, or no deal."); return; }
        if (!_durations.Contains(Input.Duration)) { Fail(form, nameof(Input.Duration), "Choose a duration."); return; }
        if (Input.Reminder is not null && !Reminders.Contains(Input.Reminder)) { Fail(form, nameof(Input.Reminder), "Choose a reminder, or no reminder."); return; }
        if (Blank(Input.AssignedToId) is { } assignee && !_team.ContainsKey(assignee)) { Fail(form, nameof(Input.AssignedToId), "Choose a team member."); return; }

        // The form's fields and nothing else: who created it and whether it's done aren't the form's to set.
        (saved.Type, saved.Title, saved.ContactId, saved.DealId) = (Input.Type, Input.Title!.Trim(), Input.ContactId, Input.DealId);
        // Another time or another reminder is reminded of again (Email/Reminders.cs).
        var start = Input.Date!.Value.ToDateTime(Input.StartTime!.Value);
        if (start != saved.Start || Input.Reminder != saved.Reminder) saved.Reminded = null;
        (saved.Start, saved.Duration) = (start, Input.Duration);
        (saved.AssignedToId, saved.Reminder, saved.Location, saved.Agenda) = (Blank(Input.AssignedToId), Input.Reminder, Blank(Input.Location), Blank(Input.Agenda));
        if (adding)
        {
            saved.CreatedById = (await AuthState).User.UserId();
            Db.Activities.Add(saved);
            // Logged, it's done already, and its contact has been heard from.
            if (logging)
            {
                (saved.Completed, saved.Reminder) = (DateTime.UtcNow, null);
                await Db.TouchContactAsync(saved.ContactId, saved.Completed.Value);
            }
        }

        // The audit log records it as it saves (Auditing/AuditInterceptor.cs).
        await Db.SaveChangesAsync();

        if (logging) Toasts.Success($"{saved.Title} is in the timeline.", "Activity logged");
        else if (adding) Toasts.Success($"{saved.Title} is on the calendar.", "Activity scheduled");
        else Toasts.Success($"{saved.Title} is up to date.", "Activity saved");
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["dialog"] = null, ["as"] = null }));
    }

    // Deletes the page's activity and what goes with it (Data/Deleting.cs), then shows the list.
    private async Task DeleteAsync()
    {
        if (!CanEdit) return;
        if (await Db.Activities.FirstOrDefaultAsync(r => r.Id == Activity) is { } doomed)
        {
            await Db.DeleteAsync(doomed);
            Toasts.Success($"{doomed.Title} is off the calendar.", "Activity deleted");
        }

        Navigation.NavigateTo("activities");
    }
}
