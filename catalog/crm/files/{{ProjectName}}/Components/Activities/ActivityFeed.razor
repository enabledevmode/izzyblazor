@* A record's activity feed, in one card: what happened with it and the notes written on it, newest first, as a
   timeline with an icon for each kind. Add opens the note form (Components/Notes/NoteDialog.razor) or the
   activity form (ActivityDialog.razor) as a meeting, a call or a task, over the page; the filters (?type=notes,
   meetings, calls) keep one kind. A note with a title links to its own page; one without leads with its text.
   Each note has a menu to edit or delete it. The page loads the entries and has the two dialogs:

   <ActivityFeed Title="Relationship timeline" Items="_history" Href="@($"contacts/{Id}")" On="@($"contacts/{Id}")" CanEdit="_canEdit" />

   NotesOnly is a card of notes alone, with an Add note button and no filters: an activity's own notes. *@
<Card Title="@Title" TitleLevel="2" Dividers="!NotesOnly">
    @if (CanEdit)
    {
        <CardActions>
            @if (NotesOnly)
            {
                <Button Href="@Add(NoteDialog.NewId)" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Plus">Add note</Button>
            }
            else
            {
                <Menu Placement="Placement.BottomEnd">
                    <Trigger>
                        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.Plus" EndIcon="Lucide.ChevronDown" @attributes="context">Add</Button>
                    </Trigger>
                    <ChildContent>
                        <MenuItem Href="@Add(NoteDialog.NewId)" Icon="Icon(FeedKind.Note)">Note</MenuItem>
                        <MenuItem Href="@Add(ActivityDialog.NewId, "meeting")" Icon="Icon(FeedKind.Meeting)">Meeting</MenuItem>
                        <MenuItem Href="@Add(ActivityDialog.NewId, "call")" Icon="Icon(FeedKind.Call)">Call</MenuItem>
                        <MenuItem Href="@Add(ActivityDialog.NewId, "task")" Icon="Icon(FeedKind.Task)">Task</MenuItem>
                    </ChildContent>
                </Menu>
            }
        </CardActions>
    }
    @if (!NotesOnly)
    {
        <CardBody>
            <TabNav Label="Filter activity" Variant="TabsVariant.Segmented" Size="ControlSize.Sm">
                <TabLink Href="@Href" Label="All" Current="@(Shown is null)" />
                <TabLink Href="@($"{Href}?type=notes")" Label="Notes" Current="@(Shown == FeedKind.Note)" />
                <TabLink Href="@($"{Href}?type=meetings")" Label="Meetings" Current="@(Shown == FeedKind.Meeting)" />
                <TabLink Href="@($"{Href}?type=calls")" Label="Calls" Current="@(Shown == FeedKind.Call)" />
            </TabNav>
        </CardBody>
    }
    <CardBody>
        @if (Entries.Count > 0)
        {
            <Timeline TimePlacement="TimelinePlacement.End">
                @foreach (var item in Entries)
                {
                    var note = item.Note;
                    <TimelineItem @key="item" Icon="Icon(item.Kind)" Status="Tone(item.Kind)" Time="@item.Time" DateTime="@item.When.ToString("yyyy-MM-ddTHH:mm")"
                                  Title="@(item.Title.Length > 0 ? item.Title : null)" Href="@(note?.Title is null ? null : $"notes/{note.Id}")"
                                  TitleContent="@(item.Title.Length > 0 ? null : Lead(item))" Actions="@(!CanEdit ? null : note is not null ? NoteMenu(note) : NoMenu)">
                        @* Up to two lines about it, then what kind it is, who, and where a note was written. *@
                        @if (item.Title.Length > 0 && !string.IsNullOrWhiteSpace(item.Text))
                        {
                            <TextBlock Color="Color.Muted" LineClamp="2">@item.Text</TextBlock>
                        }
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                            @string.Join(" · ", new[] { Kind(item.Kind), item.By, note is not null && note.Edited > note.Created ? "Edited" : null }.Where(part => part is not null))
                            @if (note is not null && FeedItem.Records(note).Where(r => r.Href != On).ToList() is { Count: > 0 } records)
                            {
                                <text> · Written on </text>
                                @foreach (var (record, index) in records.Select((r, i) => (r, i)))
                                {
                                    @(index > 0 ? ", " : "")<Anchor Href="@record.Href" InheritColor>@record.Name</Anchor>
                                }
                            }
                        </TextBlock>
                    </TimelineItem>
                }
            </Timeline>
        }
        else
        {
            <EmptyState Icon="@(NotesOnly || Shown == FeedKind.Note ? Lucide.NotebookPen : Lucide.Activity)" Size="ControlSize.Sm"
                        Title="@(Shown switch { FeedKind.Note => "No notes yet", FeedKind.Meeting => "No meetings yet", FeedKind.Call => "No calls yet", _ => NotesOnly ? "No notes yet" : "Nothing yet" })"
                        Description="@(CanEdit ? NotesOnly ? "Add a note to record what was decided." : "Add a note, or log a meeting or a call." : null)" />
        }
    </CardBody>
</Card>

@code {
    /// <summary>The card's title: "Relationship timeline", "Deal activity", "Notes".</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The entries, newest first. A note's has its Note, with its Author, Contact, Deal, Company and Activity.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<FeedItem> Items { get; set; } = [];

    /// <summary>The address of the page it's on, such as "contacts/7": where the filters link and the dialogs open.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    /// <summary>The page's own record, such as "contacts/7": left out of each note's "Written on".</summary>
    [Parameter] public string? On { get; set; }

    /// <summary>Whether the reader can add and change (Policies.EditRecords).</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>A card of notes alone: an Add note button, no filters.</summary>
    [Parameter] public bool NotesOnly { get; set; }

    /// <summary>The kind the filter keeps: "notes", "meetings" or "calls"; everything without one.</summary>
    [SupplyParameterFromQuery(Name = "type")] private string? Type { get; set; }

    private FeedKind? Shown => NotesOnly ? null : Type switch
    {
        "notes" => FeedKind.Note,
        "meetings" => FeedKind.Meeting,
        "calls" => FeedKind.Call,
        _ => null,
    };

    private IReadOnlyList<FeedItem> Entries => Shown is { } kind ? Items.Where(i => i.Kind == kind).ToList() : Items;

    // The page with a form open on it: a note's, or the activity form as a kind.
    private string Add(string dialog, string? type = null) => $"{Href}?dialog={dialog}{(type is null ? "" : $"&type={type}")}";

    private static IconData Icon(FeedKind kind) => kind switch
    {
        FeedKind.Note => Lucide.NotebookPen,
        FeedKind.Meeting => Lucide.Video,
        FeedKind.Call => Lucide.Phone,
        FeedKind.Task => Lucide.CircleCheck,
        _ => Lucide.Activity,
    };

    // Each kind's marker has its own tint, so a long feed can be scanned for one.
    private static Status Tone(FeedKind kind) => kind switch
    {
        FeedKind.Note => Status.Warning,
        FeedKind.Meeting => Status.Info,
        FeedKind.Call => Status.Success,
        _ => Status.Neutral,
    };

    private static string? Kind(FeedKind kind) => kind == FeedKind.Event ? null : kind.ToString();

    // A note with no title leads with its own text, up to four lines.
    private static RenderFragment Lead(FeedItem item) => __builder =>
    {
        <TextBlock As="span" LineClamp="4">@item.Text</TextBlock>
    };

    // An entry with no menu keeps a menu button's room, so every entry's time ends on the same line.
    private static readonly RenderFragment NoMenu = __builder =>
    {
        <Box Width="Length.Rem(2)" aria-hidden="true" />
    };

    private RenderFragment NoteMenu(Note note) => __builder =>
    {
        <Menu Placement="Placement.BottomEnd">
            <Trigger>
                <IconButton Label="@($"Options for {note.Title ?? $"note from {FeedItem.Written(note.Created, null, default)}"}")" Icon="Lucide.Ellipsis" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" @attributes="context" />
            </Trigger>
            <ChildContent>
                <MenuItem Href="@($"{Href}?dialog={NoteDialog.EditId}&note={note.Id}")" Icon="Lucide.Pencil">Edit</MenuItem>
                <MenuItem Href="@($"{Href}?dialog={NoteDialog.DeleteId}&note={note.Id}")" Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
            </ChildContent>
        </Menu>
    };
}
