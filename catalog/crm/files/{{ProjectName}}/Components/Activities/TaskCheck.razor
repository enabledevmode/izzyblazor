@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject Audit Audit
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject ToastService Toasts

@* A task's box: ticking it posts and marks the task done, clearing it reopens the task. A form of its own, holding
   only the box, so it saves as it changes (SubmitOnChange); the page then loads again, with the task in ?done=.
   People who can't edit records see the box but can't change it. *@
<Form Model="Model" FormName="@($"task-{Task.Id}")" OnValidSubmit="Save" Shrink="false">
    <input type="hidden" name="Model.Id" value="@Task.Id" />
    <Checkbox @bind-Value="Model!.Done" SubmitOnChange HideLabel Label="@($"Complete {Task.Title}")" Disabled="!_canEdit" />
    @* With JavaScript off, nothing posts the form as the box changes, so this does. *@
    <noscript><Button Submit Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Save</Button></noscript>
</Form>

@code {
    /// <summary>The task.</summary>
    [Parameter, EditorRequired] public Activity Task { get; set; } = null!;

    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = null!;

    [SupplyParameterFromQuery] private string? Done { get; set; }

    // What a box posted: any task's on the page, so each takes only its own.
    [SupplyParameterFromForm] private Toggle? Model { get; set; }

    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        if (Model?.Id != Task.Id) Model = new Toggle { Id = Task.Id, Done = Task.Completed is not null };
        _canEdit = (await Authorization.AuthorizeAsync((await Auth).User, Policies.EditRecords)).Succeeded;
    }

    private async Task Save()
    {
        if (!_canEdit) return;
        if (await Db.Activities.FirstOrDefaultAsync(a => a.Id == Task.Id && a.Type == ActivityType.Task) is { } task
            && task.Completed is null == Model!.Done)
        {
            task.Completed = Model.Done ? DateTime.UtcNow : null;
            // Done is its own line in the audit log; reopening is an ordinary change.
            Db.Auditing = !Model.Done;
            await Db.SaveChangesAsync();
            Db.Auditing = true;
            if (Model.Done)
                await Audit.RecordAsync(AuditActions.Completed, nameof(Activity), task.Id.ToString(), task.Title, [new AuditChange("Status", null, "Completed")]);
            Toasts.Success(task.Title, Model.Done ? "Task completed" : "Task reopened");
        }

        // Back to the page, which loads again with its counts up to date. Its address lists the tasks just done
        // (?done=4,7), so a page that shows only open tasks can keep them in sight, struck through.
        var done = Ids(Done).Where(id => id != Task.Id).ToList();
        if (Model!.Done) done.Add(Task.Id);
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("done", done.Count == 0 ? null : string.Join(',', done)));
    }

    /// <summary>The task ids in a page's ?done= value.</summary>
    public static IReadOnlyList<int> Ids(string? done) =>
        [.. (done ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(id => int.TryParse(id, out var n) ? n : 0).Where(n => n > 0).Take(50)];

    public sealed class Toggle
    {
        public int Id { get; set; }

        public bool Done { get; set; }
    }
}
