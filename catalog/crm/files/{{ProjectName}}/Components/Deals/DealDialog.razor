@using Microsoft.EntityFrameworkCore
@using System.ComponentModel.DataAnnotations
@inject ApplicationDbContext Db
@inject Audit Audit
@inject NavigationManager Navigation
@inject ToastService Toasts

@* The deal form, in a dialog over the page that asked for it: a link to that page's own address with
   ?dialog=new-deal adds one, and with ?dialog=edit-deal edits the page's deal. Put one on a page that has such a
   link:

   <DealDialog CanEdit="_canEdit" />                     the pipeline: add
   <DealDialog CanEdit="_canEdit" Company="Id" />        a company: add, with it chosen
   <DealDialog CanEdit="_canEdit" Contact="Id" />        a contact: add, with them and their company chosen
   <DealDialog CanEdit="_canEdit" Deal="Id" />           a deal: edit

   It saves and comes back to the page, without the ?dialog. A new deal starts in one of the pipeline's four
   stages. Editing offers Won and Lost too, and a closed deal moved back to a stage is open again; a change of
   stage is its own line in the audit log, as it is from the deal's page. The primary contact has to be someone
   at the deal's company: the list shows everyone, under their companies, since it can't follow the company
   chosen without a trip to the server. *@
@if (CanEdit && Input is not null && Opened is not null)
{
    var adding = Opened == NewId;
    <Dialog Id="@Opened" Title="@(adding ? "New deal" : "Edit deal")" Size="DialogSize.Lg" CloseOnBackdrop="false">
        <Form Model="Input" FormName="deal" OnValidSubmit="SaveAsync">
            @if (adding)
            {
                <TextBlock Color="Color.Muted">Track a concrete opportunity from discovery to a decision.</TextBlock>
            }
            <Fieldset Label="Opportunity" Description="Describe the work and who you are selling to." Columns="2">
                <TextField @bind-Value="Input.Name" Label="Deal name" autocomplete="off" />
                <Select @bind-Value="Input.CompanyId" Label="Company" Items="_companyIds" ItemText="id => _companies[id!.Value]" Placeholder="Choose a company" />
                <Select @bind-Value="Input.ContactId" Label="Primary contact" Items="_contactIds" ItemText="id => _contacts[id!.Value].Name"
                        ItemGroup="id => _companies.GetValueOrDefault(_contacts[id!.Value].CompanyId ?? 0)" Placeholder="No one yet" />
                <Select @bind-Value="Input.OwnerId" Label="Owner" Items="_ownerIds" ItemText="id => _owners[id!]" />
            </Fieldset>
            <Fieldset Label="Value &amp; timing" Description="Use the same stages across the team." Columns="2">
                <NumberField @bind-Value="Input.Value" Label="@($"Value ({_currency})")" Min="0" StepButtons="StepButtons.None" />
                <Select @bind-Value="Input.Stage" Label="Stage" Items="@(adding ? Pipeline : Stages)" />
                <DateField @bind-Value="Input.ExpectedClose" Label="Expected close date" />
                <Select @bind-Value="Input.Source" Label="Source" Placeholder="Not recorded" />
            </Fieldset>
            <TextArea @bind-Value="Input.Scope" Label="Scope and next steps" Placeholder="What is included, and what needs to happen next?" Rows="4" />
            @* Editing, Delete is at the footer's other end: it asks first (the ConfirmDialog below). *@
            <DialogFooter Justify="@(adding ? Justify.End : Justify.Between)">
                @if (!adding)
                {
                    <Button Submit Form="@DeleteForm" Variant="ButtonVariant.Ghost" Accent="Accent.Danger" StartIcon="Lucide.Trash" Class="@DeleteForm" data-confirm="@Input.Name">Delete</Button>
                }
                <Row Gap="2">
                    <DialogClose>Cancel</DialogClose>
                    <Button Submit>@(adding ? "Create deal" : "Save changes")</Button>
                </Row>
            </DialogFooter>
        </Form>
    </Dialog>
}

@if (CanEdit && Opened == EditId)
{
    @* Delete posts this form, once the dialog has asked. *@
    <form id="@DeleteForm" method="post" @formname="@DeleteForm" @onsubmit="DeleteAsync">
        <AntiforgeryToken />
    </form>
    <ConfirmDialog For="@($".{DeleteForm}")" Title="Delete {0}?" Message="Its files go too, with the notes and activities about it alone. This can’t be undone." ConfirmText="Delete" Accent="Accent.Danger" />
}

@code {
    /// <summary>The form the edit dialog's Delete posts, and the class the confirmation is for.</summary>
    public const string DeleteForm = "delete-deal";
    /// <summary>The dialogs' ids, for links: <c>?dialog=new-deal</c>, <c>?dialog=edit-deal</c>.</summary>
    public const string NewId = "new-deal", EditId = "edit-deal";

    /// <summary>Whether the reader can add and edit (Policies.EditRecords). Without it there's no dialog.</summary>
    [Parameter] public bool CanEdit { get; set; }

    /// <summary>The deal <c>?dialog=edit-deal</c> edits: the page's own.</summary>
    [Parameter] public int? Deal { get; set; }

    /// <summary>The company a new deal starts with: the page's own.</summary>
    [Parameter] public int? Company { get; set; }

    /// <summary>The person a new deal starts with, and so their company: the page's own.</summary>
    [Parameter] public int? Contact { get; set; }

    [SupplyParameterFromQuery(Name = "dialog")] private string? Dialog { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // The deal as the form shows it, and as it posts.
    [SupplyParameterFromForm(FormName = "deal")] private DealInput? Input { get; set; }

    // The form's fields. What a deal can't be saved without is empty until it's chosen, so each has its own message.
    private sealed class DealInput
    {
        [Required(ErrorMessage = "Enter a deal name."), StringLength(120, ErrorMessage = "Use 120 characters or fewer.")]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Choose a company.")] public int? CompanyId { get; set; }

        public int? ContactId { get; set; }

        public string? OwnerId { get; set; }

        [Required(ErrorMessage = "Enter the deal’s value."), Range(0, 1_000_000_000, ErrorMessage = "Enter a value of 0 or more.")]
        public decimal? Value { get; set; }

        public DealStage Stage { get; set; }

        [Required(ErrorMessage = "Choose an expected close date.")] public DateOnly? ExpectedClose { get; set; }

        public DealSource? Source { get; set; }

        [StringLength(4000, ErrorMessage = "Use 4,000 characters or fewer.")] public string? Scope { get; set; }
    }

    // The stages a new deal can start in, and every stage: an existing deal can be won, lost or reopened here.
    private static readonly DealStage[] Pipeline = [DealStage.Discovery, DealStage.Qualified, DealStage.Proposal, DealStage.Negotiation];
    private static readonly DealStage[] Stages = Enum.GetValues<DealStage>();

    // The dialog's choices: every company, every contact (with their company) and every team member, by name.
    private Dictionary<int, string> _companies = [];
    private List<int?> _companyIds = [];
    private Dictionary<int, (string Name, int? CompanyId)> _contacts = [];
    private List<int?> _contactIds = [];
    private Dictionary<string, string> _owners = [];
    private List<string?> _ownerIds = [];
    private Workspace? _workspace;
    private string _currency = "USD";

    // Which of the two the address opens, if either: edit only on a page with a deal.
    private string? Opened => Dialog == NewId ? NewId : Dialog == EditId && Deal is not null ? EditId : null;

    protected override async Task OnParametersSetAsync()
    {
        if (!CanEdit || Opened is null) return;
        _workspace = await Db.Workspaces.AsNoTracking().FirstOrDefaultAsync() ?? new Workspace();
        _currency = _workspace.Currency;
        _companies = await Db.Companies.AsNoTracking().ToDictionaryAsync(c => c.Id, c => c.Name);
        _companyIds = _companies.OrderBy(c => c.Value).Select(c => (int?)c.Key).ToList();
        _contacts = (await Db.Contacts.AsNoTracking().ToListAsync()).ToDictionary(c => c.Id, c => (c.Name, c.CompanyId));
        // Under their companies, A to Z; people without a company last.
        _contactIds = _contacts
            .OrderBy(c => c.Value.CompanyId is { } at && _companies.TryGetValue(at, out var name) ? name : "￿")
            .ThenBy(c => c.Value.Name).Select(c => (int?)c.Key).ToList();
        _owners = (await Db.Users.AsNoTracking().ToListAsync()).ToDictionary(u => u.Id, u => u.Name ?? u.Email ?? "");
        _ownerIds = _owners.OrderBy(o => o.Value).Select(o => (string?)o.Key).ToList();

        // A post brings the form's own values; otherwise the deal as it is, or a new one: yours, in Discovery, with
        // the page's company or person.
        if (Input is not null) return;
        if (Opened == EditId)
        {
            if (await Db.Deals.AsNoTracking().FirstOrDefaultAsync(d => d.Id == Deal) is { } deal)
                Input = new DealInput
                {
                    Name = deal.Name, CompanyId = deal.CompanyId, ContactId = deal.ContactId, OwnerId = deal.OwnerId, Value = Plain(deal.Value),
                    Stage = deal.Stage, ExpectedClose = deal.ExpectedClose, Source = deal.Source, Scope = deal.Scope,
                };
        }
        else
        {
            var me = (await AuthState).User.UserId();
            var with = Contact is { } person && _contacts.ContainsKey(person) ? Contact : null;
            var at = with is { } chosen ? _contacts[chosen].CompanyId : Company;
            Input = new DealInput
            {
                OwnerId = me, Stage = DealStage.Discovery, Source = DealSource.Referral, ContactId = with,
                CompanyId = at is { } id && _companies.ContainsKey(id) ? id : null,
            };
        }
    }

    private async Task SaveAsync(EditContext form)
    {
        if (!CanEdit || Input is null) return;
        var adding = Opened == NewId;
        var saved = adding ? new Data.Deal() : await Db.Deals.FirstOrDefaultAsync(d => d.Id == Deal);
        if (saved is null)
        {
            Fail(form, nameof(Input.Name), "This deal isn’t here any more.");
            return;
        }

        var companyId = Input.CompanyId!.Value;
        if (!_companies.TryGetValue(companyId, out var company))
        {
            Fail(form, nameof(Input.CompanyId), "Choose a company.");
            return;
        }

        // The primary contact is someone at the deal's company.
        if (Input.ContactId is { } contactId && (!_contacts.TryGetValue(contactId, out var contact) || contact.CompanyId != companyId))
        {
            Fail(form, nameof(Input.ContactId), $"Choose someone at {company}, or no one yet.");
            return;
        }

        // A new deal starts in the pipeline.
        if (adding && !Pipeline.Contains(Input.Stage) || !Enum.IsDefined(Input.Stage))
        {
            Fail(form, nameof(Input.Stage), "Choose a stage.");
            return;
        }

        // The form's fields and nothing else: the day it was created isn't the form's to set.
        var today = DateOnly.FromDateTime(Clock.Now(_workspace));
        var from = saved.Stage;
        (saved.Name, saved.CompanyId, saved.ContactId, saved.OwnerId) = (Input.Name!.Trim(), companyId, Input.ContactId, Blank(Input.OwnerId));
        (saved.Value, saved.ExpectedClose, saved.Source, saved.Scope) = (Input.Value!.Value, Input.ExpectedClose!.Value, Input.Source, Blank(Input.Scope));
        if (adding)
        {
            (saved.Stage, saved.Created) = (Input.Stage, today);
            Db.Deals.Add(saved);
        }

        // The audit log records it as it saves (Auditing/AuditInterceptor.cs).
        await Db.SaveChangesAsync();

        // Another stage is its own line in the log, as from the deal's page. Won or Lost closes the deal today;
        // back in the pipeline, it's open again.
        if (!adding && Input.Stage != from) await Audit.MoveAsync(saved, Input.Stage, today);

        if (adding) Toasts.Success($"{saved.Name} is in your pipeline.", "Deal created");
        else Toasts.Success($"{saved.Name} is up to date.", "Deal saved");
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("dialog", (string?)null));
    }

    // Without the database's trailing ".0": 18000, not 18000.0.
    private static decimal Plain(decimal value) => value % 1 == 0 ? decimal.Truncate(value) : value;

    // Deletes the page's deal and what goes with it (Data/Deleting.cs), then shows the pipeline.
    private async Task DeleteAsync()
    {
        if (!CanEdit) return;
        if (await Db.Deals.FirstOrDefaultAsync(r => r.Id == Deal) is { } doomed)
        {
            await Db.DeleteAsync(doomed);
            Toasts.Success($"{doomed.Name} is gone for everyone.", "Deal deleted");
        }

        Navigation.NavigateTo("deals");
    }
}
