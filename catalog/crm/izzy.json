// Izzy CRM: a whole static app over the blazor starter (Individual accounts, every page static, the sidebar):
// contacts, companies, a deal pipeline, activities and reports, with Identity roles, settings and team, an audit
// log of every change, seeded sample data and deploy files that need no sticky sessions. Accounts come by invite:
// no Register page. Design: artifacts/izzyblazor-handoff-crm.md.
{
  "id": "crm",
  "name": "Izzy CRM",
  "kind": "kit",
  "tier": "account",
  "category": "App kits",
  "summary": "A whole CRM, every page static: contacts, companies, a deal pipeline, activities and reports, with a team, roles, an audit log and sample data.",
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "none", "Auto": "none" },
  "modesNote": "Izzy CRM's pages read the database on the server, so they can't run in the browser as generated.",
  "base": {
    "item": "blazor",
    "fixed": {
      "Interactivity": "None", "AllInteractive": "false", "Auth": "Individual", "UseLocalDB": "false",
      "Empty": "false", "Nav": "Sidebar", "UseProgramMain": "false", "NoHttps": "false",
      "Registration": "false", "Preset": "Compact"
    }
  },
  "exclude": [
    {
      "if": "true",
      "paths": [
        "{{ProjectName}}/Data/app.db",
        "{{ProjectName}}/Data/SqlLite/**",
        "{{ProjectName}}/Components/Pages/Counter.*",
        "{{ProjectName}}/Components/Pages/Weather.*",
        "{{ProjectName}}/Components/Pages/Contact.*",
        "{{ProjectName}}/Components/Pages/Auth.*",
        "{{ProjectName}}/Components/Account/Pages/Manage/DeletePersonalData.razor"
      ]
    }
  ],
  "screens": [
    {"file": "dashboard", "caption": "My day", "alt": "My day: the open pipeline, follow-ups due, next moves and recent activity"},
    {"file": "contacts", "caption": "Contacts", "alt": "The contacts list, with search and filters"},
    {"file": "contact", "caption": "A contact", "alt": "A contact's page: their details, deals, activities and notes"},
    {"file": "company", "caption": "A company", "alt": "A company's page: its details, people and deals"},
    {"file": "pipeline", "caption": "Deal pipeline", "alt": "The deal pipeline: each deal with its company, stage, value and expected close"},
    {"file": "board", "caption": "Deal pipeline as a board", "alt": "The deal pipeline as a board: a column for each stage with its count and total, and a card for each deal"},
    {"file": "deal", "caption": "A deal", "alt": "A deal's page: its stage, value and history"},
    {"file": "calendar", "caption": "Activities", "alt": "The week's activities on a calendar"},
    {"file": "reports", "caption": "Reports", "alt": "The sales overview: charts of the pipeline and the team's results"},
    {"file": "team", "caption": "Settings and team", "alt": "Settings and team: the workspace's members and their roles"},
    {"file": "audit-log", "caption": "Audit log", "alt": "The audit log: who changed what, newest first"},
    {"file": "sign-in", "caption": "Log in", "alt": "The log-in page"},
    {"file": "phone-dashboard", "caption": "My day on a phone", "alt": "My day at a phone's width", "phone": true},
    {"file": "phone-pipeline", "caption": "Deal pipeline on a phone", "alt": "The deal pipeline at a phone's width", "phone": true},
    {"file": "phone-contact", "caption": "A contact on a phone", "alt": "A contact's page at a phone's width", "phone": true}
  ]
}
