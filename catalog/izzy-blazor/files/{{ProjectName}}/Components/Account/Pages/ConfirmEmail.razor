@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using {{RootNamespace}}.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirm email</PageTitle>

@* The outcome is the title, and each has its next step. *@
@if (confirmed)
{
    <AccountPanel Title="Email confirmed" Description="Thanks for confirming. You can log in now.">
        <Button Href="Account/Login" FullWidth>Log in</Button>
    </AccountPanel>
}
else
{
    <AccountPanel Title="This link didn't work" Description="It's invalid or has expired. Send yourself a new one.">
        <Button Href="Account/ResendEmailConfirmation" FullWidth>Send a new confirmation link</Button>
    </AccountPanel>
}

@code {
    private bool confirmed;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        // An unknown user gets the same answer as a bad link.
        var user = await UserManager.FindByIdAsync(UserId);
        if (user is not null)
        {
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            confirmed = result.Succeeded;
        }
    }
}
