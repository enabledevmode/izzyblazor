@* The frame of the pages you see before you log in, after shadcn's sign-in form: no card, a large
   title, a 22rem column centered across the page and in the top 70% of the screen (a little above
   the middle); on phones it starts at the top. The title is the page's h1. *@
<Center MinHeight="new() { Md = Length.Dvh(70) }" PaddingY="new() { Base = 4, Md = 8 }">
    <Column Gap="6" Width="Length.Full" MaxWidth="Length.Rem(22)">
        @if (Title is not null)
        {
            <Column Gap="2">
                <Heading Level="1" Size="TextSize.Xl3">@Title</Heading>
                @if (Description is not null)
                {
                    <TextBlock Color="Color.Muted">@Description</TextBlock>
                }
            </Column>
        }
        <Column Gap="4">
            @ChildContent
        </Column>
    </Column>
</Center>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
