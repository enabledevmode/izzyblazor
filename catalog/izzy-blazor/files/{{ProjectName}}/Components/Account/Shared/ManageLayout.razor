@inherits LayoutComponentBase
@*#if (UseWebAssembly && InteractiveAtRoot) *@
@layout {{RootNamespace}}.Client.Layout.MainLayout
@*#else *@
@layout {{RootNamespace}}.Components.Layout.MainLayout
@*#endif *@

@* The settings page: the Wide column (64rem) from the main area's edge, the page header, then the
   sections as tabs, whose line runs the full width and sets the nav apart from the page. The
   section draws in the Medium column (48rem) under it. On phones the tabs are a dropdown naming
   the section you're in. *@
<Container Size="ContainerSize.Lg" Align="ContainerAlign.Start" Gutters="false">
    <Column Gap="6">
        <PageHeader Title="Manage your account" />
        <ManageNavMenu />
        <Container Size="ContainerSize.Md" Align="ContainerAlign.Start" Gutters="false" MarginTop="2">
            <Column Gap="6">
                @Body
            </Column>
        </Container>
    </Column>
</Container>
