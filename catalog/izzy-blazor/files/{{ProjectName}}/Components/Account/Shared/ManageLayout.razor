@inherits LayoutComponentBase
@*#if (UseWebAssembly && InteractiveAtRoot) *@
@layout {{RootNamespace}}.Client.Layout.MainLayout
@*#else *@
@layout {{RootNamespace}}.Components.Layout.MainLayout
@*#endif *@

@* The settings page: the Wide column (64rem) from the main area's edge, the page header, then the
   section nav (15rem, so "Two-factor authentication" fits on a line) beside the Medium column
   (48rem) the section draws in. On phones the nav is a dropdown above the section, naming the one
   you're in. *@
<Container Size="ContainerSize.Lg" Align="ContainerAlign.Start" Gutters="false">
    <Column Gap="new() { Base = 6, Md = 8 }">
        <PageHeader Title="Manage your account" Description="Your sign-in details, security and data." />
        <Grid Template="@(new Responsive<string> { Base = "1fr", Md = "15rem 1fr" })" Gap="8" Align="Align.Start">
            <ManageNavMenu />
            <Container Size="ContainerSize.Md" Align="ContainerAlign.Start" Gutters="false">
                <Column Gap="6">
                    @Body
                </Column>
            </Container>
        </Grid>
    </Column>
</Container>
