<Card Title="Recovery codes" TitleLevel="2">
    <StatusMessage Message="@StatusMessage" />
    <Alert Status="Status.Warning" Title="Put these codes in a safe place">
        If you lose your device and don't have the recovery codes, you lose access to your account.
    </Alert>
    <Grid Columns="new() { Base = 2, Sm = 5 }" Gap="2" id="recovery-codes" MaxWidth="Length.Rem(36)">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <Code>@recoveryCode</Code>
        }
    </Grid>
    <Row Gap="2" Wrap>
        <CopyButton Text="@string.Join(Environment.NewLine, RecoveryCodes)" Variant="ButtonVariant.Outline">Copy codes</CopyButton>
        <Button Href="Account/Manage/TwoFactorAuthentication">Done</Button>
    </Row>
</Card>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
