@* The title is the instruction, so there's no warning to read past before the codes. *@
<PageHeader Title="Save your recovery codes" TitleLevel="2" Size="ControlSize.Sm"
            Description="Each works once. Lose your phone and these, and you lose the account." />
<StatusMessage Message="@StatusMessage" />
<Grid Columns="2" Gap="2" id="recovery-codes" MaxWidth="Length.Rem(24)">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <Code>@recoveryCode</Code>
    }
</Grid>
<Row Gap="2" Wrap>
    <CopyButton Text="@string.Join(Environment.NewLine, RecoveryCodes)" Variant="ButtonVariant.Solid" Accent="Accent.Primary">Copy codes</CopyButton>
    <Button Href="Account/Manage/TwoFactorAuthentication" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Done</Button>
</Row>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
