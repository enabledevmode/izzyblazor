@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using {{RootNamespace}}.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@if (externalLogins.Length > 0)
{
    @if (Divider)
    {
        <Divider Label="or" />
    }
    <form action="Account/PerformExternalLogin" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        <Column Gap="3">
            @foreach (var provider in externalLogins)
            {
                <Button Submit Name="provider" Value="@provider.Name" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" FullWidth>Continue with @provider.DisplayName</Button>
            }
        </Column>
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    /// <summary>An "or" divider above the buttons. Off where the page already has one, as Log in does.</summary>
    [Parameter]
    public bool Divider { get; set; } = true;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
