@using Microsoft.AspNetCore.Identity
@using {{RootNamespace}}.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager NavigationManager

@* The sections, beside the page from Md up; on phones a dropdown whose button names the section
   you're in. A section's own steps (set up, reset, rename, delete) keep it current. *@
<NavMenu aria-label="Account" VisibleFrom="Breakpoint.Md">
    @Items
</NavMenu>
<Popover HiddenFrom="Breakpoint.Md" Width="Length.Full" PanelWidth="Length.Full">
    <Trigger Context="trigger">
        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="@current.Icon" EndIcon="Lucide.ChevronDown" @attributes="trigger">
            <TextBlock As="span" Align="TextAlign.Start" Truncate Grow>@current.Title</TextBlock>
        </Button>
    </Trigger>
    <ChildContent>
        <NavMenu aria-label="Account">
            @Items
        </NavMenu>
    </ChildContent>
</Popover>

@code {
    private sealed record Section(string Title, string Href, IconData Icon, params string[] Pages);

    private Section[] sections = [];
    private Section current = null!;

    protected override async Task OnInitializedAsync()
    {
        var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
        sections =
        [
            new("Profile", "Account/Manage", Lucide.User, ""),
            new("Email", "Account/Manage/Email", Lucide.AtSign, "Email"),
            new("Password", "Account/Manage/ChangePassword", Lucide.KeyRound, "ChangePassword", "SetPassword"),
            .. hasExternalLogins ? [new Section("External logins", "Account/Manage/ExternalLogins", Lucide.Link, "ExternalLogins")] : Array.Empty<Section>(),
            new("Two-factor authentication", "Account/Manage/TwoFactorAuthentication", Lucide.Shield,
                "TwoFactorAuthentication", "EnableAuthenticator", "ResetAuthenticator", "Disable2fa", "GenerateRecoveryCodes"),
            new("Passkeys", "Account/Manage/Passkeys", Lucide.FingerprintPattern, "Passkeys", "RenamePasskey"),
            new("Personal data", "Account/Manage/PersonalData", Lucide.Database, "PersonalData", "DeletePersonalData"),
        ];
        var page = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].TrimEnd('/');
        current = sections.FirstOrDefault(s => s.Pages.Any(p => page.Equals(p.Length == 0 ? "Account/Manage" : "Account/Manage/" + p, StringComparison.OrdinalIgnoreCase)))
            ?? sections[0];
    }

    private RenderFragment Items => __builder =>
    {
        foreach (var section in sections)
        {
            <NavItem Href="@section.Href" Icon="section.Icon" Current="@(section == current)">@section.Title</NavItem>
        }
    };
}
