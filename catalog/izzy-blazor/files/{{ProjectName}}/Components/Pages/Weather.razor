@page "/weather"
@*#if (!InteractiveAtRoot) *@
@attribute [StreamRendering]
@*#endif *@

<PageTitle>Weather</PageTitle>

@* The data page: the Medium column (48rem) from the main area's edge, the page header, then the
   table, bordered, at the column's width. While the forecast loads, the table shows placeholder
   rows at the height the rows will take, so nothing moves when they arrive. *@
<Container Size="ContainerSize.Md" Align="ContainerAlign.Start" Gutters="false">
    <Column Gap="new() { Base = 6, Md = 8 }">
        <PageHeader Title="Weather" Description="Five days of forecasts. Sort and filter through the address." />
        <Table Items="forecasts ?? []" Loading="forecasts is null" Caption="Forecast" Striped InitialSort="date" FilterPanel>
            <Columns>
                <PropertyColumn Property="f => f.Date" Title="Date" Format="d" Sortable Filterable />
                <PropertyColumn Property="f => f.TemperatureC" Title="Temp. (C)" Align="CellAlign.End" Sortable Filterable />
                <PropertyColumn Property="f => f.TemperatureF" Title="Temp. (F)" Align="CellAlign.End" Sortable />
                <PropertyColumn Property="f => f.Summary" Title="Summary" Sortable Filterable />
            </Columns>
            <EmptyContent>
                <EmptyState Size="ControlSize.Sm" Icon="Lucide.Funnel" Title="No matching days" Description="Change or clear the filters.">
                    <EmptyStateActions>
                        <Button Href="weather" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Clear filters</Button>
                    </EmptyStateActions>
                </EmptyState>
            </EmptyContent>
        </Table>
    </Column>
</Container>

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
@*#if (InteractiveAtRoot) *@
        // Simulate asynchronous loading to demonstrate a loading indicator
@*#else *@
        // Simulate asynchronous loading to demonstrate streaming rendering
@*#endif *@
        await Task.Delay(500);

        var startDate = DateOnly.FromDateTime(DateTime.Now);
        // The same forecast all day, so sorting and filtering, which load the page again, show the same days.
        var random = new Random(startDate.DayNumber);
        var summaries = new[] { "Freezing", "Bracing", "Chilly", "Cool", "Mild", "Warm", "Balmy", "Hot", "Sweltering", "Scorching" };
        forecasts = Enumerable.Range(1, 5).Select(index => new WeatherForecast
        {
            Date = startDate.AddDays(index),
            TemperatureC = random.Next(-20, 55),
            Summary = summaries[random.Next(summaries.Length)]
        }).ToArray();
    }

    private class WeatherForecast
    {
        public DateOnly Date { get; set; }
        public int TemperatureC { get; set; }
        public string? Summary { get; set; }
        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
