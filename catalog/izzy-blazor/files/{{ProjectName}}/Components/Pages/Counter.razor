@*#if (UseServer) *@
@page "/counter"
@*#if (!InteractiveAtRoot) *@
@rendermode InteractiveServer
@*#endif *@

<PageTitle>Counter</PageTitle>

@* Where the C# runs is the point of the page, so it's the badge beside the title. The demo is in a
   card, apart from the page's text; the line beside the button says what a click just did. *@
<Container Size="ContainerSize.Md" Align="ContainerAlign.Start" Gutters="false">
    <Column Gap="new() { Base = 6, Md = 8 }">
        <PageHeader Title="Counter" Description="Click the button and watch where the C# runs.">
            <PageHeaderActions>
                <Badge Status="@Mode.Status" Pill Dot>@Mode.Text</Badge>
            </PageHeaderActions>
        </PageHeader>
        <Card>
            <CardBody Gap="5">
                <Box Width="Length.Full" MaxWidth="Length.Rem(24)">
                    <LinearGauge Label="Count" Value="currentCount" Max="ScaleMax" Step="ScaleMax / 5" ValueFormat="0" />
                </Box>
                <LiveRegion Text="@($"Count: {currentCount}")" />
                <Row Gap="4" Wrap Align="Align.Center">
                    <Button OnClick="IncrementCount" StartIcon="Lucide.Plus">Click me</Button>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Mode.Note</TextBlock>
                </Row>
            </CardBody>
        </Card>
    </Column>
</Container>

@code {
    private int currentCount = 0;

    // The scale grows by tens as the count passes them: 0 to 10, then 0 to 20, and so on.
    private int ScaleMax => (currentCount / 10 + 1) * 10;

    // Where the C# runs now. Auto starts on the server and moves to the browser once the
    // WebAssembly runtime has downloaded; before the page is interactive, it was prerendered.
    private (string Text, Status Status, string Note) Mode => (RendererInfo.IsInteractive, RendererInfo.Name, AssignedRenderMode is InteractiveAutoRenderMode) switch
    {
        (false, _, _) => ("Prerendered on the server", Status.Neutral, "Clicks work once the page is interactive."),
        (_, "WebAssembly", true) => ("Auto: now in your browser", Status.Success, "The WebAssembly runtime arrived, so clicks now run in your browser."),
        (_, "WebAssembly", false) => ("C# runs in your browser", Status.Success, "Each click runs in the browser. Nothing goes to the server."),
        (_, _, true) => ("Auto: on the server for now", Status.Info, "Runs on the server until the WebAssembly runtime arrives, then in your browser."),
        _ => ("C# runs on the server", Status.Info, "Each click calls the server over a live connection."),
    };

    private void IncrementCount()
    {
        currentCount++;
    }
}
@*#else *@
@page "/counter"

<PageTitle>Counter</PageTitle>

@* Where the C# runs is the point of the page, so it's the badge beside the title. The demo is in a
   card, apart from the page's text; the line beside the button says what a click just did. *@
<Container Size="ContainerSize.Md" Align="ContainerAlign.Start" Gutters="false">
    <Column Gap="new() { Base = 6, Md = 8 }">
        <PageHeader Title="Counter" Description="Click the button and watch where the C# runs.">
            <PageHeaderActions>
                <Badge Status="@Mode.Status" Pill Dot>@Mode.Text</Badge>
            </PageHeaderActions>
        </PageHeader>
        <Card>
            <CardBody Gap="5">
                <Box Width="Length.Full" MaxWidth="Length.Rem(24)">
                    <LinearGauge Label="Count" Value="CurrentCount" Max="ScaleMax" Step="ScaleMax / 5" ValueFormat="0" />
                </Box>
                <LiveRegion Text="@($"Count: {CurrentCount}")" />
                <Row Gap="4" Wrap Align="Align.Center">
                    <Button Href="@($"counter?count={CurrentCount + 1}")" StartIcon="Lucide.Plus">Click me</Button>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Mode.Note</TextBlock>
                </Row>
            </CardBody>
        </Card>
    </Column>
</Container>

@code {
    // The count lives in the address, so it works with no circuit and with JavaScript off.
    [SupplyParameterFromQuery(Name = "count")]
    private int CurrentCount { get; set; }

    // The scale grows by tens as the count passes them: 0 to 10, then 0 to 20, and so on.
    private int ScaleMax => (CurrentCount / 10 + 1) * 10;

    private static (string Text, Status Status, string Note) Mode =>
        ("Static: each click is a request", Status.Neutral, "Each click loads the page again with the new count in the address.");
}
@*#endif *@
