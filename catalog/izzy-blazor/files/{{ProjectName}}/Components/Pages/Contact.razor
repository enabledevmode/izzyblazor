@page "/contact"
@using System.ComponentModel.DataAnnotations
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Contact</PageTitle>

<Stack Gap="6" MaxWidth="Length.Rem(64)">
    <Stack Gap="2" MaxWidth="Length.Rem(40)">
        <Heading Level="1">Contact</Heading>
@*#if (InteractiveAtRoot) *@
        <TextBlock Color="Color.Muted">This form checks each field as you type, since every page here is interactive. The same form also posts and validates on a static page, with no circuit.</TextBlock>
@*#elif (UseServer) *@
        <TextBlock Color="Color.Muted">This form posts and validates on the server, with no circuit. Add @@rendermode InteractiveServer under @@page and it also checks each field as you type.</TextBlock>
@*#else *@
        <TextBlock Color="Color.Muted">This form posts and validates on the server, with no circuit.</TextBlock>
@*#endif *@
    </Stack>

    <Grid Columns="new() { Base = 1, Lg = 3 }" Gap="8" Align="Align.Start">
        <Form Model="Model" FormName="contact" OnValidSubmit="Send" ColSpan="new() { Lg = 2 }">
            <FormErrors />
            <Grid Columns="new() { Base = 1, Sm = 2 }" Gap="4">
                <TextField @bind-Value="Model!.Name" AutoComplete="name" />
                <TextField @bind-Value="Model!.Email" AutoComplete="email" />
                <TextField @bind-Value="Model!.Company" AutoComplete="organization" />
                <TextField @bind-Value="Model!.Phone" AutoComplete="tel" Type="TextFieldType.Tel" />
            </Grid>
            <Select @bind-Value="Model!.Topic" Placeholder="Choose a topic" />
            <RadioGroup @bind-Value="Model!.Reach" Orientation="Orientation.Horizontal" />
            <DateField @bind-Value="Model!.CallOn" Min="@Tomorrow" DateDisabled="IsWeekend" Clearable Hint="We call on weekdays." />
            <TextArea @bind-Value="Model!.Message" Rows="5" ShowCount />
            <Switch @bind-Value="Model!.News" />
            <FormActions Justify="Justify.Start">
                <Button Submit StartIcon="Lucide.Send">Send</Button>
            </FormActions>
        </Form>

        <Card TitleLevel="2" Title="Other ways to reach us">
            <DescriptionList>
                <DescriptionItem Term="Email"><Anchor Href="mailto:hello@example.com">hello@example.com</Anchor></DescriptionItem>
                <DescriptionItem Term="Replies">Within one working day</DescriptionItem>
                <DescriptionItem Term="Hours">Monday to Friday, 9:00 to 17:00</DescriptionItem>
            </DescriptionList>
        </Card>
    </Grid>
</Stack>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactMessage? Model { get; set; }

    private static DateOnly Tomorrow => DateOnly.FromDateTime(DateTime.Today.AddDays(1));

    private static bool IsWeekend(DateOnly day) => day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    protected override void OnInitialized() => Model ??= new();

    private void Send()
    {
        // Send or store the message here, then redirect: the toast follows the redirect, and reloading
        // the page doesn't post it again.
        var how = Model!.Reach == ContactMethod.Phone && Model.Phone is { Length: > 0 } phone ? $"call you on {phone}" : $"reply to {Model.Email}";
        Toasts.Success($"Thanks, {Model.Name}. We'll {how}.", "Message sent");
        Navigation.NavigateTo("contact");
    }

    public sealed class ContactMessage
    {
        [Required(ErrorMessage = "Enter your name"), StringLength(80)]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter your email"), EmailAddress(ErrorMessage = "Enter an email like name@example.com")]
        public string? Email { get; set; }

        [StringLength(80)]
        public string? Company { get; set; }

        [StringLength(30)]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "Choose a topic")]
        public Topic? Topic { get; set; }

        [Display(Name = "How should we reach you?")]
        public ContactMethod Reach { get; set; } = ContactMethod.Email;

        [Display(Name = "Best day to call")]
        public DateOnly? CallOn { get; set; }

        [Required(ErrorMessage = "Write your message"), StringLength(1000)]
        public string? Message { get; set; }

        [Display(Name = "Send me product news now and then")]
        public bool News { get; set; }
    }

    public enum Topic
    {
        [Display(Name = "A question")] Question,
        Sales,
        Support,
    }

    public enum ContactMethod
    {
        Email,
        Phone,
    }
}
