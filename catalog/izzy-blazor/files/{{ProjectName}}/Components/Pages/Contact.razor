@page "/contact"
@using System.ComponentModel.DataAnnotations
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>Contact us</PageTitle>

@* A real form posting and validating, with the other ways to reach the business beside it as a
   quiet aside (above the form on phones). Two columns pair the short fields, so nine fit in about
   two-thirds the height. *@
<Container Size="ContainerSize.Lg" Align="ContainerAlign.Start" Gutters="false">
    <Column Gap="new() { Base = 6, Md = 8 }">
@*#if (InteractiveAtRoot) *@
        <PageHeader Title="Contact us" Description="Fields are checked as you type, and again when you send." />
@*#else *@
        <PageHeader Title="Contact us" Description="Send us a message. We check it on the server when you send it." />
@*#endif *@
        <Grid Template="@(new Responsive<string> { Base = "1fr", Md = "1fr 2fr" })" Gap="new() { Base = 8, Md = 12 }" Align="Align.Start">
            <Column Gap="4">
                <Heading Level="2" Size="TextSize.Md">Other ways to reach us</Heading>
                <DescriptionList Orientation="Orientation.Vertical">
                    <DescriptionItem Term="Email"><Anchor Href="mailto:hello@example.com">hello@example.com</Anchor></DescriptionItem>
                    <DescriptionItem Term="Replies">Within one working day</DescriptionItem>
                    <DescriptionItem Term="Hours">Monday to Friday, 9:00–17:00</DescriptionItem>
                </DescriptionList>
            </Column>
            <Form Model="Model" FormName="contact" RequiredMark="RequiredMark.Optional" OnValidSubmit="Send" Columns="2">
                <FormErrors />
                <TextField @bind-Value="Model!.Name" AutoComplete="name" />
                <TextField @bind-Value="Model!.Email" AutoComplete="email" />
                <TextField @bind-Value="Model!.Company" AutoComplete="organization" />
                <TextField @bind-Value="Model!.Phone" AutoComplete="tel" Type="TextFieldType.Tel" />
                <Select @bind-Value="Model!.Topic" Placeholder="Choose a topic" />
                <RadioGroup @bind-Value="Model!.Reach" Orientation="Orientation.Horizontal" />
                <DateField @bind-Value="Model!.CallOn" Min="@Tomorrow" DateDisabled="IsWeekend" Clearable Hint="We call on weekdays." />
                <TextArea @bind-Value="Model!.Message" Rows="5" ShowCount ColSpan="GridSpan.Full" />
                <Checkbox @bind-Value="Model!.News" ColSpan="GridSpan.Full" />
                <FormActions Justify="Justify.Start">
                    <Button Submit StartIcon="Lucide.Send">Send message</Button>
                </FormActions>
            </Form>
        </Grid>
    </Column>
</Container>

@code {
    [SupplyParameterFromForm(FormName = "contact")]
    private ContactMessage? Model { get; set; }

    private static DateOnly Tomorrow => DateOnly.FromDateTime(DateTime.Today.AddDays(1));

    private static bool IsWeekend(DateOnly day) => day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    protected override void OnInitialized() => Model ??= new();

    private void Send()
    {
        // Send or store the message here, then redirect: the toast follows the redirect, and reloading
        // the page doesn't post it again.
        Toasts.Success("We'll reply within one working day.", "Message sent");
        Navigation.NavigateTo("contact");
    }

    public sealed class ContactMessage
    {
        [Required(ErrorMessage = "Enter your name."), StringLength(80)]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter your email."), EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }

        [StringLength(80)]
        public string? Company { get; set; }

        [StringLength(30)]
        public string? Phone { get; set; }

        [Required(ErrorMessage = "Choose a topic.")]
        public Topic? Topic { get; set; }

        [Required, Display(Name = "How should we reach you?")]
        public ContactMethod Reach { get; set; } = ContactMethod.Email;

        [Display(Name = "Best day to call")]
        public DateOnly? CallOn { get; set; }

        [Required(ErrorMessage = "Write a message."), StringLength(1000)]
        public string? Message { get; set; }

        [Display(Name = "Send me product news")]
        public bool News { get; set; }
    }

    public enum Topic
    {
        [Display(Name = "A question")] Question,
        Sales,
        Support,
    }

    public enum ContactMethod
    {
        Email,
        Phone,
    }
}
