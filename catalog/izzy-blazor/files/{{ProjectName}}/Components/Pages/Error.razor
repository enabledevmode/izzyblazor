@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

@* A page that's only a message, in the same column as Not found: what happened, the request ID
   to look the error up by, then the way on. *@
<Container Size="ContainerSize.Xs" Gutters="false" MarginTop="new() { Base = 8, Md = 16 }">
    <Column Gap="8">
        <PageHeader Title="Something went wrong" Description="The error has been logged with its request ID." Size="ControlSize.Lg" />
        <Alert Status="Status.Danger">
            An error occurred while processing your request.
            @if (ShowRequestId)
            {
                <br />
                <text>Request ID: </text><Code>@RequestId</Code>
            }
        </Alert>
        <Button Href="" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" FullWidth>Go to the home page</Button>
        <Column Gap="1">
            <Heading Level="2" Size="TextSize.Sm">Development mode</Heading>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                To see details of the error, set the <Code>ASPNETCORE_ENVIRONMENT</Code> environment variable to
                <Code>Development</Code> and restart the app. Don't do this in production: it shows sensitive
                information to users.
            </TextBlock>
        </Column>
    </Column>
</Container>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
