@page "/Error"

<PageTitle>Error</PageTitle>

@* A page that's only a message, as Not found: the visitor's part is centered and complete on its
   own; the developer's part is start-aligned under a line, folded away, since it's technical text. *@
<Container Size="ContainerSize.Xs" Align="ContainerAlign.Center" MaxWidth="Length.Rem(27.5)" Gutters="false" MarginTop="new() { Base = 0, Md = 12 }">
    <Column Gap="6">
        <EmptyState Size="ControlSize.Lg" Status="Status.Danger" Icon="Lucide.TriangleAlert" TitleLevel="1" Title="Something went wrong"
                    Description="We couldn't finish your request. Try again, or go back to the home page.">
            <EmptyStateActions>
                <Button Href="" Width="new() { Base = Length.Percent(100), Sm = Length.Auto }" MinWidth="Length.Rem(12.5)">Go to the home page</Button>
            </EmptyStateActions>
        </EmptyState>
        <Divider />
        <Collapsible Label="Details for developers">
            <Column Gap="3" PaddingTop="3">
                @if (ShowRequestId)
                {
                    <Row Gap="2" Align="Align.Center" Wrap>
                        <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Request ID</TextBlock>
                        <Code id="request-id">@RequestId</Code>
                        <CopyButton For="request-id" Label="Copy request ID" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" />
                    </Row>
                }
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                    To see the error's details, set <Code>ASPNETCORE_ENVIRONMENT</Code> to <Code>Development</Code> and
                    restart the app. Don't do this in production: it shows sensitive information to anyone who sees the page.
                </TextBlock>
            </Column>
        </Collapsible>
    </Column>
</Container>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = System.Diagnostics.Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
