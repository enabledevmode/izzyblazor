@page "/"

<PageTitle>Home</PageTitle>

<Stack Gap="6">
    <Stack Gap="2">
        <Heading Level="1">Hello, world!</Heading>
        <TextBlock Color="Color.Muted">Welcome to your new app, built with IzzyBlazor. Here's where to go next.</TextBlock>
    </Stack>
    <Grid Columns="new() { Base = 1, Md = 2 }" Gap="4" MaxWidth="Length.Rem(48)">
        <Card TitleLevel="2" Title="Browse the components" Description="Every component, with live examples, their code and what each does in each render mode." Href="https://izzyblazor.com/docs/components" />
        <Card TitleLevel="2" Title="Theme your app" Description="Pick a preset and a brand color on IzzyTheme in Components/App.razor." Href="https://izzyblazor.com/docs/theming" />
        @*#if (InteractiveAtRoot) *@
        <Card TitleLevel="2" Title="Choose a render mode" Description="Every page here is interactive. IzzyBlazor's components also work on static pages, which need no circuit or download." Href="https://izzyblazor.com/docs/common/render-modes" />
        @*#else *@
        <Card TitleLevel="2" Title="Choose a render mode" Description="Pages are static by default. Add @@rendermode to the ones that need C# running in the browser or over a circuit." Href="https://izzyblazor.com/docs/common/render-modes" />
        @*#endif *@
        <Card TitleLevel="2" Title="Use an AI assistant" Description="Connect your assistant to IzzyBlazor's docs, so it writes code that fits each render mode." Href="https://izzyblazor.com/docs/get-started/ai-assistants" />
    </Grid>
</Stack>
