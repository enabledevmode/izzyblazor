@page "/not-found"
@layout MainLayout

<PageTitle>Not found</PageTitle>

@* A page that's only a message: the narrow column (24rem), centered at a fixed distance from the
   top, the title, then the one way on. *@
<Container Size="ContainerSize.Xs" Gutters="false" MarginTop="new() { Base = 8, Md = 16 }">
    <Column Gap="8">
        <PageHeader Title="Not found" Description="There's nothing at this address." Size="ControlSize.Lg" />
        <Button Href="" FullWidth>Go to the home page</Button>
    </Column>
</Container>
