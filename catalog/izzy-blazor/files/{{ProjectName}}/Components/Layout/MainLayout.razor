@inherits LayoutComponentBase
@inject IConfiguration Configuration

@*#if (WidthOnShell && AutoWidth && PlainShell) *@
<AppShell ContentWidth="Length.Rem(72)">
@*#elif (WidthOnShell && AutoWidth) *@
<AppShell Variant="ShellVariant.{{Shell}}" ContentWidth="Length.Rem(72)">
@*#elif (WidthOnShell && PlainShell) *@
<AppShell ContentWidth="Length.Rem({{ContentWidth}})">
@*#elif (WidthOnShell) *@
<AppShell Variant="ShellVariant.{{Shell}}" ContentWidth="Length.Rem({{ContentWidth}})">
@*#elif (PlainShell) *@
<AppShell>
@*#else *@
<AppShell Variant="ShellVariant.{{Shell}}">
@*#endif *@
    @* One header for both nav layouts: the menu button (phones), the brand, the links (top bar),
       the color scheme and, at the end, the account control. On phones both layouts open a panel
       under the header, with Log in and Register at its foot. *@
    <AppHeader>
        @*#if (SidebarNav && SampleContent) *@
        <SidebarToggle />
        @*#endif *@
        <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
        @*#if (!SidebarNav && SampleContent) *@
        <SiteNav MenuButtonPosition="MenuButtonPosition.Start">
            <NavItem Href="" Match="NavLinkMatch.All">Home</NavItem>
            <NavItem Href="counter">Counter</NavItem>
            <NavItem Href="weather">Weather</NavItem>
            <NavItem Href="contact">Contact</NavItem>
            @*#if (IndividualLocalAuth) *@
            <NavItem Href="auth">Auth required</NavItem>
            <SiteNavFooter>
                <AuthorizeView>
                    <NotAuthorized>
                        <Row Gap="2" Grow>
                            <Button Href="Account/Login" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Lg" Grow>Log in</Button>
                            <Button Href="Account/Register" Size="ControlSize.Lg" Grow>Register</Button>
                        </Row>
                    </NotAuthorized>
                </AuthorizeView>
            </SiteNavFooter>
            @*#endif *@
        </SiteNav>
        @*#endif *@
        <Spacer />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Menu" />
        @*#if (IndividualLocalAuth) *@
        <AccountMenu />
        @*#endif *@
    </AppHeader>
    @*#if (SidebarNav && SampleContent) *@

    <AppSidebar SmallScreen="SidebarSmallScreen.Panel">
        <NavMenu>
            <NavItem Href="" Match="NavLinkMatch.All" Icon="Lucide.House">Home</NavItem>
            <NavItem Href="counter" Icon="Lucide.CirclePlus">Counter</NavItem>
            <NavItem Href="weather" Icon="Lucide.CloudSun">Weather</NavItem>
            <NavItem Href="contact" Icon="Lucide.Mail">Contact</NavItem>
            @*#if (IndividualLocalAuth) *@
            <NavItem Href="auth" Icon="Lucide.Lock">Auth required</NavItem>
            @*#endif *@
        </NavMenu>
        @*#if (IndividualLocalAuth) *@
        <SidebarFooter>
            <AuthorizeView>
                <NotAuthorized>
                    <Row Gap="2" HiddenFrom="Breakpoint.Md">
                        <Button Href="Account/Login" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Lg" Grow>Log in</Button>
                        <Button Href="Account/Register" Size="ControlSize.Lg" Grow>Register</Button>
                    </Row>
                </NotAuthorized>
            </AuthorizeView>
        </SidebarFooter>
        @*#endif *@
    </AppSidebar>
    @*#endif *@

    @*#if (WidthOnMain) *@
    <AppMain ContentWidth="Length.Rem({{ContentWidth}})">
    @*#else *@
    <AppMain>
    @*#endif *@
        @* With a content width, the shell's column already has a gutter that lines the page up with
           the header, so the page adds space above and below only; otherwise it pads every side. *@
        @*#if (WidthOnShell || WidthOnMain) *@
        <Box PaddingY="new() { Base = 6, Md = 10 }">
        @*#else *@
        <Box PaddingX="new() { Base = 4, Md = 10 }" PaddingY="new() { Base = 6, Md = 10 }">
        @*#endif *@
            <ErrorGuard ShowDetails="DetailedErrors">
                @Body
            </ErrorGuard>
        </Box>
    </AppMain>
</AppShell>

<ToastRegion />
@*#if (UseServer || UseWebAssembly) *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@*#endif *@

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");
}
