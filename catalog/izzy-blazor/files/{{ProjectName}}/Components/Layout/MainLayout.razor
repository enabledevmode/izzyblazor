@inherits LayoutComponentBase
@inject IConfiguration Configuration
@*#if (SampleContent) *@

@*#if (WidthOnShell && AutoWidth && PlainShell) *@
<AppShell ContentWidth="Length.Rem(72)">
@*#elif (WidthOnShell && AutoWidth) *@
<AppShell Variant="ShellVariant.{{Shell}}" ContentWidth="Length.Rem(72)">
@*#elif (WidthOnShell && PlainShell) *@
<AppShell ContentWidth="Length.Rem({{ContentWidth}})">
@*#elif (WidthOnShell) *@
<AppShell Variant="ShellVariant.{{Shell}}" ContentWidth="Length.Rem({{ContentWidth}})">
@*#elif (PlainShell) *@
<AppShell>
@*#else *@
<AppShell Variant="ShellVariant.{{Shell}}">
@*#endif *@
    <AppHeader>
        @*#if (SidebarNav) *@
        <SidebarToggle />
        @*#endif *@
        <AppBrand Href="" Icon="Lucide.Blocks" Label="{{ProjectName}}" />
        <Box Grow />
        @*#if (!SidebarNav) *@
        <SiteNav>
            <NavItem Href="" Match="NavLinkMatch.All">Home</NavItem>
            <NavItem Href="counter">Counter</NavItem>
            <NavItem Href="weather">Weather</NavItem>
            <NavItem Href="contact">Contact</NavItem>
            @*#if (IndividualLocalAuth) *@
            <NavItem Href="auth">Auth required</NavItem>
            @*#endif *@
        </SiteNav>
        @*#endif *@
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Toggle" />
        @*#if (IndividualLocalAuth) *@
        <AccountMenu />
        @*#endif *@
    </AppHeader>
    @*#if (SidebarNav) *@

    <AppSidebar>
        <NavMenu>
            <NavItem Href="" Match="NavLinkMatch.All" Icon="Lucide.House">Home</NavItem>
            <NavItem Href="counter" Icon="Lucide.SquarePlus">Counter</NavItem>
            <NavItem Href="weather" Icon="Lucide.CloudSun">Weather</NavItem>
            <NavItem Href="contact" Icon="Lucide.Mail">Contact</NavItem>
            @*#if (IndividualLocalAuth) *@
            <NavItem Href="auth" Icon="Lucide.Lock">Auth required</NavItem>
            @*#endif *@
        </NavMenu>
    </AppSidebar>
    @*#endif *@

    @*#if (WidthOnMain) *@
    <AppMain ContentWidth="Length.Rem({{ContentWidth}})">
    @*#else *@
    <AppMain>
    @*#endif *@
        <Box Padding="new() { Base = 4, Md = 8 }">
            <ErrorGuard ShowDetails="DetailedErrors">
                @Body
            </ErrorGuard>
        </Box>
    </AppMain>
</AppShell>
@*#else *@

<ErrorGuard ShowDetails="DetailedErrors">
    @Body
</ErrorGuard>
@*#endif *@

<ToastRegion />
@*#if (UseServer || UseWebAssembly) *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@*#endif *@

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");
}
