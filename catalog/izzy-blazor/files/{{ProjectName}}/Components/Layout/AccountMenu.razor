@implements IDisposable
@inject NavigationManager NavigationManager

@* At the end of the header, in both nav layouts. Signed out: Log in and Register (on phones they're
   at the foot of the menu panel instead). Signed in: your avatar, opening a menu headed by your
   email, to manage your account or log out. Signing in swaps one for the other in the same place. *@
<AuthorizeView>
    <Authorized>
        <Menu Placement="Placement.BottomEnd">
            <Trigger Context="trigger">
                <Button Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" aria-label="Account" @attributes="trigger">
                    <Avatar Name="@context.User.Identity?.Name" Size="AvatarSize.Sm" Decorative />
                </Button>
            </Trigger>
            <ChildContent>
                <MenuGroup Label="@(context.User.Identity?.Name ?? "Account")">
                    <MenuItem Href="Account/Manage" Icon="Lucide.User">Manage account</MenuItem>
                </MenuGroup>
                <MenuDivider />
                <MenuItem Submit Form="logout-form" Icon="Lucide.LogOut">Log out</MenuItem>
            </ChildContent>
        </Menu>
        <form id="logout-form" action="Account/Logout" method="post" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </form>
    </Authorized>
    <NotAuthorized>
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" VisibleFrom="Breakpoint.Md">Log in</Button>
        <Button Href="Account/Register" Size="ControlSize.Sm" VisibleFrom="Breakpoint.Md">Register</Button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
