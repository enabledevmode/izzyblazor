@implements IDisposable
@inject NavigationManager NavigationManager

@*#if (SidebarNav) *@
@* In the sidebar's footer, as shadcn's dashboards and AppSidebar's docs place the account. Signed in:
   your avatar and email, and a menu to manage your account or log out. Signed out, Log in and Register
   are in the header (MainLayout); on phones, where the header has room only for Log in, Register is
   here at the foot of the drawer. *@
<AuthorizeView>
    <Authorized>
        <Row Gap="2" Align="Align.Center">
            <Avatar Name="@context.User.Identity?.Name" Size="AvatarSize.Sm" Decorative />
            <TextBlock Size="TextSize.Sm" Truncate Grow>@context.User.Identity?.Name</TextBlock>
            <Menu Placement="Placement.TopEnd">
                <Trigger Context="trigger">
                    <IconButton Icon="Lucide.EllipsisVertical" Label="Account" Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger" />
                </Trigger>
                <ChildContent>
                    <MenuItem Href="Account/Manage" Icon="Lucide.UserCog">Manage account</MenuItem>
                    <MenuItem Submit Form="logout-form" Icon="Lucide.LogOut">Log out</MenuItem>
                </ChildContent>
            </Menu>
        </Row>
        <form id="logout-form" action="Account/Logout" method="post" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </form>
    </Authorized>
    <NotAuthorized>
        <Button Href="Account/Register" FullWidth HiddenFrom="Breakpoint.Md">Register</Button>
    </NotAuthorized>
</AuthorizeView>
@*#else *@
@* In the header. Signed in: an account button whose menu names you and lets you manage your account
   or log out (GitHub's pattern, so a long email never crowds the header). Signed out: Log in, and
   Register from Md up; below that, Register is in the SiteNav's panel (MainLayout). *@
<AuthorizeView>
    <Authorized>
        <Menu Placement="Placement.BottomEnd">
            <Trigger Context="trigger">
                <IconButton Icon="Lucide.CircleUser" Label="Account" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger" />
            </Trigger>
            <ChildContent>
                <MenuGroup Label="@(context.User.Identity?.Name ?? "Account")">
                    <MenuItem Href="Account/Manage" Icon="Lucide.UserCog">Manage account</MenuItem>
                    <MenuItem Submit Form="logout-form" Icon="Lucide.LogOut">Log out</MenuItem>
                </MenuGroup>
            </ChildContent>
        </Menu>
        <form id="logout-form" action="Account/Logout" method="post" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </form>
    </Authorized>
    <NotAuthorized>
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral">Log in</Button>
        <Button Href="Account/Register" VisibleFrom="Breakpoint.Md">Register</Button>
    </NotAuthorized>
</AuthorizeView>
@*#endif *@

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
