@implements IDisposable
@inject NavigationManager NavigationManager

@*#if (ShellStarter) *@
@* At the end of the header. Signed out: Log in, at every width, and Register where people can make
   accounts (on phones Register is at the foot of the menu instead). Signed in: your avatar, opening a
   menu headed by your email, to manage your account or log out. *@
@*#else *@
@* At the end of the header, in both nav layouts. Signed out: Sign in and Register (Register only when people can make accounts; on phones they're
   at the foot of the menu panel instead; an --empty app has no panel, so they stay here). Signed
   in: your avatar, opening a menu headed by your email, to manage your account or log out. Signing
   in swaps one for the other in the same place. *@
@*#endif *@
<AuthorizeView>
    <Authorized>
        <Menu Placement="Placement.BottomEnd">
            <Trigger Context="trigger">
                <IconButton Label="Account" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger">
                    <Avatar Name="@context.User.Identity?.Name" Size="AvatarSize.Sm" Decorative />
                </IconButton>
            </Trigger>
            <ChildContent>
                <MenuGroup Label="@(context.User.Identity?.Name ?? "Account")">
                    <MenuItem Href="Account/Manage" Icon="Lucide.User">Manage account</MenuItem>
                </MenuGroup>
                <MenuDivider />
                <MenuItem Submit Form="logout-form" Icon="Lucide.LogOut">Log out</MenuItem>
            </ChildContent>
        </Menu>
        <form id="logout-form" action="Account/Logout" method="post" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </form>
    </Authorized>
    <NotAuthorized>
        @*#if (ShellStarter) *@
        @* Log in stays at every width; on phones Register is at the foot of the menu. *@
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm">Log in</Button>
        @*#if (HeaderRegister) *@
        <Button Href="Account/Register" Size="ControlSize.Sm" VisibleFrom="Breakpoint.Md">Register</Button>
        @*#endif *@
        @*#elif (SampleContent) *@
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" VisibleFrom="Breakpoint.Md">Sign in</Button>
        @*#if (Registration) *@
        <Button Href="Account/Register" Size="ControlSize.Sm" VisibleFrom="Breakpoint.Md">Register</Button>
        @*#endif *@
        @*#else *@
        @* No menu panel in an --empty app, so they stay here at every width. *@
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm">Sign in</Button>
        @*#if (Registration) *@
        <Button Href="Account/Register" Size="ControlSize.Sm">Register</Button>
        @*#endif *@
        @*#endif *@
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
