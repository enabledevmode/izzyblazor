{
  //#if (IndividualLocalAuth)
  "ConnectionStrings": {
    //#if (UseLocalDB)
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=aspnet-{{RootNamespace}}-{{UserSecretsGuid}};Trusted_Connection=True;MultipleActiveResultSets=true"
    //#else
    "DefaultConnection": "DataSource=Data/app.db;Cache=Shared"
    //#endif
  },
  //#endif
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
