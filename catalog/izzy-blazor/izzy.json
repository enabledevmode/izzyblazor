// Microsoft's Blazor Web App (dotnet new blazor, .NET 10) rebuilt with IzzyBlazor: the same options, names and
// defaults, its pages drawn with IzzyBlazor's components and theme instead of Bootstrap. Its files are ported
// from Microsoft's template (MIT, dotnet/aspnetcore). With WebAssembly or Auto it's a solution with a .Client
// project; with every page interactive in the browser, the layout and pages move to the .Client project.
// With --auth Individual, Microsoft's Identity pages (Components/Account) keep their C# and are drawn with
// IzzyBlazor's components: Microsoft's code-behind is unchanged, so its fixes port by diff.
{
  "id": "izzy-blazor",
  "name": "IzzyBlazor Blazor Web App",
  "kind": "starter",
  "category": "Starters",
  "summary": "Microsoft's Blazor Web App with IzzyBlazor's components and theme, in every render mode, with the same options.",
  "components": ["AppShell", "AppHeader", "AppBrand", "AppSidebar", "SidebarToggle", "NavMenu", "NavItem", "AppMain", "SiteNav", "ColorSchemeSwitch", "Table", "Form", "TextField", "Select", "TextArea", "FormErrors", "Button", "Spinner", "EmptyState", "Prose", "Alert", "ReconnectDialog", "ToastRegion", "IzzyTheme", "Card", "Checkbox", "PasswordField", "PinField", "Divider", "Menu", "MenuItem", "QrCode", "CopyButton", "Code", "FormActions"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "full", "Auto": "full" },
  "parameters": {
    "type": "object",
    "properties": {
      "Interactivity": {
        "type": "string", "enum": ["None", "Server", "WebAssembly", "Auto"], "default": "Server",
        "description": "Which interactive render mode interactive components use. None makes every page static.",
        "x-priority": "important"
      },
      "AllInteractive": {
        "type": "boolean", "default": false,
        "description": "Makes every page interactive. Otherwise pages are static by default, and you mark the ones that need it."
      },
      "Auth": {
        "type": "string", "enum": ["None", "Individual"], "default": "None",
        "description": "The authentication: None, or Individual (accounts stored in the app's database, with ASP.NET Core Identity's pages drawn in IzzyBlazor).",
        "x-priority": "important"
      },
      "UseLocalDB": {
        "type": "boolean", "default": false,
        "description": "With Individual authentication, stores accounts in SQL Server LocalDB instead of SQLite."
      },
      "Empty": {
        "type": "boolean", "default": false,
        "description": "Leaves out the sample pages (Counter, Weather and Contact) and the sidebar."
      },
      "Preset": {
        "type": "string", "enum": ["Standard", "Compact", "Soft", "Editorial"], "default": "Standard",
        "description": "The theme preset: Standard (36px controls, Blue on Neutral), Compact (dense, for data and admin), Soft (roomy, for consumer apps) or Editorial (for reading and docs)."
      },
      "Brand": {
        "type": "string", "default": "",
        "pattern": "^$|^(blue|ink|indigo|violet|teal|green|rose)$|^#([0-9a-f]{3}|[0-9a-f]{6})$",
        "description": "The brand color: blue, ink, indigo, violet, teal, green or rose, or a hex color such as #0a7d5a. Empty keeps the preset's."
      },
      "Nav": {
        "type": "string", "enum": ["Sidebar", "Top"], "default": "Sidebar",
        "description": "Where the navigation goes: a sidebar, or links across the top bar that fold into a menu on phones."
      },
      "ContentWidth": {
        "type": "string", "enum": ["Auto", "Full", "64", "72", "80"], "default": "Auto",
        "description": "How wide pages get, in rem: Full fills the screen; 64, 72 or 80 center a column. Auto is full beside a sidebar and 72 under a top bar."
      },
      "Shell": {
        "type": "string", "enum": ["Tinted", "Inset", "Flat", "Canvas"], "default": "Tinted",
        "description": "How the app shell looks: Tinted (the sidebar takes the page tint), Inset (the main area a raised panel in a tinted frame), Flat (lines alone separate the parts) or Canvas (the main area tinted, for content in cards)."
      },
      "Framework": {
        "type": "string", "enum": ["net10.0"], "default": "net10.0",
        "description": "The target framework."
      },
      "ExcludeLaunchSettings": { "type": "boolean", "default": false, "description": "Leaves out launchSettings.json." },
      "NoHttps": { "type": "boolean", "default": false, "description": "Turns off HTTPS." },
      "UseProgramMain": {
        "type": "boolean", "default": false,
        "description": "Writes a Program class with a Main method instead of top-level statements."
      },
      "LocalhostTld": {
        "type": "boolean", "default": false,
        "description": "Puts the project name in a .dev.localhost address, such as https://myapp.dev.localhost:7000."
      },
      "NoRestore": { "type": "boolean", "default": false, "description": "Doesn't restore packages after creating the project." },
      "UserSecretsGuid": {
        "type": "string", "x-guid": true, "x-hidden": true,
        "description": "The GUID in the user secrets id and the LocalDB database name, with Individual authentication."
      },
      "KestrelHttpPort": {
        "type": "integer", "x-port": [5000, 5300], "x-option": "kestrelHttpPort", "x-hidden": true,
        "description": "The HTTP port in launchSettings.json."
      },
      "KestrelHttpsPort": {
        "type": "integer", "x-port": [7000, 7300], "x-option": "kestrelHttpsPort", "x-hidden": true,
        "description": "The HTTPS port in launchSettings.json."
      }
    }
  },
  "computed": {
    "UseServer": "Interactivity == \"Server\" || Interactivity == \"Auto\"",
    "UseWebAssembly": "Interactivity == \"WebAssembly\" || Interactivity == \"Auto\"",
    "InteractiveAtRoot": "AllInteractive && Interactivity != \"None\"",
    "SampleContent": "!Empty",
    "IndividualLocalAuth": "Auth == \"Individual\"",
    "RequiresHttps": "IndividualLocalAuth",
    "HasHttpsProfile": "RequiresHttps || !NoHttps",
    "SidebarNav": "Nav == \"Sidebar\"",
    "PlainShell": "Shell == \"Tinted\"",
    "AutoWidth": "ContentWidth == \"Auto\"",
    "WidthOnShell": "Nav == \"Top\" && ContentWidth != \"Full\"",
    "WidthOnMain": "Nav == \"Sidebar\" && ContentWidth != \"Full\" && ContentWidth != \"Auto\""
  },
  "exclude": [
    { "if": "!UseWebAssembly", "paths": ["{{ProjectName}}.Client/**", "*.slnx"] },
    { "if": "UseWebAssembly", "paths": ["{{ProjectName}}/Components/Pages/Counter.razor"] },
    {
      "if": "!IndividualLocalAuth",
      "paths": [
        "{{ProjectName}}/Components/Account/**",
        "{{ProjectName}}/Components/Layout/AccountMenu.razor",
        "{{ProjectName}}/Data/**",
        "{{ProjectName}}/Components/Pages/Auth.razor",
        "{{ProjectName}}.Client/Pages/Auth.razor"
      ]
    },
    { "if": "!(IndividualLocalAuth && !UseLocalDB)", "paths": ["{{ProjectName}}/Data/app.db"] },
    { "if": "UseWebAssembly", "paths": ["{{ProjectName}}/Components/Pages/Auth.razor"] },
    { "if": "!UseServer", "paths": ["{{ProjectName}}/Components/Account/IdentityRevalidatingAuthenticationStateProvider.cs"] },
    { "if": "UseLocalDB", "paths": ["{{ProjectName}}/Data/SqlLite/**"] },
    { "if": "!UseLocalDB", "paths": ["{{ProjectName}}/Data/SqlServer/**"] },
    { "if": "ExcludeLaunchSettings", "paths": ["{{ProjectName}}/Properties/launchSettings.json"] },
    {
      "if": "!SampleContent",
      "paths": [
        "{{ProjectName}}/Components/Pages/Counter.*",
        "{{ProjectName}}/Components/Pages/Weather.*",
        "{{ProjectName}}/Components/Pages/Contact.*",
        "{{ProjectName}}/Components/Pages/Auth.*",
        "{{ProjectName}}/wwwroot/favicon.*",
        "{{ProjectName}}.Client/Pages/**",
        "{{ProjectName}}.Client/wwwroot/**"
      ]
    }
  ],
  "rename": [
    { "if": "UseWebAssembly", "paths": { "{{ProjectName}}/Data/SqlServer/": "{{ProjectName}}/Data/Migrations/", "{{ProjectName}}/Data/SqlLite/": "{{ProjectName}}/Data/Migrations/", "{{ProjectName}}/Components/Account/Shared/RedirectToLogin.razor": "./{{ProjectName}}.Client/RedirectToLogin.razor" } },
    { "if": "!UseWebAssembly", "paths": { "{{ProjectName}}/Data/SqlServer/": "Data/Migrations/", "{{ProjectName}}/Data/SqlLite/": "Data/Migrations/" } },
    { "if": "!UseWebAssembly", "paths": { "{{ProjectName}}/": "./" } },
    {
      "if": "UseWebAssembly && InteractiveAtRoot",
      "paths": {
        "{{ProjectName}}/Components/Layout/": "./{{ProjectName}}.Client/Layout/",
        "{{ProjectName}}/Components/Pages/Home.razor": "./{{ProjectName}}.Client/Pages/Home.razor",
        "{{ProjectName}}/Components/Pages/NotFound.razor": "./{{ProjectName}}.Client/Pages/NotFound.razor",
        "{{ProjectName}}/Components/Pages/Weather.razor": "./{{ProjectName}}.Client/Pages/Weather.razor",
        "{{ProjectName}}/Components/Pages/Contact.razor": "./{{ProjectName}}.Client/Pages/Contact.razor",
        "{{ProjectName}}/Components/Routes.razor": "./{{ProjectName}}.Client/Routes.razor"
      }
    }
  ],
  "restore": "!NoRestore"
}
