// The free hero: the top of a landing page, written into the project as a component you own
// (Components/Blocks/Hero.razor) and placed on a page after its <PageTitle>.
{
  "id": "hero",
  "name": "Hero",
  "kind": "block",
  "category": "Heroes",
  "summary": "The top of a landing page: a headline, a sentence, two buttons and a screenshot or image.",
  "components": ["Section", "Container", "Grid", "Stack", "Box", "Tag", "Heading", "TextBlock", "Button", "BrowserFrame", "Image"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "full", "Auto": "full" },
  "parameters": {
    "type": "object",
    "properties": {
      "Layout": {
        "type": "string", "enum": ["Centered", "Split"], "default": "Centered", "x-priority": "important",
        "description": "Centered stacks everything in the middle; Split puts the image or screenshot beside the text."
      },
      "Eyebrow": { "type": "string", "default": "", "description": "A short pill above the headline, such as \"Now in public beta\". Empty leaves it out." },
      "EyebrowHref": { "type": "string", "default": "", "description": "Makes the eyebrow a link, such as to the announcement. Empty leaves it plain." },
      "Headline": { "type": "string", "default": "Ship your app with less code", "x-priority": "important", "description": "The headline: what you offer, in a few words." },
      "Subhead": { "type": "string", "default": "One place for your team to plan, track and ship work. Start free, with no card needed.", "description": "The sentence under the headline." },
      "PrimaryText": { "type": "string", "default": "Get started", "description": "The main button." },
      "PrimaryHref": { "type": "string", "default": "get-started", "description": "Where the main button goes." },
      "SecondaryText": { "type": "string", "default": "See how it works", "description": "The second button. Empty leaves it out." },
      "SecondaryHref": { "type": "string", "default": "about", "description": "Where the second button goes." },
      "Media": {
        "type": "string", "enum": ["Screenshot", "Image", "None"], "default": "Screenshot",
        "description": "Screenshot frames the image in a browser window; Image shows it as it is."
      },
      "Address": { "type": "string", "default": "myapp.com", "description": "The address in the screenshot's browser bar. Empty shows only the dots." },
      "ImageSrc": { "type": "string", "default": "images/hero-screenshot.svg", "description": "The image, from wwwroot. The default is a placeholder to replace." },
      "ImageAlt": { "type": "string", "default": "A screenshot of the app", "description": "What the image shows, for screen readers. Empty marks it decorative." },
      "HeadingLevel": { "type": "string", "enum": ["1", "2"], "default": "1", "description": "1 makes the headline the page's main heading; use 2 when the page has its own." },
      "Name": { "type": "string", "default": "Hero", "description": "The component's name." },
      "Into": { "type": "string", "default": "Components/Pages/Home.razor", "description": "The page it's placed on, after its <PageTitle>." }
    }
  },
  "computed": {
    "HasMedia": "Media != \"None\"",
    "Split": "Layout == \"Split\" && Media != \"None\"",
    "Centered": "Layout == \"Centered\"",
    "Screenshot": "Media == \"Screenshot\"",
    "HasAddress": "Address != \"\"",
    "EyebrowLink": "EyebrowHref != \"\"",
    "HasEyebrow": "Eyebrow != \"\"",
    "HasSecondary": "SecondaryText != \"\"",
    "Placeholder": "Media != \"None\" && ImageSrc == \"images/hero-screenshot.svg\""
  },
  "accessibility": [
    "The section is named by its headline, which is the page's h1 (HeadingLevel 1) or an h2 under the page's own heading (HeadingLevel 2).",
    "The buttons are links, the main one first in reading order. On phones they stack at full width.",
    "The screenshot's browser bar is hidden from screen readers, so they read only the image's alt text. Empty alt text marks the image decorative.",
    "A linked eyebrow is a plain link named by its text."
  ],
  "variations": [
    { "key": "layout", "label": "Layout", "setting": "Layout", "options": { "Split": "Split", "Centered": "Centered" } },
    { "key": "media", "label": "Media", "setting": "Media", "options": { "Screenshot": "Screenshot", "Image": "Image", "None": "None" } },
    { "key": "eyebrow", "label": "Eyebrow", "setting": "Eyebrow", "options": { "On": "Now in public beta", "Off": "" } },
    { "key": "second", "label": "Second button", "setting": "SecondaryText", "options": { "On": "See how it works", "Off": "" } }
  ],
  // Previews sit under the docs page's own h1, and their buttons stay on the docs page.
  "preview": { "HeadingLevel": "2", "PrimaryHref": "blocks/hero", "SecondaryHref": "blocks/hero" },
  "exclude": [ { "if": "!Placeholder", "paths": ["wwwroot/images/hero-screenshot.svg"] } ],
  "inserts": [
    { "file": "{{Into}}", "pattern": "<PageTitle>", "position": "after", "text": "\n<{{Name}} />\n" },
    { "file": "Components/_Imports.razor", "anchor": "@using {{RootNamespace}}.Components", "position": "after", "text": "@using {{RootNamespace}}.Components.Blocks\n" }
  ],
  "checks": [
    {
      "if": "HeadingLevel == \"1\"", "file": "{{Into}}", "pattern": "<h1[ >]|Level=\"1\"|<PageHeader(?![^>]*TitleLevel=\"[2-6]\")",
      "message": "{{Into}} already has a level-1 heading, and the hero's headline is one too. Remove one, or set HeadingLevel to 2."
    }
  ]
}
