// The free contact section: ways to reach you beside a form that posts with no circuit, written
// into the project as a component you own (Components/Blocks/ContactSection.razor) and added at
// the end of a page. The starter's own Contact page is separate.
{
  "id": "contact",
  "name": "Contact",
  "kind": "block",
  "category": "Contact",
  "summary": "Three ways to reach you beside a short form: checked on the server, answered with a toast, guarded by a honeypot.",
  "components": ["Section", "SectionHeader", "Container", "Grid", "Column", "Row", "Center", "Icon", "Heading", "TextBlock", "Anchor", "Box", "Form", "FormErrors", "TextField", "TextArea", "Button"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "full", "Auto": "full" },
  "parameters": {
    "type": "object",
    "properties": {
      "Title": { "type": "string", "default": "Talk to us", "x-priority": "important", "description": "The section's heading." },
      "Lead": { "type": "string", "default": "Questions about plans, a demo for your team, or help with your account. We answer within one working day.", "description": "The sentence under the heading: when they'll hear back." },
      "Privacy": { "type": "string", "default": "We'll only use your details to reply.", "description": "The line under the Send button." },
      "PrivacyHref": { "type": "string", "default": "privacy", "description": "Where \"Privacy policy\" after that line goes." },
      "LinkBase": { "type": "string", "default": "", "x-hidden": true, "description": "Put before each way's address; the docs previews use it to keep their links on the page." },
      "Name": { "type": "string", "default": "ContactSection", "description": "The component's name." },
      "Into": { "type": "string", "default": "Components/Pages/Home.razor", "description": "The page it's added to, at the end." }
    }
  },
  "accessibility": [
    "The section is named by its heading, an h2; each way to reach you is an h3 in a list.",
    "Every field has a visible label; required ones are announced as required, optional ones say so.",
    "After a post with errors, the summary at the top of the form takes focus and lists them; each field shows its own message too.",
    "The honeypot field is hidden from screen readers and skipped by the Tab key."
  ],
  "preview": { "LinkBase": "#", "PrivacyHref": "#" },
  "inserts": [
    { "file": "{{Into}}", "position": "end", "place": true, "text": "\n<{{Name}} />\n" },
    { "file": "Components/_Imports.razor", "anchor": "@using {{RootNamespace}}.Components", "position": "after", "text": "@using {{RootNamespace}}.Components.Blocks\n" }
  ]
}
