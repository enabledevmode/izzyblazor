@page "/{{Route}}"
@*#if (Authorize) *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@*#endif *@
@using {{RootNamespace}}.Data
@*#each (Alias in Aliases) *@
@using {{Alias.Name}} = {{Alias.Type}}
@*#endeach *@
@inject I{{Model}}Store Store

<PageTitle>{{Plural}}</PageTitle>

@* The {{PluralLower}}, from izzy add crud: search and filters in the address, the grid sorting and paging
   in the database, and a page for each {{SingularLower}}. It's yours: change the columns, the filters and
   the words here. *@
<Stack Gap="new() { Base = 6, Md = 8 }" PaddingBottom="new() { Base = _total > 0 ? 16 : 0, Sm = 0 }">
    <PageHeader Title="{{Plural}}">
        @if (_total > 0)
        {
            <PageHeaderActions>
                <Button Href="{{Route}}/new" StartIcon="Lucide.Plus" VisibleFrom="Breakpoint.Sm">New {{SingularLower}}</Button>
            </PageHeaderActions>
        }
    </PageHeader>

    @if (_total == 0)
    {
        <EmptyState Icon="Lucide.Inbox" Title="No {{PluralLower}} yet" Description="Add your first {{SingularLower}} to see them here." Bordered>
            <Button Href="{{Route}}/new" StartIcon="Lucide.Plus">New {{SingularLower}}</Button>
        </EmptyState>
    }
    else
    {
@*#if (HasSearch || HasStatus) *@
        <FilterForm Label="Filter {{PluralLower}}">
@*#if (HasSearch) *@
            <FilterSearch Name="q" Label="Search" Placeholder="{{SearchPlaceholder}}" />
@*#endif *@
@*#if (HasStatus) *@
            <FilterSelect Name="status" Label="{{StatusLabel}}" EnumType="typeof({{StatusType}})" AllText="All {{StatusPlural}}" />
@*#endif *@
            <TextBlock role="status" Color="Color.Muted">@_found @(_found == 1 ? "{{SingularLower}}" : "{{PluralLower}}")</TextBlock>
        </FilterForm>
@*#endif *@
        if (_found == 0)
        {
            <EmptyState Icon="Lucide.SearchX" Title="No {{PluralLower}} match" Description="{{NoMatchHint}}" Bordered>
                <Button Href="{{Route}}" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Clear filters</Button>
            </EmptyState>
        }
        else
        {
            <DataGrid TItem="{{ModelType}}" ItemsProvider="Find" ItemKey="x => x.{{Key}}.ToString()!" RowLabel="Name" Caption="{{Plural}}" PageSize="10"
                      InitialSort="{{InitialSort}}" SmallScreen="DataGridSmallScreen.HideColumns" Grow>
                <Columns>
@*#if (HasTitle) *@
                    <TemplateColumn Title="{{TitleLabel}}" SortBy="x => x.{{TitleSortField}}" SortKey="{{TitleSortKey}}" Sortable Priority="2">
                        <Anchor Href="@Url(context.{{Key}})" Weight="FontWeight.Medium">@Name(context)</Anchor>
@*#if (HasSubtitle) *@
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">@context.{{SubtitleField}}</TextBlock>
@*#endif *@
                    </TemplateColumn>
@*#else *@
                    <TemplateColumn Title="{{Singular}}" SortBy="x => x.{{Key}}" SortKey="{{TitleSortKey}}" Sortable Priority="2">
                        <Anchor Href="@Url(context.{{Key}})">@Name(context)</Anchor>
                    </TemplateColumn>
@*#endif *@
@*#each (Field in ListFields) *@
@*#if (Field.IsStatus) *@
                    <TemplateColumn Title="{{Field.Column}}" SortBy="x => x.{{Field.Name}}" SortKey="{{Field.Key}}" Sortable Priority="1"{{Field.WidthAttr}}>
                        <Badge Status="Tone(context.{{Field.Name}})" Dot>@Label(context.{{Field.Name}})</Badge>
                    </TemplateColumn>
@*#elif (Field.Kind == "Bool") *@
                    <TemplateColumn Title="{{Field.Column}}" SortBy="x => x.{{Field.Name}}" SortKey="{{Field.Key}}" Sortable{{Field.WidthAttr}}>@(context.{{Field.Name}} == true ? "Yes" : "No")</TemplateColumn>
@*#elif (Field.HasFormat) *@
                    <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}" Format="{{Field.Format}}"{{Field.WidthAttr}} Sortable />
@*#else *@
                    <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}"{{Field.WidthAttr}} Sortable />
@*#endif *@
@*#endeach *@
                    <ActionColumn Context="item" Overflow="RowActionOverflow.Always">
                        <RowAction Icon="Lucide.Eye" Label="View" Href="@Url(item.{{Key}})" />
                        <RowAction Icon="Lucide.Pencil" Label="Edit" Href="@Url(item.{{Key}}, "edit")" />
                    </ActionColumn>
                </Columns>
            </DataGrid>
        }
        @* On phones the button floats under the thumb, and the header's hides. *@
        <FloatingButton Icon="Lucide.Plus" Label="New {{SingularLower}}" Href="{{Route}}/new" HiddenFrom="Breakpoint.Sm" />
    }
</Stack>

@code {
@*#if (HasSearch) *@
    [SupplyParameterFromQuery(Name = "q")] private string? Search { get; set; }
@*#endif *@
@*#if (HasStatus) *@
    [SupplyParameterFromQuery(Name = "status")] private string? StatusText { get; set; }
@*#endif *@

    private int _total;
    private int _found;

@*#if (HasStatus) *@
    private {{StatusType}}? StatusFilter => Enum.TryParse<{{StatusType}}>(StatusText, ignoreCase: true, out var status) ? status : null;

@*#endif *@
    protected override async Task OnParametersSetAsync()
    {
        _total = await Store.CountAsync();
@*#if (HasSearch && HasStatus) *@
        _found = string.IsNullOrWhiteSpace(Search) && StatusFilter is null ? _total : await Store.CountAsync(Search, StatusFilter);
@*#elif (HasSearch) *@
        _found = string.IsNullOrWhiteSpace(Search) ? _total : await Store.CountAsync(Search);
@*#elif (HasStatus) *@
        _found = StatusFilter is null ? _total : await Store.CountAsync(null, StatusFilter);
@*#else *@
        _found = _total;
@*#endif *@
    }

@*#if (HasSearch && HasStatus) *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request, Search, StatusFilter);
@*#elif (HasSearch) *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request, Search);
@*#elif (HasStatus) *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request, null, StatusFilter);
@*#else *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request, null);
@*#endif *@

    // What the list calls a {{SingularLower}}.
    private static string Name({{ModelType}} x) => $"{{RowName}}";

    // A {{SingularLower}}'s address, its key escaped for a URL.
    private static string Url({{KeyType}} key, string? then = null) => $"{{Route}}/{{{UrlKey}}}{(then is null ? "" : "/" + then)}";
@*#if (HasStatus) *@

    // A badge's color for each {{StatusLabel}}: change them to what each means in your app.
    private static Status Tone({{StatusType}}? value) => value switch
    {
@*#each (Value in StatusValues) *@
        {{StatusType}}.{{Value.Name}} => IzzyBlazor.Status.{{Value.Tone}},
@*#endeach *@
        _ => IzzyBlazor.Status.Neutral,
    };

    private static string Label({{StatusType}}? value) => value switch
    {
@*#each (Value in StatusValues) *@
        {{StatusType}}.{{Value.Name}} => "{{Value.Label}}",
@*#endeach *@
        _ => value?.ToString() ?? "Not set",
    };
@*#endif *@
}
