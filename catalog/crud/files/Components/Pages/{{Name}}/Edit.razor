@page "/{{Route}}/new"
@page "/{{Route}}/{Id{{KeyConstraint}}}/edit"
@*#if (Authorize) *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@*#endif *@
@using Microsoft.AspNetCore.Components.Forms
@using {{RootNamespace}}.Data
@*#each (Alias in Aliases) *@
@using {{Alias.Name}} = {{Alias.Type}}
@*#endeach *@
@inject I{{Model}}Store Store
@inject ToastService Toasts
@inject NavigationManager Navigation

@* One form for a new {{SingularLower}} and for editing one, from izzy add crud. It posts with no circuit,
   is checked on the server against {{Model}}'s attributes, and lists what to fix at the top. *@
<PageTitle>@Title</PageTitle>

<Container Size="ContainerSize.Md" Align="ContainerAlign.Start" Gutters="false">
    <Stack Gap="new() { Base = 7, Md = 8 }">
        <Stack Gap="3">
            <Breadcrumb>
                <BreadcrumbItem Href="{{Route}}">{{Plural}}</BreadcrumbItem>
                <BreadcrumbItem>@(IsNew ? Title : "Edit")</BreadcrumbItem>
            </Breadcrumb>
            <PageHeader Title="@Title" />
        </Stack>

        @if (Model is not null)
        {
            <Form Model="Model" FormName="{{SingularLower}}" RequiredMark="RequiredMark.Optional" Columns="2" OnValidSubmit="SaveAsync">
                <FormErrors />
@*#if (KeyInput) *@
                @if (IsNew)
                {
@*#if (KeyIsText) *@
                    <TextField @bind-Value="Model.{{Key}}" Label="{{KeyLabel}}" Required />
@*#else *@
                    <NumberField @bind-Value="Model.{{Key}}" Label="{{KeyLabel}}" Required />
@*#endif *@
                }
                else
                {
                    <TextField Value="@KeyText" ValueExpression="() => KeyText" Label="{{KeyLabel}}" ReadOnly Hint="It's the {{SingularLower}}'s address, so it stays." />
                }
@*#endif *@
@*#each (Field in FormFields) *@
@*#if (Field.Kind == "Text") *@
                <TextField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "Email") *@
                <TextField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Type="TextFieldType.Email" AutoComplete="email"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "Phone") *@
                <TextField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Type="TextFieldType.Tel" AutoComplete="tel"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "Url") *@
                <TextField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Type="TextFieldType.Url"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "LongText") *@
                <TextArea @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Rows="4" ColSpan="2"{{Field.RequiredAttr}} />
@*#elif (Field.Numeric) *@
                <NumberField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}"{{Field.RequiredAttr}} />
@*#elif (Field.NullableBool) *@
                <Select @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Items="YesNo" ItemText="YesNoText" Placeholder="Not set" Clearable />
@*#elif (Field.Kind == "Bool") *@
                <Switch @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" ColSpan="2" />
@*#elif (Field.Kind == "Date") *@
                <DateField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "DateTime") *@
                <DateField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Type="DateFieldType.DateTime"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "Time") *@
                <TimeField @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}"{{Field.RequiredAttr}} />
@*#elif (Field.Radio) *@
                <RadioGroup @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Items="{{Field.EnumItems}}" ItemText="{{Field.Name}}Text" Orientation="Orientation.Horizontal" ColSpan="2"{{Field.RequiredAttr}} />
@*#elif (Field.Kind == "Enum") *@
                <Select @bind-Value="Model.{{Field.Name}}" Label="{{Field.Label}}" Items="{{Field.EnumItems}}" ItemText="{{Field.Name}}Text"{{Field.ClearableAttr}}{{Field.RequiredAttr}} />
@*#endif *@
@*#endeach *@
                <FormActions Justify="Justify.Start">
                    <Button Submit>@(IsNew ? "Create {{SingularLower}}" : "Save changes")</Button>
                    <Button Href="@Back" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Cancel</Button>
                </FormActions>
            </Form>
        }
    </Stack>
</Container>

@code {
    [Parameter] public {{KeyType}}? Id { get; set; }

    [SupplyParameterFromForm(FormName = "{{SingularLower}}")]
    private {{ModelType}}? Model { get; set; }

    private bool IsNew => Id is null;
    private string Title => IsNew ? "New {{SingularLower}}" : "Edit {{SingularLower}}";
    private string Back => IsNew ? "{{Route}}" : Url({{IdValue}});
    private string? KeyText => Id?.ToString();

    // The page's own errors (beside the model's attributes), cleared when the form is checked again.
    private ValidationMessageStore? _errors;

    protected override async Task OnInitializedAsync()
    {
        // A post brings the form's values; otherwise start empty, or from the {{SingularLower}} being edited.
        if (Model is not null) return;
        if (IsNew)
        {
            Model = new();
            return;
        }
        var saved = await Store.GetAsync({{IdValue}});
        if (saved is null)
        {
            Navigation.NotFound();
            return;
        }
        Model = new();
        Copy(saved, Model);
    }

    private async Task SaveAsync(EditContext form)
    {
        if (_errors is null)
        {
            _errors = new ValidationMessageStore(form);
            form.OnValidationRequested += (_, _) => _errors.Clear();
        }
        _errors.Clear();
@*#each (Field in FormFields) *@
@*#if (Field.CheckRequired) *@
        if (string.IsNullOrWhiteSpace(Model!.{{Field.Name}})) Error(form, nameof({{ModelType}}.{{Field.Name}}), "Enter {{Field.Article}} {{Field.LabelLower}}.");
@*#endif *@
@*#if (Field.Kind == "Url") *@
        // Only web addresses: a javascript: address shown as a link would run when it's clicked.
        if (!string.IsNullOrWhiteSpace(Model!.{{Field.Name}}) && !IsWebAddress(Model.{{Field.Name}}))
            Error(form, nameof({{ModelType}}.{{Field.Name}}), "Enter a web address that starts with https://.");
@*#endif *@
@*#endeach *@
@*#if (KeyInput) *@
@*#if (KeyIsText) *@
        if (IsNew) Model!.{{Key}} = Model.{{Key}}?.Trim() ?? "";
        if (IsNew && string.IsNullOrEmpty(Model!.{{Key}})) Error(form, nameof({{ModelType}}.{{Key}}), "Enter {{Article}} {{SingularLower}} {{KeyLabelLower}}.");
        else if (IsNew && await Store.GetAsync(Model!.{{Key}}) is not null) Error(form, nameof({{ModelType}}.{{Key}}), Taken);
@*#else *@
        if (IsNew && await Store.GetAsync(Model!.{{Key}}) is not null) Error(form, nameof({{ModelType}}.{{Key}}), Taken);
@*#endif *@
@*#endif *@
        if (form.GetValidationMessages().Any()) return;

        if (IsNew)
        {
            // A new one gets only the form's fields: anything else in the post is ignored.
            var item = new {{ModelType}}();
@*#if (KeyInput) *@
            item.{{Key}} = Model!.{{Key}};
@*#endif *@
            Copy(Model!, item);
            if (!await Store.AddAsync(item))
            {
@*#if (KeyInput) *@
                Error(form, nameof({{ModelType}}.{{Key}}), Taken);
@*#else *@
                Error(form, "", "This {{SingularLower}} couldn't be saved. Try again.");
@*#endif *@
                return;
            }
            Toasts.Success("{{Singular}} saved");
            Navigation.NavigateTo(Url(item.{{Key}}));
            return;
        }
        var saved = await Store.GetAsync({{IdValue}});
        if (saved is null)
        {
            Navigation.NotFound();
            return;
        }
        Copy(Model!, saved);
        await Store.UpdateAsync(saved);
        Toasts.Success("{{Singular}} saved");
        Navigation.NavigateTo(Url({{IdValue}}));
    }

    // Only the form's fields: what the form doesn't show is never taken from a post.
    private static void Copy({{ModelType}} from, {{ModelType}} to)
    {
@*#each (Field in FormFields) *@
        to.{{Field.Name}} = from.{{Field.Name}};
@*#endeach *@
    }

    // A {{SingularLower}}'s address, its key escaped for a URL.
    private static string Url({{KeyType}} key) => $"{{Route}}/{{{UrlKey}}}";
@*#if (KeyInput) *@

    private const string Taken = "There's already {{Article}} {{SingularLower}} with this {{KeyLabelLower}}.";
@*#endif *@

    private void Error(EditContext form, string field, string message)
    {
        _errors!.Add(form.Field(field), message);
        form.NotifyValidationStateChanged();
    }

    private static bool IsWebAddress(string text) =>
        Uri.TryCreate(text, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp);

    private static readonly bool?[] YesNo = [true, false];

    private static string YesNoText(bool? value) => value == true ? "Yes" : "No";
@*#each (Field in FormFields) *@
@*#if (Field.Kind == "Enum") *@

    private static string {{Field.Name}}Text({{Field.EnumParam}} value) => value switch
    {
@*#each (Value in Field.Values) *@
        {{Field.EnumType}}.{{Value.Name}} => "{{Value.Label}}",
@*#endeach *@
        _ => $"{value}",
    };
@*#endif *@
@*#endeach *@
}
