@page "/{{Route}}"
@*#if (HasViewPolicy) *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "{{ViewPolicy}}")]
@*#elif (Authorize) *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@*#endif *@
@using {{RootNamespace}}.Data
@*#each (Alias in Aliases) *@
@using {{Alias.Name}} = {{Alias.Type}}
@*#endeach *@
@inject I{{Model}}Store Store
@*#if (HasEditPolicy) *@
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@*#endif *@

<PageTitle>{{Plural}}</PageTitle>

@* The {{PluralLower}} on one page, from izzy add crud: the grid adds, edits and deletes in a dialog it makes
   from the columns, and searches, sorts and pages in the database. Every action is an address and a form
   post, so it works with no circuit. Columns are kept per person in a cookie; Export downloads what's shown,
   from {{Model}}Export.cs. *@
<Stack Gap="new() { Base = 6, Md = 8 }">
    <PageHeader Title="{{Plural}}" />

    <DataGrid TItem="{{ModelType}}" ItemsProvider="Find" FindItem="FindAsync" ItemKey="x => x.{{Key}}.ToString()!" RowLabel="@(x => $"{{RowName}}")" Caption="{{Plural}}" PageSize="10"
              InitialSort="{{InitialSort}}" SmallScreen="DataGridSmallScreen.HideColumns" Searchable ColumnPicker LayoutKey="{{LayoutKey}}" ExportExcelHref="{{Route}}/export.xlsx" ToolbarLabels
              EditMode="DataGridEditMode.Dialog" EditColumns="2" EditDialogTitle="@(x => x is null ? "New {{SingularLower}}" : "Edit {{SingularLower}}")"
              EditSaveText="@(x => x is null ? "Create {{SingularLower}}" : "Save changes")"
@*#if (HasEditPolicy) *@
              NewItem="@(_canEdit ? () => new {{ModelType}}{{NewItemInit}} : null)" ItemEditable="_ => _canEdit" ItemDeletable="_ => _canEdit"
              AddText="Add {{SingularLower}}" OnSave="SaveAsync" OnDelete="DeleteAsync"
@*#else *@
              NewItem="() => new {{ModelType}}{{NewItemInit}}" AddText="Add {{SingularLower}}" OnSave="SaveAsync" OnDelete="DeleteAsync"
@*#endif *@
              NoMatchesText="No {{PluralLower}} match “{0}”" Grow>
        <ToolbarContent>
            <DataGridExport />
            @* On a phone, Add floats at the bottom corner, under the thumb. *@
@*#if (HasEditPolicy) *@
            @if (_canEdit)
            {
                <DataGridAdd FloatBelow="Breakpoint.Sm" />
            }
@*#else *@
            <DataGridAdd FloatBelow="Breakpoint.Sm" />
@*#endif *@
        </ToolbarContent>
        <EmptyContent>
            @* Add {{SingularLower}} is in the toolbar above it; on a phone, where Add floats once there are
               {{PluralLower}}, the empty state holds the button. *@
            <EmptyState Icon="Lucide.Inbox" Title="No {{PluralLower}} yet" Description="Add your first {{SingularLower}} to see them here.">
@*#if (HasEditPolicy) *@
                @if (_canEdit)
                {
                    <Button Href="{{Route}}?add=1" StartIcon="Lucide.Plus" HiddenFrom="Breakpoint.Sm">Add {{SingularLower}}</Button>
                }
@*#else *@
                <Button Href="{{Route}}?add=1" StartIcon="Lucide.Plus" HiddenFrom="Breakpoint.Sm">Add {{SingularLower}}</Button>
@*#endif *@
            </EmptyState>
        </EmptyContent>
        <Columns>
@*#each (Field in Fields) *@
@*#if (Field.InList && Field.IsStatus) *@
            <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}"{{Field.WidthAttr}}{{Field.PriorityAttr}}{{Field.EditableAttr}} Sortable{{Field.FilterAttr}} Context="x">
                <Badge Status="Tone(x.{{Field.Name}})" Dot>@Label(x.{{Field.Name}})</Badge>
            </PropertyColumn>
@*#elif (Field.InList) *@
            <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}"{{Field.FormatAttr}}{{Field.WidthAttr}}{{Field.PriorityAttr}}{{Field.EditableAttr}} Sortable{{Field.FilterAttr}} />
@*#else *@
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}"{{Field.FormatAttr}}{{Field.EditableAttr}} Visible="false" />
@*#endif *@
@*#endeach *@
        </Columns>
    </DataGrid>
</Stack>

@code {
@*#if (HasEditPolicy) *@
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> AuthState { get; set; } = default!;

    // Who may add, edit and delete: the {{EditPolicy}} policy. Everyone else who can open the page sees the
    // {{PluralLower}} read-only.
    private bool _canEdit;

    protected override async Task OnInitializedAsync() =>
        _canEdit = (await Authorization.AuthorizeAsync((await AuthState).User, "{{EditPolicy}}")).Succeeded;

@*#endif *@
    // The grid's search goes to the store, which looks in more fields than the grid shows.
@*#if (HasStatus) *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request with { Search = null }, request.Search, null);
@*#else *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request with { Search = null }, request.Search);
@*#endif *@

    // The row an edit address (?edit=42) names, which may be on another page.
    private Task<{{ModelType}}?> FindAsync(string key) => {{KeyParse}} is { } id ? Store.GetAsync(id) : Task.FromResult<{{ModelType}}?>(null);

    private async Task SaveAsync(DataGridSave<{{ModelType}}> save)
    {
@*#if (HasEditPolicy) *@
        if (!_canEdit) return;
@*#endif *@
        var missing = false;
@*#each (Field in FormFields) *@
@*#if (Field.CheckRequired) *@
        if (string.IsNullOrWhiteSpace(save.Item.{{Field.Name}}))
        {
            save.AddError(x => x.{{Field.Name}}, "Enter {{Field.Article}} {{Field.LabelLower}}.");
            missing = true;
        }
@*#endif *@
@*#endeach *@
        if (missing) return;

        if (save.IsNew)
        {
            if (!await Store.AddAsync(save.Item)) save.AddError("This {{SingularLower}} couldn't be saved. Try again.");
            return;
        }
        if (await Store.GetAsync(save.Item.{{Key}}) is { } saved)
        {
            save.CopyTo(saved);
            await Store.UpdateAsync(saved);
        }
    }

    private async Task DeleteAsync(DataGridDelete<{{ModelType}}> delete)
    {
@*#if (HasEditPolicy) *@
        if (!_canEdit) return;
@*#endif *@
        if (!await Store.DeleteAsync(delete.Item.{{Key}}))
            delete.AddError("Other records point to this {{SingularLower}}. Delete or change those first.");
    }
@*#if (HasStatus) *@

    // A badge's color for each {{StatusLabel}}: change them to what each means in your app.
    private static Status Tone({{StatusType}}? value) => value switch
    {
@*#each (Value in StatusValues) *@
        {{StatusType}}.{{Value.Name}} => IzzyBlazor.Status.{{Value.Tone}},
@*#endeach *@
        _ => IzzyBlazor.Status.Neutral,
    };

    private static string Label({{StatusType}}? value) => value switch
    {
@*#each (Value in StatusValues) *@
        {{StatusType}}.{{Value.Name}} => "{{Value.Label}}",
@*#endeach *@
        _ => value?.ToString() ?? "Not set",
    };
@*#endif *@
}
