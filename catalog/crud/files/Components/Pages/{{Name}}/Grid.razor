@page "/{{Route}}"
@*#if (Authorize) *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@*#endif *@
@using {{RootNamespace}}.Data
@*#each (Alias in Aliases) *@
@using {{Alias.Name}} = {{Alias.Type}}
@*#endeach *@
@inject I{{Model}}Store Store

<PageTitle>{{Plural}}</PageTitle>

@* The {{PluralLower}} on one page, from izzy add crud: the grid adds, edits and deletes in a dialog it makes
   from the columns, and searches, sorts and pages in the database. Every action is an address and a form
   post, so it works with no circuit. Columns are kept per person in a cookie; Export downloads what's shown,
   from {{Model}}Export.cs. *@
<Stack Gap="new() { Base = 6, Md = 8 }">
    <PageHeader Title="{{Plural}}" />

    <DataGrid TItem="{{ModelType}}" ItemsProvider="Find" FindItem="FindAsync" ItemKey="x => x.{{Key}}.ToString()!" RowLabel="@(x => $"{{RowName}}")" Caption="{{Plural}}" PageSize="10"
              InitialSort="{{InitialSort}}" SmallScreen="DataGridSmallScreen.HideColumns" Searchable ColumnPicker LayoutKey="{{LayoutKey}}" ExportExcelHref="{{Route}}/export.xlsx" ToolbarLabels
              EditMode="DataGridEditMode.Dialog" EditColumns="2" EditDialogTitle="@(x => x is null ? "New {{SingularLower}}" : "Edit {{SingularLower}}")"
              NewItem="() => new {{ModelType}}()" AddText="Add {{SingularLower}}" OnSave="SaveAsync" OnDelete="DeleteAsync"
              NoMatchesText="No {{PluralLower}} match “{0}”" Grow>
        <EmptyContent>
            @* No button of its own: Add {{SingularLower}} is right above it. *@
            <EmptyState Icon="Lucide.Inbox" Title="No {{PluralLower}} yet" Description="Add your first {{SingularLower}} to see them here." />
        </EmptyContent>
        <Columns>
@*#each (Field in Fields) *@
@*#if (Field.InList) *@
            <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}"{{Field.FormatAttr}}{{Field.WidthAttr}}{{Field.PriorityAttr}}{{Field.EditableAttr}} Sortable />
@*#else *@
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.{{Field.Name}}" Title="{{Field.Column}}"{{Field.FormatAttr}}{{Field.EditableAttr}} Visible="false" />
@*#endif *@
@*#endeach *@
        </Columns>
    </DataGrid>
</Stack>

@code {
    // The grid's search goes to the store, which looks in more fields than the grid shows.
@*#if (HasStatus) *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request with { Search = null }, request.Search, null);
@*#else *@
    private ValueTask<DataResult<{{ModelType}}>> Find(DataRequest<{{ModelType}}> request) => Store.FindAsync(request with { Search = null }, request.Search);
@*#endif *@

    // The row an edit address (?edit=42) names, which may be on another page.
    private Task<{{ModelType}}?> FindAsync(string key) => {{KeyParse}} is { } id ? Store.GetAsync(id) : Task.FromResult<{{ModelType}}?>(null);

    private async Task SaveAsync(DataGridSave<{{ModelType}}> save)
    {
        var missing = false;
@*#each (Field in FormFields) *@
@*#if (Field.CheckRequired) *@
        if (string.IsNullOrWhiteSpace(save.Item.{{Field.Name}}))
        {
            save.AddError(x => x.{{Field.Name}}, "Enter {{Field.Article}} {{Field.LabelLower}}.");
            missing = true;
        }
@*#endif *@
@*#endeach *@
        if (missing) return;

        if (save.IsNew)
        {
            if (!await Store.AddAsync(save.Item)) save.AddError("This {{SingularLower}} couldn't be saved. Try again.");
            return;
        }
        if (await Store.GetAsync(save.Item.{{Key}}) is { } saved)
        {
            save.CopyTo(saved);
            await Store.UpdateAsync(saved);
        }
    }

    private async Task DeleteAsync(DataGridDelete<{{ModelType}}> delete)
    {
        if (!await Store.DeleteAsync(delete.Item.{{Key}}))
            delete.AddError("Other records point to this {{SingularLower}}. Delete or change those first.");
    }
}
