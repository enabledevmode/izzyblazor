// izzy add crud <Model>: pages to list, show, add, edit and delete a model's records, written into the
// project as code you own. The CLI reads the model from the app's source (no build) and gives the
// item its fields as lists (Fields, FormFields, ListFields, SearchFields, StatusValues), so the
// templates loop over them; the settings it leaves out get their defaults there (Crud.Prepare).
// Grid (C4, free, the default): one page whose DataGrid adds, edits and deletes in a dialog. Pages
// (C1-C3, Pro): a list, a detail page and one form for new and edit; their files are in the private
// Pro catalog (izzyblazor-pro-catalog/crud), never here. Both read and write through I{Model}Store,
// kept in memory or over the app's DbContext. Every page works as static SSR, and interactive too.
// Store Http (Pro), for an app with a .Client project: the pages, the interface and Http{Model}Store go
// to the .Client project, where the pages run in the browser, and the server gets {Model}Api, endpoints
// over the Ef or Memory store (InEf says which). Its two files are in the Pro catalog too.
{
  "id": "crud",
  "name": "Pages for a Model",
  "keywords": ["CRUD", "admin pages", "list and form", "data grid"],
  "kind": "page",
  "category": "Data",
  "summary": "Pages to list, show, add, edit and delete a model's records, from the model class in your app.",
  "components": ["PageHeader", "FilterForm", "DataGrid", "EmptyState", "FloatingButton", "Breadcrumb", "DescriptionList", "ConfirmButton", "Form", "FormErrors", "FormActions", "Badge"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "partial", "Auto": "partial" },
  "screens": [
    {"file": "list", "caption": "The grid page", "alt": "Customers in a grid: each name with its email under it, status, lifetime value, joined date and newsletter, with edit and delete on each row"},
    {"file": "edit", "caption": "Editing in a dialog", "alt": "The grid's Edit customer dialog: name, email, status, lifetime value, joined date and newsletter"},
    {"file": "delete", "caption": "Delete, asked first", "alt": "A dialog asking Delete Jonas Becker? over the grid, with Cancel and Delete"},
    {"file": "pages-list", "caption": "Pages: the list (Pro)", "alt": "The Pages mode's customer list: a search, a status filter, a count, and each name linking to its page"},
    {"file": "details", "caption": "Pages: a record's page (Pro)", "alt": "One customer's page: their status, every field, and Edit and Delete"},
    {"file": "form", "caption": "Pages: the form (Pro)", "alt": "The Edit customer form page, with Save changes and Cancel"},
    {"file": "phone-list", "caption": "The grid page on a phone", "alt": "The grid at a phone's width: each customer's name with their email under it", "phone": true}
  ],
  "modesNote": "WebAssembly and Auto need the Http store (Pro): the pages go into the .Client project and call an API that crud adds to the server. Every other store reads the database on the server.",
  "parameters": {
    "type": "object",
    "properties": {
      "Model": { "type": "string", "default": "", "x-hidden": true, "x-priority": "important", "description": "The model class whose records the pages show, such as Customer." },
      "Mode": {
        "type": "string", "enum": ["Grid", "Pages"], "default": "Grid", "x-tiers": { "Pages": "pro" }, "x-priority": "important",
        "description": "Grid: one page whose grid adds, edits and deletes in a dialog. Pages: a list with filters, a page for each record and a form page, for records with many fields (Pro)."
      },
      "Store": {
        "type": "string", "enum": ["Ef", "Memory", "Http"], "default": "Memory", "x-tiers": { "Http": "pro" }, "x-priority": "important",
        "description": "Where the records are kept: Ef, through the DbContext with a DbSet of the model (the default when there's one), or Memory, until the app stops. Http is for an app with a .Client project: the pages run in the browser and call an API that crud adds to the server, over the DbContext or memory (Pro)."
      },
      "Render": {
        "type": "string", "enum": ["Default", "Server", "WebAssembly", "Auto"], "default": "Default", "x-priority": "important",
        "description": "Where the pages' C# runs. Default: on the server once per request, or in the browser when Store is Http. Server: over a circuit. WebAssembly and Auto: in the browser, with Store Http only."
      },
      "Name": { "type": "string", "default": "", "description": "The folder and the pages' names, and the title: the model's plural by default." },
      "Singular": { "type": "string", "default": "", "description": "What one record is called on the pages, such as team member, when it isn't the class's name in words." },
      "Plural": { "type": "string", "default": "", "description": "What the records are called, such as team members: the title and the nav entry. Defaults to the plural of Singular, else of Name." },
      "Route": { "type": "string", "default": "", "description": "The address the pages start at, such as customers or admin/customers: the name in kebab case by default." },
      "Context": { "type": "string", "default": "", "description": "The DbContext, when more than one has a DbSet of the model." },
      "Folder": { "type": "string", "default": "", "description": "The folder the pages' own folder goes in, from the project's folder: Components/Pages by default, or the .Client project's Pages when Store is Http." },
      "Layout": { "type": "string", "default": "", "description": "The layout component, such as EmptyLayout, when the pages don't use the app's default." },
      "Nav": { "type": "boolean", "default": true, "description": "Adds a link to the pages in the app's nav. Off leaves the nav as it is." },
      "Authorize": { "type": "boolean", "default": false, "description": "Only signed-in people can open the pages. On by default when the app signs people in." },
      "ViewPolicy": { "type": "string", "default": "", "description": "The authorization policy people need to open the pages, such as ViewSales." },
      "EditPolicy": { "type": "string", "default": "", "description": "The policy people need to add, edit and delete; others see the records read-only." }
    }
  },
  "accessibility": [
    "Each page has one h1, its title; the list's count is a status region, so a search says how many it found.",
    "A record's name is the link to it, so the row's menu stays a separate stop for keyboard users.",
    "The form's errors are listed at the top after a failed save, and each field names its own.",
    "Delete asks first, in a dialog that names the record, with the delete button's text repeating the verb."
  ],
  "server": ["{{ServerOnly}}"],
  "exclude": [
    { "if": "Mode == \"Grid\"", "paths": ["Components/Pages/{{Name}}/Index.razor", "Components/Pages/{{Name}}/Details.razor", "Components/Pages/{{Name}}/Edit.razor"] },
    { "if": "Mode == \"Pages\"", "paths": ["Components/Pages/{{Name}}/Grid.razor"] },
    { "if": "InEf", "paths": ["Data/Memory{{Model}}Store.cs"] },
    { "if": "!InEf", "paths": ["Data/Ef{{Model}}Store.cs"] },
    { "if": "!OverHttp", "paths": ["Data/Http{{Model}}Store.cs", "Data/{{Model}}Api.cs"] }
  ],
  "rename": [
    { "if": "OverHttp && Mode == \"Grid\"", "paths": { "Components/Pages/{{Name}}/Grid.razor": "{{PagesFolder}}/{{Name}}/Index.razor" } },
    { "if": "OverHttp", "paths": { "Components/Pages/{{Name}}/": "{{PagesFolder}}/{{Name}}/", "Data/I{{Model}}Store.cs": "{{Client}}Data/I{{Model}}Store.cs", "Data/Http{{Model}}Store.cs": "{{Client}}Data/Http{{Model}}Store.cs" } },
    { "if": "Mode == \"Grid\"", "paths": { "Components/Pages/{{Name}}/Grid.razor": "{{PagesFolder}}/{{Name}}/Index.razor" } },
    { "if": "Mode == \"Pages\"", "paths": { "Components/Pages/{{Name}}/": "{{PagesFolder}}/{{Name}}/" } }
  ],
  "inserts": [
    { "if": "!HasStoreRegistration", "file": "Program.cs", "anchor": "var app = builder.Build();", "position": "before", "text": "builder.Services.{{StoreLifetime}}<{{StoreNamespace}}.I{{Model}}Store, {{RootNamespace}}.Data.{{StoreClass}}>();\n\n" },
    {
      "if": "HasStoreRegistration", "file": "Program.cs", "position": "replace",
      "pattern": "builder\\.Services\\.Add\\w+<[\\w.]*\\bI{{Model}}Store,\\s*[\\w.]+>\\(\\);",
      "text": "builder.Services.{{StoreLifetime}}<{{StoreNamespace}}.I{{Model}}Store, {{RootNamespace}}.Data.{{StoreClass}}>();"
    },
    { "if": "OverHttp", "file": "Program.cs", "anchor": "app.Run();", "position": "before", "text": "{{RootNamespace}}.Data.{{Model}}Api.Map(app);\n" },
    { "if": "OverHttp && !HasHttpClient", "file": "{{Client}}Program.cs", "anchor": "await builder.Build().RunAsync();", "position": "before", "text": "builder.Services.AddScoped(_ => new HttpClient { BaseAddress = new Uri(builder.HostEnvironment.BaseAddress) });\n" },
    { "if": "OverHttp", "file": "{{Client}}Program.cs", "anchor": "await builder.Build().RunAsync();", "position": "before", "text": "builder.Services.AddScoped<{{StoreNamespace}}.I{{Model}}Store, {{StoreNamespace}}.Http{{Model}}Store>();\n\n" },
    { "file": "Program.cs", "anchor": "app.Run();", "position": "before", "text": "{{RootNamespace}}.Data.{{Model}}Export.Map(app);\n\n" },
    { "if": "NavRenamed", "file": "{{LayoutFile}}", "position": "replace", "pattern": "{{NavEntry}}", "text": "{{Plural}}" },
    { "if": "NavIcons && !HasNavLink", "file": "{{LayoutFile}}", "pattern": "<NavItem Href=\"\" Match=\"NavLinkMatch.All\"[^>]*\\bIcon=", "position": "after", "text": "<NavItem Href=\"{{Route}}\" Icon=\"Lucide.Rows3\">{{Plural}}</NavItem>\n" },
    { "if": "!NavIcons && !HasNavLink", "file": "{{LayoutFile}}", "pattern": "<NavItem Href=\"\" Match=\"NavLinkMatch.All\"", "position": "after", "text": "<NavItem Href=\"{{Route}}\">{{Plural}}</NavItem>\n" }
  ]
}
