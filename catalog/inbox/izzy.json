// List and detail app: a shell that fills the window, with a sidebar of views, a list of tickets and the chosen
// ticket beside it, each scrolling on its own; on phones the list and the ticket are two screens. Made over
// the blazor starter, with the welcome page as its Home. Design: artifacts/izzyblazor-handoff-starters.md (ST5).
{
  "id": "inbox",
  "name": "List and detail app",
  "kind": "starter",
  "tier": "account",
  "category": "Starters",
  "summary": "An app that fills the window: a sidebar of views, a list, and the chosen item beside it. On phones the list and the item are two screens.",
  "components": ["EmptyState", "ListView", "Menu", "SidebarToggle", "Splitter"],
  "base": {
    "item": "blazor",
    "fixed": { "Starter": "List and detail app", "Nav": "Sidebar", "Empty": "false", "ContentWidth": "Auto" }
  },
  // The shell, with Blazor's error bar, is ShellLayout here; MainLayout only pads a page inside it.
  "exclude": [
    { "if": "true", "paths": ["{{ProjectName}}/Components/Layout/MainLayout.razor.css"] }
  ],
  "rename": [
    { "if": "UseWebAssembly && InteractiveAtRoot", "paths": { "{{ProjectName}}/Components/Pages/Tickets/": "./{{ProjectName}}.Client/Pages/Tickets/" } }
  ],
  "screens": [
    {"file": "home", "caption": "Home", "alt": "The home page in the list and detail shell"},
    {"file": "list", "caption": "The list", "alt": "The tickets list, with nothing chosen"},
    {"file": "ticket", "caption": "A ticket", "alt": "A ticket open beside the list"},
    {"file": "phone-list", "caption": "The list on a phone", "alt": "The tickets list at a phone's width", "phone": true},
    {"file": "phone-ticket", "caption": "A ticket on a phone", "alt": "A ticket at a phone's width, with a link back to the list", "phone": true}
  ]
}
