@page "/tickets"
@layout ShellLayout

<PageTitle>Inbox</PageTitle>

@* A list and the chosen item beside it. The ticket is in the address (?id=), so choosing one is a link:
   it works on a static page, and the browser's Back returns to the list. From 768px up the list and the
   ticket are a Splitter's two panes: each scrolls on its own, the bar between them resizes the list,
   and LayoutKey keeps the size each person leaves. Below 768px (OnePaneBelow) they are two screens:
   the pane marked Current shows, the list until a ticket is chosen. *@
@*#if (IndividualLocalAuth) *@
<AuthorizeView>
    <NotAuthorized>
        <Center Height="Length.Full" Padding="6">
            <EmptyState Icon="Lucide.Lock" Title="Log in to see your tickets" TitleLevel="1" Size="ControlSize.Lg"
                        Description="Tickets are only shown to signed-in users.">
                <Column Gap="4" Align="Align.Center">
                    <Button Href="Account/Login" Size="ControlSize.Lg">Log in</Button>
                    @*#if (Registration) *@
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">No account? <Anchor Href="Account/Register">Register</Anchor></TextBlock>
                    @*#endif *@
                </Column>
            </EmptyState>
        </Center>
    </NotAuthorized>
    <Authorized>
@*#endif *@
@* The page's heading. On phones the list is hidden while a ticket is open, so it isn't the list's own. *@
<VisuallyHidden As="h1">Inbox</VisuallyHidden>
<Splitter Height="Length.Full" OnePaneBelow="Breakpoint.Md" LayoutKey="inbox">
    <SplitterPane Label="Inbox" Size="Length.Rem(23.75)" Min="Length.Rem(16)" Max="Length.Rem(32)" Current="@(Chosen is null)" role="region" aria-labelledby="inbox-heading">
    <Column Gap="0" Height="Length.Full">
        <Row Justify="Justify.Between" Align="Align.Center" PaddingX="3" MinHeight="Length.Rem(3.5)" BorderBottom="1">
            <Heading Level="2" Size="TextSize.Md" id="inbox-heading">Inbox</Heading>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">12 open</TextBlock>
        </Row>
        <Box Grow MinHeight="Length.Px(0)" Overflow="Overflow.Auto">
            <ListView Items="Ticket.Sample" ItemKey="t => t.Id.ToString()" Label="Tickets" ItemHref="@(t => $"tickets?id={t.Id}")"
                      ItemCurrent="t => t == Chosen" ItemLabel="Label" Context="ticket">
                @{ var unread = ticket.Unread && ticket != Chosen; }
                <Column Gap="1" Grow MinWidth="Length.Px(0)">
                    <Row Gap="2" Align="Align.Center">
                        @if (unread)
                        {
                            <Box As="span" Width="Length.Px(8)" Height="Length.Px(8)" Bg="Color.Primary" Radius="Radius.Full" Shrink="false"><VisuallyHidden>Unread</VisuallyHidden></Box>
                        }
                        <TextBlock Size="TextSize.Sm" Weight="@(unread ? FontWeight.Semibold : FontWeight.Medium)" Truncate Grow MinWidth="Length.Px(0)">@ticket.From</TextBlock>
                        <TextBlock Size="TextSize.Xs" Color="Color.Muted">@ticket.Time</TextBlock>
                    </Row>
                    <TextBlock Size="TextSize.Sm" Weight="@(unread ? FontWeight.Semibold : FontWeight.Normal)" Truncate>@ticket.Subject</TextBlock>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted" Truncate>@ticket.Snippet</TextBlock>
                </Column>
            </ListView>
        </Box>
    </Column>
    </SplitterPane>

    <SplitterPane Label="Ticket" Current="@(Chosen is not null)">
        @if (Chosen is { } chosen)
        {
            <Column As="article" Gap="5" MaxWidth="Length.Rem(47.5)" PaddingX="new() { Base = 4, Md = 8 }" PaddingY="new() { Base = 4, Md = 7 }" aria-labelledby="ticket-heading">
                @* On phones the ticket is a screen of its own: a way back above it. *@
                <Button Href="tickets" Variant="ButtonVariant.Ghost" StartIcon="Lucide.ArrowLeft" AlignSelf="Align.Start" HiddenFrom="Breakpoint.Md">Inbox</Button>
                <Row Gap="3" Justify="Justify.Between" Align="Align.Start">
                    <Heading Level="2" Size="TextSize.Xl" id="ticket-heading">@chosen.Subject</Heading>
                    <Menu Placement="Placement.BottomEnd">
                        <Trigger Context="trigger">
                            <IconButton Label="More actions" Icon="Lucide.Ellipsis" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger" />
                        </Trigger>
                        <ChildContent>
                            @* Sample items: give each an Href, or an OnClick on an interactive page. *@
                            <MenuItem Icon="Lucide.UserCheck">Assign to me</MenuItem>
                            <MenuItem Icon="Lucide.MailOpen">Mark as unread</MenuItem>
                            <MenuDivider />
                            <MenuItem Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
                        </ChildContent>
                    </Menu>
                </Row>
                <Row Gap="3" Align="Align.Center">
                    <Avatar Name="@chosen.From" Decorative />
                    <Column Gap="0" MinWidth="Length.Px(0)">
                        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Semibold">@chosen.From</TextBlock>
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">@chosen.Email · @chosen.Sent</TextBlock>
                    </Column>
                </Row>
                <Column Gap="3" MaxWidth="Length.Rem(40)">
                    @foreach (var paragraph in chosen.Body)
                    {
                        <TextBlock LineHeight="LineHeight.Relaxed" KeepLines>@paragraph</TextBlock>
                    }
                </Column>
                @* Sample buttons: give them an OnClick, or put them in a form that posts. *@
                <Row Gap="2" Wrap PaddingTop="4" BorderTop="1">
                    <Button Size="ControlSize.Sm" StartIcon="Lucide.Reply">Reply</Button>
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Check">Mark as done</Button>
                </Row>
            </Column>
        }
        else
        {
            <Center Height="Length.Full" Padding="6">
                <EmptyState Icon="Lucide.Inbox" Title="No ticket chosen" TitleLevel="2" Description="Choose a ticket from the list to read it here." />
            </Center>
        }
    </SplitterPane>
</Splitter>
@*#if (IndividualLocalAuth) *@
    </Authorized>
</AuthorizeView>
@*#endif *@

@code {
    // The chosen ticket's id, from the address.
    [SupplyParameterFromQuery] private int? Id { get; set; }

    private Ticket? Chosen => Ticket.Sample.FirstOrDefault(t => t.Id == Id);

    // A row's link, named for screen readers: whether it's unread, who it's from and its subject.
    private string Label(Ticket ticket) => (ticket.Unread && ticket != Chosen ? "Unread. " : "") + $"{ticket.From}: {ticket.Subject}";

