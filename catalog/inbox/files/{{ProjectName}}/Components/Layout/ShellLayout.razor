@inherits LayoutComponentBase
@*#if (IndividualLocalAuth) *@
@using Microsoft.AspNetCore.Components.Authorization
@*#endif *@
@inject IConfiguration Configuration

@* The shell fills the window and never scrolls as a whole: the sidebar and the page scroll on their own.
   A page that fills the main area edge to edge, such as the inbox, uses this layout directly
   (@layout ShellLayout); every other page gets MainLayout, which pads it inside this one. *@
@*#if (PlainShell) *@
<AppShell ScrollMode="ShellScroll.Main">
@*#else *@
<AppShell Variant="ShellVariant.{{Shell}}" ScrollMode="ShellScroll.Main">
@*#endif *@
    <AppHeader>
        <SidebarToggle />
        <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
        <Spacer />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Menu" />
        @*#if (IndividualLocalAuth) *@
        <AccountMenu />
        @*#endif *@
    </AppHeader>

    @* The views. Beside the page from 1280px up, so the list and the ticket keep their room; a drawer
       behind the menu button below that. *@
    <AppSidebar Width="Length.Rem(15)" Breakpoint="Breakpoint.Xl">
        <NavMenu>
            <NavItem Href="" Match="NavLinkMatch.All" Icon="Lucide.House">Home</NavItem>
            <NavLabel>Tickets</NavLabel>
            <NavItem Href="tickets" Match="NavLinkMatch.All" Icon="Lucide.Inbox" Badge="@Count(12)">Inbox</NavItem>
            <NavItem Href="tickets/assigned" Icon="Lucide.UserCheck" Badge="@Count(4)">Assigned to me</NavItem>
            <NavItem Href="tickets/waiting" Icon="Lucide.Clock" Badge="@Count(3)">Waiting</NavItem>
            <NavItem Href="tickets/done" Icon="Lucide.Check">Done</NavItem>
        </NavMenu>
        @*#if (IndividualLocalAuth && Registration) *@
        @* On phones the header keeps Log in; Register is at the foot of the drawer. *@
        <SidebarFooter>
            <AuthorizeView>
                <NotAuthorized>
                    <Column Gap="2" HiddenFrom="Breakpoint.Md">
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">New here?</TextBlock>
                        <Button Href="Account/Register" FullWidth>Register</Button>
                    </Column>
                </NotAuthorized>
            </AuthorizeView>
        </SidebarFooter>
        @*#endif *@
    </AppSidebar>

    <AppMain>
        <ErrorGuard ShowDetails="DetailedErrors">
            @Body
        </ErrorGuard>
    </AppMain>
</AppShell>

<ToastRegion />
@*#if (UseServer || UseWebAssembly) *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@*#endif *@

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");

    @*#if (IndividualLocalAuth) *@
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool _signedIn;

    protected override async Task OnParametersSetAsync() =>
        _signedIn = AuthenticationState is not null && (await AuthenticationState).User.Identity?.IsAuthenticated == true;

    // The counts are the signed-in person's, so a signed-out sidebar has none.
    private string? Count(int open) => _signedIn ? open.ToString() : null;
    @*#else *@
    private static string Count(int open) => open.ToString();
    @*#endif *@
}
