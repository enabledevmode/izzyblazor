@inherits LayoutComponentBase
@inject IConfiguration Configuration

@* A website's shell: the header, the page and the footer share one centered column, 72rem wide. The links
   are a row in the header from 768px up; on phones the menu button at the header's end opens them in a
   panel under it. The links and the footer's are placeholders: each opens Pages/Placeholder.razor until it has a page. *@
<AppShell Variant="ShellVariant.Flat" ContentWidth="Length.Rem(72)">
    <AppHeader>
        <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
        <SiteNav MarginStart="6">
            <NavItem Href="features">Features</NavItem>
            <NavItem Href="pricing">Pricing</NavItem>
            <NavItem Href="blog">Blog</NavItem>
            <NavItem Href="about">About</NavItem>
            @*#if (IndividualLocalAuth && Registration) *@
            @* On phones the header keeps Log in; Register is at the foot of the panel. *@
            <SiteNavFooter>
                <AuthorizeView>
                    <NotAuthorized>
                        <Button Href="Account/Register" Size="ControlSize.Lg" FullWidth>Register</Button>
                    </NotAuthorized>
                </AuthorizeView>
            </SiteNavFooter>
            @*#endif *@
        </SiteNav>
        <Spacer />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Menu" />
        @*#if (IndividualLocalAuth) *@
        <AccountMenu />
        @*#endif *@
    </AppHeader>

    <AppMain>
        @* The shell's column has the side gutter; the page adds space above and below. *@
        <Box PaddingTop="new() { Base = 6, Md = 12 }" PaddingBottom="new() { Base = 12, Md = 16 }">
            <ErrorGuard ShowDetails="DetailedErrors">
                @Body
            </ErrorGuard>
        </Box>
    </AppMain>

    <AppFooter>
        <Row Gap="new() { Base = 4, Md = 6 }" Align="Align.Center" Wrap PaddingY="3">
            <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
            <Spacer />
            <Row As="nav" Gap="5" Wrap aria-label="Footer">
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted"><Anchor Href="privacy" Underline="AnchorUnderline.Hover" InheritColor>Privacy</Anchor></TextBlock>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted"><Anchor Href="terms" Underline="AnchorUnderline.Hover" InheritColor>Terms</Anchor></TextBlock>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted"><Anchor Href="contact" Underline="AnchorUnderline.Hover" InheritColor>Contact</Anchor></TextBlock>
            </Row>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Width="new() { Base = Length.Full, Md = Length.Auto }">© @DateTime.Now.Year {{ProjectName}}</TextBlock>
        </Row>
    </AppFooter>
</AppShell>

<ToastRegion />
@*#if (UseServer || UseWebAssembly) *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@*#endif *@

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");
}
