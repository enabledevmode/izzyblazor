@page "/{Slug}"
@inject NavigationManager Navigation

<PageTitle>@_title</PageTitle>

@* Where the header's and the footer's links go until they have pages of their own. A page with its own
   address (@@page "/pricing") takes over from this one; delete this file when none of the links is left.
   Any other address is not found. *@
@if (_title is not null)
{
    <Container Size="ContainerSize.Xs" Align="ContainerAlign.Center" MaxWidth="Length.Rem(27.5)" Gutters="false" MarginTop="new() { Base = 0, Md = 12 }">
        <EmptyState Size="ControlSize.Lg" Icon="Lucide.FilePlus" TitleLevel="1" Title="@_title"
                    Description="Nothing here yet. This link is a placeholder for a page of your own.">
            <EmptyStateActions>
                <Button Href="" Width="new() { Base = Length.Percent(100), Sm = Length.Auto }" MinWidth="Length.Rem(12.5)">Go to the home page</Button>
            </EmptyStateActions>
        </EmptyState>
    </Container>
}

@code {
    // The links in MainLayout that have no page yet.
    private static readonly Dictionary<string, string> Titles = new(StringComparer.OrdinalIgnoreCase)
    {
        ["features"] = "Features",
        ["pricing"] = "Pricing",
        ["blog"] = "Blog",
        ["about"] = "About",
        ["privacy"] = "Privacy",
        ["terms"] = "Terms",
        ["contact"] = "Contact",
    };

    private string? _title;

    [Parameter] public string Slug { get; set; } = "";

    protected override void OnParametersSet()
    {
        _title = Titles.GetValueOrDefault(Slug);
        if (_title is null) Navigation.NotFound();
    }
}
