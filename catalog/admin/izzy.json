// The Admin console: a whole static app over the izzy-blazor starter (Individual accounts, every page static, the
// sidebar), with Identity roles, an audit log of every change, seeded sample data (customers and invoices) and
// deploy files that need no sticky sessions. Design: artifacts/izzyblazor-admin-kit-design.md.
{
  "id": "admin",
  "name": "Admin console",
  "kind": "kit",
  "category": "App kits",
  "summary": "A whole admin app, every page static: users and roles, an audit log, customers and invoices, with sample data.",
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "none", "Auto": "none" },
  "base": {
    "item": "izzy-blazor",
    "fixed": {
      "Interactivity": "None", "AllInteractive": "false", "Auth": "Individual", "UseLocalDB": "false",
      "Empty": "false", "Nav": "Sidebar", "UseProgramMain": "false", "NoHttps": "false"
    }
  },
  "parameters": {
    "type": "object",
    "properties": {
      "Mode": {
        "type": "string", "enum": ["Grid", "Pages"], "default": "Grid", "x-tiers": { "Pages": "pro" },
        "description": "How records are listed and edited: Grid (each list a grid that adds and edits in a dialog) or Pages (a list, a detail page and a form for each).",
        "x-priority": "important"
      }
    }
  },
  "exclude": [
    {
      "if": "true",
      "paths": [
        "{{ProjectName}}/Data/app.db",
        "{{ProjectName}}/Data/SqlLite/**",
        "{{ProjectName}}/Components/Pages/Counter.*",
        "{{ProjectName}}/Components/Pages/Weather.*",
        "{{ProjectName}}/Components/Pages/Contact.*",
        "{{ProjectName}}/Components/Pages/Auth.*"
      ]
    }
  ]
}
