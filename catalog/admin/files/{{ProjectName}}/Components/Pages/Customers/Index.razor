@page "/customers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ViewSales")]
@using {{RootNamespace}}.Data
@using Customer = global::{{RootNamespace}}.Data.Customer
@using CustomerStatus = global::{{RootNamespace}}.Data.CustomerStatus
@using CustomerPlan = global::{{RootNamespace}}.Data.CustomerPlan
@inject ICustomerStore Store
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization

<PageTitle>Customers</PageTitle>

@* The customers on one page, from izzy add crud: the grid adds, edits and deletes in a dialog it makes
   from the columns, and searches, sorts and pages in the database. Every action is an address and a form
   post, so it works with no circuit. Columns are kept per person in a cookie; Export downloads what's shown,
   from CustomerExport.cs. *@
@* A data page: it fills the main area, so the grid scrolls its own rows under its header. *@
<Stack Gap="new() { Base = 6, Md = 8 }" Grow>
    <PageHeader Title="Customers" />

    <DataGrid TItem="Customer" ItemsProvider="Find" FindItem="FindAsync" ItemKey="x => x.Id.ToString()!" RowLabel="@(x => $"{x.FirstName} {x.LastName}")" Caption="Customers" PageSize="10"
              InitialSort="-joined" SmallScreen="DataGridSmallScreen.HideColumns" Searchable ColumnPicker LayoutKey="customers" ExportExcelHref="customers/export.xlsx" ToolbarLabels
              EditMode="DataGridEditMode.Dialog" EditColumns="2" EditDialogTitle="@(x => x is null ? "New customer" : "Edit customer")"
              EditSaveText="@(x => x is null ? "Create customer" : "Save changes")"
              NewItem="@(_canEdit ? () => new Customer { Joined = DateOnly.FromDateTime(DateTime.Today) } : null)" ItemEditable="_ => _canEdit" ItemDeletable="_ => _canEdit"
              AddText="Add customer" OnSave="SaveAsync" OnDelete="DeleteAsync"
              NoMatchesText="No customers match “{0}”" Grow>
        <ToolbarContent>
            <DataGridExport />
            @* On a phone, Add floats at the bottom corner, under the thumb. *@
            @if (_canEdit)
            {
                <DataGridAdd FloatBelow="Breakpoint.Sm" />
            }
        </ToolbarContent>
        <EmptyContent>
            @* Add customer is in the toolbar above it; on a phone, where Add floats once there are
               customers, the empty state holds the button. *@
            <EmptyState Icon="Lucide.Inbox" Title="No customers yet" Description="Add your first customer to see them here.">
                @if (_canEdit)
                {
                    <Button Href="customers?add=1" StartIcon="Lucide.Plus" HiddenFrom="Breakpoint.Sm">Add customer</Button>
                }
            </EmptyState>
        </EmptyContent>
        <Columns>
            <PropertyColumn Property="x => x.FirstName" Title="First name" Sortable />
            <PropertyColumn Property="x => x.LastName" Title="Last name" Sortable />
            <PropertyColumn Property="x => x.Email" Title="Email" Sortable />
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.Phone" Title="Phone" Visible="false" />
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.Company" Title="Company" Visible="false" />
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.StreetAddress" Title="Street address" Visible="false" />
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.City" Title="City" Visible="false" />
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.PostalCode" Title="Postal code" Visible="false" />
            @* In the edit dialog only; the column picker can show it. *@
            <PropertyColumn Property="x => x.Country" Title="Country" Visible="false" />
            <PropertyColumn Property="x => x.Status" Title="Status" Width="Length.Rem(7.5)" Priority="1" Sortable Filterable Context="x">
                <Badge Status="Tone(x.Status)" Dot>@Label(x.Status)</Badge>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Plan" Title="Plan" Width="Length.Rem(7.5)" Sortable Filterable />
            <PropertyColumn Property="x => x.LifetimeValue" Title="Lifetime value" Format="C" Width="Length.Rem(10.5)" Editable="false" Sortable />
            <PropertyColumn Property="x => x.Joined" Title="Joined" Format="MMM d, yyyy" Width="Length.Rem(8.5)" Sortable />
        </Columns>
        @* The dialog in the design's sections, so the address reads as one block. *@
        <EditDialog>
            <Fieldset Label="Contact" Description="Who we’re selling to, and how to reach them." Columns="2">
                <EditField Key="firstname" />
                <EditField Key="lastname" />
                <EditField Key="email" />
                <EditField Key="phone" />
                <EditField Key="company" />
            </Fieldset>
            <Fieldset Label="Address" Description="Used on invoices." Columns="2">
                <EditField Key="streetaddress" ColSpan="GridSpan.Full" />
                <EditField Key="city" />
                <EditField Key="postalcode" />
                <EditField Key="country" />
            </Fieldset>
            <Fieldset Label="Subscription" Description="What they pay for, and where they are with you." Columns="2">
                <EditField Key="status" />
                <EditField Key="plan" />
                <EditField Key="joined" />
            </Fieldset>
        </EditDialog>
    </DataGrid>
</Stack>

@code {
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState> AuthState { get; set; } = default!;

    // Who may add, edit and delete: the EditSales policy. Everyone else who can open the page sees the
    // customers read-only.
    private bool _canEdit;

    protected override async Task OnInitializedAsync() =>
        _canEdit = (await Authorization.AuthorizeAsync((await AuthState).User, "EditSales")).Succeeded;

    // The grid's search goes to the store, which looks in more fields than the grid shows.
    private ValueTask<DataResult<Customer>> Find(DataRequest<Customer> request) => Store.FindAsync(request with { Search = null }, request.Search, null);

    // The row an edit address (?edit=42) names, which may be on another page.
    private Task<Customer?> FindAsync(string key) => (int.TryParse(key, out var parsed) ? parsed : (int?)null) is { } id ? Store.GetAsync(id) : Task.FromResult<Customer?>(null);

    private async Task SaveAsync(DataGridSave<Customer> save)
    {
        if (!_canEdit) return;
        var missing = false;
        if (string.IsNullOrWhiteSpace(save.Item.FirstName))
        {
            save.AddError(x => x.FirstName, "Enter a first name.");
            missing = true;
        }
        if (string.IsNullOrWhiteSpace(save.Item.LastName))
        {
            save.AddError(x => x.LastName, "Enter a last name.");
            missing = true;
        }
        if (string.IsNullOrWhiteSpace(save.Item.Email))
        {
            save.AddError(x => x.Email, "Enter an email.");
            missing = true;
        }
        if (missing) return;

        if (save.IsNew)
        {
            if (!await Store.AddAsync(save.Item)) save.AddError("This customer couldn't be saved. Try again.");
            return;
        }
        if (await Store.GetAsync(save.Item.Id) is { } saved)
        {
            save.CopyTo(saved);
            await Store.UpdateAsync(saved);
        }
    }

    private async Task DeleteAsync(DataGridDelete<Customer> delete)
    {
        if (!_canEdit) return;
        if (!await Store.DeleteAsync(delete.Item.Id))
            delete.AddError("Other records point to this customer. Delete or change those first.");
    }

    // A badge's color for each Status: change them to what each means in your app.
    private static Status Tone(CustomerStatus? value) => value switch
    {
        CustomerStatus.Active => IzzyBlazor.Status.Success,
        CustomerStatus.Trial => IzzyBlazor.Status.Info,
        CustomerStatus.Churned => IzzyBlazor.Status.Neutral,
        _ => IzzyBlazor.Status.Neutral,
    };

    private static string Label(CustomerStatus? value) => value switch
    {
        CustomerStatus.Active => "Active",
        CustomerStatus.Trial => "Trial",
        CustomerStatus.Churned => "Churned",
        _ => value?.ToString() ?? "Not set",
    };
}
