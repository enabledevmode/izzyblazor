@page "/invoices/{Id:int}"
@attribute [Authorize(Policy = Policies.ViewSales)]
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject InvoiceActions Actions
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>@(_invoice?.Number ?? "Invoice")</PageTitle>

@* One invoice: the document as the customer sees it, where it stands, and the one thing to do next, which is
   always the solid button. Beside it, what's owed and the invoice's history from the audit log; on a phone
   those come first, so the status and next step are on screen without scrolling past the paper. Every action
   is a form post that comes back here with a toast (Billing/InvoiceActions.cs). Print prints the document
   alone (wwwroot/app.css). *@
@if (_invoice is not { } invoice)
{
    <EmptyState Icon="Lucide.FileX" Title="Invoice not found" Description="It may have been a draft that was deleted.">
        <Button Href="invoices" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Back to invoices</Button>
    </EmptyState>
}
else
{
    var state = InvoiceText.State(invoice, _today);
    var open = invoice.Status == InvoiceStatus.Sent;
    <PageCrumbs>
        <BreadcrumbItem Href="invoices">Invoices</BreadcrumbItem>
        <BreadcrumbItem>@invoice.Number</BreadcrumbItem>
    </PageCrumbs>

    <Stack Gap="new() { Base = 5, Md = 6 }">
        <PageHeader Title="@invoice.Number" Badge="@state.ToString()" BadgeStatus="InvoiceText.Tone(state)" Description="@Line(invoice, state)" Class="invoice-screen">
            <PageHeaderActions>
                @if (invoice.Status == InvoiceStatus.Draft && _canEdit)
                {
                    @* A draft opens in the wizard at Review, where each step has a Change link. *@
                    <Button Href="@($"invoices/{invoice.Id}/edit?step=4")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Pencil">Edit draft</Button>
                    <Button Submit Form="invoice-action" Name="send" Value="send" StartIcon="Lucide.Send">Send invoice</Button>
                }
                else
                {
                    <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Printer" Print>Print</Button>
                    @if (open && _canEdit)
                    {
                        <Button Submit Form="invoice-action" Name="paid" Value="paid" StartIcon="Lucide.Check">Mark as paid</Button>
                    }
                }
                @if (_canEdit)
                {
                    <Menu Placement="Placement.BottomEnd">
                        <Trigger>
                            <IconButton Icon="Lucide.Ellipsis" Label="More actions" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" @attributes="context" />
                        </Trigger>
                        <ChildContent>
                            @if (invoice.Status == InvoiceStatus.Draft)
                            {
                                <MenuItem Icon="Lucide.Printer" Print>Print</MenuItem>
                            }
                            @if (open)
                            {
                                <MenuItem Icon="Lucide.Bell" Submit Form="invoice-action" Name="remind" Value="remind">Send reminder</MenuItem>
                            }
                            <MenuItem Icon="Lucide.Copy" Submit Form="invoice-action" Name="duplicate" Value="duplicate">Duplicate</MenuItem>
                            @if (invoice.Status == InvoiceStatus.Draft)
                            {
                                <MenuDivider />
                                <MenuItem Icon="Lucide.Trash" Accent="Accent.Danger" Href="@Navigation.GetUriWithQueryParameter("confirm", "delete")">Delete draft</MenuItem>
                            }
                            @if (open)
                            {
                                <MenuDivider />
                                <MenuItem Icon="Lucide.Ban" Accent="Accent.Danger" Href="@Navigation.GetUriWithQueryParameter("confirm", "void")">Void</MenuItem>
                            }
                        </ChildContent>
                    </Menu>
                }
            </PageHeaderActions>
        </PageHeader>

        @if (state == InvoiceState.Overdue)
        {
            var late = InvoiceText.DaysLate(invoice, _today);
            <Alert Status="IzzyBlazor.Status.Danger" Class="invoice-screen">
                <strong>@(late == 1 ? "1 day" : $"{late} days") overdue.</strong>
                @(invoice.Customer?.FirstName ?? "The customer") hasn't paid yet.@(invoice.LastReminder is { } reminded ? $" The last reminder went out on {InvoiceText.Short(reminded)}." : "")
                @if (_canEdit)
                {
                    <AlertActions>
                        <Button Submit Form="invoice-action" Name="remind" Value="remind" Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Danger" StartIcon="Lucide.Bell">Send a reminder</Button>
                    </AlertActions>
                }
            </Alert>
        }

        <Grid Template='new() { Base = "minmax(0, 1fr)", Lg = "minmax(0, 2fr) minmax(0, 1fr)" }' Gap="new() { Base = 4, Lg = 6 }" Align="Align.Start" Class="invoice-layout">
            @* The invoice as the customer sees it, and as it prints. *@
            <Card Class="invoice-document" aria-label="@($"Invoice {invoice.Number}")">
                <Stack Gap="7" Padding="new() { Base = 1, Md = 4 }">
                    <Row Justify="Justify.Between" Align="Align.Start" Gap="4" Wrap>
                        <Stack Gap="1">
                            <Heading Level="2" Size="TextSize.Xl">Invoice</Heading>
                            <TextBlock Size="TextSize.Sm" Color="Color.Muted" TabularNums>@invoice.Number</TextBlock>
                        </Stack>
                        <Stack Gap="0" Align="Align.End">
                            <TextBlock Size="TextSize.Sm" Weight="FontWeight.Semibold">@Company.Name</TextBlock>
                            @foreach (var line in Company.Address)
                            {
                                <TextBlock Size="TextSize.Sm" Color="Color.Muted">@line</TextBlock>
                            }
                        </Stack>
                    </Row>

                    @* Who it's for, and its dates beside it. *@
                    <Grid Template='new() { Base = "minmax(0, 1fr)", Sm = "repeat(2, minmax(0, 1fr))" }' Gap="new() { Base = 4, Sm = 6 }" Align="Align.Start">
                        <DescriptionList Orientation="Orientation.Vertical" Size="ControlSize.Sm">
                            <DescriptionItem Term="Bill to">
                                @InvoiceText.CustomerName(invoice)<br />@invoice.Customer?.Email
                            </DescriptionItem>
                        </DescriptionList>
                        <DescriptionList Orientation="Orientation.Vertical" Size="ControlSize.Sm">
                            <DescriptionItem Term="Issued">@InvoiceText.Date(invoice.Issued)</DescriptionItem>
                            <DescriptionItem Term="Due">@InvoiceText.Date(invoice.Due)</DescriptionItem>
                            @if (invoice.PoNumber is { Length: > 0 } po)
                            {
                                <DescriptionItem Term="PO number">@po</DescriptionItem>
                            }
                        </DescriptionList>
                    </Grid>

                    <Table Items="invoice.Lines" Caption="Items" Bordered="false" Size="ControlSize.Sm">
                        <Columns>
                            <PropertyColumn Property="l => l.Description" Context="l">
                                @l.Description
                                @* On a phone Qty and Unit price are hidden: the sum goes under the description. *@
                                <TextBlock Size="TextSize.Sm" Color="Color.Muted" HiddenFrom="Breakpoint.Sm">@l.Quantity × @InvoiceText.Money(l.UnitPrice)</TextBlock>
                            </PropertyColumn>
                            <PropertyColumn Property="l => l.Quantity" Title="Qty" Align="CellAlign.End" Width="Length.Rem(4)" Class="invoice-wide" />
                            <PropertyColumn Property="l => l.UnitPrice" Title="Unit price" Format="C" Align="CellAlign.End" Width="Length.Rem(7)" Class="invoice-wide" />
                            <TemplateColumn Title="Amount" Align="CellAlign.End" Width="Length.Rem(7)" Context="l">@InvoiceText.Money(l.Amount)</TemplateColumn>
                        </Columns>
                    </Table>

                    <DescriptionList Size="ControlSize.Sm" Class="invoice-totals">
                        <DescriptionItem Term="Subtotal">@InvoiceText.Money(invoice.Subtotal)</DescriptionItem>
                        <DescriptionItem Term="@($"Tax ({(invoice.TaxRate * 100).ToString("0.##", CultureInfo.CurrentCulture)}%)")">@InvoiceText.Money(invoice.Tax)</DescriptionItem>
                        <DescriptionItem Term="Total" Class="invoice-total">@InvoiceText.Money(invoice.Total)</DescriptionItem>
                        @if (invoice.Paid is { } paid)
                        {
                            <DescriptionItem Term="@($"Paid {InvoiceText.Short(paid)}")" Class="invoice-paid">−@InvoiceText.Money(invoice.Total)</DescriptionItem>
                            <DescriptionItem Term="Amount due" Class="invoice-total">@InvoiceText.Money(0)</DescriptionItem>
                        }
                    </DescriptionList>

                    @if (invoice.Note is { Length: > 0 } note)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted" BorderTop="1" PaddingTop="5">@note</TextBlock>
                    }
                </Stack>
            </Card>

            @* What's owed and what happened: first on a phone. *@
            <Stack Gap="new() { Base = 4, Lg = 6 }" LayoutOrder="new() { Base = -1, Lg = 0 }" Class="invoice-screen">
                <Card>
                    <Stack Gap="3">
                        <Heading Level="2" Size="TextSize.Md">@(invoice.Status == InvoiceStatus.Paid ? "Paid" : "Amount due")</Heading>
                        <TextBlock Size="TextSize.Xl3" Weight="FontWeight.Semibold" TabularNums Class="invoice-amount">@InvoiceText.Money(invoice.Status == InvoiceStatus.Void ? 0 : invoice.Total)</TextBlock>
                        <DescriptionList Size="ControlSize.Sm">
                            @if (invoice.Paid is { } paidOn)
                            {
                                <DescriptionItem Term="Paid on">@InvoiceText.Date(paidOn)</DescriptionItem>
                                <DescriptionItem Term="Customer">@InvoiceText.CustomerName(invoice)</DescriptionItem>
                            }
                            else
                            {
                                <DescriptionItem Term="Due">
                                    @if (invoice.Status == InvoiceStatus.Draft)
                                    {
                                        @($"{InvoiceText.Date(invoice.Due)} ({InvoiceText.Terms(InvoiceText.TermsDays(invoice))})")
                                    }
                                    else if (state == InvoiceState.Overdue)
                                    {
                                        <TextBlock As="span" Color="Color.DangerText" Weight="FontWeight.Medium">@InvoiceText.Date(invoice.Due) (@InvoiceText.DueNote(invoice, _today))</TextBlock>
                                    }
                                    else
                                    {
                                        @($"{InvoiceText.Date(invoice.Due)} ({InvoiceText.DueNote(invoice, _today).ToLowerInvariant()})")
                                    }
                                </DescriptionItem>
                                <DescriptionItem Term="Customer">@InvoiceText.CustomerName(invoice)</DescriptionItem>
                                <DescriptionItem Term="Reminders">@(invoice.LastReminder is { } last ? $"Last sent {InvoiceText.Short(last)}" : "None sent")</DescriptionItem>
                            }
                        </DescriptionList>
                    </Stack>
                </Card>

                <Card>
                    <Stack Gap="4">
                        <Heading Level="2" Size="TextSize.Md">Activity</Heading>
                        @* The invoice's history from the audit log, newest first: the same events Audit log lists. *@
                        <Timeline TimePlacement="TimelinePlacement.Below">
                            @foreach (var e in _history)
                            {
                                var who = e.ActorName ?? "System";
                                var changes = Shown(e).ToList();
                                @if (changes.Count == 0)
                                {
                                    <TimelineItem Avatar="@who" Value="Utc(e.Time)">
                                        <TitleContent><strong>@who</strong> @Verb(e, invoice)</TitleContent>
                                    </TimelineItem>
                                }
                                else
                                {
                                    <TimelineItem Avatar="@who" Value="Utc(e.Time)">
                                        <TitleContent><strong>@who</strong> @Verb(e, invoice)</TitleContent>
                                        <ChildContent>
                                            @foreach (var c in changes)
                                            {
                                                @* "Status: Draft → Sent", the old value struck through. *@
                                                <div>
                                                    @AuditText.Field(c.Field):
                                                    @if (c.Before is { } before)
                                                    {
                                                        <TextBlock As="span" Decoration="TextDecoration.LineThrough">@Value(before)</TextBlock>
                                                        <span aria-hidden="true"> → </span><span class="ib-visually-hidden"> to </span>
                                                    }
                                                    <TextBlock As="span" Color="Color.OnSurface">@Value(c.After)</TextBlock>
                                                </div>
                                            }
                                        </ChildContent>
                                    </TimelineItem>
                                }
                            }
                        </Timeline>
                        @if (_canAudit)
                        {
                            <Anchor Href="@($"admin/audit?search={Uri.EscapeDataString(invoice.Number)}&f-type={nameof(Invoice)}")" EndIcon="Lucide.ArrowRight">View in audit log</Anchor>
                        }
                    </Stack>
                </Card>
            </Stack>
        </Grid>
    </Stack>

    @if (_confirm is "delete" or "void" && _canEdit)
    {
        var deleting = _confirm == "delete";
        <Dialog Open QueryKey="confirm" Title="@(deleting ? $"Delete {invoice.Number}?" : $"Void {invoice.Number}?")" Size="DialogSize.Sm" CloseOnBackdrop="false" ShowCloseButton="false">
            <TextBlock>@(deleting ? "The draft is deleted. This can't be undone." : $"{InvoiceText.CustomerName(invoice)} won't owe anything on it. It stays on record as void.")</TextBlock>
            <DialogFooter>
                <Button Href="@($"invoices/{invoice.Id}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Cancel</Button>
                <Button Submit Form="invoice-action" Name="@_confirm" Value="@_confirm" Accent="Accent.Danger">@(deleting ? "Delete draft" : "Void invoice")</Button>
            </DialogFooter>
        </Dialog>
    }
}

@* The page's posts: each button names its action. *@
<form id="invoice-action" method="post" @formname="invoice-action" @onsubmit="ActAsync">
    <AntiforgeryToken />
</form>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "confirm")] private string? Confirm { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "send")] private string? SendPost { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "paid")] private string? PaidPost { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "remind")] private string? RemindPost { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "duplicate")] private string? DuplicatePost { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "delete")] private string? DeletePost { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "void")] private string? VoidPost { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private readonly DateOnly _today = InvoiceText.Today;
    private Invoice? _invoice;
    private List<AuditEvent> _history = [];
    private bool _canEdit, _canAudit;
    private string? _confirm;

    protected override async Task OnParametersSetAsync()
    {
        var user = (await AuthState).User;
        _canEdit = (await Authorization.AuthorizeAsync(user, Policies.EditSales)).Succeeded;
        _canAudit = (await Authorization.AuthorizeAsync(user, Policies.ViewAudit)).Succeeded;
        _invoice = await Actions.GetAsync(Id);
        _confirm = Confirm;
        if (_invoice is not null)
        {
            var id = Id.ToString(CultureInfo.InvariantCulture);
            _history = await Db.AuditEvents.AsNoTracking().Where(e => e.EntityType == nameof(Invoice) && e.EntityId == id)
                .OrderByDescending(e => e.Time).ThenByDescending(e => e.Id).ToListAsync();
        }
    }

    private async Task ActAsync()
    {
        if (!_canEdit || _invoice is not { } invoice) return;
        var number = invoice.Number;
        var name = InvoiceText.CustomerName(invoice);
        if (SendPost is not null) Done(await Actions.SendAsync(invoice), $"{name} will get {number} by email.", "Invoice sent");
        else if (PaidPost is not null) Done(await Actions.MarkPaidAsync(invoice), $"{number} is paid in full.", "Marked as paid");
        else if (RemindPost is not null) Done(await Actions.RemindAsync(invoice), $"{name} will get a reminder for {number}.", "Reminder sent");
        else if (VoidPost is not null) Done(await Actions.VoidAsync(invoice), $"{name} no longer owes anything on {number}.", "Invoice voided");
        else if (DuplicatePost is not null)
        {
            var copy = await Actions.DuplicateAsync(invoice);
            Toasts.Success($"{copy.Number} is a new draft for {name}.", "Invoice duplicated");
            Navigation.NavigateTo($"invoices/{copy.Id}");
            return;
        }
        else if (DeletePost is not null)
        {
            if (await Actions.DeleteDraftAsync(invoice) is { } why)
            {
                Toasts.Error(why);
            }
            else
            {
                Toasts.Success($"{number} is deleted.", "Draft deleted");
                Navigation.NavigateTo("invoices");
                return;
            }
        }
        // Back to the invoice, with no post to repeat on a reload.
        Navigation.NavigateTo($"invoices/{invoice.Id}");
    }

    private void Done(string? error, string message, string title)
    {
        if (error is not null) Toasts.Error(error);
        else Toasts.Success(message, title);
    }

    // The line under the number, which changes with where the invoice stands.
    private static string Line(Invoice invoice, InvoiceState state) => $"{InvoiceText.CustomerName(invoice)} · " + state switch
    {
        InvoiceState.Draft => "Not sent yet",
        InvoiceState.Paid => $"Paid {InvoiceText.Date(invoice.Paid!.Value)}",
        InvoiceState.Overdue => $"Was due {InvoiceText.Date(invoice.Due)}",
        InvoiceState.Void => "Void",
        _ => $"Due {InvoiceText.Date(invoice.Due)}",
    } + $" · {InvoiceText.Money(invoice.Total)}";

    // What an event did to the invoice, after the person's name.
    private static string Verb(AuditEvent e, Invoice invoice)
    {
        if (e.Action == AuditActions.Created) return "created this invoice";
        if (e.Action == AuditActions.InvoiceSent) return $"sent it to {InvoiceText.CustomerName(invoice)}";
        if (e.Action == AuditActions.ReminderSent) return "sent a reminder";
        var status = e.ReadChanges().FirstOrDefault(c => c.Field == nameof(Invoice.Status))?.After;
        return status switch
        {
            nameof(InvoiceStatus.Paid) => "marked it paid",
            nameof(InvoiceStatus.Void) => "voided it",
            _ => AuditText.Label(e.Action).ToLowerInvariant() + " this invoice",
        };
    }

    // The fields worth showing: not when it was sent or paid, which the event itself says, and nothing on creation.
    private static IEnumerable<AuditChange> Shown(AuditEvent e) => e.Action == AuditActions.Created ? []
        : e.ReadChanges().Where(c => c.Field is not (nameof(Invoice.Sent) or nameof(Invoice.Paid) or nameof(Invoice.LastReminder)));

    // A logged value as the page writes it: dates as Dec 13, 2026.
    private static string Value(string? value) =>
        value is null ? "(empty)" : DateOnly.TryParseExact(value, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ? InvoiceText.Date(date) : value;

    // The log keeps UTC; SQLite gives it back unmarked.
    private static DateTimeOffset Utc(DateTime time) => new(DateTime.SpecifyKind(time, DateTimeKind.Utc));
}
