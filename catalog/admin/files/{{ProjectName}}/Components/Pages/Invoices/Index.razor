@page "/invoices"
@attribute [Authorize(Policy = Policies.ViewSales)]
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject InvoiceActions Actions
@inject IAuthorizationService Authorization
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Invoices</PageTitle>

@* Every invoice, newest first, with what's owed and what's late at the top. Status is the main filter, as tabs
   in the address (?status=overdue), and the grid searches by number or customer and pages in the database.
   Each row opens its invoice; its ⋯ menu reminds, marks paid or deletes a draft, as form posts that come back
   with a toast (Billing/InvoiceActions.cs does the work and writes the audit log). *@
@* A data page: it fills the main area, so the grid scrolls its own rows under its header,
   with the pager in view. *@
<Stack Gap="new() { Base = 6, Md = 8 }" Grow>
    <PageHeader Title="Invoices" Description="@Lead" />

    @if (_counts.All == 0)
    {
        <EmptyState Icon="Lucide.FileText" Title="No invoices yet" Description="Create one for a customer in four short steps. You can save it as a draft and send it later.">
            @if (_canEdit)
            {
                <Button Href="invoices/new" StartIcon="Lucide.Plus">New invoice</Button>
            }
        </EmptyState>
    }
    else
    {
        <Stack Gap="4" Grow>
            @* On a phone only Overdue keeps its count, so all five tabs fit. *@
            <TabNav Label="Status">
                @foreach (var tab in Tabs)
                {
                    <TabLink Href="@(tab.Key is null ? "invoices" : $"invoices?status={tab.Key}")" Label="@tab.Label" Current="tab.Key == Shown"
                             Badge="@_counts.Of(tab.Key).ToString("N0")" BadgeStatus="@(tab.Key == "overdue" && _counts.Overdue > 0 ? IzzyBlazor.Status.Danger : IzzyBlazor.Status.Neutral)"
                             BadgeVisibleFrom="@(tab.Key == "overdue" ? null : Breakpoint.Sm)" />
                }
            </TabNav>

            <DataGrid TItem="Invoice" ItemsProvider="FindAsync" ItemKey="i => i.Id.ToString()" RowLabel="i => i.Number" Caption="Invoices"
                      PageSize="25" InitialSort="-number" Searchable SearchLabel="Search number or customer" SmallScreen="DataGridSmallScreen.HideColumns"
                      ItemDeletable="i => _canEdit && i.Status == InvoiceStatus.Draft" OnDelete="DeleteAsync"
                      NoMatchesText="No invoices match “{0}”" Grow>
                <ToolbarContent>
                    <DataGridSearch />
                    @* The grid's main action, as Add customer and Invite user are on theirs; it opens the
                       new-invoice wizard, so it's a link, not the grid's add dialog. A phone floats it. *@
                    @if (_canEdit)
                    {
                        <ToolbarButton Href="invoices/new" StartIcon="Lucide.Plus" Variant="ButtonVariant.Solid" Accent="Accent.Primary"
                                       Position="ToolbarPosition.End" Priority="1" FloatBelow="Breakpoint.Sm" FloatLabel="New invoice">New invoice</ToolbarButton>
                    }
                </ToolbarContent>
                <Columns>
                    <PropertyColumn Property="i => i.Number" Title="Invoice" Sortable Context="i">
                        <Anchor Href="@($"invoices/{i.Id}")" InheritColor Underline="AnchorUnderline.Hover"><TextBlock As="span" Weight="FontWeight.Medium" TabularNums>@i.Number</TextBlock></Anchor>
                        @* On a phone the Customer column is hidden: the name goes under the number. *@
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted" Truncate HiddenFrom="Breakpoint.Sm">@InvoiceText.CustomerName(i)</TextBlock>
                    </PropertyColumn>
                    <PropertyColumn Property="i => i.Customer!.LastName" Title="Customer" SortKey="customer" Sortable Context="i">
                        <TextBlock Truncate>@InvoiceText.CustomerName(i)</TextBlock>
                    </PropertyColumn>
                    <PropertyColumn Property="i => i.Status" Priority="2" Context="i">
                        @{ var state = InvoiceText.State(i, _today); }
                        <Badge Status="InvoiceText.Tone(state)" Dot>@state</Badge>
                        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium" TabularNums HiddenFrom="Breakpoint.Sm">@InvoiceText.Money(i.Total)</TextBlock>
                    </PropertyColumn>
                    <PropertyColumn Property="i => i.Issued" Sortable Context="i">
                        <TextBlock Color="Color.Muted">@(i.Status == InvoiceStatus.Draft ? "—" : InvoiceText.Date(i.Issued))</TextBlock>
                    </PropertyColumn>
                    <PropertyColumn Property="i => i.Due" Sortable Context="i">
                        @* The date (a dash on a draft); an overdue one in danger text. The badge says the rest. *@
                        @{ var late = InvoiceText.State(i, _today) == InvoiceState.Overdue; }
                        <TextBlock Color="@(late ? Color.DangerText : Color.Muted)" Weight="@(late ? FontWeight.Medium : FontWeight.Normal)">@(i.Status == InvoiceStatus.Draft ? "—" : InvoiceText.Date(i.Due))</TextBlock>
                    </PropertyColumn>
                    <TemplateColumn Title="Total" Align="CellAlign.End" Context="i">
                        <TextBlock Weight="FontWeight.Medium" TabularNums>@InvoiceText.Money(i.Total)</TextBlock>
                    </TemplateColumn>
                    <ActionColumn Context="i" Overflow="RowActionOverflow.Always">
                        <RowAction Icon="Lucide.Eye" Label="View" Href="@($"invoices/{i.Id}")" />
                        <RowAction Icon="Lucide.Bell" Label="Send reminder" Form="invoice-action" Name="remind" Value="@i.Id.ToString()" Visible="_canEdit && i.Status == InvoiceStatus.Sent" />
                        <RowAction Icon="Lucide.Check" Label="Mark as paid" Form="invoice-action" Name="paid" Value="@i.Id.ToString()" Visible="_canEdit && i.Status == InvoiceStatus.Sent" />
                        <DeleteAction />
                    </ActionColumn>
                </Columns>
            </DataGrid>
        </Stack>

    }
</Stack>

@* The row menu's posts: they name the action and the invoice. *@
<form id="invoice-action" method="post" @formname="invoice-action" @onsubmit="ActAsync">
    <AntiforgeryToken />
</form>

@code {
    [SupplyParameterFromQuery(Name = "status")] private string? Status { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "remind")] private int? RemindId { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-action", Name = "paid")] private int? PaidId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private static readonly (string? Key, string Label)[] Tabs = [(null, "All"), ("draft", "Draft"), ("sent", "Sent"), ("overdue", "Overdue"), ("paid", "Paid")];

    private readonly DateOnly _today = InvoiceText.Today;
    private Counts _counts = new(0, 0, 0, 0, 0);
    private decimal _outstanding, _overdue;
    private bool _canEdit;

    // The tab shown: one of Tabs' keys, or null for All.
    private string? Shown => Status?.ToLowerInvariant() is { } key && Tabs.Any(t => t.Key == key) ? key : null;

    private string Lead => _counts.All == 0 ? "Bill your customers and see who has paid."
        : Shown == "overdue" ? (_counts.Overdue == 0 ? "Nothing is overdue." : $"{_counts.Overdue} overdue, {InvoiceText.Money(_overdue)} in all. Send a reminder from each invoice.")
        : $"{InvoiceText.Money(_outstanding)} outstanding · {InvoiceText.Money(_overdue)} overdue";

    protected override async Task OnInitializedAsync()
    {
        _canEdit = (await Authorization.AuthorizeAsync((await AuthState).User, Policies.EditSales)).Succeeded;

        // What's owed: every sent invoice not yet paid. Totals come from the lines, so they're added up here.
        var open = await Db.Invoices.AsNoTracking().Where(i => i.Status == InvoiceStatus.Sent).Include(i => i.Lines).ToListAsync();
        _outstanding = open.Sum(i => i.Total);
        _overdue = open.Where(i => i.Due < _today).Sum(i => i.Total);
        var byStatus = await Db.Invoices.GroupBy(i => i.Status).Select(g => new { g.Key, Count = g.Count() }).ToDictionaryAsync(g => g.Key, g => g.Count);
        int Of(InvoiceStatus s) => byStatus.GetValueOrDefault(s);
        var overdue = open.Count(i => i.Due < _today);
        _counts = new(byStatus.Values.Sum(), Of(InvoiceStatus.Draft), Of(InvoiceStatus.Sent) - overdue, overdue, Of(InvoiceStatus.Paid));
    }

    // The tab's invoices, searched by number or customer name, a page at a time.
    private async ValueTask<DataResult<Invoice>> FindAsync(DataRequest<Invoice> request)
    {
        var query = Db.Invoices.AsNoTracking().Include(i => i.Customer).Include(i => i.Lines).AsQueryable();
        query = Shown switch
        {
            "draft" => query.Where(i => i.Status == InvoiceStatus.Draft),
            "sent" => query.Where(i => i.Status == InvoiceStatus.Sent && i.Due >= _today),
            "overdue" => query.Where(i => i.Status == InvoiceStatus.Sent && i.Due < _today),
            "paid" => query.Where(i => i.Status == InvoiceStatus.Paid),
            _ => query,
        };
        if (request.Search?.Trim() is { Length: > 0 } search)
        {
            query = query.Where(i => i.Number.Contains(search) || (i.Customer!.FirstName + " " + i.Customer.LastName).Contains(search));
        }
        return await (request with { Search = null }).ToResultAsync(query, (q, ct) => q.CountAsync(ct), (q, ct) => q.ToListAsync(ct));
    }

    private async Task ActAsync()
    {
        if (!_canEdit) return;
        if (await Actions.GetAsync(RemindId ?? PaidId ?? 0) is not { } invoice)
        {
            Toasts.Error("That invoice isn't here any more.");
        }
        else if (RemindId is not null)
        {
            if (await Actions.RemindAsync(invoice) is { } why) Toasts.Error(why);
            else Toasts.Success($"{InvoiceText.CustomerName(invoice)} will get a reminder for {invoice.Number}.", "Reminder sent");
        }
        else if (await Actions.MarkPaidAsync(invoice) is { } why)
        {
            Toasts.Error(why);
        }
        else
        {
            Toasts.Success($"{invoice.Number} is paid in full.", "Marked as paid");
        }
        // Back to the list as it was, with no post to repeat on a reload.
        Navigation.NavigateTo(Navigation.Uri);
    }

    private async Task DeleteAsync(DataGridDelete<Invoice> delete)
    {
        if (!_canEdit || await Actions.GetAsync(delete.Item.Id) is not { } invoice) return;
        if (await Actions.DeleteDraftAsync(invoice) is { } why) delete.AddError(why);
        else Toasts.Success($"{invoice.Number} is deleted.", "Draft deleted");
    }

    private sealed record Counts(int All, int Draft, int Sent, int Overdue, int Paid)
    {
        public int Of(string? key) => key switch { "draft" => Draft, "sent" => Sent, "overdue" => Overdue, "paid" => Paid, _ => All };
    }
}
