@page "/invoices/new"
@page "/invoices/{Id:int}/edit"
@attribute [Authorize(Policy = Policies.EditSales)]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject InvoiceActions Invoices
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>@Title</PageTitle>

@* A new invoice in four steps: who it's for, what it bills, its numbers and dates, then a review before it's
   sent. Each step is a form post that saves the draft (?draft=42&step=3), so Back, a reload or coming back
   tomorrow keeps the answers; Back saves what's typed without checking it. The draft is made by step 1, and a
   draft's Edit opens here at Review (invoices/42/edit). Add item and Remove post too, and redraw the step. *@
@if (_unavailable)
{
    <EmptyState Icon="Lucide.FileX" Title="This invoice can't be edited" Description="Only a draft can be changed. It may have been sent or deleted.">
        <Button Href="invoices" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Back to invoices</Button>
    </EmptyState>
}
else
{
    <PageCrumbs>
        <BreadcrumbItem Href="invoices">Invoices</BreadcrumbItem>
        @if (Editing)
        {
            <BreadcrumbItem Href="@($"invoices/{_invoice!.Id}")">@_invoice.Number</BreadcrumbItem>
        }
        <BreadcrumbItem>@(Editing ? "Edit" : "New invoice")</BreadcrumbItem>
    </PageCrumbs>

    <Stack Gap="new() { Base = 6, Md = 8 }" MaxWidth="Length.Rem(48)">
        <PageHeader Title="@Title" />

        <Stack Gap="2">
            @* Finished steps link back. On a phone the stepper shows only the current step's name. *@
            <Stepper Current="_step">
                <Step Label="Customer" Href="@StepHref(1)" />
                <Step Label="Items" Href="@StepHref(2)" />
                <Step Label="Details" Href="@StepHref(3)" />
                <Step Label="Review" />
            </Stepper>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" HiddenFrom="Breakpoint.Sm">Step @_step of 4</TextBlock>
        </Stack>

        @switch (_step)
        {
            case 1:
                <Form Model="CustomerStep" FormName="invoice-customer" OnSubmit="SaveCustomerAsync" RequiredMark="RequiredMark.Optional">
                    @Question("Who is this invoice for?", "Pick a customer. Their billing details come from their record.")
                    <Combobox @bind-Value="CustomerStep!.CustomerId" Label="Customer" Placeholder="Type a name or email"
                              Search="FindCustomers" ItemText="CustomerText" Context="id"
                              ActionText="Add a new customer" ActionHref="@Navigation.GetUriWithQueryParameter("new-customer", "1")">
                        <ItemTemplate>
                            <Stack Gap="0">
                                <span>@CustomerText(id)</span>
                                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">@Person(id)?.Email</TextBlock>
                            </Stack>
                        </ItemTemplate>
                    </Combobox>
                    @if (Person(CustomerStep.CustomerId) is { } chosen)
                    {
                        <DescriptionList Orientation="Orientation.Vertical" Size="ControlSize.Sm">
                            <DescriptionItem Term="Bill to">@chosen.Name<br />@chosen.Email</DescriptionItem>
                        </DescriptionList>
                    }
                    @Actions("Continue", back: false)
                </Form>
                break;

            case 2:
                <Form Model="ItemsStep" FormName="invoice-items" OnSubmit="SaveItemsAsync" RequiredMark="RequiredMark.Optional">
                    @Question("What are you billing for?", "Add a line for each product or service.")
                    <FormErrors />
                    <FieldRepeater @bind-Items="ItemsStep!.Lines" NewItem="() => new LineInput()" Label="Items" AddText="Add item" MinItems="1" Context="line">
                        <ChildContent>
                            <TextField @bind-Value="line.Description" Label="Description" />
                            <NumberField @bind-Value="line.Quantity" Label="Quantity" Min="1" StepButtons="StepButtons.None" Width="Length.Rem(5.5)" />
                            <NumberField @bind-Value="line.UnitPrice" Label="Unit price" Min="0" Step="0.01" StepButtons="StepButtons.None" Width="Length.Rem(8)">
                                <StartAddon>@NumberFormatInfo.CurrentInfo.CurrencySymbol</StartAddon>
                            </NumberField>
                            <FieldRepeaterValue Label="Amount" Width="Length.Rem(7)" Align="CellAlign.End">@InvoiceText.Money(line.Amount)</FieldRepeaterValue>
                        </ChildContent>
                        <Footer>
                            <TextBlock TabularNums><TextBlock As="span" Color="Color.Muted">Subtotal</TextBlock> <strong>@InvoiceText.Money(ItemsStep.Lines.Sum(l => l.Amount))</strong></TextBlock>
                        </Footer>
                    </FieldRepeater>
                    @Actions("Continue", back: true)
                </Form>
                break;

            case 3:
                <Form Model="DetailsStep" FormName="invoice-details" OnSubmit="SaveDetailsAsync" Columns="2" RequiredMark="RequiredMark.Optional">
                    @Question("Invoice details", "Numbers and dates that appear on the invoice.")
                    <TextField @bind-Value="DetailsStep!.Number" Label="Invoice number" Hint="The next number in your series." />
                    <TextField @bind-Value="DetailsStep!.PoNumber" Label="PO number" />
                    <DateField @bind-Value="DetailsStep!.Issued" Label="Issue date" />
                    <Select @bind-Value="DetailsStep!.Terms" Label="Payment terms" Items="TermOptions" ItemText="TermText" />
                    <TextArea @bind-Value="DetailsStep!.Note" Label="Note to customer" Rows="4" Hint="Shown on the invoice, under the items." ColSpan="GridSpan.Full" />
                    @Actions("Continue", back: true)
                </Form>
                break;

            default:
                var invoice = _invoice!;
                var days = InvoiceText.TermsDays(invoice);
                <Stack Gap="6">
                    @Question("Check and send", "Make sure everything’s right. You can still change any step.")

                    @Section("Customer", 1, @<DescriptionList>
                        <DescriptionItem Term="Bill to">@InvoiceText.CustomerName(invoice)</DescriptionItem>
                        <DescriptionItem Term="Email">@invoice.Customer?.Email</DescriptionItem>
                    </DescriptionList>)

                    @Section("Items", 2, @<Stack Gap="3">
                        @foreach (var line in invoice.Lines)
                        {
                            <Row Gap="3" Justify="Justify.Between" Align="Align.Start">
                                <TextBlock As="span">@line.Description <TextBlock As="span" Color="Color.Muted" TabularNums>× @line.Quantity</TextBlock></TextBlock>
                                <TextBlock As="span" TabularNums>@InvoiceText.Money(line.Amount)</TextBlock>
                            </Row>
                        }
                        <Divider />
                        <Row Gap="3" Justify="Justify.Between">
                            <TextBlock As="span" Color="Color.Muted">Tax (@((invoice.TaxRate * 100).ToString("0.##", CultureInfo.CurrentCulture))%)</TextBlock>
                            <TextBlock As="span" TabularNums>@InvoiceText.Money(invoice.Tax)</TextBlock>
                        </Row>
                        <Row Gap="3" Justify="Justify.Between">
                            <TextBlock As="span" Weight="FontWeight.Semibold">Total due</TextBlock>
                            <TextBlock As="span" Weight="FontWeight.Semibold" TabularNums>@InvoiceText.Money(invoice.Total)</TextBlock>
                        </Row>
                    </Stack>)

                    @Section("Details", 3, @<DescriptionList>
                        <DescriptionItem Term="Invoice">@invoice.Number</DescriptionItem>
                        @if (invoice.PoNumber is { Length: > 0 } po)
                        {
                            <DescriptionItem Term="PO number">@po</DescriptionItem>
                        }
                        <DescriptionItem Term="Issued">@InvoiceText.Date(invoice.Issued)</DescriptionItem>
                        <DescriptionItem Term="Due">@(days <= 0 ? $"{InvoiceText.Date(invoice.Due)} (due on receipt)" : $"{InvoiceText.Date(invoice.Due)} ({InvoiceText.Terms(days)})")</DescriptionItem>
                        @if (invoice.Note is { Length: > 0 } note)
                        {
                            <DescriptionItem Term="Note">@note</DescriptionItem>
                        }
                    </DescriptionList>)

                    @* Sending and saving are posts; Back goes to Details. *@
                    <form method="post" @formname="invoice-review" @onsubmit="ReviewAsync">
                        <AntiforgeryToken />
                        @Actions("Send invoice", back: true, draft: true)
                    </form>
                </Stack>
                break;
        }
    </Stack>

    @if (AddingCustomer is not null && _step == 1)
    {
        <Dialog Open QueryKey="new-customer" Title="New customer" Size="DialogSize.Sm">
            <Form Model="NewCustomer" FormName="invoice-new-customer" OnValidSubmit="AddCustomerAsync" RequiredMark="RequiredMark.Optional">
                <TextField @bind-Value="NewCustomer!.FirstName" Label="First name" AutoComplete="off" />
                <TextField @bind-Value="NewCustomer!.LastName" Label="Last name" AutoComplete="off" />
                <TextField @bind-Value="NewCustomer!.Email" Label="Email" Type="TextFieldType.Email" AutoComplete="off" />
                <DialogFooter>
                    <Button Href="@Navigation.GetUriWithQueryParameter("new-customer", (string?)null)" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Cancel</Button>
                    <Button Submit>Add customer</Button>
                </DialogFooter>
            </Form>
        </Dialog>
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "draft")] private int? DraftQuery { get; set; }
    [SupplyParameterFromQuery(Name = "step")] private int? StepQuery { get; set; }
    [SupplyParameterFromQuery(Name = "customer")] private int? CustomerQuery { get; set; }
    [SupplyParameterFromQuery(Name = "new-customer")] private string? AddingCustomer { get; set; }

    [SupplyParameterFromForm(FormName = "invoice-customer")] private CustomerInput? CustomerStep { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-items")] private ItemsInput? ItemsStep { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-details")] private DetailsInput? DetailsStep { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-new-customer")] private NewCustomerInput? NewCustomer { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-items", Name = "go")] private string? ItemsGo { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-details", Name = "go")] private string? DetailsGo { get; set; }
    [SupplyParameterFromForm(FormName = "invoice-review", Name = "go")] private string? ReviewGo { get; set; }

    private static readonly int[] StandardTerms = [0, 7, 14, 30, 45, 60];

    private Invoice? _invoice;
    private List<Picked> _people = [];
    private int _step = 1, _reached = 1;
    private bool _unavailable;

    // Editing a draft from its page (invoices/42/edit), rather than making one here.
    private bool Editing => Id is not null;

    private string Title => Editing && _invoice is not null ? $"Edit {_invoice.Number}" : "New invoice";

    protected override async Task OnParametersSetAsync()
    {
        if ((Id ?? DraftQuery) is { } id)
        {
            _invoice = await Invoices.GetAsync(id);
            if (_invoice is not { Status: InvoiceStatus.Draft })
            {
                _unavailable = true;
                return;
            }
        }

        _people = await Db.Customers.AsNoTracking().OrderBy(c => c.FirstName).ThenBy(c => c.LastName)
            .Select(c => new Picked(c.Id, c.FirstName + " " + c.LastName, c.Email)).ToListAsync();

        // A step opens once the ones before it are answered: Items needs the draft, Details and Review need a line.
        _reached = _invoice is null ? 1 : _invoice.Lines.Count == 0 ? 2 : 4;
        _step = Math.Clamp(StepQuery ?? (Editing ? 4 : 1), 1, _reached);

        CustomerStep ??= new() { CustomerId = CustomerQuery ?? _invoice?.CustomerId };
        ItemsStep ??= new()
        {
            Lines = _invoice?.Lines.Count > 0
                ? [.. _invoice.Lines.Select(l => new LineInput { Description = l.Description, Quantity = l.Quantity, UnitPrice = l.UnitPrice })]
                : [new()],
        };
        DetailsStep ??= _invoice is null ? new() : new()
        {
            Number = _invoice.Number,
            PoNumber = _invoice.PoNumber,
            Issued = _invoice.Issued,
            Terms = InvoiceText.TermsDays(_invoice),
            Note = _invoice.Note,
        };
        NewCustomer ??= new();
    }

    private async Task SaveCustomerAsync(EditContext context)
    {
        if (!context.Validate()) return;
        var customerId = CustomerStep!.CustomerId!.Value;
        if (Person(customerId) is null)
        {
            Fail(context, nameof(CustomerInput.CustomerId), "Choose a customer from the list.");
            return;
        }

        if (_invoice is null)
        {
            // The draft starts here, so leaving now keeps it.
            _invoice = await Invoices.StartDraftAsync(customerId);
            Navigation.NavigateTo($"invoices/new?draft={_invoice.Id}&step=2");
            return;
        }

        _invoice.CustomerId = customerId;
        await Db.SaveChangesAsync();
        Navigation.NavigateTo(Here(2));
    }

    private async Task SaveItemsAsync(EditContext context)
    {
        var back = ItemsGo == "back";
        if (!back && !context.Validate()) return;

        // Back keeps what's typed, unchecked: a row with nothing in it is left out.
        _invoice!.Lines.Clear();
        foreach (var line in ItemsStep!.Lines.Where(l => !back || !l.IsBlank))
        {
            _invoice.Lines.Add(new InvoiceLine { Description = line.Description?.Trim() ?? "", Quantity = line.Quantity ?? 0, UnitPrice = line.UnitPrice ?? 0 });
        }

        await Db.SaveChangesAsync();
        Navigation.NavigateTo(Here(back ? 1 : 3));
    }

    private async Task SaveDetailsAsync(EditContext context)
    {
        var back = DetailsGo == "back";
        var form = DetailsStep!;
        var number = form.Number?.Trim();
        var taken = number is { Length: > 0 } && await Db.Invoices.AnyAsync(i => i.Number == number && i.Id != _invoice!.Id);
        if (!back)
        {
            var valid = context.Validate();
            if (taken)
            {
                Fail(context, nameof(DetailsInput.Number), $"{number} is another invoice's number. Use the next one in your series.");
                valid = false;
            }

            if (!valid) return;
        }

        // Back saves whatever is usable of what's typed.
        var invoice = _invoice!;
        if (number is { Length: > 0 and <= 20 } && !taken) invoice.Number = number;
        if (form.PoNumber?.Trim() is var po && po?.Length is null or <= 40) invoice.PoNumber = string.IsNullOrEmpty(po) ? null : po;
        if (form.Issued is { } issued) invoice.Issued = issued;
        invoice.Due = invoice.Issued.AddDays(Math.Max(0, form.Terms));
        if (form.Note?.Trim() is var note && note?.Length is null or <= 500) invoice.Note = string.IsNullOrEmpty(note) ? null : note;
        await Db.SaveChangesAsync();
        Navigation.NavigateTo(Here(back ? 2 : 4));
    }

    private async Task ReviewAsync()
    {
        var invoice = _invoice!;
        switch (ReviewGo)
        {
            case "send":
                if (await Invoices.SendAsync(invoice) is { } why)
                {
                    Toasts.Error(why);
                    Navigation.NavigateTo(Here(4));
                    return;
                }

                Toasts.Success($"{invoice.Number} is on its way to {invoice.Customer?.Email}.", "Invoice sent");
                Navigation.NavigateTo("invoices");
                return;
            case "draft":
                Toasts.Success($"{invoice.Number} is saved. Send it when it's ready.", "Draft saved");
                Navigation.NavigateTo($"invoices/{invoice.Id}");
                return;
            default:
                Navigation.NavigateTo(Here(3));
                return;
        }
    }

    // "Add a new customer" from the picker's list: the customer is added and chosen, and the dialog closes.
    private async Task AddCustomerAsync(EditContext context)
    {
        var input = NewCustomer!;
        var email = input.Email!.Trim();
        if (await Db.Customers.AnyAsync(c => c.Email == email))
        {
            Fail(context, nameof(NewCustomerInput.Email), "A customer already has this email. Search for them instead.");
            return;
        }

        var customer = new Customer
        {
            FirstName = input.FirstName!.Trim(),
            LastName = input.LastName!.Trim(),
            Email = email,
            Status = CustomerStatus.Active,
            Joined = InvoiceText.Today,
        };
        Db.Customers.Add(customer);
        await Db.SaveChangesAsync();
        Navigation.NavigateTo(Here(1, customer.Id));
    }

    // This wizard's address at a step: the draft's, once there is one.
    private string Here(int step, int? customer = null)
    {
        var path = _invoice is null ? "invoices/new" : Editing ? $"invoices/{_invoice.Id}/edit" : $"invoices/new?draft={_invoice.Id}";
        if (_invoice is not null) path += (path.Contains('?') ? "&" : "?") + $"step={step}";
        return customer is null ? path : path + (path.Contains('?') ? "&" : "?") + $"customer={customer}";
    }

    private string? StepHref(int step) => step < _step && step <= _reached ? Here(step) : null;

    private Picked? Person(int? id) => id is null ? null : _people.Find(p => p.Id == id);

    private string CustomerText(int? id) => Person(id)?.Name ?? "";

    // The picker finds customers by name or email.
    private Task<IEnumerable<int?>> FindCustomers(string text, CancellationToken cancellationToken) =>
        Task.FromResult(_people
            .Where(p => text.Length == 0 || p.Name.Contains(text, StringComparison.CurrentCultureIgnoreCase) || p.Email.Contains(text, StringComparison.OrdinalIgnoreCase))
            .Take(50).Select(p => (int?)p.Id));

    // The usual terms, and the draft's own if it has others.
    private IEnumerable<int> TermOptions => StandardTerms.Contains(DetailsStep!.Terms) ? StandardTerms : StandardTerms.Append(DetailsStep.Terms).Order();

    private string TermText(int days)
    {
        var issued = DetailsStep!.Issued ?? InvoiceText.Today;
        return days <= 0 ? $"Due on receipt · {InvoiceText.Date(issued)}" : $"{InvoiceText.Terms(days)} · due {InvoiceText.Date(issued.AddDays(days))}";
    }

    private static void Fail(EditContext context, string field, string message)
    {
        var messages = new ValidationMessageStore(context);
        messages.Add(context.Field(field), message);
        context.NotifyValidationStateChanged();
    }

    // Each step's question and its one line of help.
    private static RenderFragment Question(string question, string help) =>
        @<Stack Gap="1">
            <Heading Level="2" Size="TextSize.Xl">@question</Heading>
            <TextBlock Color="Color.Muted">@help</TextBlock>
        </Stack>;

    // A review section: its answers, and a link back to the step that asked them.
    private RenderFragment Section(string title, int step, RenderFragment body) =>
        @<Card>
            <Stack Gap="4">
                <Row Gap="3" Justify="Justify.Between" Align="Align.Center">
                    <Heading Level="3" Size="TextSize.Md">@title</Heading>
                    <Anchor Href="@Here(step)">Change<span class="ib-visually-hidden"> @title.ToLowerInvariant()</span></Anchor>
                </Row>
                @body
            </Stack>
        </Card>;

    // Continue (or Send), Back, and on Review Save as draft; Cancel at the far end (under them on a phone).
    // Back is a submit that skips checking, so it saves what's typed.
    private RenderFragment Actions(string next, bool back, bool draft = false) =>
        @<Stack Direction="new() { Base = Direction.Column, Sm = Direction.Row }" Align="new() { Base = Align.Stretch, Sm = Align.Center }"
                Gap="3" BorderTop="1" PaddingTop="6" ColSpan="GridSpan.Full">
            <Button Submit Name="go" Value="@(draft ? "send" : "next")" StartIcon="@(draft ? Lucide.Send : null)">@next</Button>
            @if (back)
            {
                <Button Submit Name="go" Value="back" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" formnovalidate>Back</Button>
            }
            @if (draft)
            {
                <Button Submit Name="go" Value="draft" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Save as draft</Button>
            }
            <Box Grow VisibleFrom="Breakpoint.Sm" />
            <Anchor Href="@(Editing ? $"invoices/{_invoice!.Id}" : "invoices")" AlignSelf="new() { Base = Align.Center, Sm = Align.Center }">Cancel</Anchor>
        </Stack>;

    private sealed record Picked(int Id, string Name, string Email);

    public sealed class CustomerInput
    {
        [Required(ErrorMessage = "Choose a customer.")]
        public int? CustomerId { get; set; }
    }

    public sealed class ItemsInput
    {
        public List<LineInput> Lines { get; set; } = [];
    }

    public sealed class LineInput
    {
        [Required(ErrorMessage = "Enter a description."), StringLength(200)]
        public string? Description { get; set; }

        [Required(ErrorMessage = "Enter a quantity."), Range(1, 100_000, ErrorMessage = "Enter a quantity from 1 to 100,000.")]
        public int? Quantity { get; set; }

        [Display(Name = "Unit price"), Required(ErrorMessage = "Enter a price."), Range(typeof(decimal), "0", "1000000", ErrorMessage = "Enter a price up to 1,000,000.")]
        public decimal? UnitPrice { get; set; }

        public decimal Amount => (Quantity ?? 0) * (UnitPrice ?? 0);

        public bool IsBlank => string.IsNullOrWhiteSpace(Description) && Quantity is null && UnitPrice is null;
    }

    public sealed class DetailsInput
    {
        [Display(Name = "Invoice number"), Required(ErrorMessage = "Enter an invoice number."), StringLength(20)]
        public string? Number { get; set; }

        [Display(Name = "PO number"), StringLength(40)]
        public string? PoNumber { get; set; }

        [Display(Name = "Issue date"), Required(ErrorMessage = "Enter the issue date.")]
        public DateOnly? Issued { get; set; }

        [Display(Name = "Payment terms"), Required]
        public int Terms { get; set; } = InvoiceActions.DefaultTerms;

        [StringLength(500)]
        public string? Note { get; set; }
    }

    public sealed class NewCustomerInput
    {
        [Required(ErrorMessage = "Enter their first name."), StringLength(40)]
        public string? FirstName { get; set; }

        [Required(ErrorMessage = "Enter their last name."), StringLength(40)]
        public string? LastName { get; set; }

        [Required(ErrorMessage = "Enter their email."), EmailAddress, StringLength(254)]
        public string? Email { get; set; }
    }
}
