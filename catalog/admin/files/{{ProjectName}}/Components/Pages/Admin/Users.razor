@page "/admin/users"
@attribute [Authorize(Policy = Policies.ManageUsers)]
@inject UserAdmin Admin
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation
@inject ToastService Toasts

<PageTitle>Users</PageTitle>

@* Everyone who can sign in, with a search and Role and Status filters in the grid's toolbar, all in the address
   so a filtered list can be shared. Each row's ⋯ menu acts on that account; every action is a form post, and
   comes back here with a toast. *@
<Stack Gap="new() { Base = 6, Md = 8 }">
    <PageHeader Title="Users" Description="People who can sign in to {{ProjectName}}.">
        <PageHeaderActions>
            <Button Href="admin/users/invite" StartIcon="Lucide.UserPlus" VisibleFrom="Breakpoint.Sm">Invite user</Button>
        </PageHeaderActions>
    </PageHeader>

    <DataGrid TItem="UserRow" Items="_users" ItemKey="u => u.Id" RowLabel="u => u.Name" Caption="Users" PageSize="25"
              Searchable SearchLabel="Name or email" SmallScreen="DataGridSmallScreen.HideColumns" OnDelete="DeleteAsync" ItemDeletable="u => u.Id != _me"
              NoMatchesText="No users match “{0}”" Grow>
        <ToolbarContent>
            <DataGridSearch />
            <DataGridFilter Column="Role" />
            <DataGridFilter Column="Status" />
        </ToolbarContent>
        <EmptyContent>
            <EmptyState Icon="Lucide.SearchX" Title="No users match" Description="Try another name, role or status.">
                <Button Href="admin/users" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Clear filters</Button>
            </EmptyState>
        </EmptyContent>
        <Columns>
            <TemplateColumn Title="User" SortBy="u => u.Name" FilterBy="u => u.Name + ' ' + u.Email" Sortable Context="user">
                <Row Gap="3" Align="Align.Center">
                    <Avatar Name="@user.Name" Size="AvatarSize.Sm" Decorative />
                    <Stack Gap="0" Grow>
                        <Row Gap="2" Align="Align.Center">
                            <Anchor Href="@($"admin/users/{user.Id}")" Underline="AnchorUnderline.Hover" InheritColor>@user.Name</Anchor>
                            @if (user.Id == _me)
                            {
                                <Badge Accent="Accent.Primary">You</Badge>
                            }
                        </Row>
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted" Truncate>@user.Email</TextBlock>
                    </Stack>
                </Row>
            </TemplateColumn>
            <TemplateColumn Title="Role" SortKey="role" FilterBy="u => u.Roles" Filter="RoleFilter" Filterable Context="user">
                <ChildContent>
                    <Row Gap="1" Wrap>
                        @foreach (var role in user.Roles.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                        {
                            <Badge Variant="BadgeVariant.Outline">@role</Badge>
                        }
                    </Row>
                </ChildContent>
                <FilterTemplate Context="filter">
                    @foreach (var role in Roles.All)
                    {
                        <label class="ib-check">
                            <input class="ib-check-input" @attributes="filter.CheckboxAttributes(role)" />
                            <span>@role</span>
                        </label>
                    }
                </FilterTemplate>
            </TemplateColumn>
            <PropertyColumn Property="u => u.Status" Filterable Priority="1" Width="Length.Rem(9)" Context="user">
                <Badge Status="StatusColor(user.Status)" Dot>@user.Status</Badge>
            </PropertyColumn>
            <PropertyColumn Property="u => u.LastSignIn" Title="Last sign-in" Sortable Width="Length.Rem(9)" Context="user">
                @if (user.LastSignIn is { } at)
                {
                    <RelativeTime Value="new DateTimeOffset(DateTime.SpecifyKind(at, DateTimeKind.Utc))" Color="Color.Muted" />
                }
                else
                {
                    <TextBlock Color="Color.Muted" Italic>Never</TextBlock>
                }
            </PropertyColumn>
            <ActionColumn Context="user" Overflow="RowActionOverflow.Always">
                <RowAction Icon="Lucide.Eye" Label="View" Href="@($"admin/users/{user.Id}")" />
                <RowAction Icon="@(user.Status == UserStatus.Invited ? Lucide.Send : Lucide.KeyRound)" Label="@(user.Status == UserStatus.Invited ? "Resend invite" : "Send password reset")" Form="user-action" Name="reset" Value="@user.Id" Visible="user.Status != UserStatus.Deactivated" />
                <RowAction Icon="Lucide.UserCheck" Label="Reactivate" Form="user-action" Name="reactivate" Value="@user.Id" Visible="user.Status == UserStatus.Deactivated" />
                <RowAction Icon="Lucide.UserX" Label="Deactivate" Href="@Navigation.GetUriWithQueryParameter("deactivate", user.Id)" Visible="user.Status != UserStatus.Deactivated && user.Id != _me" />
                <DeleteAction />
            </ActionColumn>
        </Columns>
    </DataGrid>
</Stack>

@* On a phone, Invite floats at the bottom corner, under the thumb. *@
<FloatingButton Href="admin/users/invite" Icon="Lucide.UserPlus" Label="Invite user" HiddenFrom="Breakpoint.Sm" />

@* The row menu's posts: they name the action and the user. *@
<form id="user-action" method="post" @formname="user-action" @onsubmit="ActAsync">
    <AntiforgeryToken />
</form>

@if (_deactivating is { } leaving)
{
    <Dialog Open QueryKey="deactivate" Title="@($"Deactivate {leaving.Name}?")" Size="DialogSize.Sm" CloseOnBackdrop="false" ShowCloseButton="false">
        <TextBlock>They can't sign in until they're reactivated. Nothing they did is lost.</TextBlock>
        <DialogFooter>
            <Button Href="admin/users" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Cancel</Button>
            <Button Submit Form="user-action" Name="deactivate" Value="@leaving.Id" Accent="Accent.Danger">Deactivate</Button>
        </DialogFooter>
    </Dialog>
}

@code {
    [SupplyParameterFromQuery(Name = "deactivate")] private string? DeactivateId { get; set; }
    [SupplyParameterFromForm(FormName = "user-action", Name = "reset")] private string? ResetId { get; set; }
    [SupplyParameterFromForm(FormName = "user-action", Name = "deactivate")] private string? DeactivatePostId { get; set; }
    [SupplyParameterFromForm(FormName = "user-action", Name = "reactivate")] private string? ReactivateId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<UserRow> _users = [];
    private UserRow? _deactivating;
    private string? _me;

    protected override async Task OnInitializedAsync()
    {
        _me = UserManager.GetUserId((await AuthState).User);
        _users = await Admin.ListAsync();
        _deactivating = _users.FirstOrDefault(u => u.Id == DeactivateId && u.Id != _me && u.Status != UserStatus.Deactivated);
    }

    private async Task ActAsync()
    {
        var id = ResetId ?? DeactivatePostId ?? ReactivateId;
        if (await UserManager.FindByIdAsync(id ?? "") is not { } user)
        {
            Toasts.Error("That user isn't here any more.");
        }
        else if (ResetId is not null)
        {
            var sent = await Admin.SendPasswordResetAsync(user);
            Toasts.Success(sent == "Invite sent"
                ? $"{user.Name ?? user.Email} will get the invite again."
                : $"{user.Name ?? user.Email} will get an email with a link to set a new password.", sent);
        }
        else if (DeactivatePostId is not null)
        {
            if (await Admin.DeactivateAsync(user, _me) is { } why) Toasts.Error(why);
            else Toasts.Success($"{user.Name ?? user.Email} can't sign in until they're reactivated.", "User deactivated");
        }
        else
        {
            await Admin.ReactivateAsync(user);
            Toasts.Success($"{user.Name ?? user.Email} can sign in again.", "User reactivated");
        }
        // Back to the list as it was, with no post to repeat on a reload.
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("deactivate", (string?)null));
    }

    private async Task DeleteAsync(DataGridDelete<UserRow> delete)
    {
        if (await UserManager.FindByIdAsync(delete.Item.Id) is not { } user) return;
        if (await Admin.DeleteAsync(user, _me) is { } why) delete.AddError(why);
        else Toasts.Success($"{delete.Item.Name} no longer has access.", "User deleted");
    }

    // A person can have more than one role, so the Role filter keeps anyone who has any of those chosen.
    private static System.Linq.Expressions.Expression<Func<UserRow, bool>>? RoleFilter(FieldFilter filter)
    {
        var chosen = filter.Values.Select(v => v?.ToString()).OfType<string>().ToList();
        return chosen.Count == 0 ? null : u => chosen.Any(role => (", " + u.Roles + ",").Contains(", " + role + ","));
    }

    private static Status StatusColor(UserStatus status) => status switch
    {
        UserStatus.Active => Status.Success,
        UserStatus.Invited => Status.Info,
        UserStatus.Locked => Status.Warning,
        _ => Status.Neutral,
    };
}
