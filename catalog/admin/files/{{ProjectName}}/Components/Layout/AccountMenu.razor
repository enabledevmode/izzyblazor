@implements IDisposable
@inject NavigationManager NavigationManager

@* At the end of the header. Signed in: your avatar (your name's initials), opening a menu headed by your
   name, to manage your account or log out. Signed out: Log in; there's no Register, as accounts
   come by invite. The name comes from your sign-in (Security/NameClaim.cs); with none set, the email. *@
<AuthorizeView>
    <Authorized>
        @{
            var shown = NameClaim.Shown(context.User);
        }
        <Menu Placement="Placement.BottomEnd">
            <Trigger Context="trigger">
                <IconButton Label="Account" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger">
                    <Avatar Name="@shown" Size="AvatarSize.Sm" Decorative />
                </IconButton>
            </Trigger>
            <ChildContent>
                <MenuGroup Label="@(shown ?? "Account")">
                    <MenuItem Href="Account/Manage" Icon="Lucide.User">Manage account</MenuItem>
                </MenuGroup>
                <MenuDivider />
                <MenuItem Submit Form="logout-form" Icon="Lucide.LogOut">Log out</MenuItem>
            </ChildContent>
        </Menu>
        <form id="logout-form" action="Account/Logout" method="post" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </form>
    </Authorized>
    <NotAuthorized>
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm">Log in</Button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
