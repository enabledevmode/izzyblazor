@inherits LayoutComponentBase
@inject IConfiguration Configuration

@* The admin console's shell: a sidebar the full height of the window, with the brand at its top, the
   pages in groups and Settings at its foot. On wide screens it collapses to an icon rail (the button at
   its foot, remembered in a cookie); on phones it's a drawer behind the menu button. The header holds
   the page's breadcrumbs (PageCrumbs), the color scheme and your account. Only the main area scrolls, as in
   an app: the header and sidebar stay where they are. Page content is 1600px at most, centered; the header is
   app chrome, so it spans the window beside the sidebar, the account menu in the corner. *@
<AppShell ScrollMode="ShellScroll.Main">
    <AppHeader>
        <SidebarToggle HiddenFrom="Breakpoint.Md" />
        <Box VisibleFrom="Breakpoint.Md">
            <SectionOutlet SectionName="@PageCrumbs.Section" />
        </Box>
        <Spacer />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Menu" />
        <AccountMenu />
    </AppHeader>

    <AppSidebar FullHeight Collapsible CollapseButton="true">
        <SidebarHeader>
            <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
        </SidebarHeader>
        <NavMenu>
            <NavItem Href="" Match="NavLinkMatch.All" Icon="Lucide.House">Dashboard</NavItem>
            <AuthorizeView Policy="@Policies.ViewSales">
                <NavLabel>Sales</NavLabel>
                <NavItem Href="customers" Icon="Lucide.CreditCard">Customers</NavItem>
                <NavItem Href="invoices" Icon="Lucide.FileText">Invoices</NavItem>
            </AuthorizeView>
            <AuthorizeView Policy="@Policies.ManageUsers">
                <NavLabel>Admin</NavLabel>
                <NavItem Href="admin/users" Icon="Lucide.Users">Users</NavItem>
                <NavItem Href="admin/roles" Icon="Lucide.Shield">Roles</NavItem>
                <AuthorizeView Policy="@Policies.ViewAudit" Context="audit">
                    <NavItem Href="admin/audit" Icon="Lucide.RotateCcwClock">Audit log</NavItem>
                </AuthorizeView>
            </AuthorizeView>
        </NavMenu>
        <SidebarFooter>
            <NavMenu aria-label="Account">
                <NavItem Href="Account/Manage" Icon="Lucide.Settings">Settings</NavItem>
            </NavMenu>
        </SidebarFooter>
    </AppSidebar>

    @* A list page fills the main area (its top element has Grow), and its grid scrolls its own rows. *@
    <AppMain ContentWidth="Length.Rem(100)" PaddingY="new() { Base = 6, Md = 8 }">
        <ErrorGuard ShowDetails="DetailedErrors">
            @Body
        </ErrorGuard>
    </AppMain>
</AppShell>

<ToastRegion />

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");
}
