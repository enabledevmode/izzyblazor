// The free team grid: the people behind the product, written into the project as a component you
// own (Components/Blocks/Team.razor) and added at the end of a page, such as About.
{
  "id": "team",
  "name": "Team",
  "kind": "block",
  "tier": "account",
  "writes": ["Components/Blocks/Team.razor"],
  "category": "Team",
  "summary": "The people behind the product: a photo or initials, a name and a role for each, and a link to open roles.",
  "components": ["Section", "SectionHeader", "Container", "Column", "Grid", "Avatar", "TextBlock", "Anchor", "Icon"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "full", "Auto": "full" },
  "parameters": {
    "type": "object",
    "properties": {
      "Title": { "type": "string", "default": "The people behind {{ProjectName}}", "x-priority": "important", "description": "The section's heading." },
      "Lead": { "type": "string", "default": "A small team in four countries, working on one product.", "description": "The sentence under the heading. Empty leaves it out." },
      "HiringText": { "type": "string", "default": "We're hiring: see open roles", "description": "A link under the people. Empty leaves it out." },
      "HiringHref": { "type": "string", "default": "careers", "description": "Where the link goes." },
      "Name": { "title": "Component name", "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "default": "Team", "description": "The component's name." },
      "Into": { "title": "Page to place it on", "type": "string", "default": "Components/Pages/Home.razor", "description": "The page it's added to, at the end." }
    }
  },
  "computed": {
    "HasLead": "Lead != \"\"",
    "HasHiring": "HiringText != \"\""
  },
  "accessibility": [
    "The section is named by its heading, an h2. The people are a list, so screen readers say how many there are.",
    "The photos are decorative: each person's name is written under it."
  ],
  "variations": [
    { "key": "hiring", "label": "Hiring link", "setting": "HiringText", "options": { "On": "We're hiring: see open roles", "Off": "" } }
  ],
  "preview": { "HiringHref": "#" },
  "inserts": [
    { "file": "{{Into}}", "position": "end", "place": true, "text": "\n<{{Name}} />\n" },
    { "file": "Components/_Imports.razor", "anchor": "@using {{UiNamespace}}", "position": "after", "text": "@using {{UiNamespace}}.Blocks\n" }
  ]
}
