<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/izzyblazor.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["{{ProjectName}}.styles.css"]" />
    @* The theme: a preset, a brand color and fonts, set on the server so it applies on first paint. See https://izzyblazor.com/docs/theming *@
    @*#if (Preset == "Standard" && Brand == "") *@
    <IzzyTheme />
    @*#elif (Brand == "") *@
    <IzzyTheme Preset="ThemePreset.{{Preset}}" />
    @*#elif (Preset == "Standard") *@
    <IzzyTheme Brand="{{Brand}}" />
    @*#else *@
    <IzzyTheme Preset="ThemePreset.{{Preset}}" Brand="{{Brand}}" />
    @*#endif *@
    <ImportMap />
    @*#if (SampleContent) *@
    <link rel="icon" type="image/png" href="favicon.png" />
    @*#endif *@
    @*#if (!InteractiveAtRoot) *@
    <HeadOutlet />
    @*#else *@
    <HeadOutlet @rendermode="PageRenderMode" />
    @*#endif *@
</head>

<body>
    @*#if (!InteractiveAtRoot) *@
    <Routes />
    @*#else *@
    <Routes @rendermode="PageRenderMode" />
    @*#endif *@
    @*#if (UseServer) *@
    <ReconnectDialog />
    @*#endif *@
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @*#if (IndividualLocalAuth) *@
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    @*#endif *@
</body>

</html>
@*#if (InteractiveAtRoot) *@

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Every page is interactive except those marked [ExcludeFromInteractiveRouting], such as the
    // account pages: they set cookies, which needs the HTTP response.
@*#if (UseServer && UseWebAssembly) *@
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveAuto : null;
@*#elif (UseServer) *@
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
@*#else *@
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveWebAssembly : null;
@*#endif *@
}
@*#endif *@
