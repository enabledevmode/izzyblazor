@page "/not-found"
@layout MainLayout

<PageTitle>Not found</PageTitle>

@* A page that's only a message: centered in a narrow column, a tinted icon, the title, what
   happened, and the one way on (full width on phones). *@
<Container Size="ContainerSize.Xs" Align="ContainerAlign.Center" MaxWidth="Length.Rem(27.5)" Gutters="false" MarginTop="new() { Base = 0, Md = 12 }">
    <EmptyState Size="ControlSize.Lg" Icon="Lucide.Compass" TitleLevel="1" Title="Page not found"
                Description="There's nothing at this address.">
        <EmptyStateActions>
            <Button Href="" Width="new() { Base = Length.Percent(100), Sm = Length.Auto }" MinWidth="Length.Rem(12.5)">Go to the home page</Button>
        </EmptyStateActions>
    </EmptyState>
</Container>
