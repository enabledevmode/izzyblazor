// The free announcement bar: one line of news across the top of every page, written into the
// project as a component you own (Components/Blocks/Announcement.razor) and placed in MainLayout,
// above the header.
{
  "id": "announcement",
  "name": "Announcement bar",
  "kind": "block",
  "category": "Banners",
  "summary": "One line of news across the top of every page, with a link and a close button that's remembered.",
  "components": ["Banner", "Badge", "Anchor"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "full", "Auto": "full" },
  "parameters": {
    "type": "object",
    "properties": {
      "Text": { "type": "string", "default": "Invoices are here: bill customers in four steps.", "x-priority": "important", "description": "The news, in one sentence: on phones it wraps to two lines at most." },
      "LinkText": { "type": "string", "default": "Read the announcement", "description": "A link after the sentence. Empty leaves it out." },
      "LinkHref": { "type": "string", "default": "blog/invoices", "description": "Where the link goes." },
      "Key": { "type": "string", "default": "invoices-2026-11", "description": "Names this announcement: closing it is remembered under this key, so change it for the next one." },
      "Name": { "type": "string", "default": "Announcement", "description": "The component's name." },
      "Into": { "type": "string", "default": "Components/Layout/MainLayout.razor", "description": "The layout it's placed in, above its AppHeader." }
    }
  },
  "computed": {
    "HasLink": "LinkText != \"\""
  },
  "accessibility": [
    "It's a region landmark named \"Announcement\", so screen readers can find it and skip it.",
    "The close button is named \"Dismiss announcement\"; with script, focus moves on when it closes.",
    "On a solid primary strip the text and link take the strip's own text color, so they keep their contrast."
  ],
  "variations": [
    { "key": "link", "label": "Link", "setting": "LinkText", "options": { "On": "Read the announcement", "Off": "" } }
  ],
  "preview": { "LinkHref": "blocks/announcement", "Key": "docs-preview" },
  "inserts": [
    { "file": "{{Into}}", "pattern": "<AppHeader", "position": "before", "place": true, "text": "    <{{Name}} />\n" },
    { "file": "Components/_Imports.razor", "anchor": "@using {{RootNamespace}}.Components", "position": "after", "text": "@using {{RootNamespace}}.Components.Blocks\n" }
  ]
}
