@* One line of news across the top of every page, from izzy add announcement. It's yours: change
   the words below. It sits in MainLayout above the header. Closing it is remembered by its key, so
   a new announcement (a new RememberKey) shows again to everyone who closed the last one. *@
<Banner Status="Status.Neutral" Accent="Accent.Primary" Variant="AlertVariant.Solid" HideIcon Center Dismissible
        Remember="DismissMemory.Persistent" RememberKey="{{Key}}" DismissLabel="Dismiss announcement">
    <Badge Pill Size="BadgeSize.Sm" MarginEnd="1">New</Badge> {{Text}}
    @*#if (HasLink) *@
    <Anchor Href="{{LinkHref}}" Style="white-space: nowrap">{{LinkText}}</Anchor>
    @*#endif *@
</Banner>
