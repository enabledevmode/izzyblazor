@*#if (Routable) *@
@page "/Account/AccessDenied"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Routing.Patterns
@using Microsoft.AspNetCore.Routing.Template
@inject EndpointDataSource Endpoints
@inject IInlineConstraintResolver Constraints

<PageTitle>Access denied</PageTitle>

@*#endif *@
@* Where sign-in sends someone who is signed in but lacks the role a page needs, from izzy add
   access-denied. Centered, as the other one-message pages: what happened, which role it needs and
   who can give it, the one way on, then the usual cause, the wrong account. *@
@*#if (Routable) *@
<Container Size="ContainerSize.Xs" Align="ContainerAlign.Center" MaxWidth="Length.Rem(27.5)" Gutters="false" MarginTop="new() { Base = 0, Md = 12 }" PaddingTop="new() { Base = 12, Md = 16 }">
@*#else *@
@* The docs preview: the stack in the middle of its frame. *@
<Container Size="ContainerSize.Xs" Align="ContainerAlign.Center" MaxWidth="Length.Rem(27.5)" Gutters="false" PaddingY="12">
@*#endif *@
    <Column Gap="5">
        <EmptyState Size="ControlSize.Lg" Padding="0" Status="Status.Warning" Icon="Lucide.Lock" TitleLevel="1" Title="You don't have access to this page"
                    Description="@Message">
            <EmptyStateActions>
@*#if (Routable) *@
                <Button Href="" Width="new() { Base = Length.Percent(100), Sm = Length.Auto }" MinWidth="Length.Rem(12.5)">Go to the home page</Button>
@*#else *@
                <Button Href="#" Width="new() { Base = Length.Percent(100), Sm = Length.Auto }" MinWidth="Length.Rem(12.5)">Go to the home page</Button>
@*#endif *@
            </EmptyStateActions>
        </EmptyState>
        @if (SignedInAs is not null)
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">
@*#if (Routable) *@
                Signed in as @SignedInAs. <Button Submit Form="switch-account" Variant="ButtonVariant.Link" Accent="Accent.Neutral">Switch account</Button>
@*#else *@
                Signed in as @SignedInAs. <Button Href="#" Variant="ButtonVariant.Link" Accent="Accent.Neutral">Switch account</Button>
@*#endif *@
            </TextBlock>
@*#if (Routable) *@
            @* Switch account: sign out, then sign in again and go back to the page. *@
            <form id="switch-account" action="Account/Logout" method="post" hidden>
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@($"Account/Login?ReturnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}")" />
            </form>
@*#endif *@
        }
    </Column>
</Container>

@code {
@*#if (Routable) *@
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The page they were turned away from, as sign-in passes it.
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? SignedInAs => HttpContext?.User.Identity?.Name;

    private IReadOnlyList<IReadOnlyList<string>> Roles => RolesFor(ReturnUrl);
@*#else *@
    // The docs preview has no one signed in: the design's sample.
    private string? SignedInAs => "ada@example.com";

    private IReadOnlyList<IReadOnlyList<string>> Roles => [["Admin"]];
@*#endif *@

    // Each [Authorize] names roles any one of which will do, and the page needs every [Authorize]:
    // "It needs the Admin or Owner role", "It needs the Staff role and the Billing role".
    private string Message => Roles.Count == 0
        ? "Ask an admin on your team to give it to you."
        : $"It needs {string.Join(" and ", Roles.Select(any => $"the {string.Join(" or ", any)} role"))}. Ask an admin on your team to give it to you.";
@*#if (Routable) *@

    // The roles the page at that address asks for in [Authorize(Roles = "...")], one list for each
    // [Authorize]; none when it asks for a policy instead, or the address matches no page. The page is
    // the route that routing would pick: the most specific one whose constraints the address meets.
    private IReadOnlyList<IReadOnlyList<string>> RolesFor(string? returnUrl)
    {
        if (string.IsNullOrEmpty(returnUrl) || !Uri.TryCreate(new Uri("http://app/"), returnUrl.TrimStart('~'), out var uri))
        {
            return [];
        }
        var path = PathString.FromUriComponent(uri);
        if (HttpContext is { } context && path.StartsWithSegments(context.Request.PathBase, out var rest))
        {
            path = rest;
        }
        var routes = Endpoints.Endpoints.OfType<RouteEndpoint>()
            .Select(endpoint => (Endpoint: endpoint, Template: new RouteTemplate(endpoint.RoutePattern)))
            .OrderBy(route => route.Endpoint.Order)
            .ThenBy(route => RoutePrecedence.ComputeInbound(route.Template));
        foreach (var (endpoint, template) in routes)
        {
            var values = new RouteValueDictionary();
            if (new TemplateMatcher(template, new RouteValueDictionary()).TryMatch(path, values) && Meets(endpoint.RoutePattern, values))
            {
                return endpoint.Metadata.GetOrderedMetadata<IAuthorizeData>()
                    .Select(a => a.Roles?.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries) ?? [])
                    .Where(any => any.Length > 0)
                    .Select(any => (IReadOnlyList<string>)any)
                    .ToList();
            }
        }
        return [];
    }

    // Whether the address's values meet the route's constraints, such as {Id:int}.
    private bool Meets(RoutePattern pattern, RouteValueDictionary values)
    {
        foreach (var (name, policies) in pattern.ParameterPolicies)
        {
            if (!values.ContainsKey(name))
            {
                continue;
            }
            foreach (var policy in policies)
            {
                var constraint = policy.ParameterPolicy as IRouteConstraint ?? (policy.Content is { } content ? Constraints.ResolveConstraint(content) : null);
                if (constraint is not null && !constraint.Match(HttpContext, null, name, values, RouteDirection.IncomingRequest))
                {
                    return false;
                }
            }
        }
        return true;
    }
@*#endif *@
}
