// The free cookie consent: a notice at the bottom of the window until the visitor chooses, a
// settings page with a switch per category, and the code that saves and reads the choice, written
// into the project as code you own (CookieNotice.razor, Pages/Cookies.razor, Consent.cs). They read the
// request's cookies, so they stay in the server project when the pages are in a .Client one.
{
  "id": "cookies",
  "name": "Cookie consent",
  "kind": "block",
  "category": "Legal and privacy",
  "summary": "Ask before any cookie that isn't essential: a notice until the visitor chooses, a settings page, and a way for your code to check.",
  "components": ["Card", "Heading", "TextBlock", "Anchor", "Button", "Stack", "Grid", "Spacer", "Form", "Switch", "Row", "Column"],
  "modes": { "Static SSR": "full", "Server": "full", "WebAssembly": "partial", "Auto": "full" },
  "parameters": {
    "type": "object",
    "properties": {
      "SettingsRoute": { "type": "string", "default": "cookies", "description": "The settings page's address, without the leading slash: the footer's Cookie settings link goes here." },
      "PolicyHref": { "type": "string", "default": "privacy", "description": "Where \"Cookie policy\" goes, such as the privacy page from izzy add legal." },
      "Floating": { "type": "boolean", "default": true, "x-hidden": true, "description": "Pins the notice to the window; the docs previews show it in place." },
      "Routable": { "type": "boolean", "default": true, "x-hidden": true, "description": "Writes the settings page's route and title; the docs previews leave them out." },
      "Name": { "type": "string", "default": "CookieNotice", "description": "The notice's component name." },
      "PageName": { "type": "string", "default": "Cookies", "description": "The settings page's component name." },
      "Into": { "type": "string", "default": "Components/Layout/MainLayout.razor", "description": "The layout the notice is placed in, at the end of its AppShell. When every page runs in the browser, it goes in App.razor after Routes instead, rendered on the server." }
    }
  },
  "accessibility": [
    "The notice is a region named by its heading, so screen readers can find it; it doesn't block the page or take focus.",
    "Reject analytics and Accept all are the same size and style, so rejecting is as easy as accepting.",
    "On the settings page each switch is named by its category; Essential is on and can't be turned off, and says so."
  ],
  "preview": { "Floating": "false", "Routable": "false", "SettingsRoute": "#", "PolicyHref": "#" },
  "server": ["Components/**"],
  "checks": [
    {
      "file": "Components/App.razor", "pattern": "<Routes\\s+@rendermode=\"Interactive",
      "message": "App.razor makes every page interactive, so the settings page, which is static to save the visitor's choice in a cookie, shows Not found. Give Routes and HeadOutlet a render mode that's null for pages marked [ExcludeFromInteractiveRouting], as a new blazor app does: @rendermode=\"PageRenderMode\" with PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null."
    }
  ],
  "inserts": [
    { "file": "{{Into}}", "pattern": "</AppShell>", "position": "before", "place": true, "if": "!LayoutInBrowser", "text": "    <{{Name}} />\n" },
    { "file": "Components/App.razor", "pattern": "<Routes[\\s/>]", "position": "after", "place": true, "if": "LayoutInBrowser", "text": "<{{Name}} />\n" },
    { "file": "Program.cs", "anchor": "app.Run();", "position": "before", "text": "app.MapConsent();\n\n" },
    { "file": "Components/_Imports.razor", "anchor": "@using {{RootNamespace}}.Components", "position": "after", "text": "@using {{RootNamespace}}.Components.Blocks\n" }
  ]
}
