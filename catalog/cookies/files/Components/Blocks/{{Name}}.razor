@implements IDisposable
@inject NavigationManager Navigation
@inject PersistentComponentState State

@* Asks before anything that isn't essential, from izzy add cookies: a card at the bottom of the
   window (a sheet on phones) until the visitor chooses. Rejecting is as easy as accepting. The
   buttons post to /consent (Consent.cs), so it works on every page, with or without script. *@
@if (Show)
{
    @*#if (Floating) *@
    <Card Pinned Variant="CardVariant.Outline" Shadow="Shadow.Lg" role="region" aria-labelledby="{{Name}}-title">
    @*#else *@
    <Card Variant="CardVariant.Outline" Shadow="Shadow.Lg" MaxWidth="Length.Rem(30)" role="region" aria-labelledby="{{Name}}-title">
    @*#endif *@
        <CardBody Gap="3">
            <Heading Level="2" id="{{Name}}-title" Size="TextSize.Md">Cookies on {{ProjectName}}</Heading>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                We use essential cookies to keep you signed in. With your OK, we'd also use analytics cookies to learn how {{ProjectName}} is used.
                <TextBlock As="span" Color="Color.OnSurface"><Anchor Href="{{PolicyHref}}" InheritColor>Cookie policy</Anchor></TextBlock>
            </TextBlock>
            @*#if (Routable) *@
            <form method="post" action="consent">
                <AntiforgeryToken />
            @*#else *@
            @* The docs preview has no /consent: its buttons only reload the preview. *@
            <form method="get" action="">
            @*#endif *@
                @*#if (!LayoutInBrowser) *@
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                @*#endif *@
                @* Phones: the two choices side by side, then Choose cookies under them at full width. *@
                <Stack Direction="new() { Base = Direction.ColumnReverse, Sm = Direction.Row }" Gap="2" Align="new() { Base = Align.Stretch, Sm = Align.Center }" MarginTop="1">
                    <Button Href="@SettingsHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral">Choose cookies</Button>
                    <Spacer />
                    <Grid Columns="2" Gap="2">
                        <Button Submit Name="choice" Value="reject" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Reject analytics</Button>
                        <Button Submit Name="choice" Value="accept" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Accept all</Button>
                    </Grid>
                </Stack>
            </form>
        </CardBody>
    </Card>
}
@*#if (!Routable) *@
else
{
    @* The docs preview: what the visitor chose, as the real notice would leave it, and a way back. *@
    <TextBlock Size="TextSize.Sm" Color="Color.Muted">
        @(Choice == "accept" ? "Accepted all cookies." : "Rejected analytics cookies.") The notice won't show again.
        <Anchor Href="@Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["choice"] = null, ["returnUrl"] = null })">Show it again</Anchor>
    </TextBlock>
}
@*#endif *@

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Decided on the server while the page renders, and handed to an interactive render after it.
    private bool Show { get; set; }

    private PersistingComponentStateSubscription _persisting;

    private string ReturnUrl => "~/" + Navigation.ToBaseRelativePath(Navigation.Uri);

@*#if (LayoutInBrowser) *@
    // Rendered once per full load, outside the pages that run in the browser: the address it was rendered at
    // isn't where the visitor is now, so there's no return address and /consent goes back to the posting page.
    private string SettingsHref => "{{SettingsRoute}}";
@*#else *@
    private string SettingsHref => "{{SettingsRoute}}?returnUrl=" + Uri.EscapeDataString(ReturnUrl);
@*#endif *@

    protected override void OnInitialized()
    {
@*#if (Routable) *@
        if (State.TryTakeFromJson<bool>("{{Name}}", out var shown))
        {
            Show = shown;
        }
        // Not on the settings page itself: it asks the same thing in full.
        else if (HttpContext is not null)
        {
            Show = !Consent.Chosen(HttpContext) && !Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("{{SettingsRoute}}", StringComparison.OrdinalIgnoreCase);
        }
@*#else *@
        Show = Choice is null;
@*#endif *@
        // A method of this component, not [PersistentState]: Blazor then skips it when the notice is static,
        // where [PersistentState] throws in an app with both Server and WebAssembly.
        _persisting = State.RegisterOnPersisting(PersistShow);
    }

    private Task PersistShow()
    {
        State.PersistAsJson("{{Name}}", Show);
        return Task.CompletedTask;
    }

    public void Dispose() => _persisting.Dispose();
@*#if (!Routable) *@

    // The docs preview's buttons put the choice in the address instead of posting it.
    [SupplyParameterFromQuery(Name = "choice")]
    private string? Choice { get; set; }
@*#endif *@
}
