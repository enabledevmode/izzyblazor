@*#if (Routable) *@
@page "/{{SettingsRoute}}"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Cookie settings</PageTitle>

@*#endif *@
@inject NavigationManager Navigation
@inject ToastService Toasts

@* Every cookie choice, from izzy add cookies: a card and a switch per category, everything but
   Essential off until the visitor chooses. A static page, since it writes the consent cookie
   (Consent.cs). The cookie notice's Choose cookies and the footer's Cookie settings come here. *@
<Column Gap="new() { Base = 6, Md = 8 }" MaxWidth="Length.Rem(42.5)" PaddingTop="new() { Base = 2, Md = 6 }" PaddingBottom="new() { Base = 12, Md = 16 }">
    <Column Gap="2">
        <Heading Level="1" Size="TextSize.Xl4" MinSize="TextSize.Xl3">Cookie settings</Heading>
        <TextBlock Color="Color.Muted">
            Choose which cookies {{ProjectName}} can use. You can change this any time from the link in the footer.
            <TextBlock As="span" Color="Color.OnSurface"><Anchor Href="{{PolicyHref}}" InheritColor>Cookie policy</Anchor></TextBlock>
        </TextBlock>
    </Column>
    <Form Model="Model" FormName="cookie-settings" OnValidSubmit="Save" Gap="4">
        <Card Variant="CardVariant.Outline">
            <Row Gap="4" Align="Align.Start">
                <Column Gap="1" Grow>
                    <Heading Level="2" Size="TextSize.Md">Essential</Heading>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Keep you signed in, remember your settings and protect the site from abuse. The site can't work without them.</TextBlock>
                </Column>
                <Column Gap="1" Align="Align.End" Shrink="false">
                    <Switch @bind-Value="Model!.Essential" Label="Essential" HideLabel Disabled />
                    <TextBlock Size="TextSize.Xs" Color="Color.Muted">Always on</TextBlock>
                </Column>
            </Row>
        </Card>
        <Card Variant="CardVariant.Outline">
            <Row Gap="4" Align="Align.Start">
                <Column Gap="1" Grow>
                    <Heading Level="2" Size="TextSize.Md">Analytics</Heading>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Count visits and see which features are used, so we can improve {{ProjectName}}. No data is sold or used for ads.</TextBlock>
                </Column>
                <Switch @bind-Value="Model!.Analytics" Label="Analytics" HideLabel Shrink="false" />
            </Row>
        </Card>
        <Card Variant="CardVariant.Outline">
            <Row Gap="4" Align="Align.Start">
                <Column Gap="1" Grow>
                    <Heading Level="2" Size="TextSize.Md">Preferences</Heading>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Remember choices like your language and color scheme on this device.</TextBlock>
                </Column>
                <Switch @bind-Value="Model!.Preferences" Label="Preferences" HideLabel Shrink="false" />
            </Row>
        </Card>
        @* Phones: full width, Save choices first. *@
        <Stack Direction="new() { Base = Direction.Column, Sm = Direction.Row }" Gap="3" Align="new() { Base = Align.Stretch, Sm = Align.Center }" PaddingTop="2">
            <Button Submit Name="choice" Value="save">Save choices</Button>
            <Button Submit Name="choice" Value="reject" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Reject analytics</Button>
            <Button Submit Name="choice" Value="accept" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Accept all</Button>
        </Stack>
    </Form>
</Column>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "cookie-settings")]
    private Choices? Model { get; set; }

    [SupplyParameterFromForm(Name = "choice", FormName = "cookie-settings")]
    private string? Choice { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    // The switches start from what the visitor chose before: off until they choose.
    protected override void OnInitialized() => Model ??= new()
    {
        Analytics = Consent.Allows(HttpContext, "analytics"),
        Preferences = Consent.Allows(HttpContext, "preferences"),
    };

    private void Save()
    {
        string[] allowed = Choice switch
        {
            "accept" => Consent.Categories,
            "reject" => [],
            _ => [.. Model!.Analytics ? ["analytics"] : Array.Empty<string>(), .. Model.Preferences ? ["preferences"] : Array.Empty<string>()],
        };
        Consent.Write(HttpContext!, allowed);
        Toasts.Success("You can change them here any time.", "Cookie choices saved");
        // Back to the page they came from, or this one.
        Navigation.NavigateTo(Consent.LocalPath(ReturnUrl) ?? "{{SettingsRoute}}");
    }

    public sealed class Choices
    {
        public bool Essential { get; set; } = true;
        public bool Analytics { get; set; }
        public bool Preferences { get; set; }
    }
}
