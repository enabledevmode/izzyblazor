@using System.Globalization
@*#if (Standalone) *@
@* The maintenance page, from izzy add message-page. UseMaintenance (Maintenance.cs) serves it to
   every request while maintenance is on, with status 503, and at /{{Route}} at any time so you can
   check it. It's a whole document of its own, not a routed page: it needs nothing the app may have
   stopped (no layout, no circuit, no script, no database) and it works in every render mode.
   Give its IzzyTheme the same settings as App.razor's. *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <base href="/" />
    <title>We'll be right back</title>
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/izzyblazor.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <IzzyTheme />
</head>

<body>
@*#endif *@
    @* A page that's only a message: centered in a narrow column, the tinted wrench, when it ends,
       the one way on (full width on phones), then a word that nothing is lost. *@
    <Column PaddingX="4" PaddingTop="new() { Base = 6, Md = 4 }" PaddingBottom="12">
        <Container Size="ContainerSize.Xs" Align="ContainerAlign.Center" MaxWidth="Length.Rem(27.5)" Gutters="false" MarginTop="new() { Base = 12, Md = 16 }">
            <Column Gap="5">
                <EmptyState Size="ControlSize.Lg" Padding="0" Status="Status.Info" Icon="Lucide.Wrench" TitleLevel="1" Title="We'll be right back" Description="@Message">
                    @if (!string.IsNullOrEmpty(StatusPage))
                    {
                        <EmptyStateActions>
                            <Button Href="@StatusPage" Width="new() { Base = Length.Percent(100), Sm = Length.Auto }" MinWidth="Length.Rem(12.5)">See the status page</Button>
                        </EmptyStateActions>
                    }
                </EmptyState>
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">
                    Your work is saved. Nothing you did before the break is lost.
                </TextBlock>
            </Column>
        </Container>
    </Column>
@*#if (Standalone) *@
</body>

</html>
@*#endif *@

@code {
    /// <summary>When maintenance ends, from appsettings.json; unset, the page doesn't say.</summary>
    [Parameter] public DateTimeOffset? Until { get; set; }

    /// <summary>Your status page's address; unset, there's no button.</summary>
    [Parameter] public string? StatusPage { get; set; }

    private string Message => Until is { } until && until > DateTimeOffset.UtcNow
        ? $"{{ProjectName}} is down for planned maintenance until {When(until)}, about {HowLong(until - DateTimeOffset.UtcNow)} from now."
        : "{{ProjectName}} is down for planned maintenance.";
@*#if (!Standalone) *@

    // The docs preview has no settings: it ends 45 minutes from now.
    protected override void OnParametersSet()
    {
        Until ??= DateTimeOffset.UtcNow.AddMinutes(45);
        StatusPage ??= "{{StatusPage}}";
    }
@*#endif *@

    // "03:00 UTC" today, with the date when it's another day: "Nov 16, 03:00 UTC".
    private static string When(DateTimeOffset until)
    {
        var utc = until.UtcDateTime;
        var format = utc.Date == DateTime.UtcNow.Date ? "HH:mm" : "MMM d, HH:mm";
        return utc.ToString(format, CultureInfo.InvariantCulture) + " UTC";
    }

    // Rounded up, to 5 minutes under an hour and to hours after that: "45 minutes", "2 hours".
    private static string HowLong(TimeSpan left)
    {
        if (left.TotalMinutes <= 55)
        {
            var minutes = Math.Max(5, (int)Math.Ceiling(left.TotalMinutes / 5) * 5);
            return $"{minutes} minutes";
        }
        if (left.TotalHours < 48)
        {
            var hours = (int)Math.Ceiling(left.TotalHours);
            return hours == 1 ? "1 hour" : $"{hours} hours";
        }
        return $"{(int)Math.Ceiling(left.TotalDays)} days";
    }
}
