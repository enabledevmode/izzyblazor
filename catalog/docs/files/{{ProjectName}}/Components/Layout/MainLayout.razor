@inherits LayoutComponentBase
@inject IConfiguration Configuration

@* A docs site's shell: one surface, its parts separated by lines. The sidebar lists the sections and their
   pages (DocsNav); on phones it's a drawer behind the menu button. An article puts its own "On this page"
   in the shell's aside (see Pages/Docs/WritingPages.razor); a page without one, such as Home, has no column. *@
<AppShell Variant="ShellVariant.Flat">
    <AppHeader>
        <SidebarToggle />
        <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
        <Spacer />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Menu" />
        @*#if (IndividualLocalAuth) *@
        <AccountMenu />
        @*#endif *@
    </AppHeader>

    <AppSidebar Label="Docs">
        <DocsNav />
    </AppSidebar>

    <AppMain>
        <Box PaddingX="new() { Base = 4, Md = 10, Xl = 12 }" PaddingTop="new() { Base = 6, Md = 8, Xl = 10 }" PaddingBottom="new() { Base = 10, Md = 12, Xl = 16 }">
            <ErrorGuard ShowDetails="DetailedErrors">
                @Body
            </ErrorGuard>
        </Box>
    </AppMain>
</AppShell>

<ToastRegion />
@*#if (UseServer || UseWebAssembly) *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@*#endif *@

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");
}
