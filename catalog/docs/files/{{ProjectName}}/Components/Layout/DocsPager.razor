@inject NavigationManager Navigation

@* The previous and next links at the end of an article, from the sidebar's order (DocsNav). *@
<PrevNext PreviousHref="@previous?.Href" PreviousTitle="@previous?.Title" NextHref="@next?.Href" NextTitle="@next?.Title" />

@code {
    private DocsNav.DocsPage? previous, next;

    protected override void OnParametersSet()
    {
        var pages = DocsNav.Sections.SelectMany(section => section.Pages).ToList();
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
        var index = pages.FindIndex(page => string.Equals(page.Href, path, StringComparison.OrdinalIgnoreCase));
        previous = index > 0 ? pages[index - 1] : null;
        next = index >= 0 && index < pages.Count - 1 ? pages[index + 1] : null;
    }
}
