@implements IDisposable
@inject NavigationManager NavigationManager

@* At the end of the header on phones, where the sidebar's account row (in MainLayout) doesn't show. Signed in:
   your avatar, opening the account menu (AccountMenuItems). Signed out: Log in; Register is at the foot of
   the drawer. The log out form is here, at every width, for both menus. *@
<AuthorizeView>
    <Authorized>
        <Menu Placement="Placement.BottomEnd" HiddenFrom="Breakpoint.Md">
            <Trigger Context="trigger">
                <IconButton Label="Account" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger">
                    <Avatar Name="@context.User.Identity?.Name" Size="AvatarSize.Sm" Decorative />
                </IconButton>
            </Trigger>
            <ChildContent>
                <AccountMenuItems />
            </ChildContent>
        </Menu>
        <form id="logout-form" action="Account/Logout" method="post" hidden>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </form>
    </Authorized>
    <NotAuthorized>
        <Button Href="Account/Login" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" HiddenFrom="Breakpoint.Md">Log in</Button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
