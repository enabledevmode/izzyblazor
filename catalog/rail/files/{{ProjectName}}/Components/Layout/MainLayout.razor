@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Sections
@inject IConfiguration Configuration

@*#if (PlainShell) *@
<AppShell>
@*#else *@
<AppShell Variant="ShellVariant.{{Shell}}">
@*#endif *@
    @* The header beside the sidebar: the button that collapses it to a rail (on phones, opens it as a drawer),
       the page's title, the color scheme and, on phones, the brand and your account. *@
    <AppHeader>
        <SidebarToggle />
        <Divider Orientation="Orientation.Vertical" Height="Length.Rem(1.25)" AlignSelf="Align.Center" VisibleFrom="Breakpoint.Md" />
        <TextBlock Size="TextSize.Sm" Color="Color.Muted" VisibleFrom="Breakpoint.Md"><SectionOutlet SectionName="page-title" /></TextBlock>
        <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" HiddenFrom="Breakpoint.Md" />
        <Spacer />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Menu" />
        @*#if (IndividualLocalAuth) *@
        <AccountMenu />
        @*#endif *@
    </AppHeader>

    @* The sidebar runs the height of the window. Collapsed, its links are icons with their text as tooltips;
       the choice is kept in a cookie. *@
    <AppSidebar FullHeight Collapsible>
        <SidebarHeader>
            <AppBrand Href="" Icon="Lucide.Box" Label="{{ProjectName}}" />
        </SidebarHeader>
        <NavMenu>
            <NavItem Href="" Match="NavLinkMatch.All" Icon="Lucide.House">Home</NavItem>
        </NavMenu>
        @*#if (IndividualLocalAuth) *@
        <SidebarFooter>
            <AuthorizeView>
                <Authorized>
                    @* Your account, from 768px up; on phones the header's avatar opens the same menu. *@
                    <SidebarAccount Name="@(context.User.Identity?.Name ?? "Account")" VisibleFrom="Breakpoint.Md">
                        <AccountMenuItems />
                    </SidebarAccount>
                </Authorized>
                <NotAuthorized>
                    <Row Gap="2" VisibleFrom="Breakpoint.Md" Class="ib-collapsed-hide">
                        <Button Href="Account/Login" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" Grow>Log in</Button>
                        @*#if (Registration) *@
                        <Button Href="Account/Register" Size="ControlSize.Sm" Grow>Register</Button>
                        @*#endif *@
                    </Row>
                    @* In the rail: one button; the log-in page links to Register. *@
                    @*#if (Registration) *@
                    <Box Class="ib-collapsed-show">
                        <Tooltip Text="Log in or register" Placement="Placement.End">
                            <IconButton Href="Account/Login" Icon="Lucide.LogIn" Label="Log in" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" />
                        </Tooltip>
                    </Box>
                    @*#else *@
                    <Box Class="ib-collapsed-show">
                        <Tooltip Text="Log in" Placement="Placement.End">
                            <IconButton Href="Account/Login" Icon="Lucide.LogIn" Label="Log in" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" />
                        </Tooltip>
                    </Box>
                    @*#endif *@
                    @*#if (Registration) *@
                    @* On phones the header keeps Log in; Register is at the foot of the drawer. *@
                    <Column Gap="2" HiddenFrom="Breakpoint.Md">
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">New here?</TextBlock>
                        <Button Href="Account/Register" FullWidth>Register</Button>
                    </Column>
                    @*#endif *@
                </NotAuthorized>
            </AuthorizeView>
        </SidebarFooter>
        @*#endif *@
    </AppSidebar>

    @*#if (WidthOnMain) *@
    <AppMain ContentWidth="Length.Rem({{ContentWidth}})">
    @*#else *@
    <AppMain>
    @*#endif *@
        @* With a content width, the shell's column already has a gutter that lines the page up with
           the header, so the page adds space above and below only; otherwise it pads every side. *@
        @*#if (WidthOnShell || WidthOnMain) *@
        <Box PaddingY="new() { Base = 6, Md = 10 }">
        @*#else *@
        <Box PaddingX="new() { Base = 4, Md = 10 }" PaddingY="new() { Base = 6, Md = 10 }">
        @*#endif *@
            <ErrorGuard ShowDetails="DetailedErrors">
                @Body
            </ErrorGuard>
        </Box>
    </AppMain>
</AppShell>

<ToastRegion />
@*#if (UseServer || UseWebAssembly) *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@*#endif *@

@code {
    // A page that throws shows an alert in its place; the exception itself only where
    // DetailedErrors is on, as appsettings.Development.json sets it.
    private bool DetailedErrors => Configuration.GetValue<bool>("DetailedErrors");
}
