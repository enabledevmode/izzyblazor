// Collapsible sidebar app: a sidebar the full height of the window, with the brand at its top and the account at
// its foot, that collapses to an icon rail; the header beside it holds the page's title. Made over the blazor starter,
// with the welcome page as its Home. Design: artifacts/izzyblazor-handoff-starters.md (ST3).
{
  "id": "rail",
  "name": "Collapsible sidebar app",
  "kind": "starter",
  "tier": "account",
  "category": "Starters",
  "summary": "An app shell with a full-height sidebar that collapses to an icon rail, the brand at its top and the account at its foot.",
  "components": ["SidebarAccount", "SidebarToggle", "Tooltip"],
  "base": {
    "item": "blazor",
    "fixed": { "Starter": "Collapsible sidebar app", "Nav": "Sidebar", "Empty": "false" }
  },
  "computed": { "HeaderTitle": "true" },
  // The account menu's items are only there with accounts.
  "exclude": [
    { "if": "!IndividualLocalAuth", "paths": ["{{ProjectName}}/Components/Layout/AccountMenuItems.razor"] }
  ],
  "screens": [
    {"file": "home", "caption": "Sidebar open", "alt": "The home page with the full-height sidebar open"},
    {"file": "collapsed", "caption": "Sidebar collapsed", "alt": "The home page with the sidebar collapsed to a rail of icons"},
    {"file": "phone-home", "caption": "Home on a phone", "alt": "The home page at a phone's width", "phone": true}
  ]
}
