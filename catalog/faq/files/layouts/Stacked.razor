@* The questions that stop people signing up, from izzy add faq. It's yours: change the questions
   and answers below (links are fine in an answer). Five to eight read well. *@
<Section Spacing="SectionSpacing.Lg" aria-labelledby="{{Name}}-title">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        @* Centered from 768px up; on phones everything starts at the edge, like the answers. *@
        <Column Gap="8" Align="new() { Base = Align.Start, Md = Align.Center }">
            @*#if (HasLead) *@
            <SectionHeader Title="{{Title}}" TitleId="{{Name}}-title" Description="{{Lead}}" Align="new() { Base = TextAlign.Start, Md = TextAlign.Center }" AlignSelf="Align.Stretch" />
            @*#else *@
            <SectionHeader Title="{{Title}}" TitleId="{{Name}}-title" Align="new() { Base = TextAlign.Start, Md = TextAlign.Center }" AlignSelf="Align.Stretch" />
            @*#endif *@
            <Container Size="ContainerSize.Md" Gutters="false">
                @*#if (Exclusive) *@
                <Accordion Variant="AccordionVariant.Flush" Size="ControlSize.Lg" Exclusive>
                @*#else *@
                <Accordion Variant="AccordionVariant.Flush" Size="ControlSize.Lg">
                @*#endif *@
                    @*#if (OpenFirst) *@
                    <AccordionItem Title="How does the free plan work?" Open>
                    @*#else *@
                    <AccordionItem Title="How does the free plan work?">
                    @*#endif *@
                        <TextBlock Color="Color.Muted">Starter is free for up to three people and one project, for as long as you like. Upgrade when you need more, and your work comes with you.</TextBlock>
                    </AccordionItem>
                    <AccordionItem Title="Can I cancel any time?">
                        <TextBlock Color="Color.Muted">Yes. Cancel from your account settings and you won't be charged again. You keep access until the end of the period you paid for.</TextBlock>
                    </AccordionItem>
                    <AccordionItem Title="Do you offer discounts for nonprofits and schools?">
                        <TextBlock Color="Color.Muted">Yes, 50% off any paid plan. <Anchor Href="{{ContactHref}}">Contact us</Anchor> with a link to your organization.</TextBlock>
                    </AccordionItem>
                    <AccordionItem Title="Where is my data stored?">
                        <TextBlock Color="Color.Muted">In data centers in the EU or the US, your choice, encrypted at rest and in transit.</TextBlock>
                    </AccordionItem>
                    <AccordionItem Title="How do I get help?">
                        <TextBlock Color="Color.Muted">Email support on every paid plan, usually answered within the hour on weekdays.</TextBlock>
                    </AccordionItem>
                </Accordion>
            </Container>
            @*#if (HasContact) *@
            <Column Gap="1" Align="new() { Base = Align.Start, Md = Align.Center }">
                <TextBlock Color="Color.Muted">{{ContactPrompt}}</TextBlock>
                <TextBlock Weight="FontWeight.Medium"><Anchor Href="{{ContactHref}}" Underline="AnchorUnderline.Hover">{{ContactText}} <Icon Name="Lucide.ArrowRight" /></Anchor></TextBlock>
            </Column>
            @*#endif *@
        </Column>
    </Container>
</Section>
