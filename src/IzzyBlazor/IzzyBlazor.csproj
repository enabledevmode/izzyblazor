<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The package server apps install. It adds the pieces that need the ASP.NET Core server (the
    request's cookies) to IzzyBlazor.Core, which holds every component, the CSS and the JS and
    also runs in WebAssembly.
  -->
  <PropertyGroup>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageId>IzzyBlazor</PackageId>
    <Description>Blazor components. No circuit required. 150+ open-source components for every render mode: static SSR, Interactive Server, WebAssembly and Auto. Install this in server apps; WebAssembly (.Client) projects reference IzzyBlazor.Core.</Description>
    <PackageTags>blazor;components;ssr;static-ssr;interactive-server;webassembly;datagrid;charts;ui;design-system</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\IzzyBlazor.Core\IzzyBlazor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IzzyBlazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\brand\nuget\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)docs\nuget-readme.md" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>

</Project>
