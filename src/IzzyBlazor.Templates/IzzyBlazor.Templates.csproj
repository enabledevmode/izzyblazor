<Project Sdk="Microsoft.NET.Sdk">

  <!-- The dotnet new package: after it builds, this program exports each starter in /catalog as a template
       folder (TemplateExport), and packing puts those folders under content/. The program itself isn't shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>IzzyBlazor.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Title>IzzyBlazor templates</Title>
    <Description>dotnet new templates for IzzyBlazor: Microsoft's Blazor Web App with IzzyBlazor's components and theme, in every render mode.</Description>
    <PackageTags>blazor;templates;dotnet-new;izzyblazor;components</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- Packed with the solution; release.yml pushes it after IzzyBlazor and IzzyBlazor.Core. -->
    <IsPackable>true</IsPackable>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <CatalogDir Condition="'$(CatalogDir)' == ''">$(RepoRoot)catalog</CatalogDir>
    <TemplatesOut>$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)templates</TemplatesOut>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IzzyBlazor.Generation\IzzyBlazor.Generation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- izzy-blazor is ported from Microsoft's template (MIT); its notice ships with the package. -->
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)docs/nuget-readme-templates.md" Pack="true" PackagePath="\README.md" Visible="false" />
    <None Include="$(RepoRoot)brand/nuget/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <Target Name="ExportTemplates" AfterTargets="Build">
    <RemoveDir Directories="$(TemplatesOut)" />
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(CatalogDir)&quot; &quot;$(TemplatesOut)&quot;" />
  </Target>

  <Target Name="PackTemplates" BeforeTargets="_GetPackageFiles" DependsOnTargets="ExportTemplates">
    <ItemGroup>
      <!-- NuGet adds each file's folder under content/ itself (RecursiveDir). -->
      <None Include="$(TemplatesOut)/**/*" Pack="true" PackagePath="content/" />
    </ItemGroup>
  </Target>

</Project>
