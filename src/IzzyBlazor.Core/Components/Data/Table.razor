@namespace IzzyBlazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits DataViewBase<TItem>
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, there's no select-all checkbox, and filters apply when you press Apply, not as you type; empty filters stay in the address (?f-customer=), as with any GET form.")]

@*
    A data table that sorts and pages through the URL: column headers and page numbers are
    links that set ?sort= and ?page=, so it works on static pages with no script, survives
    reloads, and can be shared. On interactive pages the links are ordinary navigations (with
    enhanced navigation the server renders the page again) and the table follows the URL.

    Filterable columns add a filter button to their header, opening the filter in a popover; the
    active filters show as removable tags above the table. Text matches anywhere, enums and
    booleans offer a menu, dates match a day, and numbers take a range (at least, at most).
    Filters go in the URL too (?f-customer=ada, ?f-total-min=100): with no script the fields
    submit a GET form when you press Enter or Apply; with script they apply as you type. The
    table filters by column values; operators, several conditions and a filter row belong to a
    data grid.

    Bind Sort, Page or Filter (@bind-Sort, @bind-Page, @bind-Filter) on an interactive page to
    keep them in the component instead: headers and page numbers become buttons, the URL doesn't change, and the
    table sorts and pages in place, like a client-side grid. It starts from the URL's values. The
    bound Filter is the filter tree (Filter.All of a FieldFilter per filtered column); conditions
    set in C# that a column's panel can't show still apply, as tags of their own.

    Give it Items (a list, or an IQueryable that EF Core translates) and it sorts and pages them,
    or an ItemsProvider to load each page yourself: it gets a DataRequest (the range, the sort, the
    filter tree, the columns as fields) and returns a DataResult. If loading fails, the table logs
    the exception and shows "Couldn't load the rows." with Retry in place of the rows (a link to
    the same address on static pages); with Load more, the rows shown stay and the message goes
    under them.

    Paging pages by cursor, for data with no total or that pages by a token: the provider returns
    the items and a Next cursor (DataResult.Next), and the table shows First, Previous and Next
    (NextPrevious), or loads as the last row comes into view (LoadOnScroll, best with a
    MaxHeight). The cursor goes in the URL (?cursor=) beside ?page=, the page's position.
    Loading on scroll adds a page as the last row comes into view: in place on interactive pages,
    and on static pages through a "Load more" link under the rows (?page=3 shows the first three),
    which the script follows and enhanced navigation swaps in. With script off the link shows.

    Selectable adds a checkbox per row: it posts the row's ItemKey with the surrounding form, and
    @bind-SelectedKeys follows it on interactive pages. RowHref makes each row a link. Columns
    take FooterText or Footer for a footer row.

    <Table Items="orders" PageSize="10" Caption="Orders">
        <PropertyColumn Property="o => o.Customer" Sortable />
        <PropertyColumn Property="o => o.Total" Format="C" Sortable />
        <TemplateColumn Title="Status"><Badge>@context.Status</Badge></TemplateColumn>
    </Table>

    Accessibility:
    - `Caption` names the table for screen readers; it isn't shown. It also names the scrolling
      area, which can be scrolled from the keyboard; with script it's a Tab stop only while it
      has something to scroll.
    - Sortable headers are links, and the sorted column has `aria-sort`.
    - Each filter button is named for its column ("Filter Customer"), and so is the field in its
      panel, by a visible label. The active filters are a group named "Filters".
    - Row checkboxes are named "Select" and the row's `RowLabel` ("Select order 1001"); without
      one, the `ItemKey`.
    - The range under the table ("1–5 of 23") is read when it changes.
    - A failed load is announced from a status region that's always in the table ("Couldn't
      load the rows."); the message shows with Retry after it. Focus stays where it was, and
      goes to the table's scroll box once Retry brings the rows.
*@

<ib-table @attributes="AdditionalAttributes" class="@_class" style="@_style" data-ib-page-key="@(HasFilters && !UseState ? PageKey : null)" data-ib-cursor-key="@(HasFilters && !UseState && CursorPaging ? CursorKey : null)" data-ib-load-on-scroll="@(Paging == DataPaging.LoadOnScroll ? "" : null)" data-ib-interactive="@(RendererInfo.IsInteractive ? "" : null)">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
        @ColumnsReadyNotifier
    </CascadingValue>
    @if (HasFilters)
    {
        var active = CurrentFilters();
        @* The active filters, which the header hides in its popovers: a removable tag each. Always
           rendered (hidden while empty): if it came and went, enhanced navigation's DOM merge would
           turn the table's scroll box into it and rebuild the table, closing the filter popover
           someone is typing in. *@
        <div class="ib-table-filter-tags" role="group" aria-label="@TextDefaults.Filters" hidden="@(active.Count + ExtraCount == 0)">
            @foreach (var column in _columns.Where(c => c.CanFilter && active.ContainsKey(c.Key!)))
            {
                var summary = FilterSummary(column, active[column.Key!]);
                <Tag Label="@($"{column.HeaderText}: {summary}")" Size="ControlSize.Sm"
                     RemoveHref="@(UseState ? null : FilterValuesHref(column, []))"
                     OnRemove="@(UseState ? EventCallback.Factory.Create(this, () => OnFilterValuesAsync(column, [])) : default)" />
            }
            @if (UseState)
            {
                @* Conditions of a bound filter that no column's panel shows, in the filter's own words. *@
                @foreach (var extra in _stateExtra)
                {
                    var condition = extra;
                    <Tag Label="@condition.ToString()" Size="ControlSize.Sm" OnRemove="@(EventCallback.Factory.Create(this, () => RemoveExtraAsync(condition)))" />
                }
            }
            @if (active.Count + ExtraCount > 0 && UseState)
            {
                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm" @onclick="ClearFiltersAsync">@TextDefaults.Clear</button>
            }
            else if (active.Count > 0)
            {
                <a href="@ClearFiltersHref" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm">@TextDefaults.Clear</a>
            }
        </div>
    }
    @ErrorStatus
    <div class="ib-table-scroll" role="region" aria-label="@(Caption ?? TextDefaults.TableName)" tabindex="0" style="@ScrollStyle" @ref="_scrollRef">
        <table class="ib-table-grid" aria-busy="@(IsLoading ? "true" : null)">
            @if (Caption is not null)
            {
                <caption class="ib-visually-hidden">@Caption</caption>
            }
            <thead>
                <tr>
                    @if (Selectable)
                    {
                        @* Select all (this page): script only; it checks the rows, which report their own changes. *@
                        <th scope="col" class="ib-table-select-cell">
                            @* The column's name while select-all is hidden (no script yet). *@
                            <span class="ib-visually-hidden ib-table-select-heading">@(SelectRowLabel ?? TextDefaults.SelectRow)</span>
                            <input type="checkbox" class="ib-check-input ib-table-select-all" aria-label="@(SelectAllLabel ?? TextDefaults.SelectAllRows)" checked="@AllOnPageSelected" />
                        </th>
                    }
                    @{ var headerFilters = HasFilters ? CurrentFilters() : null; }
                    @foreach (var column in _columns)
                    {
                        <th scope="col" class="@CellClass(column)" style="@WidthStyle(column)" aria-sort="@AriaSort(column)">
                            @if (headerFilters is not null && column.CanFilter)
                            {
                                @* The title (or sort control) and a filter button that opens the filter. *@
                                <div class="ib-table-head">
                                    @HeaderTitle(column)
                                    @HeaderFilter(column, headerFilters.GetValueOrDefault(column.Key!) ?? "")
                                </div>
                            }
                            else
                            {
                                @HeaderTitle(column)
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (_loadError is not null)
                {
                    @* In place of the rows: what went wrong and a way to try again. *@
                    <tr class="ib-table-empty ib-table-error">
                        <td colspan="@Math.Max(1, _columns.Count + (Selectable ? 1 : 0))">
                            <div class="ib-table-empty-content ib-data-error-content">
                                @LoadFailedMessage
                                @RetryControl(RetryAsync, _providerLoading)
                            </div>
                        </td>
                    </tr>
                }
                else if (_items.Count == 0 && IsLoading)
                {
                    @for (var i = 0; i < SkeletonRows; i++)
                    {
                        <tr class="ib-table-skeleton-row" aria-hidden="true">
                            @if (Selectable)
                            {
                                <td class="ib-table-select-cell"></td>
                            }
                            @foreach (var column in _columns)
                            {
                                <td class="@CellClass(column)"><span class="ib-skeleton ib-table-skeleton"></span></td>
                            }
                        </tr>
                    }
                }
                else if (_items.Count == 0)
                {
                    <tr class="ib-table-empty">
                        <td colspan="@Math.Max(1, _columns.Count + (Selectable ? 1 : 0))">
                            <div class="ib-table-empty-content">
                                @if (EmptyContent is not null)
                                {
                                    @EmptyContent
                                }
                                else
                                {
                                    @(EmptyText ?? TextDefaults.NoItems)
                                }
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @for (var index = 0; index < _items.Count; index++)
                    {
                        var row = index;
                        var item = _items[row];
                        var key = KeyOf(item);
                        var href = RowHref?.Invoke(item);
                        @* The first row of each page Load more adds can take focus, which goes to it when it arrives. *@
                        <tr class="@RowClasses(item, href)" aria-current="@(href is null ? CurrentOf(item) : null)" tabindex="@(_pageStarts.Contains(row) || row == _arriveAt ? "-1" : null)" data-ib-autofocus="@(row == _arriveAt ? "" : null)" @ref="_rowRefs[row]">
                            @if (Selectable)
                            {
                                <td class="ib-table-select-cell">
                                    <input type="checkbox" class="ib-check-input ib-table-select" name="@EffectiveSelectionName" value="@key"
                                           aria-label="@SelectLabel(item)"
                                           checked="@IsSelected(key)"
                                           @onchange="e => OnSelectChanged(key, e)" />
                                </td>
                            }
                            @{ var first = true; }
                            @foreach (var column in _columns)
                            {
                                <td class="@CellClass(column)">
                                    @if (first && href is not null)
                                    {
                                        @* One link per row, stretched over it; controls in the row stay clickable above it. *@
                                        <a class="ib-table-row-link" href="@href" aria-current="@CurrentOf(item)"><span class="ib-visually-hidden">@LabelOf(item)</span></a>
                                    }
                                    @column.Cell(item)
                                </td>
                                first = false;
                            }
                        </tr>
                    }
                }
            </tbody>
            @if (_columns.Any(c => c.HasFooter))
            {
                <tfoot>
                    <tr>
                        @if (Selectable)
                        {
                            <td class="ib-table-select-cell"></td>
                        }
                        @foreach (var column in _columns)
                        {
                            <td class="@CellClass(column)">@(column.HasFooter ? column.FooterCell : null)</td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
        @* Loading on scroll: the keyboard's way on, under the last row, inside the scroll box. *@
        @MoreRow
    </div>
    @if (HasFilters && !StateLayout)
    {
        @* The filters' GET form. Its fields join it through form="", not by nesting, so a table
           inside another form (a selection form) still works: if the browser drops this nested
           form, the filters belong to no form and never post with the outer one. *@
        <form id="@FilterFormId" method="get" action="@ActionPath" class="ib-table-filter-form"></form>
        <div class="ib-table-filter-kept">
            @foreach (var (key, value) in KeptQuery())
            {
                <input type="hidden" name="@key" value="@value" form="@FilterFormId" />
            }
        </div>
    }
    @Footer(PagesLabel)
</ib-table>

@code {
    /// <summary>The columns: <see cref="PropertyColumn{TItem, TValue}"/> and <see cref="TemplateColumn{TItem}"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The sort when the URL has none, such as <c>"name"</c> or <c>"-date"</c> (descending).</summary>
    [Parameter] public string? InitialSort { get; set; }

    /// <summary>
    /// The sort, such as <c>"name"</c> or <c>"-date"</c> (descending); null for
    /// <see cref="InitialSort"/>. Binding it (<c>@bind-Sort</c>) on an interactive page keeps sort
    /// and page in the component instead of the URL.
    /// </summary>
    [Parameter] public string? Sort { get; set; }

    /// <summary>Raised when a header is chosen, on interactive pages.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string?> SortChanged { get; set; }

    /// <summary>
    /// The filter: <c>Filter.All</c> of a condition per filtered column (contains for text, between
    /// for numbers, on day for dates, equals or in for choices), or null for none. Binding it
    /// (<c>@bind-Filter</c>) on an interactive page keeps filters, sort and page in the component
    /// instead of the URL. Set it in C#, such as
    /// <c>Filter.Where("status", FilterOperator.Equals, "Paid")</c>; a condition no column's panel
    /// can show still applies, and shows as a tag that removes it.
    /// </summary>
    [Parameter] public IzzyBlazor.Filter? Filter { get; set; }

    /// <summary>Raised when a filter changes, on interactive pages (typing waits for a pause).</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<IzzyBlazor.Filter?> FilterChanged { get; set; }

    /// <summary>The table's name for screen readers (a visually hidden caption).</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>A class for each row, such as one that highlights overdue orders.</summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>Alternating row backgrounds.</summary>
    [Parameter] public bool Striped { get; set; }

    /// <summary>A line between rows. Defaults to true; the line under the header always shows.</summary>
    [Parameter] public bool RowLines { get; set; } = true;

    /// <summary>A line between columns. Defaults to false.</summary>
    [Parameter] public bool ColumnLines { get; set; }

    /// <summary>A rounded border around the table. Defaults to true; false for a table that sits inside a card or panel.</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    /// <summary>Row height and text size. <see cref="ControlSize.Sm"/> for dense data. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>A height limit: the rows scroll and the header stays in view.</summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>
    /// Makes each row a link, such as to the item's details page. The whole row is clickable;
    /// links, buttons and checkboxes inside it still work on their own.
    /// </summary>
    [Parameter] public Func<TItem, string?>? RowHref { get; set; }

    /// <summary>
    /// The row for what the page is showing, such as the one whose details are in a panel beside the
    /// table: drawn as selected, and marked <c>aria-current</c> (on its link with <see cref="RowHref"/>).
    /// </summary>
    [Parameter] public Func<TItem, bool>? RowCurrent { get; set; }

    /// <summary>Names a row for screen readers, in its link and its checkbox. Defaults to <see cref="DataViewBase{TItem}.ItemKey"/>.</summary>
    [Parameter] public Func<TItem, string>? RowLabel { get; set; }

    private readonly List<ColumnBase<TItem>> _columns = [];
    private string? _sortKey;
    private bool _descending;
    private bool _columnsReady;
    private string? _class;
    private string? _style;
    private ElementReference _scrollRef;
    // The sort a load shaped the request with, shown once the load succeeds.
    private (string? Key, bool Descending) _shapedSort;

    /// <inheritdoc />
    internal override string ViewName => "Table";

    /// <inheritdoc />
    internal override bool ReadyToLoad => _columnsReady;

    // Sort and filters live in the component too (not the URL) on interactive pages that bind them.
    /// <inheritdoc />
    internal override bool ExtraBound => SortChanged.HasDelegate || FilterChanged.HasDelegate;

    /// <inheritdoc />
    internal override string? SortParameter => Sort;

    // The prerender of a bound interactive table leaves out the filters' GET form and its Apply
    // row, as the interactive render will: drawn, they'd go when the circuit connects and the
    // table would jump. Its links (sort, pages) still work until then.
    private bool StateLayout => WillBeInteractive && Bound;

    // A bound filter, as its columns' panel text and the conditions no panel shows. A Filter
    // parameter is split once the columns that name its fields have registered.
    private IReadOnlyDictionary<string, string> _stateFilters = new Dictionary<string, string>();
    private IReadOnlyList<IzzyBlazor.Filter> _stateExtra = [];
    private IzzyBlazor.Filter? _lastFilterParam;
    private IzzyBlazor.Filter? _reportedFilter;
    private IzzyBlazor.Filter? _unsplitFilter;
    private bool _hasUnsplitFilter;

    // The tags for a bound filter's other conditions.
    private int ExtraCount
    {
        get
        {
            StateFilters();
            return UseState ? _stateExtra.Count : 0;
        }
    }
    private CancellationTokenSource? _filterDelay;
    private string? _filterFormId;

    private bool HasFilters => _columns.Any(c => c.CanFilter);

    private string FilterFormId => _filterFormId ??= IdGenerator.Next("ib-table-filters");

    private string FilterQueryKey(ColumnBase<TItem> column) => $"{QueryPrefix}f-{column.Key}";

    // A number filter is a range: its two fields post under their own keys (?f-total-min=100),
    // so the plain GET form needs no script to put them together.
    private string MinQueryKey(ColumnBase<TItem> column) => $"{FilterQueryKey(column)}-min";

    private string MaxQueryKey(ColumnBase<TItem> column) => $"{FilterQueryKey(column)}-max";

    // Every URL key a column's filter uses. A number column's include its plain key, which it
    // no longer reads, so an old link's ?f-qty= is dropped rather than carried along.
    private IEnumerable<string> FilterQueryKeys(ColumnBase<TItem> column) => column.FilterKind == ColumnFilterKind.Number
        ? [MinQueryKey(column), MaxQueryKey(column), FilterQueryKey(column)]
        : [FilterQueryKey(column)];

    // GET replaces the query string with the form's fields, so the action is just the path.
    private string ActionPath => new Uri(Navigation.Uri).AbsolutePath;

    // Filter values from the URL, for the filterable columns.
    private Dictionary<string, string> ReadFilters()
    {
        CheckFilterKeys();
        var query = QueryString.Of(Navigation.Uri);
        var filters = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var column in _columns.Where(c => c.CanFilter))
        {
            var values = query.GetValueOrDefault(FilterQueryKey(column));
            var text = column.FilterKind == ColumnFilterKind.Number
                ? ColumnFilter.JoinRange(query.GetValueOrDefault(MinQueryKey(column)).ToString(), query.GetValueOrDefault(MaxQueryKey(column)).ToString())
                : column.FilterKind == ColumnFilterKind.Choice && !column.FilterMultiple
                    ? (values.Count > 0 ? values[0] ?? "" : "")   // one value: a repeated key's first
                    : values.ToString();
            if (!string.IsNullOrWhiteSpace(text))
            {
                filters[column.Key!] = text;
            }
        }

        return filters;
    }

    // A number column "price" posts f-price-min and f-price-max: a column keyed "price-min"
    // would share one.
    private void CheckFilterKeys()
    {
        var taken = new Dictionary<string, ColumnBase<TItem>>(StringComparer.OrdinalIgnoreCase);
        foreach (var column in _columns.Where(c => c.CanFilter))
        {
            foreach (var key in FilterQueryKeys(column))
            {
                if (taken.TryGetValue(key, out var other) && other != column)
                {
                    throw new InvalidOperationException(
                        $"The \"{column.HeaderText}\" and \"{other.HeaderText}\" columns both filter through ?{key}. Give one a different {nameof(ColumnBase<TItem>.SortKey)}.");
                }

                taken[key] = column;
            }
        }
    }

    private IReadOnlyDictionary<string, string> CurrentFilters() => UseState ? StateFilters() : ReadFilters();

    private IReadOnlyDictionary<string, string> StateFilters()
    {
        if (_hasUnsplitFilter && _columnsReady)
        {
            _hasUnsplitFilter = false;
            (_stateFilters, _stateExtra) = SplitFilter(_unsplitFilter);
        }

        return _stateFilters;
    }

    // A filter as each filterable column's panel text, where its panel can show the condition,
    // and the rest.
    private (IReadOnlyDictionary<string, string> Columns, IReadOnlyList<IzzyBlazor.Filter> Extra) SplitFilter(IzzyBlazor.Filter? filter)
    {
        var columns = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        var extra = new List<IzzyBlazor.Filter>();
        foreach (var condition in Conditions(filter))
        {
            var column = condition is FieldFilter f ? _columns.FirstOrDefault(c => c.CanFilter && string.Equals(c.Key, f.Field, StringComparison.OrdinalIgnoreCase)) : null;
            if (column is not null && !columns.ContainsKey(column.Key!) && ColumnFilter.TextOf(column, (FieldFilter)condition) is { Length: > 0 } text)
            {
                columns[column.Key!] = text;
            }
            else
            {
                extra.Add(condition);
            }
        }

        return (columns, extra);

        // The conditions every match meets: an and group's, through nested ones.
        static IEnumerable<IzzyBlazor.Filter> Conditions(IzzyBlazor.Filter? filter) => filter switch
        {
            null => [],
            FilterGroup { Logic: FilterLogic.And } g => g.Filters.SelectMany(Conditions),
            _ => [filter],
        };
    }

    // The filter tree for a request: each filtered column's condition and a bound filter's others,
    // all together; null when nothing is filtered.
    private IzzyBlazor.Filter? CurrentFilter()
    {
        var text = CurrentFilters();
        var conditions = _columns
            .Where(c => c.CanFilter && text.ContainsKey(c.Key!))
            .Select(c => ColumnFilter.Condition(c, text[c.Key!]))
            .OfType<IzzyBlazor.Filter>()
            .Concat(UseState ? _stateExtra : [])
            .ToArray();
        return conditions.Length == 0 ? null : IzzyBlazor.Filter.All(conditions);
    }

    // What the filter is, for telling whether it changed since the last load.
    /// <inheritdoc />
    internal override string FilterSignature() =>
        UseState && _stateExtra.Count > 0
            ? $"{Signature(CurrentFilters())}|{string.Join("|", _stateExtra)}"
            : Signature(CurrentFilters());

    private async Task RemoveExtraAsync(IzzyBlazor.Filter condition)
    {
        _stateExtra = _stateExtra.Where(c => !ReferenceEquals(c, condition)).ToList();
        await ReportFilterAsync();
    }

    // A changed filter starts from the first page; both are told to a bound parent.
    private async Task ReportFilterAsync()
    {
        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_statePage, _stateCursor) = (1, null);
        _reportedFilter = CurrentFilter();
        await FilterChanged.InvokeAsync(_reportedFilter);
        await ReportFirstPageAsync(pageWas, cursorWas);

        await ReloadIfStaleAsync();
    }

    // What a number filter's two boxes show: what was typed in them, not the tidied range ("1."
    // while typing "1.5" stays "1."). URL: each box's own key. Bound: the ends last typed, while
    // they still make up the current value; otherwise the value's two ends.
    private (string Min, string Max) RangeEnds(ColumnBase<TItem> column, string current)
    {
        if (!UseState)
        {
            var query = QueryString.Of(Navigation.Uri);
            return (query.GetValueOrDefault(MinQueryKey(column)).ToString(), query.GetValueOrDefault(MaxQueryKey(column)).ToString());
        }

        return _rangeTyped.TryGetValue(column.Key!, out var typed) && ColumnFilter.JoinRange(typed.Min, typed.Max) == current
            ? typed
            : ColumnFilter.SplitRange(current);
    }

    private readonly Dictionary<string, (string Min, string Max)> _rangeTyped = new(StringComparer.OrdinalIgnoreCase);

    private static string Signature(IReadOnlyDictionary<string, string> filters) =>
        string.Join('&', filters.Where(f => !string.IsNullOrWhiteSpace(f.Value)).OrderBy(f => f.Key, StringComparer.Ordinal).Select(f => $"{f.Key}={f.Value}"));

    // The rest of the URL, carried through the filters' GET form: everything but this table's
    // filters and page (a new filter starts at page 1).
    private IEnumerable<(string Key, string Value)> KeptQuery()
    {
        var own = _columns.Where(c => c.CanFilter).SelectMany(FilterQueryKeys).Append(PageKey).Append(CursorKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return QueryString.Of(Navigation.Uri)
            .Where(q => !own.Contains(q.Key))
            .SelectMany(q => q.Value.Select(v => (q.Key, v ?? "")));
    }

    private string ClearFiltersHref => Navigation.GetUriWithQueryParameters(
        _columns.Where(c => c.CanFilter).SelectMany(FilterQueryKeys).Append(PageKey).Append(CursorKey).Distinct().ToDictionary(k => k, _ => (object?)null));

    // The header's title: a sort control (a button when state is in the component, a link
    // otherwise) or plain text.
    private RenderFragment HeaderTitle(ColumnBase<TItem> column) => __builder =>
    {
        if (column.CanSort && UseState)
        {
            <button type="button" class="ib-table-sort" @onclick="() => OnSortClickAsync(column)">
                <span class="ib-table-title">@column.HeaderText</span>
                <Icon Role="SortIcon(column)" Class="ib-table-sort-icon" />
            </button>
        }
        else if (column.CanSort)
        {
            <a href="@SortHref(column)" class="ib-table-sort">
                <span class="ib-table-title">@column.HeaderText</span>
                <Icon Role="SortIcon(column)" Class="ib-table-sort-icon" />
            </a>
        }
        else
        {
            <span class="ib-table-title">@column.HeaderText</span>
        }
    };

    private string FilterLabel(ColumnBase<TItem> column) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterColumn, column.HeaderText);

    // What a filter is set to, in words: the text typed, the choice's name, "2 selected", or a
    // range ("100–500", "100 or more").
    private string FilterSummary(ColumnBase<TItem> column, string current)
    {
        if (column.FilterKind == ColumnFilterKind.Number)
        {
            var (min, max) = ColumnFilter.SplitRange(current);
            var culture = System.Globalization.CultureInfo.CurrentCulture;
            return (min.Length > 0, max.Length > 0) switch
            {
                (true, true) when min == max => min,
                (true, true) => string.Format(culture, TextDefaults.FilterBetween, min, max),
                (true, false) => string.Format(culture, TextDefaults.FilterAtLeast, min),
                (false, true) => string.Format(culture, TextDefaults.FilterAtMost, max),
                _ => "",
            };
        }

        if (column.FilterKind != ColumnFilterKind.Choice)
        {
            return current;
        }

        var chosen = ColumnFilter.SplitValues(current);
        var choices = column.FilterChoices(TextDefaults);
        return chosen.Count switch
        {
            0 => TextDefaults.All,
            1 => choices.FirstOrDefault(c => string.Equals(c.Value, chosen[0], StringComparison.OrdinalIgnoreCase)).Text ?? chosen[0],
            _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterSelected, chosen.Count),
        };
    }

    // A funnel button, marked when the column is filtered, that opens the
    // filter. Choices open a menu (checkbox items for FilterMultiple); text, numbers and dates a
    // popover with the field. Both popovers open with no script.
    private RenderFragment HeaderFilter(ColumnBase<TItem> column, string current) => __builder =>
    {
        var label = FilterLabel(column);
        var name = current.Length > 0 ? $"{label}: {FilterSummary(column, current)}" : label;
        var placement = column.EffectiveAlign == CellAlign.End ? Placement.BottomEnd : Placement.BottomStart;
        if (column.FilterKind == ColumnFilterKind.Choice)
        {
            <Menu Placement="placement" data-ib-user-controlled>
                <Trigger>
                    <button type="button" class="ib-table-filter-button" data-active="@(current.Length > 0 ? "" : null)" aria-label="@name" title="@name" @attributes="context">
                        <Icon Role="IconRole.Filter" />
                    </button>
                </Trigger>
                <ChildContent>
                    @FilterMenuItems(column, current)
                </ChildContent>
            </Menu>
        }
        else
        {
            var fieldId = $"{FilterFormId}-{_columns.IndexOf(column)}";
            <Popover Placement="placement" data-ib-user-controlled>
                <Trigger>
                    <button type="button" class="ib-table-filter-button" data-active="@(current.Length > 0 ? "" : null)" aria-label="@name" title="@name" @attributes="context">
                        <Icon Role="IconRole.Filter" />
                    </button>
                </Trigger>
                <ChildContent>
                    @if (column.FilterKind == ColumnFilterKind.Number)
                    {
                        @* A range: at least and at most, each with its own label, in a group named
                           by the panel's title. *@
                        var (min, max) = RangeEnds(column, current);
                        <div class="ib-table-filter-panel ib-field-sm" role="group" aria-labelledby="@($"{fieldId}-title")">
                            <span class="ib-field-label ib-table-filter-label" id="@($"{fieldId}-title")">@label</span>
                            <div class="ib-table-filter-range">
                                @RangeInput(column, min, atLeast: true, id: $"{fieldId}-min")
                                @RangeInput(column, max, atLeast: false, id: $"{fieldId}-max")
                            </div>
                            @FilterPanelActions
                        </div>
                    }
                    else
                    {
                        <div class="ib-table-filter-panel ib-field-sm">
                            <label class="ib-field-label ib-table-filter-label" for="@fieldId">@label</label>
                            @FilterInput(column, current, fieldId)
                            @FilterPanelActions
                        </div>
                    }
                </ChildContent>
            </Popover>
        }
    };

    // Without script (and on static pages before it arrives), Enter or Apply submits the filters'
    // GET form; with script the fields apply as they change and CSS hides the button.
    private RenderFragment FilterPanelActions => __builder =>
    {
        if (!UseState)
        {
            <div class="ib-table-filter-panel-actions">
                <button type="submit" form="@FilterFormId" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm">@TextDefaults.Apply</button>
            </div>
        }
    };

    // The menu of a choice filter: "All", then the values. FilterMultiple: checkbox items that
    // toggle and keep the menu open. Otherwise choosing one sets it and closes the menu. Static
    // pages: each item links to the URL with the new values. Bound: the items change state.
    private RenderFragment FilterMenuItems(ColumnBase<TItem> column, string current) => __builder =>
    {
        var chosen = ColumnFilter.SplitValues(current);
        <MenuItem Href="@(UseState ? null : FilterValuesHref(column, []))"
                  OnClick="@(UseState ? EventCallback.Factory.Create<MouseEventArgs>(this, () => OnFilterValuesAsync(column, [])) : default)">@TextDefaults.All</MenuItem>
        <MenuDivider />
        foreach (var (value, text) in column.FilterChoices(TextDefaults))
        {
            var on = chosen.Contains(value, StringComparer.OrdinalIgnoreCase);
            IReadOnlyList<string> next = !column.FilterMultiple
                ? new[] { value }
                : on ? chosen.Where(v => !string.Equals(v, value, StringComparison.OrdinalIgnoreCase)).ToList() : chosen.Append(value).ToList();
            <MenuItem Checked="on" KeepOpen="column.FilterMultiple"
                      Href="@(UseState ? null : FilterValuesHref(column, next))"
                      CheckedChanged="@(UseState ? EventCallback.Factory.Create<bool>(this, () => OnFilterValuesAsync(column, next)) : default)">@text</MenuItem>
        }
    };

    // A header filter's field, shown under its label (id): a date input, or a text box. Static
    // pages join it to the GET form; bound pages handle its events. (Choices open a menu instead.)
    private RenderFragment FilterInput(ColumnBase<TItem> column, string current, string id) => __builder =>
    {
        if (column.FilterKind == ColumnFilterKind.Date)
        {
            @* A date input sends yyyy-MM-dd whatever the person's locale shows; it applies when a
               whole date is chosen, so there's no pause to wait for. *@
            var day = ColumnFilter.TryParseDay(current, out var parsed) ? parsed.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "";
            <div class="ib-field ib-field-sm ib-table-filter ib-table-filter-date">
                <div class="ib-field-control">
                    @if (UseState)
                    {
                        <input type="date" class="ib-field-input" id="@id" autofocus value="@day" @onchange="e => OnFilterAsync(column, e, wait: false)" />
                    }
                    else
                    {
                        <input type="date" class="ib-field-input" id="@id" autofocus value="@day" name="@FilterQueryKey(column)" form="@FilterFormId" data-ib-filter />
                    }
                </div>
            </div>
        }
        else
        {
            <div class="ib-field ib-field-sm ib-table-filter">
                <div class="ib-field-control">
                    @if (UseState)
                    {
                        <input type="search" class="ib-field-input" id="@id" autofocus value="@current" autocomplete="off"
                               @oninput="e => OnFilterAsync(column, e, wait: true)" />
                    }
                    else
                    {
                        <input type="search" class="ib-field-input" id="@id" autofocus value="@current" autocomplete="off"
                               name="@FilterQueryKey(column)" form="@FilterFormId" data-ib-filter />
                    }
                </div>
            </div>
        }
    };

    // One end of a number filter's range, labeled "Min" or "Max", with a numeric keyboard. Static
    // pages post it under its own key (?f-total-min=); bound pages put the two ends together.
    private RenderFragment RangeInput(ColumnBase<TItem> column, string value, bool atLeast, string id) => __builder =>
    {
        <div class="ib-field ib-field-sm ib-table-filter">
            <label class="ib-field-label" for="@id">@(atLeast ? TextDefaults.FilterMin : TextDefaults.FilterMax)</label>
            <div class="ib-field-control">
                @if (UseState)
                {
                    <input type="text" class="ib-field-input" id="@id" autofocus="@atLeast" value="@value" inputmode="decimal" autocomplete="off"
                           @oninput="e => OnRangeAsync(column, e, atLeast)" />
                }
                else
                {
                    <input type="text" class="ib-field-input" id="@id" autofocus="@atLeast" value="@value" inputmode="decimal" autocomplete="off"
                           name="@(atLeast ? MinQueryKey(column) : MaxQueryKey(column))" form="@FilterFormId" data-ib-filter />
                }
            </div>
        </div>
    };

    // The URL with a filter set to these values (repeated keys for several), from page 1. No
    // values clears every key the filter uses (a range's two).
    private string FilterValuesHref(ColumnBase<TItem> column, IReadOnlyList<string> values)
    {
        var changes = FilterQueryKeys(column).ToDictionary(k => k, _ => (object?)null);
        if (values.Count > 0)
        {
            changes[FilterQueryKey(column)] = values.ToArray();
        }

        changes[PageKey] = null;
        changes[CursorKey] = null;
        return Navigation.GetUriWithQueryParameters(changes);
    }

    private async Task ClearFiltersAsync()
    {
        _filterDelay?.Cancel();
        (_stateFilters, _stateExtra) = (new Dictionary<string, string>(), []);
        await ReportFilterAsync();
    }

    private Task OnFilterValuesAsync(ColumnBase<TItem> column, IReadOnlyList<string> values) =>
        OnFilterAsync(column, new ChangeEventArgs { Value = string.Join(',', values) }, wait: false);

    // One end of a bound range changed: the value is both ends together ("100..500").
    private Task OnRangeAsync(ColumnBase<TItem> column, ChangeEventArgs e, bool atLeast)
    {
        var (min, max) = RangeEnds(column, StateFilters().GetValueOrDefault(column.Key!) ?? "");
        var typed = e.Value?.ToString() ?? "";
        var ends = atLeast ? (typed, max) : (min, typed);
        _rangeTyped[column.Key!] = ends;
        return OnFilterAsync(column, new ChangeEventArgs { Value = ColumnFilter.JoinRange(ends.Item1, ends.Item2) }, wait: true);
    }

    // Typing waits for a pause before filtering; a menu or a date applies at once.
    private async Task OnFilterAsync(ColumnBase<TItem> column, ChangeEventArgs e, bool wait)
    {
        var value = e.Value?.ToString() ?? "";
        var next = new Dictionary<string, string>(StateFilters(), StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(value))
        {
            next.Remove(column.Key!);
        }
        else
        {
            next[column.Key!] = value;
        }

        _stateFilters = next;
        _filterDelay?.Cancel();
        if (wait)
        {
            var delay = _filterDelay = new CancellationTokenSource();
            try
            {
                await Task.Delay(FilterDelay, delay.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
        }

        await ReportFilterAsync();
    }

    /// <summary>How long typing in a filter waits for a pause. Internal so tests can shorten it.</summary>
    internal TimeSpan FilterDelay { get; set; } = TimeSpan.FromMilliseconds(300);

    private int SkeletonRows => Math.Clamp(EffectivePageSize ?? 5, 1, 10);

    /// <inheritdoc />
    internal override string LabelOf(TItem item) => RowLabel?.Invoke(item) ?? KeyOf(item);

    // On the row's link when it has one (screen readers announce it there), else on the row.
    private string? CurrentOf(TItem item) => RowCurrent?.Invoke(item) == true ? "true" : null;

    private string? RowClasses(TItem item, string? href)
    {
        var classes = string.Join(' ', new[] { RowClass?.Invoke(item), href is null ? null : "ib-table-row-linked" }.Where(c => !string.IsNullOrEmpty(c)));
        return classes.Length > 0 ? classes : null;
    }

    // Rendered after the columns: its initialization runs once they have registered.
    private RenderFragment ColumnsReadyNotifier => builder =>
    {
        builder.OpenComponent<TableColumnsReady>(0);
        builder.AddComponentParameter(1, nameof(TableColumnsReady.Ready), (Func<Task>)ColumnsReadyAsync);
        builder.CloseComponent();
    };

    private string? ScrollStyle => MaxHeight is { } height ? $"max-height:{StyleValues.Length(height)}" : null;

    internal void AddColumn(ColumnBase<TItem> column)
    {
        if (!_columns.Contains(column))
        {
            _columns.Add(column);

            // A column shown later (behind an @if) appears without waiting for another render.
            if (_columnsReady)
            {
                StateHasChanged();
            }
        }
    }

    internal void ColumnChanged()
    {
        if (_columnsReady)
        {
            StateHasChanged();
        }
    }

    internal void RemoveColumn(ColumnBase<TItem> column)
    {
        if (_columns.Remove(column))
        {
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        (_class, _style) = BuildRootAttributes();

        if (Paging == DataPaging.LoadMore)
        {
            throw new InvalidOperationException(
                "A Table pages by number (DataPaging.Pages), by cursor (DataPaging.NextPrevious), or loads the next page as you scroll (DataPaging.LoadOnScroll, with a MaxHeight). " +
                "A Load more button is for lists: use ListView.");
        }

        SyncSelection();
        await SyncAndLoadAsync();
    }

    private void TakeFilter(IzzyBlazor.Filter? filter)
    {
        (_unsplitFilter, _hasUnsplitFilter) = (filter, true);
        (_stateFilters, _stateExtra) = (new Dictionary<string, string>(), []);
    }

    private async Task OnSortClickAsync(ColumnBase<TItem> column)
    {
        var next = NextSort(column);
        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_stateSort, _statePage, _stateCursor) = (next, 1, null);
        await SortChanged.InvokeAsync(next);
        await ReportFirstPageAsync(pageWas, cursorWas);

        await ReloadIfStaleAsync();
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-table");
        classes.Add("ib-table-striped", Striped);
        classes.Add("ib-table-no-row-lines", !RowLines);
        classes.Add("ib-table-column-lines", ColumnLines);
        classes.Add("ib-table-borderless", !Bordered);
        classes.Add("ib-table-sm", Size == ControlSize.Sm);
        classes.Add("ib-table-lg", Size == ControlSize.Lg);
        classes.Add("ib-table-sticky", MaxHeight is not null);
        base.BuildAttributes(classes, styles);
    }

    private async Task ColumnsReadyAsync()
    {
        _columnsReady = true;

        // Filters kept in the component start from the URL too, once the columns that name them
        // have registered.
        if (UseState && Filter is null && StateFilters().Count == 0 && _stateExtra.Count == 0)
        {
            _stateFilters = ReadFilters();
        }

        await LoadAsync();
        StateHasChanged();
    }

    // Ascending first; a second click on the sorted column turns it descending.
    private string? NextSort(ColumnBase<TItem> column)
    {
        var ascendingNow = string.Equals(column.Key, _sortKey, StringComparison.OrdinalIgnoreCase) && !_descending;
        return ascendingNow ? $"-{column.Key}" : column.Key;
    }

    private string SortHref(ColumnBase<TItem> column) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [SortQueryKey] = NextSort(column),
            [PageKey] = null,
            [CursorKey] = null,
        });

    private bool IsSorted(ColumnBase<TItem> column) => string.Equals(column.Key, _sortKey, StringComparison.OrdinalIgnoreCase);

    private string? AriaSort(ColumnBase<TItem> column) => !column.CanSort ? null : !IsSorted(column) ? "none" : _descending ? "descending" : "ascending";

    private IconRole SortIcon(ColumnBase<TItem> column) =>
        !IsSorted(column) ? IconRole.Sortable : _descending ? IconRole.SortDescending : IconRole.SortAscending;

    private static string? CellClass(ColumnBase<TItem> column)
    {
        var align = column.EffectiveAlign switch
        {
            CellAlign.Center => "ib-cell-center",
            CellAlign.End => "ib-cell-end",
            _ => null,
        };

        var classes = string.Join(' ', new[] { align, column.Class }.Where(c => !string.IsNullOrEmpty(c)));
        return classes.Length > 0 ? classes : null;
    }

    private static string? WidthStyle(ColumnBase<TItem> column) =>
        column.Width is { } width ? $"width:{StyleValues.Length(width)}" : null;

    private string PagesLabel =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TablePages, Caption ?? TextDefaults.TableName);

    /// <inheritdoc />
    internal override void SyncFilter(bool first)
    {
        if (first)
        {
            TakeFilter(Filter);
            _lastFilterParam = Filter;
            return;
        }

        // A new filter from the parent, but not the echo of one this table just reported.
        if (!ReferenceEquals(Filter, _lastFilterParam))
        {
            _lastFilterParam = Filter;
            if (!ReferenceEquals(Filter, _reportedFilter))
            {
                TakeFilter(Filter);
            }
        }
    }

    /// <inheritdoc />
    internal override DataRequest<TItem> Shape(DataRequest<TItem> request, string? sortRaw)
    {
        var sort = !string.IsNullOrEmpty(sortRaw) ? sortRaw : InitialSort;
        var descending = sort?.StartsWith('-') == true;
        var sortKey = sort?.TrimStart('-');
        var column = _columns.FirstOrDefault(c => c.CanSort && string.Equals(c.Key, sortKey, StringComparison.OrdinalIgnoreCase));
        _shapedSort = (column is null ? null : sortKey, descending);
        return request with
        {
            Sort = column is null ? [] : [new SortField(column.Key!, descending)],
            Filter = CurrentFilter(),
            Fields = _columns.Select(c => c.ToField(TextDefaults)).OfType<DataField<TItem>>().ToList(),
        };
    }

    /// <inheritdoc />
    internal override void Loaded() => (_sortKey, _descending) = _shapedSort;

    /// <inheritdoc />
    internal override ValueTask FocusAfterRetryAsync() => _scrollRef.FocusAsync();

    /// <inheritdoc />
    public override void Dispose()
    {
        base.Dispose();
        _filterDelay?.Cancel();
    }
}
