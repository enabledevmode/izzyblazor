@namespace IzzyBlazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits LayoutItemBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, there's no select-all checkbox, and filters apply when you press Apply, not as you type.")]

@*
    A data table that sorts and pages through the URL: column headers and page numbers are
    links that set ?sort= and ?page=, so it works on static pages with no script, survives
    reloads, and can be shared. On interactive pages the links are ordinary navigations (with
    enhanced navigation the server renders the page again) and the table follows the URL.

    Filterable columns add a filter row under the headers. Filters go in the URL too
    (?f-customer=ada): with no script the boxes submit a GET form when you press Enter; with
    script they apply as you type.

    Bind Sort, Page or Filters (@bind-Sort, @bind-Page, @bind-Filters) on an interactive page to
    keep them in the component instead: headers and page numbers become buttons, the URL doesn't change, and the
    table sorts and pages in place, like a client-side grid. It starts from the URL's values.

    Give it Items (a list, or an IQueryable that EF Core translates) and it sorts and pages them,
    or an ItemsProvider to load each page yourself.

    Selectable adds a checkbox per row: it posts the row's ItemKey with the surrounding form, and
    @bind-SelectedKeys follows it on interactive pages. RowHref makes each row a link. Columns
    take FooterText or Footer for a footer row.

    <Table Items="orders" PageSize="10" Caption="Orders">
        <PropertyColumn Property="o => o.Customer" Sortable />
        <PropertyColumn Property="o => o.Total" Format="C" Sortable />
        <TemplateColumn Title="Status"><Badge>@context.Status</Badge></TemplateColumn>
    </Table>

    Accessibility:
    - `Caption` names the table for screen readers; it isn't shown. It also names the scrolling
      area, which can be scrolled from the keyboard.
    - Sortable headers are links, and the sorted column has `aria-sort`.
    - Each filter button is named for its column ("Filter Customer"), and the active filters are a
      group named "Filters".
    - Row checkboxes are named "Select" and the row's `RowLabel` ("Select order 1001"); without
      one, the `ItemKey`.
    - The range under the table ("1–5 of 23") is read when it changes.
*@

<ib-table @attributes="AdditionalAttributes" class="@_class" style="@_style" data-ib-page-key="@(HasFilters && !UseState ? PageKey : null)">
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
        @ColumnsReadyNotifier
    </CascadingValue>
    @if (HasFilters && FilterPlacement == FilterPlacement.Header)
    {
        var active = CurrentFilters();
        @* The active filters, which the header hides in its popovers: a removable tag each. Always
           rendered (hidden while empty): if it came and went, enhanced navigation's DOM merge would
           turn the table's scroll box into it and rebuild the table, closing the filter popover
           someone is typing in. *@
        <div class="ib-table-filter-tags" role="group" aria-label="@TextDefaults.Filters" hidden="@(active.Count == 0)">
            @foreach (var column in _columns.Where(c => c.CanFilter && active.ContainsKey(c.Key!)))
            {
                var summary = FilterSummary(column, active[column.Key!]);
                <Tag Label="@($"{column.HeaderText}: {summary}")" Size="ControlSize.Sm"
                     RemoveHref="@(UseState ? null : FilterValuesHref(column, []))"
                     OnRemove="@(UseState ? EventCallback.Factory.Create(this, () => OnFilterValuesAsync(column, [])) : default)" />
            }
            @if (active.Count > 0 && UseState)
            {
                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm" @onclick="ClearFiltersAsync">@TextDefaults.Clear</button>
            }
            else if (active.Count > 0)
            {
                <a href="@ClearFiltersHref" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm">@TextDefaults.Clear</a>
            }
        </div>
    }
    <div class="ib-table-scroll" role="region" aria-label="@(Caption ?? TextDefaults.TableName)" tabindex="0" style="@ScrollStyle">
        <table class="ib-table-grid" aria-busy="@(IsLoading ? "true" : null)">
            @if (Caption is not null)
            {
                <caption class="ib-visually-hidden">@Caption</caption>
            }
            <thead>
                <tr>
                    @if (Selectable)
                    {
                        @* Select all (this page): script only; it checks the rows, which report their own changes. *@
                        <th scope="col" class="ib-table-select-cell">
                            <input type="checkbox" class="ib-check-input ib-table-select-all" aria-label="@(SelectAllLabel ?? TextDefaults.SelectAllRows)" checked="@AllOnPageSelected" />
                        </th>
                    }
                    @{ var headerFilters = HasFilters && FilterPlacement == FilterPlacement.Header ? CurrentFilters() : null; }
                    @foreach (var column in _columns)
                    {
                        <th scope="col" class="@CellClass(column)" style="@WidthStyle(column)" aria-sort="@AriaSort(column)">
                            @if (headerFilters is not null && column.CanFilter)
                            {
                                @* The title (or sort control) and a filter button that opens the filter. *@
                                <div class="ib-table-head">
                                    @HeaderTitle(column)
                                    @HeaderFilter(column, headerFilters.GetValueOrDefault(column.Key!) ?? "")
                                </div>
                            }
                            else
                            {
                                @HeaderTitle(column)
                            }
                        </th>
                    }
                </tr>
                @if (HasFilters && FilterPlacement == FilterPlacement.Row)
                {
                    var filters = CurrentFilters();
                    <tr class="ib-table-filter-row">
                        @if (Selectable)
                        {
                            <td class="ib-table-select-cell"></td>
                        }
                        @foreach (var column in _columns)
                        {
                            <td class="@CellClass(column)">
                                @if (column.CanFilter)
                                {
                                    @FilterControl(column, filters.GetValueOrDefault(column.Key!) ?? "")
                                }
                            </td>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @if (_items.Count == 0 && IsLoading)
                {
                    @for (var i = 0; i < SkeletonRows; i++)
                    {
                        <tr class="ib-table-skeleton-row" aria-hidden="true">
                            @if (Selectable)
                            {
                                <td class="ib-table-select-cell"></td>
                            }
                            @foreach (var column in _columns)
                            {
                                <td class="@CellClass(column)"><span class="ib-skeleton ib-table-skeleton"></span></td>
                            }
                        </tr>
                    }
                }
                else if (_items.Count == 0)
                {
                    <tr class="ib-table-empty">
                        <td colspan="@Math.Max(1, _columns.Count + (Selectable ? 1 : 0))">
                            @if (EmptyContent is not null)
                            {
                                @EmptyContent
                            }
                            else
                            {
                                @(EmptyText ?? TextDefaults.NoItems)
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in _items)
                    {
                        var key = KeyOf(item);
                        var href = RowHref?.Invoke(item);
                        <tr class="@RowClasses(item, href)">
                            @if (Selectable)
                            {
                                <td class="ib-table-select-cell">
                                    <input type="checkbox" class="ib-check-input ib-table-select" name="@EffectiveSelectionName" value="@key"
                                           aria-label="@($"{SelectRowLabel ?? TextDefaults.SelectRow} {LabelOf(item)}")"
                                           checked="@IsSelected(key)"
                                           @onchange="e => OnSelectChanged(key, e)" />
                                </td>
                            }
                            @{ var first = true; }
                            @foreach (var column in _columns)
                            {
                                <td class="@CellClass(column)">
                                    @if (first && href is not null)
                                    {
                                        @* One link per row, stretched over it; controls in the row stay clickable above it. *@
                                        <a class="ib-table-row-link" href="@href"><span class="ib-visually-hidden">@LabelOf(item)</span></a>
                                    }
                                    @column.Cell(item)
                                </td>
                                first = false;
                            }
                        </tr>
                    }
                }
            </tbody>
            @if (_columns.Any(c => c.HasFooter))
            {
                <tfoot>
                    <tr>
                        @if (Selectable)
                        {
                            <td class="ib-table-select-cell"></td>
                        }
                        @foreach (var column in _columns)
                        {
                            <td class="@CellClass(column)">@(column.HasFooter ? column.FooterCell : null)</td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    @if (HasFilters && !UseState)
    {
        @* The filters' GET form. Its fields join it through form="", not by nesting, so a table
           inside another form (a selection form) still works: if the browser drops this nested
           form, the filters belong to no form and never post with the outer one. *@
        <form id="@FilterFormId" method="get" action="@ActionPath" class="ib-table-filter-form"></form>
        <div class="ib-table-filter-actions">
            @foreach (var (key, value) in KeptQuery())
            {
                <input type="hidden" name="@key" value="@value" form="@FilterFormId" />
            }
            @if (FilterPlacement == FilterPlacement.Row)
            {
                @* Without script, Enter in a filter submits through this button; selects need it. *@
                <button type="submit" form="@FilterFormId" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm">@TextDefaults.Apply</button>
                @if (CurrentFilters().Count > 0)
                {
                    <a href="@ClearFiltersHref" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm">@TextDefaults.Clear</a>
                }
            }
        </div>
    }
    @if (EffectivePageSize is { } size && _total > 0)
    {
        <div class="ib-table-footer">
            <div class="ib-table-footer-info">
                @if (PageSizeOptions is { Count: > 0 } options)
                {
                    @* Rows per page: an option menu, so it works with no script (each size a link). *@
                    <span class="ib-table-page-size">
                        <span class="ib-table-page-size-label" aria-hidden="true">@TextDefaults.RowsPerPage</span>
                        <Menu Placement="Placement.TopStart">
                            <Trigger>
                                <button type="button" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm ib-table-page-size-button" aria-label="@($"{TextDefaults.RowsPerPage}: {size}")" @attributes="context">
                                    @size
                                    <Icon Role="IconRole.ChevronDown" Class="ib-table-page-size-chevron" />
                                </button>
                            </Trigger>
                            <ChildContent>
                                @foreach (var option in options)
                                {
                                    var choice = option;
                                    <MenuItem Checked="choice == size"
                                              Href="@(UseState ? null : PageSizeHref(choice))"
                                              CheckedChanged="@(UseState ? EventCallback.Factory.Create<bool>(this, () => OnPageSizeAsync(choice)) : default)">@choice</MenuItem>
                                }
                            </ChildContent>
                        </Menu>
                    </span>
                }
                @* A status region, so screen readers hear the new range after sorting, paging or filtering. *@
                <span class="ib-table-summary" role="status">@Summary(size)</span>
            </div>
            @if (UseState)
            {
                <Pagination Page="_page" PageChanged="OnPageClickAsync" TotalItems="_total" PageSize="size" Size="ControlSize.Sm" Label="@PagesLabel" />
            }
            else
            {
                <Pagination Page="_page" TotalItems="_total" PageSize="size" QueryKey="@PageKey" Size="ControlSize.Sm" Label="@PagesLabel" />
            }
        </div>
    }
</ib-table>

@code {
    /// <summary>The items. A list is sorted and paged in memory; an <c>IQueryable</c> (such as an EF Core query) is sorted and paged by the database.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Loads one page of items yourself, in place of <see cref="Items"/>. Use <see cref="TableRequest{TItem}.Apply"/> on your query.</summary>
    [Parameter] public Func<TableRequest<TItem>, ValueTask<TableResult<TItem>>>? ItemsProvider { get; set; }

    /// <summary>The columns: <see cref="PropertyColumn{TItem, TValue}"/> and <see cref="TemplateColumn{TItem}"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Items per page. Leave it out to show every item.</summary>
    [Parameter] public int? PageSize { get; set; }

    /// <summary>
    /// Sizes to choose from in a "Rows per page" menu in the footer, such as
    /// <c>new[] { 10, 25, 50 }</c>. The URL carries the choice (<c>?size=25</c>); only these sizes
    /// are accepted from it. <see cref="PageSize"/> is the default (the first option when not set).
    /// </summary>
    [Parameter] public IReadOnlyList<int>? PageSizeOptions { get; set; }

    /// <summary>
    /// Raised when a page size is chosen on an interactive page. Binding it
    /// (<c>@bind-PageSize</c>) keeps the size, with sort, page and filters, in the component.
    /// </summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<int?> PageSizeChanged { get; set; }

    /// <summary>The sort when the URL has none, such as <c>"name"</c> or <c>"-date"</c> (descending).</summary>
    [Parameter] public string? InitialSort { get; set; }

    /// <summary>
    /// The sort, such as <c>"name"</c> or <c>"-date"</c> (descending); null for
    /// <see cref="InitialSort"/>. Binding it (<c>@bind-Sort</c>) on an interactive page keeps sort
    /// and page in the component instead of the URL.
    /// </summary>
    [Parameter] public string? Sort { get; set; }

    /// <summary>Raised when a header is chosen, on interactive pages.</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string?> SortChanged { get; set; }

    /// <summary>
    /// The page, from 1. Binding it (<c>@bind-Page</c>) on an interactive page keeps sort and page
    /// in the component instead of the URL. Set it back to 1 when your filters change.
    /// </summary>
    [Parameter] public int? Page { get; set; }

    /// <summary>Raised when a page is chosen (and with 1 when the sort or filters change), on interactive pages.</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<int> PageChanged { get; set; }

    /// <summary>
    /// Where the column filters go: a filter button in each header that opens the filter
    /// (<see cref="FilterPlacement.Header"/>, the default, with the active filters as removable
    /// tags above the table), or a row of fields under the headers (<see cref="FilterPlacement.Row"/>).
    /// </summary>
    [Parameter] public FilterPlacement FilterPlacement { get; set; } = FilterPlacement.Header;

    /// <summary>
    /// The filter values of <see cref="ColumnBase{TItem}.Filterable"/> columns, by column key
    /// (<c>"customer"</c> → <c>"ada"</c>). Binding it (<c>@bind-Filters</c>) on an interactive page
    /// keeps filters, sort and page in the component instead of the URL.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, string>? Filters { get; set; }

    /// <summary>Raised when a filter changes, on interactive pages (typing waits for a pause).</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<IReadOnlyDictionary<string, string>> FiltersChanged { get; set; }

    /// <summary>
    /// Prefix for this table's query-string keys, so several tables can share a page:
    /// <c>QueryPrefix="orders-"</c> uses <c>?orders-sort=</c> and <c>?orders-page=</c>.
    /// </summary>
    [Parameter] public string QueryPrefix { get; set; } = "";

    /// <summary>The table's name for screen readers (a visually hidden caption).</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>Shown when there are no items. Defaults to <see cref="EmptyText"/>.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>The text when there are no items. Defaults to "No items".</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>A class for each row, such as one that highlights overdue orders.</summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>Alternating row backgrounds.</summary>
    [Parameter] public bool Striped { get; set; }

    /// <summary>A line between rows. Defaults to true; the line under the header always shows.</summary>
    [Parameter] public bool RowLines { get; set; } = true;

    /// <summary>A line between columns. Defaults to false.</summary>
    [Parameter] public bool ColumnLines { get; set; }

    /// <summary>A rounded border around the table. Defaults to true; false for a table that sits inside a card or panel.</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    /// <summary>Row height and text size. <see cref="ControlSize.Sm"/> for dense data. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>A height limit: the rows scroll and the header stays in view.</summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>
    /// A unique, stable key for each item, such as its id. Selection posts and binds these keys.
    /// Defaults to the item's string form.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemKey { get; set; }

    /// <summary>
    /// Adds a checkbox to each row. Inside a form, the checked rows post their <see cref="ItemKey"/>
    /// under <see cref="SelectionName"/>; on interactive pages <c>@bind-SelectedKeys</c> follows them.
    /// With script, a header checkbox selects every row on the page.
    /// </summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>The form field name the checked rows post under. Defaults to <c>"{QueryPrefix}selected"</c>.</summary>
    [Parameter] public string? SelectionName { get; set; }

    /// <summary>The keys of the selected rows (on any page). Read the posted ones with <c>[SupplyParameterFromForm]</c> on static pages.</summary>
    [Parameter] public IReadOnlyCollection<string>? SelectedKeys { get; set; }

    /// <summary>Raised when rows are selected or cleared on interactive pages.</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<IReadOnlyCollection<string>> SelectedKeysChanged { get; set; }

    /// <summary>
    /// Makes each row a link, such as to the item's details page. The whole row is clickable;
    /// links, buttons and checkboxes inside it still work on their own.
    /// </summary>
    [Parameter] public Func<TItem, string?>? RowHref { get; set; }

    /// <summary>Names a row for screen readers, in its link and its checkbox. Defaults to <see cref="ItemKey"/>.</summary>
    [Parameter] public Func<TItem, string>? RowLabel { get; set; }

    /// <summary>Shows the table as loading: rows dim, or placeholder rows show while there are none. Set automatically while an <see cref="ItemsProvider"/> loads on interactive pages.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>The header checkbox's name for screen readers. Defaults to "Select all rows".</summary>
    [Parameter] public string? SelectAllLabel { get; set; }

    /// <summary>The start of each row checkbox's name for screen readers, before <see cref="RowLabel"/>. Defaults to "Select".</summary>
    [Parameter] public string? SelectRowLabel { get; set; }

    private readonly List<ColumnBase<TItem>> _columns = [];
    private IReadOnlyList<TItem> _items = [];
    private int _total;
    private int _page = 1;
    private string? _sortKey;
    private bool _descending;
    private bool _columnsReady;
    private string? _class;
    private string? _style;
    private bool _providerLoading;
    private HashSet<string> _selected = new(StringComparer.Ordinal);
    private IReadOnlyCollection<string>? _paramKeys;
    private IReadOnlyCollection<string>? _reportedKeys;

    private bool IsLoading => Loading || _providerLoading;

    // Sort and page live in the component (not the URL) on interactive pages that bind them.
    private bool UseState => RendererInfo.IsInteractive && (SortChanged.HasDelegate || PageChanged.HasDelegate || FiltersChanged.HasDelegate || PageSizeChanged.HasDelegate);

    private IReadOnlyDictionary<string, string> _stateFilters = new Dictionary<string, string>();
    private IReadOnlyDictionary<string, string>? _lastFiltersParam;
    private CancellationTokenSource? _filterDelay;
    private string? _filterFormId;

    private bool HasFilters => _columns.Any(c => c.CanFilter);

    private string FilterFormId => _filterFormId ??= IdGenerator.Next("ib-table-filters");

    private string FilterQueryKey(ColumnBase<TItem> column) => $"{QueryPrefix}f-{column.Key}";

    // GET replaces the query string with the form's fields, so the action is just the path.
    private string ActionPath => new Uri(Navigation.Uri).AbsolutePath;

    // Filter values from the URL, for the filterable columns.
    private Dictionary<string, string> ReadFilters()
    {
        var query = QueryString.Of(Navigation.Uri);
        var filters = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var column in _columns.Where(c => c.CanFilter))
        {
            if (query.TryGetValue(FilterQueryKey(column), out var value) && value.ToString() is { Length: > 0 } text && !string.IsNullOrWhiteSpace(text))
            {
                filters[column.Key!] = text;
            }
        }

        return filters;
    }

    private IReadOnlyDictionary<string, string> CurrentFilters() => UseState ? _stateFilters : ReadFilters();

    private static string Signature(IReadOnlyDictionary<string, string> filters) =>
        string.Join('&', filters.Where(f => !string.IsNullOrWhiteSpace(f.Value)).OrderBy(f => f.Key, StringComparer.Ordinal).Select(f => $"{f.Key}={f.Value}"));

    // The rest of the URL, carried through the filters' GET form: everything but this table's
    // filters and page (a new filter starts at page 1).
    private IEnumerable<(string Key, string Value)> KeptQuery()
    {
        var own = _columns.Where(c => c.CanFilter).Select(FilterQueryKey).Append(PageKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return QueryString.Of(Navigation.Uri)
            .Where(q => !own.Contains(q.Key))
            .SelectMany(q => q.Value.Select(v => (q.Key, v ?? "")));
    }

    private string ClearFiltersHref => Navigation.GetUriWithQueryParameters(
        _columns.Where(c => c.CanFilter).Select(FilterQueryKey).Append(PageKey).Distinct().ToDictionary(k => k, _ => (object?)null));

    // The header's title: a sort control (a button when state is in the component, a link
    // otherwise) or plain text.
    private RenderFragment HeaderTitle(ColumnBase<TItem> column) => __builder =>
    {
        if (column.CanSort && UseState)
        {
            <button type="button" class="ib-table-sort" @onclick="() => OnSortClickAsync(column)">
                <span class="ib-table-title">@column.HeaderText</span>
                <Icon Role="SortIcon(column)" Class="ib-table-sort-icon" />
            </button>
        }
        else if (column.CanSort)
        {
            <a href="@SortHref(column)" class="ib-table-sort">
                <span class="ib-table-title">@column.HeaderText</span>
                <Icon Role="SortIcon(column)" Class="ib-table-sort-icon" />
            </a>
        }
        else
        {
            <span class="ib-table-title">@column.HeaderText</span>
        }
    };

    private string FilterLabel(ColumnBase<TItem> column) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterColumn, column.HeaderText);

    // What a filter is set to, in words: the text typed, the choice's name, or "2 selected".
    private string FilterSummary(ColumnBase<TItem> column, string current)
    {
        if (column.FilterKind != ColumnFilterKind.Choice)
        {
            return current;
        }

        var chosen = ColumnFilter.SplitValues(current);
        var choices = column.FilterChoices(TextDefaults);
        return chosen.Count switch
        {
            0 => TextDefaults.All,
            1 => choices.FirstOrDefault(c => string.Equals(c.Value, chosen[0], StringComparison.OrdinalIgnoreCase)).Text ?? chosen[0],
            _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterSelected, chosen.Count),
        };
    }

    // FilterPlacement.Header: a funnel button, marked when the column is filtered, that opens the
    // filter. Choices open a menu (checkbox items for FilterMultiple); text, numbers and dates a
    // popover with the field. Both popovers open with no script.
    private RenderFragment HeaderFilter(ColumnBase<TItem> column, string current) => __builder =>
    {
        var label = FilterLabel(column);
        var name = current.Length > 0 ? $"{label}: {FilterSummary(column, current)}" : label;
        var placement = column.EffectiveAlign == CellAlign.End ? Placement.BottomEnd : Placement.BottomStart;
        if (column.FilterKind == ColumnFilterKind.Choice)
        {
            <Menu Placement="placement" data-ib-user-controlled>
                <Trigger>
                    <button type="button" class="ib-table-filter-button" data-active="@(current.Length > 0 ? "" : null)" aria-label="@name" title="@name" @attributes="context">
                        <Icon Role="IconRole.Filter" />
                    </button>
                </Trigger>
                <ChildContent>
                    @FilterMenuItems(column, current)
                </ChildContent>
            </Menu>
        }
        else
        {
            <Popover Placement="placement" data-ib-user-controlled>
                <Trigger>
                    <button type="button" class="ib-table-filter-button" data-active="@(current.Length > 0 ? "" : null)" aria-label="@name" title="@name" @attributes="context">
                        <Icon Role="IconRole.Filter" />
                    </button>
                </Trigger>
                <ChildContent>
                    <div class="ib-table-filter-panel">
                        @FilterInput(column, current, label, autofocus: true)
                        @if (!UseState)
                        {
                            @* With script the field applies as you type; without, Enter or Apply submits. *@
                            <div class="ib-table-filter-panel-actions">
                                <button type="submit" form="@FilterFormId" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm">@TextDefaults.Apply</button>
                            </div>
                        }
                    </div>
                </ChildContent>
            </Popover>
        }
    };

    // FilterPlacement.Row: a field per column. Several values: a field-like button opening the menu.
    private RenderFragment FilterControl(ColumnBase<TItem> column, string current) => __builder =>
    {
        var label = FilterLabel(column);
        if (column.FilterKind == ColumnFilterKind.Choice && column.FilterMultiple)
        {
            var summary = FilterSummary(column, current);
            <div class="ib-field ib-field-sm ib-table-filter ib-table-filter-multiple">
                <Menu Size="ControlSize.Sm" Placement="Placement.BottomStart" data-ib-user-controlled>
                    <Trigger>
                        <button type="button" class="ib-field-input ib-table-filter-trigger" aria-label="@($"{label}: {summary}")" @attributes="context">
                            <span class="ib-table-filter-summary">@summary</span>
                            <Icon Role="IconRole.ChevronDown" Class="ib-table-filter-chevron" />
                        </button>
                    </Trigger>
                    <ChildContent>
                        @FilterMenuItems(column, current)
                    </ChildContent>
                </Menu>
            </div>
        }
        else
        {
            @FilterInput(column, current, label)
        }
    };

    // The menu of a choice filter: "All", then the values. FilterMultiple: checkbox items that
    // toggle and keep the menu open. Otherwise choosing one sets it and closes the menu. Static
    // pages: each item links to the URL with the new values. Bound: the items change state.
    private RenderFragment FilterMenuItems(ColumnBase<TItem> column, string current) => __builder =>
    {
        var chosen = ColumnFilter.SplitValues(current);
        <MenuItem Href="@(UseState ? null : FilterValuesHref(column, []))"
                  OnClick="@(UseState ? EventCallback.Factory.Create<MouseEventArgs>(this, () => OnFilterValuesAsync(column, [])) : default)">@TextDefaults.All</MenuItem>
        <MenuDivider />
        foreach (var (value, text) in column.FilterChoices(TextDefaults))
        {
            var on = chosen.Contains(value, StringComparer.OrdinalIgnoreCase);
            IReadOnlyList<string> next = !column.FilterMultiple
                ? new[] { value }
                : on ? chosen.Where(v => !string.Equals(v, value, StringComparison.OrdinalIgnoreCase)).ToList() : chosen.Append(value).ToList();
            <MenuItem Checked="on" KeepOpen="column.FilterMultiple"
                      Href="@(UseState ? null : FilterValuesHref(column, next))"
                      CheckedChanged="@(UseState ? EventCallback.Factory.Create<bool>(this, () => OnFilterValuesAsync(column, next)) : default)">@text</MenuItem>
        }
    };

    // A single field: a select for a choice, a date input, or a text box (numbers get a numeric
    // keyboard). Static pages join it to the GET form; bound pages handle its events.
    private RenderFragment FilterInput(ColumnBase<TItem> column, string current, string label, bool autofocus = false) => __builder =>
    {
        if (column.FilterKind == ColumnFilterKind.Choice)
        {
            <div class="ib-field ib-field-sm ib-table-filter">
                <div class="ib-field-control ib-has-end">
                    @if (UseState)
                    {
                        <select class="ib-field-input ib-field-select" aria-label="@label" autofocus="@autofocus" value="@current" @onchange="e => OnFilterAsync(column, e, wait: false)">
                            @FilterOptions(column, current)
                        </select>
                    }
                    else
                    {
                        <select class="ib-field-input ib-field-select" aria-label="@label" autofocus="@autofocus" value="@current" name="@FilterQueryKey(column)" form="@FilterFormId" data-ib-filter>
                            @FilterOptions(column, current)
                        </select>
                    }
                    <Icon Role="IconRole.ChevronDown" Class="ib-field-icon ib-field-icon-end" />
                </div>
            </div>
        }
        else if (column.FilterKind == ColumnFilterKind.Date)
        {
            @* A date input sends yyyy-MM-dd whatever the person's locale shows; it applies when a
               whole date is chosen, so there's no pause to wait for. *@
            var day = ColumnFilter.TryParseDay(current, out var parsed) ? parsed.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "";
            <div class="ib-field ib-field-sm ib-table-filter ib-table-filter-date">
                <div class="ib-field-control">
                    @if (UseState)
                    {
                        <input type="date" class="ib-field-input" aria-label="@label" autofocus="@autofocus" value="@day" @onchange="e => OnFilterAsync(column, e, wait: false)" />
                    }
                    else
                    {
                        <input type="date" class="ib-field-input" aria-label="@label" autofocus="@autofocus" value="@day" name="@FilterQueryKey(column)" form="@FilterFormId" data-ib-filter />
                    }
                </div>
            </div>
        }
        else
        {
            var mode = column.FilterKind == ColumnFilterKind.Number ? "decimal" : null;
            <div class="ib-field ib-field-sm ib-table-filter">
                <div class="ib-field-control">
                    @if (UseState)
                    {
                        <input type="search" class="ib-field-input" aria-label="@label" autofocus="@autofocus" value="@current" inputmode="@mode" autocomplete="off"
                               @oninput="e => OnFilterAsync(column, e, wait: true)" />
                    }
                    else
                    {
                        <input type="search" class="ib-field-input" aria-label="@label" autofocus="@autofocus" value="@current" inputmode="@mode" autocomplete="off"
                               name="@FilterQueryKey(column)" form="@FilterFormId" data-ib-filter />
                    }
                </div>
            </div>
        }
    };

    private RenderFragment FilterOptions(ColumnBase<TItem> column, string current) => __builder =>
    {
        <option value="" selected="@(current.Length == 0)">@TextDefaults.All</option>
        foreach (var (value, text) in column.FilterChoices(TextDefaults))
        {
            <option value="@value" selected="@string.Equals(value, current, StringComparison.OrdinalIgnoreCase)">@text</option>
        }
    };

    // The URL with a multi-value filter set to these values (repeated keys), from page 1.
    private string FilterValuesHref(ColumnBase<TItem> column, IReadOnlyList<string> values) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [FilterQueryKey(column)] = values.Count == 0 ? null : values.ToArray(),
            [PageKey] = null,
        });

    private async Task ClearFiltersAsync()
    {
        _filterDelay?.Cancel();
        _stateFilters = new Dictionary<string, string>();
        var pageWas = _statePage;
        _statePage = 1;
        await FiltersChanged.InvokeAsync(_stateFilters);
        if (pageWas != 1)
        {
            await PageChanged.InvokeAsync(1);
        }

        await ReloadIfStaleAsync();
    }

    private Task OnFilterValuesAsync(ColumnBase<TItem> column, IReadOnlyList<string> values) =>
        OnFilterAsync(column, new ChangeEventArgs { Value = string.Join(',', values) }, wait: false);

    // Typing waits for a pause before filtering; a select applies at once.
    private async Task OnFilterAsync(ColumnBase<TItem> column, ChangeEventArgs e, bool wait)
    {
        var value = e.Value?.ToString() ?? "";
        var next = new Dictionary<string, string>(_stateFilters, StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(value))
        {
            next.Remove(column.Key!);
        }
        else
        {
            next[column.Key!] = value;
        }

        _stateFilters = next;
        _filterDelay?.Cancel();
        if (wait)
        {
            var delay = _filterDelay = new CancellationTokenSource();
            try
            {
                await Task.Delay(FilterDelay, delay.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
        }

        var pageWas = _statePage;
        _statePage = 1;
        await FiltersChanged.InvokeAsync(_stateFilters);
        if (pageWas != 1)
        {
            await PageChanged.InvokeAsync(1);
        }

        await ReloadIfStaleAsync();
    }

    /// <summary>How long typing in a filter waits for a pause. Internal so tests can shorten it.</summary>
    internal TimeSpan FilterDelay { get; set; } = TimeSpan.FromMilliseconds(300);

    private bool _stateReady;
    private string? _stateSort;
    private int _statePage = 1;
    private string? _lastSortParam;
    private int? _lastPageParam;

    private int SkeletonRows => Math.Clamp(EffectivePageSize ?? 5, 1, 10);

    private string SizeKey => $"{QueryPrefix}size";

    private int? _statePageSize;
    private int? _lastPageSizeParam;

    // The size when none has been chosen: PageSize, else the first option.
    private int? DefaultPageSize => PageSize ?? (PageSizeOptions is { Count: > 0 } o ? o[0] : null);

    // A ?size= from the URL, if it's one of the options.
    private int? ReadSizeQuery() =>
        PageSizeOptions is { Count: > 0 } options
        && QueryString.Of(Navigation.Uri).TryGetValue(SizeKey, out var raw)
        && int.TryParse(raw.ToString(), out var size) && options.Contains(size) ? size : null;

    private int? EffectivePageSize => UseState ? _statePageSize ?? DefaultPageSize : ReadSizeQuery() ?? DefaultPageSize;

    // The page that holds the first row on view now, at another size.
    private int PageAt(int newSize) => EffectivePageSize is { } current ? (_page - 1) * current / newSize + 1 : 1;

    private string PageSizeHref(int size)
    {
        var page = PageAt(size);
        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [SizeKey] = size == DefaultPageSize ? null : size,
            [PageKey] = page == 1 ? null : page,
        });
    }

    private async Task OnPageSizeAsync(int size)
    {
        var page = PageAt(size);
        var pageWas = _statePage;
        (_statePageSize, _statePage) = (size, page);
        await PageSizeChanged.InvokeAsync(size);
        if (page != pageWas)
        {
            await PageChanged.InvokeAsync(page);
        }

        await ReloadIfStaleAsync();
    }

    private string KeyOf(TItem item) => ItemKey?.Invoke(item) ?? item?.ToString() ?? "";

    private string LabelOf(TItem item) => RowLabel?.Invoke(item) ?? KeyOf(item);

    private string EffectiveSelectionName => SelectionName ?? $"{QueryPrefix}selected";

    private bool IsSelected(string key) => _selected.Contains(key);

    private bool AllOnPageSelected => _items.Count > 0 && _items.All(i => _selected.Contains(KeyOf(i)));

    private string? RowClasses(TItem item, string? href)
    {
        var classes = string.Join(' ', new[] { RowClass?.Invoke(item), href is null ? null : "ib-table-row-linked" }.Where(c => !string.IsNullOrEmpty(c)));
        return classes.Length > 0 ? classes : null;
    }

    private async Task OnSelectChanged(string key, ChangeEventArgs e)
    {
        var on = e.Value is true || (e.Value is string text && bool.TryParse(text, out var parsed) && parsed);
        if (on ? !_selected.Add(key) : !_selected.Remove(key))
        {
            return;
        }

        var keys = _selected.ToArray();
        _reportedKeys = keys;
        await SelectedKeysChanged.InvokeAsync(keys);
    }

    // Rendered after the columns: its initialization runs once they have registered.
    private RenderFragment ColumnsReadyNotifier => builder =>
    {
        builder.OpenComponent<TableColumnsReady>(0);
        builder.AddComponentParameter(1, nameof(TableColumnsReady.Ready), (Func<Task>)ColumnsReadyAsync);
        builder.CloseComponent();
    };

    private string SortQueryKey => $"{QueryPrefix}sort";

    private string PageKey => $"{QueryPrefix}page";

    private string? ScrollStyle => MaxHeight is { } height ? $"max-height:{StyleValues.Length(height)}" : null;

    internal void AddColumn(ColumnBase<TItem> column)
    {
        if (!_columns.Contains(column))
        {
            _columns.Add(column);

            // A column shown later (behind an @if) appears without waiting for another render.
            if (_columnsReady)
            {
                StateHasChanged();
            }
        }
    }

    internal void ColumnChanged()
    {
        if (_columnsReady)
        {
            StateHasChanged();
        }
    }

    internal void RemoveColumn(ColumnBase<TItem> column)
    {
        if (_columns.Remove(column))
        {
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        (_class, _style) = BuildRootAttributes();

        // Take the parent's keys when the parameter changes (a static post, or C# clearing the
        // selection), but not the echo of a change this table just reported. Without a binding
        // the parameter never changes, so the table keeps its own selection.
        if (!ReferenceEquals(SelectedKeys, _paramKeys))
        {
            _paramKeys = SelectedKeys;
            if (!ReferenceEquals(SelectedKeys, _reportedKeys))
            {
                _selected = new HashSet<string>(SelectedKeys ?? [], StringComparer.Ordinal);
            }
        }

        SyncState();

        if (_columnsReady)
        {
            await LoadAsync();
        }
    }

    // Takes the parent's Sort and Page when they change (C# setting them, or the echo of a click),
    // starting from the URL so a link to ?sort=&page= still opens on that view.
    private void SyncState()
    {
        if (!UseState)
        {
            return;
        }

        if (!_stateReady)
        {
            var (sortRaw, pageRaw) = ReadQuery();
            _stateSort = Sort ?? (string.IsNullOrEmpty(sortRaw) ? null : sortRaw);
            _statePage = Page ?? (int.TryParse(pageRaw, out var number) ? number : 1);
            _stateFilters = Filters ?? new Dictionary<string, string>();
            // A bound PageSize is the current size; otherwise it's the default, and the URL may pick another.
            _statePageSize = PageSizeChanged.HasDelegate ? PageSize : ReadSizeQuery();
            (_lastSortParam, _lastPageParam, _lastFiltersParam, _lastPageSizeParam, _stateReady) = (Sort, Page, Filters, PageSize, true);
            return;
        }

        if (PageSize != _lastPageSizeParam)
        {
            _lastPageSizeParam = PageSize;
            _statePageSize = PageSize;
        }

        if (!ReferenceEquals(Filters, _lastFiltersParam))
        {
            _lastFiltersParam = Filters;
            _stateFilters = Filters ?? new Dictionary<string, string>();
        }

        if (!string.Equals(Sort, _lastSortParam, StringComparison.Ordinal))
        {
            _lastSortParam = Sort;
            _stateSort = Sort;
        }

        if (Page != _lastPageParam)
        {
            _lastPageParam = Page;
            _statePage = Page ?? 1;
        }
    }

    private async Task OnSortClickAsync(ColumnBase<TItem> column)
    {
        var next = NextSort(column);
        var pageWas = _statePage;
        (_stateSort, _statePage) = (next, 1);
        await SortChanged.InvokeAsync(next);
        if (pageWas != 1)
        {
            await PageChanged.InvokeAsync(1);
        }

        await ReloadIfStaleAsync();
    }

    private async Task OnPageClickAsync(int page)
    {
        _statePage = page;
        await PageChanged.InvokeAsync(page);
        await ReloadIfStaleAsync();
    }

    // A bound parent re-renders the table, which loads; otherwise load here.
    private async Task ReloadIfStaleAsync()
    {
        var (sortRaw, pageRaw) = CurrentState();
        if (_loadedKey is { } loaded && loaded.Sort == sortRaw && loaded.Page == pageRaw && loaded.Filters == Signature(CurrentFilters()) && loaded.PageSize == EffectivePageSize)
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    }

    // Where sort and page come from: the component's state, or the URL.
    private (string? Sort, string? Page) CurrentState() =>
        UseState ? (_stateSort, _statePage.ToString(System.Globalization.CultureInfo.InvariantCulture)) : ReadQuery();

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-table");
        classes.Add("ib-table-striped", Striped);
        classes.Add("ib-table-no-row-lines", !RowLines);
        classes.Add("ib-table-column-lines", ColumnLines);
        classes.Add("ib-table-borderless", !Bordered);
        classes.Add("ib-table-sm", Size == ControlSize.Sm);
        classes.Add("ib-table-lg", Size == ControlSize.Lg);
        classes.Add("ib-table-sticky", MaxHeight is not null);
        base.BuildAttributes(classes, styles);
    }

    private async Task ColumnsReadyAsync()
    {
        _columnsReady = true;

        // Filters kept in the component start from the URL too, once the columns that name them
        // have registered.
        if (UseState && Filters is null && _stateFilters.Count == 0)
        {
            _stateFilters = ReadFilters();
        }

        await LoadAsync();
        StateHasChanged();
    }

    // Only this table's own sort or page changing calls for a reload here; anything else that
    // changes the data (filters) re-renders the page, which reloads through the parameters.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(async () =>
    {
        if (!_columnsReady || UseState || (ReadQuery() == (_loadedKey?.Sort, _loadedKey?.Page) && Signature(ReadFilters()) == _loadedKey?.Filters && EffectivePageSize == _loadedKey?.PageSize))
        {
            return;
        }

        try
        {
            await LoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    });

    private (string? Sort, string? Page) ReadQuery()
    {
        var query = QueryString.Of(Navigation.Uri);
        return (query.TryGetValue(SortQueryKey, out var s) ? s.ToString() : null,
                query.TryGetValue(PageKey, out var p) ? p.ToString() : null);
    }

    private sealed record LoadKey(string? Sort, string? Page, string Filters, object? Items, object? Provider, int? PageSize);

    private LoadKey? _loadedKey;
    private int _loadVersion;

    // A list is queried as an EnumerableQuery, which runs the query through Enumerable's methods,
    // found by reflection; the DynamicDependency keeps them in a trimmed app.
    [System.Diagnostics.CodeAnalysis.DynamicDependency(System.Diagnostics.CodeAnalysis.DynamicallyAccessedMemberTypes.PublicMethods, typeof(Enumerable))]
    [System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessage("Trimming", "IL2026", Justification = "The DynamicDependency keeps the Enumerable methods the in-memory query binds to.")]
    private static IQueryable<TItem> AsQuery(IEnumerable<TItem> items) => items as IQueryable<TItem> ?? items.AsQueryable();

    private async Task LoadAsync()
    {
        var (sortRaw, pageRaw) = CurrentState();
        var filters = CurrentFilters();
        var pageSize = EffectivePageSize;
        // Always reload: the same list may have changed since the last render.
        _loadedKey = new LoadKey(sortRaw, pageRaw, Signature(filters), Items, ItemsProvider, pageSize);
        var version = ++_loadVersion;

        var sort = !string.IsNullOrEmpty(sortRaw) ? sortRaw : InitialSort;
        var descending = sort?.StartsWith('-') == true;
        var sortKey = sort?.TrimStart('-');
        var column = _columns.FirstOrDefault(c => c.CanSort && string.Equals(c.Key, sortKey, StringComparison.OrdinalIgnoreCase));
        if (column is null)
        {
            sortKey = null;
        }

        // Keep (page - 1) * size inside int range, whatever is in the URL.
        var maxPage = pageSize is > 0 and var size0 ? int.MaxValue / size0 : int.MaxValue;
        var page = int.TryParse(pageRaw, out var number) ? Math.Clamp(number, 1, maxPage) : 1;
        var request = new TableRequest<TItem>(sortKey, descending, page, pageSize)
        {
            Column = column,
            Filters = filters,
            FilterColumns = _columns.Where(c => c.CanFilter).ToList(),
        };

        IReadOnlyList<TItem> items;
        int total;
        if (ItemsProvider is not null)
        {
            // Show the loading state while the provider works (on interactive pages it renders).
            _providerLoading = true;
            if (RendererInfo.IsInteractive)
            {
                StateHasChanged();
            }

            TableResult<TItem> result;
            try
            {
                result = await ItemsProvider(request);
            }
            finally
            {
                if (version == _loadVersion)
                {
                    _providerLoading = false;
                }
            }

            items = result.Items;
            total = result.TotalItems;

            // A page past the end shows the last page.
            if (pageSize is { } size && items.Count == 0 && total > 0 && page > LastPage(total, size))
            {
                page = LastPage(total, size);
                result = await ItemsProvider(request with { Page = page });
                items = result.Items;
                total = result.TotalItems;
            }
        }
        else if (Items is not null)
        {
            var source = AsQuery(Items);
            var sorted = request.ApplySorting(request.ApplyFiltering(source));
            total = sorted.Count();
            if (pageSize is { } size)
            {
                page = Math.Min(page, LastPage(total, size));
                items = sorted.Skip((page - 1) * size).Take(size).ToList();
            }
            else
            {
                items = sorted.ToList();
            }
        }
        else
        {
            items = [];
            total = 0;
        }

        // A slower, older load must not overwrite a newer one.
        if (version != _loadVersion)
        {
            return;
        }

        (_items, _total, _page, _sortKey, _descending) = (items, total, page, sortKey, descending);

        // A page past the end showed the last one; keep that, so the next click counts from it.
        if (UseState)
        {
            _statePage = page;
        }
    }

    private static int LastPage(int total, int size) => Math.Max(1, (int)Math.Ceiling(total / (double)size));

    // Ascending first; a second click on the sorted column turns it descending.
    private string? NextSort(ColumnBase<TItem> column)
    {
        var ascendingNow = string.Equals(column.Key, _sortKey, StringComparison.OrdinalIgnoreCase) && !_descending;
        return ascendingNow ? $"-{column.Key}" : column.Key;
    }

    private string SortHref(ColumnBase<TItem> column) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [SortQueryKey] = NextSort(column),
            [PageKey] = null,
        });

    private bool IsSorted(ColumnBase<TItem> column) => string.Equals(column.Key, _sortKey, StringComparison.OrdinalIgnoreCase);

    private string? AriaSort(ColumnBase<TItem> column) => !column.CanSort ? null : !IsSorted(column) ? "none" : _descending ? "descending" : "ascending";

    private IconRole SortIcon(ColumnBase<TItem> column) =>
        !IsSorted(column) ? IconRole.Sortable : _descending ? IconRole.SortDescending : IconRole.SortAscending;

    private static string? CellClass(ColumnBase<TItem> column)
    {
        var align = column.EffectiveAlign switch
        {
            CellAlign.Center => "ib-cell-center",
            CellAlign.End => "ib-cell-end",
            _ => null,
        };

        var classes = string.Join(' ', new[] { align, column.Class }.Where(c => !string.IsNullOrEmpty(c)));
        return classes.Length > 0 ? classes : null;
    }

    private static string? WidthStyle(ColumnBase<TItem> column) =>
        column.Width is { } width ? $"width:{StyleValues.Length(width)}" : null;

    private string Summary(int size)
    {
        var first = (_page - 1L) * size + 1;
        var last = Math.Min((long)_page * size, _total);
        return string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TableRange, first, last, _total);
    }

    private string PagesLabel =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TablePages, Caption ?? TextDefaults.TableName);

    /// <inheritdoc />
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _filterDelay?.Cancel();
    }
}
