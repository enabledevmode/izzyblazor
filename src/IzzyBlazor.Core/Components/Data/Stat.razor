@namespace IzzyBlazor
@inherits LayoutItemBase
@attribute [ModeSupport]

@*
    A key figure: a label, a large value, and optionally how it changed and a note. No script.

    <Stat Label="Revenue"
          Value="$48,210"
          Change="12%"
          Trend="StatTrend.Up"
          Description="vs last month" />

    Accessibility:
    - It renders a `dl`: `Label` is the `dt`, the value a `dd`, and the change and note share a
      second `dd`, so the label names the figure for screen readers.
    - The trend arrow is hidden from screen readers; the change is read with `TrendLabel` in front
      of it, "Up", "Down" or "No change" by default.
    - The change's color isn't read, so when the color carries meaning (`ChangeStatus`), say it in
      `Description` or `TrendLabel` too.
    - The `Icon` is decorative and hidden from screen readers.
    - A `Sparkline` is an image named by `SparklineLabel` (or `Label`), with the first, last, lowest and
      highest values. Give the period in `SparklineLabel`, such as "Revenue, last 12 weeks".
    See also: Card, DescriptionList, Progress, Badge.
*@

<div @attributes="AdditionalAttributes" class="@_class" style="@_style">
    <dl class="ib-stat-body">
        <dt class="ib-stat-label">@Label</dt>
        <dd class="ib-stat-value">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Value
            }
        </dd>
        @if (Change is not null || Trend != StatTrend.None || Description is not null)
        {
            <dd class="ib-stat-meta">
                @if (Change is not null || Trend != StatTrend.None)
                {
                    <span class="@ChangeClass">
                        @if (Trend != StatTrend.None)
                        {
                            <Icon Purpose="TrendIcon" Class="ib-stat-trend" />
                            <span class="ib-visually-hidden">@(EffectiveTrendLabel + " ")</span>
                        }
                        @Change
                    </span>
                }
                @if (Description is not null)
                {
                    <span class="ib-stat-description">@Description</span>
                }
            </dd>
        }
        @if (Sparkline is not null)
        {
            <dd class="ib-stat-spark">
                <Sparkline Values="Sparkline" Label="@(SparklineLabel ?? Label ?? "")" Type="SparklineType" Points="SparklinePoints" ValueFormat="@SparklineFormat" />
            </dd>
        }
    </dl>
    @if (Icon is { } icon)
    {
        <span class="ib-stat-icon" aria-hidden="true"><Icon Name="icon" /></span>
    }
</div>

@code {
    /// <summary>What the figure is, such as "Revenue".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The figure, such as "$48,210". Format it the way it should read.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Custom value content, such as a number with a unit in smaller text. Replaces <see cref="Value"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>How much it changed, such as "12%" or "+340".</summary>
    [Parameter] public string? Change { get; set; }

    /// <summary>Which way it moved: adds an arrow before <see cref="Change"/> and colors it.</summary>
    [Parameter] public StatTrend Trend { get; set; }

    /// <summary>
    /// The change's color. By default up is <see cref="Status.Success"/>, down is
    /// <see cref="Status.Danger"/> and flat is neutral; set it when down is good, such as for costs
    /// or response times.
    /// </summary>
    [Parameter] public Status? ChangeStatus { get; set; }

    /// <summary>Read before the change in place of the arrow. Defaults to "Up", "Down" or "No change".</summary>
    [Parameter] public string? TrendLabel { get; set; }

    /// <summary>A muted note after the change, such as "vs last month".</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>
    /// Recent values to draw as a sparkline under the figure, such as the last twelve weeks. It's
    /// named by <see cref="Label"/>, which it needs.
    /// </summary>
    [Parameter] public IEnumerable<double?>? Sparkline { get; set; }

    /// <summary>
    /// The <see cref="Sparkline"/>'s name for screen readers, with its period, such as "Revenue, last
    /// 12 weeks". Defaults to <see cref="Label"/>.
    /// </summary>
    [Parameter] public string? SparklineLabel { get; set; }

    /// <summary>How the <see cref="Sparkline"/> draws: a line (the default), an area or bars.</summary>
    [Parameter] public SparklineType SparklineType { get; set; }

    /// <summary>The <see cref="Sparkline"/>'s marked values: the last (the current one) by default. See <see cref="IzzyBlazor.Sparkline.Points"/>.</summary>
    [Parameter] public SparklinePoints SparklinePoints { get; set; } = SparklinePoints.Last;

    /// <summary>A .NET format string for the <see cref="Sparkline"/>'s values as a screen reader hears them, such as <c>C0</c>.</summary>
    [Parameter] public string? SparklineFormat { get; set; }

    /// <summary>An icon in a tinted square at the end.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>Text size. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    private string? _class;
    private string? _style;

    private IconPurpose TrendIcon => Trend switch
    {
        StatTrend.Up => IconPurpose.TrendUp,
        StatTrend.Down => IconPurpose.TrendDown,
        _ => IconPurpose.TrendFlat,
    };

    private string EffectiveTrendLabel => TrendLabel ?? Trend switch
    {
        StatTrend.Up => TextDefaults.TrendUp,
        StatTrend.Down => TextDefaults.TrendDown,
        _ => TextDefaults.TrendFlat,
    };

    private Status EffectiveChangeStatus => ChangeStatus ?? Trend switch
    {
        StatTrend.Up => Status.Success,
        StatTrend.Down => Status.Danger,
        _ => Status.Neutral,
    };

    private string ChangeClass => $"ib-stat-change ib-stat-change-{EffectiveChangeStatus.ToString().ToLowerInvariant()}";

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-stat");
        classes.Add("ib-stat-sm", Size == ControlSize.Sm);
        classes.Add("ib-stat-lg", Size == ControlSize.Lg);
        classes.Add("ib-stat-sparked", Sparkline is not null);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Sparkline is not null && string.IsNullOrWhiteSpace(SparklineLabel ?? Label))
        {
            throw new InvalidOperationException("A Stat with a Sparkline needs a Label or SparklineLabel, which names the sparkline.");
        }

        (_class, _style) = BuildRootAttributes();
    }
}
