    /// <inheritdoc />
    internal override void ColumnsChanged() => _shown = null;

    /// <inheritdoc />
    public override void Dispose()
    {
        base.Dispose();
        _persisting?.Dispose();
        _searchDelay?.Cancel();
    }

    // Its key in a layout. Not every column has a sort key; its title is the next best.
    private static string KeyOf(ColumnBase<TItem> column) => column.Key ?? column.HeaderText;

    private string? WidthOf(ColumnBase<TItem> column) =>
        CurrentLayout?.Column(KeyOf(column))?.Width ?? (column.Width is { } width ? StyleValues.Length(width) : null);

    // A layout can freeze a column only if it has a width to be placed by.
    private ColumnFrozen FrozenOf(ColumnBase<TItem> column)
    {
        // A stored layout can't freeze a column on a grid that can't have frozen columns.
        // A band is frozen as one, as its first column is, so it never straddles the frozen edge.
        if (column.Band is { } band)
        {
            // The script sets all of a band's columns, hidden ones too; only those shown need widths.
            var outer = band.Chain[0];
            var members = AllColumns.Where(c => c.Band?.Chain[0] == outer).ToList();
            var first = OwnFrozen(members[0]);
            return first != ColumnFrozen.None && members.Any(c => !HiddenByLayout(c) && WidthOf(c) is null) ? ColumnFrozen.None : first;
        }

        var frozen = OwnFrozen(column);
        return frozen != ColumnFrozen.None && WidthOf(column) is null ? ColumnFrozen.None : frozen;
    }

    private bool HiddenByLayout(ColumnBase<TItem> column) =>
        !(column.Pickable && CurrentLayout?.Column(KeyOf(column))?.Hidden is { } hidden ? !hidden : column.Visible);

    private ColumnFrozen OwnFrozen(ColumnBase<TItem> column) =>
        RowHref is not null ? column.Frozen : CurrentLayout?.Column(KeyOf(column))?.Frozen ?? column.Frozen;

    // Start, then the rest, then end, whatever order they were declared or came in: a frozen column
    // among those that scroll would overlap them. Within those, a layout's place, else the declared one.
    // At least one always shows: a layout that hides them all is ignored for that.
    /// <inheritdoc />
    internal override IReadOnlyList<ColumnBase<TItem>> Shown
    {
        get
        {
            var grouping = Grouping;
            if (!ReferenceEquals(grouping, _shownFor))
            {
                (_shown, _shownFor) = (null, grouping);
            }

            return _shown ??= Arrange();
        }
    }

    private List<ColumnBase<TItem>> Arrange()
    {
        // One the page says can't be hidden isn't, whatever a stored layout says.
        // Visible says how it starts. What someone chose goes first, on a column they can choose.
        var visible = AllColumns.Where(c => !GroupedColumnLeaves(c) && !HiddenByLayout(c)).ToList();
        return InOrder(visible.Count > 0 ? visible : AllColumns);
    }

    // Columns in the grid's order: frozen at start, the rest, frozen at end, each by its saved place
    // or its declared one, a band's columns together. The picker lists hidden ones the same way.
    private List<ColumnBase<TItem>> InOrder(IReadOnlyList<ColumnBase<TItem>> columns)
    {
        var layout = CurrentLayout;
        var placed = columns
            .Select((column, index) => (column, index, place: layout?.Column(KeyOf(column))?.Position ?? index))
            .ToList();
        if (!HasBands)
        {
            return placed
                .OrderBy(x => FrozenOf(x.column) switch { ColumnFrozen.Start => 0, ColumnFrozen.End => 2, _ => 1 })
                .ThenBy(x => x.place)
                .Select(x => x.column)
                .ToList();
        }

        // A band's columns stay together: siblings (a column, or a band with all its columns) are in
        // order of the first place among their columns, so moving a band moves its columns' places.
        var bandPlace = new Dictionary<ColumnBand, int>();
        foreach (var (column, _, place) in placed)
        {
            foreach (var band in column.Band?.Chain ?? [])
            {
                bandPlace[band] = Math.Min(bandPlace.GetValueOrDefault(band, int.MaxValue), place);
            }
        }

        // The key of each step down from the top: a band's place (and its number, should two share
        // one), then the column's.
        List<(int Place, int Tie)> Key((ColumnBase<TItem> column, int index, int place) x) =>
            [.. (x.column.Band?.Chain ?? []).Select(b => (bandPlace[b], BandId(b))), (x.place, int.MaxValue / 2 + x.index)];

        return placed
            .OrderBy(x => FrozenOf(x.column) switch { ColumnFrozen.Start => 0, ColumnFrozen.End => 2, _ => 1 })
            .ThenBy(Key, KeyOrder.Instance)
            .Select(x => x.column)
            .ToList();
    }

    private sealed class KeyOrder : IComparer<List<(int Place, int Tie)>>
    {
        public static readonly KeyOrder Instance = new();

        public int Compare(List<(int Place, int Tie)>? x, List<(int Place, int Tie)>? y)
        {
            for (var i = 0; i < Math.Min(x!.Count, y!.Count); i++)
            {
                var step = x[i].CompareTo(y[i]);
                if (step != 0)
                {
                    return step;
                }
            }

            return x.Count.CompareTo(y.Count);
        }
    }

    /// <inheritdoc />
    internal override RenderFragment? ColGroup => Shown.Count == 0 ? null : __builder =>
    {
        @* An empty group would be a column of its own. *@
        @if (!HasBands || GripColumn || SelectColumn || LeadSpan > 0)
        {
        <colgroup>
            @if (GripColumn)
            {
                <col class="ib-datagrid-grip-col" />
            }
            @if (SelectColumn)
            {
                <col class="ib-datagrid-select-col" />
            }
            @for (var i = 0; i < LeadSpan; i++)
            {
                if (ExpanderComesAndGoes && i == LeadSpan - 1)
                {
                    <col class="ib-grid-lead-col" style="width:var(--ib-grid-expander, var(--ib-datagrid-group))" />
                }
                else
                {
                    <col class="ib-grid-lead-col" />
                }
            }
            @if (!HasBands)
            {
                @for (var i = 0; i < Shown.Count; i++)
                {
                    @ColumnCol(i)
                }
                @if (HasLastCell)
                {
                    <col class="ib-datagrid-menu-col" style="@(TrailExpander ? $"width:calc({LastWidth})" : null)" />
                }
            }
        </colgroup>
        }
        @* With bands, a group per band, which its scope="colgroup" names, or per column with none. *@
        @if (HasBands)
        {
            @foreach (var span in OuterBands())
            {
                <colgroup>
                    @for (var i = span.First; i <= span.Last; i++)
                    {
                        @ColumnCol(i)
                    }
                </colgroup>
            }
            @if (HasLastCell)
            {
                <colgroup>
                    <col class="ib-datagrid-menu-col" style="@(TrailExpander ? $"width:calc({LastWidth})" : null)" />
                </colgroup>
            }
        }
    };

    private RenderFragment ColumnCol(int i) => __builder =>
    {
        <col class="@ColClass(Shown[i])" style="@(FixedWidth(i) is null ? null : $"width:var(--ib-col-{i})")" />
    };

    /// <inheritdoc />
    internal override bool BandBreaks(ColumnBase<TItem> before, ColumnBase<TItem> after) => FrozenOf(before) != FrozenOf(after);

    // As its columns: frozen at their edge, and, once every one of them hides, hidden with the last.
    /// <inheritdoc />
    internal override string? BandColumnsClass(BandSpan span)
    {
        var columns = Enumerable.Range(span.First, span.Count).Select(i => Shown[i]).ToList();
        var frozen = FrozenOf(columns[0]);
        var classes = new List<string>();
        if (frozen != ColumnFrozen.None)
        {
            var side = frozen == ColumnFrozen.Start ? "start" : "end";
            classes.Add($"ib-frozen ib-frozen-{side}");
            if (columns.Any(c => ColumnClass(c)?.Contains("ib-frozen-edge", StringComparison.Ordinal) == true))
            {
                classes.Add("ib-frozen-edge");
            }
        }
        else if (Hiding && columns.All(c => Plan.Levels.ContainsKey(c)))
        {
            classes.Add($"ib-h{columns.Max(c => Plan.Levels[c])}");
        }

        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    // A frozen band sits where its first column does at the start, or its last at the end.
    /// <inheritdoc />
    internal override string? BandStyle(BandSpan span) =>
        FrozenOf(Shown[span.First]) switch
        {
            ColumnFrozen.Start => CellStyle(Shown[span.First]),
            ColumnFrozen.End => CellStyle(Shown[span.Last]),
            _ => null,
        };

    // How many buttons wide the action column is: as the most a row has, the ⋮ among them. Save and
    // Cancel have to fit, and starting an edit mustn't move the columns.
    private int ActionButtons
    {
        get
        {
            var buttons = _items.Count == 0 ? 1 : _items.Max(i => ActionCount(i) is var (count, menu, auto) ? count + auto + (menu ? 1 : 0) : 0);
            return InRow || (CellMode && CanAdd) ? Math.Max(buttons, 2) : buttons;
        }
    }

    // The same once columns hide, and buttons that fold are in the ⋮.
    private int FoldedActionButtons
    {
        get
        {
            var buttons = _items.Count == 0 ? 1 : _items.Max(i => ActionCount(i) is var (count, menu, auto) ? count + (menu || auto > 0 ? 1 : 0) : 0);
            return InRow || (CellMode && CanAdd) ? Math.Max(buttons, 2) : buttons;
        }
    }

    // Widths are variables on the table, so one change later (a resize) moves everything that uses
    // them. Fixed layout shares the rest equally whatever each column's minimum, so the grid's
    // minimum gives every unset column the largest of them.
    /// <inheritdoc />
    internal override string? GridStyle
    {
        get
        {
            // Before the columns register (a page still streaming), a message takes the whole width.
            if (Shown.Count == 0)
            {
                return "table-layout:auto";
            }

            CheckFrozen();
            CheckEditing();
            CheckDetails();
            var style = new System.Text.StringBuilder();
            var parts = new List<string>();
            var unset = new List<string>();
            for (var i = 0; i < Shown.Count; i++)
            {
                if (FixedWidth(i) is { } width)
                {
                    style.Append($"--ib-col-{i}:{width};");
                    parts.Add($"var(--ib-col-{i})");
                }
                else
                {
                    unset.Add((i == 0 ? FirstColumnWidth(Shown[i]) : null) ?? (Shown[i].MinWidth is { } min ? StyleValues.Length(min) : HeaderMinWidth(Shown[i])));
                }
            }

            if (GripColumn)
            {
                parts.Add("var(--ib-datagrid-grip)");
            }

            if (SelectColumn)
            {
                parts.Add("var(--ib-datagrid-select)");
            }

            if (LeadSpan > 0)
            {
                parts.Add(LeadWidths);
            }

            if (HasActionCell)
            {
                var buttons = ActionButtons;
                if (buttons > 1)
                {
                    style.Append(System.FormattableString.Invariant($"--ib-datagrid-menu:{0.75 + 2.25 * buttons}rem;"));
                }

                parts.Add("var(--ib-datagrid-menu)");
            }

            if (TrailExpander)
            {
                parts.Add(HasActionCell ? "var(--ib-grid-expander, var(--ib-datagrid-group))" : LastWidth);
            }

            if (unset.Count > 0)
            {
                parts.Add($"{unset.Count} * max({string.Join(", ", unset.Distinct())})");
            }

            if (parts.Count > 0)
            {
                style.Append($"{(unset.Count > 0 ? "min-width" : "width")}:calc({string.Join(" + ", parts)})");
            }

            return style.Length > 0 ? style.ToString() : null;
        }
    }

    /// <inheritdoc />
    internal override string? HeaderStyle(ColumnBase<TItem> column) => CellStyle(column);

    /// <inheritdoc />
    internal override string SelectCellClass =>
        Shown.Any(c => FrozenOf(c) == ColumnFrozen.Start) ? "ib-table-select-cell ib-frozen ib-frozen-start" : "ib-table-select-cell";

    /// <inheritdoc />
    internal override string? ColumnClass(ColumnBase<TItem> column)
    {
        var frozen = FrozenOf(column);
        if (frozen == ColumnFrozen.None)
        {
            return HideClass(column);
        }

        var side = frozen == ColumnFrozen.Start ? "start" : "end";
        // The one beside the columns that scroll draws the line between them.
        var edge = frozen == ColumnFrozen.Start
            ? column == Shown.LastOrDefault(c => FrozenOf(c) == ColumnFrozen.Start)
            : column == Shown.FirstOrDefault(c => FrozenOf(c) == ColumnFrozen.End);
        return edge ? $"ib-frozen ib-frozen-{side} ib-frozen-edge" : $"ib-frozen ib-frozen-{side}";
    }

    // Its offset: the widths between it and its edge, and the selection column at the start.
    /// <inheritdoc />
    internal override string? CellStyle(ColumnBase<TItem> column)
    {
        var frozen = FrozenOf(column);
        if (frozen == ColumnFrozen.None)
        {
            return null;
        }

        var index = _shown!.IndexOf(column);
        var parts = new List<string>();
        if (frozen == ColumnFrozen.Start)
        {
            if (GripColumn)
            {
                parts.Add("var(--ib-datagrid-grip)");
            }

            if (SelectColumn)
            {
                parts.Add("var(--ib-datagrid-select)");
            }

            if (LeadSpan > 0)
            {
                parts.Add(LeadWidths);
            }

            for (var i = 0; i < index; i++)
            {
                parts.Add($"var(--ib-col-{i})");
            }
        }
        else
        {
            for (var i = index + 1; i < Shown.Count; i++)
            {
                parts.Add($"var(--ib-col-{i})");
            }

            if (HasLastCell)
            {
                parts.Add(LastWidth);
            }
        }

        return parts.Count == 0 ? null : $"--ib-frozen-at:calc({string.Join(" + ", parts)})";
    }

    // A frozen cell is the containing block of the row's stretched link, and sits above it, so the
    // link wouldn't cover the row.
    private void CheckFrozen()
    {
        if (RowHref is not null && Shown.Any(c => FrozenOf(c) != ColumnFrozen.None))
        {
            throw new InvalidOperationException($"A {ViewName} can't have both {nameof(RowHref)} and {nameof(ColumnBase<TItem>.Frozen)} columns yet: use a link in a cell.");
        }

        // A band is frozen as one: a column frozen on its own would leave the band split at the edge.
        foreach (var band in AllColumns.Where(c => c.Band is not null).GroupBy(c => c.Band!.Chain[0]))
        {
            if (band.Select(c => c.Frozen).Distinct().Skip(1).Any())
            {
                throw new InvalidOperationException($"The \"{BandFullName(band.Key)}\" band's columns are frozen differently: set the same {nameof(ColumnBase<TItem>.Frozen)} on all of them, as a band is frozen as one.");
            }
        }

        if (Rearrangeable)
        {
            // A layout finds columns by key: two with one, or one with none, would be mixed up.
            var taken = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var column in AllColumns)
            {
                if (string.IsNullOrEmpty(KeyOf(column)) || !taken.Add(KeyOf(column)))
                {
                    throw new InvalidOperationException($"The \"{column.FullName}\" column needs a {nameof(ColumnBase<TItem>.SortKey)} of its own, since people can rearrange the columns: its key is empty or another column's.");
                }
            }
        }
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-datagrid");
        classes.Add("ib-datagrid-virtual", VirtualRows);
        classes.Add("ib-datagrid-grip", GripColumn);
        // Hiding goes by the width it's given, so it takes all of it rather than its columns' width.
        classes.Add("ib-datagrid-fill", SmallScreen == DataGridSmallScreen.HideColumns);
        base.BuildAttributes(classes, styles);
    }
}
