    RenderFragment IDataGridToolbar.FilterBuilderBar(bool showText) => __builder =>
    {
        var active = UseState ? ExtraFilter is not null : QueryString.Of(Navigation.Uri).ContainsKey(FilterTextKey);
        <div class="ib-toolbar-item ib-filter-builder-tool">
            <Popover Id="@BuilderPanelId" Placement="Placement.BottomStart" PanelWidth="Length.Rem(48)" data-ib-user-controlled>
                <Trigger>
                    @if (showText)
                    {
                        <Button StartIcon="IconSet.Current.Get(IconPurpose.Filter)" Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" data-active="@(active ? "" : null)" @attributes="context">@TextDefaults.FilterBuilderLabel</Button>
                    }
                    else
                    {
                        <Button StartIcon="IconSet.Current.Get(IconPurpose.Filter)" IconOnly Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" aria-label="@TextDefaults.FilterBuilderLabel" title="@TextDefaults.FilterBuilderLabel" data-active="@(active ? "" : null)" @attributes="context" />
                    }
                </Trigger>
                <ChildContent>
                    @if (UseState)
                    {
                        <FilterBuilder TItem="TItem" Fields="BuilderFields" Name="@FilterTextKey" PageKey="@PageKey" CursorKey="@CursorKey" Value="ExtraFilter" ValueChanged="SetExtraFilterAsync" />
                    }
                    else
                    {
                        <FilterBuilder TItem="TItem" Fields="BuilderFields" Name="@FilterTextKey" PageKey="@PageKey" CursorKey="@CursorKey" />
                    }
                </ChildContent>
            </Popover>
        </div>
    };

    /// <inheritdoc />
    internal override bool ShowsFilterRow => FilterRow;

    /// <inheritdoc />
    internal override string? ValuesGridSearch => CurrentSearch;

    /// <inheritdoc />
    internal override bool ExtraBound => base.ExtraBound || SearchChanged.HasDelegate || EditKeyChanged.HasDelegate || GroupBound || DetailBound;

    /// <inheritdoc />
    internal override bool NeedsFilterForm => base.NeedsFilterForm || Searchable;

    /// <inheritdoc />
    internal override IEnumerable<string> ExtraFilterKeys => Searchable ? [SearchKey] : [];

    /// <inheritdoc />
    internal override string FilterSignature() => $"{base.FilterSignature()}|{CurrentSearch}|{GroupSignature}";

    /// <inheritdoc />
    internal override DataRequest<TItem> Shape(DataRequest<TItem> request, string? sortRaw) =>
        base.Shape(request, sortRaw) with { Search = CurrentSearch };

    private async Task OnSearchAsync(ChangeEventArgs e)
    {
        _stateSearch = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();
        _reportedSearch = _stateSearch;
        _searchDelay?.Cancel();
        var delay = _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(FilterDelay, delay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_statePage, _stateCursor) = (1, null);
        await SearchChanged.InvokeAsync(_stateSearch);
        await ReportFirstPageAsync(pageWas, cursorWas);
        await ReloadIfStaleAsync();
    }

    // A static page can only keep a change by having it saved and asking for the page again.
    private bool CanSave => WillBeInteractive || LayoutKey is not null || LayoutSaveUrl is not null;

    private bool Rearrangeable => (ResizableColumns || ReorderableColumns || ColumnPicker) && CanSave;

    private DataGridLayout? _stored;
    private PersistingComponentStateSubscription? _persisting;
    private List<ColumnBase<TItem>>? _shown;
    private GroupState? _shownFor;

    // One bound follows the parent; given one-way, what people choose after it wins.
    private DataGridLayout? CurrentLayout => LayoutChanged.HasDelegate || !_rearranged ? Layout ?? _stored : _stored;

    private bool _rearranged;

    private string CookieName => $"ib-grid-{LayoutKey}";

    internal Func<DataGroupRequest<TItem>, ValueTask<DataGroupResult>>? GroupsProvider { get; set; }

    /// <inheritdoc />
    internal override Func<DataGroupRequest<TItem>, ValueTask<DataGroupResult>>? GroupsSource => GroupsProvider;

    /// <inheritdoc />
    internal override string ViewName => "DataGrid";

    /// <inheritdoc />
    internal override RenderFragment? GroupRows => _groupRoots is not { Count: > 0 } roots ? null : __builder =>
    {
        foreach (var root in roots)
        {
            @GroupRow(root)
        }
    };

    private RenderFragment GroupRow(GroupNode node) => __builder =>
    {
        // The label starts in the lead column of its level and spans up to the first aggregate, which
        // sits in its own column. One in the first column has no cell of its own: it goes after the label.
        var shown = Shown.ToList();
        var first = shown.FindIndex(c => c.AggregateIn(AggregatePlace.GroupRow) is not null);
        var next = first == 0 ? shown.FindIndex(1, c => c.AggregateIn(AggregatePlace.GroupRow) is not null) : first;
        var span = next < 0 ? shown.Count : next;
        var value = node.Level.Column.GroupText(node.Value) ?? TextDefaults.GroupNone;
        <tr class="ib-grid-group" data-ib-key="@($"g:{node.Path}")" aria-level="@(node.Depth + 1)" aria-expanded="@(node.Open ? "true" : "false")" aria-posinset="@node.Position" aria-setsize="@node.SetSize">
            @GripEmptyCell
            @if (SelectColumn)
            {
                <td class="@SelectCellClass">
                    @* Its rows, when they're drawn: the script ticks them, and they report their own changes. *@
                    @if (MultiSelect && node.Open && HasRows(node))
                    {
                        <input type="checkbox" class="ib-check-input ib-table-group-select" aria-label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.GroupSelect, value)" />
                    }
                </td>
            }
            @if (node.Depth > 0)
            {
                <td class="@LeadClass" style="@LeadStyle" colspan="@node.Depth"></td>
            }
            <th scope="row" colspan="@(LeadSpan - node.Depth + span)" style="@LabelAt(node.Depth)">
                @* Sticks, as the cell is as wide as its columns and a frozen column may be under it. *@
                <span class="ib-grid-group-label">
                    @if (UseState)
                    {
                        <button type="button" class="ib-grid-group-toggle" aria-expanded="@(node.Open ? "true" : "false")" @onclick="() => ToggleGroupAsync(node)">
                            <Icon Purpose="IconPurpose.ChevronRight" />
                            @GroupLabel(node, value)
                        </button>
                    }
                    else
                    {
                        <a class="ib-grid-group-toggle" href="@ToggleHref(node)" aria-expanded="@(node.Open ? "true" : "false")">
                            <Icon Purpose="IconPurpose.ChevronRight" />
                            @GroupLabel(node, value)
                        </a>
                    }
                    @if (first == 0)
                    {
                        <span class="ib-grid-group-aggregate">@AggregateCell(shown[0], node.Group, AggregatePlace.GroupRow)</span>
                    }
                </span>
            </th>
            @foreach (var column in Shown.Skip(span))
            {
                <td class="@CellClass(column)" style="@CellStyle(column)">@AggregateCell(column, node.Group, AggregatePlace.GroupRow)</td>
            }
            @LastEmptyCell
        </tr>
        if (node.Open)
        {
            foreach (var child in node.Children)
            {
                @GroupRow(child)
            }

            for (var i = 0; i < node.Rows.Count; i++)
            {
                @DataRow(node.Rows[i], node.FirstRow + i, null, node.Depth + 1)
                @AfterRow(node.Rows[i], node.FirstRow + i, node.Depth + 1)
            }

            if (Shown.Any(c => c.AggregateIn(AggregatePlace.GroupFooter) is not null))
            {
                <tr class="ib-grid-group-foot" aria-level="@(node.Depth + 2)">
                    @GripEmptyCell
                    @if (SelectColumn)
                    {
                        <td class="@SelectCellClass"></td>
                    }
                    @LeadCell
                    @foreach (var column in Shown)
                    {
                        <td class="@CellClass(column)" style="@CellStyle(column)">@AggregateCell(column, node.Group, AggregatePlace.GroupFooter)</td>
                    }
                    @LastEmptyCell
                </tr>
            }

            if (node.Children.Count == 0 && node.Group.Count > node.Rows.Count)
            {
                <tr class="ib-grid-group-more" aria-level="@(node.Depth + 2)">
                    @GripEmptyCell
                    @if (SelectColumn)
                    {
                        <td class="@SelectCellClass"></td>
                    }
                    @LeadCell
                    <td colspan="@(Shown.Count + (LastEmptyCell is null ? 0 : 1))">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.GroupShowing, node.Rows.Count, node.Group.Count)
                        @if (OnlyThisGroup(node) is { } only)
                        {
                            @(" ")
                            if (UseState)
                            {
                                <button type="button" class="ib-link" @onclick="() => OnlyThisGroupAsync(only)">@TextDefaults.GroupShowOnly</button>
                            }
                            else
                            {
                                <a href="@OnlyThisGroupHref(only)">@TextDefaults.GroupShowOnly</a>
                            }
                        }
                    </td>
                </tr>
            }
        }
    };

    private RenderFragment GroupLabel(GroupNode node, string value) => __builder =>
    {
        if (node.Level.Column.GroupTemplate is { } template)
        {
            @template(new DataGridGroup(node.Value, value, node.Group, node.Depth, node.Open))
        }
        else
        {
            @string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.GroupLabel, node.Level.Column.FullName, value)
        }

        @(" ")
        @string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.GroupCount, node.Group.Count)
    };

    /// <inheritdoc />
    internal override int LeadSpan => Grouping.Levels.Count + (LeadExpander ? 1 : 0);

    // The lead columns hold the groups' chevrons: frozen with the start columns, after the selection.
    private string LeadClass => Shown.Any(c => FrozenOf(c) == ColumnFrozen.Start) ? "ib-grid-lead ib-frozen ib-frozen-start" : "ib-grid-lead";

    private string? LeadStyle => StartSpan > 0 && Shown.Any(c => FrozenOf(c) == ColumnFrozen.Start) ? $"--ib-frozen-at:calc({StartWidths}0px)" : null;

    // Where a label sticks: past the selection and the lead columns of the levels above it.
    private string LabelAt(int depth) =>
        $"--ib-group-at:calc({StartWidths}{depth} * var(--ib-datagrid-group))";

    /// <inheritdoc />
    internal override RenderFragment? LeadCell => LeadSpan == 0 ? null : __builder =>
    {
        <td class="@LeadClass" style="@LeadStyle" colspan="@LeadSpan"></td>
    };

    /// <inheritdoc />
    internal override RenderFragment? LeadHeader => LeadSpan == 0 ? null : __builder =>
    {
        // One control opens or closes them all: the groups, over their lead columns, and the details.
        var levels = Grouping.Levels.Count;
        if (levels > 0)
        {
            var state = Grouping;
            var all = state.AllOpen && state.Shut.Count == 0;
            var label = all ? TextDefaults.GroupCollapseAll : TextDefaults.GroupExpandAll;
            <th scope="col" class="@LeadClass" style="@LeadStyle" colspan="@levels">
                @if (UseState)
                {
                    <button type="button" class="ib-grid-expand" aria-expanded="@(all ? "true" : "false")" aria-label="@label" title="@label" @onclick="() => SetAllOpenAsync(!all)"><Icon Purpose="IconPurpose.ChevronRight" /></button>
                }
                else
                {
                    <a class="ib-grid-expand" href="@AllOpenHref(!all)" aria-expanded="@(all ? "true" : "false")" aria-label="@label" title="@label"><Icon Purpose="IconPurpose.ChevronRight" /></a>
                }
            </th>
        }

        if (LeadExpander)
        {
            var all = Details.AllOpen;
            var label = all ? TextDefaults.DetailCollapseAll : TextDefaults.DetailExpandAll;
            <th scope="col" class="@ExpanderClass" style="@ExpanderStyle">
                @if (SingleDetail)
                {
                    <span class="ib-visually-hidden">@TextDefaults.DetailColumn</span>
                }
                else if (UseState)
                {
                    <button type="button" class="ib-grid-expand" aria-expanded="@(all ? "true" : "false")" aria-label="@label" title="@label" @onclick="() => SetDetailsAsync(AllDetails(!all, ExpandAllDetails))"><Icon Purpose="IconPurpose.ChevronRight" /></button>
                }
                else
                {
                    <a class="ib-grid-expand" href="@AllDetailsHref(!all)" aria-expanded="@(all ? "true" : "false")" aria-label="@label" title="@label"><Icon Purpose="IconPurpose.ChevronRight" /></a>
                }
            </th>
        }
    };

    // The detail buttons' column: frozen past the selection and the groups' lead columns.
    private string? ExpanderStyle => Shown.Any(c => FrozenOf(c) == ColumnFrozen.Start)
        ? $"--ib-frozen-at:calc({StartWidths}{Grouping.Levels.Count} * var(--ib-datagrid-group))"
        : null;

    // Hiding with no template, the button column goes while nothing is hidden (DataGridSmallScreen.cs).
    private string ExpanderClass => ExpanderComesAndGoes ? LeadClass + " ib-hx" : LeadClass;

    // The lead columns' width: the button column's is 0 while it's gone.
    private string LeadWidths => ExpanderComesAndGoes
        ? $"{Grouping.Levels.Count} * var(--ib-datagrid-group) + var(--ib-grid-expander, var(--ib-datagrid-group))"
        : $"{LeadSpan} * var(--ib-datagrid-group)";

    /// <inheritdoc />
    internal override RenderFragment? RowLead(TItem item, int row) => !LeadExpander ? LeadCell : __builder =>
    {
        var levels = Grouping.Levels.Count;
        if (levels > 0)
        {
            <td class="@LeadClass" style="@LeadStyle" colspan="@levels"></td>
        }
        <td class="@ExpanderClass" style="@ExpanderStyle">@DetailButton(item, row)</td>
    };

    // A row's button for its detail: a chevron that turns right to down at the row's start; at its end
    // (a TreeList's), one that points down and turns over.
    private RenderFragment DetailButton(TItem item, int row) => __builder =>
    {
        @* Not while it's open only for an edit, which closes it. *@
        @if (HasDetail(item) && (Details.IsOpen(KeyOf(item)) || !DetailOpen(item)))
        {
            var key = KeyOf(item);
            var open = DetailOpen(item);
            var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, open ? TextDefaults.DetailHide : TextDefaults.DetailShow, LabelOf(item));
            // One with only hidden values to show goes while nothing is hidden.
            var css = (HasTemplateDetail(item) ? "ib-grid-expand" : "ib-grid-expand ib-hx") + (TrailExpander ? " ib-grid-expand-down" : "");
            var icon = TrailExpander ? IconPurpose.ChevronDown : IconPurpose.ChevronRight;
            if (UseState)
            {
                <button type="button" class="@css" aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? DetailId(row) : null)" aria-label="@label" title="@label" @onclick="() => ToggleDetailAsync(key)"><Icon Purpose="icon" /></button>
            }
            else
            {
                <a class="@css" href="@DetailHref(key)" aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? DetailId(row) : null)" aria-label="@label" title="@label"><Icon Purpose="icon" /></a>
            }
        }
    };

    /// <inheritdoc />
    // Open only for an edit, it shows only while a column is hidden: there are no fields in it otherwise.
    internal override RenderFragment? AfterRow(TItem item, int row, int? indent) => !DetailOpen(item) ? null : DetailRow(item, row, indent, HasTemplateDetail(item) && Details.IsOpen(KeyOf(item)));

    // The new row being added: its hidden columns' fields go in a detail under it, as for any row.
    /// <inheritdoc />
    internal override RenderFragment? AfterNewRow(TItem item) => !Hiding ? null : DetailRow(item, -1, null, false);

    // One cell across the grid. Its content starts under the row's data, and stays in view when the
    // grid scrolls sideways.
    private RenderFragment DetailRow(TItem item, int row, int? indent, bool template) => __builder =>
    {
        <tr class="@(template ? "ib-grid-detail" : "ib-grid-detail ib-hx")" id="@DetailId(row)" aria-level="@(indent + 1)" data-ib-follows="@(HasGrip ? "" : null)">
            <td colspan="@(Shown.Count + StartSpan + LeadSpan + (LastHeaderCell is null ? 0 : 1))" style="@($"--ib-detail-at:calc({StartWidths}{LeadWidths}{DetailIndent(item)})")">
                <div class="ib-grid-detail-content">
                    @if (Hiding)
                    {
                        @HiddenValues(item)
                    }
                    @if (template)
                    {
                        @DetailTemplate!(item)
                    }
                </div>
            </td>
        </tr>
    };

    /// <summary>More room before a row's detail, as " + ...": a TreeList's row's indent, so its detail starts at its value.</summary>
    internal virtual string DetailIndent(TItem item) => "";

    // The widths of the columns before the lead ones, each followed by " + ": the handles and the selection.
    private string StartWidths => (GripColumn ? "var(--ib-datagrid-grip) + " : "") + (SelectColumn ? "var(--ib-datagrid-select) + " : "");

    // Moving rows (DataGridReorder.cs): the drag, the menus' moves in place and their shortcuts on
    // static pages, and the live region that announces every move. Beside the table, as a custom
    // element can't sit between a table and its rows.
    private RenderFragment? RowSorter => !HasGrip ? null : __builder =>
    {
        <ib-sortable class="ib-visually-hidden" data-ib-rows=""
                     data-ib-interactive="@(MovesLive ? "" : null)"
                     data-ib-seq="@(RendererInfo.IsInteractive ? _rowMoveSeq.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)"
                     @onibmove="DropRowAsync" __internal_stopPropagation_onibmove="@RendererInfo.IsInteractive"
                     data-ib-submit="@(PostsOrder && SubmitOnMove ? "" : null)"
                     data-ib-moved="@TextDefaults.MovedTo"
                     data-ib-cancelled="@(MovesLive ? TextDefaults.MoveCancelled : null)">
            @if (PostsOrder)
            {
                @* The form's default button, ahead of the rows' moves: Enter in another field submits the
                   form, rather than pressing the first row's (disabled) Move up. *@
                <button type="submit" class="ib-data-default-submit ib-visually-hidden" tabindex="-1" aria-hidden="true"></button>
            }
            <div role="status">@_moveAnnouncement</div>
            @if (MovesLive)
            {
                @* The script's own, for a drop no render answered: C# owns the one above. *@
                <div role="status" data-ib-say></div>
            }
        </ib-sortable>
    };

    internal string GripCellClass => Shown.Any(c => FrozenOf(c) == ColumnFrozen.Start) ? "ib-grid-grip-cell ib-frozen ib-frozen-start" : "ib-grid-grip-cell";

    /// <inheritdoc />
    internal override string? RowsClass => HasGrip ? "ib-sortable-list" : null;

    /// <inheritdoc />
    internal override string? OwnRowClass => HasGrip ? "ib-sortable-item" : null;

    /// <inheritdoc />
    internal override object? RowKey(string key) => HasGrip ? key : null;

    /// <inheritdoc />
    internal override IReadOnlyDictionary<string, object>? RowAttributes(TItem item) => !HasGrip ? null : CanMove(item) && MoveBlockedReason is null
        ? new Dictionary<string, object> { ["data-ib-label"] = LabelOf(item), ["data-ib-movable"] = "" }
        : new Dictionary<string, object> { ["data-ib-label"] = LabelOf(item) };

    /// <inheritdoc />
    internal override RenderFragment? GripHeader => !GripColumn ? null : __builder =>
    {
        <th scope="col" class="@GripCellClass"><span class="ib-visually-hidden">@TextDefaults.MoveColumn</span></th>
    };

    /// <inheritdoc />
    internal override RenderFragment? GripEmptyCell => !GripColumn ? null : __builder =>
    {
        <td class="@GripCellClass"></td>
    };

    /// <inheritdoc />
    internal override RenderFragment? GripCell(TItem item, int row) => !GripColumn ? null : TreeGrip(item) ?? ReorderGrip(item, row);

    private RenderFragment ReorderGrip(TItem item, int row) => __builder =>
    {
        var key = KeyOf(item);
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.MoveItem, LabelOf(item));
        <td class="@GripCellClass">
            @if (!CanMove(item))
            {
            }
            else if (MoveBlockedReason is { } reason)
            {
                <span title="@reason">
                    <IconButton Icon="Lucide.GripVertical" Label="@($"{label}: {reason}")" Disabled Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-sortable-handle" />
                </span>
            }
            else
            {
                var focus = !MovesLive && key == _moveFocusKey;
                <Menu>
                    <Trigger Context="wire">
                        <IconButton Icon="Lucide.GripVertical" Label="@label" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-sortable-handle ib-sortable-trigger"
                                    aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown Alt+Home Alt+End"
                                    autofocus="@focus" data-ib-autofocus="@(focus ? "" : null)" @attributes="wire" />
                    </Trigger>
                    <ChildContent>
                        @RowMove(new(ListMoveKind.Up, key), TextDefaults.MoveUp, "Alt+↑", row == 0)
                        @RowMove(new(ListMoveKind.Down, key), TextDefaults.MoveDown, "Alt+↓", row == _items.Count - 1)
                        @RowMove(new(ListMoveKind.Top, key), TextDefaults.MoveToTop, "Alt+Home", row == 0)
                        @RowMove(new(ListMoveKind.Bottom, key), TextDefaults.MoveToBottom, "Alt+End", row == _items.Count - 1)
                    </ChildContent>
                </Menu>
            }
            @if (PostsOrder && InOwnOrder)
            {
                @* Only in the grid's own order: a sorted order posted with the form would save as the rows' own. *@
                <input type="hidden" name="@OrderKeysName" value="@key" />
            }
        </td>
    };

    // The script finds a menu item by its move: the shortcuts click it, and on static pages it moves the row in place.
    private RenderFragment RowMove(ListMove move, string text, string shortcut, bool disabled) => __builder =>
    {
        var kind = move.Kind.ToString().ToLowerInvariant();
        if (MovesLive)
        {
            <MenuItem Shortcut="@shortcut" Disabled="disabled" data-ib-move="@kind" OnClick="() => MoveRowAsync(move)">@text</MenuItem>
        }
        else
        {
            <MenuItem Shortcut="@shortcut" Disabled="disabled" data-ib-move="@kind" Submit Name="@OrderMoveName" Value="@move.ToString()">@text</MenuItem>
        }
    };

    /// <inheritdoc />
    internal override void Loaded()
    {
        base.Loaded();
        ArrangePosted();
    }

    /// <inheritdoc />
    internal override string Summary(int size)
    {
        if (!GroupedNow)
        {
            return base.Summary(size);
        }

        var shown = _groupRoots?.Count ?? 0;
        if (shown == 0)
        {
            return "";
        }

        var first = (_page - 1L) * size + 1;
        return string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.GroupRange, first, first + shown - 1, _total ?? 0);
    }

    /// <inheritdoc />
    internal override bool MultiSort => true;

    /// <inheritdoc />
    internal override bool GridColumns => true;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (LayoutKey is null)
        {
            return;
        }

        if (LayoutKey.Length is 0 or > 64 || !LayoutKey.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_'))
        {
            throw new InvalidOperationException($"The {ViewName}'s {nameof(LayoutKey)} \"{LayoutKey}\" names a cookie: use letters, digits, - and _.");
        }

        // The cookie is there on the server's first render; an interactive render that follows a
        // prerender gets it handed over.
        var state = Services.GetService<PersistentComponentState>();
        var key = $"ib-grid:{LayoutKey}";
        if (state is not null && PersistedState.TryTake(state, key, PersistedStateJson.Default.DataGridLayout, out var handedOver))
        {
            _stored = handedOver;
        }
        else if (!RendererInfo.IsInteractive)
        {
            _stored = DataGridLayout.Parse(Services.GetService<IRequestCookies>()?.Get(CookieName));
        }

        if (state is not null && _stored is not null)
        {
            _persisting = state.RegisterOnPersisting(() =>
            {
                try
                {
                    PersistedState.Persist(state, key, _stored, PersistedStateJson.Default.DataGridLayout);
                }
                catch (ArgumentException)
                {
                    // Another grid with the same key already handed it over.
                }

                return Task.CompletedTask;
            });
        }
    }

    /// <inheritdoc />
    protected override Task OnParametersSetAsync()
    {
        if (SelectOnClick && !Selectable)
        {
            throw new InvalidOperationException($"{nameof(SelectOnClick)} selects rows, so it needs a {nameof(SelectionMode)}.");
        }

        if (SelectOnClick && RowHref is not null)
        {
            throw new InvalidOperationException($"With a {nameof(RowHref)}, a click on a row follows its link, so it can't also select it: leave out {nameof(SelectOnClick)} or {nameof(RowHref)}.");
        }

        if (CanEdit && ItemKey is null)
        {
            throw new InvalidOperationException($"A {ViewName} with an {nameof(EditMode)} needs an {nameof(ItemKey)} to know which row is being edited.");
        }

        if (CanDelete && ItemKey is null)
        {
            throw new InvalidOperationException($"A {ViewName} with an {nameof(OnDelete)} needs an {nameof(ItemKey)} to know which row to delete.");
        }

        if (Virtualize)
        {
            if (MaxHeight is null)
            {
                throw new InvalidOperationException("A DataGrid with Virtualize needs a MaxHeight, for its rows to scroll inside.");
            }

            if (Paging is not (DataPaging.Pages or DataPaging.LoadOnScroll))
            {
                throw new InvalidOperationException("A DataGrid with Virtualize has no pages, so it can't take a Paging.");
            }

            // Without a runtime to draw rows as they scroll, they load on scroll.
            Paging = RendererInfo.IsInteractive ? DataPaging.Pages : DataPaging.LoadOnScroll;
            PageSize ??= 50;
        }

        CheckReorder();
        _shown = null;
        ForgetEndedEdit();
        // Bound, it starts from the address, as sort and page do, and then follows the parent.
        if (!_searchReady)
        {
            _searchReady = true;
            _lastSearchParam = Search;
            _stateSearch = Search ?? (QueryString.Of(Navigation.Uri).TryGetValue(SearchKey, out var words) ? words.ToString() : null);
            _searchShown = _stateSearch;
        }
        else if (Search != _lastSearchParam)
        {
            _lastSearchParam = Search;
            // Not the echo of what was just typed, which may have moved on since.
            if (Search != _reportedSearch)
            {
                _stateSearch = _searchShown = Search;
            }
        }

        if ((ResizableColumns || ReorderableColumns || ColumnPicker) && !CanSave && !_warned)
        {
            _warned = true;
            Logger?.LogWarning("A DataGrid on a static page needs a {Key} or {Url} for people to rearrange its columns, so it shows no controls.", nameof(LayoutKey), nameof(LayoutSaveUrl));
        }

        if (EditMode is DataGridEditMode.Row or DataGridEditMode.Cell && (Virtualize || Appending))
        {
            throw new InvalidOperationException($"{nameof(DataGridEditMode)}.{EditMode} can't edit rows that load as they're needed, as an edited row could scroll away with what's typed in it: use {nameof(DataGridEditMode)}.{nameof(DataGridEditMode.Dialog)}.");
        }

        // Rows that load as they're needed can't be counted on to hold the one a link names.
        if (CanEdit && FindItem is null && (Virtualize || Appending))
        {
            throw new InvalidOperationException($"A {ViewName} that loads rows as they're needed can't edit one it hasn't loaded: give it a {nameof(FindItem)}.");
        }

        return LoadThenFindAsync();
    }

    private bool _warned;

    private async Task OnLayoutAsync(IzzyLayoutEventArgs e)
    {
        _stored = DataGridLayout.Parse(e.Layout);
        _rearranged = true;
        _shown = null;
        await LayoutChanged.InvokeAsync(_stored);
        StateHasChanged();
    }

    private bool CanResize(ColumnBase<TItem> column) => ResizableColumns && CanSave && column.Resizable;

    private bool CanMove(ColumnBase<TItem> column) => ReorderableColumns && CanSave && column.Reorderable;

    /// <inheritdoc />
    internal override IReadOnlyDictionary<string, object>? HeaderAttributes(ColumnBase<TItem> column)
    {
        // A header that can be dragged to the bar of what's grouped.
        var group = ShowsGroupBar && CanGroupBy(column) && !GroupsBy(column) && HasRoomToGroup;
        if (!Rearrangeable && !group)
        {
            return null;
        }

        var attributes = new Dictionary<string, object> { ["data-ib-col"] = KeyOf(column) };
        if (group)
        {
            attributes["data-ib-group"] = column.GroupToken;
        }

        if (CanMove(column))
        {
            attributes["data-ib-reorder"] = "";
        }

        if (BandPath(column) is { } path)
        {
            attributes["data-ib-path"] = path;
            // Its name where the script says it alone: a width as it's resized.
            attributes["data-ib-name"] = column.FullName;
        }

        if (CanResize(column))
        {
            attributes["data-ib-resize"] = "";
            // Its controls need room: smaller, they'd sit on each other.
            attributes["data-ib-min"] = column.MinWidth is { } min ? StyleValues.Length(min) : "6rem";
            if (column.MaxWidth is { } max)
            {
                attributes["data-ib-max"] = StyleValues.Length(max);
            }
        }

        return attributes;
    }

    /// <inheritdoc />
    internal override bool HasHeaderMenu(ColumnBase<TItem> column) =>
        CanResize(column) || CanMove(column) || CanGroupBy(column);

    /// <inheritdoc />
    internal override RenderFragment? HeaderMenu(ColumnBase<TItem> column) => !HasHeaderMenu(column) ? null : __builder =>
    {
        var key = KeyOf(column);
        var frozen = FrozenOf(column);
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColumnOptions, column.FullName);
        var zone = SiblingBlocks(column.Band, frozen);
        <Menu Class="ib-col-menu" data-ib-user-controlled>
            <Trigger>
                <button type="button" class="ib-table-filter-button" data-ib-menu aria-label="@TextDefaults.ColumnOptionsButton" title="@label" @attributes="context">
                    <Icon Purpose="IconPurpose.MoreVertical" />
                </button>
            </Trigger>
            <ChildContent>
                @{ var groups = new List<RenderFragment>(); }
                @if (column.CanSort)
                {
                    var sorted = SortedDescending(column);
                    groups.Add(@<text>
                        @SortItem(column, false, Lucide.ArrowUp, TextDefaults.ColumnSortAscending)
                        @SortItem(column, true, Lucide.ArrowDown, TextDefaults.ColumnSortDescending)
                        @if (sorted is null && SortsByOthers(column))
                        {
                            @SortItem(column, false, Lucide.ArrowDownNarrowWide, TextDefaults.ColumnSortAddAscending, add: true)
                            @SortItem(column, true, Lucide.ArrowDownWideNarrow, TextDefaults.ColumnSortAddDescending, add: true)
                        }
                        @if (sorted is not null)
                        {
                            @SortItem(column, null, Lucide.X, TextDefaults.ColumnSortClear)
                        }
                    </text>);
                }
                @if (CanGroupBy(column))
                {
                    var grouped = GroupsBy(column);
                    groups.Add(UseState
                        ? @<MenuItem Icon="Lucide.Rows3" OnClick="() => SetGroupAsync(GroupTextWith(column, !grouped))" Disabled="@(!grouped && !HasRoomToGroup)">@(grouped ? TextDefaults.GroupRemove : TextDefaults.GroupByColumn)</MenuItem>
                        : @<MenuItem Icon="Lucide.Rows3" Href="@GroupHref(GroupTextWith(column, !grouped))" Disabled="@(!grouped && !HasRoomToGroup)">@(grouped ? TextDefaults.GroupRemove : TextDefaults.GroupByColumn)</MenuItem>);
                    // The chips' drag and Alt+arrows, for touch and the pointer: one of several levels moves.
                    if (grouped && Grouping.Levels.Count > 1)
                    {
                        var groupItem = groups[^1];
                        groups[^1] = @<text>
                            @groupItem
                            @GroupMoveItem(column, -1, Lucide.MoveLeft, TextDefaults.GroupMoveLeft)
                            @GroupMoveItem(column, 1, Lucide.MoveRight, TextDefaults.GroupMoveRight)
                        </text>;
                    }
                }
                @if (CanMove(column) && RowHref is null)
                {
                    groups.Add(FreezeSub(column, "data-ib-col", key));
                }
                @if (CanResize(column))
                {
                    groups.Add(@<text>
                        <MenuItem Icon="Lucide.ArrowLeftRight" data-ib-col-action="fit" data-ib-col="@key">@TextDefaults.ColumnFit</MenuItem>
                        <MenuItem Icon="Lucide.ChevronsLeftRight" data-ib-col-action="fit-all" data-ib-col="@key">@TextDefaults.ColumnFitAll</MenuItem>
                        <MenuSub Label="@TextDefaults.ColumnSize" Icon="Lucide.Ruler">
                            <MenuItem data-ib-col-action="wider" data-ib-col="@key">@TextDefaults.ColumnWider</MenuItem>
                            <MenuItem data-ib-col-action="narrower" data-ib-col="@key">@TextDefaults.ColumnNarrower</MenuItem>
                            <MenuItem Disabled="CurrentLayout?.Column(key)?.Width is null || (frozen != ColumnFrozen.None && column.Width is null)" data-ib-col-action="reset-width" data-ib-col="@key">@TextDefaults.ColumnResetWidth</MenuItem>
                        </MenuSub>
                    </text>);
                }
                @if (CanMove(column))
                {
                    groups.Add(@<text>
                        <MenuItem Icon="Lucide.ArrowLeft" Disabled="zone.FirstOrDefault() == (object)column" data-ib-col-action="left" data-ib-col="@key">@TextDefaults.ColumnMoveStart</MenuItem>
                        <MenuItem Icon="Lucide.ArrowRight" Disabled="zone.LastOrDefault() == (object)column" data-ib-col-action="right" data-ib-col="@key">@TextDefaults.ColumnMoveEnd</MenuItem>
                    </text>);
                }
                @if (HasPicker || Rearrangeable)
                {
                    groups.Add(@<text>
                        @if (HasPicker && column.Pickable)
                        {
                            <MenuItem Icon="Lucide.EyeOff" Disabled="@(Shown.Count <= 1)" data-ib-col-action="hide" data-ib-col="@key">@TextDefaults.ColumnHide</MenuItem>
                        }
                        @if (HasPicker)
                        {
                            <MenuItem Icon="Lucide.Columns3" data-ib-col-action="choose" data-ib-col="@key">@TextDefaults.ColumnChoose</MenuItem>
                        }
                        <MenuItem Icon="Lucide.RotateCcw" data-ib-col-action="reset">@TextDefaults.ColumnsReset</MenuItem>
                    </text>);
                }
                @for (var i = 0; i < groups.Count; i++)
                {
                    if (i > 0)
                    {
                        <MenuDivider />
                    }
                    @groups[i]
                }
            </ChildContent>
        </Menu>
    };

    // Move group left or right (a column menu's) or Move left or right (a chip's): a link on static pages, as Group by is.
    private RenderFragment GroupMoveItem(ColumnBase<TItem> column, int by, IconData icon, string text, string? chip = null) => __builder =>
    {
        var moved = GroupTextMoved(column, by);
        if (UseState)
        {
            <MenuItem Icon="icon" Disabled="moved is null" OnClick="() => SetGroupAsync(moved)" data-ib-chip-move="@chip">@text</MenuItem>
        }
        else
        {
            <MenuItem Icon="icon" Disabled="moved is null" Href="@(moved is null ? null : GroupHref(moved))" data-ib-chip-move="@chip">@text</MenuItem>
        }
    };

    // A column menu's sort item: a link on static pages, as the header's is. The header shows the
    // sort now; Sort ascending and descending sort by this column alone, which changes a sort of
    // several too. With another column sorted and not this one, Add to sort keeps that sort and adds
    // this column: Shift+click's sort of several, for touch and the keyboard.
    private RenderFragment SortItem(ColumnBase<TItem> column, bool? descending, IconData icon, string text, bool add = false) => __builder =>
    {
        if (UseState)
        {
            <MenuItem Icon="icon" OnClick="() => SortToAsync(column, descending, add)">@text</MenuItem>
        }
        else
        {
            <MenuItem Icon="icon" Href="@SortToHref(column, descending, add)">@text</MenuItem>
        }
    };

    // Freeze columns ›: a line, as a sheet's frozen panes. To the left freezes every column to this
    // one's left (its band's, for a column in one), To the right every column to its right; freezing
    // again moves the line. Unfreeze clears this column's side, or every frozen column from one that
    // scrolls.
    private RenderFragment FreezeSub(ColumnBase<TItem> member, string by, object id) => __builder =>
    {
        var outer = member.Band?.Chain[0];
        var span = Shown.Select((c, i) => (c, i)).Where(x => outer is null ? x.c == member : x.c.Band?.Chain[0] == outer).Select(x => x.i).ToList();
        var attributes = new Dictionary<string, object> { [by] = id };
        <MenuSub Label="@TextDefaults.ColumnFreeze" Icon="Lucide.Pin">
            <MenuItem Disabled="@(span[0] == 0)" data-ib-col-action="freeze-start" @attributes="attributes">@TextDefaults.ColumnFreezeLeft</MenuItem>
            <MenuItem Disabled="@(span[^1] == Shown.Count - 1)" data-ib-col-action="freeze-end" @attributes="attributes">@TextDefaults.ColumnFreezeRight</MenuItem>
            <MenuItem Disabled="@(!Shown.Any(c => FrozenOf(c) != ColumnFrozen.None))" data-ib-col-action="unfreeze" @attributes="attributes">@TextDefaults.ColumnUnfreeze</MenuItem>
        </MenuSub>
    };

    // What a column or band moves among: the columns and bands in its band (or outside any), in its
    // frozen zone, that can move. A band is one block.
    private List<object> SiblingBlocks(ColumnBand? parent, ColumnFrozen zone)
    {
        var depth = parent?.Chain.Count ?? 0;
        var blocks = new List<object>();
        foreach (var column in Shown)
        {
            var chain = column.Band?.Chain ?? [];
            if (FrozenOf(column) != zone || (parent is not null && (chain.Count < depth || chain[depth - 1] != parent)))
            {
                continue;
            }

            object block = chain.Count > depth ? chain[depth] : column;
            if (blocks.Count == 0 || blocks[^1] != block)
            {
                blocks.Add(block);
            }
        }

        return blocks.Where(b => b is ColumnBand band ? BandMoves(band) : CanMove((ColumnBase<TItem>)b)).ToList();
    }

    // A band moves when every column in it can.
    private bool BandMoves(ColumnBand band) =>
        ReorderableColumns && CanSave && AllColumns.Where(c => c.Band?.Chain.Contains(band) == true).All(c => c.Reorderable);

    /// <inheritdoc />
    internal override IReadOnlyDictionary<string, object>? BandAttributes(ColumnBand band, BandSpan span)
    {
        if (!Rearrangeable)
        {
            return null;
        }

        var attributes = new Dictionary<string, object> { ["data-ib-band"] = BandId(band), ["data-ib-path"] = BandPath(band) };
        // All its columns, hidden ones too, which the script freezes and places with the band.
        if (band.Parent is null)
        {
            attributes["data-ib-cols"] = System.Text.Json.JsonSerializer.Serialize(AllColumns.Where(c => c.Band?.Chain[0] == band).Select(KeyOf).ToArray(), PersistedStateJson.Default.StringArray);
        }
        if (BandMoves(band))
        {
            attributes["data-ib-reorder"] = "";
        }

        return attributes;
    }

    /// <inheritdoc />
    internal override RenderFragment BandHeader(ColumnBand band, BandSpan span) => !BandMoves(band) ? BandLabel(band) : __builder =>
    {
        var id = BandId(band);
        var frozen = FrozenOf(Shown[span.First]);
        var zone = SiblingBlocks(band.Parent, frozen);
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColumnOptions, BandFullName(band));
        <div class="ib-table-head">
            @* Centered (or as aligned) in the room the menu button leaves, which sits at the end. *@
            <span class="ib-table-title" style="@(band.Align switch { CellAlign.Center => "margin-inline:auto", CellAlign.End => "margin-inline-start:auto", _ => null })">@BandLabel(band)</span>
            <Menu Class="ib-col-menu" data-ib-user-controlled>
                <Trigger>
                    <button type="button" class="ib-table-filter-button" data-ib-menu aria-label="@TextDefaults.ColumnOptionsButton" title="@label" @attributes="context">
                        <Icon Purpose="IconPurpose.MoreVertical" />
                    </button>
                </Trigger>
                <ChildContent>
                    @if (RowHref is null && band.Parent is null)
                    {
                        @FreezeSub(Shown[span.First], "data-ib-band", id)
                        <MenuDivider />
                    }
                    <MenuItem Icon="Lucide.ArrowLeft" Disabled="zone.FirstOrDefault() == (object)band" data-ib-col-action="left" data-ib-band="@id">@TextDefaults.ColumnMoveStart</MenuItem>
                    <MenuItem Icon="Lucide.ArrowRight" Disabled="zone.LastOrDefault() == (object)band" data-ib-col-action="right" data-ib-band="@id">@TextDefaults.ColumnMoveEnd</MenuItem>
                </ChildContent>
            </Menu>
        </div>
    };

    /// <inheritdoc />
    internal override RenderFragment? HeaderHandle(ColumnBase<TItem> column) => !CanResize(column) ? null : __builder =>
    {
        @* Pointer only: the grid is one Tab stop, and the keys and the menu do the same. *@
        <span class="ib-col-resize" aria-hidden="true"></span>
    };

    private bool HasPicker => Rearrangeable && ColumnPicker;

    // With frozen End columns its column stays in view with them, or its button would be out of reach.
    private string MenuCellClass => Shown.Any(c => FrozenOf(c) == ColumnFrozen.End) ? "ib-grid-menu-cell ib-frozen ib-frozen-end" : "ib-grid-menu-cell";

    // Named for its row, if the row has a name: its string form may be a whole record.
    private string RowMenuLabel(TItem item) => RowLabel is null && ItemKey is null
        ? TextDefaults.RowActions
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ItemMenu, LabelOf(item));

    /// <inheritdoc />
    internal override RenderFragment? LastHeaderCell => !HasLastCell ? null : __builder =>
    {
        <th scope="col" class="@MenuCellClass"><span class="ib-visually-hidden">@(HasActionCell ? TextDefaults.RowActions : TextDefaults.DetailColumn)</span></th>
    };

    /// <inheritdoc />
    internal override RenderFragment? LastEmptyCell => !HasLastCell ? null : __builder =>
    {
        <td class="@MenuCellClass"></td>
    };

    /// <inheritdoc />
    internal override RenderFragment? LastCell(TItem item) => !HasLastCell ? null : __builder =>
    {
        <td class="@MenuCellClass">
            <div class="ib-grid-actions">
                @if (TrailExpander)
                {
                    @DetailButton(item, RowIndexOf(item))
                }
                @if (HasActionCell)
                {
                var edited = RowEditKey is { } editing && (editing == NewRowKey ? ReferenceEquals(item, _editModel) : IsEditingRow(item));
                @if (edited)
                {
                    @RowEditActions
                }
                else
                {
                    <CascadingValue TValue="RowActionScope" Value="ScopeOf(item, false)">@ActionsOf(item)</CascadingValue>
                }
                var count = edited ? default : ActionCount(item);
                @if (count.Menu || count.Auto > 0)
                {
                    @* With only buttons that fold, the ⋮ shows once they're in it. *@
                    <Menu>
                        <Trigger Context="wire">
                            <IconButton Icon="IconSet.Current.Get(IconPurpose.MoreVertical)" Label="@RowMenuLabel(item)" Class="@(count.Menu ? null : "ib-fold-off")"
                                        Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-row-menu @attributes="wire" />
                        </Trigger>
                        <ChildContent><CascadingValue TValue="RowActionScope" Value="ScopeOf(item, true)">@ActionsOf(item)</CascadingValue></ChildContent>
                    </Menu>
                }
                }
            </div>
        </td>
    };

    // A row's place among those drawn, for its detail's id, where only the row is at hand.
    private int RowIndexOf(TItem item)
    {
        for (var i = 0; i < _items.Count; i++)
        {
            if (EqualityComparer<TItem>.Default.Equals(_items[i], item))
            {
                return i;
            }
        }

        return -1;
    }

    private bool HasSearchTool => Searchable;

    private readonly List<DataGridExportFormat> _exportFormats = [];

    // Excel, CSV, then the grid's own formats in the order they're written.
    private IEnumerable<(string Label, string Href)> ExportLinks
    {
        get
        {
            if (ExportExcelHref is not null)
            {
                yield return (TextDefaults.ExportExcel, ExportExcelHref);
            }

            if (ExportCsvHref is not null)
            {
                yield return (TextDefaults.ExportCsv, ExportCsvHref);
            }

            foreach (var format in FormatsAsWritten())
            {
                yield return (format.Label, format.Href);
            }
        }
    }

    // The formats join in the order they first render, so one shown later (behind an @if) would come
    // last. Their places are read from the frames the columns write; one the columns don't write
    // themselves (inside a component of yours, or a band) keeps its joining order, after them.
    private IEnumerable<DataGridExportFormat> FormatsAsWritten()
    {
        if (_exportFormats.Count < 2 || Columns is null)
        {
            return _exportFormats;
        }

        var written = new List<(string? Label, string? Href)>();
#pragma warning disable BL0006 // Reading render frames: the columns are run here only to see where the formats are.
        using (var builder = new Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder())
        {
            Columns(builder);
            var frames = builder.GetFrames();
            for (var i = 0; i < frames.Count; i++)
            {
                if (frames.Array[i].FrameType != Microsoft.AspNetCore.Components.RenderTree.RenderTreeFrameType.Component || frames.Array[i].ComponentType != typeof(DataGridExportFormat))
                {
                    continue;
                }

                string? label = null, href = null;
                for (var j = i + 1; j < frames.Count && frames.Array[j].FrameType == Microsoft.AspNetCore.Components.RenderTree.RenderTreeFrameType.Attribute; j++)
                {
                    switch (frames.Array[j].AttributeName)
                    {
                        case nameof(DataGridExportFormat.Label):
                            label = frames.Array[j].AttributeValue as string;
                            break;
                        case nameof(DataGridExportFormat.Href):
                            href = frames.Array[j].AttributeValue as string;
                            break;
                    }
                }

                written.Add((label, href));
            }
        }
#pragma warning restore BL0006

        // OrderBy is stable: formats not found keep their joining order.
        return _exportFormats.OrderBy(format =>
        {
            var at = written.IndexOf((format.Label, format.Href));
            if (at < 0)
            {
                return int.MaxValue;
            }

            written[at] = default;
            return at;
        }).ToList();
    }

    /// <inheritdoc />
    private protected override void AddExportFormat(DataGridExportFormat format)
    {
        _exportFormats.Add(format);
        ExportFormatChanged();
    }

    /// <inheritdoc />
    private protected override void RemoveExportFormat(DataGridExportFormat format)
    {
        if (_exportFormats.Remove(format))
        {
            ExportFormatChanged();
        }
    }

    // One added later (behind an @if), or relabeled, shows without waiting for another render.
    /// <inheritdoc />
    private protected override void ExportFormatChanged()
    {
        if (ReadyToLoad)
        {
            StateHasChanged();
        }
    }

    // Not when every shown column with a key is left out: an address naming none of them would get
    // every field, the ones left out too.
    private bool HasExportTool => (ExportCsvHref is not null || ExportExcelHref is not null || _exportFormats.Count > 0) && !ExportsNothing;

    private bool ExportsNothing => ExportColumns.Count == 0 && Grouping.Levels.Select(l => l.Column).Concat(Shown).Any(c => c.Key is not null);

    // Only real keys: a title can hold a comma, and no field has one for a key.
    // A grouped column left the table, not the file.
    private List<ColumnBase<TItem>> ExportColumns => Grouping.Levels.Select(l => l.Column).Concat(Shown).Distinct().Where(c => c.Key is not null && c.Exportable).ToList();

    bool IDataGridToolbar.HasSearch => HasSearchTool;

    bool IDataGridToolbar.HasColumnPicker => HasPicker;

    /// <inheritdoc />
    internal override bool SelectionTakesToolbar => ToolbarContent is not null || HasSearchTool || HasPicker || HasExportTool || FilterBuilder || CanAdd;

    bool IDataGridToolbar.HasExport => HasExportTool;

    bool IDataGridToolbar.ExportHasMenu => ExportHasMenu;

    private bool ExportHasMenu => ExportLinks.Skip(1).Any();

    bool IDataGridToolbar.ToolbarLabels => ToolbarLabels;

    string IDataGridToolbar.ColumnPickerLabel => TextDefaults.ColumnPicker;

    string IDataGridToolbar.ExportLabel => ExportHasMenu ? TextDefaults.Export : ExportLinks.FirstOrDefault().Label ?? TextDefaults.Export;

    RenderFragment IDataGridToolbar.SearchBar => __builder =>
    {
        <div class="ib-toolbar-item" style="width:14rem">
            <div class="ib-field ib-field-sm">
                <div class="ib-field-control">
                    @if (UseState)
                    {
                        <input type="search" class="ib-field-input" aria-label="@(SearchLabel ?? TextDefaults.Search)" placeholder="@(SearchLabel ?? TextDefaults.Search)" value="@_searchShown" autocomplete="off" data-ib-bound-search @oninput="OnSearchAsync" />
                    }
                    else
                    {
                        <input type="search" class="ib-field-input" aria-label="@(SearchLabel ?? TextDefaults.Search)" placeholder="@(SearchLabel ?? TextDefaults.Search)" value="@CurrentSearch" autocomplete="off" name="@SearchKey" form="@FilterFormId" data-ib-filter />
                    }
                </div>
            </div>
        </div>
    };

    RenderFragment IDataGridToolbar.ColumnPickerBar(bool showText) => __builder =>
    {
        var pickable = InOrder(AllColumns.Where(c => c.Pickable).ToList());
        var hidden = pickable.Count(c => !Shown.Contains(c));
        <div class="ib-toolbar-item ib-col-picker">
            <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/column-picker.css"]" />
            <Popover Title="@TextDefaults.ColumnPickerTitle" ShowCloseButton="true" Class="ib-col-picker-pop" data-ib-user-controlled>
                <Trigger>
                    @if (showText)
                    {
                        <Button StartIcon="IconSet.Current.Get(IconPurpose.Columns)" @attributes="context">@TextDefaults.ColumnPicker</Button>
                    }
                    else
                    {
                        <IconButton Icon="IconSet.Current.Get(IconPurpose.Columns)" Label="@TextDefaults.ColumnPicker" @attributes="context" />
                    }
                </Trigger>
                <ChildContent>
                    <ib-col-picker class="ib-col-picker-panel">
                        <div class="ib-col-picker-top">
                            @if (HasBands)
                            {
                                @* Named for what it does next: every band starts open. *@
                                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm ib-col-picker-chevron" data-ib-open="" aria-label="@TextDefaults.ColumnsCollapseAll" data-ib-text-open="@TextDefaults.ColumnsExpandAll" data-ib-text-close="@TextDefaults.ColumnsCollapseAll" data-ib-picker-expand-all><Icon Name="Lucide.ChevronDown" /></button>
                            }
                            <input type="checkbox" class="ib-check-input" aria-label="@TextDefaults.ColumnsShowAll" checked="@(hidden == 0)" data-ib-mixed="@(hidden > 0 && hidden < pickable.Count ? "" : null)" data-ib-picker-all />
                            <div class="ib-field ib-field-sm">
                                <div class="ib-field-control">
                                    <input type="search" class="ib-field-input" aria-label="@TextDefaults.ColumnsSearch" placeholder="@TextDefaults.SearchPlaceholder" autocomplete="off" data-ib-picker-search />
                                </div>
                            </div>
                        </div>
                        <ul class="ib-col-picker-list ib-scroll" aria-label="@TextDefaults.ColumnPicker">
                            @PickerRows(pickable, 0)
                        </ul>
                        @* Only with something to say: what's hidden, or a layout to go back from. *@
                        @if (hidden > 0 || CurrentLayout is not null)
                        {
                            <div class="ib-col-picker-foot">
                                <span>@(hidden > 0 ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColumnsHidden, hidden, pickable.Count) : null)</span>
                                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm" data-ib-col-action="reset">@TextDefaults.ColumnsReset</button>
                            </div>
                        }
                    </ib-col-picker>
                </ChildContent>
            </Popover>
        </div>
    };

    // The picker's rows from here down: each band's columns in a list of their own under its row.
    private RenderFragment PickerRows(List<ColumnBase<TItem>> columns, int depth) => __builder =>
    {
        for (var i = 0; i < columns.Count;)
        {
            var chain = columns[i].Band?.Chain ?? [];
            if (chain.Count > depth)
            {
                var band = chain[depth];
                var run = columns.Skip(i).TakeWhile(c => c.Band?.Chain is { } other && other.Count > depth && other[depth] == band).ToList();
                i += run.Count;
                var shown = run.Count(Shown.Contains);
                var id = BandId(band);
                var list = $"{_pickerId ??= IdGenerator.Next("ib-pick")}-b{id}";
                <li class="ib-col-picker-band" data-ib-picker-item="band:@id" data-ib-title="@band.Title">
                    <div class="ib-col-picker-row">
                        <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm ib-col-picker-chevron" aria-expanded="true" aria-controls="@list" aria-label="@BandFullName(band)" data-ib-picker-toggle><Icon Name="Lucide.ChevronDown" /></button>
                        <input type="checkbox" class="ib-check-input" id="@($"{list}-c")" aria-label="@(band.Parent is null ? null : BandFullName(band))" checked="@(shown == run.Count)" data-ib-mixed="@(shown > 0 && shown < run.Count ? "" : null)"
                               data-ib-picker-keys="@System.Text.Json.JsonSerializer.Serialize(run.Select(KeyOf).ToArray(), PersistedStateJson.Default.StringArray)" />
                        @PickerHandle(shown > 0 && BandMoves(band), band, null, BandFullName(band))
                        <label for="@($"{list}-c")">@band.Title</label>
                    </div>
                    <ul id="@list" aria-label="@BandFullName(band)">@PickerRows(run, depth + 1)</ul>
                </li>
            }
            else
            {
                var column = columns[i++];
                var key = KeyOf(column);
                var shown = Shown.Contains(column);
                var box = $"{_pickerId ??= IdGenerator.Next("ib-pick")}-c{AllColumns.ToList().IndexOf(column)}";
                var frozen = shown && FrozenOf(column) != ColumnFrozen.None;
                var name = column.Band is null ? column.HeaderText : column.FullName;
                name = frozen ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColumnFrozenNote, name) : name;
                <li data-ib-picker-item="@key" data-ib-title="@column.HeaderText">
                    <div class="ib-col-picker-row">
                        @if (HasBands)
                        {
                            <span class="ib-col-picker-gap"></span>
                        }
                        <input type="checkbox" class="ib-check-input" id="@box" aria-label="@(name == column.HeaderText ? null : name)" data-ib-col-show="@key" checked="@shown" disabled="@(shown && Shown.Count <= 1)" />
                        @PickerHandle(shown && CanMove(column), null, column, column.FullName)
                        <label for="@box">
                            @column.HeaderText
                            @if (frozen)
                            {
                                <Icon Name="Lucide.Pin" Class="ib-col-picker-pin" />
                            }
                        </label>
                    </div>
                </li>
            }
        }
    };

    private string? _pickerId;

    // A row's handle: dragged, or pressed for its moves (one pointer, and the keys). Rows that can't
    // move keep its room.
    private RenderFragment PickerHandle(bool moves, ColumnBand? band, ColumnBase<TItem>? column, string name) => __builder =>
    {
        if (!ReorderableColumns)
        {
            return;
        }

        if (!moves)
        {
            <span class="ib-col-picker-gap"></span>
            return;
        }

        var zone = band is not null ? SiblingBlocks(band.Parent, FrozenOf(AllColumns.First(c => c.Band?.Chain.Contains(band) == true && Shown.Contains(c)))) : SiblingBlocks(column!.Band, FrozenOf(column));
        object self = (object?)band ?? column!;
        var attributes = band is not null ? new Dictionary<string, object> { ["data-ib-band"] = BandId(band) } : new Dictionary<string, object> { ["data-ib-col"] = KeyOf(column!) };
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.MoveItem, name);
        <Menu Class="ib-col-menu" data-ib-user-controlled>
            <Trigger>
                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm ib-col-picker-handle" aria-label="@label" title="@label" aria-keyshortcuts="Alt+ArrowUp Alt+ArrowDown Alt+Home Alt+End" data-ib-picker-handle @attributes="context">
                    <Icon Name="Lucide.GripVertical" />
                </button>
            </Trigger>
            <ChildContent>
                <MenuItem Icon="Lucide.ArrowUp" Shortcut="Alt+↑" Disabled="zone.FirstOrDefault() == self" data-ib-col-action="left" @attributes="attributes">@TextDefaults.MoveUp</MenuItem>
                <MenuItem Icon="Lucide.ArrowDown" Shortcut="Alt+↓" Disabled="zone.LastOrDefault() == self" data-ib-col-action="right" @attributes="attributes">@TextDefaults.MoveDown</MenuItem>
                <MenuItem Shortcut="Alt+Home" Disabled="zone.FirstOrDefault() == self" data-ib-col-action="first" @attributes="attributes">@TextDefaults.MoveToTop</MenuItem>
                <MenuItem Shortcut="Alt+End" Disabled="zone.LastOrDefault() == self" data-ib-col-action="last" @attributes="attributes">@TextDefaults.MoveToBottom</MenuItem>
            </ChildContent>
        </Menu>
    };

    RenderFragment IDataGridToolbar.ExportBar(bool showText) => __builder =>
    {
        // Its links can be cleared before the item has left.
        if (!HasExportTool)
        {
            return;
        }

        var label = ((IDataGridToolbar)this).ExportLabel;
        var icon = IconSet.Current.Get(IconPurpose.Export);
        if (ExportHasMenu)
        {
            // Both inside one button, not a split button: one click only ever opens the menu.
            var chevron = IconSet.Current.Get(IconPurpose.ChevronDown);
            <Menu>
                <Trigger>
                    @if (showText)
                    {
                        <Button Class="ib-grid-export" StartIcon="icon" EndIcon="chevron" Disabled="@(_loadedRequest is null)" @attributes="context">@label</Button>
                    }
                    else
                    {
                        <Button Class="ib-grid-export ib-grid-export-icons" StartIcon="icon" EndIcon="chevron" Disabled="@(_loadedRequest is null)" aria-label="@label" title="@label" @attributes="context" />
                    }
                </Trigger>
                <ChildContent>@(((IDataGridToolbar)this).ExportMenu)</ChildContent>
            </Menu>
        }
        else if (showText)
        {
            <Button Href="@ExportHref(ExportLinks.First().Href)" StartIcon="icon" Disabled="@(_loadedRequest is null)" download>@label</Button>
