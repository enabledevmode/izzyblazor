    RenderFragment IDataGridToolbar.ExportMenu => __builder =>
    {
        foreach (var (label, href) in ExportLinks)
        {
            <MenuItem Href="@ExportHref(href)" Disabled="@(_loadedRequest is null)" download>@label</MenuItem>
        }
    };

    /// <summary>Whether its export keeps the rows under a match too (a TreeList's FilterBranch), as <c>branch=true</c>.</summary>
    internal virtual bool ExportsBranch => false;

    /// <summary>
    /// <paramref name="href"/> with what the grid's export links add: the current <c>filter</c>,
    /// <c>sort</c> (after its groups') and <c>search</c>, and the shown, exportable <c>columns</c>, for
    /// every row that matches, not one page. For a button of your own on an interactive page: call it
    /// when the button is clicked, such as <c>Nav.NavigateTo(grid.ExportHref("/orders.json"), forceLoad: true)</c>,
    /// as the grid's filter and sort change without the page rendering again. On a static page, a
    /// <see cref="DataGridExportFormat"/> puts the link in the grid's export.
    /// </summary>
    /// <param name="href">Your endpoint, such as <c>/orders/export.json</c>. A <c>#fragment</c> is dropped.</param>
    public string ExportHref(string href)
    {
        // Rows follow their groups, though a file has none.
        var request = _loadedRequest is { } loaded ? (loaded with { Sort = [.. Grouping.Levels.Select(l => new SortField(l.Field, l.Descending)), .. loaded.Sort], Skip = 0, Take = null, Cursor = null, NeedsTotal = true, FilterBranch = ExportsBranch }).ToQueryString() : "";
        var columns = "columns=" + string.Join(",", ExportColumns.Select(c => Uri.EscapeDataString(c.Key!)));
        // A fragment would swallow the query, and means nothing to a download.
        href = href.Split('#')[0];
        return href + (href.Contains('?', StringComparison.Ordinal) ? "&" : "?") + (request.Length > 0 ? request + "&" : "") + columns;
    }

    /// <inheritdoc />
