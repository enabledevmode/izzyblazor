            <IconButton Icon="Lucide.CornerDownRight" Label="@label" Href="@AddUnderHref(key)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-edit="@(AddsInPlace(key) ? AddQueryKey : null)" data-ib-edit-row="@(InRow && AddsInPlace(key) ? "" : null)" />
        }
    };

    private (int Buttons, bool Menu, int Auto) ActionCount(TItem item) => RowActionBase.Count(ActionsOf(item), ActionOverflow, CanEditRow(item) && !InCell, CanDeleteRow(item), Hiding);

