    /// <inheritdoc />
    internal override string? OverflowClass(ColumnBase<TItem> column)
    {
        if (Virtualize && column.Wrap == true)
        {
            throw new InvalidOperationException($"With {nameof(Virtualize)}, every row is one line high, so the column \"{column.HeaderText}\" can't wrap: leave out its Wrap.");
        }

        return !Virtualize && (column.Wrap ?? WrapCells) ? null : "ib-cell-clip";
    }

