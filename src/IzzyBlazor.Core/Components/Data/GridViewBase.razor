    private RenderFragment EditBinding(string key) => builder =>
    {
        builder.OpenComponent<DataGridEditBinding<TItem>>(0);
        builder.AddComponentParameter(1, nameof(DataGridEditBinding<TItem>.ChildContent), (RenderFragment<TItem?>)(posted => InPlace ? RowForm(key, posted) : EditDialogFor(key, posted)));
        builder.CloseComponent();
