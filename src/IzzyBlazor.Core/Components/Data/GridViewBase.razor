        {
            <IconButton Icon="Lucide.Trash" Label="@label" Href="@Navigation.GetUriWithQueryParameter(DeleteQueryKey, key)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-edit="@DeleteQueryKey" />
        }
    };

    private RowActionScope ScopeOf(TItem item, bool inMenu) =>
        new(inMenu, ActionOverflow, Hiding, (menu, reason) => EditControl(item, menu, reason), (menu, reason) => DeleteControl(item, menu, reason), menu => AddUnderControl(item, menu), menu => MoveControl(item, menu));

    private string AddRootHref => Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [AddQueryKey] = 1, [AddUnderQueryKey] = null });

    // A TreeList's Add child: a new row under this one, in the dialog or in place.
    private RenderFragment? AddUnderControl(TItem item, bool inMenu) => ChildFactory is null || !CanEdit ? null : __builder =>
    {
