    // The form of a row being edited: empty but for errors no field shows, as a form can't hold rows of a
    // table, and the row's fields and Save join it by its id.
    private RenderFragment RowForm(string key, TItem? posted) => __builder =>
    {
        var had = _editModel is not null;
        SyncEdit(key, posted);
        // On a static page this is drawn after the row's cells, which have the model to draw now.
        if (!had && _editModel is not null && !RendererInfo.IsInteractive)
        {
            StateHasChanged();
        }

        if (_editModel is null && !IsLoading)
        {
            <Alert Status="Status.Warning">@TextDefaults.EditRowGone</Alert>
        }

        <Form Class="ib-grid-edit-form" id="@RowFormId" novalidate="@(Hiding ? "" : null)" EditContext="_editContext" FormName="@(RendererInfo.IsInteractive ? null : DataGridEditBinding<TItem>.FormName)" OnValidSubmit="SaveEditAsync" OnInvalidSubmit="@(() => StateHasChanged())" data-ib-edit-for="@(_cellKey is not null ? null : key == NewRowKey ? "" : key)">
            @if (_editModel is not null)
            {
                <FormErrors ExceptFields="@EditProperties.Select(p => p.Name).ToList()" />
            }
        </Form>
    };

    private RenderFragment RowEditActions => __builder =>
    {
        <IconButton Icon="Lucide.Save" Label="@TextDefaults.Save" Submit Form="@RowFormId" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" />
        @if (UseState)
        {
            <IconButton Icon="Lucide.Undo2" Label="@TextDefaults.Cancel" OnClick="@(() => EndEditAsync(saved: false))" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-edit-cancel />
        }
        else
        {
            <IconButton Icon="Lucide.Undo2" Label="@TextDefaults.Cancel" Href="@EditEndHref" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-edit-cancel data-ib-edit-row />
        }
    };

    private RenderFragment EditDialogFor(string key, TItem? posted) => __builder =>
    {
        SyncEdit(key, posted);
        var missing = _editModel is null && !IsLoading && !_finding;
        var title = EditDialogTitle is { } titled && _editModel is not null ? titled(_editIsNew ? default : _editItem) : _editIsNew ? TextDefaults.Add : _editItem is { } item ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.EditItem, LabelOf(item)) : TextDefaults.Edit;
        <Dialog Open="true" OpenChanged="OnEditDialogChangedAsync" QueryKey="@(key == NewRowKey ? AddQueryKey : EditQueryKey)" Title="@title" Size="EditDialogSize" CloseOnBackdrop="false" ShowCloseButton="false" data-ib-edit-for="@(key == NewRowKey ? "" : key)">
            <Form Columns="EditColumns" Layout="EditLayout" EditContext="_editContext" FormName="@(RendererInfo.IsInteractive ? null : DataGridEditBinding<TItem>.FormName)" OnValidSubmit="SaveEditAsync">
                @if (missing)
                {
                    <Alert Status="Status.Warning">@TextDefaults.EditRowGone</Alert>
                }
                else if (_editModel is not null)
                {
                    <FormErrors />
                    var placed = PlacedKeys;
                    @if (EditDialog is not null)
                    {
                        <CascadingValue TValue="DataGridEditFields" Value="EditFieldsOf">@EditDialog</CascadingValue>
                    }
                    @foreach (var column in EditableColumns.Where(c => !placed.Contains(c.EditKey!)))
                    {
                        @EditorOf(column)
                    }
                }
                <DialogFooter>
                    @EditCancel
                    @if (!missing)
                    {
                        <Button Submit>@TextDefaults.Save</Button>
                    }
                </DialogFooter>
            </Form>
        </Dialog>
    };

