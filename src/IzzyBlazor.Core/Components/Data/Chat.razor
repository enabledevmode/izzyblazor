@namespace IzzyBlazor
@using Microsoft.AspNetCore.Components.Forms
@inherits StyledComponentBase
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, a message posts with the Send button, and Enter adds a line.")]

@*
    A conversation: its entries in a log that scrolls, and a box to write the next message in.
    For an assistant, or for people talking.

    <Chat Label="Assistant" FormName="assistant" OnSend="SendAsync" OnStop="Stop" Status="_status">
        @foreach (var turn in _turns)
        {
            <ChatEntry Mine="turn.Mine" Author="@(turn.Mine ? null : "Assistant")"
                       Time="turn.Time" Markdown="@turn.Text" Pending="turn.Pending" />
        }
    </Chat>

    Appearance chooses how others' entries look: across the log for an assistant, or in bubbles
    for people talking. Entries in a row from the same person, minutes apart, are grouped: their
    name, avatar and time show once.

    The chat is 32rem tall, its log scrolling inside; set Height, or Grow to fill its parent.
    The app keeps the entries and makes the replies: OnSend gets what was typed, and the app adds
    it and the reply as ChatEntry items. Status says where the reply is: while it's Waiting or
    Streaming, Send becomes Stop (OnStop) on an interactive page, and goes on a static one. Suggestions are buttons above the box that send their
    text. The log starts at its newest entry and stays there as entries arrive, with no script.

    On a static page the box is a form that posts (FormName names it, as with Form), so a
    message sends with JavaScript off too; with script, Enter sends and Shift+Enter adds a line.
    A reply streams on a static page too, with [StreamRendering] on the page, when the post came
    with script: OnSend's CanStream says so (with JavaScript off, send the reply whole).

    AllowFiles adds a button to attach files (Accept, MaxFileSize, MaxFiles); they come to OnSend
    with the text, checked against those limits, and post with the form on a static page. Each
    pick replaces the files chosen before.

    Entries are added at the end: a day separator and a static Retry go by the order entries
    arrived in, so inserting earlier ones (loading older messages) isn't supported yet.

    Accessibility:
    - The log is a `log` named by Label, which is required. It's quiet (aria-live off): a reply
      isn't read word by word as it arrives. A status, polite, says "Replying", then "Reply
      complete", "Stopped" or "Reply failed".
    - In a conversation between people, an entry from someone else that arrives on an interactive
      page is announced with its author ("Dana: Sounds good").
    - Each entry is an article with a heading screen readers can jump between ("You said",
      "Dana said"), hidden on screen; HeadingLevel sets its level (3 by default).
    - The box is a text area named "Message". Send and Stop are labeled buttons; the
      suggestions are a group named "Suggestions".
    - The log can be scrolled with the keyboard: it's in the Tab order.
    - Attach is a label for the file input, named "Attach files"; the files chosen are a list,
      each with a Remove button on an interactive page. A file over the limits is named in an
      error under the box, announced as it appears.
    See also: ChatEntry, RichText, TextArea.
*@

<ib-chat @attributes="AdditionalAttributes" class="@_class" style="@_style">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chat.css"]" />
    @* Reversed, so the log starts at its end and stays there as entries arrive, with no script;
       the one child keeps the entries in reading order. *@
    <div class="ib-chat-view">
        <div class="ib-chat-log" role="log" aria-label="@Label" aria-live="off" tabindex="0">
            <div class="ib-chat-entries">
                @if (EmptyContent is not null)
                {
                    <div class="ib-chat-empty">@EmptyContent</div>
                }
                <CascadingValue Value="_context" IsFixed="true">
                    @ChildContent
                </CascadingValue>
            </div>
        </div>
        @* Shown by the script when the reader has scrolled up. *@
        <IconButton Icon="Lucide.ArrowDown" Label="@TextDefaults.ChatJumpToLatest" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-chat-jump" hidden />
    </div>
    <LiveRegion Text="@_announcement" />
    @if (RendererInfo.IsInteractive)
    {
        @Composer(null)
    }
    else
    {
        @* Named for this chat, so that a post reaches only its own form. *@
        <FormMappingScope Name="@($"ib-chat-{FormName}")" Context="scope">
            @StaticComposer
        </FormMappingScope>
    }
</ib-chat>

@code {
    /// <summary>Names the conversation's log, such as "Assistant" or "Messages with Dana". Required.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The entries: <see cref="ChatEntry"/> items, oldest first.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Shown in the log before the first entry, such as a greeting.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    /// <summary>Called with what a person sent: the message typed, or a suggestion chosen.</summary>
    [Parameter, ModeSupport] public EventCallback<ChatSendArgs> OnSend { get; set; }

    /// <summary>Called when a person chooses Stop, shown while <see cref="Status"/> is Waiting or Streaming.</summary>
    [Parameter, ModeSupport] public EventCallback OnStop { get; set; }

    /// <summary>Where the reply is. While it's Waiting or Streaming, Send becomes Stop and a message can't be sent.</summary>
    [Parameter] public ChatStatus Status { get; set; }

    /// <summary>Messages a person can send with one press, shown above the box while nothing is on its way.</summary>
    [Parameter] public IReadOnlyList<string>? Suggestions { get; set; }

    /// <summary>The prompt in the empty box, such as "Ask about your order".</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>The most characters a message can have.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>The form's name on a static page, unique on the page, as a Form's FormName. Defaults to "chat".</summary>
    [Parameter] public string FormName { get; set; } = "chat";

    /// <summary>
    /// The address the form posts to on a static page; by default, the page's own. Set it to keep
    /// the conversation's id in the address, such as <c>/help?conversation=4f2a</c>: the post goes
    /// there, so the page knows the conversation, with no redirect.
    /// </summary>
    [Parameter] public string? FormAction { get; set; }

    /// <summary>
    /// The message being written, to fill the box or clear it from code (with <c>@bind-Draft</c>,
    /// it follows what's typed on an interactive page). A static page shows it in the box.
    /// </summary>
    [Parameter] public string? Draft { get; set; }

    /// <summary>Called as the message being written changes, on an interactive page.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)] public EventCallback<string?> DraftChanged { get; set; }

    /// <summary>Buttons of your own in the box's row of tools, just before Send, such as a microphone that dictates into <see cref="Draft"/>. Give each a label.</summary>
    [Parameter] public RenderFragment? ComposerActions { get; set; }

    /// <summary>Adds a button to attach files to a message: they come to <see cref="OnSend"/> as its <c>Files</c>.</summary>
    [Parameter] public bool AllowFiles { get; set; }

    /// <summary>The file types that can be attached, as a file input's accept: <c>.pdf,image/*</c>.</summary>
    [Parameter] public string? Accept { get; set; }

    /// <summary>The largest file that can be attached, in bytes. Defaults to 10 MB (10,000,000).</summary>
    [Parameter] public long MaxFileSize { get; set; } = 10_000_000;

    /// <summary>The most files a message can have. Defaults to 5.</summary>
    [Parameter] public int MaxFiles { get; set; } = 5;

    /// <summary>How others' entries look: across the log (Assistant, the default) or in bubbles (Conversation, for people talking).</summary>
    [Parameter] public ChatAppearance Appearance { get; set; }

    /// <summary>The level of each entry's hidden heading, 2 to 6. Defaults to 3.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    private readonly DraftModel _draft = new();
    private List<IBrowserFile> _files = [];
    private string? _fileError;
    private string? _lastDraft;
    private ChatContext _context = null!;
    private string? _class;
    private string? _style;
    private string? _announcement;
    private ChatStatus? _lastStatus;
    private bool _stopped;
    private bool _rendered;
    private readonly string _inputId = IdGenerator.Next("ib-chat");

    private sealed class DraftModel
    {
        public string? Text { get; set; }
    }

    private bool Busy => Status is ChatStatus.Waiting or ChatStatus.Streaming;

    /// <inheritdoc />
    protected override void OnInitialized() => _context = new ChatContext(this);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException("Chat needs a Label: it names the conversation's log.");
        }

        if (HeadingLevel is < 2 or > 6)
        {
            throw new InvalidOperationException("Chat's HeadingLevel is 2 to 6.");
        }

        (_class, _style) = BuildRootAttributes();

        // The status says what changed: a reply started, finished, stopped or failed.
        if (_lastStatus is { } last && last != Status)
        {
            _announcement = Status switch
            {
                ChatStatus.Waiting or ChatStatus.Streaming when last is ChatStatus.Ready or ChatStatus.Failed => TextDefaults.ChatReplying,
                ChatStatus.Ready when last is ChatStatus.Waiting or ChatStatus.Streaming => _stopped ? TextDefaults.ChatStopped : TextDefaults.ChatReplied,
                ChatStatus.Failed => TextDefaults.ChatReplyFailed,
                _ => _announcement,
            };
            if (!Busy) _stopped = false;
        }

        _lastStatus = Status;

        // A draft set from outside replaces what's in the box.
        if (Draft != _lastDraft)
        {
            _lastDraft = Draft;
            _draft.Text = Draft;
        }
    }

    private Task DraftEdited()
    {
        _lastDraft = _draft.Text;
        return DraftChanged.InvokeAsync(_draft.Text);
    }

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender) => _rendered = true;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-chat");
        classes.Add("ib-chat-conversation", Appearance == ChatAppearance.Conversation);
        // 32rem tall unless Height says otherwise; with Grow and no Height, it fills its parent.
        classes.Add("ib-chat-sized", Height.IsEmpty && !Grow);
        classes.Add("ib-chat-fill", Height.IsEmpty && Grow);
        base.BuildAttributes(classes, styles);
    }

    /// <summary>An entry from someone else arrived after the page did: announced, as people's messages are.</summary>
    internal bool Rendered => _rendered;

    internal void Arrived(ChatEntry entry)
    {
        if (!_rendered || entry.Mine || entry.Pending || Busy) return;
        var text = entry.PlainText();
        if (text.Length > 100) text = text[..100] + "…";
        _announcement = string.IsNullOrEmpty(entry.Author) ? text : $"{entry.Author}: {text}";
        InvokeAsync(StateHasChanged);
    }

    internal int EntryHeadingLevel => HeadingLevel;

    private string FilesId => _inputId + "-files";

    /// <summary>The composer form's id: a static Retry button in an entry submits it.</summary>
    internal string FormId => _inputId + "-form";

    private RenderFragment StaticComposer => builder =>
    {
        builder.OpenComponent<ChatPost>(0);
        builder.AddComponentParameter(1, nameof(ChatPost.ChildContent), (RenderFragment<ChatPost>)(posted => Composer(posted)));
        builder.CloseComponent();
    };

    private async Task SubmitAsync(ChatPost? posted)
    {
        if (posted?.Stop is not null)
        {
            await StopAsync();
            return;
        }

        if (posted?.Retry is { } retry)
        {
            if (_context.At(retry) is { } entry) await entry.RetryAsync();
            return;
        }

        // A form posts line breaks as CRLF; maxlength counts each as one, and so does OnSend's text.
        var text = (posted is null ? _draft.Text : posted.Suggestion ?? posted.Text)?.Replace("\r\n", "\n").Trim() ?? "";
        var files = AllowFiles && posted?.Suggestion is null ? (posted is null ? _files : posted.Files?.Where(f => f.Size > 0 || f.Name.Length > 0).ToList() ?? []) : [];
        if ((text.Length == 0 && files.Count == 0) || Busy) return;
        // The limits, checked here too: a static page's files come with no check before posting.
        _fileError = FileError(files);
        if (_fileError is not null) return;
        if (MaxLength is { } max && text.Length > max) text = text[..max];
        _draft.Text = null;
        _lastDraft = null;
        _files = [];
        if (DraftChanged.HasDelegate) await DraftChanged.InvokeAsync(null);
        await OnSend.InvokeAsync(new ChatSendArgs(text, CanStream: posted is null || posted.Script == "1") { Files = files });
    }

    private async Task SuggestAsync(string text)
    {
        if (Busy) return;
        await OnSend.InvokeAsync(new ChatSendArgs(text, CanStream: true));
    }

    private string? FileError(IReadOnlyList<IBrowserFile> files)
    {
        if (files.Count > MaxFiles) return string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ChatTooManyFiles, MaxFiles);
        if (files.FirstOrDefault(f => !FileHints.Accepts(Accept, f.Name, f.ContentType)) is { } wrong)
        {
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FileWrongType, wrong.Name);
        }

        if (files.FirstOrDefault(f => f.Size > MaxFileSize) is { } large)
        {
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FileTooLarge, large.Name, FileHints.FormatSize(MaxFileSize));
        }

        return null;
    }

    private void Chosen(InputFileChangeEventArgs args)
    {
        // Each pick replaces the last (the browser can't read an earlier pick's files once there's a
        // new one), all of them taken, as GetMultipleFiles throws when given fewer than were chosen.
        _files = args.FileCount == 0 ? [] : [.. args.GetMultipleFiles(args.FileCount)];
        _fileError = FileError(_files);
    }

    private void Remove(IBrowserFile file)
    {
        _files.Remove(file);
        _fileError = FileError(_files);
    }

    private async Task StopAsync()
    {
        _stopped = true;
        await OnStop.InvokeAsync();
    }

    private RenderFragment Composer(ChatPost? posted) => @<EditForm id="@FormId" action="@(posted is null ? null : FormAction)" enctype="@(AllowFiles && posted is not null ? "multipart/form-data" : null)" class="ib-chat-composer" Model="_draft" FormName="@(posted is null ? null : "send")" Enhance OnSubmit="@(() => SubmitAsync(posted))">
        @if (Suggestions is { Count: > 0 } suggestions && !Busy)
        {
            <div class="ib-chat-suggestions" role="group" aria-label="@TextDefaults.ChatSuggestions">
                @foreach (var suggestion in suggestions)
                {
                    @if (posted is null)
                    {
                        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" @onclick="@(() => SuggestAsync(suggestion))">@suggestion</Button>
                    }
                    else
                    {
                        <Button Submit Name="@ChatPost.SuggestionName" Value="@suggestion" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm">@suggestion</Button>
                    }
                }
            </div>
        }
        @if (AllowFiles)
        {
            @* The files chosen: the script lists them on a static page. *@
            <ul class="ib-chat-chosen" aria-label="@TextDefaults.ChatAttached" data-ib-chat-chosen>
                @foreach (var file in _files)
                {
                    <li class="ib-chat-file-chip">
                        <span>@file.Name</span>
                        <IconButton Icon="Lucide.X" Label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ChatRemoveFile, file.Name)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" @onclick="() => Remove(file)" />
                    </li>
                }
            </ul>
        }
        @if (_fileError is not null)
        {
            <p class="ib-chat-file-error" id="@(_inputId)-error" role="alert">@_fileError</p>
        }
        @* The text across the box, and its tools on a row below: attach at the start; your own, then Send, at the end. *@
        <div class="ib-chat-box">
            <label class="ib-visually-hidden" for="@_inputId">@TextDefaults.ChatMessage</label>
            @* Shown (to screen readers) by the script, which makes the keys work. *@
            <span id="@(_inputId)-hint" class="ib-visually-hidden ib-chat-hint" hidden>@TextDefaults.ChatKeys</span>
            @if (posted is null)
            {
                <textarea id="@_inputId" class="ib-chat-input" rows="1" placeholder="@Placeholder" maxlength="@MaxLength"
                          @bind="_draft.Text" @bind:event="oninput" @bind:after="DraftEdited"></textarea>
            }
            else
            {
                @* A post refused for its files comes back with what was typed. *@
                <textarea id="@_inputId" class="ib-chat-input" name="@ChatPost.TextName" rows="1" placeholder="@Placeholder" maxlength="@MaxLength">@(_fileError is not null ? posted.Text : Draft)</textarea>
            }
            <div class="ib-chat-tools">
                @if (AllowFiles)
                {
                    <label class="ib-btn ib-btn-ghost ib-btn-neutral ib-btn-sm ib-btn-icon-only ib-chat-attach" for="@(_inputId)-files" title="@TextDefaults.ChatAttach">
                        <Icon Name="Lucide.Paperclip" />
                        <span class="ib-visually-hidden">@TextDefaults.ChatAttach</span>
                    </label>
                    @if (posted is null)
                    {
                        <InputFile id="@FilesId" class="ib-chat-file" multiple accept="@Accept" OnChange="Chosen" />
                    }
                    else
                    {
                        <input type="file" id="@(_inputId)-files" class="ib-chat-file" name="@ChatPost.FilesName" multiple accept="@Accept" />
                    }
                }
                <span class="ib-chat-spacer"></span>
                @ComposerActions
                @if (Busy)
                {
                    @* Stop only on an interactive page: on a static one the reply streams in another
                       request, which a new post can't reach. *@
                    @if (posted is null)
                    {
                        <IconButton Icon="Lucide.Square" Label="@TextDefaults.ChatStop" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-chat-action" @onclick="StopAsync" />
                    }
                }
                else
                {
                    @* Disabled until there's something to send: here on an interactive page; on a static
                       one by the script, so that with JavaScript off it still sends. *@
                    <IconButton Submit Icon="Lucide.ArrowRight" Label="@TextDefaults.ChatSend" Size="ControlSize.Sm" Class="ib-chat-action"
                                Disabled="@(posted is null && string.IsNullOrWhiteSpace(_draft.Text) && _files.Count == 0)" />
                }
            </div>
        </div>
    </EditForm>;
}
