@namespace IzzyBlazor
@inherits StyledComponentBase
@attribute [ModeSupport]

@*
    A surface for one thing: media, a heading with actions, content, and a footer. With Href
    the whole card is a link (the title's link stretches over it), while buttons in CardActions
    and CardFooter stay clickable. No script involved.

    Content between the tags is the body. The other parts are components written among it, directly
    in the card: CardMedia (drawn at the top), CardHeader (custom heading content, above the title),
    CardActions (at the end of the heading row), CardBody (the body with layout props) and
    CardFooter (the bottom row, drawn last). CardMedia, CardHeader and CardActions are drawn at the
    card's level, so a form or cascading value they're written inside doesn't reach them.

    <Card Title="Website" Description="Updated 2 hours ago" Href="/projects/website">
        <CardActions><IconButton ... /></CardActions>
        <CardBody>...</CardBody>
        <CardFooter Justify="Justify.End">...</CardFooter>
    </Card>

    Accessibility:
    - `Title` renders a real heading, `h3` by default; set `TitleLevel` to fit the page's outline.
    - With `Href`, the link is the title alone, so its name is the `Title` text, not the whole card.
      It needs a `Title`: without one there's no link.
    - Keyboard users tab to the title link, and the focus ring is drawn around the whole card.
    - Links and buttons in CardActions, CardFooter and the body stay their own tab stops and stay
      clickable above the stretched link.
    - CardFooter is drawn last but stays where it's written in the DOM, which is the order screen
      readers follow, so write it last.
    See also: Section, Stat, DescriptionList.
*@

<div @attributes="AdditionalAttributes" class="@_class" style="@_style">
    @if (_scope.Shown<CardMedia>() is { } media)
    {
        <div class="ib-card-media">@_scope.Outlet(media)</div>
    }
    @if (HasHeader)
    {
        <div class="ib-card-header">
            @if (Title is not null || Description is not null || _scope.Shown<CardHeader>() is not null)
            {
                <div class="ib-card-heading">
                    @if (_scope.Shown<CardHeader>() is { } header)
                    {
                        @_scope.Outlet(header)
                    }
                    @if (Title is not null)
                    {
                        @TitleElement
                    }
                    @if (Description is not null)
                    {
                        <p class="ib-card-description">@Description</p>
                    }
                </div>
            }
            @if (_scope.Shown<CardActions>() is { } actions)
            {
                <div class="ib-card-actions">@_scope.Outlet(actions)</div>
            }
        </div>
    }
    @if (ChildContent is not null)
    {
        <CascadingValue Value="_scope" IsFixed="true">
            <div class="ib-card-body">@ChildContent</div>
        </CascadingValue>
    }
</div>

@code {
    /// <summary>The heading.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The heading level of <see cref="Title"/>, 1 to 6. Defaults to 3.</summary>
    [Parameter] public int TitleLevel { get; set; } = 3;

    /// <summary>A muted line under the title.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>
    /// The card's content: the body, plus any <see cref="CardMedia"/>, <see cref="CardHeader"/>,
    /// <see cref="CardActions"/>, <see cref="CardBody"/> and <see cref="CardFooter"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Makes the whole card a link to this address, through its title. Needs a <see cref="Title"/>.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>
    /// Makes each <see cref="CardBody"/> a section, with a line across the card between sections,
    /// as in a settings page.
    /// </summary>
    [Parameter] public bool Dividers { get; set; }

    /// <summary>How it's drawn. Defaults to <see cref="CardVariant.Outline"/>.</summary>
    [Parameter] public CardVariant Variant { get; set; } = CardVariant.Outline;

    /// <summary>Inner spacing and title size. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    private string? _class;
    private string? _style;
    private PartScope _scope = null!;

    [CascadingParameter] private PartScope? OuterScope { get; set; }

    private bool HasHeader => Title is not null || Description is not null
        || _scope.Shown<CardHeader>() is not null || _scope.Shown<CardActions>() is not null;


    private RenderFragment TitleElement => builder =>
    {
        builder.OpenElement(0, $"h{Math.Clamp(TitleLevel, 1, 6)}");
        builder.AddAttribute(1, "class", "ib-card-title");
        if (Href is not null)
        {
            builder.OpenElement(2, "a");
            builder.AddAttribute(3, "href", Href);
            builder.AddAttribute(4, "class", "ib-card-link");
            builder.AddContent(5, Title);
            builder.CloseElement();
        }
        else
        {
            builder.AddContent(6, Title);
        }

        builder.CloseElement();
    };

    /// <inheritdoc />
    protected override void OnInitialized() => _scope = new PartScope(this, OuterScope, StateHasChanged);

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-card");
        classes.Add($"ib-card-{Variant.ToString().ToLowerInvariant()}");
        classes.Add("ib-card-sm", Size == ControlSize.Sm);
        classes.Add("ib-card-lg", Size == ControlSize.Lg);
        classes.Add("ib-card-linked", Href is not null && Title is not null);
        classes.Add("ib-card-dividers", Dividers);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet() => (_class, _style) = BuildRootAttributes();
}
