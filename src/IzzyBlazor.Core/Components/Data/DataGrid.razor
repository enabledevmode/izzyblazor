@namespace IzzyBlazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits TableViewBase<TItem>
@implements IDataGridToolbar
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, there's no select-all checkbox and Shift+click doesn't add to the sort; filters apply when you press Apply.")]

@*
    A data grid: a real table, on the same columns, data, paging, filters and selection as Table,
    with sort, filter and page in the address, so it works on static pages. It adds what a grid
    needs: Shift+click on a header sorts by several columns (?sort=customer,-total), and column
    widths are set by the server, so nothing moves when the script arrives.

    A column with a Width keeps it (a fixed length, not a percent). Columns without one share the rest of the space, down to their
    MinWidth (8rem by default), and then the grid scrolls sideways. If every column has a Width, the
    grid is as wide as their sum.

    Frozen keeps a column in view at the grid's start or end, with no script, and is drawn at that
    edge wherever it's declared. It needs a Width. On a phone they scroll like the rest, and so they
    do if the script finds they'd leave too little room for the rows. RowHref can't be used with it.

    <DataGrid Items="orders" ItemKey="o => o.Id" PageSize="20" Caption="Orders">
        <PropertyColumn Property="o => o.Id" Title="Order" Width="8.Rem" Frozen="ColumnFrozen.Start" />
        <PropertyColumn Property="o => o.Customer" Sortable Filterable MinWidth="12.Rem" />
        <PropertyColumn Property="o => o.Total" Format="C" Sortable Width="10.Rem" />
    </DataGrid>

    LayoutKey remembers how one person has arranged the columns (widths, order, hidden, frozen) in a
    cookie, so the server draws it on the first paint with no flash. It's per person and per page; a
    shared link still shows the same rows, since sort, filter and page are in the address. To keep
    layouts in a database instead, bind Layout.

    ResizableColumns, ReorderableColumns and ColumnPicker let people rearrange the columns, with
    script, by pointer, keys, a menu in each header and a picker above the grid. On a static page they
    need somewhere to keep the result: a LayoutKey, or Layout with a LayoutSaveUrl.

    A toolbar above the grid holds ToolbarContent (Toolbar's items), the search box with Searchable,
    export and the Columns button, which show their icons alone unless ToolbarLabels is set. Write
    DataGridSearch, DataGridExport or DataGridColumnPicker in ToolbarContent to place one among your items. While rows are selected, the selection bar takes its place. Searchable
    searches the text columns; the words go in the address (?search=), and with script apply as
    you type.

    Virtualize draws only the rows in view, for tens of thousands of them, on an interactive page: give
    it a MaxHeight, and keep rows to one line of RowHeight. An ItemsProvider gets each window as a Skip
    and Take, and returns the Total. On a static page it loads on scroll instead, by PageSize (50 if
    not set), up to 2,000 rows. If the focused row scrolls away, focus waits on the scroll box and goes back when it
    returns, or on the next key, which scrolls to it. Browser find, and Shift ranges of selection,
    reach the rows drawn; Select all N reaches the rest.

    ExportCsvHref and ExportExcelHref add plain links to endpoints the app maps with DataExport. They
    carry the filter, sort, search and visible columns, in every mode and with no script. The
    endpoint's fields decide what's written, and head the file. A download matches the screen when
    they have the grid's keys: a column whose key they don't have is left out, a filter on it matches
    nothing, and a sort on it is ignored. Search covers their searchable fields, which may not be the
    grid's text columns.

    RowMenu gives each row a ⋮ menu of MenuItems in a last column, working with no script. With script
    a right-click on the row, a long press, Shift+F10 or the menu key opens the same menu. It acts on
    the row it opened on, and doesn't change the selection; actions on the selection go in the bar. A
    right-click on a link keeps the browser's menu, with its "open in new tab": that includes the
    whole of a row with RowHref, whose ⋮ button and Shift+F10 still open the menu.

    Accessibility:
    - `Caption` names the grid for screen readers; it isn't shown.
    - With script it's an ARIA grid, one Tab stop: arrows move between cells, Home and End along the
      row, Ctrl+Home and Ctrl+End to the corners, PageUp and PageDown by the rows in view and then to
      the next page. A cell with one link, button or checkbox focuses that; with several controls
      or a field, Enter or F2 goes in, and Escape, F2 or tabbing past the end comes back. On a header,
      Enter sorts, Shift+Enter adds to the sort, and F2 goes in to its filter and menu.
    - On a header, Shift+Left and Shift+Right resize the column and Alt+Left and Alt+Right move it; its
      menu (Alt+Down, which opens the filter when there's no menu) does both, so nothing needs
      dragging. A new width is read out.
    - Space toggles the row's checkbox from a cell of text, Shift+Space from anywhere, Shift+Up and
      Shift+Down extend the selection, and Ctrl+A selects the page. With no script, it's a plain
      table and Tab goes through its controls.
    - Sortable headers are links, and the first sorted column has `aria-sort`. With several sorted,
      each says its place and direction ("Sort 2, descending").
    - Row checkboxes and filter buttons are named as in a Table.
    - The toolbar is one Tab stop with script, with arrow keys between its controls. The tools that
      show only an icon are named for what they do, and have that as a hover tooltip.
    See also: Table.
*@

<ib-table @attributes="AdditionalAttributes" class="@_class" style="@_style" data-ib-page-key="@(NeedsFilterForm && !UseState ? PageKey : null)" data-ib-cursor-key="@(NeedsFilterForm && !UseState && CursorPaging ? CursorKey : null)" data-ib-load-on-scroll="@(Paging == DataPaging.LoadOnScroll ? "" : null)" data-ib-interactive="@(RendererInfo.IsInteractive ? "" : null)">
    <ib-grid hidden></ib-grid>
    @if (Rearrangeable || (LayoutKey is not null && RendererInfo.IsInteractive))
    {
        <ib-grid-columns hidden data-ib-layout="@CurrentLayout?.ToJson()" data-ib-layout-key="@LayoutKey" data-ib-save-url="@LayoutSaveUrl"
                         data-ib-interactive="@(RendererInfo.IsInteractive ? "" : null)" data-ib-width-text="@TextDefaults.ColumnWidth" @oniblayout="OnLayoutAsync"></ib-grid-columns>
    }
    @Body
</ib-table>

@code {
    private const string DefaultMinWidth = "8rem";

    /// <summary>
    /// Remembers how each person has arranged the columns, in a cookie under this name, so the server
    /// draws it on the first paint. Letters, digits, <c>-</c> and <c>_</c>. With neither this nor
    /// <see cref="Layout"/>, nothing is stored.
    /// </summary>
    [Parameter] public string? LayoutKey { get; set; }

    /// <summary>
    /// How the columns are arranged, in place of the cookie: bind it (<c>@bind-Layout</c>) to keep
    /// layouts yourself, such as per user in a database. Null leaves them as declared.
    /// </summary>
    [Parameter] public DataGridLayout? Layout { get; set; }

    /// <summary>Raised when the columns are rearranged, on interactive pages.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<DataGridLayout?> LayoutChanged { get; set; }

    /// <summary>
    /// With script, an address the app maps to save a person's layout: the grid posts it there as JSON
    /// when it changes, for a static page that passes its own <see cref="Layout"/>.
    /// </summary>
    [Parameter] public string? LayoutSaveUrl { get; set; }

    /// <summary>
    /// Lets people resize columns: by dragging a handle at the header's end, by double-clicking it to
    /// fit, by Shift+Left and Shift+Right, or from the header's menu. The grid scrolls if it grows.
    /// Needs script, and on a static page a <see cref="LayoutKey"/> or <see cref="LayoutSaveUrl"/>.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public bool ResizableColumns { get; set; }

    /// <summary>
    /// Lets people move columns: by dragging a header, by Alt+Left and Alt+Right, or from the header's
    /// menu, which can also freeze them. Frozen columns move among themselves. Needs script, and on a
    /// static page a <see cref="LayoutKey"/> or <see cref="LayoutSaveUrl"/>.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public bool ReorderableColumns { get; set; }

    /// <summary>
    /// A button above the grid listing the columns to show or hide, and to put back as declared. Needs
    /// script, and on a static page a <see cref="LayoutKey"/> or <see cref="LayoutSaveUrl"/>.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public bool ColumnPicker { get; set; }

    /// <summary>
    /// Draws only the rows in view, on an interactive page; on a static page they load on scroll
    /// instead, by <c>PageSize</c> (50 if not set), up to 2,000 rows. Needs a <c>MaxHeight</c>, and rows
    /// of one line, as tall as <see cref="RowHeight"/>. An <c>ItemsProvider</c> must return a
    /// <c>Total</c>, and read each window's <c>Skip</c> and <c>Take</c>, not <c>Page</c>, as a window
    /// needn't start on a page. It can't take paging by cursor. Pages, and their footer, don't apply.
    /// </summary>
    [Parameter] public bool Virtualize { get; set; }

    /// <summary>
    /// The height of every row, in pixels, with <see cref="Virtualize"/>. Text past it is cut short.
    /// A control in a cell can't be cut short: a row with a checkbox or a ⋮ button needs at least 33.
    /// Defaults to 48.
    /// </summary>
    [Parameter] public double RowHeight { get; set; } = 48;

    /// <inheritdoc />
    internal override bool VirtualRows => Virtualize && RendererInfo.IsInteractive;

    /// <inheritdoc />
    internal override bool ByTotal => Virtualize;

    /// <inheritdoc />
    internal override double VirtualRowHeight => RowHeight;

    /// <summary>
    /// Text beside the icons of the toolbar's own tools, for a grid people use now and then. Without it
    /// they're icons with a tooltip, for one used all day. A tool's own <c>ShowText</c> goes first.
    /// </summary>
    [Parameter] public bool ToolbarLabels { get; set; }

    /// <summary>
    /// A link in the toolbar, in a menu with <see cref="ExportExcelHref"/>, to an endpoint that writes the rows as CSV with <c>DataExport</c>. It adds
    /// the current <c>filter</c>, <c>sort</c>, <c>search</c> and <c>columns</c> to the address. The
    /// endpoint's fields need the grid's keys for the file to match the screen.
    /// </summary>
    [Parameter] public string? ExportCsvHref { get; set; }

    /// <summary>
    /// A link in the toolbar, in a menu with <see cref="ExportCsvHref"/>, to an endpoint that writes the rows as an Excel workbook with
    /// <c>DataExport</c>. It adds the current <c>filter</c>, <c>sort</c>, <c>search</c> and
    /// <c>columns</c> to the address. The endpoint's fields need the grid's keys for the file to match
    /// the screen.
    /// </summary>
    [Parameter] public string? ExportExcelHref { get; set; }

    /// <summary>
    /// A menu for each row, of <c>MenuItem</c>s, in a ⋮ button in a last column. A row whose menu
    /// renders nothing has no button. With script, a right-click on the row, a long press, Shift+F10
    /// or the menu key open it too; on a link, a right-click keeps the browser's menu. With frozen
    /// End columns, the button's column stays in view with them.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? RowMenu { get; set; }

    /// <summary>
    /// The page's own controls in the toolbar above the grid: <c>ToolbarButton</c>,
    /// <c>ToolbarMenu</c> and the like. Write <see cref="DataGridSearch"/>, <see cref="DataGridExport"/> or
    /// <see cref="DataGridColumnPicker"/> here to place the grid's own among them. While rows are selected,
    /// the selection bar takes its place. The grid reads this once more on each render, to see which of
    /// its tools are here, so nothing in it should count or consume anything.
    /// </summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>
    /// A search box in the toolbar, across the text columns. The words go in the address
    /// (<c>?search=</c>) and reach an <c>ItemsProvider</c> as the request's <c>Search</c>. With no
    /// script they apply on Enter.
    /// </summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>The words searched for. Binding it (<c>@bind-Search</c>) on an interactive page keeps them, with sort and page, in the component.</summary>
    [Parameter] public string? Search { get; set; }

    /// <summary>Raised when the search changes, on interactive pages (typing waits for a pause).</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string?> SearchChanged { get; set; }

    /// <summary>The search box's name and placeholder. Defaults to "Search".</summary>
    [Parameter] public string? SearchLabel { get; set; }

    private string SearchKey => $"{QueryPrefix}search";

    private string? _stateSearch;
    private string? _lastSearchParam;
    private string? _reportedSearch;
    // What the box is drawn with: not what's being typed, or a slow render would overwrite the keys
    // pressed since. It changes only when C# sets something else.
    private string? _searchShown;
    private bool _searchReady;
    private CancellationTokenSource? _searchDelay;

    // The words searched for: the component's when bound, else the address's.
    private string? CurrentSearch =>
        UseState ? _stateSearch?.Trim()
        : !Searchable ? null
        : QueryString.Of(Navigation.Uri).TryGetValue(SearchKey, out var words) ? (string.IsNullOrWhiteSpace(words.ToString()) ? null : words.ToString().Trim())
        : null;

    /// <inheritdoc />
    internal override bool ExtraBound => base.ExtraBound || SearchChanged.HasDelegate;

    /// <inheritdoc />
    internal override bool NeedsFilterForm => base.NeedsFilterForm || Searchable;

    /// <inheritdoc />
    internal override IEnumerable<string> ExtraFilterKeys => Searchable ? [SearchKey] : [];

    /// <inheritdoc />
    internal override string FilterSignature() => $"{base.FilterSignature()}|{CurrentSearch}";

    /// <inheritdoc />
    internal override DataRequest<TItem> Shape(DataRequest<TItem> request, string? sortRaw) =>
        base.Shape(request, sortRaw) with { Search = CurrentSearch };

    private async Task OnSearchAsync(ChangeEventArgs e)
    {
        _stateSearch = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value!.ToString();
        _reportedSearch = _stateSearch;
        _searchDelay?.Cancel();
        var delay = _searchDelay = new CancellationTokenSource();
        try
        {
            await Task.Delay(FilterDelay, delay.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_statePage, _stateCursor) = (1, null);
        await SearchChanged.InvokeAsync(_stateSearch);
        await ReportFirstPageAsync(pageWas, cursorWas);
        await ReloadIfStaleAsync();
    }

    // A static page can only keep a change by having it saved and asking for the page again.
    private bool CanSave => WillBeInteractive || LayoutKey is not null || LayoutSaveUrl is not null;

    private bool Rearrangeable => (ResizableColumns || ReorderableColumns || ColumnPicker) && CanSave;

    private DataGridLayout? _stored;
    private PersistingComponentStateSubscription? _persisting;
    private List<ColumnBase<TItem>>? _shown;

    // One bound follows the parent; given one-way, what people choose after it wins.
    private DataGridLayout? CurrentLayout => LayoutChanged.HasDelegate || !_rearranged ? Layout ?? _stored : _stored;

    private bool _rearranged;

    private string CookieName => $"ib-grid-{LayoutKey}";

    /// <inheritdoc />
    internal override string ViewName => "DataGrid";

    /// <inheritdoc />
    internal override bool MultiSort => true;

    /// <inheritdoc />
    internal override bool GridColumns => true;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (LayoutKey is null)
        {
            return;
        }

        if (LayoutKey.Length is 0 or > 64 || !LayoutKey.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_'))
        {
            throw new InvalidOperationException($"The DataGrid's {nameof(LayoutKey)} \"{LayoutKey}\" names a cookie: use letters, digits, - and _.");
        }

        // The cookie is there on the server's first render; an interactive render that follows a
        // prerender gets it handed over.
        var state = Services.GetService<PersistentComponentState>();
        var key = $"ib-grid:{LayoutKey}";
        if (state is not null && PersistedState.TryTake(state, key, PersistedStateJson.Default.DataGridLayout, out var handedOver))
        {
            _stored = handedOver;
        }
        else if (!RendererInfo.IsInteractive)
        {
            _stored = DataGridLayout.Parse(Services.GetService<IRequestCookies>()?.Get(CookieName));
        }

        if (state is not null && _stored is not null)
        {
            _persisting = state.RegisterOnPersisting(() =>
            {
                try
                {
                    PersistedState.Persist(state, key, _stored, PersistedStateJson.Default.DataGridLayout);
                }
                catch (ArgumentException)
                {
                    // Another grid with the same key already handed it over.
                }

                return Task.CompletedTask;
            });
        }
    }

    /// <inheritdoc />
    protected override Task OnParametersSetAsync()
    {
        if (Virtualize)
        {
            if (MaxHeight is null)
            {
                throw new InvalidOperationException("A DataGrid with Virtualize needs a MaxHeight, for its rows to scroll inside.");
            }

            if (Paging is not (DataPaging.Pages or DataPaging.LoadOnScroll))
            {
                throw new InvalidOperationException("A DataGrid with Virtualize has no pages, so it can't take a Paging.");
            }

            // Without a runtime to draw rows as they scroll, they load on scroll.
            Paging = RendererInfo.IsInteractive ? DataPaging.Pages : DataPaging.LoadOnScroll;
            PageSize ??= 50;
        }

        _shown = null;
        // Bound, it starts from the address, as sort and page do, and then follows the parent.
        if (!_searchReady)
        {
            _searchReady = true;
            _lastSearchParam = Search;
            _stateSearch = Search ?? (QueryString.Of(Navigation.Uri).TryGetValue(SearchKey, out var words) ? words.ToString() : null);
            _searchShown = _stateSearch;
        }
        else if (Search != _lastSearchParam)
        {
            _lastSearchParam = Search;
            // Not the echo of what was just typed, which may have moved on since.
            if (Search != _reportedSearch)
            {
                _stateSearch = _searchShown = Search;
            }
        }

        if ((ResizableColumns || ReorderableColumns || ColumnPicker) && !CanSave && !_warned)
        {
            _warned = true;
            Logger?.LogWarning("A DataGrid on a static page needs a {Key} or {Url} for people to rearrange its columns, so it shows no controls.", nameof(LayoutKey), nameof(LayoutSaveUrl));
        }

        return base.OnParametersSetAsync();
    }

    private bool _warned;

    private async Task OnLayoutAsync(IzzyLayoutEventArgs e)
    {
        _stored = DataGridLayout.Parse(e.Layout);
        _rearranged = true;
        _shown = null;
        await LayoutChanged.InvokeAsync(_stored);
        StateHasChanged();
    }

    private bool CanResize(ColumnBase<TItem> column) => ResizableColumns && CanSave && column.Resizable;

    private bool CanMove(ColumnBase<TItem> column) => ReorderableColumns && CanSave && column.Reorderable;

    /// <inheritdoc />
    internal override IReadOnlyDictionary<string, object>? HeaderAttributes(ColumnBase<TItem> column)
    {
        if (!Rearrangeable)
        {
            return null;
        }

        var attributes = new Dictionary<string, object> { ["data-ib-col"] = KeyOf(column) };
        if (CanMove(column))
        {
            attributes["data-ib-reorder"] = "";
        }

        if (CanResize(column))
        {
            attributes["data-ib-resize"] = "";
            // Its controls need room: smaller, they'd sit on each other.
            attributes["data-ib-min"] = column.MinWidth is { } min ? StyleValues.Length(min) : "6rem";
            if (column.MaxWidth is { } max)
            {
                attributes["data-ib-max"] = StyleValues.Length(max);
            }
        }

        return attributes;
    }

    /// <inheritdoc />
    internal override bool HasHeaderMenu(ColumnBase<TItem> column) =>
        CanResize(column) || CanMove(column) || (ColumnPicker && CanSave && column.Pickable);

    /// <inheritdoc />
    internal override RenderFragment? HeaderMenu(ColumnBase<TItem> column) => !HasHeaderMenu(column) ? null : __builder =>
    {
        var key = KeyOf(column);
        var frozen = FrozenOf(column);
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColumnOptions, column.HeaderText);
        var zone = Shown.Where(c => FrozenOf(c) == frozen && CanMove(c)).ToList();
        <Menu Placement="Placement.BottomEnd" Class="ib-col-menu" data-ib-user-controlled>
            <Trigger>
                <button type="button" class="ib-table-filter-button" data-ib-menu aria-label="@label" title="@label" @attributes="context">
                    <Icon Role="IconRole.MoreVertical" />
                </button>
            </Trigger>
            <ChildContent>
                @if (CanMove(column))
                {
                    <MenuItem Disabled="zone.FirstOrDefault() == column" data-ib-col-action="left" data-ib-col="@key">@TextDefaults.ColumnMoveStart</MenuItem>
                    <MenuItem Disabled="zone.LastOrDefault() == column" data-ib-col-action="right" data-ib-col="@key">@TextDefaults.ColumnMoveEnd</MenuItem>
                    <MenuDivider />
                }
                @if (CanResize(column))
                {
                    <MenuItem data-ib-col-action="wider" data-ib-col="@key">@TextDefaults.ColumnWider</MenuItem>
                    <MenuItem data-ib-col-action="narrower" data-ib-col="@key">@TextDefaults.ColumnNarrower</MenuItem>
                    <MenuItem Disabled="CurrentLayout?.Column(key)?.Width is null || (frozen != ColumnFrozen.None && column.Width is null)" data-ib-col-action="reset-width" data-ib-col="@key">@TextDefaults.ColumnResetWidth</MenuItem>
                    <MenuDivider />
                }
                @if (CanMove(column) && RowHref is null)
                {
                    if (frozen == ColumnFrozen.None)
                    {
                        <MenuItem data-ib-col-action="freeze-start" data-ib-col="@key">@TextDefaults.ColumnFreezeStart</MenuItem>
                        <MenuItem data-ib-col-action="freeze-end" data-ib-col="@key">@TextDefaults.ColumnFreezeEnd</MenuItem>
                    }
                    else
                    {
                        <MenuItem data-ib-col-action="unfreeze" data-ib-col="@key">@TextDefaults.ColumnUnfreeze</MenuItem>
                    }
                }
                @if (ColumnPicker && CanSave && column.Pickable)
                {
                    <MenuItem Disabled="Shown.Count <= 1" data-ib-col-action="hide" data-ib-col="@key">@TextDefaults.ColumnHide</MenuItem>
                }
            </ChildContent>
        </Menu>
    };

    /// <inheritdoc />
    internal override RenderFragment? HeaderHandle(ColumnBase<TItem> column) => !CanResize(column) ? null : __builder =>
    {
        @* Pointer only: the grid is one Tab stop, and the keys and the menu do the same. *@
        <span class="ib-col-resize" aria-hidden="true"></span>
    };

    private bool HasPicker => Rearrangeable && ColumnPicker;

    // With frozen End columns its column stays in view with them, or its button would be out of reach.
    private string MenuCellClass => Shown.Any(c => FrozenOf(c) == ColumnFrozen.End) ? "ib-grid-menu-cell ib-frozen ib-frozen-end" : "ib-grid-menu-cell";

    // Named for its row, if the row has a name: its string form may be a whole record.
    private string RowMenuLabel(TItem item) => RowLabel is null && ItemKey is null
        ? TextDefaults.RowActions
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ItemMenu, LabelOf(item));

    /// <inheritdoc />
    internal override RenderFragment? LastHeaderCell => RowMenu is null ? null : __builder =>
    {
        <th scope="col" class="@MenuCellClass"><span class="ib-visually-hidden">@TextDefaults.RowActions</span></th>
    };

    /// <inheritdoc />
    internal override RenderFragment? LastEmptyCell => RowMenu is null ? null : __builder =>
    {
        <td class="@MenuCellClass"></td>
    };

    /// <inheritdoc />
    internal override RenderFragment? LastCell(TItem item) => RowMenu is null ? null : __builder =>
    {
        <td class="@MenuCellClass">
            @if (HasContent(RowMenu(item)))
            {
                <Menu Placement="Placement.BottomEnd">
                    <Trigger Context="wire">
                        <IconButton Icon="IconSet.Current.Get(IconRole.MoreVertical)" Label="@RowMenuLabel(item)"
                                    Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-row-menu @attributes="wire" />
                    </Trigger>
                    <ChildContent>@RowMenu(item)</ChildContent>
                </Menu>
            }
        </td>
    };

    private bool HasSearchTool => Searchable;

    private bool HasExportTool => ExportCsvHref is not null || ExportExcelHref is not null;

    bool IDataGridToolbar.HasSearch => HasSearchTool;

    bool IDataGridToolbar.HasColumnPicker => HasPicker;

    bool IDataGridToolbar.HasExport => HasExportTool;

    bool IDataGridToolbar.ToolbarLabels => ToolbarLabels;

    string IDataGridToolbar.ColumnPickerLabel => TextDefaults.ColumnPicker;

    string IDataGridToolbar.ExportLabel => ExportCsvHref is null ? TextDefaults.ExportExcel : ExportExcelHref is null ? TextDefaults.ExportCsv : TextDefaults.Export;

    RenderFragment IDataGridToolbar.SearchBar => __builder =>
    {
        <div class="ib-toolbar-item" style="width:14rem">
            <div class="ib-field ib-field-sm">
                <div class="ib-field-control">
                    @if (UseState)
                    {
                        <input type="search" class="ib-field-input" aria-label="@(SearchLabel ?? TextDefaults.Search)" placeholder="@(SearchLabel ?? TextDefaults.Search)" value="@_searchShown" autocomplete="off" data-ib-bound-search @oninput="OnSearchAsync" />
                    }
                    else
                    {
                        <input type="search" class="ib-field-input" aria-label="@(SearchLabel ?? TextDefaults.Search)" placeholder="@(SearchLabel ?? TextDefaults.Search)" value="@CurrentSearch" autocomplete="off" name="@SearchKey" form="@FilterFormId" data-ib-filter />
                    }
                </div>
            </div>
        </div>
    };

    RenderFragment IDataGridToolbar.ColumnPickerBar(bool showText) => __builder =>
    {
        <div class="ib-toolbar-item ib-col-picker">
            <Popover Placement="Placement.BottomEnd" data-ib-user-controlled>
                <Trigger>
                    @if (showText)
                    {
                        <Button StartIcon="IconSet.Current.Get(IconRole.Columns)" @attributes="context">@TextDefaults.ColumnPicker</Button>
                    }
                    else
                    {
                        <IconButton Icon="IconSet.Current.Get(IconRole.Columns)" Label="@TextDefaults.ColumnPicker" @attributes="context" />
                    }
                </Trigger>
                <ChildContent>
                    <ul class="ib-col-picker-list" aria-label="@TextDefaults.ColumnPicker">
                    @foreach (var column in Columns.Where(c => c.Pickable))
                    {
                        var key = KeyOf(column);
                        var shown = Shown.Contains(column);
                        var zoneOf = Shown.Where(c => FrozenOf(c) == FrozenOf(column) && CanMove(c)).ToList();
                        <li>
                            <label>
                                <input type="checkbox" class="ib-check-input" data-ib-col-show="@key" checked="@shown" disabled="@(shown && Shown.Count <= 1)" />
                                @column.HeaderText
                            </label>
                            @if (ReorderableColumns)
                            {
                                @* Always drawn, so the row keeps its width when a column is hidden. *@
                                var at = shown && CanMove(column) ? zoneOf.IndexOf(column) : -1;
                                <span class="ib-col-picker-move">
                                    <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm" disabled="@(at <= 0)" data-ib-col-action="left" data-ib-col="@key" aria-label="@($"{TextDefaults.ColumnMoveStart}: {column.HeaderText}")"><span aria-hidden="true">↑</span></button>
                                    <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm" disabled="@(at < 0 || at >= zoneOf.Count - 1)" data-ib-col-action="right" data-ib-col="@key" aria-label="@($"{TextDefaults.ColumnMoveEnd}: {column.HeaderText}")"><span aria-hidden="true">↓</span></button>
                                </span>
                            }
                        </li>
                    }
                    </ul>
                    <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm" data-ib-col-action="reset">@TextDefaults.ColumnsReset</button>
                </ChildContent>
            </Popover>
        </div>
    };

    RenderFragment IDataGridToolbar.ExportBar(bool showText) => __builder =>
    {
        // Its links can be cleared before the item has left.
        if (!HasExportTool)
        {
            return;
        }

        var label = ((IDataGridToolbar)this).ExportLabel;
        var icon = IconSet.Current.Get(IconRole.Export);
        if (ExportCsvHref is not null && ExportExcelHref is not null)
        {
            <Menu Placement="Placement.BottomEnd">
                <Trigger>
                    @if (showText)
                    {
                        <Button StartIcon="icon" Disabled="@(_loadedRequest is null)" @attributes="context">@label</Button>
                    }
                    else
                    {
                        <IconButton Icon="icon" Label="@label" Disabled="@(_loadedRequest is null)" @attributes="context" />
                    }
                </Trigger>
                <ChildContent>@(((IDataGridToolbar)this).ExportMenu)</ChildContent>
            </Menu>
        }
        else if (showText)
        {
            <Button Href="@ExportHref((ExportCsvHref ?? ExportExcelHref)!)" StartIcon="icon" Disabled="@(_loadedRequest is null)" download>@label</Button>
        }
        else
        {
            <IconButton Href="@ExportHref((ExportCsvHref ?? ExportExcelHref)!)" Icon="icon" Label="@label" Disabled="@(_loadedRequest is null)" download />
        }
    };

    RenderFragment IDataGridToolbar.ExportMenu => __builder =>
    {
        if (ExportCsvHref is not null)
        {
            <MenuItem Href="@ExportHref(ExportCsvHref)" Disabled="@(_loadedRequest is null)" download>@TextDefaults.ExportCsv</MenuItem>
        }

        if (ExportExcelHref is not null)
        {
            <MenuItem Href="@ExportHref(ExportExcelHref)" Disabled="@(_loadedRequest is null)" download>@TextDefaults.ExportExcel</MenuItem>
        }
    };

    // Everything that matches what's on screen, not its page, in the columns on screen.
    private string ExportHref(string href)
    {
        var request = _loadedRequest is { } loaded ? (loaded with { Skip = 0, Take = null, Cursor = null, NeedsTotal = true }).ToQueryString() : "";
        // Only real keys: a title can hold a comma, and no field has one for a key.
        var columns = "columns=" + string.Join(",", Shown.Where(c => c.Key is not null).Select(c => Uri.EscapeDataString(c.Key!)));
        // A fragment would swallow the query, and means nothing to a download.
        href = href.Split('#')[0];
        return href + (href.Contains('?', StringComparison.Ordinal) ? "&" : "?") + (request.Length > 0 ? request + "&" : "") + columns;
    }

    /// <inheritdoc />
    internal override RenderFragment? AboveGrid => __builder =>
    {
        if (Rearrangeable)
        {
            <span class="ib-visually-hidden" role="status" data-ib-col-say></span>
        }

        if (ToolbarContent is not null || HasSearchTool || HasPicker || HasExportTool)
        {
            var placed = DataGridToolbarItem.Placed(ToolbarContent);
            <div class="ib-grid-toolbar @(ToolbarContent is null && !HasSearchTool && !HasExportTool ? "ib-grid-toolbar-picker-only" : null)">
                @* Around the toolbar, not inside it: its items keep the order they join in, and a wrapper would delay these. *@
                <CascadingValue TValue="IDataGridToolbar" Value="this">
                    <Toolbar Label="@($"{Caption ?? TextDefaults.TableName}: {TextDefaults.GridToolbar}")">
                        @if (!placed.Contains(typeof(DataGridSearch)))
                        {
                            <DataGridSearch />
                        }
                        @ToolbarContent
                        @if (!placed.Contains(typeof(DataGridExport)))
                        {
                            <DataGridExport />
                        }
                        @if (!placed.Contains(typeof(DataGridColumnPicker)))
                        {
                            <DataGridColumnPicker />
                        }
                    </Toolbar>
                </CascadingValue>
            </div>
        }
    };

    /// <inheritdoc />
    internal override void ColumnsChanged() => _shown = null;

    /// <inheritdoc />
    public override void Dispose()
    {
        base.Dispose();
        _persisting?.Dispose();
        _searchDelay?.Cancel();
    }

    // Its key in a layout. Not every column has a sort key; its title is the next best.
    private static string KeyOf(ColumnBase<TItem> column) => column.Key ?? column.HeaderText;

    private string? WidthOf(ColumnBase<TItem> column) =>
        CurrentLayout?.Column(KeyOf(column))?.Width ?? (column.Width is { } width ? StyleValues.Length(width) : null);

    // A layout can freeze a column only if it has a width to be placed by.
    private ColumnFrozen FrozenOf(ColumnBase<TItem> column)
    {
        // A stored layout can't freeze a column on a grid that can't have frozen columns.
        var frozen = RowHref is not null ? column.Frozen : CurrentLayout?.Column(KeyOf(column))?.Frozen ?? column.Frozen;
        return frozen != ColumnFrozen.None && WidthOf(column) is null ? ColumnFrozen.None : frozen;
    }

    // Start, then the rest, then end, whatever order they were declared or came in: a frozen column
    // among those that scroll would overlap them. Within those, a layout's place, else the declared one.
    // At least one always shows: a layout that hides them all is ignored for that.
    /// <inheritdoc />
    internal override IReadOnlyList<ColumnBase<TItem>> Shown => _shown ??= Arrange();

    private List<ColumnBase<TItem>> Arrange()
    {
        var layout = CurrentLayout;
        // One the page says can't be hidden isn't, whatever a stored layout says.
        var visible = Columns.Where(c => !c.Pickable || layout?.Column(KeyOf(c))?.Hidden != true).ToList();
        return (visible.Count > 0 ? visible : Columns)
            .Select((column, index) => (column, index))
            .OrderBy(x => FrozenOf(x.column) switch { ColumnFrozen.Start => 0, ColumnFrozen.End => 2, _ => 1 })
            .ThenBy(x => layout?.Column(KeyOf(x.column))?.Position ?? x.index)
            .Select(x => x.column)
            .ToList();
    }

    /// <inheritdoc />
    internal override RenderFragment? ColGroup => Shown.Count == 0 ? null : __builder =>
    {
        <colgroup>
            @if (Selectable)
            {
                <col class="ib-datagrid-select-col" />
            }
            @for (var i = 0; i < Shown.Count; i++)
            {
                <col style="@(WidthOf(Shown[i]) is null ? null : $"width:var(--ib-col-{i})")" />
            }
            @if (RowMenu is not null)
            {
                <col class="ib-datagrid-menu-col" />
            }
        </colgroup>
    };

    // Widths are variables on the table, so one change later (a resize) moves everything that uses
    // them. Fixed layout shares the rest equally whatever each column's minimum, so the grid's
    // minimum gives every unset column the largest of them.
    /// <inheritdoc />
    internal override string? GridStyle
    {
        get
        {
            // Before the columns register (a page still streaming), a message takes the whole width.
            if (Shown.Count == 0)
            {
                return "table-layout:auto";
            }

            CheckFrozen();
            var style = new System.Text.StringBuilder();
            var parts = new List<string>();
            var unset = new List<string>();
            for (var i = 0; i < Shown.Count; i++)
            {
                if (WidthOf(Shown[i]) is { } width)
                {
                    style.Append($"--ib-col-{i}:{width};");
                    parts.Add($"var(--ib-col-{i})");
                }
                else
                {
                    unset.Add(Shown[i].MinWidth is { } min ? StyleValues.Length(min) : DefaultMinWidth);
                }
            }

            if (Selectable)
            {
                parts.Add("var(--ib-datagrid-select)");
            }

            if (RowMenu is not null)
            {
                parts.Add("var(--ib-datagrid-menu)");
            }

            if (unset.Count > 0)
            {
                parts.Add($"{unset.Count} * max({string.Join(", ", unset.Distinct())})");
            }

            if (parts.Count > 0)
            {
                style.Append($"{(unset.Count > 0 ? "min-width" : "width")}:calc({string.Join(" + ", parts)})");
            }

            return style.Length > 0 ? style.ToString() : null;
        }
    }

    /// <inheritdoc />
    internal override string? HeaderStyle(ColumnBase<TItem> column) => CellStyle(column);

    /// <inheritdoc />
    internal override string SelectCellClass =>
        Shown.Any(c => FrozenOf(c) == ColumnFrozen.Start) ? "ib-table-select-cell ib-frozen ib-frozen-start" : "ib-table-select-cell";

    /// <inheritdoc />
    internal override string? ColumnClass(ColumnBase<TItem> column)
    {
        var frozen = FrozenOf(column);
        if (frozen == ColumnFrozen.None)
        {
            return null;
        }

        var side = frozen == ColumnFrozen.Start ? "start" : "end";
        // The one beside the columns that scroll draws the line between them.
        var edge = frozen == ColumnFrozen.Start
            ? column == Shown.LastOrDefault(c => FrozenOf(c) == ColumnFrozen.Start)
            : column == Shown.FirstOrDefault(c => FrozenOf(c) == ColumnFrozen.End);
        return edge ? $"ib-frozen ib-frozen-{side} ib-frozen-edge" : $"ib-frozen ib-frozen-{side}";
    }

    // Its offset: the widths between it and its edge, and the selection column at the start.
    /// <inheritdoc />
    internal override string? CellStyle(ColumnBase<TItem> column)
    {
        var frozen = FrozenOf(column);
        if (frozen == ColumnFrozen.None)
        {
            return null;
        }

        var index = _shown!.IndexOf(column);
        var parts = new List<string>();
        if (frozen == ColumnFrozen.Start)
        {
            if (Selectable)
            {
                parts.Add("var(--ib-datagrid-select)");
            }

            for (var i = 0; i < index; i++)
            {
                parts.Add($"var(--ib-col-{i})");
            }
        }
        else
        {
            for (var i = index + 1; i < Shown.Count; i++)
            {
                parts.Add($"var(--ib-col-{i})");
            }

            if (RowMenu is not null)
            {
                parts.Add("var(--ib-datagrid-menu)");
            }
        }

        return parts.Count == 0 ? null : $"--ib-frozen-at:calc({string.Join(" + ", parts)})";
    }

    // A frozen cell is the containing block of the row's stretched link, and sits above it, so the
    // link wouldn't cover the row.
    private void CheckFrozen()
    {
        if (RowHref is not null && Shown.Any(c => FrozenOf(c) != ColumnFrozen.None))
        {
            throw new InvalidOperationException($"A DataGrid can't have both {nameof(RowHref)} and {nameof(ColumnBase<TItem>.Frozen)} columns yet: use a link in a cell.");
        }

        if (Rearrangeable)
        {
            // A layout finds columns by key: two with one, or one with none, would be mixed up.
            var taken = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var column in Columns)
            {
                if (string.IsNullOrEmpty(KeyOf(column)) || !taken.Add(KeyOf(column)))
                {
                    throw new InvalidOperationException($"The \"{column.HeaderText}\" column needs a {nameof(ColumnBase<TItem>.SortKey)} of its own, since people can rearrange the columns: its key is empty or another column's.");
                }
            }
        }
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-datagrid");
        classes.Add("ib-datagrid-virtual", VirtualRows);
        base.BuildAttributes(classes, styles);
    }
}
