@namespace IzzyBlazor
@typeparam TItem
@inherits DataViewBase<TItem>
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging

@* What Table and DataGrid share: columns, sort, filters, and the table they draw. See Table.razor. *@

@code {
    private RenderFragment SkeletonRow => __builder =>
    {
        <tr class="ib-table-skeleton-row" aria-hidden="true" style="@VirtualRowStyle">
            @GripEmptyCell
            @if (Selectable)
            {
                <td class="@SelectCellClass"></td>
            }
            @LeadCell
            @foreach (var column in Shown)
            {
                <td class="@CellClass(column)" style="@CellStyle(column)"><span class="ib-skeleton ib-table-skeleton"></span></td>
            }
            @LastEmptyCell
        </tr>
    };

    private RenderFragment RowWithDetail(TItem item, int row) => __builder =>
    {
        @DataRow(item, row, null)
        @AfterRow(item, row, null)
    };

    // One row. With virtual rows, absolute is its place among all the rows, and it's kept by that.
    internal RenderFragment DataRow(TItem item, int row, int? absolute, int? indent = null) => __builder =>
    {
        var key = KeyOf(item);
        var editing = IsEditingRow(item);
        var href = editing ? null : RowHref?.Invoke(item);
        @* The first row of each page Load more adds can take focus, which goes to it when it arrives. *@
        <tr @key="(object?)absolute" class="@RowClasses(item, href)" role="@StackRole("row")" aria-rowindex="@(absolute + HeaderRows + 1)" data-ib-even="@((absolute ?? row) % 2 == 1 ? "" : null)" style="@VirtualRowStyle" aria-level="@(indent + 1)" data-ib-key="@(GridColumns ? key : null)" aria-selected="@(GridColumns && Selectable ? (IsSelected(item, key) ? "true" : "false") : null)" aria-current="@(href is null ? CurrentOf(item) : null)" tabindex="@(_pageStarts.Contains(row) || row == _arriveAt ? "-1" : null)" data-ib-autofocus="@(row == _arriveAt ? "" : null)" data-ib-editing="@(editing ? "" : null)" @attributes="RowAttributes(item)" @ref="_rowRefs[absolute is null ? row : -1]">
            @GripCell(item, row)
            @if (Selectable)
            {
                <td class="@SelectCellClass" role="@StackRole("cell")">
                    @* Keyed by its item: rows are keyed by place, and a tick C# hasn't heard of yet would stay on the
                       next item to take this place. *@
                    <input @key="key" type="@(MultiSelect ? "checkbox" : "radio")" class="ib-check-input ib-table-select" name="@SelectionKeysName" value="@key"
                           aria-label="@SelectLabel(item)"
                           checked="@IsSelected(item, key)"
                           disabled="@(!CanSelect(item))"
                           @onchange="e => OnSelectChanged(key, e)" />
                </td>
            }
            @RowLead(item, row)
            @{ var first = true; }
            @foreach (var column in Shown)
            {
                var cellEditor = editing ? null : CellEditor(item, column);
                <td class="@CellClass(column)" role="@StackRole("cell")" style="@CellStyle(column)" data-ib-edit-col="@EditColumnKey(item, column)" data-ib-editing="@(cellEditor is null ? null : "")">
                    @if (first && href is not null)
                    {
                        @* One link per row, stretched over it; controls in the row stay clickable above it. *@
                        <a class="ib-table-row-link" href="@href" aria-current="@CurrentOf(item)"><span class="ib-visually-hidden">@LabelOf(item)</span></a>
                    }
                    @{ var content = cellEditor ?? (editing ? EditCell(column) ?? column.Cell(item) : column.Cell(item)); }
                    @(first ? FirstCell(item, content) : content)
                </td>
                first = false;
            }
            @LastCell(item)
        </tr>
    };

    private readonly record struct VirtualRow(int Index, TItem Item);

    /// <summary>The rows draw through Virtualize, as they scroll into view.</summary>
    internal virtual double VirtualRowHeight => 48;

    private ItemsProviderDelegate<VirtualRow>? _windowProvider;
    private RenderFragment<VirtualRow>? _virtualRowContent;
    private Virtualize<VirtualRow>? _virtualize;
    // Which list the rows are of: a new sort or filter starts them again from the top, and the same
    // one loaded again (an edit) stays where it is.
    private int _virtualLoad;
    private object? _virtualShape;
    private bool _firstWindowLoaded;

    // Called directly, not added as content: that would put each row in a region of its own, where its
    // key has no neighbors to match, and a row staying in view would be rebuilt, focus and all.
    private RenderFragment<VirtualRow> VirtualRowContent => _virtualRowContent ??= drawn => builder => DataRow(drawn.Item, drawn.Index, drawn.Index)(builder);

    private ItemsProviderDelegate<VirtualRow> WindowProvider => _windowProvider ??= LoadWindowAsync;

    private string? VirtualRowStyle => VirtualRows ? $"height:{VirtualRowHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)}px" : null;

    private bool HasFooterRow => Shown.Any(c => c.HasFooter);

    // An aggregate's cell, in one weight: "Sum: $1,200", or the column's template.
    internal RenderFragment AggregateCell(ColumnBase<TItem> column, DataGroup? group, AggregatePlace place) => __builder =>
    {
        if (column.AggregateIn(place) is { } type && column.TryAggregate(group, type, out var value))
        {
            var text = column.AggregateText(type, value);
            if (column.AggregateTemplate is { } template)
            {
                @template(new DataGridAggregate(type, value, text, group!))
            }
            else if (column.AggregateWord(TextDefaults, type) is { Length: > 0 } word)
            {
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.AggregateText, word, text)
            }
            else
            {
                @text
            }
        }
    };

    private async ValueTask<ItemsProviderResult<VirtualRow>> LoadWindowAsync(ItemsProviderRequest window)
    {
        if (_loadedRequest is not { } basis)
        {
            return new([], 0);
        }

        // The first page has just loaded, for the total: no need to ask again.
        if (_firstWindowLoaded && window.StartIndex == 0 && window.Count <= _items.Count)
        {
            _firstWindowLoaded = false;
            _items = _items.Take(window.Count).ToList();
            return new(_items.Select((item, i) => new VirtualRow(i, item)), _total ?? 0);
        }

        _firstWindowLoaded = false;
        // A slower answer to an older list must not touch this one.
        var version = _loadVersion;
        var request = basis with { Skip = window.StartIndex, Take = window.Count, Cursor = null, NeedsTotal = true, CancellationToken = window.CancellationToken };
        try
        {
            IReadOnlyList<TItem> items;
            int total;
            if (ItemsProvider is not null)
            {
                var result = await ItemsProvider(request);
                (items, total) = (result.Items, result.Total ?? throw new InvalidOperationException($"A {ViewName} with virtual rows needs its {nameof(ItemsProvider)} to return a {nameof(DataResult<TItem>.Total)}."));
            }
            else
            {
                var sorted = request.ApplySorting(request.ApplyFiltering(AsQuery(SourceItems ?? [])));
                (items, total) = (sorted.Skip(window.StartIndex).Take(window.Count).ToList(), sorted.Count());
            }

            if (version != _loadVersion)
            {
                return new([], _total ?? 0);
            }

            // What's drawn, for Select all's state, and the total, for the count. None back isn't "no rows".
            if (items.Count > 0 || total == 0)
            {
                _items = items;
            }

            _total = total;
            await InvokeAsync(StateHasChanged);
            return new(items.Select((item, i) => new VirtualRow(window.StartIndex + i, item)), total);
        }
        // Only Virtualize's own cancelling is expected: a provider's timeout is a failure like any other.
        catch (Exception ex) when (ex is not OperationCanceledException || !window.CancellationToken.IsCancellationRequested)
        {
            if (version != _loadVersion)
            {
                return new([], _total ?? 0);
            }

            Logger?.LogError(ex, "The {View}'s rows failed to load.", ViewName);
            _loadError = ex;
            await InvokeAsync(StateHasChanged);
            return new([], _total ?? 0);
        }
    }

    // The inside of the root element, which each view draws itself.
    internal RenderFragment Body => __builder =>
    {
            <CascadingValue Value="this" IsFixed="true">
                @Columns
                @ColumnsReadyNotifier
            </CascadingValue>
            @AboveGrid
            @SelectionBar
            @ErrorStatus
            @GridStyleSheet
            @if (HasBands)
            {
                <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/bands.css"]" />
            }
            <div class="ib-table-scroll" role="region" aria-label="@(Caption ?? TextDefaults.TableName)" tabindex="0" style="@ScrollStyle" @ref="_scrollRef">
                <table id="@GridId" class="@(HasBands ? "ib-table-grid ib-table-banded" : "ib-table-grid")" role="@StackRole("table")" style="@GridStyle" aria-busy="@(IsLoading ? "true" : null)" aria-rowcount="@(VirtualRows ? (_total ?? 0) + HeaderRows + (HasFooterRow ? 1 : 0) : null)" data-ib-first="@(VirtualRows ? HeaderRows + 1 : null)" data-ib-load="@(VirtualRows ? _virtualLoad : null)">
                    @if (Caption is not null)
                    {
                        <caption class="ib-visually-hidden">@Caption</caption>
                    }
                    @(ColGroup ?? (HasBands ? PlainBandColGroups : null))
                <thead role="@StackRole("rowgroup")">
                        @{ var bandDepth = BandDepth; }
                        @for (var level = 0; level < bandDepth; level++)
                        {
                            <tr class="ib-table-band-row" role="@StackRole("row")" aria-rowindex="@(VirtualRows ? level + 1 : null)">
                                @GripEmptyCell
                                @if (Selectable)
                                {
                                    <td class="@SelectCellClass"></td>
                                }
                                @LeadCell
                                @foreach (var span in BandRow(level))
                                {
                                    if (span.Band is { } band)
                                    {
                                        @* The outermost bands name their column groups; a band inside one covers the columns it spans. *@
                                        <th scope="@(band.Parent is null ? "colgroup" : "col")" colspan="@(span.Count > 1 ? span.Count : null)" class="@BandClass(band, span)" role="@StackRole("columnheader")" style="@BandStyle(span)" @attributes="BandAttributes(band, span)">@BandHeader(band, span)</th>
                                    }
                                    else
                                    {
                                        <td class="@BandGapClass(Shown[span.First])" style="@CellStyle(Shown[span.First])"></td>
                                    }
                                }
                                @LastEmptyCell
                            </tr>
                        }
                        <tr role="@StackRole("row")" aria-rowindex="@(VirtualRows ? bandDepth + 1 : null)">
                            @GripHeader
                            @if (Selectable)
                            {
                                @* Select all: script only. For the page, it checks the rows, which report their own changes. *@
                                <th scope="col" class="@SelectCellClass" role="@StackRole("columnheader")">
                                    @* The column's name while select-all is hidden (no script yet). *@
                                    <span class="ib-visually-hidden ib-table-select-heading">@(SelectRowLabel ?? TextDefaults.SelectRow)</span>
                                    @if (MultiSelect)
                                    {
                                        <input type="checkbox" class="ib-check-input ib-table-select-all" aria-label="@(SelectAllLabel ?? TextDefaults.SelectAllRows)" checked="@SelectAllChecked" @attributes="SelectAllMatching" />
                                    }
                                </th>
                            }
                            @LeadHeader
                            @{ var headerFilters = HasFilters ? CurrentFilters() : null; }
                            @foreach (var column in Shown)
                            {
                                <th scope="col" class="@CellClass(column)" role="@StackRole("columnheader")" style="@HeaderStyle(column)" aria-sort="@AriaSort(column)" @attributes="HeaderAttributes(column)">
                                    @if (column == Shown[0] && FirstHeaderLead is { } headerLead)
                                    {
                                        <div class="ib-tree-head">
                                            @headerLead
                                            @HeaderContent(column, headerFilters)
                                        </div>
                                    }
                                    else
                                    {
                                        @HeaderContent(column, headerFilters)
                                    }
                                    @HeaderHandle(column)
                                </th>
                            }
                            @LastHeaderCell
                        </tr>
                        @if (ShowsFilterRow && headerFilters is not null)
                        {
                            <tr class="ib-table-filter-row" aria-rowindex="@(VirtualRows ? bandDepth + 2 : null)">
                                @GripEmptyCell
                                @if (Selectable)
                                {
                                    <td class="@SelectCellClass"></td>
                                }
                                @LeadCell
                                @foreach (var column in Shown)
                                {
                                    <td class="@CellClass(column)" style="@HeaderStyle(column)">
                                        @if (column.CanFilter)
                                        {
                                            @FilterCell(column, headerFilters.GetValueOrDefault(column.Key!) ?? ColumnFilter.Empty(column))
                                        }
                                    </td>
                                }
                                @LastEmptyCell
                            </tr>
                        }
                    </thead>
                    <tbody class="@RowsClass" role="@StackRole("rowgroup")">
                        @if (_loadError is null && NewRowItem is { } added)
                        {
                            <tr data-ib-editing="">
                                @GripEmptyCell
                                @if (Selectable)
                                {
                                    <td class="@SelectCellClass"></td>
                                }
                                @LeadCell
                                @foreach (var column in Shown)
                                {
                                    <td class="@CellClass(column)" style="@CellStyle(column)">@(EditCell(column) ?? column.Cell(added))</td>
                                }
                                @LastCell(added)
                            </tr>
                            @AfterNewRow(added)
                        }
                        @if (_loadError is not null)
                        {
                            @* In place of the rows: what went wrong and a way to try again. *@
                            _virtualShape = null;
                            <tr class="ib-table-empty ib-table-error" role="@StackRole("row")">
                                <td role="@StackRole("cell")" colspan="@Math.Max(1, Shown.Count + StartSpan + LeadSpan + (LastHeaderCell is null ? 0 : 1))">
                                    <div class="ib-table-empty-content ib-data-error-content">
                                        @LoadFailedMessage
                                        @RetryControl(RetryAsync, _providerLoading)
                                    </div>
                                </td>
                            </tr>
                        }
                        else if (GroupRows is { } groups)
                        {
                            @groups
                        }
                        else if (_items.Count == 0 && IsLoading)
                        {
                            @for (var i = 0; i < SkeletonRows; i++)
                            {
                                @SkeletonRow
                            }
                        }
                        else if (_items.Count == 0)
                        {
                            <tr class="ib-table-empty" role="@StackRole("row")">
                                <td role="@StackRole("cell")" colspan="@Math.Max(1, Shown.Count + StartSpan + LeadSpan + (LastHeaderCell is null ? 0 : 1))">
                                    <div class="ib-table-empty-content">
                                        @if (NoneTicked() is { } unticked)
                                        {
                                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterNoneEmpty, unticked.FullName)
                                        }
                                        else if (EmptyContent is not null)
                                        {
                                            @EmptyContent
                                        }
                                        else
                                        {
                                            @(EmptyText ?? TextDefaults.NoItems)
                                        }
                                        @if (HasFilters && !FilterPanel && ActiveFilterCount > 0)
                                        {
                                            @* The way back from no rows, wherever the filters that did it are. *@
                                            <div class="ib-table-empty-clear">
                                                @ClearAction(true, () => ClearFiltersHref, ClearFiltersAsync, TextDefaults.ClearFilters)
                                            </div>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @if (VirtualRows)
                            {
                                <Virtualize @key="_virtualLoad" @ref="_virtualize" TItem="VirtualRow" ItemsProvider="WindowProvider" ItemContent="VirtualRowContent" Placeholder="@(_ => SkeletonRow)" ItemSize="(float)VirtualRowHeight" OverscanCount="5" SpacerElement="tr" />
                            }
                            else
                            {
                                @for (var index = 0; index < _items.Count; index++)
                                {
                                    var item = _items[index];
                                    var at = index;
                                    if (RowKey(KeyOf(item)) is { } rowKey)
                                    {
                                        @* Opened here, so the key sits among the loop's own siblings: in a fragment
                                           of its own it would only be compared with the row at the same place. By hand,
                                           as Razor finds only public components by tag; numbered past Razor's own. *@
                                        __builder.OpenComponent<KeyedRows>(100000);
                                        __builder.SetKey(rowKey);
                                        __builder.AddComponentParameter(100001, nameof(KeyedRows.ChildContent), RowWithDetail(item, at));
                                        __builder.CloseComponent();
                                    }
                                    else
                                    {
                                        @DataRow(item, at, null)
                                        @AfterRow(item, at, null)
                                    }
                                }
                            }
                        }
                    </tbody>
                    @if (Shown.Any(c => c.HasFooter))
                    {
                        <tfoot role="@StackRole("rowgroup")">
                            <tr role="@StackRole("row")" aria-rowindex="@(VirtualRows ? (_total ?? 0) + HeaderRows + 1 : null)">
                                @GripEmptyCell
                                @if (Selectable)
                                {
                                    <td class="@SelectCellClass" role="@StackRole("cell")"></td>
                                }
                                @LeadCell
                                @foreach (var column in Shown)
                                {
                                    <td class="@CellClass(column)" role="@StackRole("cell")" style="@CellStyle(column)">@(column.WrittenFooter ?? AggregateCell(column, _grandTotal, AggregatePlace.Footer))</td>
                                }
                                @LastEmptyCell
                            </tr>
                        </tfoot>
                    }
                </table>
                @* Loading on scroll: the keyboard's way on, under the last row, inside the scroll box. *@
                @MoreRow
            </div>
            @if (FilterPanel || ExtraCount > 0 || (HasFilters && GridColumns))
            {
                @* Below the rows, so nothing here can move them. FilterPanel lists every filter. Without it, this
                   is only for what no funnel can show: a bound filter's conditions that no column's panel holds,
                   and a filter on a hidden column. On a grid it's always rendered, hidden while empty, as enhanced
                   navigation's merge would otherwise turn the footer into it. *@
                var listed = FilterPanel ? FilteredColumns() : FilteredColumns().Where(c => !Shown.Contains(c)).ToList();
                var count = listed.Count + ExtraCount;
                <div class="ib-table-filter-tags" role="group" aria-label="@TextDefaults.Filters" hidden="@(!FilterPanel && count == 0)">
                    @if (FilterPanel && count == 0)
                    {
                        <span class="ib-table-filter-none">@TextDefaults.FiltersNone</span>
                    }
                    @ActiveFilterTags(listed)
                    @if (FilterPanel)
                    {
                        <div class="ib-table-filter-clear-all">
                            @if (BuilderPanelId is { } panel)
                            {
                                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm ib-filter-builder-tool" popovertarget="@panel">@TextDefaults.FilterEdit</button>
                            }
                            @* Only with something to clear, named for what it clears; the row keeps its place without it. *@
                            @if (count > 0)
                            {
                                @ClearAction(true, () => ClearFiltersHref, ClearFiltersAsync, TextDefaults.ClearFilters)
                            }
                        </div>
                    }
                </div>
            }
            @if (NeedsFilterForm && !StateLayout)
            {
                @* The filters' GET form. Its fields join it through form="", not by nesting, so a table
                   inside another form (a selection form) still works: if the browser drops this nested
                   form, the filters belong to no form and never post with the outer one. *@
                <form id="@FilterFormId" method="get" action="@ActionPath" class="ib-table-filter-form"></form>
                <div class="ib-table-filter-kept">
                    @foreach (var (key, value) in KeptQuery())
                    {
                        <input type="hidden" name="@key" value="@value" form="@FilterFormId" />
                    }
                </div>
                @if (ShowsFilterRow)
                {
                    @FilterRowForm
                }
            }
            @Footer(PagesLabel)
    };

    /// <summary>The columns: <see cref="PropertyColumn{TItem, TValue}"/>, <see cref="TemplateColumn{TItem}"/> and <see cref="DynamicColumn{TItem}"/>, in <see cref="ColumnBand"/>s if you like.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>The sort when the URL has none, such as <c>"name"</c> or <c>"-date"</c> (descending). A DataGrid takes several: <c>"status,-date"</c>.</summary>
    [Parameter] public string? InitialSort { get; set; }

    /// <summary>
    /// The sort, such as <c>"name"</c> or <c>"-date"</c> (descending), or several in a DataGrid
    /// (<c>"status,-date"</c>); null for <see cref="InitialSort"/>. Binding it (<c>@bind-Sort</c>) on an interactive page keeps sort
    /// and page in the component instead of the URL.
    /// </summary>
    [Parameter] public string? Sort { get; set; }

    /// <summary>Raised when a header is chosen, on interactive pages.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string?> SortChanged { get; set; }

    /// <summary>
    /// The filter: <c>Filter.All</c> of a condition per filtered column (contains for text, between
    /// for numbers, equals for dates, equals or in for choices), or null for none. Binding it
    /// (<c>@bind-Filter</c>) on an interactive page keeps filters, sort and page in the component
    /// instead of the URL. Set it in C#, such as
    /// <c>Filter.Where("status", FilterOperator.Equals, "Paid")</c>; a condition no column's panel
    /// can show still applies, and shows as a tag that removes it.
    /// </summary>
    [Parameter] public IzzyBlazor.Filter? Filter { get; set; }

    /// <summary>Raised when a filter changes, on interactive pages (typing waits for a pause).</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<IzzyBlazor.Filter?> FilterChanged { get; set; }

    /// <summary>
    /// How text compares in the column filters and search. Defaults to <see cref="FilterCase.IgnoreCase"/>,
    /// which lowers both sides. <see cref="FilterCase.Database"/> compares text as it is and leaves it
    /// to the database's collation, so an index can serve it. An export endpoint sets
    /// <see cref="DataField{TItem}.Case"/> on its own fields, or the file and the screen can differ.
    /// </summary>
    [Parameter] public FilterCase FilterCase { get; set; }

    /// <summary>
    /// A row below the rows that lists the active filters, each with a button to remove it, and Clear
    /// for all of them. It's there whether or not anything is filtered, so nothing moves.
    /// </summary>
    [Parameter] public bool FilterPanel { get; set; }

    /// <summary>The table's name for screen readers (a visually hidden caption).</summary>
    [Parameter] public string? Caption { get; set; }

    /// <summary>A class for each row, such as one that highlights overdue orders.</summary>
    [Parameter] public Func<TItem, string?>? RowClass { get; set; }

    /// <summary>
    /// Highlights the row under the pointer, to help follow a wide one across. Defaults to false, as a
    /// highlight suggests a row does something. A row with a <c>RowHref</c> always has it, and a row being
    /// edited never does.
    /// </summary>
    [Parameter] public bool RowHover { get; set; }

    /// <summary>Alternating row backgrounds.</summary>
    [Parameter] public bool Striped { get; set; }

    /// <summary>A line between rows. Defaults to true; the line under the header always shows.</summary>
    [Parameter] public bool RowLines { get; set; } = true;

    /// <summary>A line between columns. Defaults to false.</summary>
    [Parameter] public bool ColumnLines { get; set; }

    /// <summary>
    /// Shades the header, and a DataGrid's <c>FilterRow</c> with it, so they read apart from the rows; its
    /// color is <c>--ib-table-head-bg</c>. Defaults to false. With <see cref="Striped"/> too, the header
    /// is a little lighter than a stripe.
    /// </summary>
    [Parameter] public bool ShadedHeader { get; set; }

    /// <summary>A rounded border around the table. Defaults to true; false for a table that sits inside a card or panel.</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    /// <summary>Row height and text size. <see cref="ControlSize.Sm"/> for dense data. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>A height limit: the rows scroll and the header stays in view.</summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>
    /// Makes each row a link, such as to the item's details page. The whole row is clickable;
    /// links, buttons and checkboxes inside it still work on their own.
    /// </summary>
    [Parameter] public Func<TItem, string?>? RowHref { get; set; }

    /// <summary>
    /// The row for what the page is showing, such as the one whose details are in a panel beside the
    /// table: drawn as selected, and marked <c>aria-current</c> (on its link with <see cref="RowHref"/>).
    /// </summary>
    [Parameter] public Func<TItem, bool>? RowCurrent { get; set; }

    /// <summary>Names a row for screen readers, in its link and its checkbox. Defaults to <see cref="DataViewBase{TItem}.ItemKey"/>.</summary>
    [Parameter] public Func<TItem, string>? RowLabel { get; set; }

    private readonly List<ColumnBase<TItem>> _columns = [];
    private IReadOnlyList<SortField> _sorts = [];
    private bool _columnsReady;
    internal string? _class;
    internal string? _style;
    private ElementReference _scrollRef;
    // The sort a load shaped the request with, shown once the load succeeds.
    private IReadOnlyList<SortField> _shapedSort = [];

    /// <inheritdoc />
    internal override bool ReadyToLoad => _columnsReady;

    // Sort and filters live in the component too (not the URL) on interactive pages that bind them.
    /// <inheritdoc />
    internal override bool ExtraBound => SortChanged.HasDelegate || FilterChanged.HasDelegate;

    /// <inheritdoc />
    internal override string? SortParameter => Sort;

    // The prerender of a bound interactive table leaves out the filters' GET form and its Apply
    // row, as the interactive render will: drawn, they'd go when the circuit connects and the
    // table would jump. Its links (sort, pages) still work until then.
    private bool StateLayout => WillBeInteractive && Bound;

    // A bound filter, as what its columns' panels show and the conditions no panel shows. A Filter
    // parameter is split once the columns that name its fields have registered.
    private IReadOnlyDictionary<string, ColumnFilterValue> _stateFilters = new Dictionary<string, ColumnFilterValue>();
    private IReadOnlyList<IzzyBlazor.Filter> _stateExtra = [];
    private IzzyBlazor.Filter? _lastFilterParam;
    private IzzyBlazor.Filter? _reportedFilter;
    private bool _awaitingEcho;
    private IzzyBlazor.Filter? _unsplitFilter;
    private bool _hasUnsplitFilter;

    // A bound filter's other conditions.
    private int ExtraCount
    {
        get
        {
            StateFilters();
            return UseState ? _stateExtra.Count : AddressFilter().Filter is null ? 0 : 1;
        }
    }
    private CancellationTokenSource? _filterDelay;
    private string? _filterFormId;

    internal bool HasFilters => _columns.Any(c => c.CanFilter);

    /// <summary>Whether anything posts through the filters' GET form.</summary>
    internal virtual bool NeedsFilterForm => HasFilters;

    /// <summary>The URL keys of the view's own fields in that form, beyond the columns'.</summary>
    internal virtual IEnumerable<string> ExtraFilterKeys => [];

    internal string FilterFormId => _filterFormId ??= IdGenerator.Next("ib-table-filters");

    private string FilterQueryKey(ColumnBase<TItem> column) => $"{QueryPrefix}f-{column.Key}";

    // Every URL key a column's filter uses.
    private IEnumerable<string> FilterQueryKeys(ColumnBase<TItem> column) => ColumnFilter.KeysOf(column, FilterQueryKey(column));

    // GET replaces the query string with the form's fields, so the action is just the path.
    private string ActionPath => new Uri(Navigation.Uri).AbsolutePath;

    // Filters from the URL, for the filterable columns.
    private Dictionary<string, ColumnFilterValue> ReadFilters()
    {
        CheckFilterKeys();
        var query = QueryString.Of(Navigation.Uri);
        var filters = new Dictionary<string, ColumnFilterValue>(StringComparer.OrdinalIgnoreCase);
        foreach (var column in _columns.Where(c => c.CanFilter))
        {
            if (ColumnFilter.Read(column, FilterQueryKey(column), query) is { } value)
            {
                filters[column.Key!] = value;
            }
        }

        return filters;
    }

    // A column "price" posts f-price, f-price-op and f-price-to: a column keyed "price-to" would
    // share one.
    private void CheckFilterKeys()
    {
        var taken = new Dictionary<string, ColumnBase<TItem>>(StringComparer.OrdinalIgnoreCase);
        foreach (var column in _columns.Where(c => c.CanFilter))
        {
            foreach (var key in FilterQueryKeys(column))
            {
                if (taken.TryGetValue(key, out var other) && other != column)
                {
                    throw new InvalidOperationException(
                        $"The \"{column.FullName}\" and \"{other.FullName}\" columns both filter through ?{key}. Give one a different {nameof(ColumnBase<TItem>.SortKey)}.");
                }

                taken[key] = column;
            }
        }
    }

    // A sort or an aggregate finds its column by key, so two sharing one would quietly use the first.
    private void CheckSortKeys()
    {
        var taken = new Dictionary<string, ColumnBase<TItem>>(StringComparer.OrdinalIgnoreCase);
        // One with no key goes by its title, which columns in different bands often share.
        foreach (var column in _columns.Where(c => c.Key is not null ? c.CanSort || c.HasAggregate : c.HasAggregate))
        {
            var key = column.Key ?? column.AggregateKey;
            if (taken.TryGetValue(key, out var other))
            {
                throw new InvalidOperationException(
                    $"The \"{column.FullName}\" and \"{other.FullName}\" columns both have the key \"{key}\". Give one a different {nameof(ColumnBase<TItem>.SortKey)}.");
            }

            taken[key] = column;
        }
    }

    private IReadOnlyDictionary<string, ColumnFilterValue> CurrentFilters() => UseState ? StateFilters() : ReadFilters();

    // The columns filtered now.
    private List<ColumnBase<TItem>> FilteredColumns()
    {
        var filters = CurrentFilters();
        return _columns.Where(c => c.CanFilter && filters.GetValueOrDefault(c.Key!) is { IsFilter: true }).ToList();
    }

    // The first column whose list has nothing ticked, which is why there are no rows.
    private ColumnBase<TItem>? NoneTicked()
    {
        var filters = CurrentFilters();
        return _columns.FirstOrDefault(c => c.CanFilter && filters.GetValueOrDefault(c.Key!) is { None: true });
    }

    private IReadOnlyDictionary<string, ColumnFilterValue> StateFilters()
    {
        if (_hasUnsplitFilter && _columnsReady)
        {
            _hasUnsplitFilter = false;
            (_stateFilters, _stateExtra) = SplitFilter(_unsplitFilter);
        }

        return _stateFilters;
    }

    // A filter as each filterable column's panel state, where its panel can show the condition,
    // and the rest.
    private (IReadOnlyDictionary<string, ColumnFilterValue> Columns, IReadOnlyList<IzzyBlazor.Filter> Extra) SplitFilter(IzzyBlazor.Filter? filter)
    {
        var columns = new Dictionary<string, ColumnFilterValue>(StringComparer.OrdinalIgnoreCase);
        var extra = new List<IzzyBlazor.Filter>();
        foreach (var condition in Conditions(filter))
        {
            var column = condition is FieldFilter f ? _columns.FirstOrDefault(c => c.CanFilter && string.Equals(c.Key, f.Field, StringComparison.OrdinalIgnoreCase)) : null;
            if (column is not null && !columns.ContainsKey(column.Key!) && ColumnFilter.StateOf(column, (FieldFilter)condition) is { } state)
            {
                columns[column.Key!] = state;
            }
            else
            {
                extra.Add(condition);
            }
        }

        return (columns, extra);

        // The conditions every match meets: an and group's, through nested ones.
        static IEnumerable<IzzyBlazor.Filter> Conditions(IzzyBlazor.Filter? filter) => filter switch
        {
            null => [],
            FilterGroup { Logic: FilterLogic.And } g => g.Filters.SelectMany(Conditions),
            _ => [filter],
        };
    }

    // The filter tree for a request: each filtered column's condition and a bound filter's others,
    // all together; null when nothing is filtered.
    private IzzyBlazor.Filter? CurrentFilter(ColumnBase<TItem>? except = null)
    {
        var filters = CurrentFilters();
        var conditions = _columns
            .Where(c => c != except && c.CanFilter && filters.ContainsKey(c.Key!))
            .Select(c => ColumnFilter.Condition(c, filters[c.Key!]))
            .OfType<IzzyBlazor.Filter>()
            .Concat(UseState ? _stateExtra : AddressFilter().Filter is { } address ? [address] : [])
            .ToArray();
        return conditions.Length == 0 ? null : IzzyBlazor.Filter.All(conditions);
    }

    // What the filter is, for telling whether it changed since the last load.
    /// <inheritdoc />
    internal override string FilterSignature()
    {
        // First, as it's what splits a new Filter into what's read next.
        var filters = Signature(CurrentFilters());
        return UseState && _stateExtra.Count > 0 ? $"{FilterCase}|{filters}|{string.Join("|", _stateExtra)}"
            : !UseState && AddressFilter().Filter is { } address ? $"{FilterCase}|{filters}|{address}"
            : $"{FilterCase}|{filters}";
    }

    private async Task RemoveExtraAsync(IzzyBlazor.Filter condition)
    {
        _stateExtra = _stateExtra.Where(c => !ReferenceEquals(c, condition)).ToList();
        await ReportFilterAsync();
    }

    // A changed filter starts from the first page; both are told to a bound parent.
    private async Task ReportFilterAsync()
    {
        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_statePage, _stateCursor) = (1, null);
        _reportedFilter = CurrentFilter();
        _awaitingEcho = true;
        await FilterChanged.InvokeAsync(_reportedFilter);
        await ReportFirstPageAsync(pageWas, cursorWas);

        await ReloadIfStaleAsync();
    }

    private static string Signature(IReadOnlyDictionary<string, ColumnFilterValue> filters) =>
        string.Join('&', filters.Where(f => f.Value.IsFilter).OrderBy(f => f.Key, StringComparer.Ordinal).Select(f => $"{f.Key}={f.Value.Signature}"));

    // The rest of the URL, carried through the filters' GET form: everything but this table's
    // filters and page (a new filter starts at page 1).
    private IEnumerable<(string Key, string Value)> KeptQuery()
    {
        var own = _columns.Where(c => c.CanFilter).SelectMany(FilterQueryKeys).Concat(ExtraFilterKeys).Concat(LinkClears).Append(PageKey).Append(CursorKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
        return QueryString.Of(Navigation.Uri)
            .Where(q => !own.Contains(q.Key))
            .SelectMany(q => q.Value.Select(v => (q.Key, v ?? "")));
    }

    private string ClearFiltersHref => LinkWith(
        _columns.Where(c => c.CanFilter).SelectMany(FilterQueryKeys).Concat(ReadsFilterText ? [FilterTextKey] : []).Append(PageKey).Append(CursorKey).Distinct().ToDictionary(k => k, _ => (object?)null));

    /// <summary>The address's key for a whole filter as text, which a FilterBuilder writes. It's anded with the columns' own.</summary>
    internal string FilterTextKey => $"{QueryPrefix}filter";

    // That filter. One that can't be read matches nothing, and a tag says so, rather than quietly showing every row.
    private (IzzyBlazor.Filter? Filter, bool Unreadable) AddressFilter()
    {
        if (!ReadsFilterText)
        {
            return (null, false);
        }

        var text = QueryString.Of(Navigation.Uri).GetValueOrDefault(FilterTextKey).ToString();
        return string.IsNullOrWhiteSpace(text) ? (null, false)
            : IzzyBlazor.Filter.TryParse(text, out var parsed) ? (parsed, false)
            : (IzzyBlazor.Filter.Any(), true);
    }

    /// <summary>
    /// Applies a whole filter from the address (<c>?filter=</c>, with the <c>QueryPrefix</c>), as a
    /// <see cref="FilterBuilder{TItem}"/> on the page writes it, along with the columns' own. Off by
    /// default, as the page may use that name itself.
    /// </summary>
    [Parameter] public bool FilterFromQuery { get; set; }

    /// <summary>Whether this view reads that filter.</summary>
    internal virtual bool ReadsFilterText => FilterFromQuery;

    /// <summary>The fields a FilterBuilder on this view builds from: its columns.</summary>
    internal IReadOnlyList<DataField<TItem>> BuilderFields => _columns.Select(c => c.ToField(TextDefaults)).OfType<DataField<TItem>>().ToList();

    /// <summary>A bound view's own conditions, as one filter: what a FilterBuilder on it edits.</summary>
    internal IzzyBlazor.Filter? ExtraFilter
    {
        get
        {
            StateFilters();
            return _stateExtra.Count switch
            {
                0 => null,
                1 => _stateExtra[0],
                _ => IzzyBlazor.Filter.All([.. _stateExtra]),
            };
        }
    }

    /// <summary>A FilterBuilder on a bound view applied this.</summary>
    internal async Task SetExtraFilterAsync(IzzyBlazor.Filter? filter)
    {
        _stateExtra = filter is null ? [] : [filter];
        await ReportFilterAsync();
    }

    /// <summary>The id of a FilterBuilder's panel, which the row of filters' Edit opens; null with none.</summary>
    internal virtual string? BuilderPanelId => null;

    // A header's text. Where the band row is hidden (a stacked table), its full name, with its bands',
    // shows instead: the stacked rows' style shows one and hides the other.
    private RenderFragment TitleText(ColumnBase<TItem> column) => __builder =>
    {
        if (StacksBands && column.Band is not null)
        {
            <span hidden data-ib-full>@column.FullName</span>
            <span data-ib-short>@column.HeaderText</span>
        }
        else
        {
            @column.HeaderText
        }
    };

    // The header's title: a sort control (a button when state is in the component, a link
    // otherwise) or plain text.
    private RenderFragment HeaderTitle(ColumnBase<TItem> column) => __builder =>
    {
        if (column.CanSort && UseState)
        {
            <button type="button" class="ib-table-sort" data-ib-primary="@(GridColumns ? "" : null)" @onclick="e => OnSortClickAsync(column, MultiSort && e.ShiftKey)">
                <span class="ib-table-title" title="@(GridColumns ? column.HeaderText : null)">@TitleText(column)</span>
                <Icon Purpose="SortIcon(column)" Class="ib-table-sort-icon" />
                @SortOrder(column)
            </button>
        }
        else if (column.CanSort)
        {
            <a href="@SortHref(column)" class="ib-table-sort" data-ib-primary="@(GridColumns ? "" : null)" data-ib-sort-add="@(MultiSort ? AddSortHref(column) : null)">
                <span class="ib-table-title" title="@(GridColumns ? column.HeaderText : null)">@TitleText(column)</span>
                <Icon Purpose="SortIcon(column)" Class="ib-table-sort-icon" />
                @SortOrder(column)
            </a>
        }
        else
        {
            <span class="ib-table-title" title="@(GridColumns ? column.HeaderText : null)">@TitleText(column)</span>
        }
    };

    // With several columns sorted, which place this one has and which way: aria-sort only says it
    // for the first (ARIA allows it on one header at a time).
    private RenderFragment SortOrder(ColumnBase<TItem> column) => __builder =>
    {
        var index = SortIndex(column);
        if (_sorts.Count > 1 && index >= 0)
        {
            var text = _sorts[index].Descending ? TextDefaults.SortOrderDescending : TextDefaults.SortOrderAscending;
            <span class="ib-table-sort-order"><span aria-hidden="true">@(index + 1)</span><span class="ib-visually-hidden">@string.Format(System.Globalization.CultureInfo.CurrentCulture, text, index + 1)</span></span>
        }
    };

    private string FilterLabel(ColumnBase<TItem> column) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterColumn, column.FullName);

    // What a filter is set to, in words: the text typed, the choice's name, "2 selected", a range
    // ("100–500", "100 or more"), or the operator and its value ("Starts with ada").
    // Days as ISO dates, as a tag says them; the row's cell, as the column shows its dates (days).
    private string FilterSummary(ColumnBase<TItem> column, ColumnFilterValue current, bool days = false)
    {
        if (current.None)
        {
            return TextDefaults.FilterNone;
        }

        if (column.FilterText is { } text)
        {
            return text(current.Values);
        }

        var culture = System.Globalization.CultureInfo.CurrentCulture;
        string Day(string text) => days ? DayText(column, text) : text;
        var (kind, value) = (column.FilterKind, Day(current.Value.Trim()));
        string Worded() => ColumnFilter.TextOf(kind, current.Op, TextDefaults) + (value.Length > 0 ? $" {value}" : "");
        switch (current.Op)
        {
            case FilterOperator.Between:
            {
                var max = Day(current.To?.Trim() ?? "");
                var date = kind == ColumnFilterKind.Date;
                return (value.Length > 0, max.Length > 0) switch
                {
                    (true, true) when value == max => value,
                    (true, true) => string.Format(culture, TextDefaults.FilterBetween, value, max),
                    (true, false) => date ? $"{TextDefaults.FilterOnOrAfter} {value}" : string.Format(culture, TextDefaults.FilterAtLeast, value),
                    (false, true) => date ? $"{TextDefaults.FilterOnOrBefore} {max}" : string.Format(culture, TextDefaults.FilterAtMost, max),
                    _ => "",
                };
            }

            case FilterOperator.GreaterThanOrEqual when kind == ColumnFilterKind.Number:
                return string.Format(culture, TextDefaults.FilterAtLeast, value);
            case FilterOperator.LessThanOrEqual when kind == ColumnFilterKind.Number:
                return string.Format(culture, TextDefaults.FilterAtMost, value);
            case FilterOperator.In when current.Values.Count > 1:
                return string.Format(culture, TextDefaults.FilterSelected, current.Values.Count);
            case FilterOperator.Contains:
                return value;
            case FilterOperator.In when kind == ColumnFilterKind.Choice:
                return ColumnFilter.ListOf(column, TextDefaults).FirstOrDefault(r => string.Equals(r.Value, current.Values[0], StringComparison.OrdinalIgnoreCase)).Text ?? value;
            case FilterOperator.In when column.HasValueList:
                return ValueText(column, current.Values[0]);
            case FilterOperator.NotIn:
                return string.Format(culture, TextDefaults.FilterAllBut, current.Values.Count == 1 ? ValueText(column, current.Values[0]) : current.Values.Count);
            case FilterOperator.Equals when kind != ColumnFilterKind.Text:
            case FilterOperator.In:
                return value;
            default:
                return Worded();
        }
    }

    // A funnel button, marked when the column is filtered, that opens the filter in a popover, with
    // no script too: a list of checkboxes for choices, the field for text, numbers and dates.
    private RenderFragment HeaderFilter(ColumnBase<TItem> column, ColumnFilterValue current) => __builder =>
    {
        var label = FilterLabel(column);
        var name = current.IsFilter ? $"{label}: {FilterSummary(column, current)}" : label;
        var fieldId = $"{FilterFormId}-{_columns.IndexOf(column)}";
        var lists = column.HasValueList && RendererInfo.IsInteractive;
        var toggled = lists ? EventCallback.Factory.Create<bool>(this, open => OnValueListToggleAsync(column, open)) : default;
        <Popover Id="@(ShowsFilterRow ? FilterPanelId(column) : null)" data-ib-user-controlled OpenChanged="toggled">
            <Trigger>
                @* With a row of filters the row is the way in, so the panel stays for it and the button goes. *@
                <button type="button" class="ib-table-filter-button" hidden="@ShowsFilterRow" data-active="@(current.IsFilter ? "" : null)" aria-label="@TextDefaults.FilterButton" title="@name" @attributes="context">
                    <Icon Purpose="IconPurpose.Filter" />
                </button>
            </Trigger>
            <ChildContent>
                @if (column.FilterTemplate is { } template)
                {
                    <div class="ib-table-filter-panel ib-field-sm" role="group" aria-labelledby="@($"{fieldId}-title")">
                        <span class="ib-visually-hidden" id="@($"{fieldId}-title")">@label</span>
                        @template(FilterContextOf(column, current))
                        @FilterPanelActions(column, current)
                    </div>
                }
                else if (column.FilterKind == ColumnFilterKind.Choice)
                {
                    @FilterList(column, current, label, fieldId)
                }
                else if (lists && ShowsValueList(column))
                {
                    @ValueList(column, label, fieldId)
                }
                else if (FetchesValues(column) && ShowsValueList(column))
                {
                    @* The script fetches this list from the page itself. With none, the usual panel. *@
                    @FetchedValueList(column, current, label, fieldId)
                    <div class="ib-filter-no-script">
                        @UsualPanel(column, current, label, $"{fieldId}-usual")
                    </div>
                }
                else
                {
                    @UsualPanel(column, current, label, fieldId)
                }
            </ChildContent>
        </Popover>
    };

    // What a column's own controls get. In the address, a control posts through the GET form as the panel's own
    // do, and the script finds it the same way; bound, its changes come here.
    private FilterTemplateContext FilterContextOf(ColumnBase<TItem> column, ColumnFilterValue current)
    {
        var key = FilterQueryKey(column);
        Dictionary<string, object> Posted(string name, bool to = false)
        {
            Dictionary<string, object> attributes = new() { ["name"] = name, ["form"] = FilterFormId, ["data-ib-filter"] = "" };
            if (to) attributes["data-ib-to"] = "";
            return attributes;
        }

        Dictionary<string, object> Bound(Action<string> changed) => new()
        {
            ["onchange"] = EventCallback.Factory.Create<ChangeEventArgs>(this, e => changed(e.Value?.ToString() ?? "")),
        };

        async Task SetValues(IReadOnlyList<string?> values)
        {
            var state = UseState ? StateOf(column) : current;
            var op = values.Count > 1 ? FilterOperator.In : ColumnFilter.DefaultOperator(column);
            var next = values.Count == 0 && string.IsNullOrEmpty(state.To) ? ColumnFilter.Empty(column) : new ColumnFilterValue(op, values, state.To);
            if (UseState) await SetFilterAsync(column, next, wait: false);
            else Navigation.NavigateTo(FilterHref(column, next));
        }

        void SetTo(string to)
        {
            var state = StateOf(column);
            _ = SetFilterAsync(column, state with { Op = ColumnFilter.DefaultOperator(column), To = to }, wait: false);
        }

        return new(
            current,
            key,
            UseState ? Bound(v => _ = SetValues(string.IsNullOrEmpty(v) ? [] : [v])) : Posted(key),
            UseState ? Bound(SetTo) : Posted($"{key}-to", to: true),
            UseState ? new Dictionary<string, object>() : Posted(key),
            SetValues,
            !UseState ? null : value => EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            {
                var state = StateOf(column);
                return SetValues(e.Value is true ? [.. state.Values, value] : state.Values.Where(v => !string.Equals(v, value, StringComparison.OrdinalIgnoreCase)).ToList());
            }));
    }

    // A column's filter as a field or a summary: the operator and values it takes, or what's in the
    // address that one box can't show.
    private RenderFragment UsualPanel(ColumnBase<TItem> column, ColumnFilterValue current, string label, string fieldId) => __builder =>
    {
        var ops = ColumnFilter.OperatorsOf(column);
        if (ColumnFilter.IsListState(current))
        {
            @* A list from the address that one box can't show: its values post as they came,
               so no script or form changes what the link means, and Clear removes it. *@
            <div class="ib-table-filter-panel ib-field-sm">
                <span class="ib-field-label ib-table-filter-label">@label</span>
                <span>@FilterSummary(column, current)</span>
                @if (!UseState)
                {
                    foreach (var (name, written) in ColumnFilter.Write(column, FilterQueryKey(column), current))
                    {
                        foreach (var value in written as string[] ?? (written is string one ? [one] : []))
                        {
                            <input type="hidden" name="@name" value="@value" form="@FilterFormId" data-ib-filter />
                        }
                    }
                }
                @FilterPanelActions(column, current)
            </div>
        }
        else if (ops.Count > 1 || ops is [FilterOperator.Between])
        {
            @* An operator above the values, and a range's two ends, in a group named by the
               panel's title. Which of them show follows the operator, in CSS. *@
            <div class="@(ops.Count == 1 ? "ib-table-filter-panel ib-table-filter-between ib-field-sm" : "ib-table-filter-panel ib-field-sm")" role="group" aria-labelledby="@($"{fieldId}-title")">
                <span class="ib-visually-hidden" id="@($"{fieldId}-title")">@label</span>
                @if (ops.Count > 1)
                {
                    @OperatorSelect(column, current, ops, $"{fieldId}-op")
                }
                <div class="ib-table-filter-range">
                    @FilterInput(column, current.Value, $"{fieldId}-min", ValueLabel(column, ops, $"{fieldId}-min"), second: false, autofocus: !ColumnFilter.TakesNoValue(current.Op))
                    @if (ops.Contains(FilterOperator.Between))
                    {
                        <div class="ib-table-filter-to">
                            @FilterInput(column, current.To ?? "", $"{fieldId}-max", UpperLabel(column, $"{fieldId}-max"), second: true, autofocus: false)
                        </div>
                    }
                </div>
                @FilterPanelActions(column, current)
            </div>
        }
        else
        {
            <div class="ib-table-filter-panel ib-field-sm">
                <label class="ib-field-label ib-table-filter-label" for="@fieldId">@label</label>
                @FilterInput(column, current.Value, fieldId, null, second: false, autofocus: true)
                @FilterPanelActions(column, current)
            </div>
        }
    };

    // Clear: a link on static pages, so it needs no script, and with nothing to clear it's disabled, so
    // the panel keeps its shape.
    // In a list's panel it's marked: (Select all) does the same, so its script hides it, and it's
    // left for pages with no script.
    private RenderFragment ClearAction(bool any, Func<string> href, Func<Task> clear, string? text = null, bool list = false) => __builder =>
    {
        const string look = "ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm";
        if (!any)
        {
            <button type="button" class="@look" disabled data-ib-list-clear="@(list ? "" : null)">@(text ?? TextDefaults.Clear)</button>
        }
        else if (UseState)
        {
            <button type="button" class="@look" data-ib-filter-clear data-ib-list-clear="@(list ? "" : null)" @onclick="() => clear()">@(text ?? TextDefaults.Clear)</button>
        }
        else
        {
            <a href="@href()" class="@look" data-ib-filter-clear data-ib-list-clear="@(list ? "" : null)">@(text ?? TextDefaults.Clear)</a>
        }
    };

    /// <summary>How many filters are active: a column's, and a bound filter's that no column shows.</summary>
    internal int ActiveFilterCount => FilteredColumns().Count + ExtraCount;

    // A removable tag for each of these columns' filters and each of a bound filter's other conditions.
    private RenderFragment ActiveFilterTags(IEnumerable<ColumnBase<TItem>> columns) => __builder =>
    {
        foreach (var column in columns)
        {
            var summary = FilterSummary(column, CurrentFilters()[column.Key!]);
            <Tag Label="@($"{column.FullName}: {summary}")" Size="ControlSize.Sm"
                 RemoveHref="@(UseState ? null : FilterHref(column, null))"
                 OnRemove="@(UseState ? EventCallback.Factory.Create(this, () => SetFilterAsync(column, ColumnFilter.Empty(column), wait: false)) : default)" />
        }

        if (UseState)
        {
            @* In the filter's own words, as no column's panel shows them. *@
            foreach (var extra in _stateExtra)
            {
                var condition = extra;
                <Tag Label="@condition.ToString()" Size="ControlSize.Sm" OnRemove="@(EventCallback.Factory.Create(this, () => RemoveExtraAsync(condition)))" />
            }
        }
        else if (AddressFilter() is { Filter: { } address } read)
        {
            <Tag Label="@(read.Unreadable ? TextDefaults.FilterUnreadable : address.ToString())" Size="ControlSize.Sm"
                 RemoveHref="@LinkWith(new Dictionary<string, object?> { [FilterTextKey] = null, [PageKey] = null, [CursorKey] = null })" />
        }
    };

    // A column's Clear removes its filter. Enter or Apply submits the filters' GET form, or with script
    // goes to the address the same way without a reload. On an interactive page the fields apply as they
    // change, and CSS hides that button.
    private RenderFragment FilterPanelActions(ColumnBase<TItem> column, ColumnFilterValue current, bool list = false) => __builder =>
    {
        <div class="ib-table-filter-panel-actions">
            @ClearAction(current.IsFilter, () => FilterHref(column, null), () => SetFilterAsync(column, ColumnFilter.Empty(column), wait: false), list: list)
            @if (!UseState)
            {
                <button type="submit" form="@FilterFormId" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm ib-table-filter-apply">@TextDefaults.Apply</button>
            }
        </div>
    };

    // A choice filter's list: a checkbox per value, all ticked with no filter. Static pages post them
    // through the GET form under the column's key, and the blank row under its own; bound pages handle
    // each change. Script adds Select all and the search, which narrows the rows and applies nothing.
    private RenderFragment FilterList(ColumnBase<TItem> column, ColumnFilterValue current, string label, string fieldId) => __builder =>
    {
        var key = FilterQueryKey(column);
        var rows = ColumnFilter.ListOf(column, TextDefaults);
        var search = rows.Count > 10;
        <div class="ib-table-filter-panel ib-field-sm" role="group" aria-labelledby="@($"{fieldId}-title")">
            <span class="ib-visually-hidden" id="@($"{fieldId}-title")">@label</span>
            <ib-filter-list data-ib-none="@(UseState ? null : $"{key}-none")" data-ib-ticked="@(string.Join(' ', rows.Where(r => ColumnFilter.IsTicked(current, r.Value)).Select(r => r.Value ?? "")))" data-ib-results="@TextDefaults.FilterSelectAllResults">
                @if (search)
                {
                    <div class="ib-field ib-field-sm ib-filter-list-search">
                        <div class="ib-field-control">
                            <input type="search" class="ib-field-input" aria-label="@TextDefaults.FilterSearchValues" placeholder="@TextDefaults.SearchPlaceholder" autocomplete="off" autofocus data-ib-list-search />
                        </div>
                    </div>
                }
                <label class="ib-check ib-filter-list-all">
                    <input type="checkbox" class="ib-check-input" autofocus="@(!search)" data-ib-list-all />
                    <span>@TextDefaults.FilterSelectAll</span><span data-ib-list-results hidden></span>
                </label>
                <div class="ib-filter-list-items">
                    @foreach (var (value, text) in rows)
                    {
                        var on = ColumnFilter.IsTicked(current, value);
                        <label class="ib-check">
                            @if (UseState)
                            {
                                <input type="checkbox" class="ib-check-input" checked="@on"
                                       @onchange="e => SetFilterAsync(column, ColumnFilter.Tick(column, StateOf(column), value, e.Value is true), wait: true)" />
                            }
                            else
                            {
                                <input type="checkbox" class="ib-check-input" name="@(value is null ? $"{key}-blank" : key)" value="@(value ?? "1")" checked="@on" form="@FilterFormId" data-ib-filter />
                            }
                            <span>@text</span>
                        </label>
                    }
                </div>
            </ib-filter-list>
            @FilterPanelActions(column, current, list: true)
        </div>
    };

    // What's kept of a list of looked-up values on an interactive page, by column. Rows stay while the
    // next ones load, so opening a panel again doesn't flicker.
    private sealed class ValueListState
    {
        public List<FilterValue> Rows = [];
        public int NextSkip;
        public bool HasMore;
        public bool Loading;
        public bool Failed;
        public bool LastWasMore;

        // What's in the box, and what the rows are for: the rows don't change until they've come.
        public string Search = "";
        public string RowsSearch = "";

        public CancellationTokenSource? Load;
        public CancellationTokenSource? SearchPause;

        // On a page with no bound filter, ticks wait here for their pause, and until the address has them.
        public ColumnFilterValue? Pending;
        public CancellationTokenSource? Apply;
        public bool Waiting;

        // What the column's keys say in the address, to tell a move that's about them, and what these ticks will make them.
        public string? Before;
        public string? Sent;

        // What must stay listed, as the first page was asked: a later page counts from it, whatever's ticked since.
        public IReadOnlyList<string?> Ticked = [];
        public IReadOnlyList<string?> Unticked = [];

        // Whether these rows are every value there is, with nothing narrowing them.
        public bool Whole;

        // While open, which panel it opened as: clearing the usual panel doesn't swap it under the keyboard.
        public bool? OpenAsList;

        public bool Searching => !string.IsNullOrWhiteSpace(RowsSearch);

        public bool Full => Rows.Count >= MaxValueRows;
    }

    // How many rows a list holds before asking for more typing instead.
    private const int MaxValueRows = 500;

    private readonly Dictionary<string, ValueListState> _valueLists = new(StringComparer.OrdinalIgnoreCase);

    private ValueListState ValueListOf(ColumnBase<TItem> column)
    {
        if (!_valueLists.TryGetValue(column.Key!, out var list))
        {
            _valueLists[column.Key!] = list = new();
        }

        return list;
    }

    // What the list's boxes show: ticks waiting to reach the address, or the filter.
    private ColumnFilterValue ValueListFilter(ColumnBase<TItem> column) =>
        ValueListOf(column).Pending ?? CurrentFilters().GetValueOrDefault(column.Key!) ?? ColumnFilter.Empty(column);

    // A condition the list can't show (from a link, or a bound filter) has the column's usual panel.
    private bool ShowsValueList(ColumnBase<TItem> column) =>
        ValueListOf(column).OpenAsList ?? (ValueListFilter(column) is var value && (!value.IsFilter || ColumnFilter.IsListState(value)));

    private StringComparer ValueComparer => FilterCase == FilterCase.IgnoreCase ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal;

    // A day as the column shows its dates (its Format, if a date can take it), else the culture's short date.
    private static string DayText(ColumnBase<TItem> column, string text)
    {
        if (column.FilterKind != ColumnFilterKind.Date || !ColumnFilter.TryParseDay(text, out var day))
        {
            return text;
        }

        var culture = System.Globalization.CultureInfo.CurrentCulture;
        try
        {
            return column.ValueFormat is { } format ? day.ToString(format, culture) : day.ToString("d", culture);
        }
        catch (FormatException)
        {
            return day.ToString("d", culture);
        }
    }

    // A value in words: the blank row's, or what the rows loaded say, as a loader can show a name for an id.
    private string ValueText(ColumnBase<TItem> column, string? value) => value is null
        ? TextDefaults.FilterBlank
        : ValueListOf(column).Rows.FirstOrDefault(r => ValueComparer.Equals(r.Value, value))?.Text ?? value;

    /// <summary>The words a DataGrid's search holds, for narrowing a list.</summary>
    internal virtual string? ValuesGridSearch => null;

    // A list of looked-up values, drawn here as C# holds them: rows, Select all and the search all come
    // from the server, so the script leaves them alone (data-ib-list-remote). Static pages and no
    // script have the column's usual panel.
    private RenderFragment ValueList(ColumnBase<TItem> column, string label, string fieldId) => __builder =>
    {
        var list = ValueListOf(column);
        var current = ValueListFilter(column);
        var full = !current.None && current.Values.Count >= ColumnFilter.MaxListValues;
        var searchTooLong = list.Searching && (list.HasMore || list.Full);
        var message = list.Failed ? TextDefaults.FilterValuesFailed
            : list.Searching && list.Rows.Count == 0 && !list.Loading ? TextDefaults.FilterNoValues
            : full ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterValuesLimit, ColumnFilter.MaxListValues)
            : searchTooLong || list.Full ? TextDefaults.FilterKeepTyping
            : null;
        <div class="ib-table-filter-panel ib-field-sm" role="group" aria-labelledby="@($"{fieldId}-title")">
            <span class="ib-visually-hidden" id="@($"{fieldId}-title")">@label</span>
            <ib-filter-list data-ib-list-remote data-ib-load-on-scroll data-ib-all="@AllTicked(list, current)" aria-busy="@(list.Loading ? "true" : null)">
                <div class="ib-field ib-field-sm ib-filter-list-search">
                    <div class="ib-field-control">
                        <input type="search" class="ib-field-input" aria-label="@TextDefaults.FilterSearchValues" placeholder="@TextDefaults.SearchPlaceholder" autocomplete="off" autofocus data-ib-bound-search
                               @oninput="e => OnValueSearchAsync(column, list, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                </div>
                <label class="ib-check ib-filter-list-all">
                    <input type="checkbox" class="ib-check-input" disabled="@(!CanSelectAll(list, current))" data-ib-list-all
                           @onchange="e => OnValueSelectAllAsync(column, list, e.Value is true)" />
                    <span hidden="@(list.Searching && !searchTooLong)">@TextDefaults.FilterSelectAll</span><span data-ib-list-results hidden="@(!list.Searching || searchTooLong)">@string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterSelectAllResults, list.Rows.Count)</span>
                </label>
                <div class="ib-filter-list-items">
                    @foreach (var row in list.Rows)
                    {
                        var on = ColumnFilter.IsValueTicked(current, row.Value, ValueComparer);
                        <label @key="row.Value ?? BlankRowKey" class="ib-check">
                            <input type="checkbox" class="ib-check-input" checked="@on" disabled="@(full && on == (current.Op == FilterOperator.NotIn))"
                                   @onchange="e => OnValueTickAsync(column, list, row.Value, e.Value is true)" />
                            <span>@(row.Text ?? row.Value ?? TextDefaults.FilterBlank)</span>
                        </label>
                    }
                    @if (list.HasMore && !list.Full && !list.Failed)
                    {
                        @* Script presses the hidden one as the last row comes into view; the other is the keyboard's. *@
                        <Button Class="ib-data-more-on-focus" Accent="Accent.Neutral" Variant="ButtonVariant.Outline" Size="ControlSize.Sm" Loading="list.Loading" data-ib-list-more OnClick="() => LoadValuesAsync(column, list, more: true)">@TextDefaults.LoadMore</Button>
                        @if (!list.Loading)
                        {
                            <button type="button" hidden data-ib-load-next @onclick="() => LoadValuesAsync(column, list, more: true)"></button>
                        }
                    }
                </div>
                @if (list.Loading && list.Rows.Count == 0)
                {
                    <Spinner />
                }
                <div class="ib-filter-list-status" role="status">@message</div>
                @if (list.Failed)
                {
                    <Button Accent="Accent.Neutral" Variant="ButtonVariant.Outline" Size="ControlSize.Sm" data-ib-list-retry OnClick="() => LoadValuesAsync(column, list, list.LastWasMore)">@TextDefaults.Retry</Button>
                }
            </ib-filter-list>
            @FilterPanelActions(column, current, list: true)
        </div>
    };

    // Whether the script fetches this column's list from the page: where nothing in C# can answer.
    private bool FetchesValues(ColumnBase<TItem> column) => column.HasValueList && !WillBeInteractive;

    private string ValuesKey => $"{QueryPrefix}fv";

    // The column whose list this request is for, as the script asks with one more key; null for a page.
    private ColumnBase<TItem>? ValuesAsked()
    {
        if (WillBeInteractive || !QueryString.Of(Navigation.Uri).TryGetValue(ValuesKey, out var field))
        {
            return null;
        }

        return _columns.FirstOrDefault(c => c.CanFilter && c.HasValueList && string.Equals(c.Key, field.ToString(), StringComparison.OrdinalIgnoreCase));
    }

    // Answers the script: the list drawn with its rows, in place of loading the table's. The rest of the
    // page is thrown away. A failure is only the list's, so the response still says so in the same place.
    private Task LoadAskedValuesAsync(ColumnBase<TItem> column)
    {
        var list = ValueListOf(column);
        var query = QueryString.Of(Navigation.Uri);
        list.Search = query.TryGetValue($"{ValuesKey}-search", out var search) ? search.ToString() : "";
        var skip = query.TryGetValue($"{ValuesKey}-skip", out var from) && int.TryParse(from, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var number) ? number : 0;
        _answering = column;
        return LoadValuesAsync(column, list, more: false, skip);
    }

    private ColumnBase<TItem>? _answering;

    // A list the script runs: it fetches the rows on opening and keeps them through navigations
    // (data-permanent keeps the children, and the attributes follow the server), so it sets the ticks
    // from the address itself. This response's own rows are in here when it's the one asked for.
    private RenderFragment FetchedValueList(ColumnBase<TItem> column, ColumnFilterValue current, string label, string fieldId) => __builder =>
    {
        var key = FilterQueryKey(column);
        var answer = _answering == column ? ValueListOf(column) : null;
        <div class="ib-table-filter-panel ib-field-sm ib-filter-with-script" role="group" aria-labelledby="@($"{fieldId}-title")">
            <span class="ib-visually-hidden" id="@($"{fieldId}-title")">@label</span>
            <ib-filter-list data-permanent="@key" data-ib-list-fetch data-ib-load-on-scroll data-ib-list-key="@key" data-ib-values-key="@ValuesKey" data-ib-values-field="@column.Key"
                            data-ib-max="@ColumnFilter.MaxListValues" data-ib-max-rows="@MaxValueRows" data-ib-ignore-case="@(FilterCase == FilterCase.IgnoreCase ? "" : null)"
                            data-ib-results="@TextDefaults.FilterSelectAllResults" data-ib-text-more="@TextDefaults.FilterKeepTyping" data-ib-text-none="@TextDefaults.FilterNoValues"
                            data-ib-text-failed="@TextDefaults.FilterValuesFailed" data-ib-text-limit="@string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterValuesLimit, ColumnFilter.MaxListValues)"
                            data-ib-answered="@(answer is not null ? "" : null)" data-ib-load-failed="@(answer is { Failed: true } ? "" : null)" data-ib-whole="@(answer is { Whole: true } ? "" : null)"
                            data-ib-next="@(answer is { HasMore: true, Failed: false } ? answer.NextSkip : null)">
                <div class="ib-field ib-field-sm ib-filter-list-search">
                    <div class="ib-field-control">
                        <input type="search" class="ib-field-input" aria-label="@TextDefaults.FilterSearchValues" placeholder="@TextDefaults.SearchPlaceholder" autocomplete="off" autofocus data-ib-list-search />
                    </div>
                </div>
                <label class="ib-check ib-filter-list-all">
                    <input type="checkbox" class="ib-check-input" data-ib-list-all />
                    <span>@TextDefaults.FilterSelectAll</span><span data-ib-list-results hidden></span>
                </label>
                <div class="ib-filter-list-items">
                    @if (answer is not null)
                    {
                        foreach (var row in answer.Rows)
                        {
                            <label class="ib-check">
                                <input type="checkbox" class="ib-check-input" value="@row.Value" data-ib-blank="@(row.Value is null ? "" : null)" />
                                <span>@(row.Text ?? row.Value ?? TextDefaults.FilterBlank)</span>
                            </label>
                        }

                        if (answer is { HasMore: true, Failed: false })
                        {
                            <Button Class="ib-data-more-on-focus" Accent="Accent.Neutral" Variant="ButtonVariant.Outline" Size="ControlSize.Sm" data-ib-list-more>@TextDefaults.LoadMore</Button>
                            <button type="button" hidden data-ib-load-next></button>
                        }
                    }
                </div>
                <div data-ib-list-loading hidden><Spinner /></div>
                <div class="ib-filter-list-status" role="status"></div>
                <div data-ib-list-retry-row hidden>
                    <Button Accent="Accent.Neutral" Variant="ButtonVariant.Outline" Size="ControlSize.Sm" data-ib-list-retry>@TextDefaults.Retry</Button>
                </div>
            </ib-filter-list>
            <div class="ib-table-filter-panel-actions">
                @ClearAction(current.IsFilter, () => FilterHref(column, null), () => Task.CompletedTask, list: true)
                <button type="button" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm ib-table-filter-apply">@TextDefaults.Apply</button>
            </div>
        </div>
    };

    // Rows are keyed by their value, and the blank has none. No value is this.
    private static readonly object BlankRowKey = new();

    // Select all acts on the rows it's about: not on rows from before what's in the box, or a search
    // that failed, or a search with more than are here, or past the limit on what a filter holds.
    private static bool CanSelectAll(ValueListState list, ColumnFilterValue current) =>
        !list.Failed && list.Search.Trim() == list.RowsSearch
        && (!list.Searching || (!list.HasMore && !list.Full && list.Rows.Count > 0 && (current.None || current.Values.Count < ColumnFilter.MaxListValues)));

    // What Select all shows, which the script sets: as what's listed when a search narrows it, and
    // otherwise as the filter, as there may be more rows than are here.
    private string AllTicked(ValueListState list, ColumnFilterValue current)
    {
        if (!list.Searching)
        {
            return !current.IsFilter ? "on" : current.None ? "off" : "mixed";
        }

        var ticked = list.Rows.Count(r => ColumnFilter.IsValueTicked(current, r.Value, ValueComparer));
        return ticked == 0 ? "off" : ticked == list.Rows.Count ? "on" : "mixed";
    }

    // Only a panel that's open asks for its values, and it asks each time, as what the other filters
    // leave may have changed. Closing ends a search.
    private Task OnValueListToggleAsync(ColumnBase<TItem> column, bool open)
    {
        var list = ValueListOf(column);
        list.OpenAsList = null;
        if (open)
        {
            list.OpenAsList = ShowsValueList(column);
            return list.OpenAsList == true ? LoadValuesAsync(column, list, more: false) : Task.CompletedTask;
        }

        list.Load?.Cancel();
        list.SearchPause?.Cancel();
        (list.Loading, list.Search) = (false, "");
        return Task.CompletedTask;
    }

    private async Task OnValueSearchAsync(ColumnBase<TItem> column, ValueListState list, string text)
    {
        list.Search = text;
        list.SearchPause?.Cancel();
        var pause = list.SearchPause = new CancellationTokenSource();
        try
        {
            await Task.Delay(FilterDelay, pause.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await LoadValuesAsync(column, list, more: false);
    }

    private async Task LoadValuesAsync(ColumnBase<TItem> column, ValueListState list, bool more, int skip = 0)
    {
        list.Load?.Cancel();
        var load = list.Load = new CancellationTokenSource();
        (list.Loading, list.Failed, list.LastWasMore) = (true, false, more);
        var search = list.Search.Trim();
        if (!more)
        {
            var current = ValueListFilter(column);
            list.Ticked = current is { None: false, Op: FilterOperator.In } ? current.Values : [];
            list.Unticked = current.Op == FilterOperator.NotIn ? current.Values : [];
        }

        var request = new FilterValuesRequest
        {
            Field = column.Key!,
            Search = search.Length > 0 ? search : null,
            Skip = more ? list.NextSkip : skip,
            OtherFilters = CurrentFilter(except: column),
            GridSearch = ValuesGridSearch,
            Ticked = list.Ticked,
            Unticked = list.Unticked,
            CancellationToken = load.Token,
        };

        FilterValuesResult result;
        int asked;
        try
        {
            if (column.FilterValues is { } loader)
            {
                result = await loader(request);
                asked = result.Values.Count;
                result = request.Keeping(result, FilterCase);
            }
            else
            {
                var fields = _columns.Select(c => c.ToField(TextDefaults)).OfType<DataField<TItem>>().ToList();
                result = request.ToResult(AsQuery(SourceItems ?? []), fields);
                asked = result.Values.Count;
            }
        }
        catch (Exception) when (load.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (list.Load == load)
            {
                (list.Loading, list.Failed) = (false, true);
                Logger?.LogError(ex, "The {View}'s list of values for \"{Column}\" failed to load.", ViewName, column.Key);
            }

            return;
        }

        if (list.Load != load || load.IsCancellationRequested)
        {
            return;
        }

        // A loader may well repeat a value it was told to keep.
        var rows = more ? list.Rows : [];
        var known = rows.Select(r => r.Value).ToHashSet();
        rows = [.. rows, .. result.Values.Where(r => known.Add(r.Value))];
        list.Rows = rows.Count > MaxValueRows ? rows.GetRange(0, MaxValueRows) : rows;
        (list.HasMore, list.NextSkip, list.Loading, list.RowsSearch) = (result.HasMore, request.Skip + asked, false, search);
        list.Whole = !list.HasMore && search.Length == 0 && request.OtherFilters is null && string.IsNullOrEmpty(request.GridSearch);
    }

    private Task OnValueTickAsync(ColumnBase<TItem> column, ValueListState list, string? value, bool on) =>
        SetValueListAsync(column, list, ColumnFilter.TickValue(column, ValueListFilter(column), value, on, ValueComparer));

    // With no search it takes in rows that aren't here yet, so it's simply no filter or none. With one,
    // it's each row listed.
    private Task OnValueSelectAllAsync(ColumnBase<TItem> column, ValueListState list, bool on)
    {
        var next = ValueListFilter(column);
        if (!CanSelectAll(list, next))
        {
            return Task.CompletedTask;
        }

        if (list.Searching)
        {
            foreach (var row in list.Rows)
            {
                next = ColumnFilter.TickValue(column, next, row.Value, on, ValueComparer);
            }
        }
        else
        {
            next = on ? ColumnFilter.Empty(column) : new(FilterOperator.In, [], None: true);
        }

        return SetValueListAsync(column, list, next);
    }

    // After the usual pause. With every value there is on these rows and every one the same, all
    // ticked is no filter and none ticked is none, however it got there. Rows the other filters have
    // narrowed aren't that: ticking all of those still means those.
    private async Task SetValueListAsync(ColumnBase<TItem> column, ValueListState list, ColumnFilterValue value)
    {
        if (list.Whole && list.Rows.Count > 0 && value is { None: false, IsFilter: true } && list.Rows.All(r => value.Values.Contains(r.Value, ValueComparer)))
        {
            value = value.Op == FilterOperator.In ? ColumnFilter.Empty(column) : new(FilterOperator.In, [], None: true);
        }

        if (UseState)
        {
            await SetFilterAsync(column, value, wait: true);
            return;
        }

        list.Before = list.Pending is null ? AddressKeys(column, Navigation.Uri) : list.Before;
        list.Pending = value;
        list.Apply?.Cancel();
        var apply = list.Apply = new CancellationTokenSource();
        list.Waiting = true;
        try
        {
            await Task.Delay(FilterDelay, apply.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        list.Waiting = false;

        // Not the section in the address, which Blazor would scroll back to. Ticks that came back to
        // where they started aren't a place in the history.
        var href = FilterHref(column, value).Split('#')[0];
        if (AddressKeys(column, href) == AddressKeys(column, Navigation.Uri))
        {
            list.Pending = null;
            StateHasChanged();
            return;
        }

        list.Sent = AddressKeys(column, href);
        Navigation.NavigateTo(href);
    }

    // The page and what a column's keys say there.
    private string AddressKeys(ColumnBase<TItem> column, string uri) =>
        $"{new Uri(uri).AbsolutePath}?{ColumnFilter.Read(column, FilterQueryKey(column), QueryString.Of(uri))?.Signature}";

    /// <inheritdoc />
    internal override void AddressChanged(string location)
    {
        // Ticks on their way are in the address now. Ticks waiting for their pause carry on through a
        // sort, a page or another filter, as a static page's do, and go with a move that changes this
        // column's own filter, or leaves the page.
        foreach (var column in _columns.Where(c => c.CanFilter && c.HasValueList))
        {
            var list = ValueListOf(column);
            var keys = AddressKeys(column, location);
            if (keys == list.Sent)
            {
                (list.Before, list.Sent) = (keys, null);
            }

            if (list.Pending is null)
            {
                continue;
            }

            if (!list.Waiting)
            {
                list.Pending = null;
            }
            else if (keys != list.Before)
            {
                list.Apply?.Cancel();
                (list.Pending, list.Sent, list.Waiting) = (null, null, false);
            }
        }
    }

    /// <summary>Whether a row of filters sits under the titles: a DataGrid's <c>FilterRow</c>.</summary>
    internal virtual bool ShowsFilterRow => false;

    // How many rows the head has, which numbers the rest for virtual rows.
    private int HeaderRows => BandDepth + (ShowsFilterRow && HasFilters ? 2 : 1);

    private string FilterRowFormId => $"{FilterFormId}-row";

    private string FilterPanelId(ColumnBase<TItem> column) => $"{FilterFormId}-{column.Key}-panel";

    // Whether a filter fits in its cell as a field: not a list, a range or a date, which open the column's panel.
    private static bool FitsInCell(ColumnBase<TItem> column, ColumnFilterValue current) =>
        column.FilterKind is not (ColumnFilterKind.Choice or ColumnFilterKind.Date) && !column.HasValueList && column.FilterTemplate is null && !current.None
        && current.Op is not (FilterOperator.Between or FilterOperator.In or FilterOperator.NotIn) && !ColumnFilter.TakesNoValue(current.Op);

    // A few choices by name, in a row's list; null past that, where the count says more than a clipped
    // line of names. Null too for a loader's values until its rows are here: they may be ids.
    private string? RowListSummary(ColumnBase<TItem> column, ColumnFilterValue current)
    {
        if (current.Op != FilterOperator.In || current.Values.Count is < 2 or > 3 || column.FilterText is not null)
        {
            return null;
        }

        if (column.FilterKind == ColumnFilterKind.Choice)
        {
            return string.Join(", ", current.Values.Select(v => ColumnFilter.ListOf(column, TextDefaults).FirstOrDefault(r => string.Equals(r.Value, v, StringComparison.OrdinalIgnoreCase)).Text ?? v));
        }

        var known = column.FilterValues is null || current.Values.All(v => v is null || ValueListOf(column).Rows.Any(r => ValueComparer.Equals(r.Value, v)));
        return known ? string.Join(", ", current.Values.Select(v => ValueText(column, v))) : null;
    }

    // A column's filter in the row, every cell one shape: a slot, then the funnel that opens the column's panel (the
    // header's, moved here). The slot is the value's field while one value with any operator says it all, else what the
    // filter's set to, which opens the panel too; the operator itself is chosen in the panel. A × in the slot clears it.
    private RenderFragment FilterCell(ColumnBase<TItem> column, ColumnFilterValue current) => __builder =>
    {
        var label = FilterLabel(column);
        var panel = FilterPanelId(column);
        var fits = FitsInCell(column, current);
        var list = column.FilterKind == ColumnFilterKind.Choice || column.HasValueList || column.FilterTemplate is not null;
        <div class="ib-filter-cell ib-field ib-field-sm" data-ib-panel="@panel" style="anchor-name:@StyleValues.AnchorName(panel + "-cell")">
            <div class="ib-filter-cell-slot">
                @if (fits)
                {
                    var number = column.FilterKind == ColumnFilterKind.Number;
                    <div class="ib-field-control">
                        @if (UseState)
                        {
                            <input type="text" class="ib-field-input" aria-label="@label" value="@current.Value" inputmode="@(number ? "decimal" : null)" autocomplete="off" data-ib-enter @attributes="InputEvents(column, false, false)" />
                        }
                        else
                        {
                            <input type="text" class="ib-field-input" aria-label="@label" value="@current.Value" inputmode="@(number ? "decimal" : null)" autocomplete="off" data-ib-enter
                                   name="@FilterQueryKey(column)" form="@FilterRowFormId" data-ib-filter data-ib-row />
                        }
                    </div>
                }
                else
                {
                    // Blank with no filter, as an empty field is, and named so: an empty list as All, an empty date
                    // by its column alone (its operator would sound like a filter that's set).
                    var summary = current.IsFilter ? FilterSummary(column, current, days: true) : list ? TextDefaults.FilterAll : "";
                    var shown = !current.IsFilter ? "" : list ? RowListSummary(column, current) ?? summary : summary;
                    var said = shown.Length > 0 ? shown : summary;
                    <button type="button" class="ib-filter-cell-summary" popovertarget="@panel" aria-label="@(said.Length > 0 ? $"{label}: {said}" : label)" title="@(shown.Length > 0 ? shown : null)" data-ib-enter><span>@shown</span></button>
                }
                @if (current.IsFilter)
                {
                    var clearName = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.FilterClearColumn, column.FullName);
                    if (UseState)
                    {
                        <button type="button" class="ib-filter-cell-clear" aria-label="@clearName" title="@clearName" @onclick="() => SetFilterAsync(column, ColumnFilter.Empty(column), wait: false)"><Icon Purpose="IconPurpose.Close" /></button>
                    }
                    else
                    {
                        <a class="ib-filter-cell-clear" href="@FilterHref(column, null)" data-ib-filter-clear aria-label="@clearName" title="@clearName"><Icon Purpose="IconPurpose.Close" /></a>
                    }
                }
            </div>
            @* Named apart from the slot: with what's set, else the operator a value would take, which the row doesn't show. *@
            @{ var name = current.IsFilter ? $"{label}: {FilterSummary(column, current, days: true)}" : list ? label : $"{label}: {ColumnFilter.TextOf(column.FilterKind, current.Op, TextDefaults)}"; }
            <button type="button" class="ib-table-filter-button" popovertarget="@panel" data-active="@(current.IsFilter ? "" : null)" aria-label="@name" title="@name"><Icon Purpose="IconPurpose.Filter" /></button>
        </div>
    };

    // The row's GET form, for no script. It holds every filter, as the panels' form does, so either posts
    // the whole state: the row's fields join it themselves, and this says the rest.
    private RenderFragment FilterRowForm => __builder =>
    {
        <form id="@FilterRowFormId" method="get" action="@ActionPath" class="ib-table-filter-form"><button type="submit" tabindex="-1">@TextDefaults.Apply</button></form>
        <div class="ib-table-filter-kept">
            @foreach (var (key, value) in KeptQuery())
            {
                <input type="hidden" name="@key" value="@value" form="@FilterRowFormId" />
            }
            @foreach (var key in ExtraFilterKeys)
            {
                <input type="hidden" name="@key" value="@QueryString.Of(Navigation.Uri).GetValueOrDefault(key).ToString()" form="@FilterRowFormId" />
            }
            @{ var filters = CurrentFilters(); }
            @foreach (var column in _columns.Where(c => c.CanFilter))
            {
                var current = filters.GetValueOrDefault(column.Key!) ?? ColumnFilter.Empty(column);
                var key = FilterQueryKey(column);
                var fits = FitsInCell(column, current) && Shown.Contains(column);
                @* An operator chosen with no value yet, which Write leaves out: the field's value goes with it. *@
                if (!current.IsFilter && current.Op != ColumnFilter.DefaultOperator(column) && ColumnFilter.IsListState(current) == false)
                {
                    <input type="hidden" name="@($"{key}-op")" value="@ColumnFilter.WordOf(current.Op)" form="@FilterRowFormId" />
                }
                foreach (var (name, written) in ColumnFilter.Write(column, key, current))
                {
                    @* A field in the row says its own value. *@
                    if (fits && name == key)
                    {
                        continue;
                    }

                    foreach (var value in written as string[] ?? (written is string one ? [one] : []))
                    {
                        <input type="hidden" name="@name" value="@value" form="@FilterRowFormId" />
                    }
                }
            }
        </div>
    };

    // The word for a range's lower end, "Min" or "From".
    private string LowerWord(ColumnBase<TItem> column) => column.FilterKind == ColumnFilterKind.Date ? TextDefaults.FilterFrom : TextDefaults.FilterMin;

    // What names a filter's first value. With only one value in sight there's nothing to tell it from,
    // so its name is for screen readers; once Between shows a second, it's the range's lower end.
    private RenderFragment ValueLabel(ColumnBase<TItem> column, IReadOnlyList<FilterOperator> ops, string id) => __builder =>
    {
        if (ops.Count == 1)
        {
            <label class="ib-field-label" for="@id">@LowerWord(column)</label>
        }
        else if (ops.Contains(FilterOperator.Between))
        {
            <label class="ib-field-label ib-table-filter-value-label" for="@id"><span class="ib-table-filter-if-range">@LowerWord(column)</span><span class="ib-table-filter-if-one">@TextDefaults.FilterValueLabel</span></label>
        }
        else
        {
            <label class="ib-visually-hidden" for="@id">@TextDefaults.FilterValueLabel</label>
        }
    };

    private RenderFragment UpperLabel(ColumnBase<TItem> column, string id) => __builder =>
    {
        <label class="ib-field-label" for="@id">@(column.FilterKind == ColumnFilterKind.Date ? TextDefaults.FilterTo : TextDefaults.FilterMax)</label>
    };

    // The operator's native select: joined to the GET form on static pages, so it posts with no
    // script, and handled here on bound pages.
    private RenderFragment OperatorSelect(ColumnBase<TItem> column, ColumnFilterValue current, IReadOnlyList<FilterOperator> ops, string id) => __builder =>
    {
        var chosen = ColumnFilter.WordOf(current.Op);
        <div class="ib-field ib-field-sm ib-table-filter">
            <div class="ib-field-control ib-has-end">
                @if (UseState)
                {
                    <select class="ib-field-input ib-field-select" id="@id" aria-label="@TextDefaults.FilterOperatorLabel" value="@chosen" autofocus="@ColumnFilter.TakesNoValue(current.Op)"
                            @onchange="e => OnOperatorAsync(column, e)">
                        @OperatorOptions(column, ops)
                    </select>
                }
                else
                {
                    <select class="ib-field-input ib-field-select" id="@id" aria-label="@TextDefaults.FilterOperatorLabel" value="@chosen" autofocus="@ColumnFilter.TakesNoValue(current.Op)"
                            name="@($"{FilterQueryKey(column)}-op")" form="@FilterFormId" data-ib-filter data-ib-default="@ColumnFilter.WordOf(ops[0])">
                        @OperatorOptions(column, ops)
                    </select>
                }
                <Icon Purpose="IconPurpose.ChevronDown" Class="ib-field-icon ib-field-icon-end" />
            </div>
        </div>
    };

    private RenderFragment OperatorOptions(ColumnBase<TItem> column, IReadOnlyList<FilterOperator> ops) => __builder =>
    {
        foreach (var op in ops)
        {
            <option value="@ColumnFilter.WordOf(op)">@ColumnFilter.TextOf(column.FilterKind, op, TextDefaults)</option>
        }
    };

    // A header filter's field, shown under its label: a date input, a box for a number with a numeric
    // keyboard, or a text box. Static pages post it under its own key (?f-total=, ?f-total-to=), joined
    // to the GET form; bound pages handle its events. (Choices have a list instead.)
    private RenderFragment FilterInput(ColumnBase<TItem> column, string current, string id, RenderFragment? label, bool second, bool autofocus) => __builder =>
    {
        var (date, number) = (column.FilterKind == ColumnFilterKind.Date, column.FilterKind == ColumnFilterKind.Number);
        @* A date input sends yyyy-MM-dd whatever the person's locale shows; it applies when a whole
           date is chosen, so there's no pause to wait for. *@
        var value = !date ? current : ColumnFilter.TryParseDay(current, out var day) ? day.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "";
        var type = date ? "date" : number ? "text" : "search";
        <div class="@(date ? "ib-field ib-field-sm ib-table-filter ib-table-filter-date" : "ib-field ib-field-sm ib-table-filter")">
            @label
            <div class="ib-field-control">
                @if (UseState)
                {
                    <input type="@type" class="ib-field-input" id="@id" autofocus="@autofocus" value="@value" inputmode="@(number ? "decimal" : null)" autocomplete="@(date ? null : "off")"
                           @attributes="InputEvents(column, second, date)" />
                }
                else
                {
                    <input type="@type" class="ib-field-input" id="@id" autofocus="@autofocus" value="@value" inputmode="@(number ? "decimal" : null)" autocomplete="@(date ? null : "off")"
                           name="@(second ? $"{FilterQueryKey(column)}-to" : FilterQueryKey(column))" form="@FilterFormId" data-ib-filter data-ib-to="@(second ? "" : null)" />
                }
            </div>
        </div>
    };

    // A bound field's events: typing waits for a pause, a date applies when it's chosen.
    private Dictionary<string, object> InputEvents(ColumnBase<TItem> column, bool second, bool date) => new()
    {
        [date ? "onchange" : "oninput"] = EventCallback.Factory.Create<ChangeEventArgs>(this, e => OnFilterTextAsync(column, e, second, wait: !date)),
    };

    // The URL with a column's filter set to this, from page 1. Null clears every key it uses.
    // These columns filtered to these values, with other address changes: how a too-long group becomes the ordinary grid.
    private protected Dictionary<string, object?> FilterChanges(IEnumerable<(ColumnBase<TItem> Column, string Value)> filters)
    {
        var changes = new Dictionary<string, object?> { [PageKey] = null, [CursorKey] = null };
        foreach (var (column, value) in filters)
        {
            foreach (var change in ColumnFilter.Write(column, FilterQueryKey(column), EqualsFilter(column, value)))
            {
                changes[change.Key] = change.Value;
            }
        }

        return changes;
    }

    private string FilterHref(ColumnBase<TItem> column, ColumnFilterValue? value)
    {
        var changes = ColumnFilter.Write(column, FilterQueryKey(column), value);
        changes[PageKey] = null;
        changes[CursorKey] = null;
        return LinkWith(changes);
    }

    private protected Task SetEqualsFilterAsync(ColumnBase<TItem> column, string value) =>
        SetFilterAsync(column, EqualsFilter(column, value), wait: false);

    // A column of choices lists what's ticked; the rest compare.
    private static ColumnFilterValue EqualsFilter(ColumnBase<TItem> column, string value) =>
        new(column.FilterKind == ColumnFilterKind.Choice ? FilterOperator.In : FilterOperator.Equals, [value]);

    private async Task ClearFiltersAsync()
    {
        _filterDelay?.Cancel();
        (_stateFilters, _stateExtra) = (new Dictionary<string, ColumnFilterValue>(), []);
        await ReportFilterAsync();
    }

    private ColumnFilterValue StateOf(ColumnBase<TItem> column) => StateFilters().GetValueOrDefault(column.Key!) ?? ColumnFilter.Empty(column);

    // One of a bound filter's fields changed.
    private Task OnFilterTextAsync(ColumnBase<TItem> column, ChangeEventArgs e, bool second, bool wait)
    {
        var typed = e.Value?.ToString() ?? "";
        var state = StateOf(column);
        return SetFilterAsync(column, second
            ? state with { To = typed }
            : state with { Values = string.IsNullOrWhiteSpace(typed) ? [] : [typed] }, wait);
    }

    // A bound filter's operator changed: it applies at once if there's a value, and with none it's
    // only how the panel draws, so nothing is told or loaded.
    private async Task OnOperatorAsync(ColumnBase<TItem> column, ChangeEventArgs e)
    {
        var state = StateOf(column);
        var op = ColumnFilter.OperatorOf(e.Value?.ToString()) ?? ColumnFilter.DefaultOperator(column);

        // What it doesn't take goes, as a static page's next response would have it.
        var next = state with
        {
            Op = op,
            Values = ColumnFilter.TakesNoValue(op) ? [] : state.Values,
            To = op == FilterOperator.Between ? state.To : null,
        };
        if (state.IsFilter || next.IsFilter)
        {
            await SetFilterAsync(column, next, wait: false);
        }
        else
        {
            _stateFilters = WithState(column, next);
        }
    }

    // The bound filters with this column's.
    private Dictionary<string, ColumnFilterValue> WithState(ColumnBase<TItem> column, ColumnFilterValue value)
    {
        var next = new Dictionary<string, ColumnFilterValue>(StateFilters(), StringComparer.OrdinalIgnoreCase);
        if (value.IsFilter || value.Op != ColumnFilter.DefaultOperator(column))
        {
            next[column.Key!] = value;
        }
        else
        {
            next.Remove(column.Key!);
        }

        return next;
    }

    // Typing and ticking wait for a pause before filtering; a date applies at once.
    private async Task SetFilterAsync(ColumnBase<TItem> column, ColumnFilterValue value, bool wait)
    {
        _stateFilters = WithState(column, value);
        _filterDelay?.Cancel();
        if (wait)
        {
            var delay = _filterDelay = new CancellationTokenSource();
            try
            {
                await Task.Delay(FilterDelay, delay.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }
        }

        await ReportFilterAsync();
    }

    /// <summary>How long typing in a filter waits for a pause. Internal so tests can shorten it.</summary>
    internal TimeSpan FilterDelay { get; set; } = TimeSpan.FromMilliseconds(300);

    private int SkeletonRows => Math.Clamp(EffectivePageSize ?? 5, 1, 10);

    /// <inheritdoc />
    internal override string LabelOf(TItem item) => RowLabel?.Invoke(item) ?? KeyOf(item);

    // On the row's link when it has one (screen readers announce it there), else on the row.
    private string? CurrentOf(TItem item) => RowCurrent?.Invoke(item) == true ? "true" : null;

    // A header's title (or sort control), with a filter button that opens the filter and its menu when it has them.
    private RenderFragment HeaderContent(ColumnBase<TItem> column, IReadOnlyDictionary<string, ColumnFilterValue>? headerFilters) => __builder =>
    {
        @if ((headerFilters is not null && column.CanFilter) || HasHeaderMenu(column))
        {
            <div class="ib-table-head">
                @HeaderTitle(column)
                @if (headerFilters is not null && column.CanFilter)
                {
                    @HeaderFilter(column, headerFilters.GetValueOrDefault(column.Key!) ?? ColumnFilter.Empty(column))
                }
                @HeaderMenu(column)
            </div>
        }
        else
        {
            @HeaderTitle(column)
        }
    };

    private string? RowClasses(TItem item, string? href)
    {
        var classes = string.Join(' ', new[] { RowClass?.Invoke(item), href is null ? null : "ib-table-row-linked", OwnRowClass, ItemRowClass(item) }.Where(c => !string.IsNullOrEmpty(c)));
        return classes.Length > 0 ? classes : null;
    }

    // Rendered after the columns: its initialization runs once they have registered.
    private RenderFragment ColumnsReadyNotifier => builder =>
    {
        builder.OpenComponent<TableColumnsReady>(0);
        builder.AddComponentParameter(1, nameof(TableColumnsReady.Ready), (Func<Task>)ColumnsReadyAsync);
        builder.CloseComponent();
    };

    private string? ScrollStyle => (MaxHeight, GridId) switch
    {
        (null, null) => null,
        ({ } height, null) => $"max-height:{StyleValues.Length(height)}",
        (null, _) => "container-type:inline-size",
        ({ } height, _) => $"max-height:{StyleValues.Length(height)};container-type:inline-size",
    };

    internal void AddColumn(ColumnBase<TItem> column)
    {
        if (!_columns.Contains(column))
        {
            PlaceColumn(column);
            _columns.Add(column);
            OrderColumns();
            ColumnsChanged();

            // A column shown later (behind an @if) appears without waiting for another render.
            if (_columnsReady)
            {
                StateHasChanged();
            }
        }
    }

    internal void ColumnChanged()
    {
        ColumnsChanged();
        if (_columnsReady)
        {
            StateHasChanged();
        }
    }

    // A column now reads something else (a DynamicColumn's Field or Type): the rows, their order
    // and the aggregates came from what it read before. Also when the table loaded in the same
    // render, before the column had its new parameters.
    internal void ColumnDataChanged()
    {
        ColumnsChanged();
        if (!_columnsReady)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            try
            {
                await LoadAsync();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                await DispatchExceptionAsync(ex);
            }
        });
    }

    internal void RemoveColumn(ColumnBase<TItem> column)
    {
        UnplaceColumn(column);
        if (_columns.Remove(column))
        {
            ColumnsChanged();
            // Its rows stay as they are until the next load, but its place in the sort goes now.
            _sorts = _sorts.Where(s => !string.Equals(s.Key, column.Key, StringComparison.OrdinalIgnoreCase)).ToList();
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        (_class, _style) = BuildRootAttributes();

        if (Paging == DataPaging.LoadMore)
        {
            throw new InvalidOperationException(
                $"A {ViewName} pages by number (DataPaging.Pages), by cursor (DataPaging.NextPrevious), or loads the next page as you scroll (DataPaging.LoadOnScroll, with a MaxHeight). " +
                "A Load more button is for lists: use ListView.");
        }

        SyncSelection();

        // The script asking still gets only the list, and a parent's data arriving late means asking again.
        if (ReadyToLoad && ValuesAsked() is { } column)
        {
            await LoadAskedValuesAsync(column);
            return;
        }

        await SyncAndLoadAsync();
    }

    private void TakeFilter(IzzyBlazor.Filter? filter)
    {
        (_unsplitFilter, _hasUnsplitFilter) = (filter, true);
        (_stateFilters, _stateExtra) = (new Dictionary<string, ColumnFilterValue>(), []);
    }

    private async Task OnSortClickAsync(ColumnBase<TItem> column, bool add)
    {
        var next = add ? AddSort(column) : NextSort(column);
        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_stateSort, _statePage, _stateCursor) = (next, 1, null);
        await SortChanged.InvokeAsync(next);
        await ReportFirstPageAsync(pageWas, cursorWas);

        await ReloadIfStaleAsync();
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-table");
        classes.Add("ib-table-striped", Striped);
        classes.Add("ib-table-row-hover", RowHover);
        classes.Add("ib-table-no-row-lines", !RowLines);
        classes.Add("ib-table-column-lines", ColumnLines);
        classes.Add("ib-table-shaded-head", ShadedHeader);
        classes.Add("ib-table-borderless", !Bordered);
        classes.Add("ib-table-sm", Size == ControlSize.Sm);
        classes.Add("ib-table-lg", Size == ControlSize.Lg);
        classes.Add("ib-table-sticky", MaxHeight is not null);
        base.BuildAttributes(classes, styles);
    }

    private async Task ColumnsReadyAsync()
    {
        await BandsJoined();
        _columnsReady = true;

        // Filters kept in the component start from the URL too, once the columns that name them
        // have registered.
        if (UseState && Filter is null && StateFilters().Count == 0 && _stateExtra.Count == 0)
        {
            _stateFilters = ReadFilters();
            _stateExtra = AddressFilter().Filter is { } address ? [address] : [];
        }

        if (ValuesAsked() is { } column)
        {
            await LoadAskedValuesAsync(column);
            StateHasChanged();
            return;
        }

        // A stream-rendered page's first flush has the headers, or a navigation's merge takes them out
        // and an open panel with them, and comes back with the rows.
        if (!RendererInfo.IsInteractive && ItemsProvider is not null)
        {
            StateHasChanged();
        }

        await LoadAsync();
        StateHasChanged();
    }

    // Ascending, descending, then no sort. "-" says none, or InitialSort would come straight back.
    private string? NextSort(ColumnBase<TItem> column)
    {
        if (SortIndex(column) != 0)
        {
            return column.Key;
        }

        return !_sorts[0].Descending ? $"-{column.Key}" : string.IsNullOrEmpty(InitialSort) ? null : "-";
    }

    // Shift: this column joins the sort, or goes on to descending, then out of it. From the sort last
    // asked for: one still loading, or that failed, isn't what the headers show yet. With nothing
    // left, "-" says no sort, or InitialSort would come straight back.
    private string? AddSort(ColumnBase<TItem> column)
    {
        var sorts = _shapedSort.ToList();
        var index = sorts.FindIndex(s => string.Equals(column.Key, s.Key, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
        {
            sorts.Add(new SortField(column.Key!, false));
        }
        else if (sorts[index].Descending)
        {
            sorts.RemoveAt(index);
        }
        else
        {
            sorts[index] = new SortField(column.Key!, true);
        }

        return sorts.Count == 0 ? (string.IsNullOrEmpty(InitialSort) ? null : "-") : string.Join(',', sorts.Select(s => s.Descending ? $"-{s.Key}" : s.Key));
    }

    /// <summary>
    /// The sort with this column alone, ascending or descending, or with it taken out (null): a
    /// column menu's Sort ascending, Sort descending and Clear sort. With <paramref name="add"/>, the
    /// sort keeps its other columns and this one joins at the end, or turns where it stands.
    /// </summary>
    internal string? SortTo(ColumnBase<TItem> column, bool? descending, bool add = false)
    {
        if (add && descending is { } turn)
        {
            var sorts = _shapedSort.ToList();
            var index = sorts.FindIndex(s => string.Equals(column.Key, s.Key, StringComparison.OrdinalIgnoreCase));
            var field = new SortField(column.Key!, turn);
            if (index < 0)
            {
                sorts.Add(field);
            }
            else
            {
                sorts[index] = field;
            }

            return string.Join(',', sorts.Select(s => s.Descending ? $"-{s.Key}" : s.Key));
        }

        if (descending is { } down)
        {
            return down ? $"-{column.Key}" : column.Key;
        }

        var rest = _shapedSort.Where(s => !string.Equals(s.Key, column.Key, StringComparison.OrdinalIgnoreCase)).ToList();
        return rest.Count > 0 ? string.Join(',', rest.Select(s => s.Descending ? $"-{s.Key}" : s.Key)) : string.IsNullOrEmpty(InitialSort) ? null : "-";
    }

    internal string SortToHref(ColumnBase<TItem> column, bool? descending, bool add = false) =>
        LinkWith(new Dictionary<string, object?>
        {
            [SortQueryKey] = SortTo(column, descending, add),
            [PageKey] = null,
            [CursorKey] = null,
        });

    internal async Task SortToAsync(ColumnBase<TItem> column, bool? descending, bool add = false)
    {
        var next = SortTo(column, descending, add);
        var (pageWas, cursorWas) = (_statePage, _stateCursor);
        (_stateSort, _statePage, _stateCursor) = (next, 1, null);
        await SortChanged.InvokeAsync(next);
        await ReportFirstPageAsync(pageWas, cursorWas);
        await ReloadIfStaleAsync();
    }

    /// <summary>Whether another column is in the sort, so this one can be added to it.</summary>
    internal bool SortsByOthers(ColumnBase<TItem> column) =>
        _sorts.Any(s => !string.Equals(s.Key, column.Key, StringComparison.OrdinalIgnoreCase));

    /// <summary>Whether this column is in the sort, and which way: null when it isn't.</summary>
    internal bool? SortedDescending(ColumnBase<TItem> column) =>
        SortIndex(column) is var index && index < 0 ? null : _sorts[index].Descending;

    private string AddSortHref(ColumnBase<TItem> column) =>
        LinkWith(new Dictionary<string, object?>
        {
            [SortQueryKey] = AddSort(column),
            [PageKey] = null,
            [CursorKey] = null,
        });

    private string SortHref(ColumnBase<TItem> column) =>
        LinkWith(new Dictionary<string, object?>
        {
            [SortQueryKey] = NextSort(column),
            [PageKey] = null,
            [CursorKey] = null,
        });

    private int SortIndex(ColumnBase<TItem> column)
    {
        for (var i = 0; i < _sorts.Count; i++)
        {
            if (string.Equals(column.Key, _sorts[i].Key, StringComparison.OrdinalIgnoreCase))
            {
                return i;
            }
        }

        return -1;
    }

    private string? AriaSort(ColumnBase<TItem> column) => !column.CanSort ? null : SortIndex(column) != 0 ? "none" : _sorts[0].Descending ? "descending" : "ascending";

    private IconPurpose SortIcon(ColumnBase<TItem> column) =>
        SortIndex(column) is var index && index < 0 ? IconPurpose.Sortable : _sorts[index].Descending ? IconPurpose.SortDescending : IconPurpose.SortAscending;

    /// <summary>A class for a column's cells beyond their alignment and its own.</summary>
    internal virtual string? ColumnClass(ColumnBase<TItem> column) => null;

    /// <summary>A style for a column's data and footer cells.</summary>
    internal virtual string? CellStyle(ColumnBase<TItem> column) => null;

    /// <summary>The class of the selection column's cells.</summary>
    internal virtual string SelectCellClass => "ib-table-select-cell";

    internal string? CellClass(ColumnBase<TItem> column)
    {
        var align = column.EffectiveAlign switch
        {
            CellAlign.Center => "ib-cell-center",
            CellAlign.End => "ib-cell-end",
            _ => null,
        };

        var classes = string.Join(' ', new[] { align, column.Class, ColumnClass(column) }.Where(c => !string.IsNullOrEmpty(c)));
        return classes.Length > 0 ? classes : null;
    }

    /// <summary>Whether Shift+click on a header adds it to the sort.</summary>
    internal virtual bool MultiSort => false;

    /// <summary>Whether the columns take options only a grid has, such as a minimum width.</summary>
    internal virtual bool GridColumns => false;

    /// <summary>Column definitions, before the header.</summary>
    internal virtual RenderFragment? ColGroup => null;

    /// <summary>A style for the table element.</summary>
    internal virtual string? GridStyle => null;

    /// <summary>The table element's id, for a style element of the view's own; its scroll box is then a container.</summary>
    internal virtual string? GridId => null;

    /// <summary>A style element of the view's own, before its scroll box.</summary>
    internal virtual RenderFragment? GridStyleSheet => null;

    /// <summary>
    /// A table part's role written out, for a table whose parts its style can make blocks, which can
    /// lose a table's meaning in some browsers. Null: the element's own.
    /// </summary>
    internal virtual string? StackRole(string role) => null;

    /// <summary>A style for a column's header cell.</summary>
    internal virtual string? HeaderStyle(ColumnBase<TItem> column) => WidthStyle(column);

    /// <summary>A last column of the view's own: its header cell.</summary>
    internal virtual RenderFragment? LastHeaderCell => null;

    /// <summary>Whether this row is being edited where it stands.</summary>
    internal virtual bool IsEditingRow(TItem item) => false;

    /// <summary>The field for this one cell, if it's the one being edited on its own.</summary>
    internal virtual RenderFragment? CellEditor(TItem item, ColumnBase<TItem> column) => null;

    /// <summary>The column's name on a cell that starts editing by itself, for the script.</summary>
    internal virtual string? EditColumnKey(TItem item, ColumnBase<TItem> column) => null;

    /// <summary>The new row being edited, which isn't among those loaded.</summary>
    internal virtual TItem? NewRowItem => default;

    /// <summary>The field for a column of the row being edited, or null for one that only shows its value.</summary>
    internal virtual RenderFragment? EditCell(ColumnBase<TItem> column) => null;

    /// <summary>A last column of the view's own: its cell in a row.</summary>
    internal virtual RenderFragment? LastCell(TItem item) => null;

    /// <summary>A last column of the view's own: its cell in a skeleton or footer row.</summary>
    internal virtual RenderFragment? LastEmptyCell => null;

    /// <summary>Above the grid and its selection bar.</summary>
    internal virtual RenderFragment? AboveGrid => null;

    /// <summary>Attributes for a column's header cell.</summary>
    internal virtual IReadOnlyDictionary<string, object>? HeaderAttributes(ColumnBase<TItem> column) => null;

    /// <summary>Whether a column's header has a menu of its own.</summary>
    internal virtual bool HasHeaderMenu(ColumnBase<TItem> column) => false;

    /// <summary>A column's own menu, in its header.</summary>
    internal virtual RenderFragment? HeaderMenu(ColumnBase<TItem> column) => null;

    /// <summary>A column's resize handle, in its header.</summary>
    internal virtual RenderFragment? HeaderHandle(ColumnBase<TItem> column) => null;

    /// <summary>The columns as registered, shown or not.</summary>
    internal IReadOnlyList<ColumnBase<TItem>> AllColumns => _columns;

    /// <summary>The columns drawn, in order.</summary>
    internal virtual IReadOnlyList<ColumnBase<TItem>> Shown => _columns;

    /// <summary>The columns changed: one came, went or has new settings.</summary>
    internal virtual void ColumnsChanged()
    {
    }

    private static string? WidthStyle(ColumnBase<TItem> column) =>
        column.Width is { } width ? $"width:{StyleValues.Length(width)}" : null;

    private string PagesLabel =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TablePages, Caption ?? TextDefaults.TableName);

    /// <inheritdoc />
    internal override void SyncFilter(bool first)
    {
        if (first)
        {
            TakeFilter(Filter);
            _lastFilterParam = Filter;
            return;
        }

        // A new filter from the parent, but not the echo of one this table just reported.
        if (!ReferenceEquals(Filter, _lastFilterParam))
        {
            _lastFilterParam = Filter;
            var echo = _awaitingEcho && ReferenceEquals(Filter, _reportedFilter);
            _awaitingEcho = false;
            if (!echo)
            {
                TakeFilter(Filter);
            }
        }
    }

    /// <inheritdoc />
    internal override DataRequest<TItem> Shape(DataRequest<TItem> request, string? sortRaw)
    {
        CheckSortKeys();
        var raw =!string.IsNullOrEmpty(sortRaw) ? sortRaw : InitialSort;
        string[] tokens = raw is null ? [] : MultiSort ? raw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) : [raw];
        var sort = new List<SortField>();
        foreach (var token in tokens)
        {
            var key = token.TrimStart('-');
            var column = _columns.FirstOrDefault(c => c.CanSort && string.Equals(c.Key, key, StringComparison.OrdinalIgnoreCase));
            if (column is not null && !sort.Any(s => string.Equals(s.Key, column.Key, StringComparison.OrdinalIgnoreCase)))
            {
                sort.Add(new SortField(column.Key!, token.StartsWith('-')));
            }
        }

        _shapedSort = sort;
        return request with
        {
            Sort = sort,
            Filter = CurrentFilter(),
            Fields = _columns.Select(c => c.ToField(TextDefaults)).Concat(_columns.Select(c => c.GroupByField)).OfType<DataField<TItem>>().ToList(),
        };
    }

    /// <inheritdoc />
    internal override string? AccessibleName => Caption;

    /// <inheritdoc />
    internal override void Loaded()
    {
        _sorts = _shapedSort;
    }

    /// <inheritdoc />
    internal override void Requested()
    {
        var shape = (_loadedKey?.Sort, _loadedKey?.Filters, _loadedKey?.PageSize);
        if (!shape.Equals(_virtualShape))
        {
            _virtualShape = shape;
            _virtualLoad++;
            _firstWindowLoaded = true;
        }
        else if (_virtualize is not null)
        {
            _ = _virtualize.RefreshDataAsync();
        }
    }

    /// <inheritdoc />
    internal override ValueTask FocusAfterRetryAsync() => _scrollRef.FocusAsync();

    /// <inheritdoc />
    public override void Dispose()
    {
        base.Dispose();
        _filterDelay?.Cancel();
        foreach (var list in _valueLists.Values)
        {
            list.Load?.Cancel();
            list.SearchPause?.Cancel();
            list.Apply?.Cancel();
        }
    }
}
