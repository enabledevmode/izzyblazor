@namespace IzzyBlazor
@typeparam TItem
@inherits IzzyComponentBase
@implements IDisposable
@implements IKanbanLanes
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager Navigation
@attribute [CascadingTypeParameter(nameof(TItem))]
@attribute [ModeSupport]

@*
    A board of cards in columns, such as tasks by status or deals by stage. Each KanbanColumn
    shows the cards whose ColumnOf is its Value, under a header with the column's title and how
    many cards it holds.

    <Kanban Items="tasks" ItemKey="t => t.Id" ColumnOf="t => t.Status" ItemText="t => t.Title"
            OnMove="Moved">
        <Columns>
            <KanbanColumn Value="To do" />
            <KanbanColumn Value="In progress" Limit="3" />
            <KanbanColumn Value="Done" />
        </Columns>
    </Kanban>

    A card drags to another place or column from anywhere on it, and its ⋯ menu has the same
    moves, with every column under "Move to". OnMove runs with each move, on a static page too,
    where the board posts a form of its own: save the card's new column there. Don't put the
    board inside another form.

    CardTemplate draws a card; without it ItemText and ItemDescription do. ItemHref makes a card a
    link and ItemMenu adds items to its ⋯ menu. The columns share the board's width, none
    narrower than ColumnWidth, and the board scrolls sideways when they don't fit. On a narrow
    board one column shows at a time with the next one's edge beside it.

    Accessibility:
    - The board is a group named by its Label. Each column is a region named by its title, which
      is a heading (TitleLevel, 3 by default), holding a list of its cards.
    - A column's count is read as "Cards: 3", or "Cards: 3 of 5" with a Limit.
    - Every card's ⋯ button is named "Actions for" and the card's label, and its menu moves the
      card, so nothing needs dragging.
    - A move is announced from the column it lands in: "Moved Budget to Done, position 1 of 3".
    - With Searchable, how many cards match is announced as the search changes: "Cards shown: 4".
    - The button that collapses a column is named by the column, as in "Review cards", and says
      whether the cards are shown.

    Keyboard:
    - Tab | Go through a card's controls in order
    - Up, Down | Move to the card above or below
    - Alt+Up, Alt+Down, Alt+Home, Alt+End | On a card's link or button, move the card
    - Shift+F10, Menu | Open the card's menu
    - Escape | While dragging, cancel
    See also: DropZoneGroup, ListView.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/kanban.css"]" />
<ib-kanban @attributes="AdditionalAttributes" class="@_class" style="@_style" role="group" aria-label="@(Label ?? TextDefaults.KanbanName)"
           data-ib-interactive="@(WillBeInteractive ? "" : null)" data-ib-count="@TextDefaults.KanbanCount" data-ib-count-limit="@TextDefaults.KanbanCountOfLimit"
           @oniborder="Ordered">
    @if (Searchable)
    {
        @SearchBar
    }
    <CascadingValue Value="_view">
    <CascadingValue Value="this" IsFixed="true">
        @if (Live)
        {
            <DropZoneGroup TItem="TItem" Class="@BoardClass" Items="Items" ItemKey="ItemKey" ZoneOf="_zoneOf" ItemsChanged="ItemsChanged" OnMove="MovedAsync" @ref="_liveGroup">
                @Inner
            </DropZoneGroup>
        }
        else
        {
            @* Named for this board, so that a post reaches only its own form. *@
            <FormMappingScope Name="@($"ib-kanban-{QueryPrefix}")">
                @Binding
            </FormMappingScope>
        }
        @if (_canceledSay is not null)
        {
            @* A posted move the page refused: the script said it moved, and the card is back. *@
            <div class="ib-visually-hidden" role="status">@_canceledSay</div>
        }
        @if (CurrentColumnEdit is { Length: > 0 } columnKey)
        {
            if (RendererInfo.IsInteractive)
            {
                @ColumnDialog(columnKey, null)
            }
            else
            {
                <FormMappingScope Name="@($"ib-kanban-column-{QueryPrefix}")">
                    @ColumnFormBinding(columnKey)
                </FormMappingScope>
            }
        }
        @if (CurrentEdit is { Length: > 0 } editKey)
        {
            @* The card's form, outside the board's own: a form can't hold another. *@
            if (EditDialogForm is not null)
            {
                @OwnDialog(editKey)
            }
            else if (RendererInfo.IsInteractive)
            {
                @EditDialog(editKey, null)
            }
            else
            {
                <FormMappingScope Name="@($"ib-kanban-edit-{QueryPrefix}")">
                    @EditBinding(editKey)
                </FormMappingScope>
            }
        }
    </CascadingValue>
    </CascadingValue>
</ib-kanban>

@code {
    /// <summary>Every card, in every column; each column shows its own in this order.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Each card's key: what posts and what keeps its elements when it moves.</summary>
    [Parameter, EditorRequired] public Func<TItem, string>? ItemKey { get; set; }

    /// <summary>
    /// The column a card is in, matching a <see cref="KanbanColumn{TItem}"/>'s <c>Value</c>, such
    /// as <c>t =&gt; t.Status</c>. A card whose column the board doesn't have isn't shown.
    /// </summary>
    [Parameter, EditorRequired] public Func<TItem, string>? ColumnOf { get; set; }

    /// <summary>Runs with every card in its new order after a move; use <c>@bind-Items</c>.</summary>
    [Parameter, ModeSupport] public EventCallback<IReadOnlyList<TItem>> ItemsChanged { get; set; }

    /// <summary>
    /// Runs with each move, before the board changes, on a static page too (the board posts):
    /// set the card's column from <see cref="KanbanMoveEventArgs{TItem}.ToColumn"/> and save it
    /// here, or set <see cref="KanbanMoveEventArgs{TItem}.Cancel"/> to keep the card where it was.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<KanbanMoveEventArgs<TItem>> OnMove { get; set; }

    /// <summary>
    /// Saves a card from the board's form, new or changed, on a static page too (the form posts).
    /// With it, a card opens the form in a dialog (<c>?card=42</c>), its menu has Edit, and each
    /// column's header has an add button. The form has a title, the column and, with
    /// <see cref="ItemDescription"/>, a description: set them on the card from the save.
    /// <c>save.AddError</c> keeps the form open with a message.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<KanbanSave<TItem>> OnSave { get; set; }

    /// <summary>Deletes a card: with it, the generated form has a Delete button. Not with an <see cref="EditDialogForm"/>, whose form deletes.</summary>
    [Parameter, ModeSupport] public EventCallback<KanbanDelete<TItem>> OnDelete { get; set; }

    /// <summary>
    /// Your own form in the card's dialog, in place of the generated one, for the fields your
    /// cards have. The board opens the dialog as before (a card, its menu's Edit, a column's add
    /// button) and closes it; the form, its model and its <c>[SupplyParameterFromForm]</c> are
    /// yours. The context has the card (none for a new one) and its column; call
    /// <c>context.CloseAsync()</c> when it has saved, and put <c>autofocus</c> on its first field.
    /// </summary>
    [Parameter] public RenderFragment<KanbanEditFormContext<TItem>>? EditDialogForm { get; set; }

    /// <summary>
    /// Shows the board without letting anyone change it, such as to someone who may only look:
    /// cards don't move, and there's no form, add button or column menu. Their links stay.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Puts a search box above the board that shows only the cards matching what's typed, in
    /// their text and description or in <see cref="SearchBy"/>. On a static page the search is in
    /// the page's address (<c>?q=…</c>) and applies on Enter.
    /// </summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>The search box's label and placeholder. Defaults to "Search".</summary>
    [Parameter] public string? SearchLabel { get; set; }

    /// <summary>What a card is searched by, such as <c>d =&gt; $"{d.Name} {d.Company}"</c>, in place of its text and description.</summary>
    [Parameter] public Func<TItem, string?>? SearchBy { get; set; }

    /// <summary>
    /// Sorts each column's cards, such as <c>t =&gt; t.Due</c>, in place of the order they're
    /// given in. A card moved to a column takes its sorted place there.
    /// </summary>
    [Parameter] public Func<TItem, IComparable?>? SortBy { get; set; }

    /// <summary>With <see cref="SortBy"/>, sorts from last to first.</summary>
    [Parameter] public bool SortDescending { get; set; }

    /// <summary>
    /// Runs when the user adds a column, on a static page too: with it, an Add column button after
    /// the columns opens a form for its title. Add the column to the list you render
    /// <see cref="Columns"/> from, with a <c>Value</c> of your own.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<KanbanColumnChange> OnColumnAdd { get; set; }

    /// <summary>Runs when the user renames a column: with it, each column's ⋯ menu has Edit, which opens a form for its title.</summary>
    [Parameter, ModeSupport] public EventCallback<KanbanColumnChange> OnColumnRename { get; set; }

    /// <summary>Runs when the user deletes a column: with it, the column's form has a Delete button, which asks first. Its cards are yours to move or delete.</summary>
    [Parameter, ModeSupport] public EventCallback<KanbanColumnDelete> OnColumnDelete { get; set; }

    /// <summary>
    /// Runs when the user moves a column: with it, each column's ⋯ menu has Move left and Move
    /// right. Put the column at <see cref="KanbanColumnMoveEventArgs.ToIndex"/> in the list you
    /// render <see cref="Columns"/> from.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<KanbanColumnMoveEventArgs> OnColumnMove { get; set; }

    /// <summary>
    /// Sets this board's posts and its keys in the page's address apart, so several can share a
    /// page: <c>QueryPrefix="orders-"</c> uses <c>?orders-card=42</c>. None by default (<c>?card=…</c>).
    /// </summary>
    [Parameter] public string QueryPrefix { get; set; } = "";

    /// <summary>The <see cref="KanbanColumn{TItem}"/>s, in the order shown.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>
    /// The lane a card is in, matching a <see cref="KanbanLane"/>'s <c>Value</c>, such as
    /// <c>t =&gt; t.Team</c>. With it, the board has a row for each lane in <see cref="Lanes"/>,
    /// across every column, and a card moves between lanes as it does between columns.
    /// </summary>
    [Parameter] public Func<TItem, string>? LaneOf { get; set; }

    /// <summary>The <see cref="KanbanLane"/>s, in the order shown, on a board with a <see cref="LaneOf"/>.</summary>
    [Parameter] public RenderFragment? Lanes { get; set; }

    /// <summary>A card's content. Without it, <see cref="ItemText"/> and <see cref="ItemDescription"/> draw the card.</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>The default card's text. Defaults to the card's string form.</summary>
    [Parameter] public Func<TItem, string?>? ItemText { get; set; }

    /// <summary>The default card's muted second line.</summary>
    [Parameter] public Func<TItem, string?>? ItemDescription { get; set; }

    /// <summary>
    /// Names a card for screen readers: in its link, its ⋯ button and the announcement of a move.
    /// Defaults to <see cref="ItemText"/>, then the key; set it when <see cref="CardTemplate"/> draws the card.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemLabel { get; set; }

    /// <summary>Makes each card a link to this address; the whole card is clickable.</summary>
    [Parameter] public Func<TItem, string?>? ItemHref { get; set; }

    /// <summary>Makes each card a button that runs this, on interactive pages. Cards with an <see cref="ItemHref"/> are links instead.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<TItem> OnItemClick { get; set; }

    /// <summary>Marks the card the page is showing, such as the one open beside the board.</summary>
    [Parameter] public Func<TItem, bool>? ItemCurrent { get; set; }

    /// <summary>Dims a card and keeps it where it is: it has no link and doesn't move.</summary>
    [Parameter] public Func<TItem, bool>? ItemDisabled { get; set; }

    /// <summary>A colored line down a card's edge, such as its priority's. Color only: put the meaning in the card's text too.</summary>
    [Parameter] public Func<TItem, Accent?>? ItemAccent { get; set; }

    /// <summary><c>MenuItem</c>s for each card's ⋯ menu, above its moves.</summary>
    [Parameter] public RenderFragment<TItem>? ItemMenu { get; set; }

    /// <summary>
    /// Text under each column's header, from the column's cards, such as their total:
    /// <c>cards =&gt; cards.Sum(d =&gt; d.Value).ToString("C0")</c>.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<TItem>, string?>? ColumnSummary { get; set; }

    /// <summary>The narrowest a column gets before the board scrolls sideways. Defaults to 17rem.</summary>
    [Parameter] public Length ColumnWidth { get; set; } = Length.Rem(17);

    /// <summary>
    /// The tallest a column's cards get before they scroll under its header, such as
    /// <c>Length.Vh(60)</c>. Without it, each column is as tall as its cards.
    /// </summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>Gives each column a button that collapses it to a strip with its title and count.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public bool Collapsible { get; set; }

    /// <summary>
    /// Puts an add button in each column's header that goes to this address, from the column's
    /// <c>Value</c>, such as the page that makes a card for that column.
    /// </summary>
    [Parameter] public Func<string, string?>? AddHref { get; set; }

    /// <summary>Puts an add button in each column's header that runs this with the column's <c>Value</c>, on interactive pages.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string> OnAdd { get; set; }

    /// <summary>What an empty column says. Defaults to "Drop items here".</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Gives each card a handle to drag it by, in place of dragging from anywhere on it. The handle opens the menu of moves.</summary>
    [Parameter] public bool DragHandle { get; set; }

    /// <summary>The cards' spacing and text size. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Names the board for screen readers. Defaults to "Board".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The heading level of the columns' titles, 2 to 6. Defaults to 3.</summary>
    [Parameter] public int TitleLevel { get; set; } = 3;

    private Func<TItem, string> _zoneOf = default!;
    private string? _class;
    private string? _style;

    // Interactive (or prerendering for it): C# applies the moves and the collapsing.
    internal bool Live => WillBeInteractive;

    bool IKanbanLanes.Live => Live;

    private DropZoneGroup<TItem>? _liveGroup;

    // An interactive page drew its columns or lanes in another order (a keyed list it reordered
    // or added to): Blazor tells a parent nothing of its children's order, so the script reports
    // the one on the page. Only an order of the columns and lanes the board has is taken.
    private void Ordered(IzzyOrderEventArgs order)
    {
        var columns = (order.Columns ?? []).Select(KanbanZone.Column).Distinct().ToList();
        var known = ValueOrder;
        if (columns.Count == known.Count && !columns.SequenceEqual(known) && columns.All(known.Contains))
        {
            _valueOrder = columns;
        }

        var lanes = (order.Lanes ?? []).ToList();
        if (lanes.Count == _laneList.Count && !lanes.SequenceEqual(_laneList.Select(l => l.Value)) && _laneList.All(l => lanes.Contains(l.Value!)))
        {
            var sorted = _laneList.OrderBy(l => lanes.IndexOf(l.Value!)).ToList();
            _laneList.Clear();
            _laneList.AddRange(sorted);
        }

        // The cards' "Move to" menus list the zones in the group's order.
        var zones = _laneList.Count == 0
            ? _valueOrder.Select(c => KanbanZone.Of(c)).ToList()
            : _laneList.SelectMany(l => _valueOrder.Select(c => KanbanZone.Of(c, l.Value))).ToList();
        _liveGroup?.OrderZones(zones);
    }

    // Cards open a form: the generated one, or the app's own.
    internal bool Editable => !ReadOnly && (OnSave.HasDelegate || EditDialogForm is not null);

    internal const string NewKey = "new";

    private string BoardClass => LaneOf is null ? "ib-kanban-columns" : "ib-kanban-lanes";

    private readonly List<KanbanLane> _laneList = [];
    private readonly KanbanRow _heads = new(null);

    /// <summary>The board's lanes, in the order they arrived.</summary>
    internal IReadOnlyList<KanbanLane> LaneList => _laneList;

    void IKanbanLanes.AddLane(KanbanLane lane)
    {
        if (!_laneList.Contains(lane))
        {
            _laneList.Add(lane);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    void IKanbanLanes.RemoveLane(KanbanLane lane)
    {
        if (_laneList.Remove(lane))
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    void IKanbanLanes.LaneChanged() => _ = InvokeAsync(StateHasChanged);

    // The board's content: the columns, or with lanes a row of the columns' headers and a row of
    // cells for each lane.
    private RenderFragment Inner => __builder =>
    {
        if (LaneOf is null)
        {
            @Columns
            @AddColumnButton
            return;
        }

        @AddColumnButton
        <CascadingValue Value="_heads" IsFixed="true">
            <div class="ib-kanban-heads">@Columns</div>
        </CascadingValue>
        <CascadingValue Value="(IKanbanLanes)this" IsFixed="true">@Lanes</CascadingValue>
        @foreach (var lane in _laneList)
        {
            var each = lane;
            var folded = Collapsible && (!Live && Posted is { } post ? post.IsLaneCollapsed(each.Value!) : each.IsCollapsed);
            <section @key="each" class="ib-kanban-lane" aria-labelledby="@each.TitleId" data-ib-collapsed="@(folded ? "" : null)">
                <div class="ib-kanban-lane-header">
                    @if (Collapsible)
                    {
                        <IconButton Icon="IconSet.Current.Get(IconPurpose.ChevronDown)" Label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.KanbanColumnCards, each.TitleText)"
                                    Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-kanban-toggle"
                                    aria-expanded="@(folded ? "false" : "true")" OnClick="() => each.ToggleAsync()" />
                        @if (!Live)
                        {
                            <input type="hidden" class="ib-kanban-collapsed" name="@($"{KanbanPostBinding.Prefix}.CollapsedLanes")" value="@each.Value" disabled="@(!folded)" />
                        }
                    }
                    @LaneTitle(each)
                    @LaneCount(each)
                </div>
                @* Keyed by the lane's value: drawn in the same place with another, its cells are made again as that lane's. *@
                <CascadingValue @key="each.Value" Value="each.Row" IsFixed="true">
                    <div class="ib-kanban-cells">@Columns</div>
                </CascadingValue>
            </section>
        }
    };

    private static RenderFragment LaneCount(KanbanLane lane) => builder =>
    {
        builder.OpenComponent<KanbanLaneCount<TItem>>(0);
        builder.AddComponentParameter(1, nameof(KanbanLaneCount<TItem>.Lane), lane);
        builder.CloseComponent();
    };

    private RenderFragment LaneTitle(KanbanLane lane) => builder =>
    {
        builder.OpenElement(0, $"h{TitleLevel}");
        builder.AddAttribute(1, "class", "ib-kanban-lane-title");
        builder.AddAttribute(2, "id", lane.TitleId);
        builder.AddContent(3, lane.TitleText);
        builder.CloseElement();
    };

    internal string EditKey => QueryPrefix + "card";

    internal string ColumnKey => QueryPrefix + "column";

    // On a board with lanes, a new card's: the first lane.
    private string? NewLane() => LaneOf is null ? null : _laneList.Count > 0 ? _laneList[0].Value : "";

    // The columns, in the order they were made.
    private readonly List<KanbanColumn<TItem>> _columnList = [];
    // The columns' values in the order shown: the order they arrived, then as the user moved them.
    private List<string> _valueOrder = [];
    // A column was drawn again with another value: the page renders its list without @key, so the
    // columns are in the page's order as they were made, and that order is read again.
    private bool _reorder;

    private List<string> ValueOrder
    {
        get
        {
            if (_reorder)
            {
                _reorder = false;
                _valueOrder = _columnList.Select(c => c.Value!).Distinct().ToList();
            }

            return _valueOrder;
        }
    }

    /// <summary>The board's columns, in the order shown.</summary>
    internal IReadOnlyList<KanbanColumn<TItem>> ColumnList
    {
        get
        {
            var order = ValueOrder;
            return _columnList.OrderBy(c => order.IndexOf(c.Value!)).ToList();
        }
    }

    internal bool ColumnsHaveMenu => !ReadOnly && (OnColumnRename.HasDelegate || OnColumnDelete.HasDelegate || OnColumnMove.HasDelegate);

    internal bool ColumnsHaveForm => !ReadOnly && (OnColumnRename.HasDelegate || OnColumnDelete.HasDelegate);

    internal int ColumnIndex(string value) => ValueOrder.IndexOf(value);

    internal int ColumnCount => ValueOrder.Count;

    internal void AddColumn(KanbanColumn<TItem> column)
    {
        if (!_columnList.Contains(column))
        {
            _columnList.Add(column);
            if (!_valueOrder.Contains(column.Value!))
            {
                _valueOrder.Add(column.Value!);
            }

            ColumnsArrived();
        }
    }

    internal void RemoveColumn(KanbanColumn<TItem> column)
    {
        if (_columnList.Remove(column))
        {
            if (!_columnList.Exists(c => c.Value == column.Value))
            {
                _valueOrder.Remove(column.Value!);
            }

            ColumnsArrived();
        }
    }

    // A column drawn in the same place with another value (a list rendered without @key).
    internal void ColumnValueChanged() => _reorder = true;

    // A column's menu: one place left or right.
    internal async Task MoveColumnAsync(string value, int by)
    {
        var order = ValueOrder;
        var from = order.IndexOf(value);
        var to = from + by;
        if (from < 0 || to < 0 || to >= order.Count)
        {
            return;
        }

        order.RemoveAt(from);
        order.Insert(to, value);
        await OnColumnMove.InvokeAsync(new KanbanColumnMoveEventArgs { Column = value, FromIndex = from, ToIndex = to });
        // Drawn again from the page's list, whether or not the page itself renders.
        StateHasChanged();
    }

    internal string ColumnEditKey => QueryPrefix + "edit-column";

    // A new column's form has a key of its own, as a column's value can be anything ("new").
    internal string ColumnAddKey => QueryPrefix + "add-column";

    // In the board's own state, the new column's form.
    private const string NewColumn_ = "\u0001new";

    internal string ColumnEditHref(string? value)
    {
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [ColumnEditKey] = value, [ColumnAddKey] = value is null ? "1" : null, [EditKey] = null, [ColumnKey] = null,
        }));
        return uri.AbsolutePath + uri.Query;
    }

    // After the columns: opens the form for a new one.
    private RenderFragment? AddColumnButton => ReadOnly || !OnColumnAdd.HasDelegate ? null : __builder =>
    {
        <div class="ib-kanban-new-column">
            <Button Href="@ColumnEditHref(null)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="IconSet.Current.Get(IconPurpose.Plus)">@TextDefaults.KanbanAddColumn</Button>
        </div>
    };

    // The open form lists the columns, which arrive after the board's first render.
    private void ColumnsArrived()
    {
        if (CurrentEdit is not null || CurrentColumnEdit is not null)
        {
            _ = InvokeAsync(StateHasChanged);
        }
    }

    internal string? Query(string key)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (Uri.UnescapeDataString(pair[0].Replace('+', ' ')) == key)
            {
                return pair.Length > 1 ? Uri.UnescapeDataString(pair[1].Replace('+', ' ')) : "";
            }
        }

        return null;
    }

    // This page with the form open for a card, or (with a column) for a new one there.
    internal string EditHref(string key, string? column = null)
    {
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [EditKey] = key, [ColumnKey] = column }));
        return uri.AbsolutePath + uri.Query;
    }

    // This page with the form closed.
    internal string ClosedHref
    {
        get
        {
            var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [EditKey] = null, [ColumnKey] = null, [ColumnEditKey] = null, [ColumnAddKey] = null }));
            return uri.AbsolutePath + uri.Query;
        }
    }

    // On a static page, the form's model when nothing was posted.
    internal KanbanPost Post { get; } = new();

    // On a static page, what the board's form posted, if it did.
    internal KanbanPost? Posted { get; private set; }

    private DropZoneGroup<TItem>? _group;
    // A posted move OnMove canceled: the board shows the cards where they were.
    private bool _canceled;
    private string? _canceledSay;

    private RenderFragment Binding => builder =>
    {
        builder.OpenComponent<KanbanPostBinding>(0);
        builder.AddComponentParameter(1, nameof(KanbanPostBinding.ChildContent), (RenderFragment<KanbanPost?>)(posted => StaticBoard(posted)));
        builder.CloseComponent();
    };

    // A static page: the board in a form of its own, which every move posts. It shows what was
    // posted, so a page with nowhere to save still keeps the move.
    private RenderFragment StaticBoard(KanbanPost? posted) => __builder =>
    {
        var post = posted ?? Post;
        Posted = post.Posted ? post : null;
        <EditForm Model="post" FormName="@KanbanPostBinding.FormName" OnSubmit="PostedAsync" Enhance class="ib-kanban-form">
            <DropZoneGroup TItem="TItem" Class="@BoardClass" Items="Items" ItemKey="ItemKey" ZoneOf="_zoneOf" Name="@KanbanPostBinding.Prefix"
                           Order="@(Posted is null || _canceled ? null : post.ToListOrder())" SubmitOnMove @ref="_group">
                @Inner
            </DropZoneGroup>
        </EditForm>
    };

    // A static page's post: the card that moved (the menu's, or the one the script dropped), from
    // where the cards say it was to where the posted board has it.
    private async Task PostedAsync(EditContext context)
    {
        var post = (KanbanPost)context.Model;
        // A column's menu: left:value or right:value.
        if (!ReadOnly && post.ColumnMove?.Split(':', 2) is [var way and ("left" or "right"), var zone] && OnColumnMove.HasDelegate)
        {
            await MoveColumnAsync(KanbanZone.Column(zone), way == "left" ? -1 : 1);
            return;
        }

        if (ReadOnly || post.MovedKey is not { } key || _group is null || Items is null)
        {
            return;
        }

        var items = Items as IReadOnlyList<TItem> ?? Items.ToList();
        var at = -1;
        for (var i = 0; i < items.Count; i++)
        {
            if (ItemKey!(items[i]) == key)
            {
                at = i;
                break;
            }
        }

        if (at < 0 || _group.PlaceOf(key) is not { } place)
        {
            return;
        }

        // What the interactive page refuses, a post doesn't get either: a disabled card, or one in
        // a column the board doesn't show.
        var item = items[at];
        var from = _zoneOf(item);
        if (ItemDisabled?.Invoke(item) == true || !_group.HasZone(from))
        {
            return;
        }

        // Places are among the cards shown (searched, sorted), as on an interactive page.
        var shown = new List<TItem>();
        foreach (var other in items)
        {
            if (_zoneOf(other) == from && _view?.Shows?.Invoke(other) != false)
            {
                shown.Add(other);
            }
        }

        if (_view?.Order is { } order)
        {
            var sorted = shown.Select((card, index) => (card, index)).ToList();
            sorted.Sort((a, b) => order(a.card, b.card) is var c and not 0 ? c : a.index.CompareTo(b.index));
            shown = sorted.ConvertAll(x => x.card);
        }

        var fromIndex = shown.FindIndex(card => ItemKey!(card) == key);
        var toIndex = _group.ShownIndex(item, place.Zone);
        // Nothing moved; or within a sorted column, where a card has no place of its own.
        if (place.Zone == from && (toIndex == fromIndex || _view?.Order is not null))
        {
            return;
        }

        var args = new KanbanMoveEventArgs<TItem>
        {
            Item = item, Key = key, FromIndex = fromIndex, ToIndex = toIndex,
            FromColumn = KanbanZone.Column(from), ToColumn = KanbanZone.Column(place.Zone),
            FromLane = KanbanZone.Lane(from), ToLane = KanbanZone.Lane(place.Zone),
        };
        // The order as posted, before the handler changes the cards.
        var arranged = _group.Arranged();
        await OnMove.InvokeAsync(args);
        if (args.Cancel)
        {
            _canceled = true;
            _canceledSay = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.MoveCanceled, ItemLabel?.Invoke(item) ?? ItemText?.Invoke(item) ?? key);
            return;
        }

        await ItemsChanged.InvokeAsync(arranged);
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-kanban");
        styles.AddVar("kanban-column-w", StyleValues.Length(ColumnWidth));
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _zoneOf = item => KanbanZone.Of(ColumnOf!(item), LaneOf?.Invoke(item));
        if (RendererInfo.IsInteractive)
        {
            Navigation.LocationChanged += Moved;
        }
    }

    // Interactive: the address changed (a card's link, Back, or a save): the form opens or closes.
    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ending = false;
        // A form the address no longer names (Back) keeps nothing: opened again, it reads the card again.
        if (Query(EditKey) != _editFor)
        {
            (_editFor, _editItem, _model, _context, _messages) = (null, default, null, null, null);
        }

        if (CurrentColumnEdit != _columnFor)
        {
            (_columnFor, _columnModel, _columnContext, _columnMessages) = (null, null, null, null);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= Moved;

    // ---- The column's form: its title, and Delete. ----

    private string? _columnFor;
    private KanbanColumnFields? _columnModel;
    private EditContext? _columnContext;
    private ValidationMessageStore? _columnMessages;

    private string? CurrentColumnEdit => ReadOnly || _ending ? null
        : OnColumnAdd.HasDelegate && Query(ColumnAddKey) is not null ? NewColumn_
        : ColumnsHaveForm ? Query(ColumnEditKey) : null;

    private RenderFragment ColumnFormBinding(string key) => builder =>
    {
        builder.OpenComponent<KanbanColumnBinding>(0);
        builder.AddComponentParameter(1, nameof(KanbanColumnBinding.ChildContent), (RenderFragment<KanbanColumnFields?>)(posted => ColumnDialog(key, posted)));
        builder.CloseComponent();
    };

    private KanbanColumn<TItem>? ColumnNamed(string? value) => _columnList.Find(c => c.Value == value);

    private RenderFragment ColumnDialog(string key, KanbanColumnFields? posted) => __builder =>
    {
        var isNew = key == NewColumn_;
        var column = isNew ? null : ColumnNamed(key);
        if (_columnFor != key || _columnModel is null || (posted is not null && !ReferenceEquals(posted, _columnModel)))
        {
            _columnFor = key;
            _columnModel = posted ?? new KanbanColumnFields { Title = column?.Title ?? column?.Value };
            _columnContext = new EditContext(_columnModel);
            _columnMessages = new ValidationMessageStore(_columnContext);
        }
        else if (!isNew && posted is null && _columnModel.Title is null && column is not null)
        {
            // The columns arrive after the board's first render.
            _columnModel.Title = column.Title ?? column.Value;
        }

        var name = KanbanColumnBinding.Prefix;
        var allowed = isNew ? OnColumnAdd.HasDelegate : ColumnsHaveForm;
        <Dialog Open="true" OpenChanged="OnDialogChanged" QueryKey="@(isNew ? ColumnAddKey : ColumnEditKey)" Title="@(isNew ? TextDefaults.KanbanNewColumnTitle : TextDefaults.KanbanEditColumnTitle)" Size="DialogSize.Sm" CloseOnBackdrop="false">
            @if (!allowed || (!isNew && column is null && _columnList.Count > 0))
            {
                <Alert Status="Status.Warning">@TextDefaults.KanbanColumnGone</Alert>
            }
            else
            {
                <Form EditContext="_columnContext" FormName="@(RendererInfo.IsInteractive ? null : KanbanColumnBinding.FormName)" OnSubmit="SubmitColumnAsync">
                    <FormErrors />
                    <TextField @bind-Value="_columnModel.Title" name="@($"{name}.Title")" Label="@TextDefaults.KanbanTitleField" ReadOnly="@(!isNew && !OnColumnRename.HasDelegate)" autofocus />
                    <DialogFooter>
                        @if (!isNew && OnColumnDelete.HasDelegate)
                        {
                            <ConfirmButton Title="@TextDefaults.KanbanDeleteColumnTitle" Message="@_columnModel.Title" ConfirmText="@TextDefaults.Delete"
                                           Accent="Accent.Danger" Variant="ButtonVariant.Ghost" Class="ib-kanban-delete"
                                           OnConfirm="DeleteColumnAsync" Name="@(RendererInfo.IsInteractive ? null : $"{name}.Remove")" Value="@(RendererInfo.IsInteractive ? null : "true")" formnovalidate>@TextDefaults.Delete</ConfirmButton>
                        }
                        @if (isNew || OnColumnRename.HasDelegate)
                        {
                            <Button Submit>@TextDefaults.Save</Button>
                        }
                    </DialogFooter>
                </Form>
            }
        </Dialog>
    };

    private void ColumnError(string message)
    {
        _columnMessages?.Add(new FieldIdentifier(_columnModel!, ""), message);
        _columnContext?.NotifyValidationStateChanged();
    }

    private async Task SubmitColumnAsync(EditContext context)
    {
        if (_columnModel is null || _columnMessages is null || _saving || _columnFor is not { } key)
        {
            return;
        }

        _columnMessages.Clear();
        if (_columnModel.Remove)
        {
            await DeleteColumnAsync();
            return;
        }

        if (!context.Validate())
        {
            return;
        }

        var isNew = key == NewColumn_;
        if (!isNew && ColumnNamed(key) is null)
        {
            ColumnError(TextDefaults.KanbanColumnGone);
            return;
        }

        var change = new KanbanColumnChange(isNew ? null : key, _columnModel.Title!.Trim(), ColumnError);
        _saving = true;
        try
        {
            await (isNew ? OnColumnAdd : OnColumnRename).InvokeAsync(change);
        }
        finally
        {
            _saving = false;
        }

        if (!change.HasErrors)
        {
            EndEdit();
        }
    }

    private async Task DeleteColumnAsync()
    {
        if (_columnFor is not { } key || key == NewColumn_ || _saving || !OnColumnDelete.HasDelegate)
        {
            return;
        }

        var delete = new KanbanColumnDelete(key, ColumnError);
        _saving = true;
        try
        {
            await OnColumnDelete.InvokeAsync(delete);
        }
        finally
        {
            _saving = false;
        }

        if (!delete.HasErrors)
        {
            EndEdit();
        }
    }

    // ---- The card's form: a card's, or a new one's. ----

    private string? _editFor;
    private TItem? _editItem;
    private KanbanEditFields? _model;
    private EditContext? _context;
    private ValidationMessageStore? _messages;
    private bool _saving;
    private bool _ending;

    private string? CurrentEdit => Editable && !_ending ? Query(EditKey) : null;

    private TItem? Find(string key)
    {
        foreach (var item in Items ?? [])
        {
            if (ItemKey!(item) == key)
            {
                return item;
            }
        }

        return default;
    }

    // A new card's column: the one whose add button opened the form, if the board has it, else the
    // first. Before the columns have arrived (the first render), the one asked for.
    private string NewColumn()
    {
        var asked = Query(ColumnKey);
        if (ColumnList.Count == 0)
        {
            return asked ?? "";
        }

        foreach (var column in ColumnList)
        {
            if (column.Value == asked)
            {
                return asked!;
            }
        }

        return ColumnList.Count > 0 ? ColumnList[0].Value! : "";
    }

    private RenderFragment EditBinding(string key) => builder =>
    {
        builder.OpenComponent<KanbanEditBinding>(0);
        builder.AddComponentParameter(1, nameof(KanbanEditBinding.ChildContent), (RenderFragment<KanbanEditFields?>)(posted => EditDialog(key, posted)));
        builder.CloseComponent();
    };

    // The app's own form in the dialog: the board opens and closes it, the form is the app's.
    private RenderFragment OwnDialog(string key) => __builder =>
    {
        var isNew = key == NewKey;
        var item = isNew ? default : Find(key);
        <Dialog Open="true" OpenChanged="OnDialogChanged" QueryKey="@EditKey" Title="@(isNew ? TextDefaults.KanbanNewTitle : TextDefaults.KanbanEditTitle)" Size="DialogSize.Md" CloseOnBackdrop="false">
            @if (!isNew && item is null)
            {
                <Alert Status="Status.Warning">@TextDefaults.KanbanGone</Alert>
            }
            else
            {
                @EditDialogForm!(new KanbanEditFormContext<TItem>(item, isNew, isNew ? NewColumn() : ColumnOf!(item!), isNew ? NewLane() : LaneOf?.Invoke(item!), () =>
                {
                    EndEdit();
                    return Task.CompletedTask;
                }))
            }
        </Dialog>
    };

    // The form's model: the card's values, a new card's column, or what was posted.
    private void SyncEdit(string key, KanbanEditFields? posted)
    {
        // The same form drawn again (after a save's errors, or any render): it keeps its model and messages.
        if (_editFor == key && _model is not null && (posted is null || ReferenceEquals(posted, _model)))
        {
            return;
        }

        _editFor = key;
        _editItem = key == NewKey ? default : Find(key);
        if (posted is not null)
        {
            _model = posted;
        }
        else if (key == NewKey)
        {
            _model = new KanbanEditFields { Column = NewColumn(), Lane = NewLane() };
        }
        else if (_editItem is { } item)
        {
            _model = new KanbanEditFields
            {
                Title = ItemText?.Invoke(item) ?? ItemLabel?.Invoke(item) ?? item.ToString(),
                Description = ItemDescription?.Invoke(item),
                Column = ColumnOf!(item),
                Lane = LaneOf?.Invoke(item),
            };
        }
        else
        {
            _model = null;
        }

        _context = _model is null ? null : new EditContext(_model);
        _messages = _context is null ? null : new ValidationMessageStore(_context);
    }

    private RenderFragment EditDialog(string key, KanbanEditFields? posted) => __builder =>
    {
        SyncEdit(key, posted);
        var isNew = key == NewKey;
        var name = KanbanEditBinding.Prefix;
        // A column the board doesn't have (asked for in the address, or none): a new card's default.
        if (isNew && _model is not null && ColumnList.Count > 0 && !ColumnList.Any(c => c.Value == _model.Column))
        {
            _model.Column = NewColumn();
        }

        if (isNew && _model is not null && _laneList.Count > 0 && !_laneList.Any(l => l.Value == _model.Lane))
        {
            _model.Lane = NewLane();
        }

        <Dialog Open="true" OpenChanged="OnDialogChanged" QueryKey="@EditKey" Title="@(isNew ? TextDefaults.KanbanNewTitle : TextDefaults.KanbanEditTitle)" Size="DialogSize.Md" CloseOnBackdrop="false">
            @if (_model is null || _context is null)
            {
                <Alert Status="Status.Warning">@TextDefaults.KanbanGone</Alert>
            }
            else
            {
                <Form EditContext="_context" FormName="@(RendererInfo.IsInteractive ? null : KanbanEditBinding.FormName)" OnSubmit="SubmitAsync">
                    <FormErrors />
                    <TextField @bind-Value="_model.Title" name="@($"{name}.Title")" Label="@TextDefaults.KanbanTitleField" autofocus />
                    @if (ColumnList.Count > 0)
                    {
                        <Select TValue="string" @bind-Value="_model.Column" name="@($"{name}.Column")" Label="@TextDefaults.KanbanColumnField"
                                Items="@ColumnList.Select(c => c.Value!)" ItemText="@ColumnTitle" />
                    }
                    @if (LaneOf is not null && _laneList.Count > 0)
                    {
                        <Select TValue="string" @bind-Value="_model.Lane" name="@($"{name}.Lane")" Label="@TextDefaults.KanbanLaneField"
                                Items="@_laneList.Select(l => l.Value!)" ItemText="@LaneTitleOf" />
                    }
                    @if (ItemDescription is not null)
                    {
                        <TextArea @bind-Value="_model.Description" name="@($"{name}.Description")" Label="@TextDefaults.KanbanDescriptionField" />
                    }
                    <DialogFooter>
                        @if (!isNew && OnDelete.HasDelegate && _editItem is not null)
                        {
                            @* Asks first: the footer has no Cancel beside it to pause on. *@
                            <ConfirmButton Title="@TextDefaults.KanbanDeleteTitle" Message="@_model.Title" ConfirmText="@TextDefaults.Delete"
                                           Accent="Accent.Danger" Variant="ButtonVariant.Ghost" Class="ib-kanban-delete"
                                           OnConfirm="DeleteAsync" Name="@(RendererInfo.IsInteractive ? null : $"{name}.Remove")" Value="@(RendererInfo.IsInteractive ? null : "true")" formnovalidate>@TextDefaults.Delete</ConfirmButton>
                        }
                        <Button Submit>@TextDefaults.Save</Button>
                    </DialogFooter>
                </Form>
            }
        </Dialog>
    };

    private string ColumnTitle(string value)
    {
        foreach (var column in ColumnList)
        {
            if (column.Value == value)
            {
                return column.Title ?? value;
            }
        }

        return value;
    }

    private string LaneTitleOf(string value) => _laneList.FirstOrDefault(l => l.Value == value)?.TitleText ?? value;

    private void OnDialogChanged(bool open)
    {
        if (!open)
        {
            EndEdit();
        }
    }

    private async Task SubmitAsync(EditContext context)
    {
        if (_model is null || _messages is null || _saving)
        {
            return;
        }

        _messages.Clear();
        if (_model.Remove)
        {
            await DeleteAsync();
            return;
        }

        if (!context.Validate())
        {
            return;
        }

        var isNew = _editFor == NewKey;
        if (!isNew && _editItem is null)
        {
            Error(TextDefaults.KanbanGone);
            return;
        }

        // The column is a field of the form, so on a static page it's what the browser sent.
        if (!ColumnList.Any(c => c.Value == _model.Column))
        {
            _model.Column = isNew ? NewColumn() : ColumnOf!(_editItem!);
        }

        // A column that doesn't take the card, as a drag there is refused.
        if (!isNew && _model.Column != ColumnOf!(_editItem!) && ColumnNamed(_model.Column) is { Accepts: { } accepts } refusing && !accepts(_editItem!))
        {
            Error(string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.KanbanColumnRefuses, refusing.Title ?? refusing.Value));
            return;
        }

        if (LaneOf is null)
        {
            _model.Lane = null;
        }
        else if (!_laneList.Any(l => l.Value == _model.Lane))
        {
            _model.Lane = isNew ? NewLane() : LaneOf(_editItem!);
        }

        var save = new KanbanSave<TItem>(_editItem, isNew, _model, Error);
        _saving = true;
        try
        {
            await OnSave.InvokeAsync(save);
        }
        finally
        {
            _saving = false;
        }

        if (!save.HasErrors)
        {
            EndEdit();
        }
    }

    private async Task DeleteAsync()
    {
        if (_editItem is not { } item || _saving)
        {
            return;
        }

        var delete = new KanbanDelete<TItem>(item, Error);
        _saving = true;
        try
        {
            await OnDelete.InvokeAsync(delete);
        }
        finally
        {
            _saving = false;
        }

        if (!delete.HasErrors)
        {
            EndEdit();
        }
    }

    private void Error(string message)
    {
        _messages?.Add(new FieldIdentifier(_model!, ""), message);
        _context?.NotifyValidationStateChanged();
    }

    // Closes the form: the address without its keys (on a static page, the post's answer is a redirect there).
    private void EndEdit()
    {
        (_editFor, _editItem, _model, _context, _messages) = (null, default, null, null, null);
        (_columnFor, _columnModel, _columnContext, _columnMessages) = (null, null, null, null);
        _ending = true;
        Navigation.NavigateTo(ClosedHref);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ItemKey is null || ColumnOf is null)
        {
            throw new InvalidOperationException("A Kanban needs an ItemKey and a ColumnOf, such as ItemKey=\"t => t.Id\" ColumnOf=\"t => t.Status\".");
        }

        if (TitleLevel is < 2 or > 6)
        {
            throw new InvalidOperationException("Kanban's TitleLevel is 2 to 6.");
        }

        if (EditDialogForm is not null && OnDelete.HasDelegate)
        {
            throw new InvalidOperationException("A Kanban with an EditDialogForm deletes in that form, so OnDelete (the generated form's Delete button) has nothing to do; leave it out.");
        }

        (_class, _style) = BuildRootAttributes();
        BuildView();
    }

    // ---- Search and sort: which cards the columns show, and in what order. ----

    private ZoneView<TItem>? _view;
    private string? _typed;
    private Func<TItem, IComparable?>? _sortedBy;
    private bool _sortedDown;
    private string? _searched;
    private bool _viewBuilt;
    private bool _locked;

    internal string SearchKey => QueryPrefix + "q";

    // What's searched for: typed on an interactive page, else the address's.
    private string? CurrentSearch => !Searchable ? null : (_typed ?? Query(SearchKey)) is { Length: > 0 } text ? text.Trim() : null;

    // Made again only when the search or the sort changes: the zones draw again when it does.
    private void BuildView()
    {
        var search = CurrentSearch;
        if (_viewBuilt && search == _searched && ReferenceEquals(SortBy, _sortedBy) && SortDescending == _sortedDown && ReadOnly == _locked)
        {
            return;
        }

        (_viewBuilt, _searched, _sortedBy, _sortedDown, _locked) = (true, search, SortBy, SortDescending, ReadOnly);
        Func<TItem, bool>? shows = search is null ? null : item =>
            (SearchBy is not null ? SearchBy(item) : $"{ItemText?.Invoke(item) ?? ItemLabel?.Invoke(item) ?? item?.ToString()} {ItemDescription?.Invoke(item)}")
                ?.Contains(search, StringComparison.CurrentCultureIgnoreCase) == true;
        Comparison<TItem>? order = SortBy is not { } by ? null : (a, b) =>
        {
            var compared = Comparer<IComparable?>.Default.Compare(by(a), by(b));
            return SortDescending ? -compared : compared;
        };
        _view = shows is null && order is null && !ReadOnly ? null : new ZoneView<TItem>(shows, order, ReadOnly);
    }

    // How many cards the search shows, on the board's columns; nothing while there's no search.
    private string? SearchSaid
    {
        get
        {
            if (_view?.Shows is not { } shows || Items is null)
            {
                return null;
            }

            var count = 0;
            foreach (var item in Items)
            {
                if (shows(item) && _columnList.Exists(c => c.Value == ColumnOf!(item)))
                {
                    count++;
                }
            }

            return string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.KanbanSearchCount, count);
        }
    }

    private void OnSearch(ChangeEventArgs e)
    {
        _typed = e.Value?.ToString() ?? "";
        BuildView();
    }

    // The search box: bound on an interactive page; on a static one a form that puts the search in
    // the address, keeping what else is there.
    private RenderFragment SearchBar => __builder =>
    {
        var label = SearchLabel ?? TextDefaults.Search;
        <div class="ib-kanban-toolbar">
            @if (RendererInfo.IsInteractive)
            {
                <div class="ib-field ib-field-sm ib-kanban-search" role="search">
                    <div class="ib-field-control">
                        <input type="search" class="ib-field-input" aria-label="@label" placeholder="@label" value="@(_typed ?? Query(SearchKey))" autocomplete="off" @oninput="OnSearch" />
                    </div>
                </div>
                @* Says how many cards match as the search changes, for people who can't see the board change. *@
                <div class="ib-visually-hidden" role="status">@SearchSaid</div>
            }
            else
            {
                var uri = new Uri(Navigation.Uri);
                <form method="get" action="@uri.AbsolutePath" class="ib-field ib-field-sm ib-kanban-search" role="search">
                    @foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
                    {
                        var pair = part.Split('=', 2);
                        var name = Uri.UnescapeDataString(pair[0].Replace('+', ' '));
                        if (name != SearchKey && name != EditKey && name != ColumnKey && name != ColumnEditKey && name != ColumnAddKey)
                        {
                            <input type="hidden" name="@name" value="@(pair.Length > 1 ? Uri.UnescapeDataString(pair[1].Replace('+', ' ')) : "")" />
                        }
                    }
                    <div class="ib-field-control">
                        <input type="search" class="ib-field-input" aria-label="@label" placeholder="@label" value="@Query(SearchKey)" autocomplete="off" name="@SearchKey" />
                    </div>
                </form>
            }
        </div>
    };

    // The group's move, in the board's words. Handled here, so the board renders after it and the
    // columns count again.
    private async Task MovedAsync(ListMoveEventArgs<TItem> move)
    {
        if (!OnMove.HasDelegate)
        {
            return;
        }

        var args = new KanbanMoveEventArgs<TItem>
        {
            Item = move.Item, Key = move.Key, FromIndex = move.FromIndex, ToIndex = move.ToIndex,
            FromColumn = KanbanZone.Column(move.FromZone!), ToColumn = KanbanZone.Column(move.ToZone!),
            FromLane = KanbanZone.Lane(move.FromZone!), ToLane = KanbanZone.Lane(move.ToZone!),
        };
        await OnMove.InvokeAsync(args);
        move.Cancel = args.Cancel;
    }
}
