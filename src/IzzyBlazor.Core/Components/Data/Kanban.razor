@namespace IzzyBlazor
@typeparam TItem
@inherits IzzyComponentBase
@using Microsoft.AspNetCore.Components.Forms
@attribute [CascadingTypeParameter(nameof(TItem))]
@attribute [ModeSupport]

@*
    A board of cards in columns, such as tasks by status or deals by stage. Each KanbanColumn
    shows the cards whose ColumnOf is its Value, under a header with the column's title and how
    many cards it holds.

    <Kanban Items="tasks" ItemKey="t => t.Id" ColumnOf="t => t.Status" ItemText="t => t.Title"
            OnMove="Moved">
        <Columns>
            <KanbanColumn Value="To do" />
            <KanbanColumn Value="In progress" Limit="3" />
            <KanbanColumn Value="Done" />
        </Columns>
    </Kanban>

    A card drags to another place or column from anywhere on it, and its ⋯ menu has the same
    moves, with every column under "Move to". OnMove runs with each move, on a static page too,
    where the board posts a form of its own: save the card's new column there. Don't put the
    board inside another form.

    CardTemplate draws a card; without it ItemText and ItemDescription do. ItemHref makes a card a
    link and ItemMenu adds items to its ⋯ menu. The columns share the board's width, none
    narrower than ColumnWidth, and the board scrolls sideways when they don't fit. On a narrow
    board one column shows at a time with the next one's edge beside it.

    Accessibility:
    - The board is a group named by its Label. Each column is a region named by its title, which
      is a heading (TitleLevel, 3 by default), holding a list of its cards.
    - A column's count is read as "Cards: 3", or "Cards: 3 of 5" with a Limit.
    - Every card's ⋯ button is named "Actions for" and the card's label, and its menu moves the
      card, so nothing needs dragging.
    - A move is announced from the column it lands in: "Moved Budget to Done, position 1 of 3".
    - The button that collapses a column is named by the column, as in "Review cards", and says
      whether the cards are shown.

    Keyboard:
    - Tab | Go through a card's controls in order
    - Up, Down | Move to the card above or below
    - Alt+Up, Alt+Down, Alt+Home, Alt+End | On a card's link or button, move the card
    - Shift+F10, Menu | Open the card's menu
    - Escape | While dragging, cancel
    See also: DropZoneGroup, ListView.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/kanban.css"]" />
<ib-kanban @attributes="AdditionalAttributes" class="@_class" style="@_style" role="group" aria-label="@(Label ?? TextDefaults.KanbanName)"
           data-ib-interactive="@(WillBeInteractive ? "" : null)" data-ib-count="@TextDefaults.KanbanCount" data-ib-count-limit="@TextDefaults.KanbanCountOfLimit">
    <CascadingValue Value="this" IsFixed="true">
        @if (Live)
        {
            <DropZoneGroup TItem="TItem" Class="ib-kanban-columns" Items="Items" ItemKey="ItemKey" ZoneOf="_zoneOf" ItemsChanged="ItemsChanged" OnMove="MovedAsync">
                @Columns
            </DropZoneGroup>
        }
        else
        {
            @* Named for this board, so that a post reaches only its own form. *@
            <FormMappingScope Name="@($"ib-kanban-{QueryPrefix}")">
                @Binding
            </FormMappingScope>
        }
    </CascadingValue>
</ib-kanban>

@code {
    /// <summary>Every card, in every column; each column shows its own in this order.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Each card's key: what posts and what keeps its elements when it moves.</summary>
    [Parameter, EditorRequired] public Func<TItem, string>? ItemKey { get; set; }

    /// <summary>
    /// The column a card is in, matching a <see cref="KanbanColumn{TItem}"/>'s <c>Value</c>, such
    /// as <c>t =&gt; t.Status</c>. A card whose column the board doesn't have isn't shown.
    /// </summary>
    [Parameter, EditorRequired] public Func<TItem, string>? ColumnOf { get; set; }

    /// <summary>Runs with every card in its new order after a move; use <c>@bind-Items</c>.</summary>
    [Parameter, ModeSupport] public EventCallback<IReadOnlyList<TItem>> ItemsChanged { get; set; }

    /// <summary>
    /// Runs with each move, before the board changes, on a static page too (the board posts):
    /// set the card's column from <see cref="KanbanMoveEventArgs{TItem}.ToColumn"/> and save it
    /// here, or set <see cref="KanbanMoveEventArgs{TItem}.Cancel"/> to keep the card where it was.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<KanbanMoveEventArgs<TItem>> OnMove { get; set; }

    /// <summary>
    /// Sets this board's posts apart, so several can share a page: give each its own, such as
    /// <c>QueryPrefix="orders-"</c>. None by default.
    /// </summary>
    [Parameter] public string QueryPrefix { get; set; } = "";

    /// <summary>The <see cref="KanbanColumn{TItem}"/>s, in the order shown.</summary>
    [Parameter] public RenderFragment? Columns { get; set; }

    /// <summary>A card's content. Without it, <see cref="ItemText"/> and <see cref="ItemDescription"/> draw the card.</summary>
    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>The default card's text. Defaults to the card's string form.</summary>
    [Parameter] public Func<TItem, string?>? ItemText { get; set; }

    /// <summary>The default card's muted second line.</summary>
    [Parameter] public Func<TItem, string?>? ItemDescription { get; set; }

    /// <summary>
    /// Names a card for screen readers: in its link, its ⋯ button and the announcement of a move.
    /// Defaults to <see cref="ItemText"/>, then the key; set it when <see cref="CardTemplate"/> draws the card.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemLabel { get; set; }

    /// <summary>Makes each card a link to this address; the whole card is clickable.</summary>
    [Parameter] public Func<TItem, string?>? ItemHref { get; set; }

    /// <summary>Makes each card a button that runs this, on interactive pages. Cards with an <see cref="ItemHref"/> are links instead.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<TItem> OnItemClick { get; set; }

    /// <summary>Marks the card the page is showing, such as the one open beside the board.</summary>
    [Parameter] public Func<TItem, bool>? ItemCurrent { get; set; }

    /// <summary>Dims a card and keeps it where it is: it has no link and doesn't move.</summary>
    [Parameter] public Func<TItem, bool>? ItemDisabled { get; set; }

    /// <summary>A colored line down a card's edge, such as its priority's. Color only: put the meaning in the card's text too.</summary>
    [Parameter] public Func<TItem, Accent?>? ItemAccent { get; set; }

    /// <summary><c>MenuItem</c>s for each card's ⋯ menu, above its moves.</summary>
    [Parameter] public RenderFragment<TItem>? ItemMenu { get; set; }

    /// <summary>
    /// Text beside each column's count, from the column's cards, such as their total:
    /// <c>cards =&gt; cards.Sum(d =&gt; d.Value).ToString("C0")</c>.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<TItem>, string?>? ColumnSummary { get; set; }

    /// <summary>The narrowest a column gets before the board scrolls sideways. Defaults to 17rem.</summary>
    [Parameter] public Length ColumnWidth { get; set; } = Length.Rem(17);

    /// <summary>
    /// The tallest a column's cards get before they scroll under its header, such as
    /// <c>Length.Vh(60)</c>. Without it, each column is as tall as its cards.
    /// </summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>Gives each column a button that collapses it to a strip with its title and count.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public bool Collapsible { get; set; }

    /// <summary>
    /// Puts an add button in each column's header that goes to this address, from the column's
    /// <c>Value</c>, such as the page that makes a card for that column.
    /// </summary>
    [Parameter] public Func<string, string?>? AddHref { get; set; }

    /// <summary>Puts an add button in each column's header that runs this with the column's <c>Value</c>, on interactive pages.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string> OnAdd { get; set; }

    /// <summary>What an empty column says. Defaults to "Drop items here".</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Gives each card a handle to drag it by, in place of dragging from anywhere on it. The handle opens the menu of moves.</summary>
    [Parameter] public bool DragHandle { get; set; }

    /// <summary>The cards' spacing and text size. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Names the board for screen readers. Defaults to "Board".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The heading level of the columns' titles, 2 to 6. Defaults to 3.</summary>
    [Parameter] public int TitleLevel { get; set; } = 3;

    private Func<TItem, string> _zoneOf = default!;
    private string? _class;
    private string? _style;

    // Interactive (or prerendering for it): C# applies the moves and the collapsing.
    internal bool Live => WillBeInteractive;

    // On a static page, the form's model when nothing was posted.
    internal KanbanPost Post { get; } = new();

    // On a static page, what the board's form posted, if it did.
    internal KanbanPost? Posted { get; private set; }

    private DropZoneGroup<TItem>? _group;
    // A posted move OnMove cancelled: the board shows the cards where they were.
    private bool _cancelled;

    private RenderFragment Binding => builder =>
    {
        builder.OpenComponent<KanbanPostBinding>(0);
        builder.AddComponentParameter(1, nameof(KanbanPostBinding.ChildContent), (RenderFragment<KanbanPost?>)(posted => StaticBoard(posted)));
        builder.CloseComponent();
    };

    // A static page: the board in a form of its own, which every move posts. It shows what was
    // posted, so a page with nowhere to save still keeps the move.
    private RenderFragment StaticBoard(KanbanPost? posted) => __builder =>
    {
        var post = posted ?? Post;
        Posted = post.Posted ? post : null;
        <EditForm Model="post" FormName="@KanbanPostBinding.FormName" OnSubmit="PostedAsync" Enhance class="ib-kanban-form">
            <DropZoneGroup TItem="TItem" Class="ib-kanban-columns" Items="Items" ItemKey="ItemKey" ZoneOf="_zoneOf" Name="@KanbanPostBinding.Prefix"
                           Order="@(Posted is null || _cancelled ? null : post.ToListOrder())" SubmitOnMove @ref="_group">
                @Columns
            </DropZoneGroup>
        </EditForm>
    };

    // A static page's post: the card that moved (the menu's, or the one the script dropped), from
    // where the cards say it was to where the posted board has it.
    private async Task PostedAsync(EditContext context)
    {
        var post = (KanbanPost)context.Model;
        if (post.MovedKey is not { } key || _group is null || Items is null)
        {
            return;
        }

        var items = Items as IReadOnlyList<TItem> ?? Items.ToList();
        var at = -1;
        for (var i = 0; i < items.Count; i++)
        {
            if (ItemKey!(items[i]) == key)
            {
                at = i;
                break;
            }
        }

        if (at < 0 || _group.PlaceOf(key) is not { } place)
        {
            return;
        }

        var item = items[at];
        var from = _zoneOf(item);
        var fromIndex = 0;
        for (var i = 0; i < at; i++)
        {
            if (_zoneOf(items[i]) == from)
            {
                fromIndex++;
            }
        }

        if (place.Zone == from && place.Index == fromIndex)
        {
            return;
        }

        var args = new KanbanMoveEventArgs<TItem>
        {
            Item = item, Key = key, FromIndex = fromIndex, ToIndex = place.Index,
            FromColumn = KanbanZone.Column(from), ToColumn = KanbanZone.Column(place.Zone),
        };
        // The order as posted, before the handler changes the cards.
        var arranged = _group.Arranged();
        await OnMove.InvokeAsync(args);
        if (args.Cancel)
        {
            _cancelled = true;
            return;
        }

        await ItemsChanged.InvokeAsync(arranged);
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-kanban");
        styles.AddVar("kanban-column-w", StyleValues.Length(ColumnWidth));
    }

    /// <inheritdoc />
    protected override void OnInitialized() => _zoneOf = item => KanbanZone.Of(ColumnOf!(item));

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ItemKey is null || ColumnOf is null)
        {
            throw new InvalidOperationException("A Kanban needs an ItemKey and a ColumnOf, such as ItemKey=\"t => t.Id\" ColumnOf=\"t => t.Status\".");
        }

        if (TitleLevel is < 2 or > 6)
        {
            throw new InvalidOperationException("Kanban's TitleLevel is 2 to 6.");
        }

        (_class, _style) = BuildRootAttributes();
    }

    // The group's move, in the board's words. Handled here, so the board renders after it and the
    // columns count again.
    private async Task MovedAsync(ListMoveEventArgs<TItem> move)
    {
        if (!OnMove.HasDelegate)
        {
            return;
        }

        var args = new KanbanMoveEventArgs<TItem>
        {
            Item = move.Item, Key = move.Key, FromIndex = move.FromIndex, ToIndex = move.ToIndex,
            FromColumn = KanbanZone.Column(move.FromZone!), ToColumn = KanbanZone.Column(move.ToZone!),
        };
        await OnMove.InvokeAsync(args);
        move.Cancel = args.Cancel;
    }
}
