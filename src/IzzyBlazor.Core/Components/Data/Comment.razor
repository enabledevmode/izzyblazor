@namespace IzzyBlazor
@using System.Globalization
@inherits LayoutItemBase
@attribute [ModeSupport]

@*
    Comment: one comment in a discussion, such as feedback under an article or a review on a pull
    request. Replies nest inside it. For messages exchanged as they happen, see Chat.

    <Comment Author="Ana Ruiz" Avatar="/img/ana.jpg" Time="posted" Text="Shipped on Tuesday.">
        <Actions><Button Variant="ButtonVariant.Ghost" Size="ControlSize.Sm">Reply</Button></Actions>
        <Replies>
            <Comment Author="Sam Lee" Time="later" Text="Thanks!" />
        </Replies>
    </Comment>

    The content is Text (plain, its lines kept) or anything else as ChildContent, which is also
    where a reply form goes: a Comment with only an Avatar or Initials and a TextArea inside reads
    as "you, writing". Replies step in by one avatar's width at each level. RelativeTime shows
    "2 hours ago" in place of the date, computed when the page renders, with the full date on hover.
    Extra adds to the author's line after the time: a Badge, "Edited", or a Menu.

    Accessibility:
    - The author's name is a heading (HeadingLevel, 3 by default), so screen readers can jump from
      comment to comment, as they do on GitHub.
    - Each comment is an `article` named by its author, its replies nested inside it, so a reply
      can be told from the comment it answers. Without an Author (a reply form) it's a plain `div`.
    - The time is a `time` element with the exact date and time in `datetime`.
    - The avatar is decoration: the author's name is next to it.
    See also: Chat, Timeline, Avatar.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/comment.css"]" />
@if (HasAuthor)
{
    <article @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@_authorId">@Inner</article>
}
else
{
    <div @attributes="AdditionalAttributes" class="@_class" style="@_style">@Inner</div>
}

@code {
    /// <summary>Who wrote it. Names the comment for screen readers.</summary>
    [Parameter] public string? Author { get; set; }

    /// <summary>The address of the author's picture.</summary>
    [Parameter] public string? Avatar { get; set; }

    /// <summary>The avatar's letters, in place of the author's initials. With no <see cref="Author"/>, they alone show the avatar (a reply form's "you").</summary>
    [Parameter] public string? Initials { get; set; }

    /// <summary>
    /// When it was written, shown after the author: the date and time, or how long ago with
    /// <see cref="RelativeTime"/>. The date is in the value's own offset, so give it in the
    /// reader's (the server can't know their time zone).
    /// </summary>
    [Parameter] public DateTimeOffset? Time { get; set; }

    /// <summary>
    /// Shows <see cref="Time"/> as how long ago ("5 minutes ago", "3 days ago"), with the full date
    /// on hover. Comments older than a week show their date. Worked out when the page renders.
    /// </summary>
    [Parameter] public bool RelativeTime { get; set; }

    /// <summary>
    /// More on the author's line, after the time: a <see cref="Badge"/> such as "Author" or
    /// "Moderator", the word "Edited", or a <see cref="Menu"/> of what you can do with it.
    /// </summary>
    [Parameter] public RenderFragment? Extra { get; set; }

    /// <summary>The comment as plain text, its line breaks kept.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>The comment as anything else: formatted text, an image, or a reply form. Wins over <see cref="Text"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A row under the comment for things to do with it, such as Reply and Like buttons.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Replies: more <see cref="Comment"/>s, nested inside this one and stepped in, and a link to load more.</summary>
    [Parameter] public RenderFragment? Replies { get; set; }

    /// <summary>The author's heading level, 2 to 6. Replies use the same level.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 3;

    private readonly string _authorId = IdGenerator.Next("ib-comment-author");
    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-comment");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (HeadingLevel is < 2 or > 6)
        {
            throw new InvalidOperationException("Comment's HeadingLevel is 2 to 6.");
        }

        (_class, _style) = BuildRootAttributes();
    }

    private bool HasAuthor => Author is { Length: > 0 };

    private RenderFragment Inner => __builder =>
    {
        @if (HasAuthor || Avatar is not null || Initials is not null)
        {
            <Avatar Name="@Author" Src="@Avatar" Initials="@Initials" Size="AvatarSize.Sm" Decorative Class="ib-comment-avatar" />
        }
        <div class="ib-comment-body">
            @if (HasAuthor || Time is not null || Extra is not null)
            {
                <div class="ib-comment-meta">
                    @if (HasAuthor)
                    {
                        @AuthorHeading
                    }
                    @if (Time is { } time)
                    {
                        @if (HasAuthor)
                        {
                            <span class="ib-comment-dot" aria-hidden="true">·</span>
                        }
                        <time datetime="@time.ToString("o", CultureInfo.InvariantCulture)" title="@(RelativeTime ? time.ToString("f", CultureInfo.CurrentCulture) : null)">@TimeText(time)</time>
                    }
                    @Extra
                </div>
            }
            @if (ChildContent is not null)
            {
                <div class="ib-comment-content">@ChildContent</div>
            }
            else if (!string.IsNullOrEmpty(Text))
            {
                <p class="ib-comment-content ib-comment-text">@Text</p>
            }
            @if (Actions is not null)
            {
                <div class="ib-comment-actions">@Actions</div>
            }
            @if (Replies is not null)
            {
                <div class="ib-comment-replies">@Replies</div>
            }
        </div>
    };

    private void AuthorHeading(RenderTreeBuilder builder)
    {
        builder.OpenElement(0, $"h{HeadingLevel}");
        builder.AddAttribute(1, "class", "ib-comment-author");
        builder.AddAttribute(2, "id", _authorId);
        builder.AddContent(3, Author);
        builder.CloseElement();
    }

    private string TimeText(DateTimeOffset time)
    {
        var culture = CultureInfo.CurrentCulture;
        if (!RelativeTime)
        {
            return time.ToString("g", culture);
        }

        var ago = DateTimeOffset.UtcNow - time;
        var text = TextDefaults;
        return ago switch
        {
            { TotalMinutes: < 1 } => text.CommentJustNow,
            { TotalMinutes: < 2 } => text.CommentMinuteAgo,
            { TotalHours: < 1 } => string.Format(culture, text.CommentMinutesAgo, (int)ago.TotalMinutes),
            { TotalHours: < 2 } => text.CommentHourAgo,
            { TotalDays: < 1 } => string.Format(culture, text.CommentHoursAgo, (int)ago.TotalHours),
            { TotalDays: < 2 } => text.CommentDayAgo,
            { TotalDays: < 7 } => string.Format(culture, text.CommentDaysAgo, (int)ago.TotalDays),
            _ => time.Year == DateTimeOffset.UtcNow.ToOffset(time.Offset).Year
                ? time.ToString(culture.DateTimeFormat.MonthDayPattern, culture)
                : time.ToString("d", culture),
        };
    }
}
