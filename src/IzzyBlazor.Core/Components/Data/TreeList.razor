@namespace IzzyBlazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits GridViewBase<TItem>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, each chevron is a link that loads the page with that row open or closed; there's no select-all checkbox, checking a row doesn't check the rows under it, and filters apply when you press Apply.")]

@*
    A grid whose rows form a tree. Give it the top rows and ItemChildren (nested data), or every row
    and ItemParentKey (a flat list with a parent id). It needs an ItemKey. Its columns are the
    DataGrid's: PropertyColumn and TemplateColumn, with sorting, filters, a toolbar, editing and export.

    The first column shows each row's level: an indent, a chevron on a row with rows under it, an
    optional ItemIcon, then the column's value. The chevron in its header opens or closes every row.

    Open rows are in the address (?open=key, repeated; * for all, !key for one closed), so a static
    page opens a row by a link. Bind ExpandedItems on an interactive page to keep them in the
    component. ExpandAll and ItemExpanded choose the rows that start open.

    Sorting orders each row's children among themselves; a row never leaves its parent. Filtering
    and search keep the matches and the rows above them, muted, with their branches open;
    FilterBranch keeps the rows under a match too. Pages count top rows, so a branch is never split.

    For rows in a database, set ItemsProvider instead of Items: it's asked for the top rows, then for
    each open row's children, with that row's key in request.Parent, and request.ToTreeResult answers
    it. ItemHasChildren gives rows their chevrons before their children load. A row shows up to
    ChildRowLimit rows under it (200), then Show more.

    With SelectionMode.Multiple, checking a row checks the rows under it, and a row with some of them
    checked shows a mixed box (Cascade="false" makes each box its own). A checked row stands for its
    branch, drawn or not: Selection.ApplyTree finds every row it means. SelectOnClick selects a row
    by a click on it.

    Accessibility:
    - With script, the table is a treegrid: each row has its level, its place among its siblings and,
      with rows under it, whether it's open.
    - Each chevron is named for its row ("Expand Ada Lovelace"), and the header's for what it does
      ("Expand all rows").
    - A row kept only because a match is under it is muted, and still read.

    Keyboard:
    In the first column
    - Right | Open the row; on an open row, move right
    - Left | Close the row; on a closed row, move to its parent
    See also: DataGrid, TreeView.
*@

@Grid

@code {
    /// <inheritdoc />
    internal override RenderFragment FirstCell(TItem item, RenderFragment content) => !_treeRows.TryGetValue(KeyOf(item), out var row) ? content : __builder =>
    {
        var key = KeyOf(item);
        <span class="ib-treelist-cell" style="@($"--ib-treelist-depth:{row.Depth}")">
            @if (row.HasChildren)
            {
                var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, row.Open ? TextDefaults.TreeCollapse : TextDefaults.TreeExpand, LabelOf(item));
                var list = TreeToggled(key, row.Open, row.OpenByDefault);
                if (UseState)
                {
                    <button type="button" class="ib-grid-expand ib-treelist-toggle" aria-expanded="@(row.Open ? "true" : "false")" aria-label="@label" title="@label" @onclick="() => SetTreeOpenAsync(list)"><Icon Purpose="IconPurpose.ChevronRight" /></button>
                }
                else
                {
                    <a class="ib-grid-expand ib-treelist-toggle" href="@TreeLink(list)" aria-expanded="@(row.Open ? "true" : "false")" aria-label="@label" title="@label"><Icon Purpose="IconPurpose.ChevronRight" /></a>
                }
            }
            else if (_treeHasChildren)
            {
                <span class="ib-treelist-leaf"></span>
            }
            @if (ItemIcon?.Invoke(item, row.Open) is { } icon)
            {
                <Icon Name="icon" Class="ib-treelist-icon" />
            }
            <span class="ib-treelist-value">@content</span>
        </span>
    };

    /// <inheritdoc />
    // After the last row drawn under a row with more children than ChildRowLimit: how many show, and Show more.
    internal override RenderFragment? AfterRow(TItem item, int row, int? indent)
    {
        var key = KeyOf(item);
        // A row's detail (its hidden columns' values) is at its level, as the treegrid's rows are.
        var own = base.AfterRow(item, row, _treeRows.TryGetValue(key, out var at) ? at.Depth : indent);
        // The row being added under this one: first among its rows.
        if (NewRowItem is { } added && AddingUnder == key && _treeRows.TryGetValue(key, out var parent))
        {
            var child = AddedRow(added, parent.Depth + 1);
            own = own is null ? child : __builder => { @own @child };
        }

        if (!_treeMore.TryGetValue(key, out var mores))
        {
            return own;
        }

        return __builder =>
        {
            @own
            @foreach (var more in mores)
            {
                <tr class="ib-grid-group-more ib-treelist-more" aria-level="@(more.Depth + 1)">
                    @GripEmptyCell
                    @if (SelectColumn)
                    {
                        <td class="@SelectCellClass"></td>
                    }
                    <td colspan="@(Shown.Count + (LastEmptyCell is null ? 0 : 1))">
                        <span class="ib-treelist-cell" style="@($"--ib-treelist-depth:{more.Depth}")">
                            <span class="ib-treelist-leaf"></span>
                            @if (ItemIcon is not null)
                            {
                                @* The icon's room, so the text lines up with the rows' values. *@
                                <span class="ib-treelist-icon" style="inline-size: 1rem"></span>
                            }
                            <span class="ib-treelist-value">
                                @string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.GroupShowing, more.Shown, more.Total)
                                @(" ")
                                @if (UseState)
                                {
                                    <button type="button" class="ib-link" @onclick="() => ShowMoreAsync(more.Parent)">@TextDefaults.TreeShowMore</button>
                                }
                                else
                                {
                                    <a class="ib-link" href="@TreeMoreLink(more.Parent)">@TextDefaults.TreeShowMore</a>
                                }
                            </span>
                        </span>
                    </td>
                </tr>
            }
        };
    }

    /// <inheritdoc />
    internal override bool TreeGrips => TreeDragKey is not null;

    /// <inheritdoc />
    // The row's handle, as a DataGrid's reorder handle looks: dragged, it moves the row and its branch;
    // pressed (or with the keyboard), it opens the Move dialog.
    internal override RenderFragment? TreeGrip(TItem item) => !TreeGrips ? null : __builder =>
    {
        var key = KeyOf(item);
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TreeMoveItem, LabelOf(item));
        <td class="@GripCellClass" @onibmove="DropAsync" __internal_stopPropagation_onibmove="@RendererInfo.IsInteractive">
            @if (CanMoveRow(item))
            {
                @if (UseState)
                {
                    <IconButton Icon="Lucide.GripVertical" Label="@label" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-treelist-grip" OnClick="@(() => _stateMoveKey = key)" />
                }
                else
                {
                    <IconButton Icon="Lucide.GripVertical" Label="@label" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-treelist-grip"
                                Href="@Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [MoveQueryKey] = key, [MoveNearQueryKey] = null, [MoveAtQueryKey] = null })"
                                data-ib-autofocus="@(key == _dropped ? "" : null)" />
                }
            }
        </td>
    };

    /// <inheritdoc />
    internal override RenderFragment? MoveControl(TItem item, bool inMenu) => !OnReparent.HasDelegate || !CanMoveRow(item) ? null : __builder =>
    {
        var label = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TreeMoveItem, LabelOf(item));
        var key = KeyOf(item);
        var href = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [MoveQueryKey] = key, [MoveNearQueryKey] = null, [MoveAtQueryKey] = null });
        @if (inMenu && UseState)
        {
            <MenuItem Icon="Lucide.FolderInput" OnClick="@(() => _stateMoveKey = key)" data-ib-edit>@label</MenuItem>
        }
        else if (inMenu)
        {
            <MenuItem Icon="Lucide.FolderInput" Href="@href" data-ib-edit="@MoveQueryKey">@label</MenuItem>
        }
        else if (UseState)
        {
            <IconButton Icon="Lucide.FolderInput" Label="@label" OnClick="@(() => _stateMoveKey = key)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-edit />
        }
        else
        {
            <IconButton Icon="Lucide.FolderInput" Label="@label" Href="@href" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-edit="@MoveQueryKey" />
        }
    };

    /// <inheritdoc />
    internal override RenderFragment? OwnDialog => CurrentMoveKey is null && (!TreeGrips || RendererInfo.IsInteractive) ? null : __builder =>
    {
        @if (RendererInfo.IsInteractive)
        {
            @MoveDialog(CurrentMoveKey!, null)
        }
        else
        {
            @* Named for this tree list, so that a post reaches only its own form. *@
            <FormMappingScope Name="@($"ib-tree-{QueryPrefix}")" Context="scope">
                @if (TreeGrips)
                {
                    @DropForm
                }
                @if (CurrentMoveKey is { } key)
                {
                    @MoveBinding(key)
                }
            </FormMappingScope>
        }
    };

    private RenderFragment DropFormFor(TreeListDropPost? posted) => __builder =>
    {
        <form method="post" @formname="drop" @onsubmit="() => DropPostedAsync(posted)" data-enhance data-ib-tree-drop hidden>
            <AntiforgeryToken />
            <input type="hidden" name="@($"{TreeListDropBinding.Prefix}.{nameof(TreeListDropPost.Key)}")" />
            <input type="hidden" name="@($"{TreeListDropBinding.Prefix}.{nameof(TreeListDropPost.Near)}")" />
            <input type="hidden" name="@($"{TreeListDropBinding.Prefix}.{nameof(TreeListDropPost.At)}")" />
        </form>
    };

    // A static page's drops post here: the script fills it in and sends it, so a drop moves the row as
    // it does on an interactive page, with no dialog to confirm.
    private RenderFragment DropForm => builder =>
    {
        builder.OpenComponent<TreeListDropBinding>(0);
        builder.AddComponentParameter(1, nameof(TreeListDropBinding.ChildContent), (RenderFragment<TreeListDropPost?>)DropFormFor);
        builder.CloseComponent();
    };

    private RenderFragment MoveBinding(string key) => builder =>
    {
        builder.OpenComponent<TreeListMoveBinding>(0);
        builder.AddComponentParameter(1, nameof(TreeListMoveBinding.ChildContent), (RenderFragment<TreeListMovePost?>)(posted => MoveDialog(key, posted)));
        builder.CloseComponent();
    };

    // Choose the row it goes under, or the top level; its own branch isn't offered.
    private RenderFragment MoveDialog(string key, TreeListMovePost? posted) => __builder =>
    {
        var node = _treeNodes?.GetValueOrDefault(key);
        var found = node is not null && CanMoveRow(node.Item);
        if (_moveFor != key || _moveContext is null)
        {
            _moveFor = key;
            // A drop on a static page chose the parent and place; the dialog confirms them.
            var dropped = !RendererInfo.IsInteractive && QueryValue(MoveNearQueryKey) is { } near && QueryValue(MoveAtQueryKey) is { } zone ? DropPlace(key, near, zone) : null;
            _moveDropParent = dropped is { } place ? place.Parent?.Key ?? "" : null;
            _moveIndex = dropped?.Index;
            _moveModel = new TreeListMovePost { Parent = _moveDropParent ?? node?.Parent?.Key ?? "" };
            _moveContext = new Microsoft.AspNetCore.Components.Forms.EditContext(_moveModel);
            _moveMessages = new Microsoft.AspNetCore.Components.Forms.ValidationMessageStore(_moveContext);
        }

        if (posted is not null)
        {
            _moveModel.Parent = posted.Parent;
        }

        var title = found ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TreeMoveItem, LabelOf(node!.Item)) : TextDefaults.TreeMove;
        <Dialog Open="true" OpenChanged="@(open => open ? Task.CompletedTask : EndEditAsync(saved: false))" QueryKey="@MoveQueryKey" Title="@title" Size="DialogSize.Sm" CloseOnBackdrop="false" ShowCloseButton="false" data-ib-edit-for="@key">
            <Form EditContext="_moveContext" FormName="@(RendererInfo.IsInteractive ? null : "move")" OnValidSubmit="@(() => found ? MoveAsync(key) : Task.CompletedTask)">
                @if (found)
                {
                    <FormErrors />
                    <TreeSelect TValue="string" TItem="TreeListMoveTarget" @bind-Value="_moveModel.Parent" Items="MoveTargets(key)" ItemChildren="t => t.Children"
                                ItemValue="t => t.Key" ItemText="t => t.Text" Label="@TextDefaults.TreeMoveUnder" name="@($"{TreeListMoveBinding.Prefix}.{nameof(TreeListMovePost.Parent)}")" />
                }
                else if (!IsLoading)
                {
                    <Alert Status="Status.Warning">@TextDefaults.EditRowGone</Alert>
                }
                <DialogFooter>
                    <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Href="@EditEndHref" data-ib-edit-cancel>@TextDefaults.Cancel</Button>
                    @if (found)
                    {
                        <Button Submit>@TextDefaults.TreeMove</Button>
                    }
                </DialogFooter>
            </Form>
        </Dialog>
    };

    /// <inheritdoc />
    // A new row starts its first cell at its level, as the rows around it do.
    internal override RenderFragment NewRowFirstCell(RenderFragment content, int? depth) => !_treeHasChildren && NewChild is null ? content : __builder =>
    {
        <span class="ib-treelist-cell" style="@($"--ib-treelist-depth:{depth ?? 0}")">
            <span class="ib-treelist-leaf"></span>
            <span class="ib-treelist-value">@content</span>
        </span>
    };

    /// <inheritdoc />
    internal override RenderFragment? FirstHeaderLead => !_treeHasChildren ? null : __builder =>
    {
        var all = TreeAllOpen;
        var label = all ? TextDefaults.TreeCollapseAll : TextDefaults.TreeExpandAll;
        if (UseState)
        {
            <button type="button" class="ib-grid-expand ib-treelist-toggle" aria-expanded="@(all ? "true" : "false")" aria-label="@label" title="@label" @onclick="() => SetTreeOpenAsync(TreeAll(!all))"><Icon Purpose="IconPurpose.ChevronRight" /></button>
        }
        else
        {
            <a class="ib-grid-expand ib-treelist-toggle" href="@TreeLink(TreeAll(!all))" aria-expanded="@(all ? "true" : "false")" aria-label="@label" title="@label"><Icon Purpose="IconPurpose.ChevronRight" /></a>
        }
    };
}
