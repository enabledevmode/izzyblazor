@namespace IzzyBlazor
@typeparam TItem
@inherits DataViewBase<TItem>
@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@attribute [ModeSupport]

@*
    A list of items from data, each drawn by a template: contacts, notifications, files, results.
    The list sibling of Table: the same Items or ItemsProvider, ItemKey and paging, with one
    template per item instead of columns.

    <ListView Items="people" ItemKey="p => p.Id" ItemHref="@(p => $"/people/{p.Id}")" Context="person">
        <Avatar Name="@person.Name" /> @person.Name
    </ListView>

    With no template, ItemText, ItemDescription and ItemIcon draw a row of an icon, the text and
    a muted second line. ItemHref makes each item a link (the whole item is clickable; links and
    buttons inside it still work on their own), and ItemCurrent marks the one the page is
    showing. OnItemClick does the same with a button, on interactive pages.

    ItemActions puts content at each item's end (icon buttons, a switch, a badge), and ItemMenu
    gives each item a ⋯ menu of MenuItems:

    <ListView Items="files" ItemKey="f => f.Id" ItemLabel="f => f.Name" Context="file">
        <ChildContent>@file.Name</ChildContent>
        <ItemActions><IconButton Icon="Lucide.Star" Label="@($"Star {file.Name}")" OnClick="() => Star(file)" /></ItemActions>
        <ItemMenu><MenuItem Submit Name="delete" Value="@file.Id">Delete</MenuItem></ItemMenu>
    </ListView>

    PageSize pages the items as Table does: numbered pages or First/Previous/Next by cursor, in the
    URL (?page=, ?cursor=, ?size=) or, bound on an interactive page, in the component. Load more
    and loading on scroll add each page under the items, with the button after the last one; give
    the list a MaxHeight and they scroll in its box.
    If an ItemsProvider fails, the list shows "Couldn't load the items." with Retry.

    Accessibility:
    - It's a `ul` of `li`s with `role="list"` (Safari drops a list's role without markers), so
      screen readers say how many items there are and where each one is.
    - With `ItemHref` or `OnItemClick`, each item has one link or button, named by `ItemLabel`
      (or the key), stretched over the item: one Tab stop per item.
    - The current item (`ItemCurrent`) is marked `aria-current` (on its link when it has one).
    - A disabled item (`ItemDisabled`) has no link or button, and is dimmed.
    - Each item's ⋯ button (`ItemMenu`) is named "Actions for" and its label. Tab goes through
      an item's controls in order: handle, link, checkbox, content, ItemActions, the ⋯ button.
    - With `SelectionMode`, each item has a checkbox (or, for Single, a radio button) named
      "Select" and the item's label; with script, a "Select all rows" checkbox above a Multiple
      list checks the page.
    - The range under a paged list ("1–10 of 42") is read when it changes, and a failed load is
      announced from a status region.
    See also: Table, List.
*@

<ib-listview @attributes="AdditionalAttributes" class="@_class" style="@_style" data-ib-load-on-scroll="@(Paging == DataPaging.LoadOnScroll ? "" : null)" data-ib-interactive="@(RendererInfo.IsInteractive ? "" : null)"
             tabindex="-1" @ref="_listRef">
    @ErrorStatus
    @SelectionBar
    @if (MultiSelect)
    {
        @* Select all (this page): script only; it checks the items, which report their own changes.
           Always rendered, so the script finds it when items arrive after an empty first render;
           CSS hides it while there are no items. *@
        <div class="ib-listview-select-all-row">
            <label class="ib-listview-select-all-label">
                <input type="checkbox" class="ib-check-input ib-listview-select-all" checked="@AllOnPageSelected" />
                @(SelectAllLabel ?? TextDefaults.SelectAllRows)
            </label>
        </div>
    }
    @if (Posts || ItemMenu is not null || ItemActions is not null)
    {
        @* The form's default button, ahead of the items' buttons: Enter in another field submits the
           form, rather than pressing the first item's (often disabled) Move up or its Delete. On an
           interactive page it only raises the form's submit. *@
        <button type="submit" class="ib-listview-default-submit" tabindex="-1" aria-hidden="true"></button>
    }
    @* The items and, in a list that grows, Load more after them: one box, which scrolls with a MaxHeight. *@
    <div class="@(MaxHeight is null ? "ib-listview-body" : "ib-listview-body ib-listview-scroll")" style="@BodyStyle" role="@(MaxHeight is null ? null : "region")"
         aria-label="@(MaxHeight is null ? null : AriaLabel ?? TextDefaults.ListName)" tabindex="@(MaxHeight is null ? null : "0")">
        @if (_loadError is not null)
        {
            @* In place of the items: what went wrong and a way to try again. *@
            <div class="ib-listview-state ib-data-error-content">
                @LoadFailedMessage
                @RetryControl(RetryAsync, _providerLoading)
            </div>
        }
        else if (_items.Count == 0 && IsLoading)
        {
            <ul class="ib-listview-list" role="list" aria-hidden="true">
                @for (var i = 0; i < Math.Clamp(EffectivePageSize ?? 3, 1, 6); i++)
                {
                    <li class="ib-listview-item ib-listview-skeleton"><span class="ib-skeleton ib-listview-skeleton-line"></span></li>
                }
            </ul>
        }
        else if (_items.Count == 0 && !InGroup)
        {
            <div class="ib-listview-state">
                @if (EmptyContent is not null)
                {
                    @EmptyContent
                }
                else
                {
                    @(EmptyText ?? TextDefaults.NoItems)
                }
            </div>
        }
        else
        {
            @if (Sortable)
            {
                @* The drag, the menu's moves in place and the shortcuts (static pages), and the live
                   region that announces every move. *@
                @* Keyed by DragWholeItem: the element sets up its touch handling once, for one or the other. *@
                <ib-sortable @key="DragWholeItem" class="@(Wraps ? "ib-sortable ib-sortable-horizontal" : "ib-sortable ib-sortable-vertical")"
                             data-ib-interactive="@(Live ? "" : null)"
                             data-ib-seq="@(RendererInfo.IsInteractive ? (InGroup ? Group!.MoveSeq : _moveSeq).ToString(CultureInfo.InvariantCulture) : null)"
                             @onibmove="DropAsync" @onibmove:stopPropagation="true"
                             data-ib-submit="@(Posts && (InGroup ? Group!.SubmitOnMove : SubmitOnMove) ? "" : null)"
                             data-ib-group="@(InGroup ? Group!.GroupId : null)" data-ib-zone="@(InGroup ? Zone : null)"
                             data-ib-zone-label="@(InGroup ? ZoneLabel : null)"
                             data-ib-max="@(InGroup && MaxItems is { } max ? max.ToString(CultureInfo.InvariantCulture) : null)"
                             data-ib-moved-zone="@(InGroup ? TextDefaults.MovedToZone : null)"
                             data-ib-whole="@(DragWholeItem ? "" : null)"
                             data-ib-moved="@TextDefaults.MovedTo"
                             data-ib-cancelled="@(Live ? TextDefaults.MoveCancelled : null)">
                    @ItemsList
                    @if (InGroup)
                    {
                        @* Shown by CSS while the list has no items, so a drop or a move on a static page can fill or empty it. *@
                        <div class="ib-listview-state ib-dropzone-empty">
                            @if (EmptyContent is not null)
                            {
                                @EmptyContent
                            }
                            else if (EmptyText is not null)
                            {
                                @EmptyText
                            }
                            else
                            {
                                @* Nothing drags without script. *@
                                <span class="ib-dropzone-drop">@TextDefaults.DropHere</span>
                                <span class="ib-dropzone-none">@TextDefaults.NoItems</span>
                            }
                        </div>
                    }
                    <div class="ib-visually-hidden" role="status">@_announcement</div>
                    @if (Live)
                    {
                        @* The script's own, for a drop no render answered: C# owns the one above, and
                           text the script wrote there would cut Blazor's later announcements off. *@
                        <div class="ib-visually-hidden" role="status" data-ib-say></div>
                    }
                </ib-sortable>
            }
            else
            {
                @ItemsList
            }
        }
        @MoreRow
    </div>
    @Footer(PagesLabel)
</ib-listview>

@code {
    /// <summary>An item's content. Without it, <see cref="ItemText"/>, <see cref="ItemDescription"/> and <see cref="ItemIcon"/> draw a row.</summary>
    [Parameter] public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>The default row's text. Defaults to the item's string form.</summary>
    [Parameter] public Func<TItem, string?>? ItemText { get; set; }

    /// <summary>The default row's muted second line, such as an email address or a date.</summary>
    [Parameter] public Func<TItem, string?>? ItemDescription { get; set; }

    /// <summary>The default row's icon, at its start.</summary>
    [Parameter] public Func<TItem, IconData?>? ItemIcon { get; set; }

    /// <summary>
    /// Names an item for screen readers, in its link or button. Defaults to <see cref="ItemText"/>,
    /// then the <see cref="DataViewBase{TItem}.ItemKey"/>.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemLabel { get; set; }

    /// <summary>
    /// Makes each item a link, such as to its details page. The whole item is clickable; links,
    /// buttons and fields inside it still work on their own.
    /// </summary>
    [Parameter] public Func<TItem, string?>? ItemHref { get; set; }

    /// <summary>
    /// The item for what the page is showing, such as the one whose details are beside the list:
    /// drawn as selected, and marked <c>aria-current</c> (on its link with <see cref="ItemHref"/>).
    /// </summary>
    [Parameter] public Func<TItem, bool>? ItemCurrent { get; set; }

    /// <summary>Makes each item a button that runs this, on interactive pages. Items with an <see cref="ItemHref"/> are links instead.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<TItem> OnItemClick { get; set; }

    /// <summary>
    /// Content at the end of each item, after its text: icon buttons, a switch, a badge or a time.
    /// Its controls work on their own above the item's link. Name each for its item, such as
    /// "Star report.pdf"; keep it to one or two, and put the rest in <see cref="ItemMenu"/>. On a
    /// narrow item they go under its text, at the end.
    /// </summary>
    /// <remarks>
    /// With <see cref="ItemActions"/> or <see cref="ItemMenu"/>, Enter in another field of the
    /// form submits it with no button's name or value, rather than pressing the first item's button.
    /// </remarks>
    [Parameter] public RenderFragment<TItem>? ItemActions { get; set; }

    /// <summary>
    /// Each item's menu, of <see cref="MenuItem"/>s, opened by a ⋯ button at the item's end, named
    /// "Actions for" and the item's label. Items that link or post work on static pages and with
    /// JavaScript off. When the fragment writes nothing for an item (an <c>@if</c> around its items),
    /// that item has no ⋯ button.
    /// </summary>
    [Parameter] public RenderFragment<TItem>? ItemMenu { get; set; }

    /// <summary>Dims an item and leaves it without its link or button; its <see cref="ItemActions"/> and <see cref="ItemMenu"/> stay.</summary>
    [Parameter] public Func<TItem, bool>? ItemDisabled { get; set; }

    /// <summary>
    /// <see cref="Orientation.Vertical"/> (the default) lists the items top to bottom;
    /// <see cref="Orientation.Horizontal"/> side by side, wrapping when space runs out.
    /// </summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    /// <summary>
    /// Lays the items out as cards in this many columns (2 to 6) on screens 640px and wider, such as
    /// a gallery of products. Phones get one. Defaults to 1, a list.
    /// </summary>
    [Parameter] public int Columns { get; set; } = 1;

    /// <summary>
    /// A height limit: the items scroll inside the list's box, with Load more after the last one.
    /// With <see cref="DataPaging.LoadOnScroll"/>, the next page loads as the last item scrolls into view.
    /// </summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>
    /// Draws each item as a card, with space between them rather than lines, such as the tasks in
    /// a board's columns. <see cref="Columns"/> over 1 always draws cards.
    /// </summary>
    [Parameter] public bool Cards { get; set; }

    /// <summary>A line between items in a list. Defaults to true.</summary>
    [Parameter] public bool Dividers { get; set; } = true;

    /// <summary>A rounded border around the list. Defaults to false.</summary>
    [Parameter] public bool Bordered { get; set; }

    /// <summary>Item spacing and text size. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Names the list for screen readers, when the text around it doesn't.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Lets the user reorder the items: each gets a handle to drag, which also opens a menu (Move
    /// up, Move down, Move to top, Move to bottom) for moving without dragging; with
    /// <see cref="DragWholeItem"/> and an <see cref="ItemMenu"/>, the moves go in each item's ⋯ menu
    /// instead, and the item drags from anywhere. Needs an
    /// <see cref="DataViewBase{TItem}.ItemKey"/> and every item shown: no paging and no
    /// <see cref="DataViewBase{TItem}.ItemsProvider"/>. On interactive pages bind the order with
    /// <c>@bind-Items</c>; on static pages give it a <see cref="Name"/> inside a form and pass the
    /// posted <see cref="ListOrder"/> back as <see cref="Order"/>.
    /// </summary>
    [Parameter] public bool Reorderable { get; set; }

    /// <summary>Runs with the items in their new order after a move, on interactive pages; use <c>@bind-Items</c>.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<IReadOnlyList<TItem>> ItemsChanged { get; set; }

    /// <summary>
    /// Runs before a move changes the list, on interactive pages: save it here, or set
    /// <see cref="ListMoveEventArgs{TItem}.Cancel"/> to keep the item where it was. A dragged item
    /// stays where it was dropped while this runs, for up to 3 seconds; moves made meanwhile are
    /// ignored.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<ListMoveEventArgs<TItem>> OnMove { get; set; }

    /// <summary>
    /// For a <see cref="Reorderable"/> list on a static page, the prefix of the fields it posts:
    /// <c>{Name}.Keys</c> and <c>{Name}.Move</c>, bound as a <see cref="ListOrder"/>. Without it, a
    /// static page shows no handles.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>
    /// For a <see cref="Reorderable"/> list on a static page, what the form posted: the list shows
    /// the posted order with the move applied, and focuses the moved item's handle (or ⋯ button).
    /// </summary>
    [Parameter] public ListOrder? Order { get; set; }

    /// <summary>
    /// For a <see cref="Reorderable"/> list on a static page with script, posts the form after each
    /// move, for pages that save every move. Otherwise moves stay in the page until the form is
    /// submitted. With JavaScript off, each move from an item's menu posts anyway.
    /// </summary>
    [Parameter, ModeSupport(Interactive = ModeLevel.None)]
    public bool SubmitOnMove { get; set; }

    /// <summary>
    /// For a <see cref="Reorderable"/> list, lets a drag start anywhere on an item, not only on its
    /// handle: with a mouse after a small move, on touch after a long press (so a swipe still
    /// scrolls the page). Links, buttons and fields in the item keep their presses; the item's own
    /// link (<see cref="ItemHref"/>) or button (<see cref="OnItemClick"/>) still works on a click.
    /// With an <see cref="ItemMenu"/> there are no handles: each item's ⋯ menu ends with a Move
    /// submenu (Move up, Move down, Move to top, Move to bottom); without one, the handle stays as
    /// the menu of moves.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, NoScriptNotes = "Nothing drags; with an ItemMenu, the moves in each item's ⋯ menu post the form.")]
    public bool DragWholeItem { get; set; }

    /// <summary>
    /// Makes the list a zone of the <see cref="DropZoneGroup{TItem}"/> around it: it shows the
    /// group's items whose zone is this one, and items move here from the group's other zones. Name
    /// each zone with <see cref="AriaLabel"/>, which also names it in the menu of moves.
    /// </summary>
    [Parameter] public string? Zone { get; set; }

    /// <summary>For a <see cref="Zone"/>, which items may move here from other zones, such as <c>t =&gt; t.Reviewed</c>.</summary>
    [Parameter] public Func<TItem, bool>? Accepts { get; set; }

    /// <summary>For a <see cref="Zone"/>, how many items it holds at most; a full zone takes no more from the others.</summary>
    [Parameter] public int? MaxItems { get; set; }

    [CascadingParameter] private DropZoneGroup<TItem>? Group { get; set; }

    private string? _class;
    private string? _style;
    private ElementReference _listRef;
    private string? _focusKey;
    private string? _announcement;
    private int _moveSeq;
    private bool _warned;

    // Interactive (or prerendering for it): C# applies the moves.
    private bool Live => WillBeInteractive;

    // A zone of a DropZoneGroup, which holds the items and saves the moves.
    private bool InGroup => Group is not null && Zone is not null;

    // Its items move: Reorderable, or a zone.
    private bool Sortable => Reorderable || InGroup;

    // Moving on a static page with a Name (the group's, in a zone): the order posts with the form.
    private bool Posts => Sortable && !Live && PostName is not null;

    // Moving on a static page without a Name: nothing could save a move, so no handles.
    private bool NotMovable => !Live && PostName is null;

    // DragWholeItem with an ItemMenu: the moves go in each item's ⋯ menu, and there are no handles.
    private bool MovesInMenu => Sortable && !NotMovable && DragWholeItem && ItemMenu is not null;

    private string? PostName => InGroup ? Group!.Name : Name;

    /// <summary>The zone's name in the menu of moves and in announcements.</summary>
    internal string ZoneLabel => AriaLabel ?? Zone ?? "";

    /// <inheritdoc />
    internal override IEnumerable<TItem>? SourceItems => InGroup ? Group!.ItemsIn(Zone!) : Items;

    /// <inheritdoc />
    internal override Func<TItem, string>? KeyFunc => InGroup ? Group!.ItemKey : ItemKey;

    // Rows that wrap: a drop line instead of sliding, and Left/Right shortcuts.
    private bool Wraps => Orientation == Orientation.Horizontal || ColumnCount > 1;

    private string KeysName => $"{PostName}.Keys";

    private string ZonesName => $"{PostName}.Zones";

    private string MoveName => $"{PostName}.Move";

    /// <inheritdoc />
    internal override string ViewName => "ListView";

    /// <inheritdoc />
    internal override string? AccessibleName => AriaLabel;

    /// <inheritdoc />
    internal override string LoadFailedText => TextDefaults.ListLoadFailed;

    /// <inheritdoc />
    internal override ValueTask FocusAfterRetryAsync() => _listRef.FocusAsync();

    private int ColumnCount => Math.Clamp(Columns, 1, 6);

    private bool AsCards => Cards || ColumnCount > 1;

    private string? BodyStyle => MaxHeight is { } height ? $"max-height:{StyleValues.Length(height)}" : null;

    /// <inheritdoc />
    internal override string LabelOf(TItem item) => ItemLabel?.Invoke(item) ?? ItemText?.Invoke(item) ?? KeyOf(item);

    private string PagesLabel => string.Format(CultureInfo.CurrentCulture, TextDefaults.TablePages, AriaLabel ?? TextDefaults.ListName);

    private string ItemClasses(bool action, bool current, bool disabled, bool trail) =>
        (Sortable ? "ib-listview-item ib-sortable-item" : "ib-listview-item")
        + (action ? " ib-listview-actionable" : "")
        + (current ? " ib-listview-current" : "")
        + (disabled ? " ib-listview-disabled" : "")
        + (trail ? " ib-listview-has-trail" : "");

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-listview");
        classes.Add("ib-listview-horizontal", Orientation == Orientation.Horizontal && ColumnCount == 1);
        classes.Add("ib-listview-dividers", Dividers && Orientation == Orientation.Vertical && !AsCards);
        classes.Add("ib-listview-bordered", Bordered && !AsCards);
        classes.Add("ib-listview-cards", AsCards);
        classes.Add("ib-listview-sm", Size == ControlSize.Sm);
        classes.Add("ib-listview-lg", Size == ControlSize.Lg);
        if (ColumnCount > 1)
        {
            classes.Add("ib-listview-columns");
            styles.AddVar("listview-columns", ColumnCount.ToString(CultureInfo.InvariantCulture));
        }

        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Zone is not null)
        {
            if (Group is null)
            {
                throw new InvalidOperationException($"A ListView with Zone=\"{Zone}\" goes inside a DropZoneGroup, which holds the items of every zone.");
            }

            _registeredZone = Zone;
            Group.Register(this);
        }
    }

    /// <inheritdoc />
    public override void Dispose()
    {
        if (_registeredZone is not null)
        {
            Group?.Unregister(this);
        }

        base.Dispose();
    }

    // The Zone it registered with the group; it can't change.
    private string? _registeredZone;

    /// <summary>The group's items or zones changed: shows this zone's again.</summary>
    internal void GroupChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            await SyncAndLoadAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await DispatchExceptionAsync(ex);
        }
    });

    /// <summary>What the zone's live region says next (the group's moves).</summary>
    internal void Announce(string? text) => _announcement = text;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Zone != _registeredZone)
        {
            throw new InvalidOperationException("A ListView's Zone can't change once it's shown: give each zone its own ListView (with @key, to swap one for another).");
        }

        if (InGroup)
        {
            // The group holds these for every zone.
            if (Items is not null || ItemsProvider is not null || ItemKey is not null || Name is not null || Order is not null
                || OnMove.HasDelegate || ItemsChanged.HasDelegate || SubmitOnMove)
            {
                throw new InvalidOperationException($"The ListView with Zone=\"{Zone}\" takes its items from its DropZoneGroup: give Items, ItemKey, Name, Order, SubmitOnMove, OnMove and @bind-Items to the group.");
            }

            if (PageSize is not null || PageSizeOptions is { Count: > 0 })
            {
                throw new InvalidOperationException("A drop zone shows every item: leave out PageSize and PageSizeOptions.");
            }

            if (NotMovable && !_warned)
            {
                _warned = true;
                Services.GetService<ILoggerFactory>()?.CreateLogger<ListView<TItem>>().LogWarning(
                    "A DropZoneGroup on a static page has no Name, so its zones show no handles: give it a Name inside a form, and pass the posted ListOrder back as Order.");
            }
        }
        else if (Reorderable)
        {
            if (ItemKey is null)
            {
                throw new InvalidOperationException("A Reorderable ListView needs an ItemKey, such as ItemKey=\"s => s.Id\": it's what posts and what keeps each item's elements.");
            }

            // A move on one page, or among the items a provider returned, has no well-defined place in the whole list.
            if (PageSize is not null || PageSizeOptions is { Count: > 0 } || ItemsProvider is not null)
            {
                throw new InvalidOperationException("A Reorderable ListView shows every item: leave out PageSize, PageSizeOptions and ItemsProvider, and give it Items.");
            }

            if (NotMovable && !_warned)
            {
                _warned = true;
                Services.GetService<ILoggerFactory>()?.CreateLogger<ListView<TItem>>().LogWarning(
                    "A Reorderable ListView on a static page has no Name, so it shows no handles: give it a Name inside a form, and pass the posted ListOrder back as Order.");
            }
        }

        (_class, _style) = BuildRootAttributes();
        SyncSelection();
        await SyncAndLoadAsync();
    }

    // The items, in a list; inside <ib-sortable> when they can be reordered.
    private RenderFragment ItemsList => __builder =>
    {
    <ul class="@(Sortable ? "ib-listview-list ib-sortable-list" : "ib-listview-list")" role="list" aria-label="@AriaLabel" aria-busy="@(IsLoading ? "true" : null)">
        @for (var index = 0; index < _items.Count; index++)
        {
            var row = index;
            var item = _items[row];
            var key = KeyOf(item);
            var disabled = ItemDisabled?.Invoke(item) == true;
            var href = disabled ? null : ItemHref?.Invoke(item);
            var clickable = !disabled && href is null && OnItemClick.HasDelegate;
            var current = ItemCurrent?.Invoke(item) == true ? "true" : null;
            // Fragments that write nothing for this item (an @if around their content) leave no space and no ⋯ button.
            var actions = ItemActions?.Invoke(item) is { } fragment && HasContent(fragment) ? fragment : null;
            var moves = !disabled && MovesInMenu;
            var own = ItemMenu is not null && HasContent(ItemMenu(item));
            var menu = moves || own;
            @* The first item of each page Load more adds can take focus, which goes to it when it arrives. *@
            @* By key, so an item keeps its elements (and focus) when the order changes; without an
               ItemKey the string forms may repeat, which @key doesn't allow. *@
            <li @key="(KeyFunc is null ? row : key)" class="@ItemClasses(href is not null || clickable, current is not null, disabled, actions is not null || menu)"
                data-ib-key="@(Sortable ? key : null)" data-ib-label="@(Sortable ? LabelOf(item) : null)"
                data-ib-movable="@(Sortable && !NotMovable && !disabled ? "" : null)"
                data-ib-to="@(InGroup ? AcceptingZones(item) : null)"
                aria-current="@(href is null && !clickable ? current : null)"
                tabindex="@(_pageStarts.Contains(row) || row == _arriveAt ? "-1" : null)"
                data-ib-autofocus="@(row == _arriveAt ? "" : null)" @ref="_rowRefs[row]">
                @if (Sortable && !NotMovable && !MovesInMenu)
                {
                    if (disabled)
                    {
                        <span class="ib-sortable-spacer"></span>
                    }
                    else
                    {
                        @Handle(item, key, row)
                    }
                }
                @if (href is not null)
                {
                    @* One link per item, stretched over it; controls in the item stay clickable above it. *@
                    <a class="ib-listview-action" href="@href" aria-current="@current"><span class="ib-visually-hidden">@LabelOf(item)</span></a>
                }
                else if (clickable)
                {
                    <button type="button" class="ib-listview-action" aria-current="@current" @onclick="() => OnItemClick.InvokeAsync(item)"><span class="ib-visually-hidden">@LabelOf(item)</span></button>
                }
                @if (Selectable)
                {
                    <input type="@(MultiSelect ? "checkbox" : "radio")" class="ib-check-input ib-listview-select" name="@SelectionKeysName" value="@key"
                           aria-label="@SelectLabel(item)" checked="@IsSelected(item, key)" disabled="@(disabled || !CanSelect(item))"
                           @onchange="e => OnSelectChanged(key, e)" />
                    @if (disabled && !Live && IsSelected(item, key))
                    {
                        <input type="hidden" name="@SelectionKeysName" value="@key" />
                    }
                }
                <div class="ib-listview-content">
                    @if (ChildContent is not null)
                    {
                        @ChildContent(item)
                    }
                    else
                    {
                        @DefaultRow(item)
                    }
                </div>
                @if (actions is not null || menu)
                {
                    @* One box, so the actions and the ⋯ button wrap under the content together on a narrow item. *@
                    <div class="ib-listview-trail">
                        @actions
                        @if (menu)
                        {
                            @MenuButton(item, key, row, moves, own)
                        }
                    </div>
                }
                @if (Posts)
                {
                    <input type="hidden" name="@KeysName" value="@key" />
                    @if (InGroup)
                    {
                        <input type="hidden" name="@ZonesName" value="@Zone" />
                    }
                }
            </li>
        }
    </ul>    };

    /// <inheritdoc />
    internal override void Loaded()
    {
        // A static post: the posted order, then the menu's move (not a disabled item's).
        _focusKey = null;
        if (InGroup)
        {
            _focusKey = Group!.FocusKey;
            return;
        }

        if (!Reorderable || Order is null)
        {
            return;
        }

        var entries = ListArrangement.Order(_items, KeyOf, Order.Keys, zones: null);
        if (ListMove.TryParse(Order.Move, out var move) && move.Kind != ListMoveKind.To
            && entries.Find(e => e.Key == move.Key) is { Key: not null } entry && ItemDisabled?.Invoke(entry.Item) != true)
        {
            ListArrangement.Apply(entries, move);
            _focusKey = move.Key;
        }

        _items = entries.ConvertAll(e => e.Item);
    }

    private Task MoveAsync(ListMove move) => InGroup
        ? Group!.MenuMoveAsync(move.Key, move)
        : ApplyMoveAsync(move.Key, entries => ListArrangement.Apply(entries, move));

    // A drag on an interactive page. The script holds the dragged item where it was dropped until a
    // render carries this count, so it's counted once the move is done (after an OnMove that awaits
    // a save), whatever comes of it: moved, cancelled or ignored.
    private async Task DropAsync(IzzyMoveEventArgs e)
    {
        if (InGroup)
        {
            if (e.Key is { } moved)
            {
                await Group!.DropAsync(moved, e.ToZone ?? Zone!, e.ToIndex, e.Seq);
            }

            return;
        }

        try
        {
            if (e.Key is { } key)
            {
                await ApplyMoveAsync(key, entries => ListArrangement.MoveTo(entries, key, null, e.ToIndex));
            }
        }
        finally
        {
            _moveSeq = Math.Max(_moveSeq, e.Seq);
        }
    }

    // One move at a time: one that arrives while OnMove awaits would start from the old order, and
    // whichever finished last would undo the other. It's ignored, and a dragged item goes back.
    private bool _moving;

    private async Task ApplyMoveAsync(string key, Func<List<ListEntry<TItem>>, ListMoved?> move)
    {
        if (_moving)
        {
            return;
        }

        _moving = true;
        try
        {
            await ApplyMoveCoreAsync(key, move);
        }
        finally
        {
            _moving = false;
        }
    }

    private async Task ApplyMoveCoreAsync(string key, Func<List<ListEntry<TItem>>, ListMoved?> move)
    {
        var entries = _items.Select(i => new ListEntry<TItem>(i, KeyOf(i), null)).ToList();
        var at = entries.FindIndex(e => e.Key == key);
        if (at < 0 || ItemDisabled?.Invoke(entries[at].Item) == true || move(entries) is not { } moved)
        {
            return;
        }

        var item = entries[moved.ToIndex].Item;
        var args = new ListMoveEventArgs<TItem> { Item = item, Key = key, FromIndex = moved.FromIndex, ToIndex = moved.ToIndex };
        await OnMove.InvokeAsync(args);
        if (args.Cancel)
        {
            _announcement = string.Format(CultureInfo.CurrentCulture, TextDefaults.MoveCancelled, LabelOf(item));
            return;
        }

        var items = entries.ConvertAll(e => e.Item);
        _items = items;
        _announcement = string.Format(CultureInfo.CurrentCulture, TextDefaults.MovedTo, LabelOf(item), moved.ToIndex + 1, entries.Count);
        await ItemsChanged.InvokeAsync(items);
    }

    // The handle: a grip to drag, and the button of a menu of moves.
    private RenderFragment Handle(TItem item, string key, int index) => __builder =>
    {
        var focus = !Live && key == _focusKey;
        <Menu>
            <Trigger Context="wire">
                <IconButton Icon="Lucide.GripVertical" Label="@string.Format(CultureInfo.CurrentCulture, TextDefaults.MoveItem, LabelOf(item))"
                            Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-sortable-handle ib-sortable-trigger"
                            autofocus="@focus" data-ib-autofocus="@(focus ? "" : null)" @attributes="wire" />
            </Trigger>
            <ChildContent>@Moves(key, index)</ChildContent>
        </Menu>
    };

    // The item's ⋯ button, opening its ItemMenu; with MovesInMenu, the moves follow its items in a
    // Move submenu (or are the menu, when it has none of its own).
    private RenderFragment MenuButton(TItem item, string key, int index, bool moves, bool own) => __builder =>
    {
        var focus = moves && !Live && key == _focusKey;
        <Menu Placement="Placement.BottomEnd">
            <Trigger Context="wire">
                <IconButton Icon="IconSet.Current.Get(IconRole.MoreHorizontal)" Label="@string.Format(CultureInfo.CurrentCulture, TextDefaults.ItemMenu, LabelOf(item))"
                            Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="@(moves ? "ib-listview-menu ib-sortable-trigger" : "ib-listview-menu")"
                            autofocus="@focus" data-ib-autofocus="@(focus ? "" : null)" @attributes="wire" />
            </Trigger>
            <ChildContent>
                @if (own)
                {
                    @ItemMenu!(item)
                }
                @if (moves && own)
                {
                    <MenuDivider />
                    <MenuSub Label="@TextDefaults.MoveMenu" Icon="Lucide.ArrowUpDown">@Moves(key, index)</MenuSub>
                }
                else if (moves)
                {
                    @Moves(key, index)
                }
            </ChildContent>
        </Menu>
    };

    // Move up, down, to the top and to the bottom; none past the ends.
    private RenderFragment Moves(string key, int index) => __builder =>
    {
        var first = index == 0;
        var last = index == _items.Count - 1;
        @MoveItem(new(ListMoveKind.Up, key), TextDefaults.MoveUp, Wraps ? "Alt+←" : "Alt+↑", first)
        @MoveItem(new(ListMoveKind.Down, key), TextDefaults.MoveDown, Wraps ? "Alt+→" : "Alt+↓", last)
        @MoveItem(new(ListMoveKind.Top, key), TextDefaults.MoveToTop, "Alt+Home", first)
        @MoveItem(new(ListMoveKind.Bottom, key), TextDefaults.MoveToBottom, "Alt+End", last)
        @if (InGroup)
        {
            @ZoneMoves(_items[index], key)
        }
    };

    // "Move to" and each zone that takes the item. Its own zone is hidden (the script shows it again
    // once the item moves away on a static page); a full one is disabled.
    private RenderFragment ZoneMoves(TItem item, string key) => __builder =>
    {
        var zones = Group!.Zones.Where(z => z.Accepts?.Invoke(item) != false).ToList();
        if (zones.Any(z => z != this))
        {
            <MenuDivider />
            <MenuGroup Label="@TextDefaults.MoveToMenu">
                @foreach (var zone in zones)
                {
                    var own = zone == this;
                    var move = new ListMove(ListMoveKind.To, key, zone.Zone);
                    if (Live)
                    {
                        <MenuItem Disabled="@(!own && !Group.CanMoveTo(item, zone, Zone))" hidden="@own" data-ib-move="to" data-ib-zone="@zone.Zone"
                                  OnClick="() => MoveAsync(move)">@zone.ZoneLabel</MenuItem>
                    }
                    else
                    {
                        <MenuItem Disabled="@(!own && !Group.CanMoveTo(item, zone, Zone))" hidden="@own" data-ib-move="to" data-ib-zone="@zone.Zone"
                                  Submit Name="@MoveName" Value="@move.ToString()">@zone.ZoneLabel</MenuItem>
                    }
                }
            </MenuGroup>
        }
    };

    // The zones that take an item, for the script's drag.
    private string AcceptingZones(TItem item) =>
        string.Join(' ', Group!.Zones.Where(z => z.Accepts?.Invoke(item) != false).Select(z => z.Zone));

    // Whether a fragment draws anything: an element, a component, or text that isn't only spaces.
    private static bool HasContent(RenderFragment fragment)
    {
#pragma warning disable BL0006 // Reading render frames: the fragment is run here only to see whether it's empty.
        using var builder = new Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder();
        fragment(builder);
        var frames = builder.GetFrames();
        for (var i = 0; i < frames.Count; i++)
        {
            ref var frame = ref frames.Array[i];
            switch (frame.FrameType)
            {
                case Microsoft.AspNetCore.Components.RenderTree.RenderTreeFrameType.Element:
                case Microsoft.AspNetCore.Components.RenderTree.RenderTreeFrameType.Component:
                case Microsoft.AspNetCore.Components.RenderTree.RenderTreeFrameType.Text when !string.IsNullOrWhiteSpace(frame.TextContent):
                case Microsoft.AspNetCore.Components.RenderTree.RenderTreeFrameType.Markup when !string.IsNullOrWhiteSpace(frame.MarkupContent):
                    return true;
            }
        }
#pragma warning restore BL0006

        return false;
    }

    // The script finds a menu item by its move: the shortcuts click it, and on static pages it moves the item in place.
    private static string Kind(ListMoveKind kind) => kind.ToString().ToLowerInvariant();

    private RenderFragment MoveItem(ListMove move, string text, string shortcut, bool disabled) => __builder =>
    {
        if (Live)
        {
            <MenuItem Shortcut="@shortcut" Disabled="disabled" data-ib-move="@Kind(move.Kind)" OnClick="() => MoveAsync(move)">@text</MenuItem>
        }
        else
        {
            <MenuItem Shortcut="@shortcut" Disabled="disabled" data-ib-move="@Kind(move.Kind)" Submit Name="@MoveName" Value="@move.ToString()">@text</MenuItem>
        }
    };

    private RenderFragment DefaultRow(TItem item) => __builder =>
    {
        var description = ItemDescription?.Invoke(item);
        <span class="ib-listview-row">
            @if (ItemIcon?.Invoke(item) is { } icon)
            {
                <Icon Name="icon" Class="ib-listview-icon" />
            }
            <span class="ib-listview-text">
                <span class="ib-listview-title">@(ItemText?.Invoke(item) ?? item?.ToString())</span>
                @if (!string.IsNullOrEmpty(description))
                {
                    <span class="ib-listview-description">@description</span>
                }
            </span>
        </span>
    };
}
