@namespace IzzyBlazor
@typeparam TItem
@inherits LayoutItemBase
@implements IDisposable
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions

@*
    A calendar of appointments: a day, a week, the working week, a month or a list of the coming
    days. Drawn on the server, so it shows with no script and no circuit and prints; the view and
    the date are in the page's address, so its toolbar is links and Back goes to the page before.

    <Scheduler Items="bookings" Start="b => b.Start" End="b => b.End" Title="b => b.Room" />

    Appointments a day long or more, and all-day ones (AllDay), are bars across their days;
    the rest are boxes in their day's column, side by side where they overlap. Times are shown as
    given, in the app's time zone; today and the now line are the server's clock.

    A box shows its title and Detail (such as where it is), not its times: the hours beside it say
    when, as in Outlook. ShowTime adds them. A month's day lists each appointment with its start.

    With Category and a SchedulerCategory for each kind, appointments take their category's color,
    and a Categories menu shows or hides each kind.

    With OnSave and ItemKey, appointments are links to a form in a dialog, the toolbar has a New
    button, and with script a click on empty time adds one there and a drag moves or resizes one.
    The form posts on a static page too, and OnSave saves it either way.

    Accessibility:
    - It's a region named by Label ("Schedule"); the toolbar's links say where they go
      ("Previous week"), and the view menu is a radio group of links.
    - Each day's appointments come in time order, each with its category and whole time said:
      "Team meeting, Work, Monday, November 9, 2026, 9:30 AM to 10:30 AM". With OnSave each is a
      link to its form; without, the hours can be scrolled from the keyboard.
    - The period's title is a polite live region, and today is marked with aria-current.
    - The form is the way to add, move and resize from the keyboard and with no script; a drag
      does nothing it can't.
    - The hour lines and the now line are hidden from screen readers.
    - Delete asks first.
    - The shortcuts are announced with aria-keyshortcuts; Shortcuts="false" turns them off.

    Keyboard:
    While focus is in the Scheduler, outside its menus and form (Google Calendar's letters)
    - T | Go to today
    - N, P | Go to the next or the previous day, week or month
    - D, W, X, M, A | Show the day, the week, the work week, the month or the agenda
    - C | Add an appointment (with OnSave)
    See also: Calendar, DateRangeField.
*@

<ib-scheduler @attributes="AdditionalAttributes" class="@_class" style="@_style" role="region" aria-label="@(Label ?? TextDefaults.SchedulerName)"
              data-ib-view-key="@ViewKey" data-ib-new="@(Editable ? EditHref(NewKey) : null)" data-ib-start-key="@StartKey" data-ib-edit-key="@EditKey" data-ib-day-start="@DayStart">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/scheduler.css"]" />
    <CascadingValue Value="Categories" IsFixed="true">@ChildContent</CascadingValue>
    @{
        var culture = CultureInfo.CurrentCulture;
        var (view, date) = (CurrentView, CurrentDate);
        var (first, days) = SchedulerLayout.Range(view, date, FirstDay, AgendaDays);
        var last = first.AddDays(days - 1);
        var entries = Read(first, last);
        var today = DateOnly.FromDateTime(DateTime.Now);
        var period = PeriodOf(view).ToLower(culture);
        _cards = 0;
    }
    @* Outlook's order: Today, the arrows and the period (what they change) at the start; the
       categories, the view and New at the end. *@
    <div class="ib-sched-bar">
        <div class="ib-sched-nav">
            <a class="ib-btn ib-btn-neutral ib-btn-outline" href="@Href(view, DateOnly.FromDateTime(DateTime.Now))" data-ib-key="@Key("t")" aria-keyshortcuts="@Key("T")">@TextDefaults.SchedulerToday</a>
            <a class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only" href="@Href(view, SchedulerLayout.Step(view, date, -1, AgendaDays))" data-ib-key="@Key("p")" aria-keyshortcuts="@Key("P")" aria-label="@string.Format(culture, TextDefaults.SchedulerPrevious, period)">
                <Icon Purpose="IconPurpose.ChevronLeft" />
            </a>
            <a class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only" href="@Href(view, SchedulerLayout.Step(view, date, 1, AgendaDays))" data-ib-key="@Key("n")" aria-keyshortcuts="@Key("N")" aria-label="@string.Format(culture, TextDefaults.SchedulerNext, period)">
                <Icon Purpose="IconPurpose.ChevronRight" />
            </a>
            @* The period, a button to a month to go to any date (Outlook's). *@
            <Popover Placement="Placement.BottomStart" Class="ib-sched-jump">
                <Trigger>
                    <button type="button" class="ib-sched-title" @attributes="context">
                        <span aria-live="polite">@TitleOf(view, date, first, last, culture)</span>
                        <Icon Purpose="IconPurpose.ChevronDown" />
                    </button>
                </Trigger>
                <ChildContent>
                    @* A GET form: with script, a day chosen goes there at once; with none, Go does. *@
                    <form method="get" action="@(new Uri(Navigation.Uri).AbsolutePath)" class="ib-sched-jump-form" data-ib-date-key="@DateKey">
                        @foreach (var (key, values) in QueryString.Of(Navigation.Uri))
                        {
                            if (key == DateKey || key == EditKey || key == StartKey) continue;
                            foreach (var v in values)
                            {
                                <input type="hidden" name="@key" value="@v" />
                            }
                        }
                        <Calendar TValue="DateOnly" @bind-Value="_jump" @bind-Value:after="JumpTo" name="@DateKey" Label="@TextDefaults.SchedulerGoTo" HideLabel />
                        <button type="submit" class="ib-btn ib-btn-neutral ib-btn-outline ib-sched-jump-go">@TextDefaults.SchedulerGo</button>
                    </form>
                </ChildContent>
            </Popover>
        </div>
        <div class="ib-sched-actions">
            @if (Categories.Items.Count > 0)
            {
                @* Each category shows or hides its appointments: a link with it in or out of the address. *@
                <Menu Label="@TextDefaults.SchedulerCategories" Placement="Placement.BottomEnd" Variant="ButtonVariant.Ghost" Class="ib-sched-cats">
                    @foreach (var c in Categories.Items)
                    {
                        <MenuItem Href="@ToggleHref(c.Value)" Checked="@(!Hidden.Contains(c.Value))" KeepOpen>
                            <span class="ib-sched-swatch" style="background:@Categories.ColorOf(c)"></span>@(c.Label ?? c.Value)
                        </MenuItem>
                    }
                </Menu>
            }
            @if (Views.Count > 1)
            {
                <Menu Label="@ViewName(view)" Placement="Placement.BottomEnd" Class="ib-sched-views">
                    <MenuRadioGroup QueryKey="@ViewKey" Value="@ViewValue(view)">
                        @foreach (var v in Views)
                        {
                            <MenuItem Value="@ViewValue(v)" Shortcut="@Key(ShortcutOf(v).ToUpperInvariant())" data-ib-key="@Key(ShortcutOf(v))">@ViewName(v)</MenuItem>
                        }
                    </MenuRadioGroup>
                </Menu>
            }
            @if (Editable)
            {
                <a class="ib-btn ib-btn-primary ib-btn-solid" href="@NewHref(date)" data-ib-key="@Key("c")" aria-keyshortcuts="@Key("C")" aria-label="@TextDefaults.SchedulerNew">
                    <Icon Purpose="IconPurpose.Plus" /><span class="ib-sched-new-text">@TextDefaults.SchedulerNewShort</span>
                </a>
            }
        </div>
    </div>

    @switch (view)
    {
        case SchedulerView.Month:
            @Month(entries, first, date, today, culture)
            break;
        case SchedulerView.Agenda:
            @Agenda(entries, first, days, today, culture)
            break;
        default:
            @Columns(entries, first, days, today, culture)
            break;
    }
    @Editor
    @if (Editable)
    {
        @MoveForm
    }
</ib-scheduler>

@code {
    /// <summary>The appointments. Those outside the range shown are left out as it draws.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>When each appointment starts, such as <c>b =&gt; b.Start</c>.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, DateTime>> Start { get; set; } = default!;

    /// <summary>When each appointment ends, such as <c>b =&gt; b.End</c>. An end at midnight is the end of the day before.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, DateTime>> End { get; set; } = default!;

    /// <summary>Each appointment's title, such as <c>b =&gt; b.Subject</c>.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Title { get; set; } = default!;

    /// <summary>
    /// A line of detail after each appointment's title, such as <c>b =&gt; b.Location</c>: on its
    /// line in the day and week views, wrapping when the box has room, and in the agenda.
    /// </summary>
    [Parameter] public Func<TItem, string?>? Detail { get; set; }

    /// <summary>
    /// Shows each appointment's times in its box in the day and week views. Off by default: the
    /// hours beside it say when (Outlook's way), and screen readers hear the whole time either way.
    /// </summary>
    [Parameter] public bool ShowTime { get; set; }

    /// <summary>Whether an appointment is all day, such as <c>b =&gt; b.AllDay</c>: a bar over its days, with no times. Appointments a day long or more are bars too.</summary>
    [Parameter] public Expression<Func<TItem, bool>>? AllDay { get; set; }

    /// <summary>Each appointment's color, a CSS color such as <c>var(--ib-color-danger)</c>. Defaults to the palette's first color.</summary>
    [Parameter] public Func<TItem, string?>? Color { get; set; }

    /// <summary>
    /// The view it opens on: <see cref="SchedulerView.Week"/> by default. The reader's choice is in
    /// the page's address, and wins.
    /// </summary>
    [Parameter] public SchedulerView View { get; set; } = SchedulerView.Week;

    /// <summary>The views in its menu, in order. All five by default.</summary>
    [Parameter] public IReadOnlyList<SchedulerView>? ViewOptions { get; set; }

    /// <summary>The day it opens on: today by default. The reader's page is in the page's address, and wins.</summary>
    [Parameter] public DateOnly? Date { get; set; }

    /// <summary>
    /// Prefix for its keys in the page's address, so several can share a page:
    /// <c>QueryPrefix="rooms-"</c> uses <c>?rooms-view=month&amp;rooms-date=2026-11-09</c>.
    /// None by default (<c>?view=…&amp;date=…</c>).
    /// </summary>
    [Parameter] public string QueryPrefix { get; set; } = "";

    /// <summary>The keyboard shortcuts (T, N, P, the views' letters and C) while focus is in it. On by default.</summary>
    [Parameter] public bool Shortcuts { get; set; } = true;

    /// <summary>The week's first day: the culture's by default.</summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }

    /// <summary>How many days the agenda lists. 7 by default.</summary>
    [Parameter] public int AgendaDays { get; set; } = 7;

    /// <summary>How many appointments a month's day shows before "+N more". 3 by default.</summary>
    [Parameter] public int MonthLimit { get; set; } = 3;

    /// <summary>The hour the day and week views open scrolled to (with script). 8 by default.</summary>
    [Parameter] public int DayStart { get; set; } = 8;

    /// <summary>The height of the day and week views' hours, which scroll inside it. 40rem by default.</summary>
    [Parameter] public Length? Height { get; set; }

    /// <summary>Its name for screen readers. "Schedule" by default.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Each appointment's category, such as <c>b =&gt; b.Kind</c>, matched to a
    /// <see cref="SchedulerCategory"/>'s <c>Value</c>: its color, the Categories menu that shows
    /// or hides it, and a choice in the edit form, which sets it.
    /// </summary>
    [Parameter] public Expression<Func<TItem, string?>>? Category { get; set; }

    /// <summary>The <see cref="SchedulerCategory"/>s, in the order of the Categories menu.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private SchedulerCategories? _categories;

    private SchedulerCategories Categories => _categories ??= new SchedulerCategories(StateHasChanged);

    private string HideKey => Prefix + "hide";

    // The categories hidden, from the address.
    private HashSet<string> Hidden => (Query(HideKey) ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).ToHashSet();

    // This page with a category shown or hidden.
    private string ToggleHref(string value)
    {
        var hidden = Hidden;
        if (!hidden.Remove(value)) hidden.Add(value);
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [HideKey] = hidden.Count == 0 ? null : string.Join(",", Categories.Items.Select(c => c.Value).Where(hidden.Contains)),
            [EditKey] = null,
            [StartKey] = null,
        }));
        return uri.AbsolutePath + uri.Query;
    }

    /// <summary>
    /// Each appointment's key, such as <c>b =&gt; b.Id.ToString()</c>: with <see cref="OnSave"/>, it
    /// names the appointment a link opens in the form (<c>?appointment=42</c>).
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemKey { get; set; }

    /// <summary>Each appointment's description, such as <c>b =&gt; b.Notes</c>: a field in the form.</summary>
    [Parameter] public Expression<Func<TItem, string?>>? Description { get; set; }

    /// <summary>
    /// Saves an appointment from the form, new or changed, on a static page too (the form posts):
    /// with it and <see cref="ItemKey"/>, appointments are links that open the form, and the toolbar
    /// has a New button. <c>save.CopyTo(item)</c> sets the mapped properties; <c>save.AddError</c>
    /// keeps the form open with a message.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<SchedulerSave<TItem>> OnSave { get; set; }

    /// <summary>Deletes an appointment: with it, the form has a Delete button.</summary>
    [Parameter, ModeSupport] public EventCallback<SchedulerDelete<TItem>> OnDelete { get; set; }

    private bool Editable => OnSave.HasDelegate && ItemKey is not null;

    private string EditKey => Prefix + "appointment";

    private string StartKey => Prefix + "start";

    private const string NewKey = "new";

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private static readonly SchedulerView[] AllViews = [SchedulerView.Day, SchedulerView.Week, SchedulerView.WorkWeek, SchedulerView.Month, SchedulerView.Agenda];

    // The date in the title's calendar.
    private DateOnly _jump;

    // Interactive: a day chosen in the title's calendar (static pages go there by script).
    private void JumpTo()
    {
        if (_jump != CurrentDate) Navigation.NavigateTo(Href(CurrentView, _jump));
    }

    private Func<TItem, DateTime>? _start, _end;
    private Func<TItem, object?>? _title;
    private Func<TItem, bool>? _allDay;
    private Func<TItem, string?>? _description, _category;
    private Expression? _lastStart, _lastEnd, _lastTitle, _lastAllDay, _lastDescription, _lastCategory;
    private IReadOnlyList<TItem> _items = [];
    private string? _class;
    private string? _style;

    private IReadOnlyList<SchedulerView> Views => ViewOptions is { Count: > 0 } v ? v : AllViews;

    private DayOfWeek FirstDay => FirstDayOfWeek ?? CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;

    private string Prefix => QueryPrefix ?? "";

    // A shortcut's letter, or nothing with Shortcuts off.
    private string? Key(string letter) => Shortcuts ? letter : null;

    private string ViewKey => Prefix + "view";

    private string DateKey => Prefix + "date";

    // The view and date: the address's, else the parameters'.
    private SchedulerView CurrentView
    {
        get
        {
            var asked = Query(ViewKey);
            foreach (var v in Views) if (ViewValue(v) == asked) return v;
            return Views.Contains(View) ? View : Views[0];
        }
    }

    private DateOnly CurrentDate =>
        Query(DateKey) is { } d && DateOnly.TryParseExact(d, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? Clamp(parsed)
            : Date is { } date ? Clamp(date) : DateOnly.FromDateTime(DateTime.Now);

    // Weeks and months around a date at DateOnly's ends would run past them.
    private static DateOnly Clamp(DateOnly date) => date < new DateOnly(2, 1, 1) ? new DateOnly(2, 1, 1) : date > new DateOnly(9998, 12, 31) ? new DateOnly(9998, 12, 31) : date;

    private static string ViewValue(SchedulerView view) => view switch
    {
        SchedulerView.WorkWeek => "workweek",
        _ => view.ToString().ToLowerInvariant(),
    };

    // What one page of a view is, for "Previous week".
    private string PeriodOf(SchedulerView view) => view switch
    {
        SchedulerView.Day => TextDefaults.SchedulerDay,
        SchedulerView.Month => TextDefaults.SchedulerMonth,
        SchedulerView.Agenda => TextDefaults.SchedulerAgenda,
        _ => TextDefaults.SchedulerWeek,
    };

    private string ViewName(SchedulerView view) => view switch
    {
        SchedulerView.Day => TextDefaults.SchedulerDay,
        SchedulerView.WorkWeek => TextDefaults.SchedulerWorkWeek,
        SchedulerView.Month => TextDefaults.SchedulerMonth,
        SchedulerView.Agenda => TextDefaults.SchedulerAgenda,
        _ => TextDefaults.SchedulerWeek,
    };

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-sched");
        if (Height is { } h) styles.AddVar("sched-height", h.Css);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (RendererInfo.IsInteractive) Navigation.LocationChanged += Moved;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Start is null || End is null || Title is null)
        {
            throw new InvalidOperationException("Scheduler needs a Start, an End and a Title for each appointment, such as b => b.Start, b => b.End and b => b.Subject.");
        }

        if (!ReferenceEquals(Start, _lastStart)) (_lastStart, _start) = (Start, Start.Compile());
        if (!ReferenceEquals(End, _lastEnd)) (_lastEnd, _end) = (End, End.Compile());
        if (!ReferenceEquals(Title, _lastTitle)) (_lastTitle, _title) = (Title, Title.Compile());
        if (!ReferenceEquals(AllDay, _lastAllDay)) (_lastAllDay, _allDay) = (AllDay, AllDay?.Compile());
        if (!ReferenceEquals(Description, _lastDescription)) (_lastDescription, _description) = (Description, Description?.Compile());
        if (!ReferenceEquals(Category, _lastCategory)) (_lastCategory, _category) = (Category, Category?.Compile());
        if (OnSave.HasDelegate && ItemKey is null)
        {
            throw new InvalidOperationException("A Scheduler with OnSave needs an ItemKey, such as b => b.Id.ToString(), which names the appointment a link opens.");
        }

        if (OnSave.HasDelegate)
        {
            foreach (var (name, read) in new (string, LambdaExpression?)[] { ("Start", Start), ("End", End), ("Title", Title), ("AllDay", AllDay), ("Description", Description), ("Category", Category) })
            {
                if (read is not null && !SchedulerMembers.CanSet(read))
                {
                    throw new InvalidOperationException($"A Scheduler with OnSave saves {name} through its lambda, so it must read a settable property, such as b => b.{name}; \"{read}\" isn't one.");
                }
            }
        }
        _items = Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];
        _jump = CurrentDate;
        base.OnParametersSet();
        (_class, _style) = BuildRootAttributes();
    }

    // Interactive: the address changed (a toolbar link or Back): draw the page it names.
    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        (_ending, _refused) = (false, null);
        _jump = CurrentDate;
        _ = InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= Moved;

    // The appointments that touch the days shown.
    private List<SchedulerEntry> Read(DateOnly first, DateOnly last)
    {
        var from = first.ToDateTime(TimeOnly.MinValue);
        var to = last.AddDays(1).ToDateTime(TimeOnly.MinValue);
        var entries = new List<SchedulerEntry>();
        var hidden = _category is null ? null : Hidden;
        for (var i = 0; i < _items.Count; i++)
        {
            if (hidden is { Count: > 0 } && _category!(_items[i]) is { } c && hidden.Contains(c)) continue;
            var (s, e) = (_start!(_items[i]), _end!(_items[i]));
            if (e < s) e = s;
            var entry = new SchedulerEntry(i, s, e, _allDay?.Invoke(_items[i]) ?? false);
            if (entry.FirstDay <= last && entry.LastDay >= first && (s < to && (e > from || s >= from))) entries.Add(entry);
        }

        return entries;
    }

    private string? Query(string key)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (Uri.UnescapeDataString(pair[0].Replace('+', ' ')) == key) return pair.Length > 1 ? Uri.UnescapeDataString(pair[1].Replace('+', ' ')) : "";
        }

        return null;
    }

    // This page at a view and date (null: today), from the site's root.
    private string Href(SchedulerView view, DateOnly? date)
    {
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [ViewKey] = ViewValue(view),
            [DateKey] = date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            [EditKey] = null,
            [StartKey] = null,
        }));
        return uri.AbsolutePath + uri.Query;
    }

    // This page with the form open: for an appointment, or a new one at a time.
    private string EditHref(string key, DateTime? start = null)
    {
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [EditKey] = key,
            [StartKey] = start?.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture),
        }));
        return uri.AbsolutePath + uri.Query;
    }

    private string NewHref(DateOnly day) => EditHref(NewKey, day.ToDateTime(new TimeOnly(Math.Clamp(DayStart, 0, 23), 0)));

    // This page with the form closed.
    private string ClosedHref
    {
        get
        {
            var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [EditKey] = null, [StartKey] = null }));
            return uri.AbsolutePath + uri.Query;
        }
    }

    // "November 2026"; across two months "Oct – Nov 2026"; across two years "Dec 2026 – Jan 2027".
    private static string TitleOf(SchedulerView view, DateOnly date, DateOnly first, DateOnly last, CultureInfo culture)
    {
        if (view == SchedulerView.Month) return date.ToString("Y", culture);
        if (first.Month == last.Month && first.Year == last.Year) return first.ToString("Y", culture);
        return first.Year == last.Year
            ? $"{first.ToString("MMM", culture)} – {last.ToString("MMM yyyy", culture)}"
            : $"{first.ToString("MMM yyyy", culture)} – {last.ToString("MMM yyyy", culture)}";
    }

    private string TitleText(SchedulerEntry e) => _title!(_items[e.Index])?.ToString() ?? "";

    private string ColorStyle(SchedulerEntry e)
    {
        var item = _items[e.Index];
        var color = Color?.Invoke(item) is { Length: > 0 } own ? own
            : _category?.Invoke(item) is { } value && Categories.Items.FirstOrDefault(c => c.Value == value) is { } category ? Categories.ColorOf(category)
            : null;
        return color is null ? "" : $"--ib-sched-color:{color}";
    }

    private static string Time(DateTime t, CultureInfo culture) => t.ToString("t", culture);

    // An appointment's category name, when it has one: said with it, since its color can't be.
    private string? CategoryLabel(SchedulerEntry e) =>
        _category?.Invoke(_items[e.Index]) is { } value && Categories.Items.FirstOrDefault(c => c.Value == value) is { } c ? c.Label ?? c.Value : null;

    // What a screen reader hears for an appointment: its title, then its whole time.
    private string Said(SchedulerEntry e, CultureInfo culture) =>
        string.Join(", ", new[] { TitleText(e), DetailText(e), CategoryLabel(e), WhenOf(e, culture) }.Where(s => s is not null));

    // An appointment's whole time: "Monday, November 9, 2026, 9:30 AM to 10:30 AM".
    private string WhenOf(SchedulerEntry e, CultureInfo culture)
    {
        var day = (DateTime t) => t.ToString("D", culture);
        string when;
        if (e.AllDay || e.IsBar)
        {
            when = e.FirstDay == e.LastDay
                ? $"{day(e.Start)}, {TextDefaults.SchedulerAllDay}"
                : string.Format(culture, TextDefaults.SchedulerTimeRange, e.AllDay ? day(e.Start) : $"{day(e.Start)} {Time(e.Start, culture)}", e.AllDay ? e.LastDay.ToString("D", culture) : $"{day(e.End)} {Time(e.End, culture)}");
        }
        else
        {
            var end = e.End.Date == e.Start.Date ? Time(e.End, culture) : $"{day(e.End)} {Time(e.End, culture)}";
            when = $"{day(e.Start)}, {string.Format(culture, TextDefaults.SchedulerTimeRange, Time(e.Start, culture), end)}";
        }

        return when;
    }

    // A start for a month's day: "11 AM" on the hour where the culture's clock is twelve-hour
    // (Outlook's), "10:30 AM" off it; a 24-hour clock keeps its minutes ("11:00").
    private static string StartOf(DateTime t, CultureInfo culture)
    {
        var pattern = culture.DateTimeFormat.ShortTimePattern;
        return t.Minute == 0 && pattern.Contains('t') && pattern.Contains(":mm")
            ? Whole(t.ToString(pattern.Replace(":mm", ""), culture))
            : Whole(Time(t, culture));
    }

    private static string Pct(double v) => (v * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    // Across a day's column, leaving room at its end to click beside the appointments (Outlook's).
    private static string Across(double v) => $"calc((100% - var(--ib-sched-gap)) * {v.ToString("0.#####", CultureInfo.InvariantCulture)})";

    private string? DetailText(SchedulerEntry e) => Detail?.Invoke(_items[e.Index]) is { Length: > 0 } d ? d : null;

    // ---- Day, week and work week: a column of hours for each day. ----

    private RenderFragment Columns(List<SchedulerEntry> entries, DateOnly first, int days, DateOnly today, CultureInfo culture) => __builder =>
    {
        var bars = SchedulerLayout.Bars(entries, first, days);
        var boxes = SchedulerLayout.Boxes(entries, first, days);
        var lanes = bars.Count == 0 ? 0 : bars.Max(b => b.Lane) + 1;
        var now = DateTime.Now;
        <div class="ib-sched-cols" style="--ib-sched-days:@days" data-ib-day-start="@DayStart">
            <div class="ib-sched-head" aria-hidden="true">
                <span class="ib-sched-gutter"></span>
                @for (var d = 0; d < days; d++)
                {
                    var day = first.AddDays(d);
                    <span class="@DayClass("ib-sched-day-head", day, today)">
                        <span class="ib-sched-num">@day.Day</span>
                        <span class="ib-sched-dow"><span class="ib-sched-dow-long">@day.ToString("dddd", culture)</span><span class="ib-sched-dow-short">@culture.DateTimeFormat.GetShortestDayName(day.DayOfWeek)</span></span>
                    </span>
                }
            </div>
            <div class="ib-sched-allday" style="grid-template-rows:repeat(@Math.Max(1, lanes), var(--ib-sched-lane))">
                <span class="ib-sched-gutter" aria-hidden="true"></span>
                @for (var d = 0; d < days; d++)
                {
                    <span class="@DayClass("ib-sched-allday-cell", first.AddDays(d), today)" style="grid-column:@(d + 2)"></span>
                }
                @foreach (var bar in bars)
                {
                    var e = entries.First(x => x.Index == bar.Index);
                    @Appointment(e, BarClass(bar.StartsBefore, bar.EndsAfter), $"grid-column:{bar.FromDay + 2} / {bar.ToDay + 3};grid-row:{bar.Lane + 1};{ColorStyle(e)}", BarContent(e, bar.StartsBefore, culture), culture)
                }
            </div>
            @* With no links in it, the scroller itself takes focus, so the keys can scroll the hours. *@
            <div class="ib-sched-scroll" tabindex="@(Editable ? "-1" : "0")" role="@(Editable ? null : "group")" aria-label="@(Editable ? null : TextDefaults.SchedulerHours)">
                <div class="ib-sched-grid">
                    <div class="ib-sched-hours" aria-hidden="true">
                        @for (var h = 1; h < 24; h++)
                        {
                            <span style="top:@Pct(h / 24.0)">@StartOf(new DateTime(2000, 1, 1, h, 0, 0), culture)</span>
                        }
                    </div>
                    @for (var d = 0; d < days; d++)
                    {
                        var day = first.AddDays(d);
                        var own = boxes.Where(b => b.Day == d).OrderBy(b => b.Top).ThenBy(b => b.Left).ToList();
                        <div class="@DayClass("ib-sched-col", day, today)" role="group" aria-current="@(day == today ? "date" : null)" aria-label="@day.ToString("D", culture)" data-ib-day="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                            @if (day == today)
                            {
                                <span class="ib-sched-now" aria-hidden="true" style="top:@Pct((now - now.Date).TotalMinutes / 1440)"></span>
                            }
                            @foreach (var box in own)
                            {
                                var e = entries.First(x => x.Index == box.Index);
                                var isShort = box.Height < 45.0 / 1440;
                                var detail = DetailText(e);
                                var boxData = Editable
                                    ? new Dictionary<string, object?> { ["draggable"] = "false", ["data-ib-item"] = ItemKey!(_items[e.Index]), ["data-ib-start"] = Iso(e.Start), ["data-ib-end"] = Iso(e.End), ["data-ib-cut"] = box.StartsBefore || box.EndsAfter ? "" : null }
                                    : null;
                                RenderFragment boxContent = @<text>
                                    <span aria-hidden="true">
                                        <span class="ib-sched-name">@TitleText(e)</span>
                                        @if (detail is not null)
                                        {
                                            @(" ")<span class="ib-sched-detail">@detail</span>
                                        }
                                        @if (ShowTime)
                                        {
                                            @(" ")<span class="ib-sched-time">@(isShort ? Whole(Time(e.Start, culture)) : $"{Whole(Time(e.Start, culture))} – {Whole(Time(e.End, culture))}")</span>
                                        }
                                    </span>
                                    <span class="ib-visually-hidden">@Said(e, culture)</span>
                                </text>;
                                @Appointment(e, isShort ? "ib-sched-event ib-sched-short" : "ib-sched-event", $"top:{Pct(box.Top)};height:{Pct(box.Height)};left:{Across(box.Left)};width:{Across(box.Width)};{ColorStyle(e)}", boxContent, culture, boxData)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    private static string DayClass(string name, DateOnly day, DateOnly today) =>
        name + (day == today ? " ib-sched-today" : "") + (day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? " ib-sched-weekend" : "");

    // A bar's title, centered; one that began before the days shown says when it began (Outlook's "‹ Nov 17").
    private RenderFragment BarContent(SchedulerEntry e, bool startsBefore, CultureInfo culture) => __builder =>
    {
        <span aria-hidden="true" class="ib-sched-bar-text">
            @if (startsBefore)
            {
                <span class="ib-sched-from"><Icon Purpose="IconPurpose.ChevronLeft" />@e.FirstDay.ToString("MMM d", culture)</span>
            }
            <span class="ib-sched-name">@TitleText(e)</span>
        </span>
        <span class="ib-visually-hidden">@Said(e, culture)</span>
    };

    private static string BarClass(bool before, bool after) =>
        "ib-sched-event ib-sched-bar-event" + (before ? " ib-sched-cont-start" : "") + (after ? " ib-sched-cont-end" : "");

    // ---- Month: six weeks of days, bars across them and each day's appointments. ----

    private RenderFragment Month(List<SchedulerEntry> entries, DateOnly first, DateOnly date, DateOnly today, CultureInfo culture) => __builder =>
    {
        <div class="ib-sched-month">
            <div class="ib-sched-week ib-sched-dows" aria-hidden="true">
                @for (var d = 0; d < 7; d++)
                {
                    <span>@first.AddDays(d).ToString("ddd", culture)</span>
                }
            </div>
            @for (var w = 0; w < 6; w++)
            {
                var weekStart = first.AddDays(w * 7);
                var bars = SchedulerLayout.Bars(entries, weekStart, 7);
                var lanes = bars.Count == 0 ? 0 : bars.Max(b => b.Lane) + 1;
                <div class="ib-sched-week" style="@($"--ib-sched-lanes:{lanes};grid-template-rows:1.75rem {string.Concat(Enumerable.Repeat("var(--ib-sched-lane) ", lanes))}minmax(4.5rem, 1fr)")">
                    @for (var d = 0; d < 7; d++)
                    {
                        var day = weekStart.AddDays(d);
                        var timed = SchedulerLayout.OnDay(entries, day, withBars: false);
                        var barsHere = bars.Count(b => b.FromDay <= d && b.ToDay >= d);
                        var room = Math.Max(0, MonthLimit - barsHere);
                        var hidden = timed.Count > room ? timed.Count - Math.Max(0, room - 1) : 0;
                        var shown = hidden > 0 ? timed.Take(Math.Max(0, room - 1)) : timed;
                        var outside = day.Month != date.Month;
                        <div class="@(DayClass("ib-sched-cell", day, today) + (outside ? " ib-sched-outside" : ""))" style="grid-column:@(d + 1)" role="group" aria-current="@(day == today ? "date" : null)" aria-label="@day.ToString("D", culture)" data-ib-day="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                            <a class="ib-sched-day-link" href="@Href(SchedulerView.Day, day)" aria-hidden="true" tabindex="-1">@(day.Day == 1 ? day.ToString("MMM d", culture) : day.Day.ToString(culture))</a>
                            <ul class="ib-sched-pills">
                                @foreach (var e in shown)
                                {
                                    <li>@Appointment(e, "ib-sched-event ib-sched-pill", ColorStyle(e), @<text>
                                        <span aria-hidden="true"><span class="ib-sched-time">@StartOf(e.Start, culture)</span> <span class="ib-sched-name">@TitleText(e)</span></span>
                                        <span class="ib-visually-hidden">@Said(e, culture)</span>
                                    </text>, culture)</li>
                                }
                                @if (hidden > 0)
                                {
                                    <li><a class="ib-sched-more" href="@Href(SchedulerView.Day, day)">@string.Format(culture, TextDefaults.SchedulerMore, hidden)<span class="ib-visually-hidden">, @day.ToString("D", culture)</span></a></li>
                                }
                            </ul>
                        </div>
                    }
                    @foreach (var bar in bars)
                    {
                        var e = entries.First(x => x.Index == bar.Index);
                        @Appointment(e, BarClass(bar.StartsBefore, bar.EndsAfter), $"grid-column:{bar.FromDay + 1} / {bar.ToDay + 2};grid-row:{bar.Lane + 2};{ColorStyle(e)}", BarContent(e, bar.StartsBefore, culture), culture)
                    }
                </div>
            }
        </div>
    };

    // ---- Agenda: the coming days' appointments, by day. ----

    private RenderFragment Agenda(List<SchedulerEntry> entries, DateOnly first, int days, DateOnly today, CultureInfo culture) => __builder =>
    {
        var any = false;
        <ol class="ib-sched-agenda">
            @for (var d = 0; d < days; d++)
            {
                var day = first.AddDays(d);
                var own = SchedulerLayout.OnDay(entries, day, withBars: true);
                if (own.Count == 0) continue;
                any = true;
                <li class="@DayClass("ib-sched-agenda-day", day, today)" aria-current="@(day == today ? "date" : null)">
                    <a class="ib-sched-agenda-date" href="@Href(SchedulerView.Day, day)" aria-label="@day.ToString("D", culture)">
                        <span class="ib-sched-num">@day.Day</span>
                        <span>@day.ToString("ddd, MMM", culture)</span>
                    </a>
                    <ul>
                        @foreach (var e in own)
                        {
                            <li>@Appointment(e, "ib-sched-event ib-sched-pill", ColorStyle(e), @<text>
                                <span class="ib-sched-time" aria-hidden="true">@(e.IsBar ? TextDefaults.SchedulerAllDay : $"{Time(e.Start, culture)} – {Time(e.End, culture)}")</span>
                                <span class="ib-sched-name" aria-hidden="true">@TitleText(e)</span>
                                @if (DetailText(e) is { } detail)
                                {
                                    <span class="ib-sched-detail" aria-hidden="true">@detail</span>
                                }
                                <span class="ib-visually-hidden">@Said(e, culture)</span>
                            </text>, culture)</li>
                        }
                    </ul>
                </li>
            }
        </ol>
        @if (!any)
        {
            <p class="ib-sched-empty">@TextDefaults.SchedulerEmpty</p>
        }
    };

    // An appointment's link to its form.
    private string? LinkOf(SchedulerEntry e) => Editable ? EditHref(ItemKey!(_items[e.Index])) : null;

    // Ids for the read-only cards, counted from 0 each render (an appointment can show twice).
    private readonly string _cardPrefix = IdGenerator.Next("ib-sched");
    private int _cards;

    // An appointment: with a form, a link to it; read-only, a button that opens a card about it
    // beside it (Outlook's and MUI's), a popover that works with no script.
    private RenderFragment Appointment(SchedulerEntry e, string cls, string style, RenderFragment content, CultureInfo culture, Dictionary<string, object?>? data = null) => __builder =>
    {
        if (Editable)
        {
            <a class="@cls" href="@LinkOf(e)" style="@style" @attributes="data">@content</a>
        }
        else
        {
            var id = $"{_cardPrefix}-{_cards++}";
            var anchor = StyleValues.AnchorName(id);
            <button type="button" class="@cls" style="@($"{style};anchor-name:{anchor}")" popovertarget="@id">@content</button>
            <div popover id="@id" role="dialog" aria-labelledby="@($"{id}-t")" class="ib-pop ib-popover ib-place-bottom-start ib-sched-card" style="@($"position-anchor:{anchor};{ColorStyle(e)}")">
                <div class="ib-sched-card-head">
                    <span class="ib-sched-swatch" aria-hidden="true"></span>
                    <span class="ib-popover-title" id="@($"{id}-t")">@TitleText(e)</span>
                </div>
                <p>@WhenOf(e, culture)</p>
                @if (DetailText(e) is { } detail)
                {
                    <p>@detail</p>
                }
                @if (CategoryLabel(e) is { } kind)
                {
                    <p class="ib-sched-card-muted">@kind</p>
                }
                @if (_description?.Invoke(_items[e.Index]) is { Length: > 0 } notes)
                {
                    <p class="ib-sched-card-notes">@notes</p>
                }
            </div>
        }
    };

    // ---- The form: an appointment's, or a new one's. ----

    private string? _editFor;
    private TItem? _editItem;
    private SchedulerEditFields? _model;
    private EditContext? _context;
    private ValidationMessageStore? _messages;
    private bool _saving;
    private bool _ending;

    private string? CurrentEdit => Editable && !_ending ? Query(EditKey) ?? _refused : null;

    private RenderFragment? Editor => CurrentEdit is not { Length: > 0 } key ? null : __builder =>
    {
        if (RendererInfo.IsInteractive)
        {
            @EditDialog(key, null)
        }
        else
        {
            @* Named for this Scheduler, so that a post reaches only its own form. *@
            <FormMappingScope Name="@($"ib-sched-{Prefix}")">
                @Binding(key)
            </FormMappingScope>
        }
    };

    private RenderFragment Binding(string key) => builder =>
    {
        builder.OpenComponent<SchedulerEditBinding>(0);
        builder.AddComponentParameter(1, nameof(SchedulerEditBinding.ChildContent), (RenderFragment<SchedulerEditFields?>)(posted => EditDialog(key, posted)));
        builder.CloseComponent();
    };

    // The form's model: the appointment's values, a new one's at the time asked, or what was posted.
    private void SyncEdit(string key, SchedulerEditFields? posted)
    {
        // The same form drawn again (after a save's errors, or any render): it keeps its model and messages.
        if (_editFor == key && _model is not null && (posted is null || ReferenceEquals(posted, _model))) return;
        _editFor = key;
        _editItem = key == NewKey ? default : _items.FirstOrDefault(i => ItemKey!(i) == key);
        if (posted is not null)
        {
            _model = posted;
        }
        else if (key == NewKey)
        {
            var start = Query(StartKey) is { } at && DateTime.TryParseExact(at, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
                ? t : CurrentDate.ToDateTime(new TimeOnly(Math.Clamp(DayStart, 0, 23), 0));
            var end = start.AddHours(1);
            _model = new SchedulerEditFields
            {
                StartDate = DateOnly.FromDateTime(start),
                StartTime = TimeOnly.FromDateTime(start),
                EndDate = DateOnly.FromDateTime(end),
                EndTime = TimeOnly.FromDateTime(end),
                Category = _category is null ? null : Categories.Items.FirstOrDefault()?.Value,
            };
        }
        else if (_editItem is { } item)
        {
            var (s, e) = (_start!(item), _end!(item));
            var entry = new SchedulerEntry(0, s, e < s ? s : e, _allDay?.Invoke(item) ?? false);
            _model = new SchedulerEditFields
            {
                Title = _title!(item)?.ToString(),
                StartDate = entry.FirstDay,
                StartTime = TimeOnly.FromDateTime(s),
                EndDate = entry.AllDay ? entry.LastDay : DateOnly.FromDateTime(entry.End),
                EndTime = TimeOnly.FromDateTime(entry.End),
                AllDay = entry.AllDay,
                Description = _description?.Invoke(item),
                Category = _category?.Invoke(item),
            };
        }
        else
        {
            _model = null;
        }

        _context = _model is null ? null : new EditContext(_model);
        _messages = _context is null ? null : new ValidationMessageStore(_context);
    }

    private RenderFragment EditDialog(string key, SchedulerEditFields? posted) => __builder =>
    {
        SyncEdit(key, posted);
        var isNew = key == NewKey;
        // The categories register after the first render: a new appointment takes the first then.
        if (isNew && _model is { Category: null } && _category is not null) _model.Category = Categories.Items.FirstOrDefault()?.Value;
        var name = SchedulerEditBinding.Prefix;
        <Dialog Open="true" OpenChanged="OnDialogChanged" QueryKey="@EditKey" Title="@(isNew ? TextDefaults.SchedulerNew : TextDefaults.SchedulerEdit)" Size="DialogSize.Md" CloseOnBackdrop="false">
            @if (_model is null || _context is null)
            {
                <Alert Status="Status.Warning">@TextDefaults.SchedulerGone</Alert>
            }
            else
            {
                <Form EditContext="_context" FormName="@(RendererInfo.IsInteractive ? null : SchedulerEditBinding.FormName)" OnSubmit="SubmitAsync" action="@(_refused is not null && !RendererInfo.IsInteractive ? EditHref(_refused) : null)">
                    <FormErrors />
                    <TextField @bind-Value="_model.Title" name="@($"{name}.Title")" Label="@TextDefaults.SchedulerTitleField" autofocus />
                    @* Each day beside its time, as one row (MUI's form). *@
                    <div class="ib-sched-when">
                        <DateField @bind-Value="_model.StartDate" name="@($"{name}.StartDate")" Label="@TextDefaults.SchedulerStartDate" />
                        <TimeField @bind-Value="_model.StartTime" name="@($"{name}.StartTime")" Label="@TextDefaults.SchedulerStartTime" Class="ib-sched-time-field" Step="TimeSpan.FromMinutes(15)" />
                    </div>
                    <div class="ib-sched-when">
                        <DateField @bind-Value="_model.EndDate" name="@($"{name}.EndDate")" Label="@TextDefaults.SchedulerEndDate" />
                        <TimeField @bind-Value="_model.EndTime" name="@($"{name}.EndTime")" Label="@TextDefaults.SchedulerEndTime" Class="ib-sched-time-field" Step="TimeSpan.FromMinutes(15)" />
                    </div>
                    @if (AllDay is not null)
                    {
                        <Switch @bind-Value="_model.AllDay" name="@($"{name}.AllDay")" Label="@TextDefaults.SchedulerAllDay" Class="ib-sched-allday-field" />
                    }
                    @if (_category is not null && Categories.Items.Count > 0)
                    {
                        @* The category sets the appointment's color, as MUI's form sets its resource. *@
                        <Select TValue="string" @bind-Value="_model.Category" name="@($"{name}.Category")" Label="@TextDefaults.SchedulerCategory"
                                Items="@Categories.Items.Select(c => c.Value)" ItemText="@CategoryTitle"
                                ItemTemplate="CategoryOption" />
                    }
                    @if (Description is not null)
                    {
                        <TextArea @bind-Value="_model.Description" name="@($"{name}.Description")" Label="@TextDefaults.SchedulerDescription" />
                    }
                    <DialogFooter>
                        @if (!isNew && OnDelete.HasDelegate && _editItem is not null)
                        {
                            @* Asks first: the footer has no Cancel beside it to pause on. *@
                            <ConfirmButton Title="@TextDefaults.SchedulerDeleteTitle" Message="@_model.Title" ConfirmText="@TextDefaults.Delete"
                                           Accent="Accent.Danger" Variant="ButtonVariant.Ghost" Class="ib-sched-delete"
                                           OnConfirm="DeleteAsync" Name="@(RendererInfo.IsInteractive ? null : $"{name}.Remove")" Value="@(RendererInfo.IsInteractive ? null : "true")" formnovalidate>@TextDefaults.Delete</ConfirmButton>
                        }
                        <Button Submit>@TextDefaults.Save</Button>
                    </DialogFooter>
                </Form>
            }
        </Dialog>
    };

    // A time that a narrow column wraps after its dash, never inside it ("11:30 / AM").
    private static string Whole(string time) => time.Replace(' ', ' ');

    private string CategoryTitle(string value) => Categories.Items.FirstOrDefault(c => c.Value == value) is { } c ? c.Label ?? c.Value : value;

    private string? CategoryColor(string value) => Categories.Items.FirstOrDefault(c => c.Value == value) is { } c ? Categories.ColorOf(c) : null;

    // A category in the form's list: its color beside its name.
    private RenderFragment<string> CategoryOption => value => @<span><span class="ib-sched-swatch" style="background:@CategoryColor(value)"></span>@CategoryTitle(value)</span>;

    private void OnDialogChanged(bool open)
    {
        if (!open) EndEdit();
    }

    private async Task SubmitAsync(EditContext context)
    {
        if (_model is null || _messages is null || _saving) return;
        _messages.Clear();
        if (_model.Remove)
        {
            await DeleteAsync();
            return;
        }

        if (!context.Validate()) return;
        if (!_model.AllDay && _model.End < _model.Start || _model.AllDay && _model.EndDate < _model.StartDate)
        {
            Error(TextDefaults.SchedulerEndBeforeStart);
            return;
        }

        if (_editFor != NewKey && _editItem is null)
        {
            Error(TextDefaults.SchedulerGone);
            return;
        }

        var fields = _model;
        var save = new SchedulerSave<TItem>(_editItem, _editFor == NewKey, fields, target =>
        {
            SchedulerMembers.Set(Start, target!, fields.Start);
            SchedulerMembers.Set(End, target!, fields.End);
            SchedulerMembers.Set(Title, target!, fields.Title);
            SchedulerMembers.Set(AllDay, target!, fields.AllDay);
            SchedulerMembers.Set(Description, target!, fields.Description);
            if (_category is not null && Categories.Items.Count > 0) SchedulerMembers.Set(Category, target!, fields.Category);
        }, Error);
        _saving = true;
        try
        {
            await OnSave.InvokeAsync(save);
        }
        finally
        {
            _saving = false;
        }

        if (!save.HasErrors) EndEdit();
    }

    private async Task DeleteAsync()
    {
        if (_editItem is not { } item || _saving) return;
        var delete = new SchedulerDelete<TItem>(item, Error);
        _saving = true;
        try
        {
            await OnDelete.InvokeAsync(delete);
        }
        finally
        {
            _saving = false;
        }

        if (!delete.HasErrors) EndEdit();
    }

    private void Error(string message)
    {
        _messages?.Add(new FieldIdentifier(_model!, ""), message);
        _context?.NotifyValidationStateChanged();
    }

    // Closes the form: the address without its keys (on a static page, the post's answer is a redirect there).
    private void EndEdit()
    {
        (_editFor, _editItem, _model, _context, _messages, _refused) = (null, default, null, null, null, null);
        _ending = true;
        Navigation.NavigateTo(ClosedHref);
    }

    private static string Iso(DateTime t) => t.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);

    // Google Calendar's letters: d, w, m and a for the views (x for the work week).
    private static string ShortcutOf(SchedulerView view) => view switch
    {
        SchedulerView.Day => "d",
        SchedulerView.Week => "w",
        SchedulerView.WorkWeek => "x",
        SchedulerView.Month => "m",
        _ => "a",
    };

    // ---- A drag's move, posted by the script (with no form shown). ----

    private readonly SchedulerMoveFields _move = new();

    private RenderFragment MoveForm => __builder =>
    {
        if (RendererInfo.IsInteractive)
        {
            @MoveFormFor(null)
        }
        else
        {
            <FormMappingScope Name="@($"ib-sched-move-{Prefix}")">
                @MoveBinding
            </FormMappingScope>
        }
    };

    private RenderFragment MoveBinding => builder =>
    {
        builder.OpenComponent<SchedulerMoveBinding>(0);
        builder.AddComponentParameter(1, nameof(SchedulerMoveBinding.ChildContent), (RenderFragment<SchedulerMoveFields?>)(posted => MoveFormFor(posted)));
        builder.CloseComponent();
    };

    private RenderFragment MoveFormFor(SchedulerMoveFields? posted) => __builder =>
    {
        var model = posted ?? _move;
        var name = SchedulerMoveBinding.Prefix;
        <EditForm Model="model" FormName="@(RendererInfo.IsInteractive ? null : SchedulerMoveBinding.FormName)" OnSubmit="MoveAsync" class="ib-sched-move" hidden>
            <input type="hidden" name="@($"{name}.Key")" @bind="model.Key" />
            <input type="hidden" name="@($"{name}.Start")" @bind="model.Start" />
            <input type="hidden" name="@($"{name}.End")" @bind="model.End" />
        </EditForm>
    };

    // A drop: the appointment at its new times, saved through OnSave like the form's. Refused, the
    // form opens with the new times and the message.
    private async Task MoveAsync(EditContext context)
    {
        var move = (SchedulerMoveFields)context.Model;
        if (_saving || move.Key is not { } key || _items.FirstOrDefault(i => ItemKey!(i) == key) is not { } item) return;
        if (!DateTime.TryParseExact(move.Start, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)
            || !DateTime.TryParseExact(move.End, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)
            || end < start)
        {
            return;
        }

        var fields = new SchedulerEditFields
        {
            Title = _title!(item)?.ToString(),
            StartDate = DateOnly.FromDateTime(start),
            StartTime = TimeOnly.FromDateTime(start),
            EndDate = DateOnly.FromDateTime(end),
            EndTime = TimeOnly.FromDateTime(end),
            Description = _description?.Invoke(item),
            Category = _category?.Invoke(item),
        };
        var messages = new List<string>();
        var save = new SchedulerSave<TItem>(item, false, fields, target =>
        {
            SchedulerMembers.Set(Start, target!, fields.Start);
            SchedulerMembers.Set(End, target!, fields.End);
        }, messages.Add);
        _saving = true;
        try
        {
            await OnSave.InvokeAsync(save);
        }
        finally
        {
            _saving = false;
        }

        (_move.Key, _move.Start, _move.End) = (null, null, null);
        if (save.HasErrors)
        {
            // The form, open at the new times, says why.
            (_editFor, _editItem, _model) = (key, item, fields);
            _context = new EditContext(_model);
            _messages = new ValidationMessageStore(_context);
            foreach (var m in messages) _messages.Add(new FieldIdentifier(_model, ""), m);
            _refused = key;
            return;
        }

        if (!RendererInfo.IsInteractive) Navigation.NavigateTo(Navigation.Uri);
    }

    // A move refused: its form shows though the address doesn't name it.
    private string? _refused;
}
