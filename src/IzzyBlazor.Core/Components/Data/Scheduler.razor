    // ---- The form: an appointment's, or a new one's. ----

    private string? _editFor;
    private TItem? _editItem;
    private SchedulerEditFields? _model;
    private EditContext? _context;
    private ValidationMessageStore? _messages;
    private bool _saving;
    private bool _ending;

    private string? CurrentEdit => Editable && !_ending ? Query(EditKey) ?? _refused : null;

    private RenderFragment? Editor => CurrentEdit is not { Length: > 0 } key ? null : __builder =>
    {
        if (EditDialogForm is not null)
        {
            @OwnDialog(key)
        }
        else if (RendererInfo.IsInteractive)
        {
            @EditDialog(key, null)
        }
        else
        {
            @* Named for this Scheduler, so that a post reaches only its own form. *@
            <FormMappingScope Name="@($"ib-sched-{Prefix}")">
                @Binding(key)
            </FormMappingScope>
        }
    };

    private RenderFragment Binding(string key) => builder =>
    {
        builder.OpenComponent<SchedulerEditBinding>(0);
        builder.AddComponentParameter(1, nameof(SchedulerEditBinding.ChildContent), (RenderFragment<SchedulerEditFields?>)(posted => EditDialog(key, posted)));
        builder.CloseComponent();
    };

    // The app's own form in the dialog: the Scheduler opens and closes it, the form is the app's.
    private RenderFragment OwnDialog(string key) => __builder =>
    {
        var isNew = key == NewKey;
        var item = isNew ? default : _items.FirstOrDefault(i => ItemKey!(i) == key);
        DateTime start, end;
        if (isNew)
        {
            start = Query(StartKey) is { } at && DateTime.TryParseExact(at, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
                ? t : CurrentDate.ToDateTime(new TimeOnly(Math.Clamp(DayStart, 0, 23), 0));
            end = start.AddHours(1);
        }
        else
        {
            (start, end) = item is null ? (default, default) : (_start!(item), _end!(item));
        }

        <Dialog Open="true" OpenChanged="OnDialogChanged" QueryKey="@EditKey" Title="@(isNew ? TextDefaults.SchedulerNew : TextDefaults.SchedulerEdit)" Size="DialogSize.Md" CloseOnBackdrop="false">
            @if (!isNew && item is null)
            {
                if (!_loading)
                {
                    <Alert Status="Status.Warning">@TextDefaults.SchedulerGone</Alert>
                }
            }
            else
            {
                @EditDialogForm!(new SchedulerEditFormContext<TItem>(item, isNew, start, end, () =>
                {
                    EndEdit();
                    return Task.CompletedTask;
                }))
            }
        </Dialog>
    };

    // Why OnSave refused the last drag, with a form of your own: said above the view.
    private List<string>? _moveRefusal;

    // The form's model: the appointment's values, a new one's at the time asked, or what was posted.
    private void SyncEdit(string key, SchedulerEditFields? posted)
    {
        // The same form drawn again (after a save's errors, or any render): it keeps its model and messages.
        if (_editFor == key && _model is not null && (posted is null || ReferenceEquals(posted, _model))) return;
        _editFor = key;
        _editItem = key == NewKey ? default : _items.FirstOrDefault(i => ItemKey!(i) == key);
        if (posted is not null)
        {
            _model = posted;
        }
        else if (key == NewKey)
        {
            var start = Query(StartKey) is { } at && DateTime.TryParseExact(at, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var t)
                ? t : CurrentDate.ToDateTime(new TimeOnly(Math.Clamp(DayStart, 0, 23), 0));
            var end = start.AddHours(1);
            _model = new SchedulerEditFields
            {
                StartDate = DateOnly.FromDateTime(start),
                StartTime = TimeOnly.FromDateTime(start),
                EndDate = DateOnly.FromDateTime(end),
                EndTime = TimeOnly.FromDateTime(end),
                Category = _category is null ? null : Kinds.FirstOrDefault()?.Value,
            };
        }
        else if (_editItem is { } item)
        {
            var (s, e) = (_start!(item), _end!(item));
            var entry = new SchedulerEntry(0, s, e < s ? s : e, _allDay?.Invoke(item) ?? false);
            _model = new SchedulerEditFields
            {
                Title = _title!(item)?.ToString(),
                StartDate = entry.FirstDay,
                StartTime = TimeOnly.FromDateTime(s),
                EndDate = entry.AllDay ? entry.LastDay : DateOnly.FromDateTime(entry.End),
                EndTime = TimeOnly.FromDateTime(entry.End),
                AllDay = entry.AllDay,
                Description = _description?.Invoke(item),
                Category = _category?.Invoke(item),
            };
        }
        else
        {
            _model = null;
        }

        _context = _model is null ? null : new EditContext(_model);
        _messages = _context is null ? null : new ValidationMessageStore(_context);
    }

    private RenderFragment EditDialog(string key, SchedulerEditFields? posted) => __builder =>
    {
        SyncEdit(key, posted);
        var isNew = key == NewKey;
        var name = SchedulerEditBinding.Prefix;
        <Dialog Open="true" OpenChanged="OnDialogChanged" QueryKey="@EditKey" Title="@(isNew ? TextDefaults.SchedulerNew : TextDefaults.SchedulerEdit)" Size="DialogSize.Md" CloseOnBackdrop="false">
            @if (_model is null || _context is null)
            {
                @* Not "gone" while the appointments are still coming. *@
                if (!_loading)
                {
                    <Alert Status="Status.Warning">@TextDefaults.SchedulerGone</Alert>
                }
            }
            else
            {
                <Form EditContext="_context" FormName="@(RendererInfo.IsInteractive ? null : SchedulerEditBinding.FormName)" OnSubmit="SubmitAsync" action="@(_refused is not null && !RendererInfo.IsInteractive ? EditHref(_refused) : null)">
                    <FormErrors />
                    <TextField @bind-Value="_model.Title" name="@($"{name}.Title")" Label="@TextDefaults.SchedulerTitleField" autofocus />
                    @* Each day beside its time, as one row (MUI's form). *@
                    <div class="ib-sched-when">
                        <DateField @bind-Value="_model.StartDate" name="@($"{name}.StartDate")" Label="@TextDefaults.SchedulerStartDate" />
                        <TimeField @bind-Value="_model.StartTime" name="@($"{name}.StartTime")" Label="@TextDefaults.SchedulerStartTime" Class="ib-sched-time-field" Step="TimeSpan.FromMinutes(15)" />
                    </div>
                    <div class="ib-sched-when">
                        <DateField @bind-Value="_model.EndDate" name="@($"{name}.EndDate")" Label="@TextDefaults.SchedulerEndDate" />
                        <TimeField @bind-Value="_model.EndTime" name="@($"{name}.EndTime")" Label="@TextDefaults.SchedulerEndTime" Class="ib-sched-time-field" Step="TimeSpan.FromMinutes(15)" />
                    </div>
                    @if (AllDay is not null)
                    {
                        <Switch @bind-Value="_model.AllDay" name="@($"{name}.AllDay")" Label="@TextDefaults.SchedulerAllDay" Class="ib-sched-allday-field" />
                    }
                    @if (_category is not null && Kinds.Count > 0)
                    {
                        @* The category sets the appointment's color, as MUI's form sets its resource. *@
                        <Select TValue="string" @bind-Value="_model.Category" name="@($"{name}.Category")" Label="@TextDefaults.SchedulerCategory"
                                Items="@Kinds.Select(c => c.Value)" ItemText="@CategoryTitle"
                                ItemTemplate="CategoryOption" />
                    }
                    @if (Description is not null)
                    {
                        <TextArea @bind-Value="_model.Description" name="@($"{name}.Description")" Label="@TextDefaults.SchedulerDescription" />
                    }
                    <DialogFooter>
                        @if (!isNew && OnDelete.HasDelegate && _editItem is not null)
                        {
                            @* Asks first: the footer has no Cancel beside it to pause on. *@
                            <ConfirmButton Title="@TextDefaults.SchedulerDeleteTitle" Message="@_model.Title" ConfirmText="@TextDefaults.Delete"
                                           Accent="Accent.Danger" Variant="ButtonVariant.Ghost" Class="ib-sched-delete"
                                           OnConfirm="DeleteAsync" Name="@(RendererInfo.IsInteractive ? null : $"{name}.Remove")" Value="@(RendererInfo.IsInteractive ? null : "true")" formnovalidate>@TextDefaults.Delete</ConfirmButton>
                        }
                        <Button Submit>@TextDefaults.Save</Button>
                    </DialogFooter>
                </Form>
            }
        </Dialog>
    };

    // A time that a narrow column wraps after its dash, never inside it ("11:30 / AM").
    private static string Whole(string time) => time.Replace(' ', ' ');

    private string CategoryTitle(string value) => Kinds.FirstOrDefault(c => c.Value == value) is { } c ? c.Label ?? c.Value : value;

    private string? CategoryColor(string value) => Kinds.FirstOrDefault(c => c.Value == value) is { } c ? ColorOf(c) : null;

    // A category in the form's list: its color beside its name.
    private RenderFragment<string> CategoryOption => value => @<span><span class="ib-sched-swatch" style="background:@CategoryColor(value)"></span>@CategoryTitle(value)</span>;

    private void OnDialogChanged(bool open)
    {
        if (!open) EndEdit();
    }

    private async Task SubmitAsync(EditContext context)
    {
        if (_model is null || _messages is null || _saving) return;
        _messages.Clear();
        if (_model.Remove)
        {
            await DeleteAsync();
            return;
        }

        if (!context.Validate()) return;
        if (!_model.AllDay && _model.End < _model.Start || _model.AllDay && _model.EndDate < _model.StartDate)
        {
            Error(TextDefaults.SchedulerEndBeforeStart);
            return;
        }

        if (_editFor != NewKey && _editItem is null)
        {
            Error(TextDefaults.SchedulerGone);
            return;
        }

        var fields = _model;
        var save = new SchedulerSave<TItem>(_editItem, _editFor == NewKey, fields, target =>
        {
            SchedulerMembers.Set(Start, target!, fields.Start);
            SchedulerMembers.Set(End, target!, fields.End);
            SchedulerMembers.Set(Title, target!, fields.Title);
            SchedulerMembers.Set(AllDay, target!, fields.AllDay);
            SchedulerMembers.Set(Description, target!, fields.Description);
            if (_category is not null && Kinds.Count > 0) SchedulerMembers.Set(Category, target!, fields.Category);
        }, Error);
        _saving = true;
        try
        {
            await OnSave.InvokeAsync(save);
        }
        finally
        {
            _saving = false;
        }

        if (!save.HasErrors) EndEdit();
    }

    private async Task DeleteAsync()
    {
        if (_editItem is not { } item || _saving) return;
        var delete = new SchedulerDelete<TItem>(item, Error);
        _saving = true;
        try
        {
            await OnDelete.InvokeAsync(delete);
        }
        finally
        {
            _saving = false;
        }

        if (!delete.HasErrors) EndEdit();
    }

    private void Error(string message)
    {
        _messages?.Add(new FieldIdentifier(_model!, ""), message);
        _context?.NotifyValidationStateChanged();
    }

    // Closes the form: the address without its keys (on a static page, the post's answer is a redirect there).
    private void EndEdit()
    {
        (_editFor, _editItem, _model, _context, _messages, _refused) = (null, default, null, null, null, null);
        _ending = true;
        Navigation.NavigateTo(ClosedHref);
    }

    private static string Iso(DateTime t) => t.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);

    // Google Calendar's letters: d, w, m and a for the views (x for the work week).
    private static string ShortcutOf(SchedulerView view) => view switch
    {
        SchedulerView.Day => "d",
        SchedulerView.Week => "w",
        SchedulerView.WorkWeek => "x",
        SchedulerView.Month => "m",
        _ => "a",
    };

    // ---- A drag's move, posted by the script (with no form shown). ----

    private readonly SchedulerMoveFields _move = new();

    private RenderFragment MoveForm => __builder =>
    {
        if (RendererInfo.IsInteractive)
        {
            @MoveFormFor(null)
        }
        else
        {
            <FormMappingScope Name="@($"ib-sched-move-{Prefix}")">
                @MoveBinding
            </FormMappingScope>
        }
    };

    private RenderFragment MoveBinding => builder =>
    {
        builder.OpenComponent<SchedulerMoveBinding>(0);
        builder.AddComponentParameter(1, nameof(SchedulerMoveBinding.ChildContent), (RenderFragment<SchedulerMoveFields?>)(posted => MoveFormFor(posted)));
        builder.CloseComponent();
    };

    private RenderFragment MoveFormFor(SchedulerMoveFields? posted) => __builder =>
    {
        var model = posted ?? _move;
        var name = SchedulerMoveBinding.Prefix;
        <EditForm Model="model" FormName="@(RendererInfo.IsInteractive ? null : SchedulerMoveBinding.FormName)" OnSubmit="MoveAsync" Enhance class="ib-sched-move" hidden>
            <input type="hidden" name="@($"{name}.Key")" @bind="model.Key" />
            <input type="hidden" name="@($"{name}.Start")" @bind="model.Start" />
            <input type="hidden" name="@($"{name}.End")" @bind="model.End" />
        </EditForm>
    };

    // A drop: the appointment at its new times, saved through OnSave like the form's. Refused, the
    // form opens with the new times and the message.
    private async Task MoveAsync(EditContext context)
    {
        var move = (SchedulerMoveFields)context.Model;
        _moveRefusal = null;
        // A move that isn't made (another still saving, gone, unreadable) draws the box back too.
        if (_saving || move.Key is not { } key || _items.FirstOrDefault(i => ItemKey!(i) == key) is not { } item)
        {
            _moves++;
            return;
        }

        if (!DateTime.TryParseExact(move.Start, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var start)
            || !DateTime.TryParseExact(move.End, "yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var end)
            || end < start)
        {
            _moves++;
            return;
        }

        var fields = new SchedulerEditFields
        {
            Title = _title!(item)?.ToString(),
            StartDate = DateOnly.FromDateTime(start),
            StartTime = TimeOnly.FromDateTime(start),
            EndDate = DateOnly.FromDateTime(end),
            EndTime = TimeOnly.FromDateTime(end),
            Description = _description?.Invoke(item),
            Category = _category?.Invoke(item),
        };
        var messages = new List<string>();
        var save = new SchedulerSave<TItem>(item, false, fields, target =>
        {
            SchedulerMembers.Set(Start, target!, fields.Start);
            SchedulerMembers.Set(End, target!, fields.End);
        }, messages.Add);
        _saving = true;
        try
        {
            await OnSave.InvokeAsync(save);
        }
        finally
        {
            _saving = false;
        }

        (_move.Key, _move.Start, _move.End) = (null, null, null);
        // The boxes' style changes with each move, so a box the script left where it was dropped is
        // drawn again where the server has it: refused at once, made once the new times have loaded
        // (sooner, a provider's load would draw it at its old time first).
        if (save.HasErrors && EditDialogForm is not null)
        {
            _moves++;
            _moveRefusal = messages;
            return;
        }

        if (save.HasErrors)
        {
            _moves++;
            // The form, open at the new times, says why.
            (_editFor, _editItem, _model) = (key, item, fields);
            _context = new EditContext(_model);
            _messages = new ValidationMessageStore(_context);
            foreach (var m in messages) _messages.Add(new FieldIdentifier(_model, ""), m);
            _refused = key;
            return;
        }

        if (!RendererInfo.IsInteractive)
        {
            Navigation.NavigateTo(Navigation.Uri);
            return;
        }

        await LoadAsync();
        _moves++;
    }

    // A move refused: its form shows though the address doesn't name it.
    private string? _refused;

    private int _moves;
}
