@namespace IzzyBlazor
@typeparam TItem
@inherits LayoutItemBase
@implements IDisposable
@implements ISchedulerToolbar
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.DependencyInjection

@*
    A calendar of appointments: a day, a week, the working week, a month or a list of the coming
    days. Drawn on the server, so it shows with no script and no circuit and prints; the view and
    the date are in the page's address, so its toolbar's arrows, Today and views are links, and
    Back goes to the page before. The period's title opens a month to go to any date.

    <Scheduler Items="bookings" Start="b => b.Start" End="b => b.End" Title="b => b.Room" />

    Only the days shown are read: an IQueryable (an EF Core query) is filtered by the database, and
    ItemsProvider is asked for them from anywhere else. On an interactive page, @bind-View and
    @bind-Date keep the view and date in the component instead of the address.

    ToolbarContent adds the page's own toolbar items, and places the toolbar's parts
    (SchedulerToday, SchedulerArrows, SchedulerPeriod, SchedulerCategories, SchedulerViews,
    SchedulerNew) among them. AppointmentTemplate draws each appointment's text, and
    DayHeaderTemplate adds to each day's header.

    Appointments a day long or more, and all-day ones (AllDay), are bars across their days;
    the rest are boxes in their day's column, side by side where they overlap. Times are shown as
    given, in the app's time zone; today and the now line are the server's clock.

    A box shows its title and Detail (such as where it is), not its times: the hours beside it say
    when, as in Outlook. ShowTime adds them. A month's day lists each appointment with its start.

    With Category and Categories, a SchedulerCategory for each kind, appointments take their
    category's color, and a Categories menu shows or hides each kind; with any hidden, its button
    is marked.

    <Scheduler Items="events" ... Category="e => e.Kind"
               Categories="@([new("work", "Work"), new("family", "Family")])" />

    Read-only (no OnSave or EditDialogForm), an appointment opens a card beside it: its whole time,
    Detail, category and Description. With a mouse, hovering any appointment shows its card too.
    With OnSave or an EditDialogForm, and ItemKey, appointments are links to a form in a dialog,
    the toolbar has a New button, and with script a click on empty time adds one there; with
    OnSave, a drag moves or resizes one. The form posts on a static page too, and OnSave saves it either way. An
    EditDialogForm puts a form of your own in the dialog instead, for what a use case needs.

    Accessibility:
    - It's a region named by Label ("Schedule"); the toolbar's links say where they go
      ("Previous week"), and the view menu is a radio group of links.
    - The period's title is a button, "November 2026, go to a date", that opens a month (a grid);
      its period is a polite live region. With no script, a date input and Go do the same.
    - Categories is named by how many are hidden too: "Categories, 2 of 4 hidden".
    - Each day's appointments come in time order, each with its category and whole time said:
      "Team meeting, Work, Monday, November 9, 2026, 9:30 AM to 10:30 AM". With a form each is a
      link to it; read-only, a button that opens its card (a dialog, which takes focus).
    - Today is marked with aria-current, not only by its color.
    - A hover's card is the mouse's alone: it stays while the pointer is on the appointment or the
      card, Escape closes it, and an editable one's card is hidden from screen readers (its link
      opens the form). A press opens a read-only one's card, which takes focus.
    - While a provider loads, the view is aria-busy; a failure is an alert with Retry, which puts
      focus on the view when the appointments come.
    - A DayHeaderTemplate's content is read, after its date.
    - A month's day numbers are links to their day ("Show Monday, November 9, 2026").
    - When the form closes or saves, focus goes back to its appointment, or to New.
    - A category's edge is the palette's color, a fifth darker in light mode, so it's 3:1 against a
      box, a month's row and the page; a Color of your own needs that contrast itself.
    - The form is the way to add, move and resize from the keyboard and with no script; a drag
      does nothing it can't.
    - The hour lines and the now line are hidden from screen readers.
    - Delete asks first.
    - The shortcuts are announced with aria-keyshortcuts; Shortcuts="false" turns them off.

    Keyboard:
    While focus is in the Scheduler, outside its menus and form (Google Calendar's letters)
    - T | Go to today
    - N, P | Go to the next or the previous day, week or month
    - D, W, X, M, A | Show the day, the week, the work week, the month or the agenda
    - C | Add an appointment (with a form)
    See also: Calendar, DateRangeField.
*@

<ib-scheduler @attributes="AdditionalAttributes" class="@_class" style="@_style" role="region" aria-label="@(Label ?? TextDefaults.SchedulerName)"
              data-ib-view-key="@ViewKey" data-ib-new="@(Editable ? EditHref(NewKey) : null)" data-ib-movable="@(Movable ? "" : null)" data-ib-start-key="@StartKey" data-ib-edit-key="@EditKey" data-ib-day-start="@DayStart">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/scheduler.css"]" />
    @{
        var culture = CultureInfo.CurrentCulture;
        var (view, date) = (CurrentView, CurrentDate);
        var (first, days) = SchedulerLayout.Range(view, date, FirstDay, AgendaDays);
        var last = first.AddDays(days - 1);
        var entries = Read(first, last);
        var today = DateOnly.FromDateTime(DateTime.Now);
        var period = PeriodOf(view).ToLower(culture);
        _cards = 0;
    }
    @* Outlook's order: Today, the arrows and the period (what they change) at the start; the
       categories, the view and New at the end. Each is a toolbar part the page can place among its
       own items in ToolbarContent; the rest keep these places. *@
    @{
        var placed = SchedulerToolbarItem.Placed(ToolbarContent);
    }
    <div class="ib-sched-bar">
        @* Around the toolbar, not inside it: its items keep the order they join in. *@
        <CascadingValue TValue="ISchedulerToolbar" Value="this">
            <Toolbar Label="@($"{Label ?? TextDefaults.SchedulerName}: {TextDefaults.GridToolbar}")" Wrap Size="ControlSize.Md" Gap="1">
                @if (!placed.Contains(typeof(SchedulerToday)))
                {
                    <SchedulerToday />
                }
                @if (!placed.Contains(typeof(SchedulerArrows)))
                {
                    <SchedulerArrows />
                }
                @if (!placed.Contains(typeof(SchedulerPeriod)))
                {
                    <SchedulerPeriod />
                }
                @ToolbarContent
                @if (!placed.Contains(typeof(SchedulerCategories)))
                {
                    <SchedulerCategories />
                }
                @if (!placed.Contains(typeof(SchedulerViews)))
                {
                    <SchedulerViews />
                }
                @if (!placed.Contains(typeof(SchedulerNew)))
                {
                    <SchedulerNew />
                }
            </Toolbar>
        </CascadingValue>
    </div>

    @if (_moveRefusal is { Count: > 0 } why)
    {
        <div class="ib-sched-error" role="alert">
            @foreach (var m in why)
            {
                <span>@m</span>
            }
        </div>
    }

    @if (_loadError is not null)
    {
        @* What was shown stays out: an empty view under the message. Retry asks again. *@
        <div class="ib-sched-error" role="alert">
            @if (ErrorContent is not null)
            {
                @ErrorContent
            }
            else
            {
                <span>@TextDefaults.SchedulerLoadFailed</span>
            }
            @if (RendererInfo.IsInteractive)
            {
                <button type="button" class="ib-btn ib-btn-neutral ib-btn-outline" @onclick="RetryAsync">@TextDefaults.Retry</button>
            }
            else
            {
                <a class="ib-btn ib-btn-neutral ib-btn-outline" href="@(new Uri(Navigation.Uri).PathAndQuery)">@TextDefaults.Retry</a>
            }
        </div>
    }

    @switch (view)
    {
        case SchedulerView.Month:
            @Month(entries, first, date, today, culture)
            break;
        case SchedulerView.Agenda:
            @Agenda(entries, first, days, today, culture)
            break;
        default:
            @Columns(entries, first, days, today, culture)
            break;
    }
    @Editor
    @if (Movable)
    {
        @MoveForm
    }
</ib-scheduler>

@code {
    /// <summary>
    /// The appointments. A list is read in memory; an <c>IQueryable</c> (such as an EF Core query)
    /// is filtered by the database to the days shown. For other sources, use
    /// <see cref="ItemsProvider"/>.
    /// </summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Loads the appointments for the days shown yourself, in place of <see cref="Items"/>, from a
    /// web API or a cache: the request has the range, the view and the hidden categories. Asked
    /// for each page drawn. An exception it throws shows "Couldn't load the appointments." with
    /// Retry (and is logged); a request that was canceled is ignored. While it loads on an
    /// interactive page, the appointments shown stay, and the Scheduler is aria-busy.
    /// </summary>
    [Parameter] public Func<SchedulerRequest, ValueTask<IEnumerable<TItem>>>? ItemsProvider { get; set; }

    /// <summary>When each appointment starts, such as <c>b =&gt; b.Start</c>.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, DateTime>> Start { get; set; } = default!;

    /// <summary>When each appointment ends, such as <c>b =&gt; b.End</c>. An end at midnight is the end of the day before.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, DateTime>> End { get; set; } = default!;

    /// <summary>Each appointment's title, such as <c>b =&gt; b.Subject</c>.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Title { get; set; } = default!;

    /// <summary>
    /// A line of detail with each appointment's title, such as <c>b =&gt; b.Location</c>: under it
    /// in the day and week views' taller boxes, after it in a short one, in the agenda and the card.
    /// Shown only: the form has no field for it, so it can be worked out from other values.
    /// </summary>
    [Parameter] public Func<TItem, string?>? Detail { get; set; }

    /// <summary>
    /// The page's own controls in the toolbar: <c>ToolbarButton</c>, <c>ToolbarMenu</c> and the
    /// like, at the start after the period, or at the end with <c>Position</c>. Write
    /// <see cref="SchedulerToday"/>, <see cref="SchedulerArrows"/>, <see cref="SchedulerPeriod"/>,
    /// <see cref="SchedulerCategories"/>, <see cref="SchedulerViews"/> or
    /// <see cref="SchedulerNew"/> here to place the Scheduler's own among them; the rest keep
    /// their places. The Scheduler reads this once more on each render, to see which parts are here.
    /// </summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <summary>Shown in place of "Couldn't load the appointments." when loading fails, before the Retry button.</summary>
    [Parameter] public RenderFragment? ErrorContent { get; set; }

    /// <summary>
    /// Draws each appointment's text yourself, in place of its title and <see cref="Detail"/>: an
    /// icon for a recurring one, a status, an avatar. The context has the item, the view, and
    /// whether there's one line (a short box, a bar or a month's row) or room to wrap. It's drawn
    /// inside the appointment's link or button, so no buttons or links of its own; screen readers
    /// still hear the appointment's title, detail, category and time, so say in <see cref="Detail"/>
    /// what matters. The month's start time and the agenda's times stay.
    /// </summary>
    [Parameter] public RenderFragment<SchedulerAppointmentContext<TItem>>? AppointmentTemplate { get; set; }

    /// <summary>
    /// Adds to each day's header, after its date: the weather, who's away, a holiday. In the day
    /// and week views' headers, each month day's top row and beside each agenda date. Read by
    /// screen readers, and it may hold links or buttons.
    /// </summary>
    [Parameter] public RenderFragment<DateOnly>? DayHeaderTemplate { get; set; }

    /// <summary>
    /// Shows each appointment's times in its box in the day and week views. Off by default: the
    /// hours beside it say when (Outlook's way), and screen readers hear the whole time either way.
    /// </summary>
    [Parameter] public bool ShowTime { get; set; }

    /// <summary>Whether an appointment is all day, such as <c>b =&gt; b.AllDay</c>: a bar over its days, with no times. Appointments a day long or more are bars too.</summary>
    [Parameter] public Expression<Func<TItem, bool>>? AllDay { get; set; }

    /// <summary>Each appointment's color, a CSS color such as <c>var(--ib-color-danger)</c>. Defaults to the palette's first color.</summary>
    [Parameter] public Func<TItem, string?>? Color { get; set; }

    /// <summary>
    /// The view it opens on: <see cref="SchedulerView.Week"/> by default. The reader's choice is in
    /// the page's address, and wins. Bound (<c>@bind-View</c>) on an interactive page, it's the
    /// view shown, kept in the component instead of the address.
    /// </summary>
    [Parameter] public SchedulerView View { get; set; } = SchedulerView.Week;

    /// <summary>Raised when the reader chooses a view, on interactive pages: binding it (<c>@bind-View</c>) keeps the view in the component.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<SchedulerView> ViewChanged { get; set; }

    /// <summary>The views in its menu, in order. All five by default.</summary>
    [Parameter] public IReadOnlyList<SchedulerView>? ViewOptions { get; set; }

    /// <summary>
    /// The day it opens on: today by default. The reader's page is in the page's address, and wins.
    /// Bound (<c>@bind-Date</c>) on an interactive page, it's the day shown, kept in the component
    /// instead of the address.
    /// </summary>
    [Parameter] public DateOnly? Date { get; set; }

    /// <summary>Raised when the reader goes to another day, week or month, on interactive pages: binding it (<c>@bind-Date</c>) keeps the date in the component.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<DateOnly?> DateChanged { get; set; }

    // Bound on an interactive page: the component, not the address, holds the view or the date.
    private bool ViewBound => RendererInfo.IsInteractive && ViewChanged.HasDelegate;

    private bool DateBound => RendererInfo.IsInteractive && DateChanged.HasDelegate;

    private bool Bound => ViewBound || DateBound;

    // Goes to a view and day when either is bound: the events for the bound ones, the address for
    // the rest. Unbound, the links go there themselves.
    private async Task GoAsync(SchedulerView view, DateOnly date)
    {
        if (!Bound) return;
        var (wasView, wasDate) = (CurrentView, CurrentDate);
        if (ViewBound && view != wasView) await ViewChanged.InvokeAsync(view);
        if (DateBound && date != wasDate) await DateChanged.InvokeAsync(date);
        if ((!ViewBound && view != wasView) || (!DateBound && date != wasDate)) Navigation.NavigateTo(Href(view, date));
    }

    /// <summary>
    /// Prefix for its keys in the page's address, so several can share a page:
    /// <c>QueryPrefix="rooms-"</c> uses <c>?rooms-view=month&amp;rooms-date=2026-11-09</c>.
    /// None by default (<c>?view=…&amp;date=…</c>).
    /// </summary>
    [Parameter] public string QueryPrefix { get; set; } = "";

    /// <summary>The keyboard shortcuts (T, N, P, the views' letters and C) while focus is in it. On by default.</summary>
    [Parameter] public bool Shortcuts { get; set; } = true;

    /// <summary>The week's first day: the culture's by default.</summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }

    /// <summary>How many days the agenda lists. 7 by default.</summary>
    [Parameter] public int AgendaDays { get; set; } = 7;

    /// <summary>How many appointments a month's day shows before "+N more". 3 by default.</summary>
    [Parameter] public int MonthLimit { get; set; } = 3;

    /// <summary>The hour the day and week views open scrolled to (with script). 8 by default.</summary>
    [Parameter] public int DayStart { get; set; } = 8;

    /// <summary>The height of the day and week views' hours, which scroll inside it. 40rem by default.</summary>
    [Parameter] public Length? Height { get; set; }

    /// <summary>Its name for screen readers. "Schedule" by default.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Each appointment's category, such as <c>b =&gt; b.Kind</c>, matched to a
    /// <see cref="SchedulerCategory"/>'s <c>Value</c>: its color, the Categories menu that shows
    /// or hides it, and a choice in the edit form, which sets it.
    /// </summary>
    [Parameter] public Expression<Func<TItem, string?>>? Category { get; set; }

    /// <summary>
    /// The kinds of appointment, in the order of the Categories menu: written out, or made from
    /// your own data, such as <c>kinds.Select(k =&gt; new SchedulerCategory(k.Id, k.Name))</c>.
    /// </summary>
    [Parameter] public IReadOnlyList<SchedulerCategory>? Categories { get; set; }

    private IReadOnlyList<SchedulerCategory> Kinds => Categories ?? [];

    // A category's color: its own, or the palette's in the order they're listed.
    private string ColorOf(SchedulerCategory category)
    {
        var at = 0;
        while (at < Kinds.Count && !ReferenceEquals(Kinds[at], category)) at++;
        return category.Color ?? $"var(--ib-chart-{at % 8 + 1})";
    }

    private string HideKey => Prefix + "hide";

    // The categories hidden, from the address.
    // Each in a key of its own (?hide=work&hide=family), so a value may hold a comma.
    private HashSet<string> Hidden =>
        QueryString.Of(Navigation.Uri).TryGetValue(HideKey, out var values) ? values.Where(v => !string.IsNullOrEmpty(v)).Select(v => v!).ToHashSet() : [];

    // This page with a category shown or hidden.
    private string ToggleHref(string value)
    {
        var hidden = Hidden;
        if (!hidden.Remove(value)) hidden.Add(value);
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [HideKey] = hidden.Count == 0 ? null : Kinds.Select(c => c.Value).Where(hidden.Contains).ToArray(),
            [EditKey] = null,
            [StartKey] = null,
        }));
        return uri.AbsolutePath + uri.Query;
    }

    /// <summary>
    /// Each appointment's key, such as <c>b =&gt; b.Id.ToString()</c>: with <see cref="OnSave"/>, it
    /// names the appointment a link opens in the form (<c>?appointment=42</c>). With an
    /// <c>IQueryable</c> or an <see cref="ItemsProvider"/>, only the days shown are loaded, so a
    /// link of your own (in an email, say) names the appointment's day too, as the Scheduler's do:
    /// <c>?date=2026-11-17&amp;appointment=42</c>.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemKey { get; set; }

    /// <summary>Each appointment's description, such as <c>b =&gt; b.Notes</c>: a field in the form.</summary>
    [Parameter] public Expression<Func<TItem, string?>>? Description { get; set; }

    /// <summary>
    /// Saves an appointment from the form, new or changed, on a static page too (the form posts):
    /// with it and <see cref="ItemKey"/>, appointments are links that open the form, and the toolbar
    /// has a New button. <c>save.CopyTo(item)</c> sets the mapped properties; <c>save.AddError</c>
    /// keeps the form open with a message.
    /// </summary>
    [Parameter, ModeSupport] public EventCallback<SchedulerSave<TItem>> OnSave { get; set; }

    /// <summary>
    /// Your own form in the edit dialog, in place of the generated one, for what a use case needs:
    /// a patient and a reason, a room's attendees, what to show beside the fields. The Scheduler
    /// opens the dialog as before (an appointment, New, a click on empty time) and closes it; the
    /// form, its model and its <c>[SupplyParameterFromForm]</c> are yours, and on a static page, so
    /// is guarding against forged fields, with a view model. The context has the appointment (none
    /// for a new one) and its times (the time clicked for a new one); call
    /// <c>context.CloseAsync()</c> when it has saved, and put <c>autofocus</c> on its first field.
    /// Needs <see cref="ItemKey"/>. Dragging to new times still saves through <see cref="OnSave"/>,
    /// and is off without it: a form with no times leaves OnSave out, so moving stays something
    /// a keyboard can do too. A drag OnSave refuses says why above the view.
    /// </summary>
    [Parameter] public RenderFragment<SchedulerEditFormContext<TItem>>? EditDialogForm { get; set; }

    /// <summary>Deletes an appointment: with it, the generated form has a Delete button. Not with an <see cref="EditDialogForm"/>, whose form deletes.</summary>
    [Parameter, ModeSupport] public EventCallback<SchedulerDelete<TItem>> OnDelete { get; set; }

    private bool Editable => (OnSave.HasDelegate || EditDialogForm is not null) && ItemKey is not null;

    // Dragging saves new times through OnSave, so it needs one.
    private bool Movable => OnSave.HasDelegate && ItemKey is not null;

    private string EditKey => Prefix + "appointment";

    private string StartKey => Prefix + "start";

    private const string NewKey = "new";

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private static readonly SchedulerView[] AllViews = [SchedulerView.Day, SchedulerView.Week, SchedulerView.WorkWeek, SchedulerView.Month, SchedulerView.Agenda];

    // The date in the title's calendar.
    private DateOnly _jump;

    // Interactive: a day chosen in the title's calendar (static pages go there by script).
    private async Task JumpTo()
    {
        if (_jump == CurrentDate) return;
        if (Bound) await GoAsync(CurrentView, _jump);
        else Navigation.NavigateTo(Href(CurrentView, _jump));
    }

    private Func<TItem, DateTime>? _start, _end;
    private Func<TItem, object?>? _title;
    private Func<TItem, bool>? _allDay;
    private Func<TItem, string?>? _description, _category;
    private Expression? _lastStart, _lastEnd, _lastTitle, _lastAllDay, _lastDescription, _lastCategory;
    private IReadOnlyList<TItem> _items = [];
    private string? _class;
    private string? _style;

    private IReadOnlyList<SchedulerView> Views => ViewOptions is { Count: > 0 } v ? v : AllViews;

    private DayOfWeek FirstDay => FirstDayOfWeek ?? CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek;

    private string Prefix => QueryPrefix ?? "";

    // A shortcut's letter, or nothing with Shortcuts off.
    private string? Key(string letter) => Shortcuts ? letter : null;

    private string ViewKey => Prefix + "view";

    private string DateKey => Prefix + "date";

    // The view and date: the address's, else the parameters'.
    private SchedulerView CurrentView
    {
        get
        {
            if (ViewBound) return Views.Contains(View) ? View : Views[0];
            var asked = Query(ViewKey);
            foreach (var v in Views) if (ViewValue(v) == asked) return v;
            return Views.Contains(View) ? View : Views[0];
        }
    }

    private DateOnly CurrentDate =>
        DateBound ? Clamp(Date ?? DateOnly.FromDateTime(DateTime.Now))
        : Query(DateKey) is { } d && DateOnly.TryParseExact(d, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)
            ? Clamp(parsed)
            : Date is { } date ? Clamp(date) : DateOnly.FromDateTime(DateTime.Now);

    // Weeks and months around a date at DateOnly's ends would run past them.
    private static DateOnly Clamp(DateOnly date) => date < new DateOnly(2, 1, 1) ? new DateOnly(2, 1, 1) : date > new DateOnly(9998, 12, 31) ? new DateOnly(9998, 12, 31) : date;

    private static string ViewValue(SchedulerView view) => view switch
    {
        SchedulerView.WorkWeek => "workweek",
        _ => view.ToString().ToLowerInvariant(),
    };

    // What one page of a view is, for "Previous week".
    private string PeriodOf(SchedulerView view) => view switch
    {
        SchedulerView.Day => TextDefaults.SchedulerDay,
        SchedulerView.Month => TextDefaults.SchedulerMonth,
        SchedulerView.Agenda => TextDefaults.SchedulerAgenda,
        _ => TextDefaults.SchedulerWeek,
    };

    private string ViewName(SchedulerView view) => view switch
    {
        SchedulerView.Day => TextDefaults.SchedulerDay,
        SchedulerView.WorkWeek => TextDefaults.SchedulerWorkWeek,
        SchedulerView.Month => TextDefaults.SchedulerMonth,
        SchedulerView.Agenda => TextDefaults.SchedulerAgenda,
        _ => TextDefaults.SchedulerWeek,
    };

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-sched");
        if (Height is { } h) styles.AddVar("sched-height", h.Css);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (RendererInfo.IsInteractive) Navigation.LocationChanged += Moved;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Start is null || End is null || Title is null)
        {
            throw new InvalidOperationException("Scheduler needs a Start, an End and a Title for each appointment, such as b => b.Start, b => b.End and b => b.Subject.");
        }

        if (!ReferenceEquals(Start, _lastStart)) (_lastStart, _start) = (Start, Start.Compile());
        if (!ReferenceEquals(End, _lastEnd)) (_lastEnd, _end) = (End, End.Compile());
        if (!ReferenceEquals(Title, _lastTitle)) (_lastTitle, _title) = (Title, Title.Compile());
        if (!ReferenceEquals(AllDay, _lastAllDay)) (_lastAllDay, _allDay) = (AllDay, AllDay?.Compile());
        if (!ReferenceEquals(Description, _lastDescription)) (_lastDescription, _description) = (Description, Description?.Compile());
        if (!ReferenceEquals(Category, _lastCategory)) (_lastCategory, _category) = (Category, Category?.Compile());
        if (Categories is { } kinds)
        {
            var values = new HashSet<string>();
            foreach (var k in kinds)
            {
                if (string.IsNullOrWhiteSpace(k.Value)) throw new InvalidOperationException("A SchedulerCategory needs a Value, what an appointment's Category gives for it, such as \"work\".");
                if (!values.Add(k.Value)) throw new InvalidOperationException($"Two SchedulerCategories have the Value \"{k.Value}\"; each needs its own.");
            }
        }

        if (EditDialogForm is not null && OnDelete.HasDelegate)
        {
            throw new InvalidOperationException("A Scheduler with an EditDialogForm deletes in that form, so OnDelete (the generated form's Delete button) has nothing to do; leave it out.");
        }

        if (EditDialogForm is not null && ItemKey is null)
        {
            throw new InvalidOperationException("A Scheduler with an EditDialogForm needs an ItemKey, such as b => b.Id.ToString(), which names the appointment a link opens.");
        }

        if (OnSave.HasDelegate && ItemKey is null)
        {
            throw new InvalidOperationException("A Scheduler with OnSave needs an ItemKey, such as b => b.Id.ToString(), which names the appointment a link opens.");
        }

        if (OnSave.HasDelegate)
        {
            foreach (var (name, read) in new (string, LambdaExpression?)[] { ("Start", Start), ("End", End), ("Title", Title), ("AllDay", AllDay), ("Description", Description), ("Category", Category) })
            {
                if (read is not null && !SchedulerMembers.CanSet(read))
                {
                    throw new InvalidOperationException($"A Scheduler with OnSave saves {name} through its lambda, so it must read a settable property, such as b => b.{name}; \"{read}\" isn't one.");
                }
            }
        }
        if (Items is not null && ItemsProvider is not null)
        {
            throw new InvalidOperationException("A Scheduler takes Items or an ItemsProvider, not both.");
        }

        _jump = CurrentDate;
        base.OnParametersSet();
        (_class, _style) = BuildRootAttributes();
    }

    /// <inheritdoc />
    protected override Task OnParametersSetAsync() => LoadAsync(force: false);

    // Interactive: the address changed (a toolbar link, Back, or a save): load and draw the page it names.
    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        (_ending, _refused, _moveRefusal) = (false, null, null);
        _jump = CurrentDate;
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await LoadAsync();
            StateHasChanged();
        });
    }

    private bool _loading;
    private Exception? _loadError;
    private int _loadVersion;
    private CancellationTokenSource? _loadCts;
    private ILogger? _logger;

    private ILogger? Logger => _logger ??= Services.GetService<ILoggerFactory>()?.CreateLogger(GetType());

    [Inject] private IServiceProvider Services { get; set; } = default!;

    // What was last loaded: the range, the view, the hidden categories and the source.
    private object? _loadedKey;

    // The appointments for the days shown: a list as it is, an IQueryable filtered by the database,
    // or the provider's. A query or provider is asked again only when what it's asked for changes
    // (a parent's render alone doesn't), or when forced: a navigation, a save, a move, Retry. A
    // slower, older load never overwrites a newer one.
    private async Task LoadAsync(bool force = true)
    {
        var (first, days) = SchedulerLayout.Range(CurrentView, CurrentDate, FirstDay, AgendaDays);
        var from = first.ToDateTime(TimeOnly.MinValue);
        var to = first.AddDays(days).ToDateTime(TimeOnly.MinValue);
        IReadOnlyCollection<string> hidden = _category is null ? [] : Hidden;
        if (ItemsProvider is null && Items is not IQueryable<TItem>)
        {
            // A list costs nothing to read again, and may have changed in place.
            (_items, _loadError) = (Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [], null);
            return;
        }

        var key = (from, to, CurrentView, string.Join(",", hidden.Order(StringComparer.Ordinal)), (object?)ItemsProvider ?? Items);
        if (!force && _loadError is null && Equals(key, _loadedKey)) return;
        _loadedKey = key;
        if (ItemsProvider is null)
        {
            try
            {
                (_items, _loadError) = (SchedulerQuery.InRange((IQueryable<TItem>)Items!, Start, End, Category, from, to, hidden).ToList(), null);
            }
            catch (Exception ex)
            {
                Logger?.LogError(ex, "The Scheduler's appointments failed to load.");
                (_items, _loadError, _loadedKey) = ([], ex, null);
            }

            return;
        }

        var version = ++_loadVersion;
        _loadCts?.Cancel();
        var cts = _loadCts = new CancellationTokenSource();
        _loading = true;
        if (RendererInfo.IsInteractive) StateHasChanged();
        try
        {
            var items = await ItemsProvider(new SchedulerRequest(from, to, CurrentView, hidden, cts.Token));
            if (version != _loadVersion) return;
            (_items, _loadError) = (items as IReadOnlyList<TItem> ?? items.ToList(), null);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // A newer load, or the Scheduler went away.
        }
        catch (Exception ex)
        {
            if (version != _loadVersion) return;
            Logger?.LogError(ex, "The Scheduler's appointments failed to load.");
            (_items, _loadError, _loadedKey) = ([], ex, null);
        }
        finally
        {
            if (version == _loadVersion) _loading = false;
        }
    }

    // The view, which takes focus when Retry has brought the appointments (its button is gone).
    private ElementReference _view;
    private bool _focusView;

    private async Task RetryAsync()
    {
        await LoadAsync();
        _focusView = _loadError is null;
        StateHasChanged();
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusView) return;
        _focusView = false;
        await _view.FocusAsync();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Navigation.LocationChanged -= Moved;
        _loadCts?.Cancel();
    }

    // The appointments that touch the days shown.
    private List<SchedulerEntry> Read(DateOnly first, DateOnly last)
    {
        var from = first.ToDateTime(TimeOnly.MinValue);
        var to = last.AddDays(1).ToDateTime(TimeOnly.MinValue);
        var entries = new List<SchedulerEntry>();
        var hidden = _category is null ? null : Hidden;
        for (var i = 0; i < _items.Count; i++)
        {
            if (hidden is { Count: > 0 } && _category!(_items[i]) is { } c && hidden.Contains(c)) continue;
            var (s, e) = (_start!(_items[i]), _end!(_items[i]));
            if (e < s) e = s;
            var entry = new SchedulerEntry(i, s, e, _allDay?.Invoke(_items[i]) ?? false);
            if (entry.FirstDay <= last && entry.LastDay >= first && (s < to && (e > from || s >= from))) entries.Add(entry);
        }

        return entries;
    }

    private string? Query(string key)
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (Uri.UnescapeDataString(pair[0].Replace('+', ' ')) == key) return pair.Length > 1 ? Uri.UnescapeDataString(pair[1].Replace('+', ' ')) : "";
        }

        return null;
    }

    // This page at a view and date (null: today), from the site's root.
    private string Href(SchedulerView view, DateOnly? date)
    {
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [ViewKey] = ViewValue(view),
            [DateKey] = date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            [EditKey] = null,
            [StartKey] = null,
        }));
        return uri.AbsolutePath + uri.Query;
    }

    // This page with the form open: for an appointment, or a new one at a time.
    private string EditHref(string key, DateTime? start = null)
    {
        var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [EditKey] = key,
            [StartKey] = start?.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture),
        }));
        return uri.AbsolutePath + uri.Query;
    }

    private string NewHref(DateOnly day) => EditHref(NewKey, day.ToDateTime(new TimeOnly(Math.Clamp(DayStart, 0, 23), 0)));

    // This page with the form closed.
    private string ClosedHref
    {
        get
        {
            var uri = new Uri(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { [EditKey] = null, [StartKey] = null }));
            return uri.AbsolutePath + uri.Query;
        }
    }

    // "November 2026"; across two months "Oct – Nov 2026"; across two years "Dec 2026 – Jan 2027".
    private static string TitleOf(SchedulerView view, DateOnly date, DateOnly first, DateOnly last, CultureInfo culture)
    {
        if (view == SchedulerView.Month) return date.ToString("Y", culture);
        if (first.Month == last.Month && first.Year == last.Year) return first.ToString("Y", culture);
        return first.Year == last.Year
            ? $"{first.ToString("MMM", culture)} – {last.ToString("MMM yyyy", culture)}"
            : $"{first.ToString("MMM yyyy", culture)} – {last.ToString("MMM yyyy", culture)}";
    }

    private string TitleText(SchedulerEntry e) => _title!(_items[e.Index])?.ToString() ?? "";

    private string ColorStyle(SchedulerEntry e)
    {
        var item = _items[e.Index];
        var color = Color?.Invoke(item) is { Length: > 0 } own ? own
            : _category?.Invoke(item) is { } value && Kinds.FirstOrDefault(c => c.Value == value) is { } category ? ColorOf(category)
            : null;
        return color is null ? "" : $"--ib-sched-color:{color}";
    }

    private static string Time(DateTime t, CultureInfo culture) => t.ToString("t", culture);

    // An appointment's category name, when it has one: said with it, since its color can't be.
    private string? CategoryLabel(SchedulerEntry e) =>
        _category?.Invoke(_items[e.Index]) is { } value && Kinds.FirstOrDefault(c => c.Value == value) is { } c ? c.Label ?? c.Value : null;

    // What a screen reader hears for an appointment: its title, then its whole time.
    private string Said(SchedulerEntry e, CultureInfo culture) =>
        string.Join(", ", new[] { TitleText(e), DetailText(e), CategoryLabel(e), WhenOf(e, culture) }.Where(s => s is not null));

    // An appointment's whole time: "Monday, November 9, 2026, 9:30 AM to 10:30 AM".
    private string WhenOf(SchedulerEntry e, CultureInfo culture)
    {
        var day = (DateTime t) => t.ToString("D", culture);
        string when;
        if (e.AllDay || e.IsBar)
        {
            when = e.FirstDay == e.LastDay
                ? $"{day(e.Start)}, {TextDefaults.SchedulerAllDay}"
                : string.Format(culture, TextDefaults.SchedulerTimeRange, e.AllDay ? day(e.Start) : $"{day(e.Start)} {Time(e.Start, culture)}", e.AllDay ? e.LastDay.ToString("D", culture) : $"{day(e.End)} {Time(e.End, culture)}");
        }
        else
        {
            var end = e.End.Date == e.Start.Date ? Time(e.End, culture) : $"{day(e.End)} {Time(e.End, culture)}";
            when = $"{day(e.Start)}, {string.Format(culture, TextDefaults.SchedulerTimeRange, Time(e.Start, culture), end)}";
        }

        return when;
    }

    // A start for a month's day: "11 AM" on the hour where the culture's clock is twelve-hour
    // (Outlook's), "10:30 AM" off it; a 24-hour clock keeps its minutes ("11:00").
    private static string StartOf(DateTime t, CultureInfo culture)
    {
        var pattern = culture.DateTimeFormat.ShortTimePattern;
        return t.Minute == 0 && pattern.Contains('t') && pattern.Contains(":mm")
            ? Whole(t.ToString(pattern.Replace(":mm", ""), culture))
            : Whole(Time(t, culture));
    }

    private static string Pct(double v) => (v * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    // Across a day's column, leaving room at its end to click beside the appointments (Outlook's).
    private static string Across(double v) => $"calc((100% - var(--ib-sched-gap)) * {v.ToString("0.#####", CultureInfo.InvariantCulture)})";

    private string? DetailText(SchedulerEntry e) => Detail?.Invoke(_items[e.Index]) is { Length: > 0 } d ? d : null;

    // ---- Day, week and work week: a column of hours for each day. ----

    private RenderFragment Columns(List<SchedulerEntry> entries, DateOnly first, int days, DateOnly today, CultureInfo culture) => __builder =>
    {
        var bars = SchedulerLayout.Bars(entries, first, days);
        var boxes = SchedulerLayout.Boxes(entries, first, days);
        var lanes = bars.Count == 0 ? 0 : bars.Max(b => b.Lane) + 1;
        var now = DateTime.Now;
        <div class="ib-sched-cols" style="--ib-sched-days:@days" data-ib-day-start="@DayStart" tabindex="-1" aria-busy="@(_loading ? "true" : null)" @ref="_view">
            <div class="ib-sched-head" aria-hidden="@(DayHeaderTemplate is null ? "true" : null)">
                <span class="ib-sched-gutter" aria-hidden="true"></span>
                @for (var d = 0; d < days; d++)
                {
                    var day = first.AddDays(d);
                    <span class="@DayClass("ib-sched-day-head", day, today)">
                        <span class="ib-sched-num" aria-hidden="true">@day.Day</span>
                        <span class="ib-sched-dow" aria-hidden="true"><span class="ib-sched-dow-long">@day.ToString("dddd", culture)</span><span class="ib-sched-dow-short">@culture.DateTimeFormat.GetShortestDayName(day.DayOfWeek)</span></span>
                        @if (DayHeaderTemplate is not null)
                        {
                            @* What the template adds is read after its date (the columns below name theirs). *@
                            <span class="ib-visually-hidden">@day.ToString("D", culture)</span>
                        }
                        @DayExtra(day)
                    </span>
                }
            </div>
            <div class="ib-sched-allday" style="grid-template-rows:repeat(@Math.Max(1, lanes), var(--ib-sched-lane))">
                <span class="ib-sched-gutter" aria-hidden="true"></span>
                @for (var d = 0; d < days; d++)
                {
                    <span class="@DayClass("ib-sched-allday-cell", first.AddDays(d), today)" style="grid-column:@(d + 2)"></span>
                }
                @foreach (var bar in bars)
                {
                    var e = entries.First(x => x.Index == bar.Index);
                    @Appointment(e, BarClass(bar.StartsBefore, bar.EndsAfter), $"grid-column:{bar.FromDay + 2} / {bar.ToDay + 3};grid-row:{bar.Lane + 1};{ColorStyle(e)}", BarContent(e, bar.StartsBefore, culture), culture)
                }
            </div>
            @* With no links in it, the scroller itself takes focus, so the keys can scroll the hours. *@
            <div class="ib-sched-scroll" tabindex="@(Editable ? "-1" : "0")" role="@(Editable ? null : "group")" aria-label="@(Editable ? null : TextDefaults.SchedulerHours)">
                <div class="ib-sched-grid">
                    <div class="ib-sched-hours" aria-hidden="true">
                        @for (var h = 1; h < 24; h++)
                        {
                            <span style="top:@Pct(h / 24.0)">@StartOf(new DateTime(2000, 1, 1, h, 0, 0), culture)</span>
                        }
                    </div>
                    @for (var d = 0; d < days; d++)
                    {
                        var day = first.AddDays(d);
                        var own = boxes.Where(b => b.Day == d).OrderBy(b => b.Top).ThenBy(b => b.Left).ToList();
                        <div class="@DayClass("ib-sched-col", day, today)" role="group" aria-current="@(day == today ? "date" : null)" aria-label="@day.ToString("D", culture)" data-ib-day="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                            @if (day == today)
                            {
                                <span class="ib-sched-now" aria-hidden="true" style="top:@Pct((now - now.Date).TotalMinutes / 1440)"></span>
                            }
                            @foreach (var box in own)
                            {
                                var e = entries.First(x => x.Index == box.Index);
                                var isShort = box.Height < 45.0 / 1440;
                                var detail = DetailText(e);
                                var boxData = Editable
                                    ? new Dictionary<string, object?> { ["draggable"] = "false", ["data-ib-item"] = ItemKey!(_items[e.Index]), ["data-ib-start"] = Iso(e.Start), ["data-ib-end"] = Iso(e.End), ["data-ib-cut"] = box.StartsBefore || box.EndsAfter ? "" : null }
                                    : null;
                                RenderFragment boxContent = AppointmentTemplate is { } boxTemplate ? @<text>
                                    <span aria-hidden="true" class="ib-sched-own">@boxTemplate(new(_items[e.Index], CurrentView, isShort))</span>
                                    <span class="ib-visually-hidden">@Said(e, culture)</span>
                                </text> : @<text>
                                    <span aria-hidden="true">
                                        <span class="ib-sched-name">@TitleText(e)</span>
                                        @if (detail is not null)
                                        {
                                            @(" ")<span class="ib-sched-detail">@detail</span>
                                        }
                                        @if (ShowTime)
                                        {
                                            @(" ")<span class="ib-sched-time">@(isShort ? Whole(Time(e.Start, culture)) : $"{Whole(Time(e.Start, culture))} – {Whole(Time(e.End, culture))}")</span>
                                        }
                                    </span>
                                    <span class="ib-visually-hidden">@Said(e, culture)</span>
                                </text>;
                                @Appointment(e, isShort ? "ib-sched-event ib-sched-short" : "ib-sched-event", $"top:{Pct(box.Top)};height:{Pct(box.Height)};inset-inline-start:{Across(box.Left)};width:{Across(box.Width)};--ib-sched-moves:{_moves};{ColorStyle(e)}", boxContent, culture, boxData)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };

    private static string DayClass(string name, DateOnly day, DateOnly today) =>
        name + (day == today ? " ib-sched-today" : "") + (day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? " ib-sched-weekend" : "");

    // A bar's title, centered; one that began before the days shown says when it began (Outlook's "‹ Nov 17").
    private RenderFragment BarContent(SchedulerEntry e, bool startsBefore, CultureInfo culture) => __builder =>
    {
        <span aria-hidden="true" class="ib-sched-bar-text">
            @if (startsBefore)
            {
                <span class="ib-sched-from"><Icon Purpose="IconPurpose.ChevronLeft" />@e.FirstDay.ToString("MMM d", culture)</span>
            }
            @if (AppointmentTemplate is { } template)
            {
                <span class="ib-sched-own">@template(new(_items[e.Index], CurrentView, true))</span>
            }
            else
            {
                <span class="ib-sched-name">@TitleText(e)</span>
            }
        </span>
        <span class="ib-visually-hidden">@Said(e, culture)</span>
    };

    private static string BarClass(bool before, bool after) =>
        "ib-sched-event ib-sched-bar-event" + (before ? " ib-sched-cont-start" : "") + (after ? " ib-sched-cont-end" : "");

    // ---- Month: six weeks of days, bars across them and each day's appointments. ----

    private RenderFragment Month(List<SchedulerEntry> entries, DateOnly first, DateOnly date, DateOnly today, CultureInfo culture) => __builder =>
    {
        <div class="ib-sched-month" tabindex="-1" aria-busy="@(_loading ? "true" : null)" @ref="_view">
            <div class="ib-sched-week ib-sched-dows" aria-hidden="true">
                @for (var d = 0; d < 7; d++)
                {
                    <span>@first.AddDays(d).ToString("ddd", culture)</span>
                }
            </div>
            @for (var w = 0; w < 6; w++)
            {
                var weekStart = first.AddDays(w * 7);
                var bars = SchedulerLayout.Bars(entries, weekStart, 7);
                var lanes = bars.Count == 0 ? 0 : bars.Max(b => b.Lane) + 1;
                <div class="ib-sched-week" style="@($"--ib-sched-lanes:{lanes};grid-template-rows:1.75rem {string.Concat(Enumerable.Repeat("var(--ib-sched-lane) ", lanes))}minmax(4.5rem, 1fr)")">
                    @for (var d = 0; d < 7; d++)
                    {
                        var day = weekStart.AddDays(d);
                        var timed = SchedulerLayout.OnDay(entries, day, withBars: false);
                        var barsHere = bars.Count(b => b.FromDay <= d && b.ToDay >= d);
                        var room = Math.Max(0, MonthLimit - barsHere);
                        var hidden = timed.Count > room ? timed.Count - Math.Max(0, room - 1) : 0;
                        var shown = hidden > 0 ? timed.Take(Math.Max(0, room - 1)) : timed;
                        var outside = day.Month != date.Month;
                        <div class="@(DayClass("ib-sched-cell", day, today) + (outside ? " ib-sched-outside" : ""))" style="grid-column:@(d + 1)" role="group" aria-current="@(day == today ? "date" : null)" aria-label="@day.ToString("D", culture)" data-ib-day="@day.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                            <div class="ib-sched-cell-head">
                                <a class="ib-sched-day-link" href="@Href(SchedulerView.Day, day)" @onclick="() => GoAsync(SchedulerView.Day, day)" @onclick:preventDefault="Bound" aria-label="@string.Format(culture, TextDefaults.SchedulerShowDay, day.ToString("D", culture))">@(day.Day == 1 ? day.ToString("MMMM d", culture) : day.Day.ToString(culture))</a>
                                @DayExtra(day)
                            </div>
                            <ul class="ib-sched-pills">
                                @foreach (var e in shown)
                                {
                                    <li>@Appointment(e, "ib-sched-event ib-sched-pill", ColorStyle(e), @<text>
                                        <span aria-hidden="true"><span class="ib-sched-time">@StartOf(e.Start, culture)</span>@(" ")@if (AppointmentTemplate is { } template)
                                        {
                                            <span class="ib-sched-own">@template(new(_items[e.Index], SchedulerView.Month, true))</span>
                                        }
                                        else
                                        {
                                            <span class="ib-sched-name">@TitleText(e)</span>
                                        }</span>
                                        <span class="ib-visually-hidden">@Said(e, culture)</span>
                                    </text>, culture)</li>
                                }
                                @if (hidden > 0)
                                {
                                    <li><a class="ib-sched-more" href="@Href(SchedulerView.Day, day)" @onclick="() => GoAsync(SchedulerView.Day, day)" @onclick:preventDefault="Bound">@string.Format(culture, TextDefaults.SchedulerMore, hidden)<span class="ib-visually-hidden">, @day.ToString("D", culture)</span></a></li>
                                }
                            </ul>
                        </div>
                    }
                    @foreach (var bar in bars)
                    {
                        var e = entries.First(x => x.Index == bar.Index);
                        @Appointment(e, BarClass(bar.StartsBefore, bar.EndsAfter), $"grid-column:{bar.FromDay + 1} / {bar.ToDay + 2};grid-row:{bar.Lane + 2};{ColorStyle(e)}", BarContent(e, bar.StartsBefore, culture), culture)
                    }
                </div>
            }
        </div>
    };

    // ---- Agenda: the coming days' appointments, by day. ----

    private RenderFragment Agenda(List<SchedulerEntry> entries, DateOnly first, int days, DateOnly today, CultureInfo culture) => __builder =>
    {
        var any = false;
        <ol class="ib-sched-agenda" tabindex="-1" aria-busy="@(_loading ? "true" : null)" @ref="_view">
            @for (var d = 0; d < days; d++)
            {
                var day = first.AddDays(d);
                var own = SchedulerLayout.OnDay(entries, day, withBars: true);
                if (own.Count == 0) continue;
                any = true;
                <li class="@DayClass("ib-sched-agenda-day", day, today)" aria-current="@(day == today ? "date" : null)">
                    <div class="ib-sched-agenda-head">
                        <a class="ib-sched-agenda-date" href="@Href(SchedulerView.Day, day)" @onclick="() => GoAsync(SchedulerView.Day, day)" @onclick:preventDefault="Bound" aria-label="@day.ToString("D", culture)">
                            <span class="ib-sched-num">@day.Day</span>
                            <span>@day.ToString("ddd, MMM", culture)</span>
                        </a>
                        @DayExtra(day)
                    </div>
                    <ul>
                        @foreach (var e in own)
                        {
                            <li>@Appointment(e, "ib-sched-event ib-sched-pill", ColorStyle(e), @<text>
                                <span class="ib-sched-time" aria-hidden="true">@(e.IsBar ? TextDefaults.SchedulerAllDay : $"{Time(e.Start, culture)} – {Time(e.End, culture)}")</span>
                                @if (AppointmentTemplate is { } template)
                                {
                                    <span class="ib-sched-own" aria-hidden="true">@template(new(_items[e.Index], SchedulerView.Agenda, false))</span>
                                }
                                else
                                {
                                    <span class="ib-sched-name" aria-hidden="true">@TitleText(e)</span>
                                    @if (DetailText(e) is { } detail)
                                    {
                                        <span class="ib-sched-detail" aria-hidden="true">@detail</span>
                                    }
                                }
                                <span class="ib-visually-hidden">@Said(e, culture)</span>
                            </text>, culture)</li>
                        }
                    </ul>
                </li>
            }
        </ol>
        @if (!any)
        {
            <p class="ib-sched-empty">@TextDefaults.SchedulerEmpty</p>
        }
    };

    // An appointment's link to its form.
    private string? LinkOf(SchedulerEntry e) => Editable ? EditHref(ItemKey!(_items[e.Index])) : null;

    // Ids for the read-only cards, counted from 0 each render (an appointment can show twice).
    private readonly string _cardPrefix = IdGenerator.Next("ib-sched");
    private int _cards;

    // An appointment, and a card about it beside it (Outlook's peek): with a form, a link to it
    // whose card shows on hover (the script); read-only, a button that opens the card, a popover
    // that works with no script, and on hover too.
    private RenderFragment Appointment(SchedulerEntry e, string cls, string style, RenderFragment content, CultureInfo culture, Dictionary<string, object?>? data = null) => __builder =>
    {
        var id = $"{_cardPrefix}-{_cards++}";
        var anchor = StyleValues.AnchorName(id);
        if (Editable)
        {
            @* Its key in every view, so focus can come back to it when its form closes. *@
            var attributes = data ?? new Dictionary<string, object?>();
            attributes["data-ib-item"] = ItemKey!(_items[e.Index]);
            <a class="@cls" href="@LinkOf(e)" style="@($"{style};anchor-name:{anchor}")" @attributes="attributes">@content</a>
        }
        else
        {
            <button type="button" class="@cls" style="@($"{style};anchor-name:{anchor}")" popovertarget="@id" aria-haspopup="dialog" aria-controls="@id">@content</button>
        }
        @* Editable, the card is a mouse's peek: screen readers hear the link's name, and the form it
           opens has the rest (the description too), so they aren't sent to it. *@
        <div popover id="@id" role="@(Editable ? null : "dialog")" tabindex="-1" aria-labelledby="@(Editable ? null : $"{id}-t")" aria-hidden="@(Editable ? "true" : null)" class="ib-pop ib-popover ib-place-bottom-start ib-sched-card" style="@($"position-anchor:{anchor};{ColorStyle(e)}")">
                <div class="ib-sched-card-head">
                    <span class="ib-sched-swatch" aria-hidden="true"></span>
                    <span class="ib-popover-title" id="@($"{id}-t")">@TitleText(e)</span>
                </div>
                <p>@WhenOf(e, culture)</p>
                @if (DetailText(e) is { } detail)
                {
                    <p>@detail</p>
                }
                @if (CategoryLabel(e) is { } kind)
                {
                    <p class="ib-sched-card-muted">@kind</p>
                }
                @if (_description?.Invoke(_items[e.Index]) is { Length: > 0 } notes)
                {
                    <p class="ib-sched-card-notes">@notes</p>
                }
        </div>
    };

