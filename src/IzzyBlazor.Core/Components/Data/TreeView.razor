@namespace IzzyBlazor
@typeparam TItem
@inherits StyledComponentBase
@inject NavigationManager Navigation
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, a tree you select from is a list of checkboxes or radio buttons in branches that open: no arrow keys, and checking a parent doesn't check its children. Children that load and the search box need it.")]

@*
    Items nested in items, from data: folders, categories, a company's teams. Items are the top
    level, and ItemChildren gives each item's own.

    <TreeView Items="roots" ItemChildren="f => f.Folders" ItemKey="f => f.Id" ItemText="f => f.Name"
              ItemHref="@(f => $"files?folder={f.Id}")" ItemCurrent="f => f.Id == folder" />

    Each item with children opens and closes, with no script. A branch starts open when it holds
    the current item (ItemCurrent), a selected one, or ItemExpanded says so, so a page arrives with
    its own place in the tree showing. With script, the branches a person opened stay open as they
    move between pages; on an interactive page @bind-Expanded follows them.

    With no template, ItemText, ItemDescription and ItemIcon draw an icon, the text and a muted
    second line; ChildContent draws each item instead. ItemHref makes items links. In a tree of
    links each item's arrow sits at its end, as in NavGroup, and an item that is a link and has
    children gets its own button to open them; other trees put the arrow first.

    SelectionMode makes a tree to choose from, as ListView's selection: Multiple gives each item a
    checkbox, Single selects one item. In a form the keys post under SelectionName; on an
    interactive page bind them with @bind-Selection:

    <TreeView Items="areas" ItemChildren="a => a.Children" ItemKey="a => a.Code" ItemText="a => a.Name"
              SelectionMode="SelectionMode.Multiple" @bind-Selection="granted" AriaLabel="Permissions" />

    Checking a parent checks its branch, and a parent with some of its branch checked shows a mixed
    box (Cascade="false" makes each box its own). The selection holds every checked key, parents
    included.

    For a large tree, ItemHasChildren and ChildrenProvider load a branch's children the first time
    it opens: on a static page the script fetches the page with the branch's key, so there's no
    endpoint to write (two such trees on a page need ids). Searchable adds a box that narrows the
    tree to matches and the branches that hold them.

    Accessibility:
    - It's nested lists (`ul` with `role="list"`), so screen readers say how many items each level
      has and how deep an item is. Put a tree of links for moving around the site in a `nav`, or
      name it with `AriaLabel`.
    - An item with children opens and closes with a `details` element: its summary is a button
      that says whether it's open. A link with children has a separate button after it, named by
      the item, so Tab reaches the link, then its button.
    - The current item (`ItemCurrent`) is marked `aria-current` ("page" on a link).
    - A disabled item (`ItemDisabled`) has no link, or its box is disabled, and it's dimmed; its
      children still open.
    - In a tree of links, Tab goes through the links and buttons in order. Arrow keys don't move
      through it: a list of links is read and reached as one.
    - With `SelectionMode` and script, it's an ARIA `tree` (give it an `AriaLabel`): one Tab stop,
      the arrow keys between items, and each item a `treeitem` that says whether it's open and
      whether it's checked (`aria-checked`, "mixed" for a part-checked parent) or selected. With
      JavaScript off it's a list of checkboxes or radio buttons in branches.

    Keyboard:
    - Up, Down | Move to the item above or below
    - Right | Open an item's branch, or move to its first child
    - Left | Close an item's branch, or move to its parent
    - Home, End | Move to the first or last item
    - * | Open every branch beside the focused item
    - Space | Check or uncheck the item, or select it; one that can't be, open or close its branch
    - Enter | Select the item; with checkboxes, check or uncheck it; one that can't be, open or close its branch
    - A letter | Move to the next item starting with it
    See also: NavGroup, ListView.
*@

<ib-tree @attributes="AdditionalAttributes" class="@_class" style="@_style"
         data-ib-select="@(Selects ? (Multiple ? "multiple" : "single") : null)"
         data-ib-cascade="@(Multiple && Cascade ? "" : null)"
         data-ib-label="@(Selects ? AriaLabel : null)"
         data-ib-interactive="@(RendererInfo.IsInteractive ? "" : null)"
         data-ib-tree-key="@(FetchesChildren ? TreeKey : null)"
         data-ib-no-matches="@(Searchable ? TextDefaults.NoMatches : null)"
         data-ib-field="@(Field is not null ? "" : null)"
         @onibtoggle="OnToggle">
    @if (_answer is not null)
    {
        @* A page-fetch for one branch's children: the script takes this list into the branch. *@
        <ul class="ib-tree-list ib-tree-group" role="list" data-ib-answered>
            @foreach (var node in _answer)
            {
                @NodeItem(node)
            }
        </ul>
    }
    else if (_roots.Count == 0)
    {
        <div class="ib-tree-empty">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                @(EmptyText ?? TextDefaults.NoItems)
            }
        </div>
    }
    else
    {
        @if (Searchable)
        {
            @* Narrows in the browser, with script; hidden until it's there. *@
            <div class="ib-field ib-field-sm ib-tree-search">
                <div class="ib-field-control">
                    <input type="search" class="ib-field-input" aria-label="@(SearchLabel ?? TextDefaults.Search)" placeholder="@(SearchLabel ?? TextDefaults.Search)" autocomplete="off" data-ib-tree-search />
                </div>
            </div>
            <div class="ib-visually-hidden" role="status" data-ib-tree-found></div>
        }
        <ul class="ib-tree-list" role="list" aria-label="@AriaLabel">
            @foreach (var node in _roots)
            {
                @NodeItem(node)
            }
        </ul>
    }
</ib-tree>

@code {
    private const int MaxDepth = 64;

    /// <summary>The items at the top of the tree.</summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>An item's children, or <see langword="null"/> or empty when it has none.</summary>
    [Parameter] public Func<TItem, IEnumerable<TItem>?>? ItemChildren { get; set; }

    /// <summary>
    /// A key that tells items apart, such as an id. Needed for selection, and for branches a person
    /// opened to stay open across pages; without it, each item's place is kept by the item itself.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemKey { get; set; }

    /// <summary>An item's content. Without it, <see cref="ItemText"/>, <see cref="ItemDescription"/> and <see cref="ItemIcon"/> draw it.</summary>
    [Parameter] public RenderFragment<TItem>? ChildContent { get; set; }

    /// <summary>An item's text, with no template. Defaults to the item's <c>ToString()</c>.</summary>
    [Parameter] public Func<TItem, string?>? ItemText { get; set; }

    /// <summary>A muted second line under an item's text, with no template.</summary>
    [Parameter] public Func<TItem, string?>? ItemDescription { get; set; }

    /// <summary>An icon before an item's text, with no template.</summary>
    [Parameter] public Func<TItem, IconData?>? ItemIcon { get; set; }

    /// <summary>
    /// Names an item for screen readers: the button that opens its children, and in a tree to
    /// choose from the item itself. Defaults to <see cref="ItemText"/>.
    /// </summary>
    [Parameter] public Func<TItem, string>? ItemLabel { get; set; }

    /// <summary>
    /// Makes an item a link to this address; <see langword="null"/> leaves it plain. Not with
    /// <see cref="SelectionMode"/>.
    /// </summary>
    [Parameter] public Func<TItem, string?>? ItemHref { get; set; }

    /// <summary>Marks the item the page is showing. Its branch starts open.</summary>
    [Parameter] public Func<TItem, bool>? ItemCurrent { get; set; }

    /// <summary>
    /// Says an item has children to load with <see cref="ChildrenProvider"/> when its branch first
    /// opens, for items whose <see cref="ItemChildren"/> is empty.
    /// </summary>
    [Parameter] public Func<TItem, bool>? ItemHasChildren { get; set; }

    /// <summary>
    /// Loads an item's children, given its key, the first time its branch opens: in the component on
    /// an interactive page, and on a static page by the script fetching the page with the key.
    /// Needs <see cref="ItemKey"/> and <see cref="ItemHasChildren"/>.
    /// </summary>
    [Parameter] public Func<string, CancellationToken, ValueTask<IEnumerable<TItem>>>? ChildrenProvider { get; set; }

    /// <summary>
    /// A search box above the tree that narrows it as you type: matches and their parents stay,
    /// their branches open. In the browser, over the items it has; with script.
    /// </summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>The search box's name and placeholder. Defaults to "Search" (<see cref="IzzyText.Search"/>).</summary>
    [Parameter] public string? SearchLabel { get; set; }

    /// <summary>Starts an item's children open.</summary>
    [Parameter] public Func<TItem, bool>? ItemExpanded { get; set; }

    /// <summary>Dims an item and takes away its link, or disables its box. Its children still open.</summary>
    [Parameter] public Func<TItem, bool>? ItemDisabled { get; set; }

    /// <summary>
    /// The keys of the items whose children are open, on an interactive page; bind it with
    /// <c>@bind-Expanded</c>. Branches that hold the current or a selected item, or that
    /// <see cref="ItemExpanded"/> opens, start open too.
    /// </summary>
    [Parameter] public IReadOnlyCollection<string>? Expanded { get; set; }

    /// <summary>Raised when a branch opens or closes, on an interactive page, with the open keys.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<IReadOnlyCollection<string>> ExpandedChanged { get; set; }

    /// <summary>
    /// <see cref="SelectionMode.Multiple"/> gives each item a checkbox; <see cref="SelectionMode.Single"/>
    /// selects one item. Needs <see cref="ItemKey"/>.
    /// </summary>
    [Parameter] public SelectionMode SelectionMode { get; set; }

    /// <summary>The selected items' keys. Bind it with <c>@bind-Selection</c>.</summary>
    [Parameter] public Selection? Selection { get; set; }

    /// <summary>Raised when the selection changes, on an interactive page.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<Selection> SelectionChanged { get; set; }

    /// <summary>
    /// The form name the selected keys post under, as <c>{name}.Keys</c>; read them with
    /// <c>[SupplyParameterFromForm(Name = "...")] Selection</c>. Defaults to <c>selected</c>.
    /// </summary>
    [Parameter] public string? SelectionName { get; set; }

    /// <summary>
    /// Whether an item can be selected; one that can't keeps its place, with its box disabled, and
    /// with script a click on it opens or closes its branch.
    /// </summary>
    [Parameter] public Func<TItem, bool>? ItemSelectable { get; set; }

    /// <summary>
    /// With checkboxes, checking a parent checks its branch, and a parent shows how much of its
    /// branch is checked. On by default; <see langword="false"/> makes each box its own.
    /// </summary>
    [Parameter] public bool Cascade { get; set; } = true;

    /// <summary>Names the tree for screen readers, when nothing around it does. A tree to choose from needs one.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>Shown when there are no items. Defaults to "No items" (<see cref="IzzyText.NoItems"/>).</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Content shown when there are no items, in place of <see cref="EmptyText"/>.</summary>
    [Parameter] public RenderFragment? EmptyContent { get; set; }

    private string? _class;
    private string? _style;
    private List<Node> _roots = [];
    private HashSet<string> _selected = [];
    private HashSet<string>? _expanded;
    private Selection _selection = IzzyBlazor.Selection.None;
    private List<Node>? _answer;
    private readonly Dictionary<string, List<TItem>> _loaded = [];
    private readonly HashSet<string> _failed = [];
    private readonly HashSet<string> _loading = [];

    // The tree's name in a page-fetch for children: its id, else "tree". Two trees on a page that
    // load children need ids.
    private string TreeKey => AdditionalAttributes?.TryGetValue("id", out var id) == true && id is string { Length: > 0 } s ? s : "tree";

    private bool Lazy => ChildrenProvider is not null && ItemHasChildren is not null;

    // On a static page the script fetches a branch's children; a page that will be interactive waits.
    private bool FetchesChildren => Lazy && !WillBeInteractive;

    private bool Links => ItemHref is not null;

    // A field around the tree (TreeSelect): its boxes post under the field's name.
    [CascadingParameter] private TreeField? Field { get; set; }

    private bool Selects => SelectionMode != SelectionMode.None;

    private bool Multiple => SelectionMode == SelectionMode.Multiple;

    private string KeysName => Field?.Name ?? $"{SelectionName ?? "selected"}.Keys";

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-tree");
        classes.Add("ib-tree-links", Links);
        classes.Add("ib-tree-selects", Selects);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Selects && ItemKey is null)
        {
            throw new InvalidOperationException("A TreeView with a SelectionMode needs an ItemKey.");
        }

        if (Selects && Links)
        {
            throw new InvalidOperationException("A TreeView's items can be links (ItemHref) or choices (SelectionMode), not both.");
        }

        (_class, _style) = BuildRootAttributes();
        _selection = Selection ?? IzzyBlazor.Selection.None;
        _selected = [.. _selection.Keys ?? []];
        if (Expanded is not null)
        {
            _expanded = [.. Expanded];
        }

        _roots = Build(Items, 1, false);

        // The boxes a checked parent checks are part of the selection, so a change starts from them.
        // Keys of items still to load (ChildrenProvider) stay selected.
        if (Multiple && Cascade)
        {
            var shown = Keys(_roots).ToHashSet();
            _selected = [.. Checked(_roots), .. Lazy ? _selected.Where(k => !shown.Contains(k)) : []];
        }
    }

    private static IEnumerable<string> Keys(List<Node> nodes) =>
        nodes.SelectMany(n => (n.Key is not null ? [n.Key] : Array.Empty<string>()).Concat(Keys(n.Children)));

    private static IEnumerable<string> Checked(List<Node> nodes) =>
        nodes.SelectMany(n => (n.Selected && n.Key is not null ? [n.Key] : Array.Empty<string>()).Concat(Checked(n.Children)));

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // A page-fetch asking this tree for one branch: render only that branch's children.
        _answer = null;
        if (FetchesChildren && IzzyRequest.SuggestionFor(Navigation, TreeKey, out var asked) is { Length: > 0 } parent && asked)
        {
            _answer = Build(await ChildrenProvider!(parent, CancellationToken.None), 2, false);
        }
    }

    // The tree as it renders: each item's children read once, which are checked, and which
    // branches start open.
    private List<Node> Build(IEnumerable<TItem>? items, int depth, bool parentChecked)
    {
        var nodes = new List<Node>();
        if (items is null)
        {
            return nodes;
        }

        if (depth > MaxDepth)
        {
            throw new InvalidOperationException(
                $"TreeView's items nest more than {MaxDepth} deep. Does ItemChildren return one of an item's ancestors?");
        }

        foreach (var item in items)
        {
            var key = ItemKey?.Invoke(item);
            var selected = key is not null && Selects
                           && (_selected.Contains(key) || (parentChecked && Multiple && Cascade && RendererInfo.IsInteractive));
            var children = ItemChildren is null ? [] : Build(ItemChildren(item), depth + 1, selected);
            var lazy = false;
            if (children.Count == 0 && key is not null && Lazy && ItemHasChildren!(item))
            {
                if (_loaded.TryGetValue(key, out var loaded))
                {
                    children = Build(loaded, depth + 1, selected);
                }
                else
                {
                    lazy = true;
                }
            }

            // A checked parent says its branch is checked: it doesn't open to show it.
            var holds = children.Exists(c => c.Current || c.Holds || (c.Selected && !(selected && Cascade)));
            var mixed = Multiple && Cascade && !selected && children.Exists(c => c.Selected || c.Mixed);
            var open = (children.Count > 0 || lazy)
                       && (holds || ItemExpanded?.Invoke(item) == true || (key is not null && _expanded?.Contains(key) == true));
            nodes.Add(new Node(item, key, children, ItemCurrent?.Invoke(item) == true, selected, holds, open, lazy) { Mixed = mixed });
        }

        return nodes;
    }

    private string TextOf(TItem item) => ItemText?.Invoke(item) ?? item?.ToString() ?? "";

    private string LabelOf(TItem item) => ItemLabel?.Invoke(item) ?? TextOf(item);

    private object? KeyOf(Node node) => node.Key ?? (object?)node.Item;

    private RenderFragment NodeItem(Node node) => __builder =>
    {
        var item = node.Item;
        var disabled = ItemDisabled?.Invoke(item) == true;
        var href = disabled ? null : ItemHref?.Invoke(item);
        @* data-ib-state: the box's state as C# has it, so the script can redraw a parent's mixed
           box and the item's ARIA state when the selection changes from code. (Not data-ib-checked,
           which a Menu's script turns into aria-checked inside a popover.) data-ib-label-only: an
           item that can't be chosen, a label for its branch. *@
        <li class="ib-tree-li" @key="KeyOf(node)" data-ib-key="@node.Key" data-ib-lazy="@(node.Lazy ? "" : null)"
            data-ib-state="@(Selects ? (node.Selected ? "on" : node.Mixed ? "mixed" : "off") : null)"
            data-ib-label-only="@(Selects && ItemSelectable?.Invoke(node.Item) == false ? "" : null)">
            @if (!node.HasChildren)
            {
                @Row(node, href, disabled, toggle: false)
            }
            else if (href is not null || Selects)
            {
                @* A link or a box with children: the item, then its own button to open them, at its
                   end beside a link, at its start beside a box. *@
                @Row(node, href, disabled, toggle: false)
                <details class="ib-tree-branch" open="@node.Open">
                    <summary class="ib-tree-toggle">
                        <Icon Role="IconRole.ChevronRight" Class="ib-tree-chevron" />
                        <span class="ib-visually-hidden">@LabelOf(item)</span>
                    </summary>
                    @Group(node)
                </details>
            }
            else
            {
                <details class="ib-tree-branch" open="@node.Open">
                    @Row(node, null, disabled, toggle: true)
                    @Group(node)
                </details>
            }
        </li>
    };

    private RenderFragment Group(Node node) => __builder =>
    {
        if (node.Lazy)
        {
            @* Children still to load: while they come, or what went wrong (the script sets
               data-ib-failed on a static page). *@
            <div class="ib-tree-status" data-ib-failed="@(_failed.Contains(node.Key!) ? "" : null)">
                <span class="ib-tree-loading"><Spinner Size="IconSize.Sm" /><span aria-hidden="true">@TextDefaults.Loading</span></span>
                <span class="ib-tree-needs-script">@TextDefaults.TreeNeedsScript</span>
                <span class="ib-tree-failed">
                    @TextDefaults.ListLoadFailed
                    @if (RendererInfo.IsInteractive)
                    {
                        <Button Accent="Accent.Neutral" Variant="ButtonVariant.Outline" Size="ControlSize.Sm" OnClick="() => LoadAsync(node.Key!)">@TextDefaults.Retry</Button>
                    }
                    else
                    {
                        <Button Accent="Accent.Neutral" Variant="ButtonVariant.Outline" Size="ControlSize.Sm" data-ib-retry>@TextDefaults.Retry</Button>
                    }
                </span>
            </div>
            return;
        }

        <ul class="ib-tree-list ib-tree-group" role="list">
            @foreach (var child in node.Children)
            {
                @NodeItem(child)
            }
        </ul>
    };

    // An item's line: a link, the summary that opens its children, a box's label, or plain text.
    private RenderFragment Row(Node node, string? href, bool disabled, bool toggle) => __builder =>
    {
        var css = "ib-tree-item"
                  + (node.Current ? " ib-tree-current" : "")
                  + (disabled ? " ib-tree-disabled" : "")
                  + (node.HasChildren && href is not null ? " ib-tree-has-toggle" : "")
                  + (!node.HasChildren ? " ib-tree-leaf" : "");
        if (Selects)
        {
            var key = node.Key!;
            var locked = disabled || ItemSelectable?.Invoke(node.Item) == false;
            <label class="@css" aria-current="@(node.Current ? "true" : null)">
                <input @key="key" type="@(Multiple ? "checkbox" : "radio")" class="ib-check-input ib-tree-select" name="@KeysName" value="@key"
                       checked="@node.Selected" disabled="@locked" @onchange="e => OnSelectChanged(key, e)" />
                @Content(node.Item)
            </label>
            @if (locked && node.Selected && !RendererInfo.IsInteractive)
            {
                @* A disabled box doesn't post. In a field's single choice it's a radio of the group, so
                   choosing another item or clearing replaces it. *@
                <input type="@(Field is not null && !Multiple ? "radio" : "hidden")" name="@KeysName" value="@key" checked="@(Field is not null && !Multiple)" hidden="@(Field is not null && !Multiple)" />
            }
        }
        else if (toggle)
        {
            <summary class="@css" aria-current="@(node.Current ? "true" : null)">
                <Icon Role="IconRole.ChevronRight" Class="ib-tree-chevron" />
                @Content(node.Item)
            </summary>
        }
        else if (href is not null)
        {
            <a class="@css" href="@href" aria-current="@(node.Current ? "page" : null)">@Content(node.Item)</a>
        }
        else
        {
            <span class="@css" aria-current="@(node.Current ? "true" : null)">@Content(node.Item)</span>
        }
    };

    private RenderFragment Content(TItem item) => __builder =>
    {
        if (ChildContent is not null)
        {
            <span class="ib-tree-content" data-ib-label="@(Selects ? LabelOf(item) : null)">@ChildContent(item)</span>
            return;
        }

        var description = ItemDescription?.Invoke(item);
        @if (ItemIcon?.Invoke(item) is { } icon)
        {
            <Icon Name="icon" Class="ib-tree-icon" />
        }
        <span class="ib-tree-text" data-ib-label="@(Selects ? LabelOf(item) : null)">
            <span class="ib-tree-title">@TextOf(item)</span>
            @if (!string.IsNullOrEmpty(description))
            {
                <span class="ib-tree-description">@description</span>
            }
        </span>
    };

    // The script reports each box it changed, its own clicks and the branch it checks along with
    // them, so the keys follow the boxes.
    private async Task OnSelectChanged(string key, ChangeEventArgs e)
    {
        // A radio only reports being chosen.
        var on = !Multiple || e.Value is true;
        HashSet<string> keys = Multiple ? [.. _selected] : [];
        if (on)
        {
            keys.Add(key);
        }
        else
        {
            keys.Remove(key);
            // With cascade, a parent with a box unchecked isn't checked: drop the ancestors too, as
            // the script does. Their own change may come after this one, and until then a checked
            // parent would check this box again as the tree renders.
            if (Multiple && Cascade && PathTo(_roots, key) is { } path)
            {
                keys.ExceptWith(path);
            }
        }

        _selected = keys;
        _selection = IzzyBlazor.Selection.Of(keys);
        await SelectionChanged.InvokeAsync(_selection);
    }

    private async Task OnToggle(IzzyToggleEventArgs e)
    {
        // Only this tree's items: a Collapsible or Menu in a template reports its own.
        if (e.Id is null || Find(_roots, e.Id) is null)
        {
            return;
        }

        if (e.Open && Lazy && !_loaded.ContainsKey(e.Id) && Find(_roots, e.Id) is { Lazy: true })
        {
            await LoadAsync(e.Id);
        }

        _expanded ??= [.. OpenKeys(_roots)];
        if (!(e.Open ? _expanded.Add(e.Id) : _expanded.Remove(e.Id)))
        {
            return;
        }

        await ExpandedChanged.InvokeAsync([.. _expanded]);
    }

    // Interactive: a branch's children, the first time it opens, or again from Retry.
    private async Task LoadAsync(string key)
    {
        if (!_loading.Add(key))
        {
            return;
        }

        _failed.Remove(key);
        try
        {
            _loaded[key] = [.. await ChildrenProvider!(key, CancellationToken.None)];
        }
        catch (Exception) when (RendererInfo.IsInteractive)
        {
            _failed.Add(key);
        }
        finally
        {
            _loading.Remove(key);
        }

        _roots = Build(Items, 1, false);

        // A checked parent checks the children it loaded: they join the selection, as the script's
        // boxes do on a static page.
        if (Multiple && Cascade && _selected.Contains(key) && Find(_roots, key) is { } parent)
        {
            // Every one added, not just the first (Any would stop there).
            var added = Keys(parent.Children).Where(_selected.Add).ToList();
            if (added.Count > 0)
            {
                _selection = IzzyBlazor.Selection.Of(_selected);
                await SelectionChanged.InvokeAsync(_selection);
            }
        }
    }

    private static Node? Find(List<Node> nodes, string key)
    {
        foreach (var node in nodes)
        {
            if (node.Key == key)
            {
                return node;
            }

            if (Find(node.Children, key) is { } found)
            {
                return found;
            }
        }

        return null;
    }

    // The keys of an item's ancestors, from the top, or null when it isn't in the tree.
    private static List<string>? PathTo(List<Node> nodes, string key)
    {
        foreach (var node in nodes)
        {
            if (node.Key == key)
            {
                return [];
            }

            if (PathTo(node.Children, key) is { } below)
            {
                if (node.Key is not null)
                {
                    below.Insert(0, node.Key);
                }

                return below;
            }
        }

        return null;
    }

    private static IEnumerable<string> OpenKeys(List<Node> nodes) =>
        nodes.SelectMany(n => (n.Open && n.Key is not null ? [n.Key] : Array.Empty<string>()).Concat(OpenKeys(n.Children)));

    private sealed record Node(TItem Item, string? Key, List<Node> Children, bool Current, bool Selected, bool Holds, bool Open, bool Lazy)
    {
        public bool HasChildren => Children.Count > 0 || Lazy;

        public bool Mixed { get; init; }
    }
}
