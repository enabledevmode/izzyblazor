@namespace IzzyBlazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits PieChartBase<TItem>
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions

@*
    Parts of a whole as slices of a circle, or of a ring with Donut.

    <PieChart Items="plans"
              Argument="p => p.Plan"
              Value="p => p.Customers"
              Title="Customers by plan"
              Donut>
        <Center><strong>1,240</strong> customers</Center>
    </PieChart>

    The legend beside it (under it, when narrow) names each slice with its value and share.

    Slices go clockwise from the top (or StartAngle) in item order, in the palette's eight colors, then gray. Missing, zero and
    negative values get no slice but keep their row in the legend and the table. Past about six
    slices they get hard to tell apart: group the smallest as "Other", or use a Chart with bars.

    Accessibility:
    - The chart is a figure captioned by Title, or named by a heading on the page with TitledBy.
    - The circle is one image named by the caption.
    - The legend is text: each slice's name, value and share, read in order.
    - "Show data" under the chart opens a table of every value and share (DataTable).
    - With script, the circle is one Tab stop: the arrow keys move between slices and say each one.

    Keyboard:
    On the circle
    - Right, Down | Show the next slice's tooltip
    - Left, Up | Show the slice before
    - Home, End | Go to the first or last slice
    - Enter | Open the slice's level below (with ChartDrillLevels)
    - Escape | Hide the tooltip
    See also: Chart, Gauge.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@TitleClass">@Title</figcaption>
    }
    <CascadingValue Value="_drill" IsFixed="true">
        @ChildContent
    </CascadingValue>
    @{
        // Drill-down: the level in the address, its groups as the slices, their values added up.
        // Until the levels have registered (the first pass), a chart with no Argument draws nothing.
        var drilled = _drill.Levels.Count > 0 ? ChartDrill.At(Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [], _drill.Levels, Navigation, ChartDrill.KeyOf(Drill), AdditionalAttributes, TextDefaults) : null;
        IReadOnlyList<TItem> items;
        string[] names;
        double?[] values;
        if (drilled is not null)
        {
            items = drilled.Firsts;
            names = drilled.Arguments.Select(a => ChartLayout.ArgumentText(a, null, CultureInfo.CurrentCulture)).ToArray();
            values = drilled.Total(drilled.Rows.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray(), Aggregate);
        }
        else if (_argument is not null)
        {
            (items, names) = ReadItems();
            values = items.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray();
        }
        else
        {
            (items, names, values) = ([], [], []);
        }
        var total = values.Sum(v => v is > 0 ? v.Value : 0);
        var slices = ChartShapes.Pie(values, Donut ? ChartShapes.DonutHole : 0, StartTurn, 1, SweepTurn);
        var texts = values.Select(FormatValue).ToArray();
        var shares = values.Select(v => v is > 0 && total > 0 ? Share(v.Value / total) : null).ToArray();
        var outside = Labels is ChartLabels.Outside or ChartLabels.Auto;
        // Inside, a slice too thin for its share gets a label beside the circle instead.
        var thin = Labels == ChartLabels.Inside ? slices.Where(s => s.End - s.Start < InsideMin).ToList() : [];
        var beside = outside ? ChartShapes.PieLabels(slices, SizeInPixels, 20) : ChartShapes.PieLabels(thin, SizeInPixels, 20);
        var ringed = beside.Count > 0;
        var pieClass = ringed ? PieClass + " ib-pie-labeled" : PieClass;

        // A label's own words: its share, with the legend there to name it; its name and share without one.
        var named = Legend == ChartLegend.None;
        PieLabelContext<TItem> Context(int i, bool inside) => new(items[i], i, names[i], values[i], texts[i], shares[i], inside);

        // Room around the circle for the labels beside it: as wide as the widest (estimated; 8rem
        // for your own), past the leaders' reach.
        var widest = beside.Select(l => LabelTemplate is not null ? 128
            : TextWidths.AtSize(named ? $"{names[l.Index]} {shares[l.Index]}" : shares[l.Index] ?? "", 14)).DefaultIfEmpty(0).Max();
        var room = $"--ib-pie-room-x:{Num(Math.Ceiling(widest + SizeInPixels * 0.11 + 8))}px;--ib-pie-room-y:{Num(Math.Ceiling(SizeInPixels * 0.15 + 10))}px";
    }
    @if (drilled is { Depth: > 0 } && !HideBreadcrumb)
    {
        @ChartDrill.Crumbs(drilled, TextDefaults.ChartDrillTop, Title, TextDefaults)
    }
    <ib-chart data-ib-box="@BoxData" data-ib-refresh="@_refresh.Every" data-ib-refresh-from="@_refresh.From" style="@Palette?.Style(items.Count)"
              data-ib-drilled="@drilled?.Said" data-ib-drill="@drilled?.Key" data-ib-deeper="@(drilled?.Hrefs is not null ? "" : null)"
              data-ib-pie="@(Donut ? Num(ChartShapes.DonutHole) : "0")"
              data-ib-count="@items.Count"
              data-ib-draw="@(Legend != ChartLegend.None ? DrawData([values], [(Donut ? ChartShapes.DonutHole : 0, 1)], Labels switch { ChartLabels.None => 0, ChartLabels.Inside => 2, _ => 1 }) : null)"
              data-ib-pos="@string.Join(",", Enumerable.Range(0, items.Count).Select(i => slices.FirstOrDefault(s => s.Index == i) is { } s ? $"{Num(s.Start)} {Num(s.End)}" : ""))">
        @if (drilled is not null)
        {
            @ChartDrill.Links(drilled)
        }
        <div class="@pieClass">
            @* With labels beside it, the circle keeps room around it for them (chart.css); without,
               this wrapper has no box of its own. *@
            <div class="@(ringed ? "ib-pie-ring" : "ib-pie-unringed")" style="@(ringed ? room : null)">
            <div class="@PlotClass" style="@PlotStyle">
                <div class="ib-pie-frame" role="img" aria-labelledby="@NameId">
                    <svg class="ib-pie-svg" viewBox="@ViewBox">
                        @if (slices.Count == 0)
                        {
                            <path class="ib-pie-empty" d="@ChartShapes.Pie([1], Donut ? ChartShapes.DonutHole : 0, StartTurn, 1, SweepTurn)[0].Path" />
                        }
                        @foreach (var slice in slices)
                        {
                            <path class="@($"ib-pie-slice {Slot(slice.Index)}")" d="@slice.Path" data-ib-i="@slice.Index">@if (Tooltip)
                            {<title>@($"{names[slice.Index]}: {texts[slice.Index]} ({shares[slice.Index]})")</title>}</path>
                        }
                        @foreach (var label in beside)
                        {
                            <path class="ib-pie-leader" d="@label.Leader" data-ib-l="@label.Index" />
                        }
                    </svg>
                </div>
                @if (Labels == ChartLabels.Inside)
                {
                    @* Each share in its slice, where it fits; the legend names them. *@
                    <div class="ib-pie-inside" aria-hidden="true">
                        @foreach (var slice in slices.Where(s => s.End - s.Start >= InsideMin))
                        {
                            var (x, y) = ChartShapes.PieInside(slice, Donut ? ChartShapes.DonutHole : 0);
                            <span class="@Slot(slice.Index)" style="left:@(Left(x))%;top:@(Top(y))%" data-ib-in="@slice.Index">@if (LabelTemplate is not null)
                                {@LabelTemplate(Context(slice.Index, true))}
                                else
                                {<span data-ib-share="@slice.Index">@shares[slice.Index]</span>}</span>
                        }
                    </div>
                }
                @if (ringed)
                {
                    @* Each label by its slice, past the end of its line. *@
                    <div class="ib-pie-labels" aria-hidden="true">
                        @foreach (var label in beside)
                        {
                            <span class="@(label.End ? Slot(label.Index) : $"{Slot(label.Index)} ib-pie-label-start")" style="left:@(Left(label.X))%;top:@(Top(label.Y))%" data-ib-l="@label.Index">@if (LabelTemplate is not null)
                                {@LabelTemplate(Context(label.Index, false))}
                                else if (named)
                                {@names[label.Index] <span class="ib-pie-label-share" data-ib-share="@label.Index">@shares[label.Index]</span>}
                                else
                                {<span data-ib-share="@label.Index">@shares[label.Index]</span>}</span>
                        }
                    </div>
                }
                @if (Donut && Center is not null)
                {
                    <div class="@(CenterClass("ib-pie-center"))" style="@CenterStyle(0.22)"><div>@Center</div></div>
                }
                @if (Tooltip)
                {
                    <div class="ib-chart-tooltip" hidden></div>
                }
            </div>
            </div>
            @if (Legend != ChartLegend.None)
            {
                <ul class="@LegendListClass">
                    @for (var i = 0; i < items.Count; i++)
                    {
                        <li class="@Slot(i)">
                            @* With script, a button that hides and shows the slice. *@
                            <span class="ib-pie-toggle" data-ib-series="@i">
                                <span class="ib-pie-key" aria-hidden="true"></span>
                                <span class="ib-pie-name">@names[i]</span>
                                <span class="ib-pie-number">@texts[i]</span>
                                <span class="ib-pie-number ib-pie-share" data-ib-share="@i">@shares[i]</span>
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        @if (Tooltip)
        {
            <div class="ib-chart-tips" hidden>
                @for (var i = 0; i < items.Count; i++)
                {
                    <div data-ib-tip>
                        <div class="ib-chart-tooltip-title">@names[i]</div>
                        <div class="ib-chart-tooltip-row">
                            <span class="@($"ib-chart-tooltip-key {Slot(i)}")"></span>
                            <span>@(_valueName ?? Title ?? TextDefaults.ChartValue)</span>
                            <span class="ib-chart-tooltip-value">@texts[i]</span>
                        </div>
                        <div class="ib-chart-tooltip-row">
                            <span class="ib-chart-tooltip-key ib-pie-blank"></span>
                            <span>@TextDefaults.ChartShare</span>
                            <span class="ib-chart-tooltip-value" data-ib-share="@i">@shares[i]</span>
                        </div>
                        @if (drilled?.Hint is { } hint && drilled.Hrefs![i] is not null)
                        {
                            <div class="ib-chart-tooltip-hint">@hint</div>
                        }
                    </div>
                }
            </div>
            <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
            <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@TextDefaults.ChartKeys@(drilled?.Hrefs is not null ? " " + TextDefaults.ChartDrillKeys : null)</span>
        }
    </ib-chart>

    @if (DataTable != ChartDataTable.None)
    {
        <details class="ib-collapsible ib-disclosure ib-chart-data" open="@(DataTable == ChartDataTable.Visible)">
            <summary class="ib-collapsible-trigger" aria-labelledby="@(TitledBy is null ? null : $"{_labelId}-show {TitledBy}")">
                <Icon Purpose="IconPurpose.ChevronRight" Class="ib-collapsible-chevron" />
                <span id="@(_labelId)-show">@TextDefaults.ChartShowData@if (Title is not null)
                    {<span class="ib-visually-hidden">, @Title</span>}</span>
            </summary>
            <div class="ib-chart-table-scroll">
                <table class="ib-chart-table" aria-labelledby="@NameId">
                    <thead>
                        <tr>
                            <th scope="col">@(drilled?.LevelName ?? _argumentName ?? TextDefaults.ChartItem)</th>
                            <th scope="col">@(_valueName ?? Title ?? TextDefaults.ChartValue)</th>
                            <th scope="col">@TextDefaults.ChartShare</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < items.Count; i++)
                        {
                            <tr>
                                <th scope="row">@if (drilled?.Hrefs?[i] is { } href)
                                {<a href="@href" data-ib-drill="@i">@names[i]</a>}
                                else
                                {@names[i]}</th>
                                <td>@texts[i]</td>
                                <td>@shares[i]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
    @if (Download)
    {
        @* Download, across from the title (chart.css): last, so the title's neighbor rules
           (label + legend, label + rings) still meet. *@
        @ChartTools.Tools(TextDefaults)
    }
</figure>

@code {
    /// <summary>
    /// <see cref="ChartDrillLevel{TItem}"/>s, from the top, for slices that drill down: each level's
    /// groups are the slices (the level's argument in place of <see cref="PieChartBase{TItem}.Argument"/>),
    /// their values added up by <see cref="Aggregate"/>, and selecting one shows the next level.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>With drill-down levels: the page address's query value that holds the level ("drill" by default; give each chart that drills on a page its own).</summary>
    [Parameter] public string? Drill { get; set; }

    /// <summary>With drill-down levels: leaves out the breadcrumb above the chart.</summary>
    [Parameter] public bool HideBreadcrumb { get; set; }

    /// <summary>With drill-down levels, how each slice adds up its items' values: Sum by default, or Avg, Min, Max or Count.</summary>
    [Parameter] public DataAggregate Aggregate { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private ChartDrillLevels<TItem>? _drillLevels;

    private ChartDrillLevels<TItem> _drill => _drillLevels ??= new ChartDrillLevels<TItem>(StateHasChanged);

    private protected override bool Drills => ChildContent is not null;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (RendererInfo.IsInteractive) Navigation.LocationChanged += Moved;
    }

    // Interactive: the address changed (a drill link or Back): draw the level it names.
    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_drillLevels is { Levels.Count: > 0 }) _ = InvokeAsync(StateHasChanged);
    }

    private protected override void Disposing() => Navigation.LocationChanged -= Moved;

    /// <summary>Each slice's size, such as <c>p =&gt; p.Customers</c>: any number. The slices share the circle by their values.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Value { get; set; } = default!;

    /// <summary>Draws a ring with a hole in the middle, for <see cref="Center"/>.</summary>
    [Parameter] public bool Donut { get; set; }

    /// <summary>Content in a donut's hole, such as the total. Not drawn without <see cref="Donut"/>.</summary>
    [Parameter] public RenderFragment? Center { get; set; }

    /// <summary>
    /// Labels each slice on the chart. <see cref="ChartLabels.Outside"/> (or <see cref="ChartLabels.Auto"/>)
    /// writes each label just outside its slice, joined to it by a short line;
    /// <see cref="ChartLabels.Inside"/> writes each in its slice, and a slice too thin for it (under
    /// 6% of the circle) gets its label outside. A label is the slice's share, with the legend
    /// naming the slices, or its name and share with <c>Legend="ChartLegend.None"</c>;
    /// <see cref="LabelTemplate"/> writes your own. Under 30rem there's no room outside the circle,
    /// so the labels there are left out and the legend names the slices. None by default.
    /// </summary>
    [Parameter] public ChartLabels Labels { get; set; }

    /// <summary>
    /// Writes each label yourself, such as "English: 56%" or a value, from the slice's name, value
    /// and share (<see cref="PieLabelContext{TItem}"/>), in its slice or outside it. Room is kept
    /// for labels 8rem wide outside the circle.
    /// </summary>
    [Parameter] public RenderFragment<PieLabelContext<TItem>>? LabelTemplate { get; set; }

    // The smallest slice a share is written in (Labels Inside): 6% of the turn.
    private const double InsideMin = 0.06;

    private Expression<Func<TItem, object?>>? _lastValue;
    private Func<TItem, object?>? _value;
    private string? _valueName;

    private protected override string ComponentName => "PieChart";

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _drill.BeginPass();
        if (Value is null)
        {
            throw new InvalidOperationException("PieChart needs a Value, each slice's size, such as p => p.Customers.");
        }

        if (!ReferenceEquals(Value, _lastValue))
        {
            _lastValue = Value;
            _value = Value.Compile();
            _valueName = ChartMembers.Name(Value);
        }

        base.OnParametersSet();
    }
}
