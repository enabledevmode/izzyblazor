@namespace IzzyBlazor
@typeparam TItem
@inherits LayoutItemBase
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions

@*
    Parts of a whole as slices of a circle, or of a ring with Donut, drawn on the server. The
    legend beside it (under it, when narrow) names each slice with its value and share.

    <PieChart Items="plans" Argument="p => p.Plan" Value="p => p.Customers" Title="Customers by plan" Donut>
        <Center><strong>1,240</strong> customers</Center>
    </PieChart>

    Slices go clockwise from the top in item order, in the palette's eight colors, then gray. Missing, zero and
    negative values get no slice but keep their row in the legend and the table. Past about six
    slices they get hard to tell apart: group the smallest as "Other", or use a Chart with bars.

    Accessibility:
    - A figure captioned by Title (or named by a heading on the page, with TitledBy); the circle is
      one image named by it.
    - The legend is text: each slice's name, value and share, read in order.
    - "Show data" under the chart opens a table of every value and share (DataTable).
    - With script, the circle is one Tab stop: the arrow keys move between slices and say each one.
    See also: Chart, Gauge.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@(HideTitle ? "ib-visually-hidden" : TitleAlign switch { ChartAlign.Center => "ib-chart-label ib-chart-label-center", ChartAlign.End => "ib-chart-label ib-chart-label-end", _ => "ib-chart-label" })">@Title</figcaption>
    }
    @{
        var items = Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];
        var names = items.Select(i => ChartLayout.ArgumentText(_argument!(i), null, CultureInfo.CurrentCulture)).ToArray();
        var values = items.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray();
        var total = values.Sum(v => v is > 0 ? v.Value : 0);
        var slices = ChartShapes.Pie(values, Donut ? ChartShapes.DonutHole : 0);
        var texts = values.Select(v => v is { } x ? x.ToString(ValueFormat ?? "#,##0.##", CultureInfo.CurrentCulture) : null).ToArray();
        var shares = values.Select(v => v is > 0 && total > 0 ? Share(v.Value / total) : null).ToArray();
        var outside = Labels is ChartLabels.Outside or ChartLabels.Auto;
        // Inside, a slice too thin for its share gets a label beside the circle instead.
        var thin = Labels == ChartLabels.Inside ? slices.Where(s => s.End - s.Start < InsideMin).ToList() : [];
        var ringed = outside || thin.Count > 0;
        var beside = outside ? ChartShapes.PieLabels(slices, SizeInPixels, 20) : ChartShapes.PieLabels(thin, SizeInPixels, 20);
        // Labels beside the circle take the legend's place: the circle centers between them.
        var pieClass = outside && Legend == ChartLegend.Auto ? "ib-pie ib-pie-labeled" : outside ? PieClass + " ib-pie-labeled" : PieClass;
    }
    <ib-chart style="@Palette?.Style(items.Count)"
              data-ib-pie="@(Donut ? Num(ChartShapes.DonutHole) : "0")"
              data-ib-count="@items.Count"
              data-ib-pos="@string.Join(",", Enumerable.Range(0, items.Count).Select(i => slices.FirstOrDefault(s => s.Index == i) is { } s ? $"{Num(s.Start)} {Num(s.End)}" : ""))">
        <div class="@pieClass">
            @* With labels beside it, the circle sits between two columns of them, each slice's name
               and share joined to it by a line; the legend stands in when there's no room (chart.css).
               Without, this wrapper has no box of its own. *@
            <div class="@(ringed ? "ib-pie-ring" : "ib-pie-unringed")">
            @if (ringed)
            {
                <div class="ib-pie-labels ib-pie-labels-start" aria-hidden="true">
                    @foreach (var label in beside.Where(l => !l.End))
                    {
                        @PieLabelText(label, names, shares)
                    }
                </div>
            }
            <div class="ib-pie-plot">
                <div class="ib-pie-frame" role="img" aria-labelledby="@NameId">
                    <svg class="ib-pie-svg" viewBox="-1 -1 2 2">
                        @if (slices.Count == 0)
                        {
                            <path class="ib-pie-empty" d="@ChartShapes.Pie([1], Donut ? ChartShapes.DonutHole : 0)[0].Path" />
                        }
                        @foreach (var slice in slices)
                        {
                            <path class="@($"ib-pie-slice {Slot(slice.Index)}")" d="@slice.Path" data-ib-i="@slice.Index">@if (Tooltip)
                            {<title>@($"{names[slice.Index]}: {texts[slice.Index]} ({shares[slice.Index]})")</title>}</path>
                        }
                        @foreach (var label in beside)
                        {
                            <path class="ib-pie-leader" d="@label.Leader" />
                        }
                    </svg>
                </div>
                @if (Labels == ChartLabels.Inside)
                {
                    @* Each share in its slice, where it fits; the legend names them. *@
                    <div class="ib-pie-inside" aria-hidden="true">
                        @foreach (var slice in slices.Where(s => s.End - s.Start >= InsideMin))
                        {
                            var (x, y) = ChartShapes.PieInside(slice, Donut ? ChartShapes.DonutHole : 0);
                            <span class="@Slot(slice.Index)" style="left:@(Num(x * 100))%;top:@(Num(y * 100))%">@shares[slice.Index]</span>
                        }
                    </div>
                }
                @if (Donut && Center is not null)
                {
                    <div class="ib-pie-center">@Center</div>
                }
                @if (Tooltip)
                {
                    <div class="ib-chart-tooltip" hidden></div>
                }
            </div>
            @if (ringed)
            {
                <div class="ib-pie-labels" aria-hidden="true">
                    @foreach (var label in beside.Where(l => l.End))
                    {
                        @PieLabelText(label, names, shares)
                    }
                </div>
            }
            </div>
            @if (Legend != ChartLegend.None)
            {
                <ul class="@(outside && Legend == ChartLegend.Auto ? LegendListClass + " ib-pie-legend-narrow" : LegendListClass)">
                    @for (var i = 0; i < items.Count; i++)
                    {
                        <li class="@Slot(i)">
                            <span class="ib-pie-key" aria-hidden="true"></span>
                            <span class="ib-pie-name">@names[i]</span>
                            <span class="ib-pie-number">@texts[i]</span>
                            <span class="ib-pie-number ib-pie-share">@shares[i]</span>
                        </li>
                    }
                </ul>
            }
        </div>

        @if (Tooltip)
        {
            <div class="ib-chart-tips" hidden>
                @for (var i = 0; i < items.Count; i++)
                {
                    <div data-ib-tip>
                        <div class="ib-chart-tooltip-title">@names[i]</div>
                        <div class="ib-chart-tooltip-row">
                            <span class="@($"ib-chart-tooltip-key {Slot(i)}")"></span>
                            <span>@(_valueName ?? Title ?? TextDefaults.ChartValue)</span>
                            <span class="ib-chart-tooltip-value">@texts[i]</span>
                        </div>
                        <div class="ib-chart-tooltip-row">
                            <span class="ib-chart-tooltip-key ib-pie-blank"></span>
                            <span>@TextDefaults.ChartShare</span>
                            <span class="ib-chart-tooltip-value">@shares[i]</span>
                        </div>
                    </div>
                }
            </div>
            <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
            <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@TextDefaults.ChartKeys</span>
        }
    </ib-chart>

    @if (DataTable != ChartDataTable.None)
    {
        <details class="ib-collapsible ib-disclosure ib-chart-data" open="@(DataTable == ChartDataTable.Visible)">
            <summary class="ib-collapsible-trigger" aria-labelledby="@(TitledBy is null ? null : $"{_labelId}-show {TitledBy}")">
                <Icon Purpose="IconPurpose.ChevronRight" Class="ib-collapsible-chevron" />
                <span id="@(_labelId)-show">@TextDefaults.ChartShowData@if (Title is not null)
                    {<span class="ib-visually-hidden">, @Title</span>}</span>
            </summary>
            <div class="ib-chart-table-scroll">
                <table class="ib-chart-table" aria-labelledby="@NameId">
                    <thead>
                        <tr>
                            <th scope="col">@(_argumentName ?? TextDefaults.ChartItem)</th>
                            <th scope="col">@(_valueName ?? Title ?? TextDefaults.ChartValue)</th>
                            <th scope="col">@TextDefaults.ChartShare</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < items.Count; i++)
                        {
                            <tr>
                                <th scope="row">@names[i]</th>
                                <td>@texts[i]</td>
                                <td>@shares[i]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    }
</figure>

@code {
    /// <summary>The items, one slice each.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Each slice's name, such as <c>p =&gt; p.Plan</c>.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Argument { get; set; } = default!;

    /// <summary>Each slice's size, such as <c>p =&gt; p.Customers</c>: any number. The slices share the circle by their values.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Value { get; set; } = default!;

    /// <summary>
    /// The chart's title, such as "Customers by plan", shown above it as its caption. It also names the chart
    /// for screen readers. A chart needs a Title or <see cref="TitledBy"/>.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Hides the title, which still names the chart for screen readers.</summary>
    [Parameter] public bool HideTitle { get; set; }

    /// <summary>
    /// Where the title sits: at the start, over the chart's first label, by default (the left, in
    /// a left-to-right page); <see cref="ChartAlign.Center"/> or <see cref="ChartAlign.End"/>.
    /// </summary>
    [Parameter] public ChartAlign TitleAlign { get; set; }

    /// <summary>
    /// The id of a heading already on the page that titles the chart, such as a card's, in place of
    /// <see cref="Title"/>: the chart takes its name from it and shows no title of its own.
    /// </summary>
    [Parameter] public string? TitledBy { get; set; }

    /// <summary>Draws a ring with a hole in the middle, for <see cref="Center"/>.</summary>
    [Parameter] public bool Donut { get; set; }

    /// <summary>Content in a donut's hole, such as the total. Not drawn without <see cref="Donut"/>.</summary>
    [Parameter] public RenderFragment? Center { get; set; }

    /// <summary>
    /// The circle's largest size. Defaults to 16rem; it's smaller when its container is narrower.
    /// </summary>
    [Parameter] public Length? Size { get; set; }

    /// <summary>A .NET format string for the values, such as <c>C0</c> or <c>N0</c>.</summary>
    [Parameter] public string? ValueFormat { get; set; }

    /// <summary>
    /// Shows a tooltip with the slice's value and share under the pointer or keyboard focus, with
    /// script. Defaults to true.
    /// </summary>
    [Parameter] public bool Tooltip { get; set; } = true;

    /// <summary>
    /// The colors in order: <see cref="ChartPalette.Colors"/> (the theme's eight, the default),
    /// <see cref="ChartPalette.Shades"/> of one color for slices in an order,
    /// <see cref="ChartPalette.Diverging"/> for slices either side of a middle, or your own with
    /// <see cref="ChartPalette.Of"/>.
    /// </summary>
    [Parameter] public ChartPalette? Palette { get; set; }

    /// <summary>
    /// The legend: each slice's name, value and share. By default it's beside the circle, at the
    /// end side, when there's room (30rem) and under it otherwise; <see cref="ChartLegend.Start"/>
    /// puts it at the start side, <see cref="ChartLegend.Top"/> and <see cref="ChartLegend.Bottom"/>
    /// always above or below, and <see cref="ChartLegend.None"/> leaves it out. Its items don't
    /// hide slices.
    /// </summary>
    [Parameter] public ChartLegend Legend { get; set; }

    /// <summary>
    /// Where the legend sits along its edge: centered on the circle, by default (beside it or
    /// under it); <see cref="ChartAlign.Start"/> for the left above or below (in a left-to-right
    /// page) or the top beside it, <see cref="ChartAlign.End"/> for the right or the bottom.
    /// </summary>
    [Parameter] public ChartAlign? LegendAlign { get; set; }

    private string LegendListClass => LegendAlign switch
    {
        ChartAlign.Start => "ib-chart-legend ib-pie-legend ib-chart-legend-start",
        ChartAlign.End => "ib-chart-legend ib-pie-legend ib-chart-legend-end",
        _ => "ib-chart-legend ib-pie-legend ib-chart-legend-center",
    };

    // The circle and its legend: beside each other when there's room (Auto, Start, End), or one
    // over the other (chart.css).
    private string PieClass => Legend switch
    {
        ChartLegend.None or ChartLegend.Bottom => "ib-pie",
        ChartLegend.Top => "ib-pie ib-pie-lg-first",
        ChartLegend.Start => "ib-pie ib-pie-legended ib-pie-lg-first",
        _ => "ib-pie ib-pie-legended",
    };

    /// <summary>
    /// Labels each slice on the chart. <see cref="ChartLabels.Outside"/> (or <see cref="ChartLabels.Auto"/>)
    /// writes each slice's name and share in a column beside the circle, joined to it by a line,
    /// and leaves the legend out; when there's no room beside the circle (under 40rem), the legend
    /// stands in. <see cref="ChartLabels.Inside"/> writes each share in its slice, with the legend
    /// naming them; a slice too thin for it (under 6% of the circle) gets its name and share beside
    /// the circle, joined by a line, where there's room. None by default.
    /// </summary>
    [Parameter] public ChartLabels Labels { get; set; }

    // The circle's size the labels are spread for: Size in pixels or rems, or 16rem.
    private double SizeInPixels => Size?.Css is { } css && System.Text.RegularExpressions.Regex.Match(css, @"^([\d.]+)(px|rem)$") is { Success: true } m
        && double.TryParse(m.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) ? m.Groups[2].Value == "rem" ? v * 16 : v : 256;

    // The smallest slice a share is written in (Labels Inside): 6% of the turn.
    private const double InsideMin = 0.06;

    // A label beside the circle: the slice's name and share, level with where it's placed.
    private static RenderFragment PieLabelText(PieLabel label, string[] names, string?[] shares) => @<span class="@Slot(label.Index)" style="top:@(Num(label.Pos * 100))%">@names[label.Index] <span class="ib-pie-label-share">@shares[label.Index]</span></span>;

    /// <summary>The values as a table: in a closed "Show data" disclosure under the chart, by default.</summary>
    [Parameter] public ChartDataTable DataTable { get; set; }

    private readonly string _labelId = IdGenerator.Next("ib-chart");

    // What names the chart: its own caption, or the heading TitledBy points at.
    private string NameId => TitledBy ?? _labelId;
    private Expression<Func<TItem, object?>>? _lastArgument;
    private Expression<Func<TItem, object?>>? _lastValue;
    private Func<TItem, object?>? _argument;
    private Func<TItem, object?>? _value;
    private string? _argumentName;
    private string? _valueName;
    private string? _class;
    private string? _style;

    private static string Num(double value) => value.ToString("0.#####", CultureInfo.InvariantCulture);

    // The palette's eight colors, then a neutral one for the rest: a ninth slice in the first
    // color would sit beside the first.
    private static string Slot(int i) => i < 8 ? $"ib-chart-s{i + 1}" : "ib-chart-s9";

    private static string Share(double share) => ChartMembers.Share(share);

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-chart");
        classes.Add("ib-pie-chart");
        if (Size is { } size) styles.AddVar("pie-size", size.Css);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Title) == string.IsNullOrWhiteSpace(TitledBy))
        {
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(Title)
                ? "PieChart needs a Title, such as \"Customers by plan\", or TitledBy, the id of a heading on the page that titles it."
                : "PieChart takes a Title or TitledBy, not both: TitledBy names it from a heading already on the page.");
        }

        if (Argument is null || Value is null)
        {
            throw new InvalidOperationException("PieChart needs an Argument, each slice's name, and a Value, its size, such as p => p.Plan and p => p.Customers.");
        }

        if (!ReferenceEquals(Argument, _lastArgument))
        {
            _lastArgument = Argument;
            _argument = Argument.Compile();
            _argumentName = ChartMembers.Name(Argument);
        }

        if (!ReferenceEquals(Value, _lastValue))
        {
            _lastValue = Value;
            _value = Value.Compile();
            _valueName = ChartMembers.Name(Value);
        }

        base.OnParametersSet();
        (_class, _style) = BuildRootAttributes();
    }
}
