@namespace IzzyBlazor
@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]
@inherits LayoutItemBase
@implements IDisposable
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions

@*
    The stages of a process that people drop out of, such as visits, sign-ups and purchases, as a
    funnel; or, with Pyramid, levels of a hierarchy.

    <FunnelChart Items="stages"
                 Argument="s => s.Stage"
                 Value="s => s.People"
                 Title="Sign-ups, October" />

    Stages keep the items' order, unsorted: the order is the process. A missing, zero or negative
    value gets no stage in the shape but keeps its label and its row in the table, and the stage
    after it has no share of the one before. Each stage has the palette's next color, as a
    PieChart's slices do.

    Accessibility:
    - The chart is a figure captioned by Title, or named by a heading on the page with TitledBy.
    - The labels are a list, named by the title: each reads its name, value, and share of the first
      and of the stage before (a pyramid's: of the total). The shape is hidden from screen readers.
    - "Show data" under the chart opens the same numbers as a table (DataTable).
    See also: Chart, PieChart.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    @* The chart script's element: Refresh on a static page (chart-live.ts) and a download button,
       Download's or the app's own (chart.ts). *@
    <ib-chart data-ib-refresh="@_refresh.Every" data-ib-refresh-from="@_refresh.From" style="display: none"></ib-chart>
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@(HideTitle ? "ib-visually-hidden" : TitleAlign switch { ChartAlign.Center => "ib-chart-label ib-chart-label-center", ChartAlign.End => "ib-chart-label ib-chart-label-end", _ => "ib-chart-label" })">@Title</figcaption>
    }
    <CascadingValue Value="_drill" IsFixed="true">
        @ChildContent
    </CascadingValue>
    @{
        // Drill-down: the level in the address, its groups as the stages, their values added up.
        // Until the levels have registered (the first pass), a chart with no Argument draws nothing.
        var drilled = _drill.Levels.Count > 0 ? ChartDrill.At(Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [], _drill.Levels, Navigation, ChartDrill.KeyOf(Drill), AdditionalAttributes, TextDefaults) : null;
        IReadOnlyList<TItem> items;
        string[] names;
        double?[] values;
        if (drilled is not null)
        {
            items = drilled.Firsts;
            names = drilled.Arguments.Select(a => ChartLayout.ArgumentText(a, null, CultureInfo.CurrentCulture)).ToArray();
            values = drilled.Total(drilled.Rows.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray(), Aggregate);
        }
        else if (_argument is not null)
        {
            items = Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];
            names = items.Select(i => ChartLayout.ArgumentText(_argument(i), null, CultureInfo.CurrentCulture)).ToArray();
            values = items.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray();
        }
        else
        {
            (items, names, values) = ([], [], []);
        }
        var texts = values.Select(v => v is { } x ? x.ToString(ValueFormat ?? "#,##0.##", CultureInfo.CurrentCulture) : null).ToArray();
        var first = values.Length > 0 ? values[0] : null;
        var total = values.Sum(v => v is > 0 ? v.Value : 0);
        var stages = ChartShapes.Funnel(values, Pyramid);

        // A funnel's shares are of the first stage, and of the one before; a pyramid's, of the total.
        string? Of(double? value, double? whole) => value is >= 0 && whole is > 0 ? ChartMembers.Share(value.Value / whole.Value) : null;
        var shares = values.Select(v => Pyramid ? Of(v, total) : Of(v, first)).ToArray();
        var steps = values.Select((v, i) => Pyramid || i == 0 ? null : Of(v, values[i - 1])).ToArray();

        // Labels inside: each where it fits its stage, the rest beside the shape.
        var inside = new bool[items.Count];
        foreach (var stage in Labels == ChartLabels.Inside ? stages : [])
        {
            inside[stage.Index] = Fits(stage, names[stage.Index], shares[stage.Index] ?? texts[stage.Index]);
        }

        // Each label beside the shape level with its stage's middle, nudged apart a line each; one
        // with no stage sits where it would be (a funnel's), or with the level below it (a pyramid's).
        var targets = new double[items.Count];
        var last = 100.0;
        for (var i = 0; i < items.Count; i++)
        {
            targets[i] = stages.FirstOrDefault(s => s.Index == i)?.Y ?? (Pyramid ? last : (i + 0.5) * 100 / items.Count);
            last = targets[i];
        }

        // With Labels None, every label is only for screen readers.
        var shown = Enumerable.Range(0, items.Count).Select(i => Labels != ChartLabels.None && !inside[i]).ToArray();
        var beside = Enumerable.Range(0, items.Count).Where(i => shown[i]).ToArray();
        var spread = ChartLayout.Spread(beside.Select(i => targets[i] / 100 * HeightPx).ToList(), HeightPx, LinePx);
        var places = new double[items.Count];
        for (var k = 0; k < beside.Length; k++) places[beside[k]] = spread[k] / HeightPx * 100;

        FunnelLabelContext<TItem> Context(int i) => new(items[i], i, names[i], values[i], texts[i], shares[i], steps[i], inside[i]);

        // What a screen reader hears for each stage, whether its label is inside or beside.
        string Spoken(int i) => string.Join(", ", new[]
        {
            names[i], texts[i],
            shares[i] is { } share && (Pyramid || i > 0) ? string.Format(CultureInfo.CurrentCulture, Pyramid ? TextDefaults.FunnelOfTotalText : TextDefaults.FunnelOfFirstText, share) : null,
            steps[i] is { } step ? string.Format(CultureInfo.CurrentCulture, TextDefaults.FunnelOfPreviousText, step) : null,
        }.Where(t => !string.IsNullOrEmpty(t)));
    }
    @if (drilled is { Depth: > 0 } && !HideBreadcrumb)
    {
        @ChartDrill.Crumbs(drilled, TextDefaults.ChartDrillTop, Title, TextDefaults)
    }
    <div class="@(Pyramid ? "ib-funnel ib-funnel-pyramid" : "ib-funnel")" style="@Palette?.Style(items.Count)">
        <div class="ib-funnel-plot">
            <svg class="ib-funnel-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @foreach (var stage in stages)
                {
                    var tip = $"{names[stage.Index]}: {texts[stage.Index]}{(shares[stage.Index] is { } s ? $" ({s})" : "")}";
                    @if (drilled?.Hrefs?[stage.Index] is { } href)
                    {
                        @* For the pointer, a link to the stage's level below (the data table's links are for the keys). *@
                        <a href="@href" tabindex="-1"><polygon class="@($"ib-funnel-stage {Slot(stage.Index)}")" points="@stage.Points"><title>@tip. @drilled.Hint</title></polygon></a>
                    }
                    else
                    {
                        <polygon class="@($"ib-funnel-stage {Slot(stage.Index)}")" points="@stage.Points"><title>@tip</title></polygon>
                    }
                }
                @foreach (var stage in stages.Where(s => shown[s.Index]))
                {
                    @* Level with the stage, then, for a label nudged apart from its neighbors, a short bend to it. *@
                    <path class="ib-funnel-leader" d="@($"M{Num(stage.X)},{Num(stage.Y)}H{Num(Math.Max(stage.X, 96))}L100,{Num(places[stage.Index])}")" />
                }
            </svg>
            @if (inside.Any(x => x))
            {
                <div class="ib-funnel-inside" aria-hidden="true">
                    @foreach (var stage in stages.Where(s => inside[s.Index]))
                    {
                        <div class="@Slot(stage.Index)" style="@($"top:{Num(stage.Y)}%;max-width:{Num(stage.MiddleWidth)}%")">
                            @if (LabelTemplate is not null)
                            {
                                @LabelTemplate(Context(stage.Index))
                            }
                            else
                            {
                                <strong>@(shares[stage.Index] ?? texts[stage.Index])</strong>
                                <span>@names[stage.Index]</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        <ol class="ib-funnel-labels" aria-labelledby="@NameId">
            @for (var i = 0; i < items.Count; i++)
            {
                <li class="@(shown[i] ? Slot(i) : "ib-funnel-in")" style="@(shown[i] ? $"top:{Num(places[i])}%" : null)">
                    @if (shown[i])
                    {
                        <span class="ib-funnel-key" aria-hidden="true"></span>
                        <span class="ib-funnel-text" aria-hidden="true">
                            @if (LabelTemplate is not null)
                            {
                                @LabelTemplate(Context(i))
                            }
                            else
                            {
                                <span class="ib-funnel-name">@names[i]</span>
                                <span class="ib-funnel-value">@texts[i]</span>
                                @if (shares[i] is { } share && (Pyramid || i > 0))
                                {
                                    <span class="ib-funnel-share">@share</span>
                                }
                            }
                        </span>
                    }
                    <span class="ib-visually-hidden">@Spoken(i)</span>
                </li>
            }
        </ol>
    </div>

    @if (DataTable != ChartDataTable.None)
    {
        RenderFragment dataTable = @<div class="ib-chart-table-scroll">
                <table class="ib-chart-table" aria-labelledby="@NameId">
                    <thead>
                        <tr>
                            <th scope="col">@(drilled?.LevelName ?? _argumentName ?? TextDefaults.ChartItem)</th>
                            <th scope="col">@(_valueName ?? TextDefaults.ChartValue)</th>
                            <th scope="col">@(Pyramid ? TextDefaults.ChartShare : TextDefaults.FunnelOfFirst)</th>
                            @if (!Pyramid)
                            {
                                <th scope="col">@TextDefaults.FunnelOfPrevious</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < items.Count; i++)
                        {
                            <tr>
                                <th scope="row">@if (drilled?.Hrefs?[i] is { } href)
                                {<a href="@href" data-ib-drill="@i">@names[i]</a>}
                                else
                                {@names[i]}</th>
                                <td>@texts[i]</td>
                                <td>@shares[i]</td>
                                @if (!Pyramid)
                                {
                                    <td>@steps[i]</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>;
        @ChartTools.Data(DataTable, _labelId, Title, TitledBy, TextDefaults, dataTable)
    }
    @if (Download)
    {
        @* Download, across from the title (chart.css): last, so the title's neighbor rules
           (label + legend, label + rings) still meet. *@
        @ChartTools.Tools(TextDefaults)
    }
</figure>

@code {
    /// <summary>
    /// How often the chart reads its data again, at least a second, such as
    /// <c>Refresh="TimeSpan.FromSeconds(30)"</c>. On a static page the page (or
    /// <see cref="RefreshFrom"/>) is fetched again and the chart drawn from it, found by its
    /// <c>id</c>, which it then needs; on an interactive page <see cref="OnRefresh"/> is raised, for
    /// you to load new data. Not while the tab is hidden or the chart is off-screen, nor (static)
    /// while the pointer or focus is in it. Unlike Chart's, it has no Pause button.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public TimeSpan? Refresh { get; set; }

    /// <summary>On a static page with <see cref="Refresh"/>: a lighter page to fetch than this one, which renders the same chart with the same <c>id</c>.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public string? RefreshFrom { get; set; }

    /// <summary>On an interactive page with <see cref="Refresh"/>: raised at each interval, to load new data.</summary>
    [Parameter, ModeSupport(Static = ModeLevel.None, NoScript = ModeLevel.None)]
    public EventCallback OnRefresh { get; set; }

    private readonly ChartRefresh _refresh = new();

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        _refresh.AfterRender(Refresh, RendererInfo, OnRefresh, InvokeAsync, DispatchExceptionAsync);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _refresh.Dispose();
        Navigation.LocationChanged -= Moved;
    }

    /// <summary>
    /// <see cref="ChartDrillLevel{TItem}"/>s, from the top, for stages that drill down: each level's
    /// groups are the stages (the level's argument in place of <see cref="Argument"/>), their
    /// values added up by <see cref="Aggregate"/>, and selecting one shows the next level.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>With drill-down levels: the page address's query value that holds the level ("drill" by default; give each chart that drills on a page its own).</summary>
    [Parameter] public string? Drill { get; set; }

    /// <summary>With drill-down levels: leaves out the breadcrumb above the chart.</summary>
    [Parameter] public bool HideBreadcrumb { get; set; }

    /// <summary>With drill-down levels, how each stage adds up its items' values: Sum by default, or Avg, Min, Max or Count.</summary>
    [Parameter] public DataAggregate Aggregate { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private ChartDrillLevels<TItem>? _drillLevels;

    private ChartDrillLevels<TItem> _drill => _drillLevels ??= new ChartDrillLevels<TItem>(StateHasChanged);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (RendererInfo.IsInteractive) Navigation.LocationChanged += Moved;
    }

    // Interactive: the address changed (a drill link or Back): draw the level it names.
    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_drillLevels is { Levels.Count: > 0 }) _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>The items, one stage each, in the order of the process.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Each stage's name, such as <c>s =&gt; s.Stage</c>.</summary>
    [Parameter] public Expression<Func<TItem, object?>>? Argument { get; set; }

    /// <summary>
    /// Each stage's value, such as <c>s =&gt; s.People</c>: any number. A funnel stage's top is as
    /// wide as its share of the largest; a pyramid level is as tall as its share of the total.
    /// </summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Value { get; set; } = default!;

    /// <summary>
    /// The chart's title, such as "Sign-ups, October", shown above it as its caption. It also names the chart
    /// for screen readers. A chart needs a Title or <see cref="TitledBy"/>.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Hides the title, which still names the chart for screen readers.</summary>
    [Parameter] public bool HideTitle { get; set; }

    /// <summary>
    /// Shows a button across from the title that saves the chart as a PNG, named after its title,
    /// in the color scheme on screen. With JavaScript off there's no button.
    /// </summary>
    [Parameter] public bool Download { get; set; }

    /// <summary>
    /// Where the title sits: at the start by default (the left, in a left-to-right page);
    /// <see cref="ChartAlign.Center"/> or <see cref="ChartAlign.End"/>.
    /// </summary>
    [Parameter] public ChartAlign TitleAlign { get; set; }

    /// <summary>
    /// The id of a heading already on the page that titles the chart, such as a card's, in place of
    /// <see cref="Title"/>: the chart takes its name from it and shows no title of its own.
    /// </summary>
    [Parameter] public string? TitledBy { get; set; }

    /// <summary>A .NET format string for the values, such as <c>C0</c> or <c>N0</c>.</summary>
    [Parameter] public string? ValueFormat { get; set; }

    /// <summary>
    /// The colors in order: <see cref="ChartPalette.Colors"/> (the theme's eight, the default),
    /// <see cref="ChartPalette.Shades"/> of one color, or your own with <see cref="ChartPalette.Of"/>.
    /// </summary>
    [Parameter] public ChartPalette? Palette { get; set; }

    /// <summary>
    /// Draws a pyramid: a triangle on its base, the first item at the bottom, each level as tall as
    /// its share of the total, for levels of a hierarchy such as a team's seniority. Each shows its
    /// share of the total in place of the first's and the one before's.
    /// </summary>
    [Parameter] public bool Pyramid { get; set; }

    /// <summary>
    /// Where the labels go: beside the shape, joined to their stages by lines, by default (Auto or
    /// <see cref="ChartLabels.Outside"/>);
    /// <see cref="ChartLabels.Inside"/> writes each in its stage (its share over its name), where it
    /// fits, and puts the rest beside the shape. <see cref="ChartLabels.None"/> leaves them out: the
    /// shape's hover text and "Show data" still give every value.
    /// </summary>
    [Parameter] public ChartLabels Labels { get; set; } = ChartLabels.Auto;

    /// <summary>
    /// Writes each label yourself, from the stage's name, value and shares: inside its stage or
    /// beside the shape (<see cref="FunnelLabelContext{TItem}.Inside"/> says which). Screen readers
    /// still hear the stage's name, value and shares.
    /// </summary>
    [Parameter] public RenderFragment<FunnelLabelContext<TItem>>? LabelTemplate { get; set; }

    /// <summary>The values as a table: by default behind a "Show data" button that opens it over the chart; <see cref="ChartDataTable.Collapsed"/> puts it in a disclosure under the chart.</summary>
    [Parameter] public ChartDataTable DataTable { get; set; } = ChartDataTable.Popover;

    // The shape's height (chart.css's 18rem) and a label's line (1.25rem), at a 16px root: the
    // labels are spread over it, so only their ratio counts.
    private const double HeightPx = 288;

    private const double LinePx = 20;

    // An inside label fits its stage when the stage is two lines tall and, at a shape 25rem wide,
    // wider than the label: its share (1rem, semibold) and its name (0.75rem). Your own label is
    // given 30% of the width. Narrower, an inside label ends in an ellipsis rather than spill out.
    private bool Fits(FunnelStage stage, string name, string? share) =>
        stage.Height / 100 * HeightPx >= LinePx * 2
        && stage.MiddleWidth / 100 * 400 >= (LabelTemplate is not null ? 120
            : Math.Max(TextWidths.AtSize(share ?? "", 16) * 1.05, TextWidths.AtSize(name, 12)) + 16);

    private readonly string _labelId = IdGenerator.Next("ib-chart");

    // What names the chart: its own caption, or the heading TitledBy points at.
    private string NameId => TitledBy ?? _labelId;
    private Expression<Func<TItem, object?>>? _lastArgument;
    private Expression<Func<TItem, object?>>? _lastValue;
    private Func<TItem, object?>? _argument;
    private Func<TItem, object?>? _value;
    private string? _argumentName;
    private string? _valueName;
    private string? _class;
    private string? _style;

    private static string Num(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    // The palette's eight colors, then a neutral one for the rest, as PieChart's slices.
    private static string Slot(int i) => i < 8 ? $"ib-chart-s{i + 1}" : "ib-chart-s9";

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-chart");
        classes.Add("ib-funnel-chart");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _refresh.Check("FunnelChart", Refresh, RefreshFrom, RendererInfo, AssignedRenderMode, AdditionalAttributes, OnRefresh.HasDelegate);
        _drill.BeginPass();
        if (string.IsNullOrWhiteSpace(Title) == string.IsNullOrWhiteSpace(TitledBy))
        {
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(Title)
                ? "FunnelChart needs a Title, such as \"Sign-ups, October\", or TitledBy, the id of a heading on the page that titles it."
                : "FunnelChart takes a Title or TitledBy, not both: TitledBy names it from a heading already on the page.");
        }

        if ((Argument is null && ChildContent is null) || Value is null)
        {
            throw new InvalidOperationException("FunnelChart needs an Argument, each stage's name, and a Value, its size, such as s => s.Stage and s => s.People.");
        }

        if (Argument is not null && !ReferenceEquals(Argument, _lastArgument))
        {
            _lastArgument = Argument;
            _argument = Argument.Compile();
            _argumentName = ChartMembers.Name(Argument);
        }

        if (!ReferenceEquals(Value, _lastValue))
        {
            _lastValue = Value;
            _value = Value.Compile();
            _valueName = ChartMembers.Name(Value);
        }

        base.OnParametersSet();
        (_class, _style) = BuildRootAttributes();
    }
}
