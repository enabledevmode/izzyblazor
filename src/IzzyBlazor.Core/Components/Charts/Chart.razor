    // A ChartRangeSelector under the plot (outside the frame, whose img role would hide its sliders):
    // the series drawn small over the whole range, a window over the view with a slider at each
    // end, the rest shaded, range buttons, and the whole range's labels. The script lines it up
    // with the plot and makes it move.
    private RenderFragment Selector(ChartModel model, IRangeSelector selector) => __builder =>
    {
        var reverse = _argumentAxis?.Reverse == true;
        var (f0, f1) = model.View?.Share ?? (0, 1);
        var place = (double f) => reverse ? 1 - f : f;
        var n = model.ArgumentTexts.Length;
        int Nearest(double share) => Enumerable.Range(0, n).Where(i => !double.IsNaN(model.ZoomPositions![i]))
            .MinBy(i => Math.Abs(model.ZoomPositions![i] - share));
        // Names: the view's ends are band edges, so its first and last items are by index.
        var (i0, i1) = model.Kind == ArgumentKind.Category
            ? model.View is { } v ? ((int)v.Lo, (int)v.Hi - 1) : (0, n - 1)
            : (Nearest(f0), Nearest(f1));
        var height = selector.Height is { } h ? $"--ib-chart-sel-h:{h.Css};" : "";
        var ranges = SelectorRanges(model, selector);
        @* On its own, the figure's caption names it already. *@
        @* Under a chart, whose axis already names the dates, its labels sit inside the strip and
           its flags show only while a handle is in use; on its own, a scale under it and flags. *@
        var inChart = SelectorHost is null;
        <div class="@("ib-chart-sel" + (inChart ? " ib-chart-sel-inner" : "") + (selector.HideFlags ? " ib-chart-sel-noflags" : ""))" role="group" aria-label="@(SelectorHost is null ? selector.Label ?? TextDefaults.RangeSelectorName : null)"
             style="@($"--ib-sel-s:{Num(place(f0))};--ib-sel-e:{Num(place(f1))};{height}")">
            @if (ranges.Count > 0)
            {
                <div class="ib-chart-sel-ranges">
                    @foreach (var r in ranges)
                    {
                        var on = Math.Abs(r.From - f0) < 1e-3 && Math.Abs(r.To - f1) < 1e-3;
                        <button type="button" class="ib-btn ib-btn-ghost ib-btn-sm" aria-label="@r.Name" aria-pressed="@(on ? "true" : "false")"
                                data-ib-range="@($"{Num(r.From)} {Num(r.To)}")">@r.Text</button>
                    }
                </div>
            }
            <div class="ib-chart-sel-track">
                <svg class="ib-chart-sel-series" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var (shape, d) in SelectorAreas(model, reverse))
                    {
                        <path class="@SeriesClass(shape, "ib-chart-sel-area")" style="@ColorStyle(shape)" d="@d" />
                    }
                </svg>
                @if (inChart)
                {
                    @* Only the coarsest labels (those shown at every width), so the strip stays quiet
                       beside the chart's own axis: years over a few years, quarters over one. *@
                    <div class="ib-chart-sel-labels" aria-hidden="true">
                        @foreach (var label in (model.ZoomTiers.FirstOrDefault()?.Labels ?? []).Where(l => l.From == 0))
                        {
                            <span style="left:@Pct(place(label.Pos))">@label.Text@(label.Context is { } context ? $" {context}" : "")</span>
                        }
                    </div>
                }
                <div class="ib-chart-sel-shade ib-chart-sel-before"></div>
                <div class="ib-chart-sel-shade ib-chart-sel-after"></div>
                <div class="ib-chart-sel-window"></div>
                @foreach (var (end, i, label) in new[] { ("start", i0, TextDefaults.RangeSelectorStart), ("end", i1, TextDefaults.RangeSelectorEnd) })
                {
                    <div class="@($"ib-chart-sel-handle ib-chart-sel-{end}")" role="slider" aria-label="@label"
                         aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="@(n - 1)" aria-valuenow="@i" aria-valuetext="@model.ArgumentTexts[i]">
                        @if (!selector.HideFlags)
                        {
                            <span class="ib-chart-sel-flag" aria-hidden="true">@model.ArgumentTexts[i]</span>
                            <span class="ib-chart-sel-flag ib-chart-js" aria-hidden="true"></span>
                        }
                    </div>
                }
            </div>
            @if (!inChart)
            {
                <div class="ib-chart-sel-axis" aria-hidden="true">
                    <div class="ib-chart-ticks">
                        @foreach (var label in model.ZoomTiers.FirstOrDefault()?.Labels ?? [])
                        {
                            var at = place(label.Pos);
                            var edge = at < 0.04 ? " ib-chart-sel-first" : at > 0.96 ? " ib-chart-sel-last" : "";
                            <span class="@((label.From > 0 ? $"ib-chart-from{label.From}" : "") + edge)" style="left:@Pct(at)">@label.Text@if (label.Context is { } context)
                                {<span class="ib-chart-context">@context</span>}</span>
                        }
                    </div>
                </div>
            }
        </div>
    };

    // The chart's series, drawn small over the whole range as soft areas on a scale of their own
    // (zero and every value), in a 1000 by 1000 box; split where a value is missing.
    private static List<(SeriesShape Shape, string D)> SelectorAreas(ChartModel model, bool reverse)
    {
        var at = model.ZoomPositions!;
        var shown = model.Series.Where(s => !s.Data.Hidden && s.Data.ColorFrom is null).ToList();
        var values = shown.SelectMany(s => s.Data.Values).Where(v => v is { } x && double.IsFinite(x)).Select(v => v!.Value).ToList();
        if (values.Count == 0) return [];
        var fromZero = shown.Any(s => s.Data.Type is ChartType.Bar or ChartType.Area);
        var (lo, hi) = fromZero ? (Math.Min(0, values.Min()), Math.Max(0, values.Max())) : (values.Min(), values.Max());
        if (hi <= lo) hi = lo + 1;
        if (!fromZero) (lo, hi) = (lo - (hi - lo) * 0.1, hi + (hi - lo) * 0.1);
        string P(double x) => x.ToString("0.#", CultureInfo.InvariantCulture);
        var y0 = fromZero ? 1000 - (0 - lo) / (hi - lo) * 1000 : 1000;
        var order = Enumerable.Range(0, at.Length).Where(i => !double.IsNaN(at[i])).OrderBy(i => at[i]).ToList();
        var areas = new List<(SeriesShape, string)>();
        foreach (var shape in shown)
        {
            var d = new System.Text.StringBuilder();
            var run = new List<(double X, double Y)>();
            void Flush()
            {
                if (run.Count > 0)
                {
                    d.Append($"M{P(run[0].X)},{P(y0)}");
                    foreach (var (x, y) in run) d.Append($"L{P(x)},{P(y)}");
                    d.Append($"L{P(run[^1].X)},{P(y0)}Z");
                }

                run.Clear();
            }

            foreach (var i in order)
            {
                if (shape.Data.Values[i] is { } v && double.IsFinite(v))
                {
                    var x = (reverse ? 1 - at[i] : at[i]) * 1000;
                    run.Add((x, 1000 - (v - lo) / (hi - lo) * 1000));
                }
                else if (!shape.Data.ConnectGaps)
                {
                    Flush();
                }
            }

            Flush();
            if (d.Length > 0) areas.Add((shape, d.ToString()));
        }

        return areas;
    }

    // A date chart's range buttons, as shares of the whole axis: the common spans back from the
    // last date (Ranges), then the app's own (Presets); spans the data doesn't reach are left out.
    private List<(string Text, string Name, double From, double To)> SelectorRanges(ChartModel model, IRangeSelector selector)
    {
        var list = new List<(string, string, double, double)>();
        // Dates spaced by item (SkipGaps, or under bars): presets count items, whatever the labels' fit.
        var byItem = model.Kind == ArgumentKind.Category && ChartLayout.Dates(_drawnArguments) is not null;
        if ((model.Kind != ArgumentKind.Time && !byItem) || (!selector.Ranges && selector.Presets is null)) return list;
        var ticks = _drawnArguments.Select(a => ChartLayout.ToDouble(a, ArgumentKind.Time)).Where(x => x is not null).Select(x => (long)x!.Value).ToList();
        if (ticks.Count < 2) return list;
        var (lo, hi) = (ticks.Min(), ticks.Max());
        if (hi <= lo) return list;
        var last = new DateTime(hi);
        // Whole days: a span back from the last day starts the day after (1M of Oct 31 is Oct 1 on).
        DateTime Back(DateTime from) => last.TimeOfDay == TimeSpan.Zero ? from.AddDays(1) : from;
        // Dates spaced by item: a span's share is its items' (one item to each slot).
        var n = _drawnArguments.Count;
        double Share(DateTime t, bool end) => byItem
            ? (end ? _drawnArguments.Count(a => ChartLayout.ToDouble(a, ArgumentKind.Time) <= t.Ticks) : _drawnArguments.Count(a => ChartLayout.ToDouble(a, ArgumentKind.Time) < t.Ticks)) / (double)n
            : Math.Clamp((t.Ticks - lo) / (double)(hi - lo), 0, 1);
        void Add(string text, string name, DateTime from, DateTime to)
        {
            if (from.Ticks <= lo && to.Ticks >= hi && text != TextDefaults.RangeAll) return;
            list.Add((text, name, Share(from, false), Share(to, true)));
        }

        if (selector.Ranges)
        {
            Add(string.Format(CultureInfo.CurrentCulture, TextDefaults.RangeMonths, 1), TextDefaults.RangeMonthName, Back(last.AddMonths(-1)), last);
            foreach (var m in new[] { 3, 6 })
            {
                Add(string.Format(CultureInfo.CurrentCulture, TextDefaults.RangeMonths, m), string.Format(CultureInfo.CurrentCulture, TextDefaults.RangeMonthsName, m), Back(last.AddMonths(-m)), last);
            }

            Add(TextDefaults.RangeYearToDate, TextDefaults.RangeYearToDateName, new DateTime(last.Year, 1, 1), last);
            Add(TextDefaults.RangeYear, TextDefaults.RangeYearName, Back(last.AddYears(-1)), last);
        }

        foreach (var preset in selector.Presets ?? [])
        {
            Add(preset.Label, preset.Label, preset.Start.ToDateTime(TimeOnly.MinValue), preset.End.ToDateTime(TimeOnly.MinValue));
        }

        if (selector.Ranges) list.Add((TextDefaults.RangeAll, TextDefaults.RangeAll, 0, 1));
        return list;
    }

    // The script reports where the reader zoomed to, as shares of the whole axis ("0.25 0.5"), or
    // "" zoomed all the way out; on an interactive page this keeps it and raises ViewChanged.
    private async Task OnView(IzzyLayoutEventArgs e)
    {
        var view = ViewAt(e.Layout);
        _follow = IsLive && view is not null ? FollowCount(e.Layout) : null;
        if (Equals(view, _view)) return;
        _view = view;
        if (ViewChanged.HasDelegate) await ViewChanged.InvokeAsync(view);
    }

    // ---- Drill-down (ChartDrill). ----

    private string DrillKey => ChartDrill.KeyOf(Drill);

    // The path last drawn (interactive): a new one starts unzoomed.
    private string? _drillPath;

    private ChartDrillState<TItem> Drilled(IReadOnlyList<TItem> items) =>
        ChartDrill.At(items, _context.Levels, Navigation, DrillKey, AdditionalAttributes, TextDefaults);

    // A series added up by the level's groups, by its Aggregate.
    private static ChartSeriesData Totals(ChartSeriesData data, ChartDrillState<TItem> drill)
    {
        if (data.IsPoint || data.IsWaterfall || data.IsOhlc || data.IsBox)
        {
            throw new InvalidOperationException("Chart drill-down levels add up bar, line and area series: leave out scatter, bubble, waterfall, candlestick and OHLC series.");
        }

        // A range's level runs from its items' lowest to their highest.
        if (data.Lows is { } lows)
        {
            return data with { Values = drill.Total(data.Values, DataAggregate.Max), Lows = drill.Total(lows, DataAggregate.Min), LabelTexts = null };
        }

        return data with { Values = drill.Total(data.Values, data.Aggregate), Targets = data.Targets is { } targets ? drill.Total(targets, data.Aggregate) : null, LabelTexts = null };
    }

    // Interactive: the address changed (a drill link or Back): draw the level it names.
    private void OnLocation(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_context.Levels.Count == 0) return;
        var path = string.Join("/", ChartDrill.PathOf(Navigation, DrillKey));
        if (path != _drillPath)
        {
            (_drillPath, _view, _follow) = (path, View, null);
        }

        _ = InvokeAsync(() =>
        {
            StateHasChanged();
            _context.Plot?.Refresh();
        });
    }

    // Live: a view that reaches the latest item follows new data, keeping as many items: their count,
    // or null for one that ends earlier.
    private int? FollowCount(string? layout)
    {
        var parts = (layout ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 2 || !double.TryParse(parts[0], CultureInfo.InvariantCulture, out var f0) || !double.TryParse(parts[1], CultureInfo.InvariantCulture, out var f1) || f1 < 1 - 1e-6) return null;
        var n = _drawnArguments.Count;
        if (n < 2) return null;
        if (_drawnKind == ArgumentKind.Category) return Math.Max(1, (int)Math.Round((f1 - f0) * n));
        var at = _drawnArguments.Select(a => ChartLayout.ToDouble(a, _drawnKind)).Where(x => x is not null).Select(x => x!.Value).ToList();
        if (at.Count < 2) return null;
        var (lo, hi) = (at.Min(), at.Max());
        return Math.Max(1, at.Count(x => x >= lo + f0 * (hi - lo) - 1e-9 * (hi - lo)));
    }

    // A view from shares of the whole axis: the names it takes in, or the scale's ends as arguments
    // of the chart's own type.
    private ChartView? ViewAt(string? layout)
    {
        var parts = (layout ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 2 || !double.TryParse(parts[0], CultureInfo.InvariantCulture, out var f0) || !double.TryParse(parts[1], CultureInfo.InvariantCulture, out var f1)) return null;
        if (f0 <= 1e-6 && f1 >= 1 - 1e-6) return null;
        var (arguments, kind) = (_drawnArguments, _drawnKind);
        if (arguments.Count < 2) return null;
        if (kind == ArgumentKind.Category)
        {
            var n = arguments.Count;
            var (i0, i1) = ((int)Math.Clamp(Math.Round(f0 * n), 0, n - 1), (int)Math.Clamp(Math.Round(f1 * n) - 1, 0, n - 1));
            return new ChartView(arguments[i0], arguments[Math.Max(i0, i1)]);
        }

        var log = _argumentAxis?.Logarithmic == true;
        var at = arguments.Select(a => ChartLayout.ToDouble(a, kind)).Where(x => x is { } v && (!log || v > 0)).Select(x => log ? Math.Log10(x!.Value) : x!.Value).ToList();
        if (at.Count < 2) return null;
        var (lo, hi) = (at.Min(), at.Max());
        object? Arg(double share)
        {
            var x = lo + share * (hi - lo);
            if (log) x = Math.Pow(10, x);
            if (kind == ArgumentKind.Number) return x;
            var t = new DateTime(Math.Clamp((long)Math.Round(x), DateTime.MinValue.Ticks, DateTime.MaxValue.Ticks));
            return arguments.FirstOrDefault(a => a is not null) switch
            {
                // Days: the nearest, as a share's rounding can fall just before midnight.
                DateOnly => DateOnly.FromDateTime(t.AddTicks(TimeSpan.TicksPerDay / 2)),
                DateTimeOffset o => new DateTimeOffset(t, o.Offset),
                _ => t,
            };
        }

        return new ChartView(Arg(f0), Arg(f1));
    }

    // What synced charts match by: each item's argument (dates as ticks, numbers as themselves,
    // names as text) and, zooming on a scale, the axis's ends in its units and whether it's a log.
    private string SyncKeys(ChartModel model)
    {
        using var stream = new MemoryStream();
        using (var w = new System.Text.Json.Utf8JsonWriter(stream))
        {
            // Bars over dates are bands, but they still match a line over the same dates by value.
            static bool IsValue(object? a) => a is DateTime or DateOnly or DateTimeOffset or byte or sbyte or short or ushort or int or uint or long or ulong or float or double or decimal;
            var text = model.Kind == ArgumentKind.Category && !_drawnArguments.Where(a => a is not null).All(IsValue);
            w.WriteStartObject();
            w.WriteBoolean("c", model.Kind == ArgumentKind.Category);
            w.WriteBoolean("t", text);
            w.WriteStartArray("k");
            foreach (var a in _drawnArguments)
            {
                if (text) w.WriteStringValue(Convert.ToString(a, CultureInfo.InvariantCulture) ?? "");
                else if (ChartLayout.ToDouble(a, a is DateTime or DateOnly or DateTimeOffset ? ArgumentKind.Time : ArgumentKind.Number) is { } x) w.WriteNumberValue(x);
                else w.WriteNullValue();
            }

            w.WriteEndArray();
            if (model.ZoomDomain is { } d)
            {
                w.WriteStartArray("d");
                w.WriteNumberValue(d.Lo);
                w.WriteNumberValue(d.Hi);
                w.WriteEndArray();
                if (_argumentAxis?.Logarithmic == true) w.WriteBoolean("g", true);
            }

            w.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    // What the script needs to draw the chart again without a series (chart-draw.ts): each
    // series' values and look, the stacking, the value range and how values read.
    private string DrawData(ChartModel model, NumberShape shape, bool horizontal, string marks)
    {
        using var stream = new MemoryStream();
        using (var w = new System.Text.Json.Utf8JsonWriter(stream))
        {
            void Number(string name, double? value)
            {
                if (value is { } v && double.IsFinite(v)) w.WriteNumber(name, v);
                else w.WriteNull(name);
            }

            w.WriteStartObject();
            w.WriteBoolean("h", horizontal);
            if (_argumentAxis?.Reverse == true) w.WriteBoolean("ar", true);
            w.WriteNumber("st", (int)Stacked);
            Number("lo", ValueMin);
            Number("hi", ValueMax);
            Number("vs", ValueLog ? null : ValueStep);
            // The second axis's range, which a redraw keeps.
            if (model.SecondaryLabels.Count > 0)
            {
                w.WriteNumber("s2l", model.SecondaryRange.Min);
                w.WriteNumber("s2h", model.SecondaryRange.Max);
            }

            // The marks' values, which the value axis always takes in.
            if (model.MarkValues.Count > 0)
            {
                w.WriteStartArray("rv");
                foreach (var v in model.MarkValues) w.WriteNumberValue(v);
                w.WriteEndArray();
            }
            // Room past the plot for labels past bars' ends.
            if (model.OutsideRoom != (0, 0))
            {
                w.WriteStartArray("lr");
                w.WriteNumberValue(model.OutsideRoom.X);
                w.WriteNumberValue(model.OutsideRoom.Y);
                w.WriteEndArray();
            }

            w.WriteBoolean("lg", ValueLog);
            w.WriteBoolean("gl", ValueGrid);
            // With a ValueFormatter, the server's value axis as drawn: its range and ticks.
            if (ValueFormatter is not null && Stacked != ChartStacking.Percent)
            {
                w.WriteNumber("rl", model.ValueRange.Min);
                w.WriteNumber("rh", model.ValueRange.Max);
                w.WriteStartArray("tk");
                var lines = model.Grid.Where(g => !g.Argument).ToList();
                for (var t = 0; t < model.ValueLabels.Count; t++)
                {
                    var label = model.ValueLabels[t];
                    w.WriteStartArray();
                    w.WriteNumberValue(Math.Round(label.Pos, 6));
                    w.WriteStringValue(label.Text);
                    w.WriteNumberValue(label.From);
                    w.WriteBooleanValue(t < lines.Count && lines[t].Zero);
                    w.WriteEndArray();
                }

                w.WriteEndArray();
            }
            w.WriteStartObject("f");
            w.WriteString("p", shape.Prefix);
            w.WriteString("s", shape.Suffix);
            w.WriteString("np", shape.NegativePrefix);
            w.WriteString("ns", shape.NegativeSuffix);
            w.WriteString("g", shape.Group);
            w.WriteString("d", shape.Decimal);
            w.WriteNumber("n", shape.Decimals);
            w.WriteNumber("t", shape.MinDecimals);
            w.WriteNumber("k", shape.Scale);
            w.WriteEndObject();
            w.WriteStartArray("a");
            foreach (var p in model.ArgumentPositions)
            {
                if (double.IsNaN(p)) w.WriteNullValue();
                else w.WriteNumberValue(Math.Round(p, 5));
            }

            w.WriteEndArray();
            w.WriteString("mk", marks);
            if (model.ZoomPositions is { } zp)
            {
                // Zoom: each item's place on the whole axis, the fewest items' span, the view drawn,
                // argument grid lines, the label tiers (place, text, second line, first width,
                // second line when first in view) or, down the side, the names.
                w.WriteStartArray("za");
                foreach (var p in zp)
                {
                    if (double.IsNaN(p)) w.WriteNullValue();
                    else w.WriteNumberValue(Math.Round(p, 6));
                }

                w.WriteEndArray();
                w.WriteNumber("zl", Math.Round(model.ZoomLeast, 6));
                w.WriteBoolean("zc", model.Kind == ArgumentKind.Category);
                w.WriteBoolean("ag", ArgumentGrid);
                w.WriteString("zs", TextDefaults.ChartShowing);
                w.WriteStartArray("zn");
                foreach (var t in model.ArgumentTexts) w.WriteStringValue(t);
                w.WriteEndArray();
                if (model.View?.Share is { } share)
                {
                    w.WriteStartArray("zv");
                    w.WriteNumberValue(Math.Round(share.F0, 6));
                    w.WriteNumberValue(Math.Round(share.F1, 6));
                    w.WriteEndArray();
                }

                w.WriteStartArray("zt");
                foreach (var tier in model.ZoomTiers)
                {
                    w.WriteStartArray();
                    w.WriteNumberValue(tier.Zoom);
                    w.WriteStartArray();
                    foreach (var label in tier.Labels)
                    {
                        w.WriteStartArray();
                        w.WriteNumberValue(Math.Round(label.Pos, 6));
                        w.WriteStringValue(label.Text);
                        if (label.Context is null) w.WriteNullValue(); else w.WriteStringValue(label.Context);
                        w.WriteNumberValue(label.From);
                        if (label.Lead is null) w.WriteNullValue(); else w.WriteStringValue(label.Lead);
                        w.WriteEndArray();
                    }

                    w.WriteEndArray();
                    w.WriteEndArray();
                }

                w.WriteEndArray();
                // Names down the side of a horizontal chart, which the script thins (from zn).
                if (horizontal && model.Kind == ArgumentKind.Category) w.WriteBoolean("zx", true);
            }
            // The tick count up the side, as the server worked it out from Height.
            // A histogram's bars fill their bins, square, and its counts tick by whole numbers.
            if (model.Edges) w.WriteBoolean("hb", true);
            w.WriteNumber("vc", Math.Max(2, (int)Math.Round(Math.Max(80, HeightInPixels(Height)) / 56)));
            // Bubbles pad the value axis by their largest radius (ChartLayout.PadEnds).
            if (model.Series.Any(s => s.Data.Type == ChartType.Bubble))
            {
                w.WriteStartArray("bp");
                w.WriteNumberValue(ChartLayout.BubbleRadius(HeightInPixels(Height)));
                w.WriteNumberValue(Math.Max(80, HeightInPixels(Height)));
                w.WriteEndArray();
            }
            // The series the server drew hidden: the script compares the legend's with these.
            w.WriteStartArray("off");
            foreach (var s in model.Series.Where(s => s.Data.Hidden)) w.WriteNumberValue(s.Index);
            w.WriteEndArray();
            w.WriteStartArray("s");
            foreach (var s in model.Series)
            {
                var d = s.Data;
                w.WriteStartObject();
                w.WriteNumber("t", (int)d.Type);
                w.WriteStartArray("v");
                foreach (var v in d.Values)
                {
                    if (v is { } x && double.IsFinite(x)) w.WriteNumberValue(x);
                    else w.WriteNullValue();
                }

                w.WriteEndArray();
                // A range's low ends.
                if (d.Lows is { } lows)
                {
                    w.WriteStartArray("lw");
                    foreach (var v in lows)
                    {
                        if (v is { } x && double.IsFinite(x)) w.WriteNumberValue(x);
                        else w.WriteNullValue();
                    }

                    w.WriteEndArray();
                }

                // A price series' opens and closes, and whether it's drawn as bars.
                foreach (var (key, prices) in new[] { ("po", d.Opens), ("cl", d.Closes) })
                {
                    if (prices is null) continue;
                    w.WriteStartArray(key);
                    foreach (var v in prices)
                    {
                        if (v is { } x && double.IsFinite(x)) w.WriteNumberValue(x);
                        else w.WriteNullValue();
                    }

                    w.WriteEndArray();
                }

                if (d.OhlcBars) w.WriteBoolean("ob", true);

                // A bar series' targets.
                if (d.Targets is { } targets)
                {
                    w.WriteStartArray("tg");
                    foreach (var v in targets)
                    {
                        if (v is { } x && double.IsFinite(x)) w.WriteNumberValue(x);
                        else w.WriteNullValue();
                    }

                    w.WriteEndArray();
                }

                w.WriteNumber("c", (int)d.Curve);
                w.WriteBoolean("j", d.ConnectGaps);
                w.WriteBoolean("m", s.Markers);
                // A bubble's radius by item, which doesn't change with the value axis.
                if (d.Type == ChartType.Bubble)
                {
                    w.WriteStartArray("r");
                    foreach (var r in s.Radii!) w.WriteNumberValue(Math.Round(r, 2));
                    w.WriteEndArray();
                }
                w.WriteNumber("k", s.Slot);
                w.WriteNumber("y", s.Style);
                w.WriteNumber("d", s.Dash);
                if (d.ColorFrom is not null && d.TrendColor is null) w.WriteBoolean("tr", true);
                if (d.ColorFrom is not null) w.WriteBoolean("so", true);
                if (d.Secondary) w.WriteBoolean("ax", true);
                if (d.EndLabel) w.WriteString("en", d.Name);
                if (d.Color is { } c) w.WriteString("col", StyleValues.Raw(c, "color"));
                if (d.Opacity is { } op) w.WriteNumber("op", op);
                // Labels: the mode, and each item's text, which the script can't format itself.
                if (model.LabelTexts[s.Index] is { } texts)
                {
                    w.WriteNumber("lm", (int)d.Labels);
                    if (d.LabelOverlap == ChartLabelOverlap.Show) w.WriteBoolean("lo", true);
                    w.WriteStartArray("lt");
                    foreach (var text in texts)
                    {
                        if (text is null) w.WriteNullValue();
                        else w.WriteStringValue(text);
                    }

                    w.WriteEndArray();
                }
                w.WriteEndObject();
            }

            w.WriteEndArray();
            w.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static string? ColorStyle(SeriesShape s) =>
        (s.Data.Color is { } color ? $"--ib-chart-color:{StyleValues.Raw(color, "color")};" : "")
        + (s.Data.Opacity is { } opacity ? $"--ib-chart-fill-opacity:{Num(opacity)}" : "") is { Length: > 0 } style ? style : null;
}
