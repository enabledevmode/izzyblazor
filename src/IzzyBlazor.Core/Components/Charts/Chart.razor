    // An item's crosshair: its argument, then each series' place, value and text (null with none).
    private static string CrossData(ChartModel model, int i, bool full)
    {
        using var stream = new MemoryStream();
        using (var w = new System.Text.Json.Utf8JsonWriter(stream))
        {
            w.WriteStartArray();
            w.WriteStringValue(model.ArgumentTexts[i]);
            w.WriteStartArray();
            for (var s = 0; s < model.Cross[i].Length; s++)
            {
                if (model.Cross[i][s] is not { } v)
                {
                    w.WriteNullValue();
                    continue;
                }

                w.WriteStartArray();
                w.WriteNumberValue(Math.Round(v.Place, 5));
                w.WriteNumberValue(v.Value);
                w.WriteStringValue(v.Text);
                // On a stack, the series' own value too: where the stack closes up under it, its top.
                var own = model.Series[s].Data.Values[i];
                if (own is { } o && o != v.Value && model.ValueTexts[s][i] is { } ownText && !full)
                {
                    w.WriteNumberValue(model.Series[s].Data.Secondary ? 1 : 0);
                    w.WriteNumberValue(o);
                    w.WriteStringValue(ownText);
                }
                else if (model.Series[s].Data.Secondary) w.WriteNumberValue(1);

                w.WriteEndArray();
            }

            w.WriteEndArray();
            w.WriteEndArray();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

