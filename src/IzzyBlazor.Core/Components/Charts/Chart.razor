                            if (hrefs[d] is null || !(place is >= -1e-9 and <= 1 + 1e-9)) continue;
                            var from = Math.Max(0, place - band / 2);
                            <a href="@hrefs[d]" tabindex="-1" draggable="false" data-ib-drill="@d" style="@(horizontal ? $"top:{Pct(from)};height:{Pct(band)};left:0;right:0" : $"left:{Pct(from)};width:{Pct(band)};top:0;bottom:0")"></a>
                        }
                    </div>
                }
                @if (tooltip)
                {
                    <div class="ib-chart-tooltip" hidden></div>
                }
                @if (model.ZoomPositions is not null)
                {
                    @* The box a drag draws (chart.css). *@
                    <div class="ib-chart-brush" aria-hidden="true"></div>
                }
            </div>
            @if (valueRight)
            {
                @FirstSide(side, horizontal, redraw, right: true, zoom: model.ZoomPositions is not null)
                @if (sideTitle is not null)
                {
                    <div class="ib-chart-title ib-chart-title-side2">@TitleKey(model, dual, secondary: false)@sideTitle</div>
                }
            }
            else if (dual)
            {
                @* The second value axis, after the plot. *@
                @SecondSide(model, right: true)
                @if (SecondaryTitle is not null)
                {
                    <div class="ib-chart-title ib-chart-title-side2">@TitleKey(model, dual, secondary: true)@SecondaryTitle</div>
                }
            }
            <div class="@(BottomClass(model, horizontal) + ((horizontal ? HideValueAxis : HideArgumentAxis) ? " ib-chart-off" : ""))" style="@room">
                <div class="@(horizontal ? "ib-chart-ticks ib-chart-values" : "ib-chart-ticks")">
                    @foreach (var label in bottom)
                    {
                        <span class="@(label.From > 0 ? $"ib-chart-from{label.From}" : null)" style="left:@Pct(label.Pos)" title="@label.Title">@label.Text@if (label.Context is { } context)
                            {<span class="ib-chart-context">@context</span>}</span>
                    }
                </div>
                @if (redraw && horizontal)
                {
                    <div class="ib-chart-ticks ib-chart-values ib-chart-js"></div>
                }
                @if (model.ZoomPositions is not null && !horizontal)
                {
                    @* The argument labels the script draws zoomed in. *@
                    <div class="ib-chart-ticks ib-chart-js ib-chart-zargs"></div>
                }
            </div>
            @if (bottomTitle is not null)
            {
                <div class="ib-chart-title ib-chart-title-bottom">@bottomTitle</div>
            }
        </div>
        }
        @if (selector is not null && model.ZoomPositions is not null)
        {
            @* Its own sheet, linked here, where the chart knows it has one. *@
            <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/range-selector.css"]" />
            @Selector(model, selector)
        }
        </div>
        @if (keyed && Place is not (ChartLegend.Top or ChartLegend.Start))
        {
            @LegendList(model, waterfall, marks, legend)
        }

        @if (tooltip)
        {
            @* Each item's tooltip, drawn here so a template is real Razor; the script shows the one
               under the pointer or keyboard focus, and says it in the live region. *@
            <div class="ib-chart-tips" hidden>
                @for (var i = 0; i < items.Count; i++)
                {
                    var tip = TooltipFor(items, model, i);
                    <div data-ib-tip data-ib-c="@(Crosshair ? CrossData(model, i, Stacked == ChartStacking.Percent) : null)">
                        @if (TooltipTemplate is not null)
                        {
                            @TooltipTemplate(tip)
                        }
                        else
                        {
                            <div class="ib-chart-tooltip-title">@tip.Argument</div>
                            @if (boxes)
                            {
                                @BoxTip(model, i)
                            }
                            else
                            {
                            @for (var p = 0; p < tip.Points.Count; p++)
                            {
                                var point = tip.Points[p];
                                if (point.Text is null) continue;
                                <div class="ib-chart-tooltip-row" data-ib-series="@p">
                                    <span class="ib-chart-tooltip-key" style="@KeyStyle(point)"></span>
                                    <span>@point.Series</span>
                                    <span class="ib-chart-tooltip-value">@point.Text</span>
                                </div>
                                @if (point.TargetText is not null)
                                {
                                    @* A bar's target, under its value. *@
                                    <div class="ib-chart-tooltip-row" data-ib-series="@p">
                                        <span class="ib-chart-tooltip-key"></span>
                                        <span>@TextDefaults.ChartTarget</span>
                                        <span class="ib-chart-tooltip-value">@point.TargetText</span>
                                    </div>
                                }
                                @if (point.SizeText is not null)
                                {
                                    @* A bubble's size, under its value. *@
                                    <div class="ib-chart-tooltip-row" data-ib-series="@p">
                                        <span class="ib-chart-tooltip-key"></span>
                                        <span>@point.SizeName</span>
                                        <span class="ib-chart-tooltip-value">@point.SizeText</span>
                                    </div>
                                }
                            }
                            }
                            @if (drill?.Hint is { } hint && drill.Hrefs![i] is not null)
                            {
                                <div class="ib-chart-tooltip-hint">@hint</div>
                            }
                        }
                    </div>
                }
            </div>
        }
        @if (tooltip || _zoomOn)
        {
            @* What the keys say and do; a chart that zooms has them with no tooltips too. *@
            <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
            <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@(!tooltip ? TextDefaults.ChartZoomOnlyKeys : _zoomOn ? TextDefaults.ChartZoomKeys : TextDefaults.ChartKeys)@(drill?.Hrefs is not null ? " " + TextDefaults.ChartDrillKeys : null)</span>
        }
        @if (model.MarkTexts.Count > 0)
        {
            <span id="@(_labelId)-marks" class="ib-visually-hidden">@string.Join("; ", model.MarkTexts)</span>
        }
        </ib-chart>

        @if (DataTable != ChartDataTable.None)
        {
            RenderFragment dataTable = @<div class="ib-chart-table-scroll">
                    <table class="ib-chart-table" aria-labelledby="@NameId">
                        @if (boxes)
                        {
                            @BoxTable(model)
                        }
                        else
                        {
                        <thead>
                            <tr>
                                <th scope="col">@(drill?.LevelName ?? ArgumentTitle ?? (bins is null ? _argumentName : binsName) ?? TextDefaults.ChartItem)</th>
                                @foreach (var s in model.Series)
                                {
                                    <th scope="col">@s.Data.Name</th>
                                    @if (model.SizeTexts[s.Index] is not null)
                                    {
                                        <th scope="col">@SizeHeader(model, s)</th>
                                    }
                                    @if (model.TargetTexts[s.Index] is not null)
                                    {
                                        <th scope="col">@TargetHeader(model, s)</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < model.ArgumentTexts.Length; i++)
                            {
                                var row = i;
                                <tr>
                                    <th scope="row">@if (drill?.Hrefs?[row] is { } href)
                                    {<a href="@href">@model.ArgumentTexts[row]</a>}
                                    else
                                    {@model.ArgumentTexts[row]}</th>
                                    @for (var s = 0; s < model.Series.Count; s++)
                                    {
                                        <td>@model.ValueTexts[s][row]</td>
                                        @if (model.SizeTexts[s] is { } sizes)
                                        {
                                            <td>@sizes[row]</td>
                                        }
                                        @if (model.TargetTexts[s] is { } targets)
                                        {
                                            <td>@targets[row]</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                        }
                    </table>
                </div>;
            @ChartTools.Data(DataTable, _labelId, Title, TitledBy, TextDefaults, dataTable)
        }
    }

    // A histogram's chart holds histograms only, upright, on bins it doesn't zoom across.
    private void CheckHistogram(ChartDrillState<TItem>? drill)
    {
        string? problem = null;
        if (_context.Series.FirstOrDefault(s => !s.IsHistogram) is { } other)
            problem = $"A histogram's chart holds only ChartHistogramSeries: {other.GetType().Name.Split('`')[0]} plots items at an Argument, which a histogram's bins aren't. Draw it in a chart of its own.";
        else if (Argument is not null)
            problem = "A histogram's bins are its argument: leave the Chart's Argument out.";
        else if (drill is not null)
            problem = "A histogram doesn't drill down: leave out the ChartDrillLevels.";
        else if (Orientation == Orientation.Horizontal)
            problem = "A histogram's bins run along the bottom: leave the Chart's Orientation vertical.";
        else if (_argumentAxis?.Zoom == true || _context.Selector is not null || View is not null)
            problem = "A histogram doesn't zoom: give its series narrower Bins to see the values closer.";
        else if (TooltipTemplate is not null)
            problem = "A histogram's tooltip has no item to show, only each bin's counts: leave out the ChartTooltip.";
        else if (_argumentAxis?.Logarithmic == true)
            problem = "A histogram's bins are equal widths on a straight scale: leave the ChartArgumentAxis's Logarithmic off.";
        if (problem is not null) throw new InvalidOperationException(problem);
    }

    // A box plot's tooltip: a column for the median and one for the middle half (and the mean),
    // headed once (chart.css draws the headings, so the live region doesn't say them twice), and
    // each number named for screen readers.
    private RenderFragment BoxTip(ChartModel model, int i) => __builder =>
    {
        var mean = model.Series.Any(s => s.Data.ShowMean);
        <div class="ib-chart-tooltip-row">
            <span></span><span></span>
            <span class="ib-chart-tooltip-value ib-chart-tooltip-box" data-ib-label="@TextDefaults.ChartMedian"></span>
            <span class="ib-chart-tooltip-value" data-ib-label="@TextDefaults.ChartBoxMiddle"></span>
            @if (mean)
            {
                <span class="ib-chart-tooltip-value ib-chart-tooltip-mean" data-ib-label="@TextDefaults.ChartMean"></span>
            }
        </div>
        @foreach (var s in model.Series)
        {
            if (model.BoxTexts[s.Index]?[i] is not { } t) continue;
            <div class="ib-chart-tooltip-row" data-ib-series="@s.Index">
                <span class="ib-chart-tooltip-key" style="@($"background:{SeriesColor(s)}")"></span>
                <span>@s.Data.Name</span>
                <span class="ib-chart-tooltip-value"><span class="ib-visually-hidden">@($", {TextDefaults.ChartMedian} ")</span>@t[0]</span>
                <span class="ib-chart-tooltip-value"><span class="ib-visually-hidden">@($", {TextDefaults.ChartBoxMiddle} ")</span>@t[1] – @t[2]</span>
                @if (mean)
                {
                    <span class="ib-chart-tooltip-value">@if (s.Data.ShowMean && t[5].Length > 0)
                    {<span class="ib-visually-hidden">@($", {TextDefaults.ChartMean} ")</span>@t[5]}</span>
                }
            </div>
        }
    };

    // A box plot's table: a row for each box, and a column for each of its numbers.
    private RenderFragment BoxTable(ChartModel model) => __builder =>
    {
        var several = model.Series.Count > 1;
        var mean = model.Series.Any(s => s.Data.ShowMean);
        // Counted only from raw values; outliers only where a series has them.
        var counted = model.Series.Any(s => s.Data.Whiskers is not null);
        var outliers = counted || model.Series.Any(s => s.Data.Boxes?.Any(b => b?.Outliers.Length > 0) == true);
        <thead>
            <tr>
                <th scope="col">@(ArgumentTitle ?? _argumentName ?? TextDefaults.ChartItem)</th>
                @if (several)
                {
                    <th scope="col">@(model.Series[0].Data.GroupName ?? TextDefaults.ChartSeries)</th>
                }
                <th scope="col">@TextDefaults.ChartMedian</th>
                <th scope="col">@TextDefaults.ChartBoxQ1</th>
                <th scope="col">@TextDefaults.ChartBoxQ3</th>
                <th scope="col">@TextDefaults.ChartBoxLow</th>
                <th scope="col">@TextDefaults.ChartBoxHigh</th>
                @if (mean)
                {
                    <th scope="col">@TextDefaults.ChartMean</th>
                }
                @if (counted)
                {
                    <th scope="col">@TextDefaults.ChartBoxCount</th>
                }
                @if (outliers)
                {
                    <th scope="col">@TextDefaults.ChartBoxOutlierCount</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < model.ArgumentTexts.Length; i++)
            {
                foreach (var s in model.Series)
                {
                    if (model.BoxTexts[s.Index]?[i] is not { } t) continue;
                    <tr>
                        <th scope="row">@model.ArgumentTexts[i]</th>
                        @if (several)
                        {
                            <td>@s.Data.Name</td>
                        }
                        <td>@t[0]</td><td>@t[1]</td><td>@t[2]</td><td>@t[3]</td><td>@t[4]</td>
                        @if (mean)
                        {
                            <td>@(s.Data.ShowMean ? t[5] : null)</td>
                        }
                        @if (counted)
                        {
                            <td>@t[6]</td>
                        }
                        @if (outliers)
                        {
                            <td>@t[7]</td>
                        }
                    </tr>
                }
            }
        </tbody>
    };

    // A box plot's arguments, while it groups its items, for a message naming one.
    private List<object?> _drawnBox = [];

    // A box plot's chart holds box plots only, on groups it doesn't zoom across.
    private void CheckBoxPlot(ChartDrillState<TItem>? drill)
    {
        string? problem = null;
        if (_context.Series.FirstOrDefault(s => !s.IsBox) is { } other)
            problem = $"A box plot's chart holds only ChartBoxPlotSeries, ChartBoxSummarySeries and ChartViolinSeries: {other.GetType().Name.Split('`')[0]} plots each item, where a box stands for a group of them. Draw it in a chart of its own.";
        else if (drill is not null)
            problem = "A box plot doesn't drill down: leave out the ChartDrillLevels.";
        else if (_argumentAxis?.Zoom == true || _context.Selector is not null || View is not null)
            problem = "A box plot doesn't zoom: its boxes are groups, not a run of items.";
        else if (TooltipTemplate is not null)
            problem = "A box plot's tooltip has no item to show, only each box's numbers: leave out the ChartTooltip.";
        else if (Stacked != ChartStacking.None)
            problem = "A box plot doesn't stack: leave out the Chart's Stacking.";
        else if (Crosshair)
            problem = "A box plot takes no Crosshair: each box's numbers are in its tooltip.";
        if (problem is not null) throw new InvalidOperationException(problem);
    }

    // A box plot series' boxes, one for each argument's values; its Lows and Values become their
    // smallest and largest values, so the value axis takes in the outliers.
    private ChartSeriesData Boxed(ChartSeriesData data, int[] at, int count)
    {
        ChartBox?[] boxes;
        if (data.Summaries is { } given)
        {
            // Given: each item is its argument's box, one to a series.
            boxes = new ChartBox?[count];
            for (var i = 0; i < given.Length; i++)
            {
                if (at[i] < 0 || given[i] is not { } box) continue;
                if (boxes[at[i]] is not null)
                {
                    throw new InvalidOperationException($"A ChartBoxSummarySeries takes one item per box: \"{ChartLayout.ArgumentText(_drawnBox[at[i]], null, CultureInfo.CurrentCulture)}\" has two{(data.Name.Length > 0 ? $" in \"{data.Name}\"" : "")}. Split them with SeriesBy, or give them Arguments of their own.");
                }

                boxes[at[i]] = box;
            }
        }
        else
        {
            var groups = new List<double>?[count];
            for (var i = 0; i < data.Values.Length; i++)
            {
                if (at[i] >= 0 && data.Values[i] is { } v && double.IsFinite(v)) (groups[at[i]] ??= []).Add(v);
            }

            // A violin's box carries its values' density too.
            boxes = groups.Select(g =>
            {
                if (g is null) return null;
                var box = ChartBox.Of(g, data.Whiskers!.Value);
                return box is not null && data.Violin ? box with { Density = ChartBox.DensityOf(g, box.Min, box.Max) } : box;
            }).ToArray();
        }

        return data with
        {
            Boxes = boxes,
            Lows = boxes.Select(b => b?.Span.Lo).ToArray(),
            Values = boxes.Select(b => b?.Span.Hi).ToArray(),
        };
    }

    // The bins every histogram series shares, from all their values.
    private ChartHistogram Binned(List<ChartSeriesData> read)
    {
        // Split by SeriesBy with no items yet (still loading), there's no series to read: no bins.
        if (read.Count == 0)
        {
            return ChartHistogram.Build([], _context.Series[0].HistogramBins!, null, ArgumentFormatter, ArgumentFormat, CultureInfo.CurrentCulture);
        }

        var first = read[0].Bins!;
        if (read.Any(d => d.Bins != first))
        {
            throw new InvalidOperationException("A chart's histogram series share one set of bins: give them all the same Bins.");
        }

        var date = read.FirstOrDefault(d => d.Date is not null)?.Date;
        if (date is not null && read.Any(d => d.Date is null && d.Values.Any(v => v is not null)))
        {
            throw new InvalidOperationException("A chart's histogram series count all numbers or all dates, not both.");
        }

        return ChartHistogram.Build(read.SelectMany(d => d.Values).Where(v => v is not null).Select(v => v!.Value), first, date, ArgumentFormatter, ArgumentFormat, CultureInfo.CurrentCulture);
    }

    // How many of a series' values fall in each bin; an empty bin counts zero.
    private static double?[] Counts(double?[] values, ChartHistogram bins)
    {
        var counts = new double?[bins.Count];
        for (var i = 0; i < counts.Length; i++) counts[i] = 0;
        foreach (var v in values)
        {
            if (v is { } x && double.IsFinite(x)) counts[bins.IndexOf(x)]++;
        }

        return counts;
    }

    // Where the legend goes: Auto is above, under the title.
    private ChartLegend Place => Legend == ChartLegend.Auto ? ChartLegend.Top : Legend;

    // Where the legend sits: above or below in a row, or beside in a column (chart.css).
    private string? LegendClass => Place switch
    {
        ChartLegend.Top => "ib-chart-lg-top",
        ChartLegend.Start => "ib-chart-lg-start",
        ChartLegend.End => "ib-chart-lg-end",
        _ => null,
    };

    private string LegendListClass => LegendAlign switch
    {
        ChartAlign.Center => "ib-chart-legend ib-chart-legend-center",
        ChartAlign.End => "ib-chart-legend ib-chart-legend-end",
        _ => "ib-chart-legend ib-chart-legend-start",
    };

    // The legend: a waterfall's keys to its colors, or a toggle for each series.
    private RenderFragment LegendList(ChartModel model, ChartSeriesData? waterfall, string marks, bool toggles) => @<text>
        @if (waterfall is not null)
        {
            @* A waterfall's keys: what each color means. Not toggles: there's one series. *@
            var owner = model.Series[0];
            <ul class="@LegendListClass">
                @foreach (var (change, name) in WaterfallKeys(owner))
                {
                    <li class="@SeriesClass(owner, null)" style="@ColorStyle(owner)">
                        <span class="ib-chart-entry">
                            <svg class="ib-chart-key" width="24" height="12" aria-hidden="true">
                                <rect class="@ChangeClass(change)" x="6" y="1" width="12" height="10" />
                            </svg>
                            @name
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <ul class="@LegendListClass">
                @foreach (var s in toggles ? model.Series : [])
                {
                    <li class="@SeriesClass(s, null)" style="@ColorStyle(s)">
                        @* The script makes this a toggle button that hides and shows the series. *@
                        <span class="ib-chart-toggle" data-ib-series="@s.Index" data-ib-hidden="@Off(s)">
                        <svg class="ib-chart-key" width="24" height="12" aria-hidden="true">
                            @if (s.Data.Violin)
                            {
                                @* A violin with its slim box. *@
                                <path class="ib-chart-violin" d="M12 0C10 3 6.5 4.5 6.5 7S10 10 12 12C14 10 17.5 9.5 17.5 7S14 3 12 0Z" />
                                <g class="ib-chart-box ib-chart-box-in"><rect x="11" y="4" width="2" height="5" /></g>
                            }
                            else if (s.Data.IsBox)
                            {
                                @* A box on its whisker, with its median. *@
                                <g class="ib-chart-box"><line x1="12" x2="12" y1="0" y2="12" /><rect x="6.5" y="2.5" width="11" height="7" /><line class="ib-chart-median" x1="7" x2="17" y1="6" y2="6" /></g>
                            }
                            else if (s.Data.IsOhlc)
                            {
                                @* Two candles, up then down: what the colors and fills mean. *@
                                <g class="ib-chart-ohlc">
                                    <g class="ib-chart-up"><line x1="8.5" x2="8.5" y1="0" y2="12" /><rect x="5.5" y="3.5" width="6" height="6" /></g>
                                    <g class="ib-chart-down"><line x1="16.5" x2="16.5" y1="0" y2="12" /><rect x="13.5" y="2.5" width="6" height="7" /></g>
                                </g>
                            }
                            else if (s.Data.Type == ChartType.Bar)
                            {
                                <rect x="6" y="1" width="12" height="10" />
                            }
                            else
                            {
                                @if (s.Data.Type == ChartType.Bubble)
                                {
                                    <circle class="ib-chart-bubble" cx="12" cy="6" r="5" />
                                }
                                else if (s.Data.Type != ChartType.Scatter)
                                {
                                    <line class="@($"ib-chart-dash{s.Dash}{Trend(s)}")" x1="0" x2="24" y1="6" y2="6" />
                                }
                                @if (s.Markers)
                                {
                                    <use href="@($"#{marks}{s.Style % 4}")" x="12" y="6" />
                                }
                            }
                        </svg>
                        @s.Data.Name
                        </span>
                    </li>
                }
                @if (model.SizeKey is { } key)
                {
                    @SizeKeyItem(key)
                }
            </ul>
        }

    </text>;

    // A bubble chart's size key: what the sizes measure, then reference circles standing on one
    // base, each value level with its circle's top along a dotted leader. chart.css puts it in the
    // chart's top corner, across from the title.
    // The size key's drawing: the largest circle, standing on the base line.
    private static double SizeKeyHeight(List<(string Text, double R)> circles) => Math.Ceiling(circles.Max(c => c.R) * 2 + 2);

    private static RenderFragment SizeKeyItem((string Name, List<(string Text, double R)> Circles) key) => @<text>
        @{
            var big = key.Circles.Max(c => c.R);
            var height = SizeKeyHeight(key.Circles);
            var width = Math.Ceiling(big * 2 + 8);
        }
        <li class="ib-chart-size-key">
            <span>@key.Name</span>
            <svg width="@Num(width)" height="@Num(height)" aria-hidden="true">
                @foreach (var (_, r) in key.Circles)
                {
                    var top = height - 1 - r * 2;
                    <circle cx="@Num(big + 1)" cy="@Num(height - 1 - r)" r="@Num(r)" />
                    <line x1="@Num(big + 1)" x2="@Num(width)" y1="@Num(top)" y2="@Num(top)" />
                }
            </svg>
            <span class="ib-chart-size-texts" style="height:@(Num(height))px">
                @foreach (var (text, r) in key.Circles)
                {
                    <span style="top:@(Num(height - 1 - r * 2))px">@text</span>
                }
            </span>
        </li>
    </text>;

    // A bar's rounded end, and a waterfall bar's color by whether it adds, takes away or totals.
    private static string? BarClass(BarRect bar) =>
        ((bar.End is { } end ? $"ib-chart-end-{end}" : "") + (ChangeClass(bar.Change) is { } change ? " " + change : "")).Trim() is { Length: > 0 } c ? c : null;

    private static string? ChangeClass(string? change) => change switch
    {
        "up" => "ib-chart-up",
        "down" => "ib-chart-down",
        "total" => "ib-chart-total",
        _ => null,
    };

    // The keys a waterfall's bars need: rises, falls and totals, each when it has one.
    private List<(string Change, string Name)> WaterfallKeys(SeriesShape owner)
    {
        var keys = new List<(string, string)>();
        foreach (var (change, name) in new[] { ("up", TextDefaults.ChartIncrease), ("down", TextDefaults.ChartDecrease), ("total", TextDefaults.ChartTotal) })
        {
            if (owner.Bars.Any(b => b.Change == change)) keys.Add((change, name));
        }

        return keys;
    }

    // The palette, and a waterfall's or a price series' colors for rises and falls (on the chart, so the tooltips have them).
    private string? RootStyle(ChartModel model, ChartSeriesData? waterfall)
    {
