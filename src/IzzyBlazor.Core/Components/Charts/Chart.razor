@namespace IzzyBlazor
@typeparam TItem
@inherits LayoutItemBase
@attribute [CascadingTypeParameter(nameof(TItem))]
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions

@*
    Bars, lines, areas, scatter, bubbles and waterfalls over a list of items, drawn on the server: the chart is in the page's
    HTML, so it shows with no script and no circuit, prints, and fills its container's width.

    <Chart Items="months" Argument="m => m.Month" Title="Revenue and costs, 2026">
        <ChartValueAxis Format="C0" />
        <ChartBarSeries Value="m => m.Revenue" />
        <ChartBarSeries Value="m => m.Costs" />
        <ChartLineSeries Value="m => m.Target" />
    </Chart>

    Argument is what each item is plotted at: names and enums sit in bands, one per item; numbers
    and dates, on a line or area chart, sit on a scale (any chart with bars uses bands). Each
    series draws one value per item, as bars, a line, an area, points or bubbles; ChartValueAxis
    and ChartArgumentAxis set up the axes. Stacking stacks bars and areas; Orientation.Horizontal lays bars across, the arguments down the side.

    The text is HTML beside the plot, so it keeps its size at any width; at narrow widths every
    other label (or every fourth) hides so they don't crowd. --ib-chart-tick-color and
    --ib-chart-tick-size set the axis labels' color and size (the theme's muted text at
    --ib-text-xs by default); labels fit by Inter at 12px until the script measures them.
    --ib-chart-title-size and --ib-chart-title-weight set the title's size and weight
    (--ib-text-lg, semibold, by default) on every chart: Chart, PieChart, the heatmaps and the rest.

    Accessibility:
    - The chart is a figure captioned by Title, or named by a heading on the page with TitledBy.
    - The plot and its axes are one image named by the caption, so a screen reader hears the
      chart, not each tick.
    - "Show data" under the chart opens a table of every value (DataTable), with no script.
    - Lines differ by dash and marker shape as well as color; bars keep the legend's order.
    - The palette's colors are 3:1 against the surface in dark mode; in light mode pink, yellow,
      aqua and orange are lighter than that, which the legend, tooltips and table make up for.
      Palette's shades and diverging ramps keep their lightest step at about 2:1, so the data
      table matters more with them.
    - Reference lines and bands are read in the chart's description, such as "Target $150K:
      $150,000". Value labels are hidden from screen readers, since "Show data" has every value.
    - With script, the plot is one Tab stop that keeps the arrow keys, with a screen reader too:
      each move shows that item's tooltip and says its values.

    Keyboard:
    On the plot
    - Right, Down | Show the next item's values in the order shown, so Right moves right on a reversed
      axis too (on a scatter chart, the next point to the right)
    - Left, Up | Show the item before
    - Page Down, Page Up | Move a tenth of the items forward or back
    - Home, End | Go to the first or last item
    - Escape | Hide the tooltip
    See also: Stat, Table.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@(HideTitle ? "ib-visually-hidden" : TitleAlign switch { ChartAlign.Center => "ib-chart-label ib-chart-label-center", ChartAlign.End => "ib-chart-label ib-chart-label-end", _ => "ib-chart-label" })">@Title</figcaption>
    }
    <CascadingValue Value="_context" IsFixed="true">
        @ChildContent
        @PlotFragment
    </CascadingValue>
</figure>

@code {
    /// <summary>The items to chart, one point or bar per series for each.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// What each item is plotted at, such as <c>m =&gt; m.Month</c>: text, an enum, a number or a
    /// date. Text and enums are bands in item order; numbers and dates are a scale on a line or
    /// area chart.
    /// </summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Argument { get; set; } = default!;

    /// <summary>
    /// The chart's title, such as "Revenue by month", shown above it as its caption. It also names the chart
    /// for screen readers. A chart needs a Title or <see cref="TitledBy"/>.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Hides the title, which still names the chart for screen readers.</summary>
    [Parameter] public bool HideTitle { get; set; }

    /// <summary>
    /// Where the title sits: at the start, over the chart's first label, by default (the left, in
    /// a left-to-right page); <see cref="ChartAlign.Center"/> or <see cref="ChartAlign.End"/>.
    /// </summary>
    [Parameter] public ChartAlign TitleAlign { get; set; }

    /// <summary>
    /// The id of a heading already on the page that titles the chart, such as a card's, in place of
    /// <see cref="Title"/>: the chart takes its name from it and shows no title of its own.
    /// </summary>
    [Parameter] public string? TitledBy { get; set; }

    /// <summary>
    /// Whether bar and area series stack: <see cref="ChartStacking.Normal"/> puts each on top of
    /// the one before, so the stack's height is the total; <see cref="ChartStacking.Percent"/>
    /// draws each stack to 100%, so the parts show as shares of the whole. Lines never stack.
    /// </summary>
    [Parameter] public ChartStacking Stacking { get; set; }

    /// <summary>
    /// <see cref="Orientation.Vertical"/>, the default, draws upright columns with the arguments
    /// along the bottom; <see cref="Orientation.Horizontal"/> draws bars across, the arguments
    /// down the side, which suits long names.
    /// </summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    /// <summary>The plot's height. Defaults to 18rem. The chart is always as wide as its container.</summary>
    [Parameter] public Length? Height { get; set; }

    /// <summary>
    /// Shows a tooltip with every series' value for the item under the pointer, or under keyboard
    /// focus on the chart, with script. By default it's on unless every series writes its values
    /// as <see cref="ChartSeriesBase{TItem}.Labels"/>, which the tooltip would repeat; true or false
    /// decides. Off, the tooltips are left out of the page.
    /// </summary>
    [Parameter] public bool? Tooltip { get; set; }

    /// <summary>
    /// The colors in order: <see cref="ChartPalette.Colors"/> (the theme's eight, the default),
    /// <see cref="ChartPalette.Shades"/> of one color for series in an order,
    /// <see cref="ChartPalette.Diverging"/> for series either side of a middle, or your own with
    /// <see cref="ChartPalette.Of"/>.
    /// </summary>
    [Parameter] public ChartPalette? Palette { get; set; }

    /// <summary>
    /// The legend and where it goes: above the chart, under the title, when there are two series
    /// or more, by default, so its keys are read before the data; <see cref="ChartLegend.Top"/>, <see cref="ChartLegend.Bottom"/>,
    /// <see cref="ChartLegend.Start"/> or <see cref="ChartLegend.End"/> to always show it there,
    /// or <see cref="ChartLegend.None"/>. Beside the chart, it moves above or below under 30rem.
    /// </summary>
    [Parameter] public ChartLegend Legend { get; set; }

    /// <summary>
    /// Where the legend sits along its edge: at the start, by default (the left above or below
    /// the chart, the top beside it); <see cref="ChartAlign.Center"/> or <see cref="ChartAlign.End"/>.
    /// </summary>
    [Parameter] public ChartAlign LegendAlign { get; set; }

    /// <summary>The values as a table: in a closed "Show data" disclosure under the chart, by default.</summary>
    [Parameter] public ChartDataTable DataTable { get; set; }

    /// <summary>
    /// The part of the arguments in view, such as the last 30 days: the chart opens zoomed into
    /// it. Null (the default) shows every item. With <see cref="ChartArgumentAxis.Zoom"/> the
    /// reader zooms from there, and <see cref="ViewChanged"/> says where to (<c>@bind-View</c>).
    /// </summary>
    [Parameter] public ChartView? View { get; set; }

    /// <summary>
    /// Raised on an interactive page when the reader zooms or pans, as each gesture ends (not
    /// while dragging), with the arguments now in view; null when zoomed all the way out.
    /// </summary>
    [Parameter] public EventCallback<ChartView?> ViewChanged { get; set; }

    /// <summary>
    /// The series (<see cref="ChartBarSeries{TItem}"/>, <see cref="ChartLineSeries{TItem}"/>,
    /// <see cref="ChartAreaSeries{TItem}"/>, <see cref="ChartScatterSeries{TItem}"/>,
    /// <see cref="ChartBubbleSeries{TItem}"/>, <see cref="ChartWaterfallSeries{TItem}"/>), the axes (<see cref="ChartValueAxis"/>,
    /// <see cref="ChartArgumentAxis"/>), reference marks and a <see cref="ChartTooltip{TItem}"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // What the axes say, read when the plot draws.
    private ChartValueAxis? _valueAxis;
    private ChartValueAxis? _secondAxis;
    private ChartArgumentAxis? _argumentAxis;
    private ChartStacking Stacked => Stacking;
    private string? ValueFormat => _valueAxis?.Format;
    private Func<double, string>? ValueFormatter => _valueAxis?.Formatter;
    private double? ValueMin => _valueAxis?.Min;
    private double? ValueMax => _valueAxis?.Max;
    private double? ValueStep => _valueAxis?.Step;
    private bool ValueLog => _valueAxis?.Logarithmic ?? false;
    private string? ValueTitle => _valueAxis?.Title;
    private bool HideValueAxis => _valueAxis?.HideLabels ?? false;
    private bool ValueGrid => _valueAxis?.GridLines ?? true;
    private string? SecondaryFormat => _secondAxis?.Format;
    private double? SecondaryMin => _secondAxis?.Min;
    private double? SecondaryMax => _secondAxis?.Max;
    private string? SecondaryTitle => _secondAxis?.Title;
    private string? ArgumentFormat => _argumentAxis?.Format;
    private Func<object?, string>? ArgumentFormatter => _argumentAxis?.Formatter;
    private string? ArgumentTitle => _argumentAxis?.Title;
    private bool HideArgumentAxis => _argumentAxis?.HideLabels ?? false;
    private ChartLabelFit ArgumentLabels => _argumentAxis?.LabelFit ?? ChartLabelFit.Skip;
    private bool ArgumentGrid => _argumentAxis?.GridLines ?? false;
    private RenderFragment<ChartTooltipContext<TItem>>? TooltipTemplate => _context.TooltipTemplate;

    private readonly string _labelId = IdGenerator.Next("ib-chart");

    // What names the chart: its own caption, or the heading TitledBy points at.
    private string NameId => TitledBy ?? _labelId;
    private ChartContext<TItem> _context = null!;
    private Expression<Func<TItem, object?>>? _lastArgument;
    private Func<TItem, object?>? _argument;
    private string? _argumentName;
    private string? _class;
    private string? _style;
    private RenderFragment PlotFragment = null!;

    private static string Pct(double value) => (value * 100).ToString("0.###", CultureInfo.InvariantCulture) + "%";

    private static string Num(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _context = new ChartContext<TItem>();
        PlotFragment = builder =>
        {
            builder.OpenComponent<ChartPlot>(0);
            builder.AddComponentParameter(1, nameof(ChartPlot.Content), (RenderFragment)RenderPlot);
            builder.AddComponentParameter(2, nameof(ChartPlot.Attach), (Action<ChartPlot>)(plot => _context.Plot = plot));
            builder.CloseComponent();
        };
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-chart");
        base.BuildAttributes(classes, styles);
    }

    // The arguments last drawn and what they are, which the script's view is a share of.
    private IReadOnlyList<object?> _drawnArguments = [];
    private ArgumentKind _drawnKind;
    private bool _zoomOn;

    // The view drawn: View, or on an interactive page where the reader zoomed to since it was set.
    private ChartView? _view;
    private ChartView? _viewSet;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!Equals(View, _viewSet)) (_view, _viewSet) = (View, View);

        if (string.IsNullOrWhiteSpace(Title) == string.IsNullOrWhiteSpace(TitledBy))
        {
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(Title)
                ? "Chart needs a Title, such as \"Revenue by month\", or TitledBy, the id of a heading on the page that titles it."
                : "Chart takes a Title or TitledBy, not both: TitledBy names it from a heading already on the page.");
        }

        if (Argument is null)
        {
            throw new InvalidOperationException("Chart needs an Argument, what each item is plotted at, such as m => m.Month.");
        }

        if (!ReferenceEquals(Argument, _lastArgument))
        {
            _lastArgument = Argument;
            _argument = Argument.Compile();
            _argumentName = ChartMembers.Name(Argument);
        }

        base.OnParametersSet();
        _context.BeginPass();
        (_class, _style) = BuildRootAttributes();
    }

    /// <summary>Finds the value axes and the argument axis among the chart's children.</summary>
    private void ReadAxes()
    {
        var values = _context.Axes.OfType<ChartValueAxis>().ToList();
        var arguments = _context.Axes.OfType<ChartArgumentAxis>().ToList();
        if (values.Count > 2)
        {
            throw new InvalidOperationException("A Chart has at most two ChartValueAxis: the first, and a second with a Name at the end side.");
        }

        if (arguments.Count > 1)
        {
            throw new InvalidOperationException("A Chart has one ChartArgumentAxis.");
        }

        // The first value axis has no name; a named one is the second, at the end side.
        if (values.Count(a => a.Name is null) > 1)
        {
            throw new InvalidOperationException("A Chart's second ChartValueAxis needs a Name, which its series give as their ValueAxis.");
        }

        if (values.Count(a => a.Name is not null) > 1)
        {
            throw new InvalidOperationException("A Chart has at most two ChartValueAxis: the first, and a second with a Name at the end side.");
        }

        _valueAxis = values.FirstOrDefault(a => a.Name is null);
        _secondAxis = values.FirstOrDefault(a => a.Name is not null);
        _argumentAxis = arguments.FirstOrDefault();
        if (_secondAxis is { } second)
        {
            if (second.Step is not null || second.Logarithmic || second.Formatter is not null || second.HideLabels)
            {
                throw new InvalidOperationException("A second ChartValueAxis takes Format, Min, Max and Title: its ticks fall on the first axis's grid lines.");
            }

            foreach (var series in _context.Series)
            {
                IsSecond(series.ValueAxis, $"The series \"{series.DisplayName}\"");
            }

            if (!_context.Series.Any(s => s.ValueAxis == second.Name))
            {
                throw new InvalidOperationException($"The ChartValueAxis named \"{second.Name}\" has no series: give one ValueAxis=\"{second.Name}\".");
            }
        }

        var position = _valueAxis?.Position ?? ChartAxisPosition.Auto;
        if (Orientation == Orientation.Horizontal ? position is ChartAxisPosition.Left or ChartAxisPosition.Right : position is ChartAxisPosition.Bottom or ChartAxisPosition.Top)
        {
            throw new InvalidOperationException(Orientation == Orientation.Horizontal
                ? "A horizontal Chart's values run along the bottom or the top: give its ChartValueAxis Position Bottom or Top."
                : "An upright Chart's values run up the left or the right: give its ChartValueAxis Position Left or Right.");
        }

        if (ValueLog && Stacking == ChartStacking.Percent)
        {
            throw new InvalidOperationException("A Chart can't use a logarithmic value axis with Stacking=\"ChartStacking.Percent\": shares of a whole read on a straight scale.");
        }
    }

    /// <summary>Whether a series or mark asking for a value axis by name is on the second one.</summary>
    private bool IsSecond(string? name, string what)
    {
        if (name is null)
        {
            return false;
        }

        if (name == _secondAxis?.Name)
        {
            return true;
        }

        throw new InvalidOperationException($"{what}'s ValueAxis \"{name}\" isn't a ChartValueAxis on the chart: give the axis that Name.");
    }

    private ChartSeriesData OnAxis(ChartSeriesData data) => data with { Secondary = IsSecond(data.ValueAxis, $"The series \"{data.Name}\"") };

    private ChartMarkInput OnAxis(ChartMarkInput mark)
    {
        if (mark.Axis != MarkAxis.Value)
        {
            return mark;
        }

        // A statistic is read on its series' axis unless it says otherwise.
        var name = mark.ValueAxis ?? (mark.Series is { } series ? _context.Series.FirstOrDefault(s => s.DisplayName == series)?.ValueAxis : null);
        return IsSecond(name, "A reference mark") ? mark with { Axis = MarkAxis.Secondary } : mark;
    }

    private static double HeightInPixels(Length? height)
    {
        var css = height?.Css;
        if (css is null) return 288;
        var match = System.Text.RegularExpressions.Regex.Match(css, @"^([\d.]+)(px|rem)$");
        return match.Success && double.TryParse(match.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var v)
            ? match.Groups[2].Value == "rem" ? v * 16 : v
            : 288;
    }

    private void RenderPlot(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        var items = Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];
        var arguments = items.Select(_argument!).ToList();
        ReadAxes();
        var series = ChartTrends.Add(_context.Series.SelectMany(s => s.Read(items)).Select(OnAxis).ToList(), arguments, TextDefaults);
        // Off by default when every series writes its values beside them; labels of other text keep it.
        var tooltip = Tooltip ?? !(series.Count > 0 && series.All(s => s.Labels != ChartLabels.None && s.LabelTexts is null));
        if (series.Any(s => s.Secondary))
        {
            if (Orientation == Orientation.Horizontal)
            {
                throw new InvalidOperationException("A Chart's second value axis needs upright bars or lines: leave Orientation Vertical, or use two charts.");
            }

            if (Stacked != ChartStacking.None && series.Any(s => s.Secondary && s.Type is ChartType.Bar or ChartType.Area))
            {
                throw new InvalidOperationException("A stacked Chart's bars and areas stay on one axis: put a line on the second axis, or leave Stacking off.");
            }
        }
        if (Orientation == Orientation.Horizontal && series.Any(s => s.EndLabel))
        {
            throw new InvalidOperationException("A series' EndLabel needs an upright chart, where lines end at the right: leave Orientation Vertical.");
        }

        var waterfall = series.FirstOrDefault(s => s.IsWaterfall);
        if (waterfall is not null)
        {
            if (series.Count > 1)
            {
                throw new InvalidOperationException("A ChartWaterfallSeries is its chart's only series: draw other measures in a chart of their own.");
            }

            if (Stacked != ChartStacking.None)
            {
                throw new InvalidOperationException("A waterfall doesn't stack: leave the Chart's Stacking off.");
            }

            if (ValueLog)
            {
                throw new InvalidOperationException("A waterfall reads on a straight scale: its changes add up. Leave the ChartValueAxis's Logarithmic off.");
            }
        }

        // A waterfall's legend keys its three colors, by default; its keys don't hide anything.
        // Series named at their ends need none.
        var legend = Legend is not (ChartLegend.Auto or ChartLegend.None)
            || (Legend == ChartLegend.Auto && (series.Count > 1 || waterfall is not null) && !series.All(s => s.EndLabel));

        // Hidden needs a legend to show the series again: with none (or a waterfall's), it's drawn.
        if (!legend || waterfall is not null) series = series.Select(s => s with { Hidden = false }).ToList();
        var horizontal = Orientation == Orientation.Horizontal;
        // The reader zooms in the script, which draws the chart again for each view; not a waterfall.
        var zoom = _argumentAxis?.Zoom == true && waterfall is null && arguments.Count > 1;
        var model = ChartLayout.Build(new ChartInput(arguments, series)
        {
            Stacked = Stacked,
            Horizontal = horizontal,
            HeightPx = HeightInPixels(Height),
            ValueFormat = ValueFormat,
            ArgumentFormat = ArgumentFormat,
            ValueMin = ValueMin,
            ValueMax = ValueMax,
            ValueStep = ValueStep,
            ValueLog = ValueLog,
            ArgumentLog = _argumentAxis?.Logarithmic ?? false,
            ArgumentReverse = _argumentAxis?.Reverse ?? false,
            View = _view,
            MinZoomSpan = Math.Max(1, _argumentAxis?.MinZoomSpan ?? 2),
            Zoom = zoom,
            ValueRight = !horizontal && _valueAxis?.Position == ChartAxisPosition.Right,
            ValueGrid = ValueGrid,
            ArgumentGrid = ArgumentGrid,
            ArgumentLabels = ArgumentLabels,
            ValueFormatter = ValueFormatter,
            ArgumentFormatter = ArgumentFormatter,
            HideValueAxis = HideValueAxis,
            HideArgumentAxis = HideArgumentAxis,
            Marks = _context.Marks.Select(m => m.Read()).Select(OnAxis).ToList(),
            SecondaryFormat = SecondaryFormat,
            SecondaryMin = SecondaryMin,
            SecondaryMax = SecondaryMax,
            Text = TextDefaults,
        });
        (_drawnArguments, _drawnKind) = (arguments, model.Kind);
        _zoomOn = model.ZoomPositions is not null;
        var side = horizontal ? model.ArgumentLabels : model.ValueLabels;
        var bottom = horizontal ? model.ValueLabels : model.ArgumentLabels;
        var marks = _labelId + "-m";
        // With a legend, the script draws the chart again without the series it hides.
        var shape = (legend || zoom) && waterfall is null ? NumberShape.Of(Stacked == ChartStacking.Percent ? "P0" : ValueFormat, CultureInfo.CurrentCulture) : null;
        var redraw = shape is not null;
        var room = model.Wrap && !horizontal
            ? $"--ib-chart-n:{Num(model.BandCount)}"
            : model.LabelRoom is { } r && !horizontal
            ? string.Concat(r.Select((w, k) => $"--ib-chart-w{k}:{Num(w)}%;"))
            : null;
        var sideTitle = horizontal ? ArgumentTitle : ValueTitle;
        var dual = model.SecondaryLabels.Count > 0;
        var mixed = model.Series.Any(s => s.Bars.Count > 0) && model.Series.Any(s => s.Line is not null || s.Marks.Count > 0);
        var bottomTitle = horizontal ? ValueTitle : ArgumentTitle;
        var valueRight = !horizontal && _valueAxis?.Position == ChartAxisPosition.Right;

        @* A bubble chart's size key goes where the legend does, with or without the series' keys. *@
        var keyed = legend || (Legend != ChartLegend.None && model.SizeKey is not null);
        @* In the top corner, across from the title, when the chart is wide enough (chart.css). *@
        var cornerKey = keyed && model.SizeKey is not null && TitledBy is null && !HideTitle && Place is ChartLegend.Top or ChartLegend.Bottom;
        <ib-chart class="@(keyed ? LegendClass + (Stacking != ChartStacking.None && !horizontal ? " ib-chart-stack-up" : "") + (cornerKey ? " ib-chart-kc" : "") : null)" style="@RootStyle(model, waterfall)"
                  data-ib-count="@model.ArgumentTexts.Length"
                  data-ib-scale="@(model.Kind == ArgumentKind.Category ? null : "")"
                  data-ib-horizontal="@(horizontal ? "" : null)"
                  data-ib-reverse="@(_argumentAxis?.Reverse == true ? "" : null)"
                  data-ib-zoom="@(model.ZoomPositions is not null ? "" : null)"
                  data-ib-interactive="@(model.ZoomPositions is not null && RendererInfo.IsInteractive ? "" : null)"
                  @oniblayout="OnView" __internal_stopPropagation_oniblayout="@RendererInfo.IsInteractive"
                  data-ib-view="@(model.View?.Share is { } share ? $"{Num(share.F0)} {Num(share.F1)}" : null)"
                  data-ib-points="@(model.Series.Any(s => s.Data.IsPoint) ? "" : null)"
                  data-ib-pos="@Positions(model)"
                  data-ib-draw="@(redraw ? DrawData(model, shape!, horizontal, marks) : null)">
        @if (keyed && Place is ChartLegend.Top or ChartLegend.Start)
        {
            @LegendList(model, waterfall, marks, legend)
        }
        @* Its own size container, so the labels fit the plot's width with a legend beside it. *@
        <div class="ib-chart-main">
        <div class="@FrameClass(model, sideTitle, horizontal && _valueAxis?.Position == ChartAxisPosition.Top)" role="img" aria-labelledby="@NameId" aria-describedby="@(model.MarkTexts.Count > 0 ? $"{_labelId}-marks" : null)" style="@FrameStyle(model, sideTitle is not null, valueRight)">
            @if (valueRight)
            {
                @if (dual)
                {
                    @* The second value axis, at the left when the first is at the right. *@
                    @if (SecondaryTitle is not null)
                    {
                        <div class="ib-chart-title ib-chart-title-side">@TitleKey(model, dual, secondary: true)@SecondaryTitle</div>
                    }
                    @SecondSide(model, right: false)
                }
            }
            else
            {
                @if (sideTitle is not null)
                {
                    <div class="ib-chart-title ib-chart-title-side">@TitleKey(model, dual, secondary: false)@sideTitle</div>
                }
                @FirstSide(side, horizontal, redraw, right: false, zoom: model.ZoomPositions is not null)
            }
            <div class="ib-chart-plot">
                @if (tooltip)
                {
                    @* The band or line under the pointer: the script places it. *@
                    <div class="ib-chart-hover" hidden></div>
                }
                @if (model.Marks.Any(m => m.Kind == ChartMarkKind.Band))
                {
                    @* Reference bands, under the series. *@
                    <div class="ib-chart-under" aria-hidden="true">
                        @foreach (var mark in model.Marks.Where(m => m.Kind == ChartMarkKind.Band))
                        {
                            @MarkElement(mark, horizontal)
                        }
                    </div>
                }
                <svg class="@(mixed ? "ib-chart-svg ib-chart-mixed" : "ib-chart-svg")">
                    <defs>
                        @* Markers, a little larger than the line is wide and with no halo, so they read on a
                           bar and on the plain surface alike: a circle, square, triangle and diamond. *@
                        <path id="@(marks)0" d="M-5,0a5,5 0 1,0 10,0a5,5 0 1,0 -10,0" />
                        <path id="@(marks)1" d="M-4.5,-4.5h9v9h-9z" />
                        <path id="@(marks)2" d="M0,-6.2L5.8,4.2H-5.8Z" />
                        <path id="@(marks)3" d="M0,-6.2L6.2,0L0,6.2L-6.2,0Z" />
                    </defs>
                    @foreach (var line in model.Grid.Where(l => l.Argument || ValueGrid || l.Zero))
                    {
                        @* Values run up (or across, for bars across); arguments across (or down from the top). *@
                        var upright = horizontal != line.Argument;
                        var y = line.Argument ? Pct(line.Pos) : Pct(1 - line.Pos);
                        <line class="@GridClass(line)"
                              x1="@(upright ? Pct(line.Pos) : "0")" x2="@(upright ? Pct(line.Pos) : "100%")"
                              y1="@(upright ? "0" : y)" y2="@(upright ? "100%" : y)" />
                    }
                    <svg class="ib-chart-paths" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                        @foreach (var s in model.Series.Where(s => s.Area is not null))
                        {
                            <path class="@SeriesClass(s, "ib-chart-area")" style="@ColorStyle(s)" d="@s.Area" data-ib-series="@s.Index" data-ib-hidden="@Off(s)" />
                        }
                        @foreach (var s in model.Series.Where(s => s.Connectors is not null))
                        {
                            <path class="ib-chart-connect" d="@s.Connectors" />
                        }
                    </svg>
                    @foreach (var s in model.Series.Where(s => s.Bars.Count > 0))
                    {
                        <g class="@SeriesClass(s, "ib-chart-bars")" style="@ColorStyle(s)" data-ib-series="@s.Index" data-ib-hidden="@Off(s)">
                            @foreach (var bar in s.Bars)
                            {
                                <rect class="@BarClass(bar)" x="@Num(bar.X)%" y="@Num(bar.Y)%" width="@Num(bar.Width)%" height="@Num(bar.Height)%">@if (tooltip)
                                {<title>@bar.Title</title>}</rect>
                            }
                        </g>
                    }
                    <svg class="ib-chart-paths ib-chart-lines" viewBox="0 0 1000 1000" preserveAspectRatio="none">
                        @foreach (var s in model.Series.Where(s => s.Line is not null))
                        {
                            <path class="@SeriesClass(s, $"ib-chart-line ib-chart-dash{s.Dash}{Trend(s)}")" style="@ColorStyle(s)" d="@s.Line" data-ib-series="@s.Index" data-ib-hidden="@Off(s)" />
                        }
                    </svg>
                    @foreach (var s in model.Series.Where(s => s.Marks.Count > 0))
                    {
                        <g class="@SeriesClass(s, s.Data.IsPoint ? "ib-chart-marks ib-chart-scatter" : "ib-chart-marks")" style="@ColorStyle(s)" data-ib-series="@s.Index" data-ib-hidden="@Off(s)">
                            @foreach (var mark in s.Marks)
                            {
                                @if (mark.R is { } radius)
                                {
                                    <circle class="ib-chart-bubble" cx="@Num(mark.X)%" cy="@Num(mark.Y)%" r="@Num(radius)" data-ib-i="@mark.Index">@if (tooltip)
                                    {<title>@mark.Title</title>}</circle>
                                    continue;
                                }
                                <use href="@($"#{marks}{s.Style % 4}")" x="@Num(mark.X)%" y="@Num(mark.Y)%" data-ib-i="@mark.Index">@if (tooltip)
                                {<title>@mark.Title</title>}</use>
                            }
                        </g>
                    }
                </svg>
                @if (redraw)
                {
                    @* The plot the script draws when the legend hides a series. *@
                    <svg class="ib-chart-svg ib-chart-js"></svg>
                }
                @if (model.Marks.Any(m => m.Kind != ChartMarkKind.Band))
                {
                    @* Reference lines and notes, over the series; the description says them. *@
                    <div class="ib-chart-over" aria-hidden="true">
                        @foreach (var mark in model.Marks.Where(m => m.Kind != ChartMarkKind.Band))
                        {
                            @MarkElement(mark, horizontal)
                        }
                    </div>
                }
                @if (model.DataLabels.Count > 0 || model.LabelTexts.Any(t => t is not null))
                {
                    @* The series' value labels; screen readers have the data table instead. *@
                    <div class="ib-chart-dl" aria-hidden="true">
                        @foreach (var label in model.DataLabels)
                        {
                            var owner = model.Series[label.Series];
                            <span class="@LabelClass(label, owner)" style="left:@LabelLeft(label);top:calc(@Pct(label.AY) + @Num(label.DY)px);@ColorStyle(owner)" data-ib-series="@label.Series">@label.Text</span>
                        }
                    </div>
                    @if (redraw)
                    {
                        <div class="ib-chart-dl ib-chart-js" aria-hidden="true"></div>
                    }
                }
                @if (model.EndLabels.Count > 0 || (redraw && series.Any(s => s.EndLabel)))
                {
                    @* Series' names past the plot's end, level with their last values; the legend's
                       and the data table's names say them to screen readers. *@
                    <div class="ib-chart-ends" aria-hidden="true">
                        @foreach (var end in model.EndLabels)
                        {
                            var owner = model.Series[end.Series];
                            <span class="@SeriesClass(owner, null)" style="top:@Pct(end.Pos);@ColorStyle(owner)" data-ib-series="@end.Series">@end.Text</span>
                        }
                    </div>
                    @if (redraw)
                    {
                        <div class="ib-chart-ends ib-chart-js" aria-hidden="true"></div>
                    }
                }
                @if (tooltip)
                {
                    <div class="ib-chart-tooltip" hidden></div>
                }
                @if (model.ZoomPositions is not null)
                {
                    @* The box a drag draws, and the button shown while zoomed in (chart.css). *@
                    <div class="ib-chart-brush" aria-hidden="true"></div>
                    <button type="button" class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm ib-chart-reset">@TextDefaults.ChartResetZoom</button>
                }
            </div>
            @if (valueRight)
            {
                @FirstSide(side, horizontal, redraw, right: true, zoom: model.ZoomPositions is not null)
                @if (sideTitle is not null)
                {
                    <div class="ib-chart-title ib-chart-title-side2">@TitleKey(model, dual, secondary: false)@sideTitle</div>
                }
            }
            else if (dual)
            {
                @* The second value axis, after the plot. *@
                @SecondSide(model, right: true)
                @if (SecondaryTitle is not null)
                {
                    <div class="ib-chart-title ib-chart-title-side2">@TitleKey(model, dual, secondary: true)@SecondaryTitle</div>
                }
            }
            <div class="@(BottomClass(model, horizontal) + ((horizontal ? HideValueAxis : HideArgumentAxis) ? " ib-chart-off" : ""))" style="@room">
                <div class="@(horizontal ? "ib-chart-ticks ib-chart-values" : "ib-chart-ticks")">
                    @foreach (var label in bottom)
                    {
                        <span class="@(label.From > 0 ? $"ib-chart-from{label.From}" : null)" style="left:@Pct(label.Pos)" title="@label.Title">@label.Text@if (label.Context is { } context)
                            {<span class="ib-chart-context">@context</span>}</span>
                    }
                </div>
                @if (redraw && horizontal)
                {
                    <div class="ib-chart-ticks ib-chart-values ib-chart-js"></div>
                }
                @if (model.ZoomPositions is not null && !horizontal)
                {
                    @* The argument labels the script draws zoomed in. *@
                    <div class="ib-chart-ticks ib-chart-js ib-chart-zargs"></div>
                }
            </div>
            @if (bottomTitle is not null)
            {
                <div class="ib-chart-title ib-chart-title-bottom">@bottomTitle</div>
            }
        </div>
        </div>
        @if (keyed && Place is not (ChartLegend.Top or ChartLegend.Start))
        {
            @LegendList(model, waterfall, marks, legend)
        }

        @if (tooltip)
        {
            @* Each item's tooltip, drawn here so a template is real Razor; the script shows the one
               under the pointer or keyboard focus, and says it in the live region. *@
            <div class="ib-chart-tips" hidden>
                @for (var i = 0; i < items.Count; i++)
                {
                    var tip = TooltipFor(items, model, i);
                    <div data-ib-tip>
                        @if (TooltipTemplate is not null)
                        {
                            @TooltipTemplate(tip)
                        }
                        else
                        {
                            <div class="ib-chart-tooltip-title">@tip.Argument</div>
                            @for (var p = 0; p < tip.Points.Count; p++)
                            {
                                var point = tip.Points[p];
                                if (point.Text is null) continue;
                                <div class="ib-chart-tooltip-row" data-ib-series="@p">
                                    <span class="ib-chart-tooltip-key" style="@KeyStyle(point)"></span>
                                    <span>@point.Series</span>
                                    <span class="ib-chart-tooltip-value">@point.Text</span>
                                </div>
                                @if (point.SizeText is not null)
                                {
                                    @* A bubble's size, under its value. *@
                                    <div class="ib-chart-tooltip-row" data-ib-series="@p">
                                        <span class="ib-chart-tooltip-key"></span>
                                        <span>@point.SizeName</span>
                                        <span class="ib-chart-tooltip-value">@point.SizeText</span>
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            </div>
            <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
            <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@(_zoomOn ? TextDefaults.ChartZoomKeys : TextDefaults.ChartKeys)</span>
        }
        @if (model.MarkTexts.Count > 0)
        {
            <span id="@(_labelId)-marks" class="ib-visually-hidden">@string.Join("; ", model.MarkTexts)</span>
        }
        </ib-chart>

        @if (DataTable != ChartDataTable.None)
        {
            <details class="ib-collapsible ib-disclosure ib-chart-data" open="@(DataTable == ChartDataTable.Visible)">
                <summary class="ib-collapsible-trigger" aria-labelledby="@(TitledBy is null ? null : $"{_labelId}-show {TitledBy}")">
                    <Icon Purpose="IconPurpose.ChevronRight" Class="ib-collapsible-chevron" />
                    <span id="@(_labelId)-show">@TextDefaults.ChartShowData@if (Title is not null)
                    {<span class="ib-visually-hidden">, @Title</span>}</span>
                </summary>
                <div class="ib-chart-table-scroll">
                    <table class="ib-chart-table" aria-labelledby="@NameId">
                        <thead>
                            <tr>
                                <th scope="col">@(ArgumentTitle ?? _argumentName ?? TextDefaults.ChartItem)</th>
                                @foreach (var s in model.Series)
                                {
                                    <th scope="col">@s.Data.Name</th>
                                    @if (model.SizeTexts[s.Index] is not null)
                                    {
                                        <th scope="col">@SizeHeader(model, s)</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < model.ArgumentTexts.Length; i++)
                            {
                                var row = i;
                                <tr>
                                    <th scope="row">@model.ArgumentTexts[row]</th>
                                    @for (var s = 0; s < model.Series.Count; s++)
                                    {
                                        <td>@model.ValueTexts[s][row]</td>
                                        @if (model.SizeTexts[s] is { } sizes)
                                        {
                                            <td>@sizes[row]</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    }

    // Where the legend goes: Auto is above, under the title.
    private ChartLegend Place => Legend == ChartLegend.Auto ? ChartLegend.Top : Legend;

    // Where the legend sits: above or below in a row, or beside in a column (chart.css).
    private string? LegendClass => Place switch
    {
        ChartLegend.Top => "ib-chart-lg-top",
        ChartLegend.Start => "ib-chart-lg-start",
        ChartLegend.End => "ib-chart-lg-end",
        _ => null,
    };

    private string LegendListClass => LegendAlign switch
    {
        ChartAlign.Center => "ib-chart-legend ib-chart-legend-center",
        ChartAlign.End => "ib-chart-legend ib-chart-legend-end",
        _ => "ib-chart-legend ib-chart-legend-start",
    };

    // The legend: a waterfall's keys to its colors, or a toggle for each series.
    private RenderFragment LegendList(ChartModel model, ChartSeriesData? waterfall, string marks, bool toggles) => @<text>
        @if (waterfall is not null)
        {
            @* A waterfall's keys: what each color means. Not toggles: there's one series. *@
            var owner = model.Series[0];
            <ul class="@LegendListClass">
                @foreach (var (change, name) in WaterfallKeys(owner))
                {
                    <li class="@SeriesClass(owner, null)" style="@ColorStyle(owner)">
                        <span class="ib-chart-entry">
                            <svg class="ib-chart-key" width="24" height="12" aria-hidden="true">
                                <rect class="@ChangeClass(change)" x="6" y="1" width="12" height="10" />
                            </svg>
                            @name
                        </span>
                    </li>
                }
            </ul>
        }
        else
        {
            <ul class="@LegendListClass">
                @foreach (var s in toggles ? model.Series : [])
                {
                    <li class="@SeriesClass(s, null)" style="@ColorStyle(s)">
                        @* The script makes this a toggle button that hides and shows the series. *@
                        <span class="ib-chart-toggle" data-ib-series="@s.Index" data-ib-hidden="@Off(s)">
                        <svg class="ib-chart-key" width="24" height="12" aria-hidden="true">
                            @if (s.Data.Type == ChartType.Bar)
                            {
                                <rect x="6" y="1" width="12" height="10" />
                            }
                            else
                            {
                                @if (s.Data.Type == ChartType.Bubble)
                                {
                                    <circle class="ib-chart-bubble" cx="12" cy="6" r="5" />
                                }
                                else if (s.Data.Type != ChartType.Scatter)
                                {
                                    <line class="@($"ib-chart-dash{s.Dash}{Trend(s)}")" x1="0" x2="24" y1="6" y2="6" />
                                }
                                @if (s.Markers)
                                {
                                    <use href="@($"#{marks}{s.Style % 4}")" x="12" y="6" />
                                }
                            }
                        </svg>
                        @s.Data.Name
                        </span>
                    </li>
                }
                @if (model.SizeKey is { } key)
                {
                    @SizeKeyItem(key)
                }
            </ul>
        }

    </text>;

    // A bubble chart's size key: what the sizes measure, then reference circles standing on one
    // base, each value level with its circle's top along a dotted leader. chart.css puts it in the
    // chart's top corner, across from the title.
    // The size key's drawing: the largest circle, standing on the base line.
    private static double SizeKeyHeight(List<(string Text, double R)> circles) => Math.Ceiling(circles.Max(c => c.R) * 2 + 2);

    private static RenderFragment SizeKeyItem((string Name, List<(string Text, double R)> Circles) key) => @<text>
        @{
            var big = key.Circles.Max(c => c.R);
            var height = SizeKeyHeight(key.Circles);
            var width = Math.Ceiling(big * 2 + 8);
        }
        <li class="ib-chart-size-key">
            <span>@key.Name</span>
            <svg width="@Num(width)" height="@Num(height)" aria-hidden="true">
                @foreach (var (_, r) in key.Circles)
                {
                    var top = height - 1 - r * 2;
                    <circle cx="@Num(big + 1)" cy="@Num(height - 1 - r)" r="@Num(r)" />
                    <line x1="@Num(big + 1)" x2="@Num(width)" y1="@Num(top)" y2="@Num(top)" />
                }
            </svg>
            <span class="ib-chart-size-texts" style="height:@(Num(height))px">
                @foreach (var (text, r) in key.Circles)
                {
                    <span style="top:@(Num(height - 1 - r * 2))px">@text</span>
                }
            </span>
        </li>
    </text>;

    // A bar's rounded end, and a waterfall bar's color by whether it adds, takes away or totals.
    private static string? BarClass(BarRect bar) =>
        ((bar.End is { } end ? $"ib-chart-end-{end}" : "") + (ChangeClass(bar.Change) is { } change ? " " + change : "")).Trim() is { Length: > 0 } c ? c : null;

    private static string? ChangeClass(string? change) => change switch
    {
        "up" => "ib-chart-up",
        "down" => "ib-chart-down",
        "total" => "ib-chart-total",
        _ => null,
    };

    // The keys a waterfall's bars need: rises, falls and totals, each when it has one.
    private List<(string Change, string Name)> WaterfallKeys(SeriesShape owner)
    {
        var keys = new List<(string, string)>();
        foreach (var (change, name) in new[] { ("up", TextDefaults.ChartIncrease), ("down", TextDefaults.ChartDecrease), ("total", TextDefaults.ChartTotal) })
        {
            if (owner.Bars.Any(b => b.Change == change)) keys.Add((change, name));
        }

        return keys;
    }

    // The palette, and a waterfall's colors for rises and falls (on the chart, so the tooltips have them).
    private string? RootStyle(ChartModel model, ChartSeriesData? waterfall)
    {
        var style = (Palette?.Style(model.Series.Count(s => s.Data.ColorFrom is null)) ?? "")
            + (waterfall?.IncreaseColor is { } up ? $"--ib-chart-increase:{StyleValues.Raw(up, "color")};" : "")
            + (waterfall?.DecreaseColor is { } down ? $"--ib-chart-decrease:{StyleValues.Raw(down, "color")};" : "")
            + (model.SizeKeyPx > 0 ? $"--ib-chart-key-w:{Num(model.SizeKeyPx)}px;" : "")
            + (model.SizeKey is { } key ? $"--ib-chart-key-h:{Num(SizeKeyHeight(key.Circles))}px;" : "");
        return style.Length > 0 ? style : null;
    }

    // Argument grid lines stay when the script draws the values again (ib-chart-agrid).
    private static string GridClass(GridLine line) =>
        (line.Zero ? "ib-chart-grid ib-chart-zero" : line.Argument ? "ib-chart-grid ib-chart-agrid" : "ib-chart-grid") + (line.From > 0 ? $" ib-chart-from{line.From}" : "");

    // A side title adds a column; values along the top move the bottom axis's row above the plot;
    // names turned below some width carry the first width they're flat at.
    private static string FrameClass(ChartModel model, string? sideTitle, bool valueTop) =>
        "ib-chart-frame" + (sideTitle is null ? "" : " ib-chart-titled") + (model.SecondaryLabels.Count > 0 ? " ib-chart-dual" : "")
        + (valueTop ? " ib-chart-vt" : "")
        + (model.FlatFrom > 0 ? $" ib-chart-rot{model.FlatFrom}" : "");

    // With two value axes, each title's key in its first series' color says which axis is whose.
    private static RenderFragment? TitleKey(ChartModel model, bool dual, bool secondary) => !dual
        ? null
        : model.Series.FirstOrDefault(s => s.Data.Secondary == secondary && s.Data.ColorFrom is null) is not { } owner
        ? null
        : builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", $"ib-chart-title-key ib-chart-s{owner.Slot}");
            builder.AddAttribute(2, "style", ColorStyle(owner));
            builder.CloseElement();
        };

    // Room at the end for half the last label on a scale, which is centered on the plot's edge;
    // turned names' height, and how far the first reaches past the plot's start.
    private string? FrameStyle(ChartModel model, bool titled, bool valueRight)
    {
        // End labels sit past the plot, in its padding, or before the labels of an axis at the right.
        var dual = model.SecondaryLabels.Count > 0;
        // Labels past bars' ends have room beside the plot, or above it.
        var end = Math.Max(dual || valueRight ? model.EndRoomPx : Math.Max(model.EndRoomPx, model.EndLabelsPx), model.OutsideRoom.X);
        // A column for each axis's labels and title on either side of the plot (chart.css has the
        // usual two: the first axis at the left, with or without its title).
        var second = dual ? SecondaryTitle is null ? 1 : 2 : 0;
        var first = titled ? 2 : 1;
        var (left, right) = valueRight ? (second, first) : (first, second);
        var columns = right == 0 && left is 1 or 2
            ? ""
            : $"grid-template-columns:{string.Concat(Enumerable.Repeat("auto ", left))}[plot] minmax(0, 1fr){string.Concat(Enumerable.Repeat(" auto", right))};";
        var style = columns + (Height is { } h ? $"--ib-chart-height:{h.Css};" : "")
            + (model.OutsideRoom.Y > 0 ? $"padding-block-start:max(0.5lh, {Num(model.OutsideRoom.Y)}px);" : "")
            + (model.EndLabelsPx > 0 ? $"--ib-chart-ends:{Num(model.EndLabelsPx)}px;" : "")
            + (end > 0 ? $"padding-inline-end:{Num(end)}px;" : "")
            + (model.FlatFrom > 0 ? $"--ib-chart-th:{Num(model.TurnedPx)}px;--ib-chart-lead:{Num(model.LeadPx)}px" : "");
        return style.Length > 0 ? style : null;
    }

    // The side labels: values up an upright chart (or names, for bars across), at the left or the right.
    private RenderFragment FirstSide(List<AxisLabel> side, bool horizontal, bool redraw, bool right, bool zoom) => __builder =>
    {
        <div class="@((horizontal ? "ib-chart-side ib-chart-names" : "ib-chart-side") + (right ? " ib-chart-side2" : "") + ((horizontal ? HideArgumentAxis : HideValueAxis) ? " ib-chart-off" : ""))">
            <div class="@(horizontal ? "ib-chart-ticks" : "ib-chart-ticks ib-chart-values")">
                @foreach (var label in side)
                {
                    <span style="top:@Pct(horizontal ? label.Pos : 1 - label.Pos)" title="@label.Title">@label.Text</span>
                }
            </div>
            @if (redraw && !horizontal)
            {
                @* The value labels the script draws when the legend hides a series. *@
                <div class="ib-chart-ticks ib-chart-values ib-chart-js"></div>
            }
            @if (zoom && horizontal)
            {
                @* The names the script draws zoomed in. *@
                <div class="ib-chart-ticks ib-chart-js ib-chart-zargs"></div>
            }
        </div>
    };

    // The second value axis's labels, across the plot from the first's.
    private static RenderFragment SecondSide(ChartModel model, bool right) => __builder =>
    {
        <div class="@(right ? "ib-chart-side ib-chart-side2" : "ib-chart-side")">
            <div class="ib-chart-ticks">
                @foreach (var label in model.SecondaryLabels)
                {
                    <span style="top:@Pct(1 - label.Pos)">@label.Text</span>
                }
            </div>
        </div>
    };

    private static string BottomClass(ChartModel model, bool horizontal) =>
        "ib-chart-bottom" + (model.TwoLine ? " ib-chart-two-line" : "")
        + (!horizontal && model.Kind == ArgumentKind.Category ? model.Wrap ? " ib-chart-bands ib-chart-wrap" : " ib-chart-bands" : "");

    private static string SeriesClass(SeriesShape s, string? kind) =>
        $"{kind} ib-chart-s{s.Slot}".TrimStart();

    private static string? Off(SeriesShape s) => s.Data.Hidden ? "" : null;

    // A trend's line is its series' color toward the text's, so it reads over the series' bars.
    // A TrendColor is used as given.
    private static string Trend(SeriesShape s) => s.Data.ColorFrom is null || s.Data.TrendColor is not null ? "" : " ib-chart-trend";

    // A reference line, band or note. Each runs along an axis: "y" places it up from the bottom
    // (values on an upright chart, names on bars across), "x" across from the left. --p and --q
    // are its ends; a note's --n is its argument. data-ib-v holds the value the script rescales.
    private static RenderFragment MarkElement(MarkShape mark, bool horizontal) => builder =>
    {
        var y = (mark.Axis == MarkAxis.Value) != horizontal;
        var (p, q) = !y || mark.Axis == MarkAxis.Value || mark.Kind == ChartMarkKind.Note ? (mark.P, mark.Q) : (1 - mark.Q, 1 - mark.P);
        if (mark.Kind == ChartMarkKind.Line && mark.Axis == MarkAxis.Argument && y) (p, q) = (1 - mark.P, 0);
        var style = mark.Kind switch
        {
            ChartMarkKind.Band => $"--p:{Num(p)};--q:{Num(q)}",
            ChartMarkKind.Note => $"--p:{Num(mark.P)};--n:{Num(horizontal ? 1 - mark.A : mark.A)}",
            _ => $"--p:{Num(p)}",
        };
        var kind = mark.Kind switch { ChartMarkKind.Band => "ib-chart-band", ChartMarkKind.Note => "ib-chart-note", _ => "ib-chart-rule" };
        var axis = mark.Kind == ChartMarkKind.Note ? (horizontal ? " ib-chart-note-h" : "") : y ? " ib-chart-mk-y" : " ib-chart-mk-x";
        builder.OpenElement(0, "div");
        var align = mark.Align switch { ChartAlign.Start => " ib-chart-at-start", ChartAlign.Center => " ib-chart-at-center", ChartAlign.End => " ib-chart-at-end", _ => "" };
        builder.AddAttribute(1, "class", kind + axis + align);
        builder.AddAttribute(2, "style", style);
        builder.AddAttribute(3, "data-ib-v", mark.V is { } v && (mark.Axis == MarkAxis.Value) ? v.ToString("R", CultureInfo.InvariantCulture) : null);
        builder.AddAttribute(4, "data-ib-vto", mark.VTo is { } vt ? vt.ToString("R", CultureInfo.InvariantCulture) : null);
        builder.AddAttribute(5, "data-ib-series", mark.Series >= 0 ? mark.Series.ToString(CultureInfo.InvariantCulture) : null);
        // Zoom: its place on the whole axis, which the script maps into each view.
        builder.AddAttribute(6, "data-ib-za", mark.Zoom is { } z ? $"{z.P.ToString("R", CultureInfo.InvariantCulture)} {z.Q.ToString("R", CultureInfo.InvariantCulture)}" : null);
        builder.AddAttribute(7, "data-ib-out", mark.Out ? "" : null);
        builder.OpenElement(8, "span");
        builder.AddContent(9, mark.Text);
        builder.CloseElement();
        builder.CloseElement();
    };

    // A label's center across, kept its half width from the plot's sides when it's justified.
    private static string LabelLeft(DataLabel label) => label.Justify > 0
        ? $"clamp({Num(label.Justify)}px,{Pct(label.AX)},calc(100% - {Num(label.Justify)}px))"
        : $"calc({Pct(label.AX)} + {Num(label.DX)}px)";

    // A label on a bar carries its series' slot, for the fill its text color is picked against.
    private static string? LabelClass(DataLabel label, SeriesShape owner) =>
        ((label.Inside ? $"ib-chart-dl-in ib-chart-s{owner.Slot}" + (ChangeClass(label.Change) is { } change ? " " + change : "") : "") + (label.From > 0 ? $" ib-chart-from{label.From}" : "")).Trim() is { Length: > 0 } c ? c : null;

    private static string SeriesColor(SeriesShape s)
    {
        var color = s.Data.Color is { } c ? StyleValues.Raw(c, "color") : "var(--ib-chart-" + s.Slot + ")";

        // A trend's own shade (chart.css's ib-chart-trend), so its tooltip key matches its line.
        return Trend(s).Length > 0 ? $"color-mix(in oklab, {color} 60%, var(--ib-color-on-surface))" : color;
    }

    // A waterfall's color for one item: a rise's, a fall's, or a total's (chart.css's ib-chart-up, -down, -total).
    private static string ItemColor(SeriesShape s, int index) => s.Bars.FirstOrDefault(b => b.Index == index)?.Change switch
    {
        "up" => "var(--ib-chart-increase, var(--ib-chart-1))",
        "down" => "var(--ib-chart-decrease, var(--ib-chart-8))",
        "total" => s.Data.Color is { } c ? StyleValues.Raw(c, "color") : "var(--ib-color-neutral)",
        _ => SeriesColor(s),
    };

    private static string KeyStyle(ChartTooltipPoint point) => "background:" + point.Color;

    private static string? Positions(ChartModel model) => model.Kind == ArgumentKind.Category
        ? null
        : string.Join(",", model.ArgumentPositions.Select(p => double.IsNaN(p) ? "" : Num(p)));

    private ChartTooltipContext<TItem> TooltipFor(IReadOnlyList<TItem> items, ChartModel model, int index) => new(
        items[index],
        index,
        model.ArgumentTexts[index],
        model.Series.Select(s => new ChartTooltipPoint(s.Data.Name, s.Data.Values[index], model.ValueTexts[s.Index][index], ItemColor(s, index))
        {
            Size = s.Data.Sizes?[index],
            SizeName = s.Data.Sizes is null ? null : s.Data.SizeName ?? TextDefaults.ChartSize,
            SizeText = model.SizeTexts[s.Index]?[index],
        }).ToList());

    // A bubble series' size column: what it measures, with the series' name when there are more.
    private string SizeHeader(ChartModel model, SeriesShape s)
    {
        var name = s.Data.SizeName ?? TextDefaults.ChartSize;
        return model.Series.Count(o => o.Data.Sizes is not null) > 1 ? $"{s.Data.Name}: {name}" : name;
    }

    // The script reports where the reader zoomed to, as shares of the whole axis ("0.25 0.5"), or
    // "" zoomed all the way out; on an interactive page this keeps it and raises ViewChanged.
    private async Task OnView(IzzyLayoutEventArgs e)
    {
        var view = ViewAt(e.Layout);
        if (Equals(view, _view)) return;
        _view = view;
        if (ViewChanged.HasDelegate) await ViewChanged.InvokeAsync(view);
    }

    // A view from shares of the whole axis: the names it takes in, or the scale's ends as arguments
    // of the chart's own type.
    private ChartView? ViewAt(string? layout)
    {
        var parts = (layout ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length != 2 || !double.TryParse(parts[0], CultureInfo.InvariantCulture, out var f0) || !double.TryParse(parts[1], CultureInfo.InvariantCulture, out var f1)) return null;
        if (f0 <= 1e-6 && f1 >= 1 - 1e-6) return null;
        var (arguments, kind) = (_drawnArguments, _drawnKind);
        if (arguments.Count < 2) return null;
        if (kind == ArgumentKind.Category)
        {
            var n = arguments.Count;
            var (i0, i1) = ((int)Math.Clamp(Math.Round(f0 * n), 0, n - 1), (int)Math.Clamp(Math.Round(f1 * n) - 1, 0, n - 1));
            return new ChartView(arguments[i0], arguments[Math.Max(i0, i1)]);
        }

        var log = _argumentAxis?.Logarithmic == true;
        var at = arguments.Select(a => ChartLayout.ToDouble(a, kind)).Where(x => x is { } v && (!log || v > 0)).Select(x => log ? Math.Log10(x!.Value) : x!.Value).ToList();
        if (at.Count < 2) return null;
        var (lo, hi) = (at.Min(), at.Max());
        object? Arg(double share)
        {
            var x = lo + share * (hi - lo);
            if (log) x = Math.Pow(10, x);
            if (kind == ArgumentKind.Number) return x;
            var t = new DateTime(Math.Clamp((long)Math.Round(x), DateTime.MinValue.Ticks, DateTime.MaxValue.Ticks));
            return arguments.FirstOrDefault(a => a is not null) switch
            {
                DateOnly => DateOnly.FromDateTime(t),
                DateTimeOffset o => new DateTimeOffset(t, o.Offset),
                _ => t,
            };
        }

        return new ChartView(Arg(f0), Arg(f1));
    }

    // What the script needs to draw the chart again without a series (chart-draw.ts): each
    // series' values and look, the stacking, the value range and how values read.
    private string DrawData(ChartModel model, NumberShape shape, bool horizontal, string marks)
    {
        using var stream = new MemoryStream();
        using (var w = new System.Text.Json.Utf8JsonWriter(stream))
        {
            void Number(string name, double? value)
            {
                if (value is { } v && double.IsFinite(v)) w.WriteNumber(name, v);
                else w.WriteNull(name);
            }

            w.WriteStartObject();
            w.WriteBoolean("h", horizontal);
            if (_argumentAxis?.Reverse == true) w.WriteBoolean("ar", true);
            w.WriteNumber("st", (int)Stacked);
            Number("lo", ValueMin);
            Number("hi", ValueMax);
            Number("vs", ValueLog ? null : ValueStep);
            // The second axis's range, which a redraw keeps.
            if (model.SecondaryLabels.Count > 0)
            {
                w.WriteNumber("s2l", model.SecondaryRange.Min);
                w.WriteNumber("s2h", model.SecondaryRange.Max);
            }

            // The marks' values, which the value axis always takes in.
            if (model.MarkValues.Count > 0)
            {
                w.WriteStartArray("rv");
                foreach (var v in model.MarkValues) w.WriteNumberValue(v);
                w.WriteEndArray();
            }
            // Room past the plot for labels past bars' ends.
            if (model.OutsideRoom != (0, 0))
            {
                w.WriteStartArray("lr");
                w.WriteNumberValue(model.OutsideRoom.X);
                w.WriteNumberValue(model.OutsideRoom.Y);
                w.WriteEndArray();
            }

            w.WriteBoolean("lg", ValueLog);
            w.WriteBoolean("gl", ValueGrid);
            // With a ValueFormatter, the server's value axis as drawn: its range and ticks.
            if (ValueFormatter is not null && Stacked != ChartStacking.Percent)
            {
                w.WriteNumber("rl", model.ValueRange.Min);
                w.WriteNumber("rh", model.ValueRange.Max);
                w.WriteStartArray("tk");
                var lines = model.Grid.Where(g => !g.Argument).ToList();
                for (var t = 0; t < model.ValueLabels.Count; t++)
                {
                    var label = model.ValueLabels[t];
                    w.WriteStartArray();
                    w.WriteNumberValue(Math.Round(label.Pos, 6));
                    w.WriteStringValue(label.Text);
                    w.WriteNumberValue(label.From);
                    w.WriteBooleanValue(t < lines.Count && lines[t].Zero);
                    w.WriteEndArray();
                }

                w.WriteEndArray();
            }
            w.WriteStartObject("f");
            w.WriteString("p", shape.Prefix);
            w.WriteString("s", shape.Suffix);
            w.WriteString("np", shape.NegativePrefix);
            w.WriteString("ns", shape.NegativeSuffix);
            w.WriteString("g", shape.Group);
            w.WriteString("d", shape.Decimal);
            w.WriteNumber("n", shape.Decimals);
            w.WriteNumber("t", shape.MinDecimals);
            w.WriteNumber("k", shape.Scale);
            w.WriteEndObject();
            w.WriteStartArray("a");
            foreach (var p in model.ArgumentPositions)
            {
                if (double.IsNaN(p)) w.WriteNullValue();
                else w.WriteNumberValue(Math.Round(p, 5));
            }

            w.WriteEndArray();
            w.WriteString("mk", marks);
            if (model.ZoomPositions is { } zp)
            {
                // Zoom: each item's place on the whole axis, the fewest items' span, the view drawn,
                // argument grid lines, the label tiers (place, text, second line, first width,
                // second line when first in view) or, down the side, the names.
                w.WriteStartArray("za");
                foreach (var p in zp)
                {
                    if (double.IsNaN(p)) w.WriteNullValue();
                    else w.WriteNumberValue(Math.Round(p, 6));
                }

                w.WriteEndArray();
                w.WriteNumber("zl", Math.Round(model.ZoomLeast, 6));
                w.WriteBoolean("zc", model.Kind == ArgumentKind.Category);
                w.WriteBoolean("ag", ArgumentGrid);
                w.WriteString("zs", TextDefaults.ChartShowing);
                w.WriteStartArray("zn");
                foreach (var t in model.ArgumentTexts) w.WriteStringValue(t);
                w.WriteEndArray();
                if (model.View?.Share is { } share)
                {
                    w.WriteStartArray("zv");
                    w.WriteNumberValue(Math.Round(share.F0, 6));
                    w.WriteNumberValue(Math.Round(share.F1, 6));
                    w.WriteEndArray();
                }

                w.WriteStartArray("zt");
                foreach (var tier in model.ZoomTiers)
                {
                    w.WriteStartArray();
                    w.WriteNumberValue(tier.Zoom);
                    w.WriteStartArray();
                    foreach (var label in tier.Labels)
                    {
                        w.WriteStartArray();
                        w.WriteNumberValue(Math.Round(label.Pos, 6));
                        w.WriteStringValue(label.Text);
                        if (label.Context is null) w.WriteNullValue(); else w.WriteStringValue(label.Context);
                        w.WriteNumberValue(label.From);
                        if (label.Lead is null) w.WriteNullValue(); else w.WriteStringValue(label.Lead);
                        w.WriteEndArray();
                    }

                    w.WriteEndArray();
                    w.WriteEndArray();
                }

                w.WriteEndArray();
                if (horizontal && model.Kind == ArgumentKind.Category)
                {
                    w.WriteStartArray("zx");
                    foreach (var t in model.ArgumentTexts) w.WriteStringValue(t);
                    w.WriteEndArray();
                }
            }
            // The tick count up the side, as the server worked it out from Height.
            w.WriteNumber("vc", Math.Max(2, (int)Math.Round(Math.Max(80, HeightInPixels(Height)) / 56)));
            // Bubbles pad the value axis by their largest radius (ChartLayout.PadEnds).
            if (model.Series.Any(s => s.Data.Type == ChartType.Bubble))
            {
                w.WriteStartArray("bp");
                w.WriteNumberValue(ChartLayout.BubbleRadius(HeightInPixels(Height)));
                w.WriteNumberValue(Math.Max(80, HeightInPixels(Height)));
                w.WriteEndArray();
            }
            // The series the server drew hidden: the script compares the legend's with these.
            w.WriteStartArray("off");
            foreach (var s in model.Series.Where(s => s.Data.Hidden)) w.WriteNumberValue(s.Index);
            w.WriteEndArray();
            w.WriteStartArray("s");
            foreach (var s in model.Series)
            {
                var d = s.Data;
                w.WriteStartObject();
                w.WriteNumber("t", (int)d.Type);
                w.WriteStartArray("v");
                foreach (var v in d.Values)
                {
                    if (v is { } x && double.IsFinite(x)) w.WriteNumberValue(x);
                    else w.WriteNullValue();
                }

                w.WriteEndArray();
                w.WriteNumber("c", (int)d.Curve);
                w.WriteBoolean("j", d.ConnectGaps);
                w.WriteBoolean("m", s.Markers);
                // A bubble's radius by item, which doesn't change with the value axis.
                if (d.Type == ChartType.Bubble)
                {
                    w.WriteStartArray("r");
                    foreach (var r in s.Radii!) w.WriteNumberValue(Math.Round(r, 2));
                    w.WriteEndArray();
                }
                w.WriteNumber("k", s.Slot);
                w.WriteNumber("y", s.Style);
                w.WriteNumber("d", s.Dash);
                if (d.ColorFrom is not null && d.TrendColor is null) w.WriteBoolean("tr", true);
                if (d.ColorFrom is not null) w.WriteBoolean("so", true);
                if (d.Secondary) w.WriteBoolean("ax", true);
                if (d.EndLabel) w.WriteString("en", d.Name);
                if (d.Color is { } c) w.WriteString("col", StyleValues.Raw(c, "color"));
                if (d.Opacity is { } op) w.WriteNumber("op", op);
                // Labels: the mode, and each item's text, which the script can't format itself.
                if (model.LabelTexts[s.Index] is { } texts)
                {
                    w.WriteNumber("lm", (int)d.Labels);
                    if (d.LabelOverlap == ChartLabelOverlap.Show) w.WriteBoolean("lo", true);
                    w.WriteStartArray("lt");
                    foreach (var text in texts)
                    {
                        if (text is null) w.WriteNullValue();
                        else w.WriteStringValue(text);
                    }

                    w.WriteEndArray();
                }
                w.WriteEndObject();
            }

            w.WriteEndArray();
            w.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static string? ColorStyle(SeriesShape s) =>
        (s.Data.Color is { } color ? $"--ib-chart-color:{StyleValues.Raw(color, "color")};" : "")
        + (s.Data.Opacity is { } opacity ? $"--ib-chart-fill-opacity:{Num(opacity)}" : "") is { Length: > 0 } style ? style : null;
}
