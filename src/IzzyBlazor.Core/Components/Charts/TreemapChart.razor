@namespace IzzyBlazor
@typeparam TItem
@inherits LayoutItemBase
@implements IDisposable
@attribute [CascadingTypeParameter(nameof(TItem))]
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions

@*
    Parts of a whole, such as a cloud bill by service, as tiles sized by their share, in groups
    with Group.

    Groups take the rectangle largest first, then each group's tiles take its space, the largest
    at the top left; tiles stay as near square as they can. The chart keeps its shape at every
    width (AspectRatio, 2:1 by default; square on a phone), so the tiles do too. Zero, negative and
    missing values are left out. Tiles take a color per group, or per tile without groups
    (Colors); ColorValue colors them by a second measure instead, such as the day's change on a
    market map, with a scale as HeatmapChart's. Each tile's name sits at its top left where it
    fits; Values adds its value. A treemap suits many parts of a whole; with a few, or when exact
    comparison matters, bars read better.

    Accessibility:
    - The chart is a figure captioned by Title, or named by a heading on the page with TitledBy.
    - The tiles are one image named by the caption, described by their count and the largest.
    - "Show data" under the chart opens a table of every tile: its group, name, value and shares,
      and its ColorValue (DataTable).
    - Tiles are told apart by their names and places, not only by color.
    - With IzzyBlazor's script, the tiles are one Tab stop: the arrow keys move from tile to tile
      and say each one's value and shares.

    Keyboard:
    On the tiles
    - Right, Left, Down, Up | Move to the nearest tile that way
    - Home, End | Go to the first or last tile
    - Enter | Open the tile's level below (with ChartDrillLevels)
    - Escape | Hide the tooltip
    See also: PieChart, Chart.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    @if (ColorValue is not null)
    {
        <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/heatmap.css"]" />
    }
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/treemap.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@(HideTitle ? "ib-visually-hidden" : TitleAlign switch { ChartAlign.Center => "ib-chart-label ib-chart-label-center", ChartAlign.End => "ib-chart-label ib-chart-label-end", _ => "ib-chart-label" })">@Title</figcaption>
    }
    <CascadingValue Value="_tooltips" IsFixed="true">
        @ChildContent
        @_plotFragment
    </CascadingValue>
    @if (Download)
    {
        @* Download, across from the title (chart.css): last, so the title's neighbor rules
           (label + legend, label + rings) still meet. *@
        @ChartTools.Tools(TextDefaults)
    }
</figure>

@code {
    /// <summary>
    /// How often the chart reads its data again, at least a second, such as
    /// <c>Refresh="TimeSpan.FromSeconds(30)"</c>. On a static page the page (or
    /// <see cref="RefreshFrom"/>) is fetched again and the chart drawn from it, found by its
    /// <c>id</c>, which it then needs; on an interactive page <see cref="OnRefresh"/> is raised, for
    /// you to load new data. Not while the tab is hidden or the chart is off-screen, nor (static)
    /// while the pointer or focus is in it. Unlike Chart's, it has no Pause button.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public TimeSpan? Refresh { get; set; }

    /// <summary>On a static page with <see cref="Refresh"/>: a lighter page to fetch than this one, which renders the same chart with the same <c>id</c>.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public string? RefreshFrom { get; set; }

    /// <summary>On an interactive page with <see cref="Refresh"/>: raised at each interval, to load new data.</summary>
    [Parameter, ModeSupport(Static = ModeLevel.None, NoScript = ModeLevel.None)]
    public EventCallback OnRefresh { get; set; }

    private readonly ChartRefresh _refresh = new();

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        _refresh.AfterRender(Refresh, RendererInfo, OnRefresh, InvokeAsync, DispatchExceptionAsync);
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _refresh.Dispose();
        Navigation.LocationChanged -= Moved;
    }

    /// <summary>With <see cref="ChartDrillLevel{TItem}"/>s (in place of <see cref="Name"/> and <see cref="Group"/>): the page address's query value that holds the level ("drill" by default; give each chart that drills on a page its own).</summary>
    [Parameter] public string? Drill { get; set; }

    /// <summary>With drill-down levels: leaves out the breadcrumb above the chart.</summary>
    [Parameter] public bool HideBreadcrumb { get; set; }

    /// <summary>With drill-down levels, how each tile adds up its items' values: Sum by default, or Avg, Min, Max or Count.</summary>
    [Parameter] public DataAggregate Aggregate { get; set; }

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // Interactive: the address changed (a drill link or Back): draw the level it names.
    private void Moved(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_tooltips.Levels.Count > 0) _ = InvokeAsync(() => _tooltips.Plot?.Refresh());
    }

    /// <summary>The tiles, one item each: its name, its value and, with <see cref="Group"/>, its group.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>Each tile's name, such as <c>c =&gt; c.Service</c>, written at its top left where it fits.</summary>
    [Parameter] public Expression<Func<TItem, object?>>? Name { get; set; }

    /// <summary>Each tile's size, such as <c>c =&gt; c.Amount</c>: any positive number. Its area is its share of the whole.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Value { get; set; } = default!;

    /// <summary>
    /// Each tile's group, such as <c>c =&gt; c.Category</c>. A group's tiles sit together under a
    /// strip with its name, and take its color. Leave it out for one level of tiles.
    /// </summary>
    [Parameter] public Expression<Func<TItem, object?>>? Group { get; set; }

    /// <summary>
    /// A second measure that colors the tiles, such as <c>s =&gt; s.Change</c> on a market map
    /// whose tiles are sized by market value: a scale of <see cref="Palette"/>'s shades, as a
    /// <see cref="HeatmapChart{TItem}"/>'s, with a legend. <see cref="Colors"/> set with it throws.
    /// </summary>
    [Parameter] public Expression<Func<TItem, object?>>? ColorValue { get; set; }

    /// <summary>
    /// The chart's title, such as "Cloud costs by service", shown above it as its caption. It also
    /// names the chart for screen readers. A chart needs a Title or <see cref="TitledBy"/>.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Hides the title, which still names the chart for screen readers.</summary>
    [Parameter] public bool HideTitle { get; set; }

    /// <summary>
    /// Shows a button across from the title that saves the chart as a PNG, named after its title,
    /// in the color scheme on screen. With JavaScript off there's no button.
    /// </summary>
    [Parameter] public bool Download { get; set; }

    /// <summary>
    /// Where the title sits: at the start by default (the left, in a left-to-right page);
    /// <see cref="ChartAlign.Center"/> or <see cref="ChartAlign.End"/>.
    /// </summary>
    [Parameter] public ChartAlign TitleAlign { get; set; }

    /// <summary>
    /// The id of a heading already on the page that titles the chart, such as a card's, in place of
    /// <see cref="Title"/>: the chart takes its name from it and shows no title of its own.
    /// </summary>
    [Parameter] public string? TitledBy { get; set; }

    /// <summary>A .NET format string for the values, such as <c>C0</c> or <c>N0</c>: on the tiles, in the tooltips and the table.</summary>
    [Parameter] public string? ValueFormat { get; set; }

    /// <summary>A .NET format string for <see cref="ColorValue"/>, such as <c>+0.0%;−0.0%;0.0%</c>: in the legend, the tooltips and the table.</summary>
    [Parameter] public string? ColorFormat { get; set; }

    /// <summary>
    /// What colors the tiles: <see cref="TreemapColors.Auto"/> (the default) colors them by group
    /// with <see cref="Group"/> set, or each tile its own color without; <see cref="TreemapColors.Group"/>
    /// or <see cref="TreemapColors.Item"/> chooses (Group needs <see cref="Group"/>). <see cref="ColorValue"/>
    /// colors them by a value instead, and throws with Colors set.
    /// </summary>
    [Parameter] public TreemapColors Colors { get; set; }

    /// <summary>
    /// The colors: the theme's eight by default, repeating past eight, or your own with
    /// <see cref="ChartPalette.Of"/>; <see cref="ChartPalette.Shades"/> and
    /// <see cref="ChartPalette.Diverging"/> throw. With <see cref="ColorValue"/>, the scale:
    /// <see cref="ChartPalette.Shades"/> of the primary color by default,
    /// <see cref="ChartPalette.Diverging"/> for values above and below <see cref="Midpoint"/>, or
    /// your own ramp with <see cref="ChartPalette.Of"/>; <see cref="ChartPalette.Colors"/> throws.
    /// </summary>
    [Parameter] public ChartPalette? Palette { get; set; }

    /// <summary>
    /// With <see cref="ColorValue"/>, about how many classes its values fall into, each a shade: 5 by
    /// default, 2 to 9 (the scale rounds its bounds, so one more or fewer), or 0 for a continuous blend.
    /// </summary>
    [Parameter] public int Steps { get; set; } = 5;

    /// <summary>With <see cref="ColorValue"/> and a <see cref="ChartPalette.Diverging"/> palette, the value the scale turns at: 0 by default.</summary>
    [Parameter] public double? Midpoint { get; set; }

    /// <summary>With <see cref="ColorValue"/>, the scale's low end. Lower values take the first class.</summary>
    [Parameter] public double? Min { get; set; }

    /// <summary>With <see cref="ColorValue"/>, the scale's high end. Higher values take the last class.</summary>
    [Parameter] public double? Max { get; set; }

    /// <summary>
    /// The chart's width over its height: 2 by default (twice as wide as tall); from 0.5 to 4. Under
    /// 30rem wide the chart is square. It keeps this shape at every width, so the tiles stay as
    /// square as they were laid out.
    /// </summary>
    [Parameter] public double AspectRatio { get; set; } = 2;

    /// <summary>Writes each tile's name at its top left, where it fits. On by default; <c>false</c> leaves only the tiles (and the groups' strips).</summary>
    [Parameter] public bool Labels { get; set; } = true;

    /// <summary>Writes each tile's value under its name (with <see cref="Labels"/>), and each group's total beside its name. Off by default; the tooltips and the table have the values.</summary>
    [Parameter] public bool Values { get; set; }

    /// <summary>
    /// With <see cref="ColorValue"/>, where its scale goes: above the tiles by default
    /// (<see cref="ChartLegend.Auto"/> or <see cref="ChartLegend.Top"/>), <see cref="ChartLegend.Bottom"/>,
    /// or <see cref="ChartLegend.None"/>. Without it there's no legend: the tiles and groups are named.
    /// </summary>
    [Parameter] public ChartLegend Legend { get; set; }

    /// <summary>With <see cref="ColorValue"/>, the legend's place along its edge: the start by default, the center or the end.</summary>
    [Parameter] public ChartAlign? LegendAlign { get; set; }

    /// <summary>
    /// A tooltip for the tile or group name under the pointer, and the arrow keys from tile to tile,
    /// each saying its value and shares (with IzzyBlazor's script; with JavaScript off, a hover
    /// title). On by default; <c>false</c> leaves them out. A <see cref="ChartTooltip{TItem}"/> writes your own.
    /// </summary>
    [Parameter] public bool Tooltip { get; set; } = true;

    /// <summary>The tiles as a table: by default behind a "Show data" button that opens it over the chart; <see cref="ChartDataTable.Collapsed"/> puts it in a disclosure under the chart.</summary>
    [Parameter] public ChartDataTable DataTable { get; set; } = ChartDataTable.Popover;

    /// <summary>A <see cref="ChartTooltip{TItem}"/> for your own tile tooltips.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _labelId = IdGenerator.Next("ib-chart");

    // Only for ChartTooltip, which a treemap shares with Chart: its context is one tile.
    private readonly ChartContext<TItem> _tooltips = new();
    private RenderFragment _plotFragment = null!;
    private Expression<Func<TItem, object?>>? _lastName, _lastValue, _lastGroup, _lastColor;
    private Func<TItem, object?>? _name, _value, _group, _color;
    private string? _nameName, _valueName, _groupName, _colorName;
    private string? _class;
    private string? _style;

    // What names the chart: its own caption, or the heading TitledBy points at.
    private string NameId => TitledBy ?? _labelId;

    private static string Num(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private string Format(double value) => value.ToString(ValueFormat ?? "#,##0.##", CultureInfo.CurrentCulture);

    private ChartLegend Place => Legend == ChartLegend.Auto ? ChartLegend.Top : Legend;

    private string LegendListClass => LegendAlign switch
    {
        ChartAlign.Center => "ib-chart-legend ib-chart-legend-center",
        ChartAlign.End => "ib-chart-legend ib-chart-legend-end",
        _ => "ib-chart-legend ib-chart-legend-start",
    };

    // A box's place and size, wide and (as --n…) narrow, for treemap.css.
    private static string Box(TreemapBox wide, TreemapBox narrow) =>
        $"--x:{Num(wide.X)}%;--y:{Num(wide.Y)}%;--w:{Num(wide.W)}%;--h:{Num(wide.H)}%;--nx:{Num(narrow.X)}%;--ny:{Num(narrow.Y)}%;--nw:{Num(narrow.W)}%;--nh:{Num(narrow.H)}%";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // The tiles draw after a ChartTooltip inside the chart has said it's there.
        _plotFragment = builder =>
        {
            builder.OpenComponent<ChartPlot>(0);
            builder.AddComponentParameter(1, nameof(ChartPlot.Content), (RenderFragment)RenderPlot);
            builder.AddComponentParameter(2, nameof(ChartPlot.Attach), (Action<ChartPlot>)(plot => _tooltips.Plot = plot));
            builder.CloseComponent();
        };
        if (RendererInfo.IsInteractive) Navigation.LocationChanged += Moved;
        base.OnInitialized();
    }

    private void RenderPlot(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        var culture = CultureInfo.CurrentCulture;
        // Drill-down: the level in the address, its groups as the tiles, laid out again at full
        // size, their values added up.
        var drilled = _tooltips.Levels.Count > 0
            ? ChartDrill.At(Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [], _tooltips.Levels, Navigation, ChartDrill.KeyOf(Drill), AdditionalAttributes, TextDefaults)
            : null;
        if (drilled is null && _name is null) throw new InvalidOperationException("TreemapChart needs a Name for each tile, such as c => c.Service, or ChartDrillLevels.");
        if (drilled is not null && (_group is not null || _color is not null))
        {
            throw new InvalidOperationException("A TreemapChart that drills down takes its tiles from its ChartDrillLevels: leave out Group and ColorValue.");
        }

        var items = drilled?.Firsts ?? Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];
        var totals = drilled?.Total(drilled.Rows.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray(), Aggregate);

        // Groups in the order the items first name them.
        var grouped = _group is not null;
        var groupNames = new List<string>();
        var groupOf = new Dictionary<string, int>();
        var input = new List<(int Group, double Value)>(items.Count);
        var names = new string[items.Count];
        for (var i = 0; i < items.Count; i++)
        {
            var g = 0;
            if (grouped)
            {
                var key = ChartLayout.ArgumentText(_group!(items[i]), null, culture);
                if (!groupOf.TryGetValue(key, out g))
                {
                    g = groupNames.Count;
                    groupNames.Add(key);
                    groupOf[key] = g;
                }
            }

            names[i] = ChartLayout.ArgumentText(drilled is not null ? drilled.Arguments[i] : _name!(items[i]), null, culture);
            input.Add((g, (totals is not null ? totals[i] : ChartMembers.ToNumber(_value!(items[i]))) ?? double.NaN));
        }

        var model = TreemapLayout.Build(input, Math.Max(1, groupNames.Count), grouped, AspectRatio);
        var tiles = model.Tiles.ToList();
        var template = _tooltips.TooltipTemplate;
        var tooltip = Tooltip && tiles.Count > 0;

        // Colors: by a value's scale, or the palette by group or by tile (each group's tiles in the
        // items' order, starting again in each group).
        var byValue = _color is not null;
        var byGroup = !byValue && (Colors == TreemapColors.Group || Colors == TreemapColors.Auto && grouped);
        // Groups take the palette in the order the items first name them, counting only groups drawn.
        var groupSlot = model.Groups.Select(g => g.Index).Order().Select((g, k) => (g, k)).ToDictionary(p => p.g, p => p.k);
        var slotOf = new Dictionary<int, int>();
        foreach (var group in model.Groups)
        {
            var k = 0;
            foreach (var tile in group.Tiles.OrderBy(t => t.Item)) slotOf[tile.Item] = byGroup ? groupSlot[group.Index] : k++;
        }

        HeatmapModel? scaleModel = null;
        var cells = new Dictionary<int, HeatmapCell>();
        string colors;
        if (byValue)
        {
            var palette = Palette ?? ChartPalette.Shades(IzzyBlazor.Color.Primary);
            var colorValues = tiles.Select(t => ChartMembers.ToNumber(_color!(items[t.Item]))).ToArray();
            var scaleInput = new HeatmapInput
            {
                Columns = [],
                Rows = [],
                Values = colorValues,
                ValueFormat = ColorFormat,
                Steps = Steps,
                FixedColors = palette.FixedCount,
                Diverging = palette.IsDiverging,
                Midpoint = Midpoint ?? 0,
                Min = Min,
                Max = Max,
            };
            scaleModel = new HeatmapModel();
            var scale = HeatmapLayout.Scale(scaleInput, scaleModel, colorValues.OfType<double>().Where(double.IsFinite).ToArray());
            for (var j = 0; j < tiles.Count; j++)
            {
                if (colorValues[j] is { } v && double.IsFinite(v)) cells[tiles[j].Item] = scale(tiles[j].Item, v, v.ToString(ColorFormat ?? "#,##0.##", culture));
            }

            colors = palette.HeatStyle(scaleModel.ClassCount);
        }
        else
        {
            colors = Palette?.Style(Math.Min(8, byGroup ? model.Groups.Count : slotOf.Values.DefaultIfEmpty(0).Max() + 1)) ?? "";
        }

        string TileClass(TreemapTile t)
        {
            if (!byValue) return $"ib-treemap-tile ib-chart-s{slotOf[t.Item] % 8 + 1}";
            if (!cells.TryGetValue(t.Item, out var c)) return "ib-treemap-tile ib-treemap-none";
            var ink = c.Ink > 0 ? $" ib-i{c.Ink}" : "";
            return scaleModel!.Continuous ? $"ib-treemap-tile{(c.Low ? " ib-lo" : "")}{ink}" : $"ib-treemap-tile ib-k{c.Class + 1}{ink}";
        }

        string TileStyle(TreemapTile t) => Box(t.Wide, t.Narrow) + (byValue && scaleModel!.Continuous && cells.TryGetValue(t.Item, out var c) ? $";--t:{Num(c.T * 100)}%" : "");

        // A tile's color in its tooltip.
        string TileColor(TreemapTile t)
        {
            if (!byValue) return $"var(--ib-chart-{slotOf[t.Item] % 8 + 1})";
            if (!cells.TryGetValue(t.Item, out var c)) return "var(--ib-color-fill-subtle)";
            if (!scaleModel!.Continuous) return $"var(--ib-heat-{c.Class + 1})";
            return $"color-mix(in oklab, var({(c.Low ? "--ib-heat-c" : "--ib-heat-b")}) {Num(c.T * 100)}%, var(--ib-heat-a))";
        }

        string GroupName(TreemapGroup g) => grouped ? groupNames[g.Index] : "";
        string Share(double part, double whole) => ChartMembers.Share(whole > 0 ? part / whole : 0);
        string? OfGroup(TreemapTile t, TreemapGroup g) => grouped ? string.Format(culture, TextDefaults.TreemapOfText, Share(t.Value, g.Total), GroupName(g)) : null;
        string OfAll(double value) => string.Format(culture, TextDefaults.TreemapOfAllText, Share(value, model.Total));

        var placeLegend = byValue && Place != ChartLegend.None;
        var chartClass = byValue ? Place switch { ChartLegend.Top => "ib-chart-lg-top ib-heatmap", _ => "ib-heatmap" } : null;
        var style = $"{colors}--ib-treemap-ratio:{Num(AspectRatio)}";
        var largest = tiles.MaxBy(t => t.Value);
        var description = largest is null
            ? ""
            : grouped
                ? string.Format(culture, TextDefaults.TreemapDescription, tiles.Count, model.Groups.Count, $"{names[largest.Item]}, {Format(largest.Value)}")
                : string.Format(culture, TextDefaults.TreemapDescriptionFlat, tiles.Count, $"{names[largest.Item]}, {Format(largest.Value)}");

        @if (drilled is { Depth: > 0 } && !HideBreadcrumb)
        {
            @ChartDrill.Crumbs(drilled, TextDefaults.ChartDrillTop, Title, TextDefaults)
        }
        <ib-chart data-ib-refresh="@_refresh.Every" data-ib-refresh-from="@_refresh.From" class="@chartClass" style="@style" data-ib-treemap="@tiles.Count"
                  data-ib-drilled="@drilled?.Said" data-ib-drill="@drilled?.Key" data-ib-deeper="@(drilled?.Hrefs is not null ? "" : null)">
            @if (drilled is not null)
            {
                @ChartDrill.Links(drilled)
            }
            @if (placeLegend && Place == ChartLegend.Top)
            {
                @(HeatmapChart<TItem>.ScaleLegend(scaleModel!, [], Palette?.IsDiverging == true, LegendListClass, TextDefaults))
            }
            <div class="@($"ib-chart-main ib-treemap{(byValue && scaleModel!.Continuous ? " ib-treemap-blend" : "")}")">
                <div class="ib-treemap-plot" role="img" aria-labelledby="@NameId" aria-describedby="@(_labelId)-desc">
                    @foreach (var group in model.Groups)
                    {
                        <div class="@(grouped ? $"ib-treemap-group{(group.HeadWide ? " ib-treemap-hw" : "")}{(group.HeadNarrow ? " ib-treemap-hn" : "")}" : "ib-treemap-group ib-treemap-flat")" style="@Box(group.Wide, group.Narrow)">
                            @if (grouped)
                            {
                                <div class="ib-treemap-head" data-ib-group="@group.Index" title="@(tooltip ? $"{GroupName(group)}: {Format(group.Total)}" : null)">
                                    <span class="ib-treemap-name">@GroupName(group)</span>@if (Values)
                                    {<span class="ib-treemap-value">@Format(group.Total)</span>}
                                </div>
                            }
                            <div class="ib-treemap-body">
                                @foreach (var tile in group.Tiles)
                                {
                                    <div class="@TileClass(tile)" style="@TileStyle(tile)" data-ib-tile="@tile.Item" title="@(tooltip ? $"{names[tile.Item]}: {Format(tile.Value)}" : null)">
                                        @if (Labels)
                                        {
                                            <span class="ib-treemap-name">@names[tile.Item]</span>
                                            @if (Values)
                                            {
                                                <span class="ib-treemap-value">@Format(tile.Value)</span>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (tooltip)
                    {
                        <div class="ib-chart-tooltip" hidden></div>
                    }
                </div>
            </div>
            @if (placeLegend && Place != ChartLegend.Top)
            {
                @(HeatmapChart<TItem>.ScaleLegend(scaleModel!, [], Palette?.IsDiverging == true, LegendListClass, TextDefaults))
            }
            @if (tooltip)
            {
                @* Each tile's and group's tooltip, drawn here so a template is real Razor; the script
                   shows the one under the pointer or keyboard focus, and says it in the live region. *@
                <div class="ib-chart-tips" hidden>
                    @foreach (var group in model.Groups)
                    {
                        @if (grouped)
                        {
                            <div data-ib-tip="@($"g{group.Index}")">
                                <div class="ib-chart-tooltip-title">
                                    <span>@GroupName(group)</span>
                                    <span class="ib-chart-tooltip-value">@Format(group.Total)</span>
                                </div>
                                <div class="ib-chart-tooltip-row"><span>@OfAll(group.Total)</span></div>
                            </div>
                        }
                        @foreach (var tile in group.Tiles)
                        {
                            <div data-ib-tip="@($"t{tile.Item}")">
                                @if (template is not null)
                                {
                                    @template(new ChartTooltipContext<TItem>(items[tile.Item], tile.Item, names[tile.Item], [new ChartTooltipPoint(_valueName ?? TextDefaults.ChartValue, tile.Value, Format(tile.Value), TileColor(tile))]))
                                }
                                else
                                {
                                    <div class="ib-chart-tooltip-title">
                                        <span>@names[tile.Item]</span>
                                        <span class="ib-chart-tooltip-value">@Format(tile.Value)</span>
                                    </div>
                                    @if (OfGroup(tile, group) is { } ofGroup)
                                    {
                                        <div class="ib-chart-tooltip-row"><span>@ofGroup</span></div>
                                    }
                                    <div class="ib-chart-tooltip-row"><span>@OfAll(tile.Value)</span></div>
                                    @if (drilled?.Hint is { } hint && drilled.Hrefs![tile.Item] is not null)
                                    {
                                        <div class="ib-chart-tooltip-hint">@hint</div>
                                    }
                                    @if (byValue)
                                    {
                                        <div class="ib-chart-tooltip-row">
                                            <span class="ib-chart-tooltip-key" style="@("background:" + TileColor(tile))"></span>
                                            <span>@(_colorName ?? TextDefaults.ChartValue)</span>
                                            <span class="ib-chart-tooltip-value">@(cells.TryGetValue(tile.Item, out var cell) ? cell.Text : TextDefaults.HeatmapNoData)</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
                <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
                <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@TextDefaults.TreemapKeys@(drilled?.Hrefs is not null ? " " + TextDefaults.ChartDrillKeys : null)</span>
            }
            <span id="@(_labelId)-desc" class="ib-visually-hidden">@description</span>
        </ib-chart>

        @if (DataTable != ChartDataTable.None)
        {
            RenderFragment dataTable = @<div class="ib-chart-table-scroll">
                    <table class="ib-chart-table" aria-labelledby="@NameId">
                        <thead>
                            <tr>
                                @if (grouped)
                                {
                                    <th scope="col">@(_groupName ?? TextDefaults.TreemapGroup)</th>
                                }
                                <th scope="col">@(drilled?.LevelName ?? _nameName ?? TextDefaults.TreemapName)</th>
                                <th scope="col">@(_valueName ?? TextDefaults.ChartValue)</th>
                                @if (grouped)
                                {
                                    <th scope="col">@TextDefaults.TreemapShareOfGroup</th>
                                }
                                <th scope="col">@TextDefaults.TreemapShareOfAll</th>
                                @if (byValue)
                                {
                                    <th scope="col">@(_colorName ?? TextDefaults.ChartValue)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in model.Groups)
                            {
                                @foreach (var tile in group.Tiles)
                                {
                                    <tr>
                                        @if (grouped)
                                        {
                                            <td>@GroupName(group)</td>
                                        }
                                        <th scope="row">@if (drilled?.Hrefs?[tile.Item] is { } href)
                                        {<a href="@href" data-ib-drill="@tile.Item">@names[tile.Item]</a>}
                                        else
                                        {@names[tile.Item]}</th>
                                        <td>@Format(tile.Value)</td>
                                        @if (grouped)
                                        {
                                            <td>@Share(tile.Value, group.Total)</td>
                                        }
                                        <td>@Share(tile.Value, model.Total)</td>
                                        @if (byValue)
                                        {
                                            <td>@(cells.TryGetValue(tile.Item, out var cell) ? cell.Text : TextDefaults.HeatmapNoData)</td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>;
            @ChartTools.Data(DataTable, _labelId, Title, TitledBy, TextDefaults, dataTable)
        }
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-chart");
        classes.Add("ib-treemap-chart");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _refresh.Check("TreemapChart", Refresh, RefreshFrom, RendererInfo, AssignedRenderMode, AdditionalAttributes, OnRefresh.HasDelegate);
        if (string.IsNullOrWhiteSpace(Title) == string.IsNullOrWhiteSpace(TitledBy))
        {
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(Title)
                ? "TreemapChart needs a Title, such as \"Cloud costs by service\", or TitledBy, the id of a heading on the page that titles it."
                : "TreemapChart takes a Title or TitledBy, not both: TitledBy names it from a heading already on the page.");
        }

        if (Value is null)
        {
            throw new InvalidOperationException("TreemapChart needs a Name and a Value for each tile, such as c => c.Service and c => c.Amount.");
        }

        if (!(AspectRatio >= 0.5 && AspectRatio <= 4))
        {
            throw new ArgumentOutOfRangeException(nameof(AspectRatio), AspectRatio, "A TreemapChart's AspectRatio, its width over its height, is 0.5 to 4.");
        }

        if (ColorValue is null)
        {
            if (Steps != 5 || Min is not null || Max is not null || Midpoint is not null || ColorFormat is not null || Legend != ChartLegend.Auto || LegendAlign is not null)
            {
                throw new InvalidOperationException("A TreemapChart's Steps, Min, Max, Midpoint, ColorFormat, Legend and LegendAlign are for a scale of ColorValue: set ColorValue, or leave them out.");
            }

            if (Colors == TreemapColors.Group && Group is null)
            {
                throw new InvalidOperationException("A TreemapChart colored by group needs Group, each tile's group, such as c => c.Category; without groups, leave Colors out.");
            }

            if (Palette is not null && (Palette.IsDiverging || !Palette.IsCategorical && Palette.FixedCount is null))
            {
                throw new InvalidOperationException("A TreemapChart's tiles are colored by group or by tile, which needs distinct colors: use ChartPalette.Colors or ChartPalette.Of. Shades and Diverging are for a ColorValue scale.");
            }
        }
        else
        {
            if (Colors != TreemapColors.Auto)
            {
                throw new InvalidOperationException("A TreemapChart with ColorValue colors its tiles by that value: leave out Colors.");
            }

            HeatmapLayout.CheckScale("TreemapChart", 0, Palette, Steps, Min, Max, Midpoint);
            if (Steps != 0 && Steps is < 2 or > 9)
            {
                throw new ArgumentOutOfRangeException(nameof(Steps), Steps, "A TreemapChart's Steps is 2 to 9, or 0 for a continuous blend.");
            }

            if (Palette?.IsCategorical == true)
            {
                throw new InvalidOperationException("A TreemapChart's ColorValue colors show how much, not which: use ChartPalette.Shades, ChartPalette.Diverging or ChartPalette.Of, not ChartPalette.Colors.");
            }

            if (Midpoint is not null && Palette?.IsDiverging != true)
            {
                throw new InvalidOperationException("A TreemapChart's Midpoint is where a ChartPalette.Diverging scale turns: set Palette to one, or leave Midpoint out.");
            }

            if (Min is { } min && Max is { } max && !(max > min))
            {
                throw new ArgumentOutOfRangeException(nameof(Max), Max, "A TreemapChart's Max must be more than its Min.");
            }

            if (Legend is ChartLegend.Start or ChartLegend.End)
            {
                throw new InvalidOperationException("A TreemapChart's legend goes above or below the tiles: Legend takes Auto, Top, Bottom or None.");
            }
        }

        if (!ReferenceEquals(Name, _lastName))
        {
            _lastName = Name;
            _name = Name?.Compile();
            _nameName = Name is null ? null : ChartMembers.Name(Name);
        }

        if (!ReferenceEquals(Value, _lastValue))
        {
            _lastValue = Value;
            _value = Value.Compile();
            _valueName = ChartMembers.Name(Value);
        }

        if (!ReferenceEquals(Group, _lastGroup))
        {
            _lastGroup = Group;
            _group = Group?.Compile();
            _groupName = Group is null ? null : ChartMembers.Name(Group);
        }

        if (!ReferenceEquals(ColorValue, _lastColor))
        {
            _lastColor = ColorValue;
            _color = ColorValue?.Compile();
            _colorName = ColorValue is null ? null : ChartMembers.Name(ColorValue);
        }

        base.OnParametersSet();
        (_class, _style) = BuildRootAttributes();
    }
}
