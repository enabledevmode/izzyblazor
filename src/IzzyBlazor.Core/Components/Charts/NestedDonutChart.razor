@namespace IzzyBlazor
@typeparam TItem
@inherits PieChartBase<TItem>
@attribute [ModeSupport]
@attribute [CascadingTypeParameter(nameof(TItem))]
@using System.Globalization

@*
    A donut with a ring for each measure of the same items, such as a country's exports and its
    imports, drawn on the server. The first ring is the outer one; each item has one color in every
    ring and one row in the legend. A line under the title says which ring is which.

    <NestedDonutChart Items="countries"
                      Argument="c => c.Country"
                      Title="Trade by partner, 2025"
                      ValueFormat="C0">
        <DonutRing Value="c => c.Exports" Name="Exports" />
        <DonutRing Value="c => c.Imports" Name="Imports" />
    </NestedDonutChart>

    Rings compare poorly: the same share is a longer arc on the outer ring. To compare how two
    wholes split, a Chart with 100% stacked bars reads better; use rings for two, at most three.

    Accessibility:
    - The chart is a figure captioned by Title, or named by a heading on the page with TitledBy.
    - The circle is one image named by the caption and described by the line naming the rings.
    - The legend is text: each item's name, read in order.
    - "Show data" under the chart opens a table of every ring's values and shares (DataTable).
    - With script, the circle is one Tab stop: Left and Right move along a ring, Up and Down
      between rings, and each slice is said with its ring.

    Keyboard:
    On the circle
    - Right, Left | Show the next or previous slice in the same ring
    - Down, Up | Move to the same item on the ring inside or outside
    - Home, End | Go to the ring's first or last slice
    - Escape | Hide the tooltip
    See also: PieChart, Chart.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@TitleClass">@Title</figcaption>
    }
    <CascadingValue Value="_rings" IsFixed="true">
        @ChildContent
        @PlotFragment
    </CascadingValue>
</figure>

@code {
    /// <summary>The rings, as <see cref="DonutRing{TItem}"/> items: the first is the outer one.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Content in the hole, such as a total.</summary>
    [Parameter] public RenderFragment? Center { get; set; }

    /// <summary>The hole, as a share of the radius: the rings share the rest equally.</summary>
    internal const double Hole = 0.5;

    private readonly DonutRings<TItem> _rings = new();
    private RenderFragment PlotFragment = null!;

    private protected override string ComponentName => "NestedDonutChart";

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        PlotFragment = builder =>
        {
            builder.OpenComponent<ChartPlot>(0);
            builder.AddComponentParameter(1, nameof(ChartPlot.Content), (RenderFragment)RenderCircle);
            builder.AddComponentParameter(2, nameof(ChartPlot.Attach), (Action<ChartPlot>)(plot => _rings.Plot = plot));
            builder.CloseComponent();
        };
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _rings.BeginPass();
    }

    // Each ring's name by its place: outside, (middle,) inside; by number past three.
    private string RingName(int r, int count, string name) => count switch
    {
        1 => name,
        _ when r == 0 => string.Format(CultureInfo.CurrentCulture, TextDefaults.ChartRingOutside, name),
        _ when r == count - 1 => string.Format(CultureInfo.CurrentCulture, TextDefaults.ChartRingInside, name),
        3 => string.Format(CultureInfo.CurrentCulture, TextDefaults.ChartRingMiddle, name),
        _ => string.Format(CultureInfo.CurrentCulture, TextDefaults.ChartRingNumber, r + 1, name),
    };

    private void RenderCircle(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        var rings = _rings.Items;
        // No rings (yet, or none left): only the title, as a Chart with no series.
        if (rings.Count == 0)
        {
            return;
        }

        var (items, names) = ReadItems();
        var n = items.Count;
        var thickness = (1 - Hole) / rings.Count;
        var values = rings.Select(r => items.Select(i => ChartMembers.ToNumber(r.Read(i))).ToArray()).ToArray();
        var slices = values.Select((v, r) => ChartShapes.Pie(v, 1 - (r + 1) * thickness, StartTurn, 1 - r * thickness)).ToArray();
        var texts = values.Select(v => v.Select(FormatValue).ToArray()).ToArray();
        var shares = values.Select(v =>
        {
            var total = v.Sum(x => x is > 0 ? x.Value : 0);
            return v.Select(x => x is > 0 && total > 0 ? Share(x.Value / total) : null).ToArray();
        }).ToArray();
        var ringsId = $"{_labelId}-rings";

        @* Which ring is which, under the title; it also describes the circle. *@
        <p id="@ringsId" class="ib-pie-rings">
            @for (var r = 0; r < rings.Count; r++)
            {
                @if (r > 0)
                {
                    <span class="ib-pie-rings-sep" aria-hidden="true"> · </span><span class="ib-visually-hidden">, </span>
                }
                <span>@RingName(r, rings.Count, rings[r].DisplayName)</span>
            }
        </p>
        <ib-chart style="@Palette?.Style(n)"
                  data-ib-pie="@Num(Hole)"
                  data-ib-rings="@rings.Count"
                  data-ib-count="@n"
                  data-ib-draw="@(Legend != ChartLegend.None ? DrawData(values, Enumerable.Range(0, rings.Count).Select(r => (1 - (r + 1) * thickness, 1 - r * thickness)).ToArray(), 0) : null)"
                  data-ib-pos="@string.Join(";", slices.Select(ring => string.Join(",", Enumerable.Range(0, n).Select(i => ring.FirstOrDefault(s => s.Index == i) is { } s ? $"{Num(s.Start)} {Num(s.End)}" : ""))))">
            <div class="@PieClass">
                <div class="ib-pie-unringed">
                <div class="ib-pie-plot">
                    <div class="ib-pie-frame" role="img" aria-labelledby="@NameId" aria-describedby="@ringsId">
                        <svg class="ib-pie-svg" viewBox="-1 -1 2 2">
                            @for (var r = 0; r < rings.Count; r++)
                            {
                                @if (slices[r].Count == 0)
                                {
                                    <path class="ib-pie-empty" d="@ChartShapes.Pie([1], 1 - (r + 1) * thickness, 0, 1 - r * thickness)[0].Path" />
                                }
                                @foreach (var slice in slices[r])
                                {
                                    <path class="@($"ib-pie-slice {Slot(slice.Index)}")" d="@slice.Path" data-ib-i="@(r * n + slice.Index)">@if (Tooltip)
                                    {<title>@($"{names[slice.Index]}, {rings[r].DisplayName}: {texts[r][slice.Index]} ({shares[r][slice.Index]})")</title>}</path>
                                }
                            }
                        </svg>
                    </div>
                    @if (Center is not null)
                    {
                        <div class="ib-pie-center ib-pie-center-nested">@Center</div>
                    }
                    @if (Tooltip)
                    {
                        <div class="ib-chart-tooltip" hidden></div>
                    }
                </div>
                </div>
                @if (Legend != ChartLegend.None)
                {
                    @* Names only: each item's value differs ring by ring (the tooltip and table have them). *@
                    <ul class="@(LegendListClass + " ib-pie-names")">
                        @for (var i = 0; i < n; i++)
                        {
                            <li class="@Slot(i)">
                                @* With script, a button that hides and shows the item's slices. *@
                                <span class="ib-pie-toggle" data-ib-series="@i">
                                    <span class="ib-pie-key" aria-hidden="true"></span>
                                    <span class="ib-pie-name">@names[i]</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (Tooltip)
            {
                <div class="ib-chart-tips" hidden>
                    @for (var r = 0; r < rings.Count; r++)
                    {
                        @for (var i = 0; i < n; i++)
                        {
                            <div data-ib-tip>
                                <div class="ib-chart-tooltip-title">@names[i]</div>
                                <div class="ib-chart-tooltip-row">
                                    <span class="@($"ib-chart-tooltip-key {Slot(i)}")"></span>
                                    <span>@rings[r].DisplayName</span>
                                    <span class="ib-chart-tooltip-value">@texts[r][i]</span>
                                </div>
                                <div class="ib-chart-tooltip-row">
                                    <span class="ib-chart-tooltip-key ib-pie-blank"></span>
                                    <span>@TextDefaults.ChartShare</span>
                                    <span class="ib-chart-tooltip-value" data-ib-share="@(r * n + i)">@shares[r][i]</span>
                                </div>
                            </div>
                        }
                    }
                </div>
                <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
                <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@(rings.Count > 1 ? TextDefaults.ChartRingKeys : TextDefaults.ChartKeys)</span>
            }
        </ib-chart>

        @if (DataTable != ChartDataTable.None)
        {
            <details class="ib-collapsible ib-disclosure ib-chart-data" open="@(DataTable == ChartDataTable.Visible)">
                <summary class="ib-collapsible-trigger" aria-labelledby="@(TitledBy is null ? null : $"{_labelId}-show {TitledBy}")">
                    <Icon Purpose="IconPurpose.ChevronRight" Class="ib-collapsible-chevron" />
                    <span id="@(_labelId)-show">@TextDefaults.ChartShowData@if (Title is not null)
                        {<span class="ib-visually-hidden">, @Title</span>}</span>
                </summary>
                <div class="ib-chart-table-scroll">
                    <table class="ib-chart-table" aria-labelledby="@NameId">
                        <thead>
                            <tr>
                                <th scope="col">@(_argumentName ?? TextDefaults.ChartItem)</th>
                                @foreach (var ring in rings)
                                {
                                    <th scope="col">@ring.DisplayName</th>
                                    <th scope="col">@TextDefaults.ChartShare<span class="ib-visually-hidden">, @ring.DisplayName</span></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < n; i++)
                            {
                                <tr>
                                    <th scope="row">@names[i]</th>
                                    @for (var r = 0; r < rings.Count; r++)
                                    {
                                        <td>@texts[r][i]</td>
                                        <td>@shares[r][i]</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    }
}
