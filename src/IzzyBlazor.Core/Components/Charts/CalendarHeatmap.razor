@namespace IzzyBlazor
@typeparam TItem
@inherits LayoutItemBase
@implements IDisposable
@attribute [ModeSupport]
@using System.Globalization
@using System.Linq.Expressions
@using System.Text.Json

@*
    A value for each day, such as commits or orders, as a calendar.

    <CalendarHeatmap Items="commits" Date="c => c.Day" Value="c => c.Count" Title="Commits this year" />

    The range runs from the first item's day to the last's, or From to To. Weeks start on the
    culture's first day, or FirstDayOfWeek. A day in the range with no item, or a null value, is
    drawn as no data, never as a zero. The colors are a HeatmapChart's: five even steps from round
    bounds by default (Steps, Min, Max), a diverging palette's two sides of Midpoint, your own
    HeatmapRange children, or a continuous blend (Steps 0). The legend is the scale.

    Accessibility:
    - The chart is a figure captioned by Title, or named by a heading on the page with TitledBy.
    - The calendar is one image named by the caption. The legend lists the scale's classes.
    - "Show data" under the chart opens the values as a table, a column per month and a row per
      day of the month (DataTable).
    - With script, the calendar is one Tab stop: the arrow keys move from day to day and say each
      one's date and value.

    Keyboard:
    On the calendar
    - Down, Up | Move to the next or previous day
    - Right, Left | Move a week later or earlier (reversed on right-to-left pages)
    - Home, End | Go to the first or last day in the row
    - Ctrl+Home, Ctrl+End | Go to the first or last day
    - Escape | Hide the tooltip
    See also: HeatmapChart, Chart.
*@

<figure @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-labelledby="@TitledBy">
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/chart.css"]" />
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/heatmap.css"]" />
    @if (TitledBy is null)
    {
        <figcaption id="@_labelId" class="@(HideTitle ? "ib-visually-hidden" : TitleAlign switch { ChartAlign.Center => "ib-chart-label ib-chart-label-center", ChartAlign.End => "ib-chart-label ib-chart-label-end", _ => "ib-chart-label" })">@Title</figcaption>
    }
    <CascadingValue Value="_context" IsFixed="true">
        @ChildContent
        @_plotFragment
    </CascadingValue>
    @if (Download)
    {
        @* Download, across from the title (chart.css): last, so the title's neighbor rules
           (label + legend, label + rings) still meet. *@
        @ChartTools.Tools(TextDefaults)
    }
</figure>

@code {
    /// <summary>
    /// How often the chart reads its data again, at least a second, such as
    /// <c>Refresh="TimeSpan.FromSeconds(30)"</c>. On a static page the page (or
    /// <see cref="RefreshFrom"/>) is fetched again and the chart drawn from it, found by its
    /// <c>id</c>, which it then needs; on an interactive page <see cref="OnRefresh"/> is raised, for
    /// you to load new data. Not while the tab is hidden or the chart is off-screen, nor (static)
    /// while the pointer or focus is in it. Unlike Chart's, it has no Pause button.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public TimeSpan? Refresh { get; set; }

    /// <summary>On a static page with <see cref="Refresh"/>: a lighter page to fetch than this one, which renders the same chart with the same <c>id</c>.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public string? RefreshFrom { get; set; }

    /// <summary>On an interactive page with <see cref="Refresh"/>: raised at each interval, to load new data.</summary>
    [Parameter, ModeSupport(Static = ModeLevel.None, NoScript = ModeLevel.None)]
    public EventCallback OnRefresh { get; set; }

    private readonly ChartRefresh _refresh = new();

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        _refresh.AfterRender(Refresh, RendererInfo, OnRefresh, InvokeAsync, DispatchExceptionAsync);
    }

    /// <inheritdoc />
    public void Dispose() => _refresh.Dispose();

    /// <summary>The items, a day each: each names its day and its value.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Each item's day, such as <c>c =&gt; c.Day</c>: a <see cref="DateOnly"/>, <see cref="DateTime"/>
    /// or <see cref="DateTimeOffset"/> (the time is ignored). A day named twice keeps the last item.
    /// </summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Date { get; set; } = default!;

    /// <summary>Each item's value, such as <c>c =&gt; c.Count</c>: any number, or null for no data.</summary>
    [Parameter, EditorRequired] public Expression<Func<TItem, object?>> Value { get; set; } = default!;

    /// <summary>
    /// The first day shown: the earliest item's day by default. For the last twelve months, such
    /// as GitHub's, set it to a year before <see cref="To"/>, plus a day.
    /// </summary>
    [Parameter] public DateOnly? From { get; set; }

    /// <summary>The last day shown: the latest item's day by default.</summary>
    [Parameter] public DateOnly? To { get; set; }

    /// <summary>The day each week's column starts on, at the top: the culture's by default (Sunday in en-US, Monday in most of Europe).</summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }

    /// <summary>
    /// The chart's title, such as "Commits this year", shown above it as its caption. It also
    /// names the chart for screen readers. A chart needs a Title or <see cref="TitledBy"/>.
    /// </summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Hides the title, which still names the chart for screen readers.</summary>
    [Parameter] public bool HideTitle { get; set; }

    /// <summary>
    /// Shows a button across from the title that saves the chart as a PNG, named after its title,
    /// in the color scheme on screen. With JavaScript off there's no button.
    /// </summary>
    [Parameter] public bool Download { get; set; }

    /// <summary>
    /// Where the title sits: at the start by default (the left, in a left-to-right page);
    /// <see cref="ChartAlign.Center"/> or <see cref="ChartAlign.End"/>.
    /// </summary>
    [Parameter] public ChartAlign TitleAlign { get; set; }

    /// <summary>
    /// The id of a heading already on the page that titles the chart, such as a card's, in place of
    /// <see cref="Title"/>: the chart takes its name from it and shows no title of its own.
    /// </summary>
    [Parameter] public string? TitledBy { get; set; }

    /// <summary>A .NET format string for the values, such as <c>N0</c> or <c>P0</c>: in the legend, the tooltips and the table.</summary>
    [Parameter] public string? ValueFormat { get; set; }

    /// <summary>
    /// The colors: <see cref="ChartPalette.Shades"/> of the primary color by default, light to
    /// dark for low to high; <see cref="ChartPalette.Shades"/> of another color;
    /// <see cref="ChartPalette.Diverging"/> for values above and below <see cref="Midpoint"/>,
    /// such as each day's temperature against normal; or your own ramp with
    /// <see cref="ChartPalette.Of"/>, one class per color. <see cref="ChartPalette.Colors"/> throws.
    /// </summary>
    [Parameter] public ChartPalette? Palette { get; set; }

    /// <summary>
    /// How many classes the values fall into, each a shade: 5 by default, 2 to 9, even steps
    /// between round bounds around the values (or from <see cref="Min"/> to <see cref="Max"/>).
    /// <c>0</c> blends the color continuously instead, with the legend a gradient.
    /// </summary>
    [Parameter] public int Steps { get; set; } = 5;

    /// <summary>The value a <see cref="ChartPalette.Diverging"/> scale turns at, gray in the middle: 0 by default.</summary>
    [Parameter] public double? Midpoint { get; set; }

    /// <summary>The scale's low end, so calendars side by side, such as one per year, share a scale. Lower values take the first class.</summary>
    [Parameter] public double? Min { get; set; }

    /// <summary>The scale's high end. Higher values take the last class.</summary>
    [Parameter] public double? Max { get; set; }

    /// <summary>
    /// The largest a day grows to: <c>2rem</c> by default. Days are square and fit the width, so
    /// they're smaller where there's less room; a smaller size, such as <c>Length.Px(12)</c>,
    /// keeps a calendar compact, as in a sidebar or a profile.
    /// </summary>
    [Parameter] public Length? CellSize { get; set; }

    /// <summary>
    /// Where the legend, the color scale, goes: above the calendar by default (<see cref="ChartLegend.Auto"/>
    /// or <see cref="ChartLegend.Top"/>), <see cref="ChartLegend.Bottom"/>, or upright beside it with
    /// <see cref="ChartLegend.Start"/> or <see cref="ChartLegend.End"/> (above it under 30rem);
    /// <see cref="ChartLegend.None"/> leaves it out. With script, each class's key hides and shows
    /// the days in it.
    /// </summary>
    [Parameter] public ChartLegend Legend { get; set; }

    /// <summary>The legend's place along its edge: the start by default, the center or the end.</summary>
    [Parameter] public ChartAlign? LegendAlign { get; set; }

    /// <summary>
    /// The tooltip for the day under the pointer or the keyboard (with script), beside its cell:
    /// on by default. With <c>false</c>, there are no tooltips and no keys.
    /// </summary>
    [Parameter] public bool Tooltip { get; set; } = true;

    /// <summary>The values as a table, a column per month and a row per day of the month: in a closed "Show data" disclosure under the chart, by default.</summary>
    [Parameter] public ChartDataTable DataTable { get; set; }

    /// <summary><see cref="HeatmapRange"/>s, your own classes, and a <see cref="HeatmapTooltip{TItem}"/> (its Date the day, Column the day as text, Row the weekday).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _labelId = IdGenerator.Next("ib-chart");
    private readonly HeatmapContext _context = new();
    private RenderFragment _plotFragment = null!;
    private Expression<Func<TItem, object?>>? _lastDate, _lastValue;
    private Func<TItem, object?>? _date, _value;
    private string? _valueName;
    private string? _class;
    private string? _style;

    private string NameId => TitledBy ?? _labelId;

    private static string Num(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _plotFragment = builder =>
        {
            builder.OpenComponent<ChartPlot>(0);
            builder.AddComponentParameter(1, nameof(ChartPlot.Content), (RenderFragment)RenderPlot);
            builder.AddComponentParameter(2, nameof(ChartPlot.Attach), (Action<ChartPlot>)(plot => _context.Plot = plot));
            builder.CloseComponent();
        };
        base.OnInitialized();
    }

    private ChartLegend Place => Legend == ChartLegend.Auto ? ChartLegend.Top : Legend;

    private string LegendListClass => LegendAlign switch
    {
        ChartAlign.Center => "ib-chart-legend ib-chart-legend-center",
        ChartAlign.End => "ib-chart-legend ib-chart-legend-end",
        _ => "ib-chart-legend ib-chart-legend-start",
    };

    // A length's pixels at a 16px root, where it's in px or rem; 32 otherwise.
    private static double Pixels(Length? length)
    {
        var css = length?.Css ?? "2rem";
        if (css.EndsWith("rem", StringComparison.Ordinal) && double.TryParse(css[..^3], NumberStyles.Float, CultureInfo.InvariantCulture, out var rem)) return rem * 16;
        if (css.EndsWith("px", StringComparison.Ordinal) && double.TryParse(css[..^2], NumberStyles.Float, CultureInfo.InvariantCulture, out var px)) return px;
        return 32;
    }

    private static DateOnly? ToDay(object? value) => value switch
    {
        null => null,
        DateOnly d => d,
        DateTime d => DateOnly.FromDateTime(d),
        DateTimeOffset d => DateOnly.FromDateTime(d.DateTime),
        _ => throw new InvalidOperationException($"A CalendarHeatmap's Date is a DateOnly, DateTime or DateTimeOffset, not {value.GetType().Name}."),
    };

    private void RenderPlot(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder __builder)
    {
        var items = Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];
        var ranges = _context.Ranges.Items;
        if (ranges.Count > 9)
        {
            throw new InvalidOperationException("A CalendarHeatmap takes up to nine HeatmapRanges: past that, colors are hard to tell apart.");
        }

        HeatmapLayout.CheckScale("CalendarHeatmap", ranges.Count, Palette, Steps, Min, Max, Midpoint);
        var palette = Palette ?? ChartPalette.Shades(Color.Primary);
        var model = CalendarLayout.Build(new CalendarInput
        {
            Dates = items.Select(i => ToDay(_date!(i))).ToArray(),
            Values = items.Select(i => ChartMembers.ToNumber(_value!(i))).ToArray(),
            From = From,
            To = To,
            FirstDayOfWeek = FirstDayOfWeek,
            MaxCellPx = Pixels(CellSize),
            Scale = new HeatmapInput
            {
                Columns = [],
                Rows = [],
                Values = [],
                ValueFormat = ValueFormat,
                Steps = Steps,
                FixedColors = palette.FixedCount,
                Diverging = palette.IsDiverging,
                Midpoint = Midpoint ?? 0,
                Min = Min,
                Max = Max,
                Ranges = ranges.Count > 0 ? ranges.Select(r => (r.From, r.To)).ToArray() : null,
            },
        });

        var heat = model.Heat;
        var cols = model.Weeks;
        var colors = ranges.Count > 0
            ? string.Concat(ranges.Select((r, k) => $"--ib-heat-{k + 1}:{StyleValues.Color(r.Color!.Value)};"))
            : palette.HeatStyle(heat.ClassCount);
        var style = $"{colors}--ib-heat-cols:{cols}{(CellSize is { } size ? $";--ib-cal-max:{size.Css}" : null)}";
        var tooltip = _context.Tooltip as RenderFragment<HeatmapCellContext<TItem>>;
        var legendClass = Place switch
        {
            ChartLegend.Top => "ib-chart-lg-top ib-heatmap",
            ChartLegend.Start => "ib-chart-lg-start ib-heatmap",
            ChartLegend.End => "ib-chart-lg-end ib-heatmap",
            _ => "ib-heatmap",
        };
        var legendFirst = Place is ChartLegend.Top or ChartLegend.Start;
        string Cell(HeatmapCell c) => c.Out ? "ib-heat-out" : c.Class < 0 ? "" : (heat.Continuous ? (c.Low ? "ib-lo" : "") : $"ib-k{c.Class + 1}");

        <ib-chart data-ib-refresh="@_refresh.Every" data-ib-refresh-from="@_refresh.From" class="@legendClass" style="@style"
                  data-ib-heat="@cols"
                  data-ib-cal
                  data-ib-dates="@(Tooltip ? JsonSerializer.Serialize(model.DateTexts, PersistedStateJson.Default.StringArray) : null)"
                  data-ib-value="@(_valueName ?? TextDefaults.ChartValue)"
                  data-ib-none="@TextDefaults.HeatmapNoData">
            @if (legendFirst && Place != ChartLegend.None)
            {
                @(HeatmapChart<TItem>.ScaleLegend(heat, ranges, palette.IsDiverging, LegendListClass, TextDefaults))
            }
            <div class="@($"ib-chart-main ib-heat ib-cal ib-heat-l8 ib-heat-g{heat.GapFrom} ib-cal-r{model.RowsFrom} ib-cal-n{model.NamesFrom}{(heat.Continuous ? " ib-heat-blend" : "")}")">
                <div class="ib-chart-bottom ib-cal-months" aria-hidden="true">
                    <div class="ib-chart-ticks">
                        @foreach (var tick in heat.Ticks)
                        {
                            <span class="@(tick.From > 0 ? $"ib-chart-from{tick.From}" : null)" style="left:@Num(tick.Pos * 100)%">@tick.Text</span>
                        }
                    </div>
                </div>
                <div class="ib-heat-rows" aria-hidden="true">
                    @for (var r = 0; r < 7; r++)
                    {
                        <span class="@(model.RowKept[r] ? null : "ib-cal-thin")">@heat.RowTexts[r]</span>
                    }
                </div>
                <div class="ib-heat-frame" role="img" aria-labelledby="@NameId">
                    <div class="ib-heat-grid">
                        @foreach (var c in heat.Cells)
                        {
                            <div class="@(Cell(c) is { Length: > 0 } k ? k : null)" style="@(heat.Continuous && c.Class >= 0 ? $"--t:{Num(c.T * 100)}%" : null)">@c.Text</div>
                        }
                    </div>
                    @if (Tooltip)
                    {
                        <div class="ib-chart-tooltip" hidden></div>
                    }
                </div>
            </div>
            @if (!legendFirst && Place != ChartLegend.None)
            {
                @(HeatmapChart<TItem>.ScaleLegend(heat, ranges, palette.IsDiverging, LegendListClass, TextDefaults))
            }
            @if (Tooltip)
            {
                @if (tooltip is not null)
                {
                    <div class="ib-chart-tips" hidden>
                        @for (var c = 0; c < heat.Cells.Length; c++)
                        {
                            var cell = heat.Cells[c];
                            if (cell.Item < 0) continue;
                            <div data-ib-tip="@c">@tooltip(new HeatmapCellContext<TItem>(items[cell.Item], cell.Item, model.DateTexts[c]!, heat.RowTexts[c / cols], cell.Value, cell.Text, model.DateOf(c)))</div>
                        }
                    </div>
                }
                <div class="ib-visually-hidden" aria-live="polite" aria-atomic="true" data-ib-live></div>
                <span id="@(_labelId)-keys" class="ib-visually-hidden" data-ib-keys="@TextDefaults.ChartRole">@TextDefaults.ChartKeys</span>
            }
        </ib-chart>

        @if (DataTable != ChartDataTable.None)
        {
            var culture = CultureInfo.CurrentCulture;
            var years = model.Months.Count > 0 && model.Months[0].Year != model.Months[^1].Year;
            <details class="ib-collapsible ib-disclosure ib-chart-data" open="@(DataTable == ChartDataTable.Visible)">
                <summary class="ib-collapsible-trigger" aria-labelledby="@(TitledBy is null ? null : $"{_labelId}-show {TitledBy}")">
                    <Icon Purpose="IconPurpose.ChevronRight" Class="ib-collapsible-chevron" />
                    <span id="@(_labelId)-show">@TextDefaults.ChartShowData@if (Title is not null)
                        {<span class="ib-visually-hidden">, @Title</span>}</span>
                </summary>
                <div class="ib-chart-table-scroll">
                    <table class="ib-chart-table" aria-labelledby="@NameId">
                        <thead>
                            <tr>
                                <th scope="col">@TextDefaults.CalendarHeatmapDay</th>
                                @foreach (var month in model.Months)
                                {
                                    <th scope="col">@month.ToString(years ? "MMM yyyy" : "MMM", culture)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var day = 1; day <= 31; day++)
                            {
                                <tr>
                                    <th scope="row">@day.ToString(culture)</th>
                                    @foreach (var month in model.Months)
                                    {
                                        <td>@DayText(model, month, day)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    }

    // A day's value in the table: blank for a day the month lacks or outside the range.
    private string? DayText(CalendarModel model, DateOnly month, int day)
    {
        if (day > DateTime.DaysInMonth(month.Year, month.Month)) return null;
        var date = new DateOnly(month.Year, month.Month, day);
        if (date < model.From || date > model.To) return null;
        var c = model.CellOf(date);
        return model.Heat.Cells[c].Text ?? TextDefaults.HeatmapNoData;
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-chart");
        classes.Add("ib-heatmap-chart");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _refresh.Check("CalendarHeatmap", Refresh, RefreshFrom, RendererInfo, AssignedRenderMode, AdditionalAttributes, OnRefresh.HasDelegate);
        if (string.IsNullOrWhiteSpace(Title) == string.IsNullOrWhiteSpace(TitledBy))
        {
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(Title)
                ? "CalendarHeatmap needs a Title, such as \"Commits this year\", or TitledBy, the id of a heading on the page that titles it."
                : "CalendarHeatmap takes a Title or TitledBy, not both: TitledBy names it from a heading already on the page.");
        }

        if (Date is null || Value is null)
        {
            throw new InvalidOperationException("CalendarHeatmap needs a Date and a Value for each item, such as c => c.Day and c => c.Count.");
        }

        if (Steps != 0 && Steps is < 2 or > 9)
        {
            throw new ArgumentOutOfRangeException(nameof(Steps), Steps, "A CalendarHeatmap's Steps is 2 to 9, or 0 for a continuous blend.");
        }

        if (Palette?.IsCategorical == true)
        {
            throw new InvalidOperationException("A CalendarHeatmap's colors show how much, not which: use ChartPalette.Shades, ChartPalette.Diverging or ChartPalette.Of, not ChartPalette.Colors.");
        }

        if (Midpoint is not null && Palette?.IsDiverging != true)
        {
            throw new InvalidOperationException("A CalendarHeatmap's Midpoint is where a ChartPalette.Diverging scale turns: set Palette to one, or leave Midpoint out.");
        }

        if (Min is { } min && Max is { } max && !(max > min))
        {
            throw new ArgumentOutOfRangeException(nameof(Max), Max, "A CalendarHeatmap's Max must be more than its Min.");
        }

        if (From is { } from && To is { } to && to < from)
        {
            throw new ArgumentOutOfRangeException(nameof(To), To, "A CalendarHeatmap's To can't be before its From.");
        }

        if (!ReferenceEquals(Date, _lastDate))
        {
            _lastDate = Date;
            _date = Date.Compile();
        }

        if (!ReferenceEquals(Value, _lastValue))
        {
            _lastValue = Value;
            _value = Value.Compile();
            _valueName = ChartMembers.Name(Value);
        }

        _context.Ranges.BeginPass();
        base.OnParametersSet();
        (_class, _style) = BuildRootAttributes();
    }
}
