@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>

@*
    Blazor marks the selected option itself when rendering statically, from the select's bound value.

    A native select. Options come from Items, or automatically from an enum.
    <Select @bind-Value="Model.Plan" />                                   (enum: options from its values)
    <Select @bind-Value="Model.CountryId" Items="Countries" ItemText="c => Names[c]" Placeholder="Choose a country" />

    Where the browser supports the customizable select (appearance: base-select), the open list
    is themed and ItemTemplate's markup is shown in it and in the closed field. Elsewhere the
    browser's own list shows ItemText, so keep both.
    <Select @bind-Value="Model.Plan" ItemTemplate="plan => @<span>@plan <small class="ib-option-hint">@Prices[plan]</small></span>" />
*@

<FieldFrame Class="@WrapperClass("select")" Style="@WrapperStyle" Id="@FieldId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    @if (ShowsReadOnly)
    {
        @ReadOnlyControl(ReadOnlyText)
    }
    else
    {
    <ib-field-control class="ib-field-control ib-has-end">
        <select @attributes="ControlAttributes"
                id="@FieldId"
                class="ib-field-input ib-field-select"
                name="@NameAttributeValue"
                @bind="CurrentValueAsString"
                required="@IsRequired"
                disabled="@IsDisabled"
                aria-invalid="@(Invalid ? "true" : null)"
                aria-describedby="@DescribedBy">
            @if (ItemTemplate is not null)
            {
                @* The closed field shows a copy of the chosen option's markup. *@
                <button class="ib-select-button" type="button"><selectedcontent class="ib-select-value"></selectedcontent></button>
            }
            @if (Placeholder is not null)
            {
                @* Browsers skip a disabled first option unless it is marked selected. *@
                <option value="" disabled="@IsRequired" selected="@string.IsNullOrEmpty(CurrentValueAsString)">@Placeholder</option>
            }
            @foreach (var item in Options)
            {
                var value = FormatValueAsString(item);
                if (ItemTemplate is null)
                {
                    <option value="@value">@TextFor(item)</option>
                }
                else
                {
                    @* data-ib-label becomes the label where rich options aren't supported (see select.ts). *@
                    <option value="@value" class="ib-option" data-ib-label="@TextFor(item)">@ItemTemplate(item)</option>
                }
            }
        </select>
        <Icon Role="IconRole.ChevronDown" Class="ib-field-icon ib-field-icon-end" />
    </ib-field-control>
    }
    @if (PostsReadOnlyValue)
    {
        @* Read-only: the value shows in a read-only text field, which doesn't post it; this does. *@
        <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString" />
    }
</FieldFrame>

@code {
    /// <summary>The options. Not needed for enums, whose values are listed automatically.</summary>
    [Parameter] public IEnumerable<TValue>? Items { get; set; }

    /// <summary>The text for each option. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    /// <summary>
    /// Markup for each option, such as an icon, avatar or a second line (class <c>ib-option-hint</c>,
    /// hidden in the closed field). Shown where the browser supports the customizable select;
    /// elsewhere the option shows <see cref="ItemText"/>. Keep it non-interactive: options can't hold links or buttons.
    /// </summary>
    [Parameter] public RenderFragment<TValue>? ItemTemplate { get; set; }

    /// <summary>A first, empty option such as "Choose a plan". Not selectable again when the field is required.</summary>
    [Parameter] public string? Placeholder { get; set; }

    private IEnumerable<TValue> Options
    {
        get
        {
            if (Items is not null)
            {
                return Items;
            }

            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return type.IsEnum ? Enum.GetValues(type).Cast<object>().Select(v => (TValue)v) : [];
        }
    }

    private string ReadOnlyText =>
        string.IsNullOrEmpty(CurrentValueAsString) ? "" : Options.FirstOrDefault(o => FormatValueAsString(o) == CurrentValueAsString) is { } item ? TextFor(item) : CurrentValueAsString;

    private string TextFor(TValue item)
    {
        if (ItemText is not null)
        {
            return ItemText(item);
        }

        if (item is Enum e)
        {
            return ChoiceOptions.EnumText(e);
        }

        return item?.ToString() ?? "";
    }
}
