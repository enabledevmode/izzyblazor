@namespace IzzyBlazor
@inherits FieldBase<string?>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the swatches (or, with none, the hex field) choose the color and post; the picker, sliders and number fields need script.")]

@*
    A color, chosen inline: swatches, a picker (a saturation and brightness area and a hue slider),
    an opacity slider, and hex and RGB fields, each optional. Bound to a hex string, "#2563eb", or
    "#2563ebcc" with ShowAlpha.

    <ColorPanel @bind-Value="Model.Accent" Label="Accent color" />
    <ColorPanel @bind-Value="Model.Tag" Label="Tag color" ShowPicker="false" ShowFields="false" />
    <ColorPanel @bind-Value="Model.Overlay" Label="Overlay" Swatches="[]" ShowAlpha />

    Changes apply at once. With no script, the swatches are radios and post as the field; with none,
    the hex field does. With script, all parts write one value, kept in a hidden field that posts.

    Accessibility:
    - It's a group named by the label. The swatches are a radio group, each named by SwatchText or
      by its color's name ("light green"); the chosen one has a ring around it, set apart from the
      swatch by a gap, so it shows on any color, and the focus outline sits outside that.
    - The area is one slider with the role "2D slider": its value says both numbers and the
      color's name ("Saturation 45%, brightness 80%, dark blue"). Left and Right change the
      saturation, Up and Down the brightness.
    - Hue and opacity are sliders; a click anywhere on the area or a slider jumps there, and the
      fields take typed values, so nothing needs dragging.

    Keyboard:
    On the area
    - Left, Right | Lower or raise the saturation by 1
    - Down, Up | Lower or raise the brightness by 1
    - Shift with an arrow | Move by 10
    - Page Down, Page Up | Lower or raise the brightness by 10
    - Home, End | Go to the lowest or highest saturation
    On the sliders
    - Left, Right, Up, Down | Move by 1
    - Shift with an arrow, Page Up, Page Down | Move by 10
    - Home, End | Go to the start or end
    On the swatches
    - Left, Right, Up, Down | Choose the swatch before or after
    See also: ColorPicker, RadioGroup.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/color-panel.css"]" />
<FieldFrame Class="@WrapperClass("color-panel")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ColorPanelView Value="@CurrentValueAsString" OnChange="OnChanged" Text="TextDefaults" ScriptName="@FormName" PostName="@FormName" Attributes="PanelAttributes"
                    ControlId="@FieldId" LabelId="@LabelId" DescribedBy="@DescribedBy" Disabled="IsDisabled" ReadOnly="IsReadOnly" Invalid="Invalid"
                    Swatches="Swatches" SwatchText="SwatchText" ShowPicker="ShowPicker" ShowAlpha="ShowAlpha" ShowFields="ShowFields"
                    Clearable="Clearable" ShowEyedropper="ShowEyedropper" />
</FieldFrame>

@code {
    /// <summary>
    /// The swatches, as hex strings. Defaults to 21 colors: seven hues in a light, a middle and a
    /// dark shade. An empty list shows none.
    /// </summary>
    [Parameter] public IEnumerable<string>? Swatches { get; set; }

    /// <summary>A name for each swatch, such as "Ocean", given its hex string; screen readers hear it and it's the tooltip. Defaults to the color's name ("light green").</summary>
    [Parameter] public Func<string, string?>? SwatchText { get; set; }

    /// <summary>The picker: a saturation and brightness area and a hue slider. Defaults to true.</summary>
    [Parameter] public bool ShowPicker { get; set; } = true;

    /// <summary>An opacity slider and field; a color that isn't opaque is <c>#rrggbbaa</c>. Off by default.</summary>
    [Parameter] public bool ShowAlpha { get; set; }

    /// <summary>Hex, red, green and blue fields (and opacity with <see cref="ShowAlpha"/>). Defaults to true.</summary>
    [Parameter] public bool ShowFields { get; set; } = true;

    /// <summary>A "no color" swatch first, which makes the value null.</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>An eyedropper button beside the fields, shown only in browsers that have one (Chromium).</summary>
    [Parameter] public bool ShowEyedropper { get; set; }

    /// <summary>Makes the field read-only: nothing changes it, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    private string LabelId => FieldId + "-label";

    /// <summary>The name the value posts under: Blazor's for the bound field, or a <c>name</c> attribute (a plain GET form).</summary>
    private string? FormName => NameAttributeValue is { Length: > 0 } bound ? bound
        : AdditionalAttributes?.TryGetValue("name", out var n) == true && n is string s && s.Length > 0 ? s : null;

    // Other attributes go on the panel; the name is FormName's.
    private IEnumerable<KeyValuePair<string, object>> PanelAttributes =>
        ControlAttributes.Where(a => !string.Equals(a.Key, "name", StringComparison.OrdinalIgnoreCase));

    private void OnChanged(string? value) => CurrentValueAsString = value;

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }

        if (ColorPanelMath.Parse(value) is { } color)
        {
            result = ColorPanelMath.ToHex(ShowAlpha ? color : color with { A = 1 });
            validationErrorMessage = null;
            return true;
        }

        result = null;
        validationErrorMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColorInvalid, ResolvedLabel ?? FieldIdentifier.FieldName);
        return false;
    }
}
