@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the date is typed or picked in the browser's own input, above a month that shows it and can't change.")]

@*
    A month on the page to choose a day from, with previous and next buttons and a select each for
    the month and year. Bind it to DateOnly or DateOnly?.
    <Calendar @bind-Value="Model.Day" />
    <Calendar @bind-Value="Model.Day" Min="@today" Max="@lastDay" ShowWeekNumbers />

    Names and the first day of the week follow the page's culture, or Culture. It's always the
    Gregorian calendar, which is what a date input posts. A browser's date input carries the value,
    so it posts with the form on a static page and binds on an interactive one. Min and Max stop the
    month and its days, and are checked again on the server.

    Accessibility:
    - The month is a `grid` named by the field's label and the month, with full day names on its
      columns and the full date on each day. The chosen day has `aria-selected`, and today
      `aria-current`.
    - One day is a tab stop, and arrow keys move it. A day outside Min and Max can take focus so the
      keys move evenly, and has `aria-disabled`.
    - A polite announcement gives the month when it changes.
    - Hint and errors are linked to the grid. The label and an error's link focus the day.
    - With JavaScript off, the browser's date input takes the value.

    Keyboard:
    In the days
    - Left, Right | Move a day (reversed in right-to-left)
    - Up, Down | Move a week
    - Home, End | Go to the start or end of the week
    - Page Up, Page Down | Move a month, keeping the day number or the month's last day
    - Shift+Page Up, Shift+Page Down | Move a year
    - Enter, Space | Choose the date
    See also: DateField, TimeField, Form.
*@

<FieldFrame Class="@WrapperClass("calendar")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ib-calendar class="ib-calendar"
                 data-ib-value="@FormatDate(Chosen)"
                 data-ib-min="@FormatDate(ResolvedMin)"
                 data-ib-max="@FormatDate(ResolvedMax)"
                 data-ib-culture="@Current.Culture.Name"
                 data-ib-first-day="@((int)Current.FirstDay)"
                 data-ib-week-anchor="@(ShowWeekNumbers ? CalendarGrid.WeekAnchor(Current.Culture.DateTimeFormat.CalendarWeekRule) : null)"
                 data-ib-hide-adjacent="@(ShowAdjacentDays ? null : "")"
                 data-ib-disabled="@(IsDisabled ? "" : null)"
                 data-ib-readonly="@(IsReadOnly ? "" : null)">
        <ib-field-control class="ib-field-control ib-calendar-text">
            <input @attributes="ControlAttributes"
                   id="@FieldId"
                   class="ib-field-input"
                   type="@InputType"
                   name="@NameAttributeValue"
                   @bind="CurrentValueAsString"
                   min="@FormatDate(ResolvedMin)"
                   max="@FormatDate(ResolvedMax)"
                   required="@IsRequired"
                   disabled="@IsDisabled"
                   readonly="@IsReadOnly"
                   aria-invalid="@(Invalid ? "true" : null)"
                   aria-describedby="@DescribedBy" />
        </ib-field-control>
        <div class="ib-calendar-view">
            <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/date.css"]" />
            @CalendarGrid.Month(Drawn, DescribedBy)
        </div>
    </ib-calendar>
</FieldFrame>

@code {
    /// <summary>Makes the field read-only: it can be focused, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    /// <summary>The earliest date. Defaults to <c>[Range]</c>'s minimum.</summary>
    [Parameter] public DateOnly? Min { get; set; }

    /// <summary>The latest date. Defaults to <c>[Range]</c>'s maximum.</summary>
    [Parameter] public DateOnly? Max { get; set; }

    /// <summary>The first column. Defaults to the culture's first day of the week.</summary>
    [Parameter] public DayOfWeek? FirstDayOfWeek { get; set; }

    /// <summary>The culture for the month and day names, the first day and the week numbers. Defaults to the current culture.</summary>
    [Parameter] public System.Globalization.CultureInfo? Culture { get; set; }

    /// <summary>Adds a first column with the week of the year, counted as the culture counts them.</summary>
    [Parameter] public bool ShowWeekNumbers { get; set; }

    /// <summary>Whether to show the days of the months before and after, muted, in the first and last weeks. Defaults to true.</summary>
    [Parameter] public bool ShowAdjacentDays { get; set; } = true;

    // Not written in the markup: there, Razor makes @bind format a date, and it binds text.
    private const string InputType = "date";

    private System.ComponentModel.DataAnnotations.RangeAttribute? Range =>
        Attribute<System.ComponentModel.DataAnnotations.RangeAttribute>();

    private DateOnly? ResolvedMin => Min ?? Annotated(Range?.Minimum);

    private DateOnly? ResolvedMax => Max ?? Annotated(Range?.Maximum);

    private System.Globalization.CultureInfo ResolvedCulture =>
        CalendarGrid.Gregorian(Culture ?? System.Globalization.CultureInfo.CurrentCulture);

    private DateOnly? Chosen => CurrentValue is DateOnly date && date != default ? date : null;

    private string LabelId => FieldId + "-label";

    private CalendarView Current
    {
        get
        {
            var culture = ResolvedCulture;
            var monthId = FieldId + "-month";
            return new(
                FirstMonth,
                Chosen,
                ResolvedMin,
                ResolvedMax,
                FirstDayOfWeek ?? culture.DateTimeFormat.FirstDayOfWeek,
                culture,
                ShowWeekNumbers,
                ShowAdjacentDays,
                IsDisabled,
                IsReadOnly,
                Size,
                monthId,
                string.IsNullOrEmpty(ResolvedLabel) ? monthId : $"{LabelId} {monthId}",
                TextDefaults);
        }
    }

    private CalendarView? _drawn;

    // The first render stays, so Blazor's diff never writes the cells the script has moved on from:
    // what changes reaches it in the element's attributes. Only a change of the grid's shape draws
    // again, and those attributes then have the script draw over it.
    private CalendarView Drawn
    {
        get
        {
            var now = Current;
            if (_drawn is not { } drawn
                || drawn.Culture.Name != now.Culture.Name
                || drawn.FirstDay != now.FirstDay
                || drawn.ShowWeekNumbers != now.ShowWeekNumbers
                || drawn.ShowAdjacentDays != now.ShowAdjacentDays
                || drawn.Size != now.Size
                || drawn.LabelledBy != now.LabelledBy)
            {
                _drawn = now;
            }

            return _drawn.Value;
        }
    }

    // The chosen day's month. With none, this month in UTC, as the server doesn't know the person's
    // zone, or the nearest with a day that can be chosen.
    private DateOnly FirstMonth
    {
        get
        {
            if (Chosen is { } chosen)
            {
                return chosen;
            }

            var today = DateOnly.FromDateTime(DateTime.UtcNow);
            return today < ResolvedMin ? ResolvedMin.Value : today > ResolvedMax ? ResolvedMax.Value : today;
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if ((Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)) != typeof(DateOnly))
        {
            throw new InvalidOperationException($"Calendar doesn't support {typeof(TValue)}. Bind it to DateOnly or DateOnly?.");
        }

        base.OnParametersSet();
    }

    /// <inheritdoc />
    private protected override bool HasOwnRules => Min is not null || Max is not null;

    /// <inheritdoc />
    private protected override string? OwnRuleError(TValue value)
    {
        var date = (DateOnly)(object)value!;
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        string Said(DateOnly limit) => limit.ToString("d", CalendarGrid.Gregorian(culture));
        return date < Min ? string.Format(culture, TextDefaults.TooEarly, ResolvedLabel, Said(Min.Value))
            : date > Max ? string.Format(culture, TextDefaults.TooLate, ResolvedLabel, Said(Max.Value))
            : null;
    }

    /// <inheritdoc />
    protected override string? FormatValueAsString(TValue? value) => value is DateOnly date ? FormatDate(date) : null;

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, [System.Diagnostics.CodeAnalysis.MaybeNullWhen(false)] out TValue result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        validationErrorMessage = null;
        result = default!;
        if (string.IsNullOrWhiteSpace(value))
        {
            if (Nullable.GetUnderlyingType(typeof(TValue)) is not null)
            {
                return true;
            }
        }
        else if (DateOnly.TryParseExact(value.Trim(), InputFormat, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var date))
        {
            result = (TValue)(object)date;
            return true;
        }

        validationErrorMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.DateInvalid, ResolvedLabel ?? FieldIdentifier.FieldName);
        return false;
    }

    private static string? FormatDate(DateOnly? date) => date?.ToString(InputFormat, System.Globalization.CultureInfo.InvariantCulture);

    // [Range]'s end: text from Range(typeof(DateOnly), "2027-01-01", "2027-12-31").
    private static DateOnly? Annotated(object? end) => end switch
    {
        DateOnly date => date,
        string text when DateOnly.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, out var date) => date,
        _ => null,
    };

    // What date inputs post.
    private const string InputFormat = "yyyy-MM-dd";
}
