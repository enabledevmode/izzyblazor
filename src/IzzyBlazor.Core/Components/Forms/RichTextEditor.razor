@namespace IzzyBlazor
@inherits FieldBase<string?>
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, it's a text box holding the HTML, which still posts and is sanitized.")]

@*
    Formatted text with label, hint and errors: headings, lists, quotes, code, bold, italic and the
    rest of what RichTextSanitizer allows. Its value is that HTML, sanitized on the server every
    time it binds, with no styles or classes, so it shows the same anywhere (show it with RichText).

    <RichTextEditor @bind-Value="Model.Body" Label="Message" />
    <RichTextEditor @bind-Value="Model.Notes" Label="Notes" Tools="RichTextTools.Basic" Rows="4" />

    The page renders the formatted text before any script runs, and a text box beside it, hidden
    with script, holds the HTML: the script keeps it current as you type, so the field posts in a
    plain form, and on an interactive page Value changes when you leave the field. The look is
    Prose's, so what you edit looks like what RichText shows; ContentClass puts your own class on
    the text for rules of your own.

    Accessibility:
    - The text is a `textbox` with `aria-multiline`, named by the label and described by the hint
      and errors, as other fields are.
    - The toolbar is named "Formatting", with one tab stop and arrow keys between its tools. Alt+F10
      moves from the text to the toolbar, and Escape back. Toggles say whether the selection has
      their format (`aria-pressed`), and each lists its shortcut (`aria-keyshortcuts`, and the
      tooltip).
    - Tab leaves the text: it never types a tab, so the keyboard can't get stuck in it.
    - The link tool opens a small dialog (Address, Text, Open in a new tab); Escape closes it and
      puts focus back in the text.
    - With `ShowCount`, the count ("120 / 2000") is part of the text's description; it isn't
      announced as it changes.
    - With JavaScript off, it's a textarea of the HTML with the field's label.

    Keyboard:
    In the text
    - Ctrl+B, Ctrl+I, Ctrl+U | Bold, italic, underline
    - Ctrl+Shift+X | Strikethrough
    - Ctrl+E | Inline code
    - Ctrl+K | Add or change a link
    - Ctrl+Shift+8, Ctrl+Shift+7 | Bulleted list, numbered list
    - Ctrl+], Ctrl+[ | Indent or outdent a list item
    - Ctrl+Alt+0 | Paragraph
    - Ctrl+Alt+2, Ctrl+Alt+3, Ctrl+Alt+4 | Heading 2, 3, 4
    - Ctrl+Z, Ctrl+Y | Undo, redo
    - Ctrl+Shift+V | Paste as plain text
    - ## , - , 1. , > or three backticks at the start of a line, then Space | Heading, list, quote, code block
    - **text**, *text*, `text` | Bold, italic, inline code
    - --- then Enter | Horizontal line
    - Alt+F10 | Move to the toolbar
    In the toolbar
    - Escape | Back to the text
    See also: RichText, RichTextSanitizer, TextArea, Form.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/rich-text.css"]" />
<FieldFrame Class="@WrapperClass("rich-text")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ib-rich-text @ref="_host" class="ib-rich-text" data-ib-markdown="@(MarkdownShortcuts ? null : "off")" data-ib-max="@MaxLength">
        @if (ShowsToolbar)
        {
            <Toolbar Label="@TextDefaults.RichTextToolbar" Wrap Class="ib-rich-text-toolbar">
                @if (HasStyle)
                {
                    @* The button shows the style where the caret is; the script keeps it and the
                       checked item current as the caret moves. *@
                    <ToolbarMenu Label="@TextDefaults.RichTextStyle">
                        <Trigger>
                            <Button @attributes="context" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                                    EndIcon="Lucide.ChevronDown" class="ib-rich-text-style" data-ib-style-button
                                    aria-label="@StyleLabel(TextDefaults.RichTextParagraph)"><span class="ib-rich-text-style-name">@TextDefaults.RichTextParagraph</span></Button>
                        </Trigger>
                        <ChildContent>
                            <MenuRadioGroup Label="@TextDefaults.RichTextStyle" Value="p">
                                @StyleItem("p", TextDefaults.RichTextParagraph, "0")
                                @StyleItem("h2", string.Format(TextDefaults.RichTextHeading, 2), "2")
                                @StyleItem("h3", string.Format(TextDefaults.RichTextHeading, 3), "3")
                                @StyleItem("h4", string.Format(TextDefaults.RichTextHeading, 4), "4")
                                @StyleItem("blockquote", TextDefaults.RichTextQuote, null)
                                @StyleItem("pre", TextDefaults.RichTextCodeBlock, null)
                            </MenuRadioGroup>
                        </ChildContent>
                    </ToolbarMenu>
                }
                @if (HasFormats)
                {
                    @if (HasStyle)
                    {
                        <ToolbarSeparator />
                    }
                    <ToolbarButtonGroup Label="@TextDefaults.RichTextFormats">
                        @Tool(RichTextTools.Bold, "bold", Lucide.Bold, TextDefaults.RichTextBold, "B", pressed: true)
                        @Tool(RichTextTools.Italic, "italic", Lucide.Italic, TextDefaults.RichTextItalic, "I", pressed: true)
                        @Tool(RichTextTools.Underline, "underline", Lucide.Underline, TextDefaults.RichTextUnderline, "U", pressed: true)
                        @Tool(RichTextTools.Strikethrough, "strikethrough", Lucide.Strikethrough, TextDefaults.RichTextStrikethrough, "Shift+X", pressed: true)
                        @Tool(RichTextTools.InlineCode, "code", Lucide.Code, TextDefaults.RichTextInlineCode, "E", pressed: true)
                        @Tool(RichTextTools.Link, "link", Lucide.Link, TextDefaults.RichTextLink, "K", pressed: true)
                    </ToolbarButtonGroup>
                }
                @if (HasLists)
                {
                    @if (HasStyle || HasFormats)
                    {
                        <ToolbarSeparator />
                    }
                    <ToolbarButtonGroup Label="@TextDefaults.RichTextLists">
                        @Tool(RichTextTools.BulletedList, "bulleted", Lucide.List, TextDefaults.RichTextBulletedList, "Shift+8", pressed: true)
                        @Tool(RichTextTools.NumberedList, "numbered", Lucide.ListOrdered, TextDefaults.RichTextNumberedList, "Shift+7", pressed: true)
                        @Tool(RichTextTools.Indent, "outdent", Lucide.ListIndentDecrease, TextDefaults.RichTextOutdent, "[")
                        @Tool(RichTextTools.Indent, "indent", Lucide.ListIndentIncrease, TextDefaults.RichTextIndent, "]")
                    </ToolbarButtonGroup>
                }
                @if (HasInserts)
                {
                    @if (HasStyle || HasFormats || HasLists)
                    {
                        <ToolbarSeparator />
                    }
                    @Tool(RichTextTools.HorizontalRule, "rule", Lucide.Minus, TextDefaults.RichTextHorizontalRule, null)
                    @Tool(RichTextTools.ClearFormatting, "clear", Lucide.RemoveFormatting, TextDefaults.RichTextClearFormatting, null)
                }
                @ToolbarContent
                @if (Has(RichTextTools.UndoRedo))
                {
                    @* No line before these: the space at the end of the bar sets them apart, and a line
                       would start the second row when the toolbar wraps. *@
                    <ToolbarButtonGroup Label="@TextDefaults.RichTextHistory" Position="ToolbarPosition.End">
                        @Tool(RichTextTools.UndoRedo, "undo", Lucide.Undo2, TextDefaults.RichTextUndo, "Z")
                        @Tool(RichTextTools.UndoRedo, "redo", Lucide.Redo2, TextDefaults.RichTextRedo, "Y")
                    </ToolbarButtonGroup>
                }
            </Toolbar>
        }
        @* The script owns what's typed here: the server writes it again only when Value changes
           from outside the field (the key changes), never with what the script reported. *@
        <div @key="_version" class="@SurfaceClass" id="@SurfaceId" role="textbox" aria-multiline="true"
             aria-labelledby="@LabelId" aria-describedby="@DescribedBy" aria-invalid="@(Invalid ? "true" : null)"
             aria-required="@(IsRequired ? "true" : null)" aria-readonly="@(IsReadOnly ? "true" : null)"
             aria-disabled="@(IsDisabled ? "true" : null)" style="--ib-rows: @Rows"
             data-placeholder="@Placeholder" data-ib-empty="@(IsBlank(_shown) ? "" : null)">@((MarkupString)_shown)</div>
        <textarea @attributes="ControlAttributes"
                  id="@FieldId"
                  class="ib-field-input ib-rich-text-source"
                  name="@NameAttributeValue"
                  @bind="CurrentValueAsString"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  required="@IsRequired"
                  disabled="@IsDisabled"
                  readonly="@IsReadOnly"
                  aria-invalid="@(Invalid ? "true" : null)"
                  aria-describedby="@DescribedBy"></textarea>
        @if (Has(RichTextTools.Link) && ShowsToolbar)
        {
            @* Opened by the link tool or Ctrl+K, under the selection. Its fields have no name, so
               they never post with the form around the editor. *@
            <div class="ib-rich-text-link" popover role="dialog" aria-label="@TextDefaults.RichTextLink">
                <div class="ib-field">
                    <label class="ib-field-label" for="@(FieldId)-link-href">@TextDefaults.RichTextLinkAddress</label>
                    <input class="ib-field-input" id="@(FieldId)-link-href" type="url" inputmode="url" autocomplete="off" placeholder="https://" data-ib-link="href" />
                </div>
                <div class="ib-field" data-ib-link="text-field">
                    <label class="ib-field-label" for="@(FieldId)-link-text">@TextDefaults.RichTextLinkText</label>
                    <input class="ib-field-input" id="@(FieldId)-link-text" type="text" autocomplete="off" data-ib-link="text" />
                </div>
                <label class="ib-rich-text-link-tab"><input type="checkbox" data-ib-link="tab" /> @TextDefaults.RichTextLinkNewTab</label>
                <div class="ib-rich-text-link-actions">
                    <Button Variant="ButtonVariant.Ghost" Accent="Accent.Danger" Size="ControlSize.Sm" data-ib-link="remove">@TextDefaults.RichTextLinkRemove</Button>
                    <Button Size="ControlSize.Sm" data-ib-link="apply">@TextDefaults.RichTextLinkApply</Button>
                </div>
            </div>
        }
    </ib-rich-text>
    @if (ShowsCount)
    {
        @* The script keeps the number current and adds the count to the text's description. *@
        <span class="ib-field-count" id="@CountId"><span class="ib-field-count-current">@TextLength(_shown)</span> / @MaxLength</span>
    }
</FieldFrame>

@code {
    private string _shown = "";
    private string? _seen;
    private string? _reported;
    private int _version;

    /// <summary>The tools in the toolbar. Defaults to <see cref="RichTextTools.Default"/>, every tool; <see cref="RichTextTools.None"/> leaves only the shortcuts.</summary>
    [Parameter] public RichTextTools Tools { get; set; } = RichTextTools.Default;

    /// <summary>The height of the text, in lines, before it grows. Defaults to 6.</summary>
    [Parameter] public int Rows { get; set; } = 6;

    /// <summary>Example text shown when empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Makes the field read-only: the text can be selected, not changed, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>A class on the text, for your own rules on what's in it, such as <c>.article h2</c>. Give the same class to <see cref="RichText"/> to show it the same way.</summary>
    [Parameter] public string? ContentClass { get; set; }

    /// <summary>The text size, as <see cref="Prose"/>'s. Defaults to <see cref="ProseSize.Md"/>.</summary>
    [Parameter] public ProseSize TextSize { get; set; } = ProseSize.Md;

    /// <summary>
    /// Turns typed Markdown into formats as you type: <c>## </c> a heading, <c>- </c> and <c>1. </c>
    /// lists, <c>&gt; </c> a quote, three backticks a code block, <c>**bold**</c>, <c>*italic*</c>
    /// and <c>`code`</c>. On by default; Ctrl+Z undoes a change it made.
    /// </summary>
    [Parameter] public bool MarkdownShortcuts { get; set; } = true;

    /// <summary>The most characters of text, not counting the HTML around it. Checked on the server; with script, the count shows when it's passed.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Shows "n / max" under the field. Needs <see cref="MaxLength"/>. Updates as you type once scripts run.</summary>
    [Parameter] public bool ShowCount { get; set; }

    /// <summary>Tools of your own at the end of the toolbar, such as a <see cref="ToolbarButton"/> whose <c>OnClick</c> calls <see cref="InsertHtmlAsync"/>.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    private ElementReference _host;
    private IJSObjectReference? _module;

    private bool ShowsCount => ShowCount && MaxLength is not null;

    private string CountId => FieldId + "-count";

    /// <summary>
    /// Inserts HTML at the caret, or in place of the selection, as if typed: it's sanitized first,
    /// and Ctrl+Z undoes it. For your own tools on interactive pages; on a static page it does nothing.
    /// </summary>
    /// <param name="html">The HTML to insert, such as <c>&lt;p&gt;Kind regards,&lt;br&gt;Dana&lt;/p&gt;</c>.</param>
    public async Task InsertHtmlAsync(string html)
    {
        if (!RendererInfo.IsInteractive) return;
        // The plain path: the page's import map gives it the same module the page already loaded.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/IzzyBlazor.Core/elements/rich-text.js");
        await _module.InvokeVoidAsync("insertHtml", _host, RichTextSanitizer.Sanitize(html));
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <inheritdoc />
    private protected override bool HasOwnRules => MaxLength is not null;

    /// <inheritdoc />
    private protected override string? OwnRuleError(string? value) =>
        MaxLength is { } max && TextLength(value ?? "") > max
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.RichTextTooLong, ResolvedLabel ?? FieldIdentifier.FieldName, max)
            : null;

    // The text's length, as the script counts it: no tags, entities as one character.
    private static int TextLength(string html) =>
        System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "")).Length;

    private string LabelId => FieldId + "-label";

    private string SurfaceId => FieldId + "-text";

    private bool ShowsToolbar => Tools != RichTextTools.None && !IsReadOnly && !IsDisabled;

    private string SurfaceClass => new ClassBuilder()
        .Add("ib-rich-text-surface ib-prose")
        .Add("ib-prose-sm", TextSize == ProseSize.Sm)
        .Add("ib-prose-lg", TextSize == ProseSize.Lg)
        .Add(ContentClass)
        .Build()!;

    private bool Has(RichTextTools tool) => (Tools & tool) == tool;

    private bool HasStyle => Has(RichTextTools.TextStyle);

    private bool HasFormats => HasAny(RichTextTools.Bold | RichTextTools.Italic | RichTextTools.Underline | RichTextTools.Strikethrough | RichTextTools.InlineCode | RichTextTools.Link);

    private bool HasLists => HasAny(RichTextTools.BulletedList | RichTextTools.NumberedList | RichTextTools.Indent);

    private bool HasInserts => HasAny(RichTextTools.HorizontalRule | RichTextTools.ClearFormatting);

    // "Text style, Heading 2": the button's name says what it is and what's chosen.
    private string StyleLabel(string style) => $"{TextDefaults.RichTextStyle}, {style}";

    // An item that previews its style, with its shortcut (Ctrl+Alt+digit) when it has one.
    private RenderFragment StyleItem(string tag, string label, string? digit) =>
        @<MenuItem Value="@tag" data-ib-command="block" data-ib-value="@tag" data-ib-label="@StyleLabel(label)"
                   Shortcut="@(digit is null ? null : $"Ctrl+Alt+{digit}")"><span class="ib-rich-text-preview-@tag">@label</span></MenuItem>;

    private bool HasAny(RichTextTools tools) => (Tools & tools) != 0;

    private RenderFragment? Tool(RichTextTools tool, string command, IconData icon, string label, string? keys, bool pressed = false)
    {
        if (!Has(tool)) return null;
        // Shown as "Ctrl+B" here; the script writes ⌘ on a Mac.
        var title = keys is null ? label : $"{label} (Ctrl+{keys})";
        var shortcut = keys is null ? null : "Control+" + keys;
        return @<ToolbarIconButton Icon="icon" Label="@label" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                                   data-ib-command="@command" aria-pressed="@(pressed ? "false" : null)"
                                   aria-keyshortcuts="@shortcut" title="@title" />;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // A Value seen before, or the script's own report coming back, changes nothing on the
        // page; anything else is new, and replaces what's in the editor.
        var value = Value ?? "";
        if (_seen is not null && value == _seen) return;
        var first = _seen is null;
        _seen = value;
        if (value == _reported) return;
        _shown = RichTextSanitizer.Sanitize(value);
        _reported = null;
        if (!first) _version++;
    }

    /// <inheritdoc />
    private protected override bool FitsValue => true;

    /// <inheritdoc />
    private protected override string? FitValue(string? value) => Clean(value);

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = Clean(value);
        _reported = result ?? "";
        validationErrorMessage = null;
        return true;
    }

    // Sanitized, and null when nothing's left to show, so [Required] sees an empty editor as empty.
    private static string? Clean(string? value)
    {
        var html = RichTextSanitizer.Sanitize(value);
        return IsBlank(html) ? null : html;
    }

    private static bool IsBlank(string html) =>
        !html.Contains("<img", StringComparison.Ordinal) && !html.Contains("<hr", StringComparison.Ordinal)
        && string.IsNullOrWhiteSpace(System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "").Replace("&nbsp;", "").Replace(" ", ""));
}
