@namespace IzzyBlazor
@inherits FieldBase<string?>
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, it's a text box holding the HTML, which still posts and is sanitized.")]

@*
    Formatted text with label, hint and errors: headings, lists, quotes, code, bold, italic and the
    rest of what RichTextSanitizer allows. Its value is that HTML, sanitized on the server every
    time it binds, with no styles or classes, so it shows the same anywhere (show it with RichText).

    The page renders the formatted text before any script runs, and a text box beside it, hidden
    with script, holds the HTML: the script keeps it current as you type, so the field posts in a
    plain form, and on an interactive page Value changes when you leave the field. The look is
    Prose's, so what you edit looks like what RichText shows; ContentClass puts your own class on
    the text for rules of your own.

    Accessibility:
    - The text is a `textbox` with `aria-multiline`, named by the label and described by the hint
      and errors, as other fields are.
    - The toolbar is named "Formatting", with one tab stop and arrow keys between its tools. Alt+F10
      moves from the text to the toolbar, and Escape back. Toggles say whether the selection has
      their format (`aria-pressed`), and each lists its shortcut (`aria-keyshortcuts`, and the
      tooltip).
    - Tab leaves the text: it never types a tab, so the keyboard can't get stuck in it. In a
      table it moves between cells, and from the last one out of the editor.
    - Tables have a header row by default, its cells column headers (`scope="col"`).
    - A task's checkbox is named by the task's text, and says whether it's done. Ctrl+Enter ticks
      it from the text, without the mouse.
    - The link and image tools open modal dialogs, named by their titles ("Add link", "Edit
      image"); Escape or Cancel closes them and puts focus back in the text, with its selection.
    - The image dialog asks for a description (alternative text) or for the image to be marked
      decorative; it opens on its own after an image is pasted or dropped. Its two sources are
      tabs (arrow keys move between them).
    - With `ShowCount`, the count ("120 / 2000") is part of the text's description; it isn't
      announced as it changes.
    - With JavaScript off, it's a textarea of the HTML with the field's label.

    Keyboard:
    In the text
    - Ctrl+B, Ctrl+I, Ctrl+U | Bold, italic, underline
    - Ctrl+Shift+X | Strikethrough
    - Ctrl+=, Ctrl+Shift+= | Subscript, superscript
    - Ctrl+Shift+L, Ctrl+Shift+E, Ctrl+Shift+R | Align start, center, end
    - Ctrl+E | Inline code
    - Ctrl+K | Add or change a link
    - Ctrl+Shift+8, Ctrl+Shift+7, Ctrl+Shift+9 | Bulleted list, numbered list, task list
    - Ctrl+Enter | Tick or untick the task at the caret
    - Ctrl+], Ctrl+[ | Indent or outdent a list item
    - Ctrl+Alt+0 | Paragraph
    - Ctrl+Alt+1 to Ctrl+Alt+6 | Heading 1 to 6, from TopHeading; again for a paragraph
    - Ctrl+Z | Undo
    - Ctrl+Y, Ctrl+Shift+Z | Redo
    - Ctrl+Shift+V | Paste as plain text
    - ## , - , 1. , > or three backticks at the start of a line, then Space | Heading, list, quote, code block
    - [ ] or [x] at the start of a line or list item, then Space | A task, not done or done
    - **text**, *text*, `text` | Bold, italic, inline code
    - --- then Enter | Horizontal line
    - Tab, Shift+Tab | In a table, the next or previous cell; Tab in its last cell leaves the editor
    - Alt+F10 | Move to the toolbar
    In the toolbar
    - Left, Right | Move to the control before or after, wrapping (reversed on right-to-left pages)
    - Home, End | Go to the first or last control
    - Down, Up | On a menu's button, open the menu at its first or last item
    - Escape | Back to the text
    See also: RichText, RichTextSanitizer, TextArea, Form.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/rich-text.css"]" />
<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/rich-content.css"]" />
<FieldFrame Class="@WrapperClass("rich-text")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" NoInput="TakesNoInput"
            Hint="@Hint" HintStatus="HintStatus" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ib-rich-text @ref="_host" class="ib-rich-text" data-ib-markdown="@(MarkdownShortcuts ? null : "off")" data-ib-max="@MaxLength" data-ib-top="@Top" data-ib-fonts="@(Fonts is { Count: > 0 } ? string.Join('|', Fonts) : null)" data-ib-font-sizes="@(FontSizes is { Count: > 0 } ? string.Join('|', FontSizes) : null)"
                  data-ib-image-upload="@ImageUploadUrl" data-ib-data-images="@(AllowDataImages ? "" : null)" data-ib-custom-colors="@(CustomColors ? "" : null)" data-ib-image-max="@MaxImageSize"
                  data-ib-image-failed="@TextDefaults.RichTextImageFailed" data-ib-image-too-large="@TextDefaults.RichTextImageTooLarge" data-ib-image-needs-alt="@TextDefaults.RichTextImageNeedsAlt">
        @* The box (toolbar and text) needs script; with none, or if the script can't load, the
           textarea of HTML stands in for it (data-ib-script and data-ib-noscript, in the main sheet). *@
        <div class="ib-rich-text-box" data-ib-script>
        @if (ShowsToolbar)
        {
            <Toolbar Label="@TextDefaults.RichTextToolbar" Wrap="WrapToolbar" Class="ib-rich-text-toolbar">
                @* Groups with a line between each; only those with tools show. *@
                @{ var first = true; }
                @foreach (var group in Groups())
                {
                    @if (!first)
                    {
                        <ToolbarSeparator />
                    }
                    first = false;
                    @group
                }
                @ToolbarContent
            </Toolbar>
        }
        @* The script owns what's typed here: the server writes it again only when Value changes
           from outside the field (the key changes), never with what the script reported. *@
        <div @key="_version" class="@SurfaceClass" id="@SurfaceId" role="textbox" aria-multiline="true"
             aria-keyshortcuts="@SurfaceShortcuts"
             aria-labelledby="@LabelId" aria-describedby="@DescribedBy" aria-invalid="@(Invalid ? "true" : null)"
             aria-required="@(IsRequired ? "true" : null)" aria-readonly="@(IsReadOnly ? "true" : null)"
             aria-disabled="@(IsDisabled ? "true" : null)" style="--ib-rows: @Rows"
             data-placeholder="@Placeholder" data-ib-empty="@(IsBlank(_shown) ? "" : null)">@((MarkupString)_shown)</div>
        </div>
        <textarea @attributes="ControlAttributes" data-ib-noscript
                  id="@FieldId"
                  class="ib-field-input ib-rich-text-source"
                  name="@NameAttributeValue"
                  @bind="CurrentValueAsString"
                  rows="@Rows"
                  placeholder="@Placeholder"
                  required="@IsRequired"
                  disabled="@IsDisabled"
                  readonly="@IsReadOnly"
                  aria-invalid="@(Invalid ? "true" : null)"
                  aria-describedby="@DescribedBy"></textarea>
        @if (Has(RichTextTools.Link) && ShowsToolbar)
        {
            @* The link tool's dialog (Ctrl+K too), modal like the library's Dialog. Its fields have no
               name, so they never post with the form around the editor. *@
            <dialog class="ib-dialog ib-dialog-sm ib-dialog-center ib-rich-text-dialog ib-rich-text-link" aria-labelledby="@(FieldId)-link-title">
                <header class="ib-dialog-header">
                    <h2 class="ib-dialog-title" id="@(FieldId)-link-title" data-ib-link="title" data-ib-add="@TextDefaults.RichTextLinkAdd" data-ib-edit="@TextDefaults.RichTextLinkEdit">@TextDefaults.RichTextLinkAdd</h2>
                </header>
                <div class="ib-dialog-body">
                    <div class="ib-field">
                        <label class="ib-field-label" for="@(FieldId)-link-href">@TextDefaults.RichTextLinkAddress</label>
                        <input class="ib-field-input" id="@(FieldId)-link-href" type="url" inputmode="url" autocomplete="off" placeholder="https://" data-ib-link="href" />
                    </div>
                    <div class="ib-field">
                        <label class="ib-field-label" for="@(FieldId)-link-text">@TextDefaults.RichTextLinkText</label>
                        <input class="ib-field-input" id="@(FieldId)-link-text" type="text" autocomplete="off" data-ib-link="text" />
                    </div>
                    <label class="ib-rich-text-check"><input type="checkbox" data-ib-link="tab" /> @TextDefaults.RichTextLinkNewTab</label>
                    <footer class="ib-dialog-footer">
                        <Button Variant="ButtonVariant.Ghost" Accent="Accent.Danger" Size="ControlSize.Sm" class="ib-rich-text-remove" data-ib-link="remove">@TextDefaults.RichTextLinkRemove</Button>
                        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-link="cancel">@TextDefaults.Cancel</Button>
                        <Button Size="ControlSize.Sm" data-ib-link="apply">@TextDefaults.RichTextLinkApply</Button>
                    </footer>
                </div>
            </dialog>
        }
        @if (CustomColors && HasAny(RichTextTools.TextColor | RichTextTools.Highlight) && ShowsToolbar)
        {
            @* The custom color dialog, opened by "Custom…" in a color menu: a color panel with no
               swatches (the menu has the palette). Its fields have no name, so they never post. *@
            <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/color-panel.css"]" />
            @* No visible title: the menu item that opens it says what it's for. Its name is for
               screen readers, set to the text color's or the highlight's as it opens. *@
            <dialog class="ib-dialog ib-dialog-sm ib-dialog-center ib-rich-text-dialog ib-rich-text-custom" aria-label="@TextDefaults.RichTextCustomTextColor"
                    data-ib-color="@TextDefaults.RichTextCustomTextColor" data-ib-highlight="@TextDefaults.RichTextCustomHighlight">
                <div class="ib-dialog-body">
                    <ColorPanelView Text="TextDefaults" Swatches="NoSwatches" ShowEyedropper />
                    <footer class="ib-dialog-footer">
                        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-custom="cancel">@TextDefaults.Cancel</Button>
                        <Button Size="ControlSize.Sm" data-ib-custom="apply">@TextDefaults.Apply</Button>
                    </footer>
                </div>
            </dialog>
        }
        @if (ShowsCount)
        {
            @* The script keeps the number current and adds the count to the text's description. *@
            <span class="ib-field-count" id="@CountId"><span class="ib-field-count-current">@TextLength(_shown)</span> / @MaxLength</span>
        }
        @if (Has(RichTextTools.Image) && ShowsToolbar)
        {
            @* The image tool's dialog, opened by the tool, and after an image is pasted or dropped so
               it gets a description. Its fields have no name, so they never post with the form. *@
            var takesFiles = ImageUploadUrl is not null || AllowDataImages;
            <dialog class="ib-dialog ib-dialog-sm ib-dialog-center ib-rich-text-dialog ib-rich-text-image" aria-labelledby="@(FieldId)-image-title">
                <header class="ib-dialog-header">
                    <h2 class="ib-dialog-title" id="@(FieldId)-image-title" data-ib-image="title" data-ib-add="@TextDefaults.RichTextImageInsert" data-ib-edit="@TextDefaults.RichTextImageEdit">@TextDefaults.RichTextImageInsert</h2>
                </header>
                <div class="ib-dialog-body">
                    @if (takesFiles)
                    {
                        <div class="ib-rich-text-tabs" role="tablist" aria-label="@TextDefaults.RichTextImageSource">
                            <button type="button" role="tab" id="@(FieldId)-image-tab-device" aria-controls="@(FieldId)-image-device" aria-selected="true" data-ib-image="tab" data-ib-panel="device">@TextDefaults.RichTextImageFromDevice</button>
                            <button type="button" role="tab" id="@(FieldId)-image-tab-web" aria-controls="@(FieldId)-image-web" aria-selected="false" tabindex="-1" data-ib-image="tab" data-ib-panel="web">@TextDefaults.RichTextImageFromWeb</button>
                        </div>
                        <div class="ib-rich-text-drop" role="tabpanel" id="@(FieldId)-image-device" aria-labelledby="@(FieldId)-image-tab-device" data-ib-image="device">
                            <img class="ib-rich-text-drop-preview" alt="" hidden data-ib-image="preview" />
                            <label class="ib-btn ib-btn-neutral ib-btn-outline ib-btn-sm ib-rich-text-drop-choose">
                                <input type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/avif" class="ib-visually-hidden" data-ib-image="file" />
                                @TextDefaults.RichTextImageSelect
                            </label>
                            <span class="ib-rich-text-drop-text">@TextDefaults.RichTextImageDrop</span>
                        </div>
                    }
                    <div class="ib-field" role="@(takesFiles ? "tabpanel" : null)" id="@(FieldId)-image-web" aria-labelledby="@(takesFiles ? $"{FieldId}-image-tab-web" : null)" hidden="@takesFiles" data-ib-image="web">
                        <label class="ib-field-label" for="@(FieldId)-image-src">@TextDefaults.RichTextImageAddress</label>
                        <input class="ib-field-input" id="@(FieldId)-image-src" type="url" inputmode="url" autocomplete="off" placeholder="https://" data-ib-image="src" />
                    </div>
                    <div class="ib-rich-text-image-size">
                        <div class="ib-field">
                            <label class="ib-field-label" for="@(FieldId)-image-width">@TextDefaults.RichTextImageWidth</label>
                            <input class="ib-field-input" id="@(FieldId)-image-width" type="number" min="1" max="10000" inputmode="numeric" data-ib-image="width" />
                        </div>
                        <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm" aria-pressed="true" aria-label="@TextDefaults.RichTextImageKeepRatio" title="@TextDefaults.RichTextImageKeepRatio" data-ib-image="ratio"><Icon Name="Lucide.Link2" /></button>
                        <div class="ib-field">
                            <label class="ib-field-label" for="@(FieldId)-image-height">@TextDefaults.RichTextImageHeight</label>
                            <input class="ib-field-input" id="@(FieldId)-image-height" type="number" min="1" max="10000" inputmode="numeric" data-ib-image="height" />
                        </div>
                    </div>
                    <div class="ib-field">
                        <label class="ib-field-label" for="@(FieldId)-image-alt">@TextDefaults.RichTextImageAlt</label>
                        <input class="ib-field-input" id="@(FieldId)-image-alt" type="text" autocomplete="off" aria-describedby="@(FieldId)-image-alt-hint" data-ib-image="alt" />
                        <p class="ib-field-hint" id="@(FieldId)-image-alt-hint">@TextDefaults.RichTextImageAltHint</p>
                    </div>
                    <label class="ib-rich-text-check"><input type="checkbox" data-ib-image="decorative" /> @TextDefaults.RichTextImageDecorative</label>
                    <p class="ib-field-error" role="alert" data-ib-image="error" hidden></p>
                    <footer class="ib-dialog-footer">
                        <Button Variant="ButtonVariant.Ghost" Accent="Accent.Danger" Size="ControlSize.Sm" class="ib-rich-text-remove" data-ib-image="remove">@TextDefaults.RichTextImageRemove</Button>
                        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-image="cancel">@TextDefaults.Cancel</Button>
                        <Button Size="ControlSize.Sm" data-ib-image="apply">@TextDefaults.RichTextLinkApply</Button>
                    </footer>
                </div>
            </dialog>
        }
        @if (Has(RichTextTools.Table) && ShowsToolbar)
        {
            <dialog class="ib-dialog ib-dialog-sm ib-dialog-center ib-rich-text-dialog ib-rich-text-table" aria-labelledby="@(FieldId)-table-title">
                <header class="ib-dialog-header">
                    <h2 class="ib-dialog-title" id="@(FieldId)-table-title">@TextDefaults.RichTextTableInsert</h2>
                </header>
                <div class="ib-dialog-body">
                    <div class="ib-rich-text-image-size ib-rich-text-table-size">
                        <div class="ib-field">
                            <label class="ib-field-label" for="@(FieldId)-table-rows">@TextDefaults.RichTextTableRows</label>
                            <input class="ib-field-input" id="@(FieldId)-table-rows" type="number" min="1" max="50" value="3" inputmode="numeric" data-ib-table="rows" />
                        </div>
                        <div class="ib-field">
                            <label class="ib-field-label" for="@(FieldId)-table-columns">@TextDefaults.RichTextTableColumns</label>
                            <input class="ib-field-input" id="@(FieldId)-table-columns" type="number" min="1" max="12" value="3" inputmode="numeric" data-ib-table="columns" />
                        </div>
                    </div>
                    <label class="ib-rich-text-check"><input type="checkbox" checked data-ib-table="header" /> @TextDefaults.RichTextTableHeader</label>
                    <footer class="ib-dialog-footer">
                        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" data-ib-table="cancel">@TextDefaults.Cancel</Button>
                        <Button Size="ControlSize.Sm" data-ib-table="apply">@TextDefaults.RichTextLinkApply</Button>
                    </footer>
                </div>
            </dialog>
        }
        @if (Has(RichTextTools.CodeBlock) && ShowsToolbar && Languages.Count > 0)
        {
            @* A code block's language: a button at the block's corner while the caret is in it (placed
               by the script). The value keeps it as the code's class, language-csharp. *@
            <div class="ib-rich-text-code-language" hidden data-ib-code-language>
                <Menu Label="@TextDefaults.RichTextCodeLanguage" Placement="Placement.BottomEnd">
                    <Trigger>
                        <Button @attributes="context" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" EndIcon="Lucide.ChevronDown"
                                aria-label="@MenuLabel(TextDefaults.RichTextCodeLanguage, TextDefaults.RichTextPlainText)" data-ib-code-button><span class="ib-rich-text-menu-name">@TextDefaults.RichTextPlainText</span></Button>
                    </Trigger>
                    <ChildContent>
                        <MenuRadioGroup Label="@TextDefaults.RichTextCodeLanguage" Value="">
                            <MenuItem Value="" data-ib-code-lang="" data-ib-label="@MenuLabel(TextDefaults.RichTextCodeLanguage, TextDefaults.RichTextPlainText)"><span class="ib-rich-text-menu-text">@TextDefaults.RichTextPlainText</span></MenuItem>
                            @foreach (var language in Languages)
                            {
                                <MenuItem Value="@language" data-ib-code-lang="@language" data-ib-label="@MenuLabel(TextDefaults.RichTextCodeLanguage, LanguageName(language))"><span class="ib-rich-text-menu-text">@LanguageName(language)</span></MenuItem>
                            }
                        </MenuRadioGroup>
                    </ChildContent>
                </Menu>
            </div>
        }
    </ib-rich-text>
</FieldFrame>

@code {
    private string _shown = "";
    private string? _seen;
    private string? _reported;
    private int _version;

    /// <summary>The tools in the toolbar. Defaults to <see cref="RichTextTools.Default"/>, every tool; <see cref="RichTextTools.None"/> leaves only the shortcuts.</summary>
    [Parameter] public RichTextTools Tools { get; set; } = RichTextTools.Default;

    /// <summary>The height of the text, in lines, before it grows. Defaults to 6.</summary>
    [Parameter] public int Rows { get; set; } = 6;

    /// <summary>Example text shown when empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Makes the field read-only: the text can be selected, not changed, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>A class on the text, for your own rules on what's in it, such as <c>.article h2</c>. Give the same class to <see cref="RichText"/> to show it the same way.</summary>
    [Parameter] public string? ContentClass { get; set; }

    /// <summary>
    /// The text's font size, on <see cref="Prose"/>'s scale: 14, 16 or 18px, with the gaps
    /// between paragraphs to match. Defaults to <see cref="ProseSize.Md"/>. The width follows the
    /// editor's container.
    /// </summary>
    [Parameter] public ProseSize FontSize { get; set; } = ProseSize.Md;

    /// <summary>
    /// Turns typed Markdown into formats as you type: <c>## </c> a heading, <c>- </c> and <c>1. </c>
    /// lists, <c>&gt; </c> a quote, three backticks a code block, <c>**bold**</c>, <c>*italic*</c>
    /// and <c>`code`</c>. On by default; Ctrl+Z undoes a change it made.
    /// </summary>
    [Parameter] public bool MarkdownShortcuts { get; set; } = true;

    /// <summary>
    /// The highest heading level, 1 to 6. The text-style menu offers it and the four below it.
    /// Defaults to 1; set 2 when the page shows its own heading 1 above the text, and give
    /// <see cref="RichText"/> the same.
    /// </summary>
    [Parameter] public int TopHeading { get; set; } = 1;

    /// <summary>
    /// The fonts the Font tool offers, each a CSS <c>font-family</c> value such as
    /// <c>Georgia, serif</c>; the first name in each is its label. Only these are kept in the
    /// value. Give <see cref="RichText"/> the same list.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Fonts { get; set; }

    /// <summary>
    /// Fixed text sizes for the Size tool, such as <c>12px</c> or <c>14pt</c>, in place of its steps
    /// (Smaller to Largest), which scale with the text around them. Only these are kept in the value.
    /// Give <see cref="RichText"/> the same list.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? FontSizes { get; set; }

    /// <summary>
    /// The languages a code block can be marked as, each a name such as <c>csharp</c>, written in
    /// the value as the code's class (<c>language-csharp</c>), which <see cref="RichText"/>
    /// highlights and Prism or highlight.js read too. Defaults to the languages the library's
    /// highlighter knows; an empty list leaves code blocks unmarked.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? CodeLanguages { get; set; }

    /// <summary>
    /// Where the image tool sends a chosen, pasted or dropped image: an endpoint of your app that
    /// takes a multipart POST with the image in a <c>file</c> field (and the form's antiforgery
    /// token, when it has one: a .NET 11 app without <c>UseAntiforgery</c> checks the origin
    /// instead), stores it, and answers with its URL, as text or as JSON <c>{ "url": "…" }</c>.
    /// Without it, images come only by their address, or embedded with <see cref="AllowDataImages"/>.
    /// </summary>
    [Parameter] public string? ImageUploadUrl { get; set; }

    /// <summary>
    /// Images chosen, pasted or dropped with no <see cref="ImageUploadUrl"/> are embedded in the
    /// value as <c>data:</c> URLs (PNG, JPEG, GIF, WebP or AVIF, never SVG). Off by default: it makes
    /// the value as large as its images. Give <see cref="RichText"/> the same.
    /// </summary>
    [Parameter] public bool AllowDataImages { get; set; }

    /// <summary>
    /// The text color and highlight menus end with "Custom…", which opens a color panel for any
    /// color, written as a style with six hex digits. Off by default: a color chosen in a light
    /// theme can be unreadable in a dark one, which the palette's colors avoid. Give
    /// <see cref="RichText"/> the same.
    /// </summary>
    [Parameter] public bool CustomColors { get; set; }

    /// <summary>The largest image, in bytes, that can be uploaded or embedded. Defaults to 2 MB.</summary>
    [Parameter] public long MaxImageSize { get; set; } = 2_000_000;

    /// <summary>
    /// The toolbar wraps onto more rows (the default), filling each; false keeps it one row, and what
    /// doesn't fit moves into a "…" menu at its end.
    /// </summary>
    [Parameter] public bool WrapToolbar { get; set; } = true;

    /// <summary>The most characters of text, not counting the HTML around it. Checked on the server; with script, the count shows when it's passed.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Shows "n / max" under the field. Needs <see cref="MaxLength"/>. Updates as you type once scripts run.</summary>
    [Parameter] public bool ShowCount { get; set; }

    /// <summary>Tools of your own at the end of the toolbar, such as a <see cref="ToolbarButton"/> whose <c>OnClick</c> calls <see cref="InsertHtmlAsync"/>.</summary>
    [Parameter] public RenderFragment? ToolbarContent { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    private ElementReference _host;
    private IJSObjectReference? _module;

    private bool ShowsCount => ShowCount && MaxLength is not null;

    private string CountId => FieldId + "-count";

    /// <summary>
    /// Inserts HTML at the caret, or in place of the selection, as if typed: it's sanitized first,
    /// and Ctrl+Z undoes it. For your own tools on interactive pages; on a static page it does nothing.
    /// </summary>
    /// <param name="html">The HTML to insert, such as <c>&lt;p&gt;Kind regards,&lt;br&gt;Dana&lt;/p&gt;</c>.</param>
    public async Task InsertHtmlAsync(string html)
    {
        if (!RendererInfo.IsInteractive) return;
        // The plain path: the page's import map gives it the same module the page already loaded.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/IzzyBlazor.Core/elements/rich-text.js");
        await _module.InvokeVoidAsync("insertHtml", _host, RichTextSanitizer.Sanitize(html, Top, Fonts, FontSizes, AllowDataImages, CustomColors));
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <inheritdoc />
    private protected override bool HasOwnRules => MaxLength is not null;

    /// <inheritdoc />
    private protected override string? OwnRuleError(string? value) =>
        MaxLength is { } max && TextLength(value ?? "") > max
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.RichTextTooLong, ResolvedLabel ?? FieldIdentifier.FieldName, max)
            : null;

    // The text's length, as the script counts it: no tags, entities as one character, and line
    // breaks (a code block's) not counted, as a <br> isn't.
    private static int TextLength(string html) =>
        System.Net.WebUtility.HtmlDecode(System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "")).Count(c => c is not ('\n' or '\r'));

    private int Top => Math.Clamp(TopHeading, 1, 6);

    private string LabelId => FieldId + "-label";

    private string SurfaceId => FieldId + "-text";

    private bool ShowsToolbar => Tools != RichTextTools.None && !IsReadOnly && !IsDisabled;

    private string SurfaceClass => new ClassBuilder()
        .Add("ib-rich-text-surface ib-prose")
        .Add("ib-prose-sm", FontSize == ProseSize.Sm)
        .Add("ib-prose-lg", FontSize == ProseSize.Lg)
        .Add(ContentClass)
        .Build()!;

    private bool Has(RichTextTools tool) => (Tools & tool) == tool;

    private bool HasStyle => Has(RichTextTools.TextStyle);

    private bool HasFormats => HasAny(RichTextTools.Bold | RichTextTools.Italic | RichTextTools.Underline | RichTextTools.Strikethrough
        | RichTextTools.Subscript | RichTextTools.Superscript | RichTextTools.InlineCode | RichTextTools.Link | RichTextTools.Image);

    private bool HasLists => HasAny(RichTextTools.BulletedList | RichTextTools.NumberedList | RichTextTools.TaskList | RichTextTools.Indent);

    private bool HasInserts => HasAny(RichTextTools.Quote | RichTextTools.CodeBlock | RichTextTools.Table | RichTextTools.HorizontalRule | RichTextTools.ClearFormatting);

    // An item in the table menu; those that change a table are disabled outside one (data-ib-in-table).
    private RenderFragment TableItem(string action, string label, IconData icon) =>
        @<MenuItem Icon="icon" data-ib-command="table" data-ib-value="@action" data-ib-in-table="@(action == "insert" ? null : "")">@label</MenuItem>;

    // The palette for text color and highlight: names in the sanitizer's list, labels from IzzyText.
    private static readonly string[] Palette = ["red", "orange", "yellow", "green", "blue", "purple", "gray"];

    private static readonly string[] NoSwatches = [];

    private string ColorName(string color) => color switch
    {
        "red" => TextDefaults.RichTextRed,
        "orange" => TextDefaults.RichTextOrange,
        "yellow" => TextDefaults.RichTextYellow,
        "green" => TextDefaults.RichTextGreen,
        "blue" => TextDefaults.RichTextBlue,
        "purple" => TextDefaults.RichTextPurple,
        _ => TextDefaults.RichTextGray,
    };

    // A font's label: the first family in its value, without quotes ("Georgia, serif" is Georgia).
    private static string FontName(string font) => font.Split(',')[0].Trim().Trim('"', '\'');

    // The toolbar's groups in order, each only when it has a tool.
    // Undo and redo first, as in DevExtreme and Radzen: nothing is pinned to the end, so the
    // tools fill each row when the toolbar wraps.
    private IEnumerable<RenderFragment> Groups()
    {
        if (Has(RichTextTools.UndoRedo)) yield return HistoryGroup;
        if (HasAny(RichTextTools.TextStyle | RichTextTools.Font | RichTextTools.FontSize)) yield return TextGroup;
        if (HasFormats) yield return FormatGroup;
        if (HasAny(RichTextTools.TextColor | RichTextTools.Highlight)) yield return ColorGroup;
        if (HasLists) yield return ListGroup;
        if (Has(RichTextTools.Alignment)) yield return AlignGroup;
        if (HasInserts) yield return InsertGroup;
    }

    private RenderFragment TextGroup => @<text>
        @if (HasStyle)
        {
            @* The button shows the style where the caret is; the script keeps it and the checked
               item current as the caret moves. *@
            <ToolbarMenu Label="@TextDefaults.RichTextStyle" Priority="2">
                <Trigger>
                    <Button @attributes="context" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                            EndIcon="Lucide.ChevronDown" class="ib-rich-text-style" data-ib-menu-button="block"
                            aria-label="@MenuLabel(TextDefaults.RichTextStyle, TextDefaults.RichTextParagraph)"><span class="ib-rich-text-menu-name">@TextDefaults.RichTextParagraph</span></Button>
                </Trigger>
                <ChildContent>
                    <MenuRadioGroup Label="@TextDefaults.RichTextStyle" Value="p">
                        @StyleItem("p", TextDefaults.RichTextParagraph, "0")
                        @for (var level = Top; level <= Math.Min(Top + 4, 6); level++)
                        {
                            @StyleItem($"h{level}", string.Format(TextDefaults.RichTextHeading, level), level.ToString(System.Globalization.CultureInfo.InvariantCulture))
                        }
                    </MenuRadioGroup>
                </ChildContent>
            </ToolbarMenu>
        }
        @if (Has(RichTextTools.Font) && Fonts is { Count: > 0 } fonts)
        {
            <ToolbarMenu Label="@TextDefaults.RichTextFont">
                <Trigger>
                    <Button @attributes="context" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                            EndIcon="Lucide.ChevronDown" class="ib-rich-text-font" data-ib-menu-button="font"
                            aria-label="@MenuLabel(TextDefaults.RichTextFont, TextDefaults.RichTextDefault)"><span class="ib-rich-text-menu-name">@TextDefaults.RichTextDefault</span></Button>
                </Trigger>
                <ChildContent>
                    <MenuRadioGroup Label="@TextDefaults.RichTextFont" Value="">
                        @ChoiceItem("font", "", TextDefaults.RichTextDefault, TextDefaults.RichTextFont)
                        @foreach (var font in fonts)
                        {
                            <MenuItem Value="@font" data-ib-command="font" data-ib-value="@font" data-ib-label="@MenuLabel(TextDefaults.RichTextFont, FontName(font))"><span class="ib-rich-text-menu-text" style="font-family: @font">@FontName(font)</span></MenuItem>
                        }
                    </MenuRadioGroup>
                </ChildContent>
            </ToolbarMenu>
        }
        @if (Has(RichTextTools.FontSize))
        {
            <ToolbarMenu Label="@TextDefaults.RichTextSize">
                <Trigger>
                    <Button @attributes="context" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                            EndIcon="Lucide.ChevronDown" class="ib-rich-text-size" data-ib-menu-button="size"
                            aria-label="@MenuLabel(TextDefaults.RichTextSize, TextDefaults.RichTextSizeNormal)"><span class="ib-rich-text-menu-name">@TextDefaults.RichTextSizeNormal</span></Button>
                </Trigger>
                <ChildContent>
                    <MenuRadioGroup Label="@TextDefaults.RichTextSize" Value="">
                        @if (FontSizes is { Count: > 0 } sizes)
                        {
                            @SizeItem("", TextDefaults.RichTextSizeNormal, null, null)
                            @foreach (var size in sizes)
                            {
                                @SizeItem(size, size, null, size)
                            }
                        }
                        else
                        {
                            @foreach (var (step, label, scale) in SizeSteps)
                            {
                                @SizeItem(step, label, step.Length == 0 ? null : "ib-size-" + step, $"{Math.Round(BasePixels * scale)}px")
                            }
                        }
                    </MenuRadioGroup>
                </ChildContent>
            </ToolbarMenu>
        }
    </text>;

    // With WrapToolbar false, higher priorities stay in the bar longest: history, then text formats,
    // then text style and lists; the rest move into the … menu first.
    private RenderFragment HistoryGroup => @<ToolbarButtonGroup Label="@TextDefaults.RichTextHistory" Priority="4">
        @Tool(RichTextTools.UndoRedo, "undo", Lucide.Undo2, TextDefaults.RichTextUndo, "Z")
        @Tool(RichTextTools.UndoRedo, "redo", Lucide.Redo2, TextDefaults.RichTextRedo, "Y")
    </ToolbarButtonGroup>;

    private RenderFragment FormatGroup => @<ToolbarButtonGroup Label="@TextDefaults.RichTextFormats" Priority="3">
        @Tool(RichTextTools.Bold, "bold", Lucide.Bold, TextDefaults.RichTextBold, "B", pressed: true)
        @Tool(RichTextTools.Italic, "italic", Lucide.Italic, TextDefaults.RichTextItalic, "I", pressed: true)
        @Tool(RichTextTools.Underline, "underline", Lucide.Underline, TextDefaults.RichTextUnderline, "U", pressed: true)
        @Tool(RichTextTools.Strikethrough, "strikethrough", Lucide.Strikethrough, TextDefaults.RichTextStrikethrough, "Shift+X", pressed: true)
        @Tool(RichTextTools.Subscript, "subscript", Lucide.Subscript, TextDefaults.RichTextSubscript, "=", pressed: true)
        @Tool(RichTextTools.Superscript, "superscript", Lucide.Superscript, TextDefaults.RichTextSuperscript, "Shift+=", pressed: true)
        @Tool(RichTextTools.InlineCode, "code", Lucide.Code, TextDefaults.RichTextInlineCode, "E", pressed: true)
        @Tool(RichTextTools.Link, "link", Lucide.Link, TextDefaults.RichTextLink, "K", pressed: true)
        @Tool(RichTextTools.Image, "image", Lucide.Image, TextDefaults.RichTextImage, null)
    </ToolbarButtonGroup>;

    private RenderFragment ColorGroup => @<text>
        @if (Has(RichTextTools.TextColor))
        {
            <ToolbarMenu Label="@TextDefaults.RichTextTextColor">
                <Trigger>
                    <IconButton @attributes="context" Icon="Lucide.Type" Label="@TextDefaults.RichTextTextColor" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                                class="ib-rich-text-swatch-tool" data-ib-swatch="color" />
                </Trigger>
                <ChildContent>
                    <MenuRadioGroup Label="@TextDefaults.RichTextTextColor" Value="">
                        @ChoiceItem("color", "", TextDefaults.RichTextDefault, null, "ib-rich-text-swatch")
                        @foreach (var color in Palette)
                        {
                            @ChoiceItem("color", color, ColorName(color), null, $"ib-rich-text-swatch ib-color-{color}")
                        }
                    </MenuRadioGroup>
                    @CustomItem("color")
                </ChildContent>
            </ToolbarMenu>
        }
        @if (Has(RichTextTools.Highlight))
        {
            <ToolbarMenu Label="@TextDefaults.RichTextHighlight">
                <Trigger>
                    <IconButton @attributes="context" Icon="Lucide.Highlighter" Label="@TextDefaults.RichTextHighlight" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                                class="ib-rich-text-swatch-tool" data-ib-swatch="highlight" />
                </Trigger>
                <ChildContent>
                    <MenuRadioGroup Label="@TextDefaults.RichTextHighlight" Value="">
                        @ChoiceItem("highlight", "", TextDefaults.RichTextNone, null, "ib-rich-text-swatch")
                        @foreach (var color in Palette)
                        {
                            @ChoiceItem("highlight", color, ColorName(color), null, $"ib-rich-text-swatch ib-highlight-{color}")
                        }
                    </MenuRadioGroup>
                    @CustomItem("highlight")
                </ChildContent>
            </ToolbarMenu>
        }
    </text>;

    private RenderFragment ListGroup => @<ToolbarButtonGroup Label="@TextDefaults.RichTextLists" Priority="2">
        @Tool(RichTextTools.BulletedList, "bulleted", Lucide.List, TextDefaults.RichTextBulletedList, "Shift+8", pressed: true)
        @Tool(RichTextTools.NumberedList, "numbered", Lucide.ListOrdered, TextDefaults.RichTextNumberedList, "Shift+7", pressed: true)
        @Tool(RichTextTools.TaskList, "tasks", Lucide.ListTodo, TextDefaults.RichTextTaskList, "Shift+9", pressed: true)
        @Tool(RichTextTools.Indent, "outdent", Lucide.ListIndentDecrease, TextDefaults.RichTextOutdent, "[")
        @Tool(RichTextTools.Indent, "indent", Lucide.ListIndentIncrease, TextDefaults.RichTextIndent, "]")
    </ToolbarButtonGroup>;

    private RenderFragment AlignGroup => @<ToolbarButtonGroup Label="@TextDefaults.RichTextAlignment">
        @Tool(RichTextTools.Alignment, "align", Lucide.TextAlignStart, TextDefaults.RichTextAlignStart, "Shift+L", pressed: true, value: "start")
        @Tool(RichTextTools.Alignment, "align", Lucide.TextAlignCenter, TextDefaults.RichTextAlignCenter, "Shift+E", pressed: true, value: "center")
        @Tool(RichTextTools.Alignment, "align", Lucide.TextAlignEnd, TextDefaults.RichTextAlignEnd, "Shift+R", pressed: true, value: "end")
    </ToolbarButtonGroup>;

    private RenderFragment InsertGroup => @<text>
        @Tool(RichTextTools.Quote, "quote", Lucide.Quote, TextDefaults.RichTextQuote, null, pressed: true)
        @Tool(RichTextTools.CodeBlock, "codeblock", Lucide.SquareCode, TextDefaults.RichTextCodeBlock, null, pressed: true)
        @if (Has(RichTextTools.Table))
        {
            @* One menu for tables: inserting one, and what changes the table at the caret (those
               items are disabled elsewhere, by the script). *@
            <ToolbarMenu Label="@TextDefaults.RichTextTable">
                <Trigger>
                    <IconButton @attributes="context" Icon="Lucide.Table" Label="@TextDefaults.RichTextTable" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" />
                </Trigger>
                <ChildContent>
                    @TableItem("insert", TextDefaults.RichTextTableInsert, Lucide.Table)
                    <MenuDivider />
                    @TableItem("row-above", TextDefaults.RichTextTableRowAbove, Lucide.ArrowUpToLine)
                    @TableItem("row-below", TextDefaults.RichTextTableRowBelow, Lucide.ArrowDownToLine)
                    @TableItem("column-before", TextDefaults.RichTextTableColumnBefore, Lucide.ArrowLeftToLine)
                    @TableItem("column-after", TextDefaults.RichTextTableColumnAfter, Lucide.ArrowRightToLine)
                    @TableItem("header", TextDefaults.RichTextTableHeader, Lucide.PanelTop)
                    <MenuDivider />
                    @TableItem("align-start", TextDefaults.RichTextTableAlignStart, Lucide.TextAlignStart)
                    @TableItem("align-center", TextDefaults.RichTextTableAlignCenter, Lucide.TextAlignCenter)
                    @TableItem("align-end", TextDefaults.RichTextTableAlignEnd, Lucide.TextAlignEnd)
                    <MenuDivider />
                    @TableItem("delete-row", TextDefaults.RichTextTableDeleteRow, Lucide.Trash)
                    @TableItem("delete-column", TextDefaults.RichTextTableDeleteColumn, Lucide.Trash)
                    @TableItem("delete-table", TextDefaults.RichTextTableDelete, Lucide.Trash)
                </ChildContent>
            </ToolbarMenu>
        }
        @Tool(RichTextTools.HorizontalRule, "rule", Lucide.Minus, TextDefaults.RichTextHorizontalRule, null)
        @Tool(RichTextTools.ClearFormatting, "clear", Lucide.RemoveFormatting, TextDefaults.RichTextClearFormatting, null)
    </text>;

    // "Text style, Heading 2": a menu button's name says what it is and what's chosen.
    private static string MenuLabel(string menu, string choice) => $"{menu}, {choice}";

    // The relative sizes: the class step, its label and its scale of the text around it.
    private (string Step, string Label, double Scale)[] SizeSteps =>
    [
        ("xs", TextDefaults.RichTextSizeSmaller, 0.75),
        ("sm", TextDefaults.RichTextSizeSmall, 0.875),
        ("", TextDefaults.RichTextSizeNormal, 1),
        ("lg", TextDefaults.RichTextSizeLarge, 1.25),
        ("xl", TextDefaults.RichTextSizeLarger, 1.5),
        ("2xl", TextDefaults.RichTextSizeLargest, 2),
    ];

    // The text's own size in pixels, for the hint beside each step ("Large 20px").
    private double BasePixels => FontSize switch { ProseSize.Sm => 14, ProseSize.Lg => 18, _ => 16 };

    // A size in the menu, drawn at its size: a step's class, or a fixed size's style.
    private RenderFragment SizeItem(string value, string label, string? step, string? hint) =>
        @<MenuItem Value="@value" data-ib-command="size" data-ib-value="@value" data-ib-label="@MenuLabel(TextDefaults.RichTextSize, label)"><span class="@(step is null ? "ib-rich-text-menu-text" : "ib-rich-text-menu-text " + step)" style="@(FontSizes is { Count: > 0 } && value.Length > 0 ? $"font-size: {value}" : null)">@label</span>@if (hint is not null && hint != label)
        {
            <span class="ib-rich-text-menu-hint">@hint</span>
        }</MenuItem>;

    private static readonly string[] DefaultLanguages = ["csharp", "razor", "html", "css", "javascript", "typescript", "json", "xml", "bash", "powershell"];

    private IReadOnlyList<string> Languages => CodeLanguages ?? DefaultLanguages;

    // The name a language shows by; one this doesn't know shows as given.
    private static string LanguageName(string language) => language.ToLowerInvariant() switch
    {
        "csharp" or "cs" or "c#" => "C#",
        "razor" => "Razor",
        "html" => "HTML",
        "css" => "CSS",
        "javascript" or "js" => "JavaScript",
        "typescript" or "ts" => "TypeScript",
        "json" => "JSON",
        "xml" => "XML",
        "bash" or "sh" or "shell" => "Bash",
        "powershell" or "pwsh" => "PowerShell",
        "sql" => "SQL",
        "python" or "py" => "Python",
        _ => language,
    };

    // A choice in a menu: a font, size, color or highlight. The preview class shows it as it'll look.
    // "Custom…" at the end of a color menu, with CustomColors: opens the custom color dialog.
    private RenderFragment? CustomItem(string format) => !CustomColors ? null :
        @<text>
            <MenuDivider />
            <MenuItem Icon="Lucide.Palette" data-ib-command="custom" data-ib-value="@format">@TextDefaults.RichTextCustomColor</MenuItem>
        </text>;

    private RenderFragment ChoiceItem(string command, string value, string label, string? menu, string? preview = null) =>
        @<MenuItem Value="@value" data-ib-command="@command" data-ib-value="@value" data-ib-label="@(menu is null ? null : MenuLabel(menu, label))"><span class="@(preview is null ? "ib-rich-text-menu-text" : "ib-rich-text-menu-text " + preview)">@label</span></MenuItem>;

    // An item that previews its style, with its shortcut (Ctrl+Alt+digit) when it has one.
    private RenderFragment StyleItem(string tag, string label, string? digit) =>
        @<MenuItem Value="@tag" data-ib-command="block" data-ib-value="@tag" data-ib-label="@MenuLabel(TextDefaults.RichTextStyle, label)"
                   Shortcut="@(digit is null ? null : $"Ctrl+Alt+{digit}")"><span class="ib-rich-text-preview-@tag">@label</span></MenuItem>;

    // The text's own keys no tool announces: to the toolbar, a plain paste, ticking a task.
    private string SurfaceShortcuts => Has(RichTextTools.TaskList) ? "Alt+F10 Control+Shift+V Control+Enter" : "Alt+F10 Control+Shift+V";

    private bool HasAny(RichTextTools tools) => (Tools & tools) != 0;

    private RenderFragment? Tool(RichTextTools tool, string command, IconData icon, string label, string? keys, bool pressed = false, string? value = null)
    {
        if (!Has(tool)) return null;
        // Shown as "Ctrl+B" here; the script writes ⌘ on a Mac.
        var title = keys is null ? label : $"{label} (Ctrl+{keys})";
        // Redo takes Ctrl+Shift+Z too.
        var shortcut = keys is null ? null : keys == "Y" ? "Control+Y Control+Shift+Z" : "Control+" + keys;
        return @<ToolbarIconButton Icon="icon" Label="@label" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm"
                                   data-ib-command="@command" data-ib-value="@value" aria-pressed="@(pressed ? "false" : null)"
                                   aria-keyshortcuts="@shortcut" title="@title" />;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        // A Value seen before, or the script's own report coming back, changes nothing on the
        // page; anything else is new, and replaces what's in the editor.
        var value = Value ?? "";
        if (_seen is not null && value == _seen) return;
        var first = _seen is null;
        _seen = value;
        if (value == _reported) return;
        _shown = RichTextSanitizer.Sanitize(value, labelTasks: true, Top, Fonts, FontSizes, AllowDataImages, CustomColors);
        _reported = null;
        if (!first) _version++;
    }

    /// <inheritdoc />
    private protected override bool FitsValue => true;

    /// <inheritdoc />
    private protected override string? FitValue(string? value) => Clean(value);

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = Clean(value);
        _reported = result ?? "";
        validationErrorMessage = null;
        return true;
    }

    // Sanitized, and null when nothing's left to show, so [Required] sees an empty editor as empty.
    private string? Clean(string? value)
    {
        var html = RichTextSanitizer.Sanitize(value, Top, Fonts, FontSizes, AllowDataImages, CustomColors);
        return IsBlank(html) ? null : html;
    }

    private static bool IsBlank(string html) =>
        !html.Contains("<img", StringComparison.Ordinal) && !html.Contains("<hr", StringComparison.Ordinal)
        && string.IsNullOrWhiteSpace(System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", "").Replace("&nbsp;", "").Replace(" ", ""));
}
