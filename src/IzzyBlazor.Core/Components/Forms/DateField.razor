@namespace IzzyBlazor
@typeparam TValue
@inherits CalendarFieldBase<TValue>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the browser's own calendar opens in place of the library's, and a posted DateTime or DateTimeOffset isn't read in TimeZone: Blazor reads a DateTimeOffset in the server's time zone and a DateTime as UTC. A DateOnly isn't affected, nor is a TimeZone of UTC on a server that runs in UTC.")]

@*
    A date field, or a date and time field: the browser's own input, so it posts with the form and
    takes a typed date, and the library's calendar to choose from. Bind it to DateOnly,
    DateTime or DateTimeOffset, or a nullable one.
    <DateField @bind-Value="Model.Due" />
    <DateField @bind-Value="Model.From" Max="@DateOnly.FromDateTime(DateTime.UtcNow)" />
    <DateField @bind-Value="Model.Due" DateDisabled="d => d.DayOfWeek == DayOfWeek.Sunday" />
    <DateField @bind-Value="Model.Due" UseNative />
    <DateField @bind-Value="Model.StartsAt" TimeZone="@zone" />

    The calendar writes to the input, so posting and binding don't change. UseNative keeps the
    browser's calendar. So do no script and a phone, unless the field has DateDisabled, which a
    browser's calendar can't show: there it's the library's, and on a phone the input can't be typed
    in. `Min`, `Max` and DateDisabled are checked again on the server, so a typed date is turned away
    when the form posts.

    With a time, the calendar has a box each for the hour and minute, with seconds if Step has them
    and AM or PM if the culture does, and OK: nothing is written until OK, and closing it any other
    way, by Escape or a click outside, drops the choice. Min
    and `Max` stop the days, and their times are checked as the form posts.

    A DateOnly is a date. A DateTime or DateTimeOffset takes a date and time, or only a date with
    Type="DateFieldType.Date" or [DataType(DataType.Date)] on the property (midnight in TimeZone).
    For a month, use MonthField; for a year, YearField.

    TimeZone is the zone the entered time is in, UTC unless set. A DateTimeOffset comes back with
    that zone's offset, and a DateTime comes back in UTC; a DateTime that isn't Local is read as
    UTC. On an interactive page its Kind is Utc. After a static post Blazor's form binding sets it,
    as Unspecified (the time is still UTC): use DateTime.SpecifyKind before ToUniversalTime or a
    timestamptz column, or bind a DateTimeOffset. On a server, TimeZoneInfo.Local is the server's zone, not the user's: ask the
    user for theirs, or keep UTC and say so in the label, as in "From (UTC)". A time a change of
    the clocks skips, such as 02:30, is taken with the zone's standard offset, so it's an hour later.
    The calendar marks today in TimeZone if it's set, and otherwise on the person's clock.

    Accessibility:
    - It renders the browser's own date or date-and-time `input` with a `label` linked to it:
      screen readers read each part (day, month, year) and arrow keys change it.
    - Label, hint and errors work as in `TextField`.
    - The time zone isn't announced: put it in the label when it matters, as in "Starts (UTC)",
      since add-on text isn't part of the field's name.
    - The calendar's button is named "Choose date" (`ChooseLabel`), or "Change date" and the date
      once there is one. Its panel is a non-modal `dialog`, named by the button, with the month as
      in `Calendar`. Focus goes to the chosen date or today, and on closing back to where it opened from.

    Keyboard:
    In the date field
    - Up, Down | Change the focused part of the date
    - Left, Right | Move between the parts of the date
    - Alt+Down | Open the calendar
    In the calendar's days
    - Left, Right | Move a day (reversed in right-to-left)
    - Up, Down | Move a week
    - Home, End | Go to the start or end of the week
    - Page Up, Page Down | Move a month, keeping the day number or the month's last day
    - Shift+Page Up, Shift+Page Down | Move a year
    - Enter, Space | Choose the date and close; with a time, choose the date and stay open
    In the calendar's time
    - Enter | Save the date and time, and close
    In the calendar
    - Tab, Shift+Tab | Move through the header, the days and the buttons, and close past either end
    - Escape | Close without changing the value
    See also: MonthField, YearField, TimeField, Calendar, Form.
*@

<FieldFrame Class="@WrapperClass("date")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" NoInput="TakesNoInput"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <FieldAddons StartAddon="StartAddon" EndAddon="EndAddon">
        <ib-field-control class="@ControlClass" style="@(HasPanel ? $"anchor-name:{StyleValues.AnchorName(FieldId + "-control")}" : null)">
            <input @attributes="ControlAttributes"
                   id="@FieldId"
                   class="ib-field-input"
                   type="@InputType"
                   name="@NameAttributeValue"
                   @bind="CurrentValueAsString"
                   min="@FormatLimit(Min, Range?.Minimum)"
                   max="@FormatLimit(Max, Range?.Maximum)"
                   step="@StepAttribute"
                   required="@IsRequired"
                   disabled="@IsDisabled"
                   readonly="@IsReadOnly"
                   data-ib-zone="@PostedZone"
                   data-ib-post="@(PostedZone is null ? null : IsOffset ? "offset" : "utc")"
                   aria-invalid="@(Invalid ? "true" : null)"
                   aria-describedby="@DescribedBy" />
            @if (Clearable && !IsDisabled && !IsReadOnly && Nullable.GetUnderlyingType(typeof(TValue)) is not null)
            {
                @ClearButton
            }
            @if (HasPanel)
            {
                <Popover Placement="Placement.BottomStart">
                    <Trigger Context="trigger">
                        <button @attributes="trigger" type="button" class="ib-date-toggle" aria-label="@ChooseText">
                            <Icon Purpose="IconPurpose.Calendar" Class="ib-field-icon" />
                        </button>
                    </Trigger>
                    <ChildContent>
                        <ib-calendar class="ib-calendar"
                                     @attributes="CalendarAttributes"
                                     data-ib-change="@(ChooseLabel is null ? TextDefaults.CalendarChange : null)"
                                     data-ib-choose="@ChooseText"
                                     data-ib-time-zone="@(TimeZone is null || IsDateOnly ? null : DateFieldZones.ScriptId(TimeZone))">
                            <div class="ib-calendar-view">
                                <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/date.css"]" />
                                @CalendarGrid.Month(Drawn, null)
                                @if (ResolvedType == DateFieldType.DateTime)
                                {
                                    @CalendarGrid.TimeBoxes(TextDefaults, ResolvedCulture, Step, ShowsSeconds, focusFirst: false)
                                }
                                @if (ResolvedType == DateFieldType.DateTime)
                                {
                                    <div class="ib-calendar-foot">
                                        <Button Size="ControlSize.Sm" data-ib-ok>@TextDefaults.Ok</Button>
                                    </div>
                                }
                            </div>
                        </ib-calendar>
                    </ChildContent>
                </Popover>
            }
        </ib-field-control>
    </FieldAddons>
</FieldFrame>

@code {
    /// <summary>Makes the field read-only: it can be focused, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    /// <summary>
    /// A date, or a date and time. Defaults to a date for <c>DateOnly</c> and for a property with
    /// <c>[DataType(DataType.Date)]</c>; otherwise a date and time. A <c>DateOnly</c> can't take a time.
    /// For a month or a year, use <see cref="MonthField{TValue}"/> or <see cref="YearField{TValue}"/>.
    /// </summary>
    [Parameter] public DateFieldType? Type { get; set; }

    /// <summary>The earliest value. Defaults to <c>[Range]</c>'s minimum; the type's default value means none.</summary>
    [Parameter] public TValue? Min { get; set; }

    /// <summary>The latest value. Defaults to <c>[Range]</c>'s maximum; the type's default value means none.</summary>
    [Parameter] public TValue? Max { get; set; }

    /// <summary>
    /// The step between allowed values: whole days for a date (1 day unless set), seconds for a
    /// date and time (1 minute unless set). A step under a minute shows seconds; otherwise the time
    /// shows to the minute, and seconds in the bound value are dropped when it posts.
    /// </summary>
    [Parameter] public TimeSpan? Step { get; set; }

    /// <summary>
    /// The zone the entered time is in, for a <c>DateTime</c> or <c>DateTimeOffset</c>. Defaults to UTC.
    /// A <c>DateTimeOffset</c> comes back with this zone's offset; a <c>DateTime</c> comes back in UTC
    /// (with Kind Unspecified after a static post, which Blazor's form binding reads). Use a zone
    /// with an IANA or Windows id, which the browser's script can look up for static posts.
    /// </summary>
    [Parameter] public TimeZoneInfo? TimeZone { get; set; }

    /// <summary>Content attached before the control, outside its border. See <see cref="TextFieldBase.StartAddon"/>.</summary>
    [Parameter] public RenderFragment? StartAddon { get; set; }

    /// <summary>Content attached after the control, outside its border, such as the time zone.</summary>
    [Parameter] public RenderFragment? EndAddon { get; set; }

    /// <summary>
    /// Keeps the browser's calendar in place of the library's. <see cref="CalendarFieldBase{TValue}.DateDisabled"/>
    /// is then checked only on the server, as the browser's calendar can't show it.
    /// </summary>
    [Parameter] public bool UseNative { get; set; }

    /// <summary>A button in the field that empties it, for a nullable value, there while it holds something. Off by default.</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>The name of the calendar's button, in place of "Choose date" and "Change date" with the date.</summary>
    [Parameter] public string? ChooseLabel { get; set; }

    private static readonly Type Underlying = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    private static bool IsDateOnly => Underlying == typeof(DateOnly);

    private static bool IsOffset => Underlying == typeof(DateTimeOffset);

    private TimeZoneInfo Zone => TimeZone ?? TimeZoneInfo.Utc;

    // Nothing to choose from on a field that can't change.
    private bool HasPanel => !UseNative && !IsDisabled && !IsReadOnly;

    private string ChooseText => ChooseLabel ?? TextDefaults.CalendarChoose;

    // A field whose rules a browser's calendar can't show keeps the library's on a phone too.
    private string ControlClass => new ClassBuilder()
        .Add("ib-field-control")
        .Add("ib-date-control", HasPanel)

        .Add("ib-date-own", HasPanel && DateDisabled is not null)
        .Build()!;

    private string InputType => ResolvedType == DateFieldType.Date ? "date" : "datetime-local";

    private static DateOnly? DayOf(string? text) =>
        text is null ? null : DateOnly.ParseExact(text.AsSpan(0, 10), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    /// <inheritdoc />
    private protected override bool LabelNamesMonth => false;

    /// <inheritdoc />
    private protected override DateOnly? ChosenDay =>
        CurrentValue is DateOnly date && date == default ? null : DayOf(Format(CurrentValue));

    /// <inheritdoc />
    private protected override DateOnly? FirstDay => DayOf(FormatLimit(Min, Range?.Minimum));

    /// <inheritdoc />
    private protected override DateOnly? LastDay => DayOf(FormatLimit(Max, Range?.Maximum));

    private DateFieldType ResolvedType => Type
        ?? (IsDateOnly || Attribute<System.ComponentModel.DataAnnotations.DataTypeAttribute>()?.DataType == System.ComponentModel.DataAnnotations.DataType.Date
            ? DateFieldType.Date
            : DateFieldType.DateTime);

    private System.ComponentModel.DataAnnotations.RangeAttribute? Range =>
        Attribute<System.ComponentModel.DataAnnotations.RangeAttribute>();

    private bool ShowsSeconds => ResolvedType == DateFieldType.DateTime && Step is { } step && step.Ticks % TimeSpan.TicksPerMinute != 0;

    private string? StepAttribute => Step switch
    {
        null => null,
        { } step when ResolvedType == DateFieldType.Date => Math.Max(1, (long)Math.Round(step.TotalDays)).ToString(System.Globalization.CultureInfo.InvariantCulture),
        { } step => Math.Max(1, (long)Math.Round(step.TotalSeconds)).ToString(System.Globalization.CultureInfo.InvariantCulture),
    };

    // The zone a static post converts to, for the script (Blazor's form binding reads a posted
    // time without an offset in the server's zone): a DateTimeOffset always gets its offset; a
    // DateTime posts UTC, which needs converting only from another zone. Interactive pages convert in C#.
    private string? PostedZone =>
        RendererInfo.IsInteractive || IsDateOnly || (!IsOffset && Zone.BaseUtcOffset == TimeSpan.Zero && !Zone.SupportsDaylightSavingTime)
            ? null
            : DateFieldZones.ScriptId(Zone);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Underlying != typeof(DateOnly) && Underlying != typeof(DateTime) && Underlying != typeof(DateTimeOffset))
        {
            throw new InvalidOperationException(Underlying == typeof(int)
                ? "DateField doesn't take an int. For a year, use YearField."
                : $"DateField doesn't support {typeof(TValue)}. Bind it to DateOnly, DateTime or DateTimeOffset, or a nullable one.");
        }

        if (IsDateOnly && Type == DateFieldType.DateTime)
        {
            throw new InvalidOperationException("A DateField bound to DateOnly can't take a time. Bind it to DateTime or DateTimeOffset for a date and time.");
        }

        base.OnParametersSet();
        if (HasPanel)
        {
            AskAboutDays();
        }
    }

    /// <inheritdoc />
    private protected override bool HasOwnRules => Min is not null || Max is not null || DateDisabled is not null;

    // As the input shows them, in Zone: fixed-width text sorts as the times do.
    /// <inheritdoc />
    private protected override string? OwnRuleError(TValue value)
    {
        var (shown, min, max) = (Format(value), FormatLimit(Min, null), FormatLimit(Max, null));
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        string Said(string limit) => DateTime.TryParse(limit, System.Globalization.CultureInfo.InvariantCulture, out var at)
            ? at.ToString(ResolvedType == DateFieldType.Date ? "d" : "g", culture)
            : limit;
        if (shown is null)
        {
            return null;
        }

        return min is not null && string.CompareOrdinal(shown, min) < 0 ? string.Format(culture, TextDefaults.TooEarly, ResolvedLabel, Said(min))
            : max is not null && string.CompareOrdinal(shown, max) > 0 ? string.Format(culture, TextDefaults.TooLate, ResolvedLabel, Said(max))
            : DateDisabled is not null && DayOf(shown) is { } day && DateDisabled(day) ? string.Format(culture, TextDefaults.DateUnavailable, ResolvedLabel, Said(shown))
            : null;
    }

    /// <inheritdoc />
    protected override string? FormatValueAsString(TValue? value) => Format(value);

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, [System.Diagnostics.CodeAnalysis.MaybeNullWhen(false)] out TValue result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (TryParse(value, out result))
        {
            validationErrorMessage = null;
            return true;
        }

        validationErrorMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.DateInvalid, ResolvedLabel ?? FieldIdentifier.FieldName);
        return false;
    }

    // The input's text: the value's date, or its date and time in Zone, as the browser writes them.
    private string? Format(object? value)
    {
        DateTime? wall = value switch
        {
            DateOnly date => date.ToDateTime(TimeOnly.MinValue),
            // Through UTC: ConvertTime throws for a Local time in the server's own DST gap.
            DateTime { Kind: DateTimeKind.Local } local => TimeZoneInfo.ConvertTimeFromUtc(local.ToUniversalTime(), Zone),
            DateTime time => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(time, DateTimeKind.Utc), Zone),
            DateTimeOffset offset => TimeZoneInfo.ConvertTime(offset, Zone).DateTime,
            _ => null,
        };

        return wall?.ToString(
            ResolvedType == DateFieldType.Date ? "yyyy-MM-dd" : ShowsSeconds ? "yyyy-MM-dd'T'HH:mm:ss" : "yyyy-MM-dd'T'HH:mm",
            System.Globalization.CultureInfo.InvariantCulture);
    }

    // Min and Max, or [Range]'s ends: a value of the bound type, or text the browser would post.
    private string? FormatLimit(TValue? limit, object? annotated)
    {
        if (limit is not null && !EqualityComparer<TValue>.Default.Equals(limit, default))
        {
            return Format(limit);
        }

        return annotated switch
        {
            string text => TryParse(text, out var parsed) ? Format(parsed) : null,
            null => null,
            _ => Format(annotated),
        };
    }

    private bool TryParse(string? text, [System.Diagnostics.CodeAnalysis.MaybeNullWhen(false)] out TValue result)
    {
        result = default!;
        if (string.IsNullOrWhiteSpace(text))
        {
            return Nullable.GetUnderlyingType(typeof(TValue)) is not null;
        }

        if (!DateTime.TryParseExact(text.Trim(), InputFormats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var wall))
        {
            return false;
        }

        if (ResolvedType == DateFieldType.Date)
        {
            wall = wall.Date;
        }

        // A time at the very ends of the calendar (year 1 east of UTC, 9999 west of it) has no UTC
        // equivalent: not a date this field can hold.
        var offset = IsDateOnly ? TimeSpan.Zero : Zone.GetUtcOffset(wall);
        var utcTicks = wall.Ticks - offset.Ticks;
        if (utcTicks < DateTime.MinValue.Ticks || utcTicks > DateTime.MaxValue.Ticks)
        {
            return false;
        }

        // Each branch boxed: a conditional would turn the DateTime into a DateTimeOffset.
        result = (TValue)(IsDateOnly ? (object)DateOnly.FromDateTime(wall)
            : IsOffset ? (object)new DateTimeOffset(wall, offset)
            : new DateTime(utcTicks, DateTimeKind.Utc));
        return true;
    }

    // What date and datetime-local inputs post.
    private static readonly string[] InputFormats =
    [
        "yyyy-MM", "yyyy-MM-dd", "yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd'T'HH:mm:ss", "yyyy-MM-dd'T'HH:mm:ss.FFFFFFF",
    ];
}
