@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, it's a plain dropdown with no typing to filter.")]

@*
    A select you can type in to filter. Options come from Items, an enum, or Search.

    <Combobox @bind-Value="Model.CountryId" Items="CountryIds" ItemText="id => Countries[id]" Placeholder="Search countries" />
    <Combobox @bind-Value="Model.OwnerId" Search="FindPeople" ItemText="id => People[id].Name">
        <ItemTemplate Context="id"><Avatar ... /> @People[id].Name</ItemTemplate>
    </Combobox>

    How it works three ways:
    - No script: a native select holds and posts the value, so the form works as is.
    - With script (<ib-combobox>): a text input and a listbox take over, filtering as you type.
      The select stays in the form, hidden under the input, so posting, required validation and
      @bind still go through it.
    - Interactive with Search: typing calls Search on the server (debounced) and the list shows
      its results; Enter or leaving the field before they come waits for them. Choosing, Escape
      or leaving puts the chosen text back and, after a search, calls Search("") again, so the
      list opens with the first results. Without a circuit, Search("") fills the list once and it filters in the
      browser.

    Accessibility:
    - With script, the input is a `combobox` with a `listbox` of options: focus stays in the
      input, and the highlighted option is its `aria-activedescendant`.
    - Down and Up open the list and move through it, Page Down and Page Up move ten, Enter chooses,
      and Alt+Up chooses and closes.
    - Escape closes the list and puts the chosen text back, without closing a dialog around it;
      Tab closes it too.
    - Leaving the field takes an option whose text was typed in full, and clears the value when
      the text was emptied.
    - When nothing matches, "No matches" (`EmptyText`) is announced politely, as is "Searching…"
      while a server search runs.
    - The label names the input and the list; the chevron button is named "Show options"
      (`ToggleLabel`) and is left out of the Tab order.
    - With JavaScript off, it's a native `select`, with its own keys and announcements.
    See also: Select, MultiSelect, TextField.
*@

<FieldFrame Class="@WrapperClass("combobox")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    @if (ShowsReadOnly)
    {
        @ReadOnlyControl(SelectedText)
    }
    else
    {
    <ib-combobox class="ib-field-control ib-has-end ib-combobox"
                 style="@($"anchor-name:{StyleValues.AnchorName(ListId)}")"
                 data-server="@(ServerFiltered ? "" : null)">
        <select @attributes="ControlAttributes"
                id="@FieldId"
                class="ib-field-input ib-field-select ib-combobox-select"
                name="@NameAttributeValue"
                @bind="CurrentValueAsString"
                required="@IsRequired"
                disabled="@IsDisabled"
                aria-invalid="@(Invalid ? "true" : null)"
                aria-describedby="@DescribedBy">
            @* Always present: clearing the text clears the value. *@
            <option value="" disabled="@IsRequired" selected="@string.IsNullOrEmpty(CurrentValueAsString)">@Placeholder</option>
            @foreach (var item in SelectOptions)
            {
                @* Keyed: when the choice changes, the option for the old one goes, not the chosen one. *@
                <option @key="FormatValueAsString(item)" value="@FormatValueAsString(item)">@TextFor(item)</option>
            }
        </select>
        <input type="text"
               id="@InputId"
               class="ib-field-input ib-combobox-input"
               value="@SelectedText"
               placeholder="@Placeholder"
               role="combobox"
               aria-autocomplete="list"
               aria-expanded="false"
               aria-controls="@ListId"
               aria-labelledby="@LabelId"
               aria-required="@(IsRequired ? "true" : null)"
               aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@DescribedBy"
               autocomplete="off"
               autocapitalize="off"
               spellcheck="false"
               enterkeyhint="done"
               disabled="@IsDisabled"
               readonly="@IsReadOnly"
               @attributes="SearchAttributes" />
        <button type="button" class="ib-combobox-toggle" tabindex="-1" aria-label="@(ToggleLabel ?? TextDefaults.ShowOptions)" disabled="@IsDisabled">
            <Icon Role="IconRole.ChevronDown" Class="ib-field-icon" />
        </button>
        <div id="@ListId"
             class="ib-pop ib-place-bottom-start ib-combobox-list"
             style="@($"position-anchor:{StyleValues.AnchorName(ListId)}")"
             popover="manual"
             role="listbox"
             aria-labelledby="@LabelId"
             aria-busy="@(_searching ? "true" : null)"
             data-query="@(ServerFiltered ? _resultsQuery : null)">
            @{ var index = 0; }
            @foreach (var item in ListOptions.DistinctBy(FormatValueAsString))
            {
                var value = FormatValueAsString(item);
                <div @key="value"
                     role="option"
                     id="@($"{ListId}-{index++}")"
                     class="ib-combobox-option"
                     data-value="@value"
                     data-text="@TextFor(item)"
                     aria-selected="@(value == CurrentValueAsString ? "true" : "false")">
                    @if (ItemTemplate is null)
                    {
                        @TextFor(item)
                    }
                    else
                    {
                        @ItemTemplate(item)
                    }
                </div>
            }
            @* Shown in the list, but read through the status below: a listbox holds only options. *@
            <div class="ib-combobox-empty" aria-hidden="true">@(_searching ? SearchingText ?? TextDefaults.Searching : EmptyText ?? TextDefaults.NoMatches)</div>
        </div>
        <span class="ib-visually-hidden ib-combobox-status" role="status"></span>
        @if (ServerFiltered)
        {
            @* The script fires input here when it puts the chosen text back, so the list holds the
               first results again, not the last search's. *@
            <input type="hidden" class="ib-combobox-reset" value="" @attributes="SearchAttributes" />
        }
    </ib-combobox>
    }
    @if (PostsReadOnlyValue)
    {
        @* Read-only: the value shows in a read-only text field, which doesn't post it; this does. *@
        <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString" />
    }
</FieldFrame>

@code {
    private CancellationTokenSource? _searchCts;
    private IReadOnlyList<TValue>? _results;
    // The text _results were found for, so the script knows which search they answer.
    private string _resultsQuery = "";
    private bool _searching;

    /// <summary>The options. Not needed for enums, whose values are listed automatically, or with <see cref="Search"/>.</summary>
    [Parameter] public IEnumerable<TValue>? Items { get; set; }

    /// <summary>
    /// Finds options for the typed text, for lists too long to send whole. Called with "" to fill
    /// the list at first (on every page), and as the user types on interactive pages. Return a
    /// short list, such as the first 50 matches.
    /// </summary>
    [Parameter, ModeSupport(Off = ModeLevel.Partial, Static = ModeLevel.Partial, Notes = "On static pages, Search fills the list once; searching as you type needs an interactive page.")]
    public Func<string, CancellationToken, Task<IEnumerable<TValue>>>? Search { get; set; }

    /// <summary>Milliseconds to wait after the last keystroke before calling <see cref="Search"/>.</summary>
    [Parameter] public int Debounce { get; set; } = 250;

    /// <summary>
    /// The text for each option, also what's typed to find it and what the field shows once chosen.
    /// Defaults to the enum value's <c>[Display(Name)]</c> or its string form. Keep it unique.
    /// </summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    /// <summary>Markup for each option in the list, such as an icon or avatar. The field shows <see cref="ItemText"/>.</summary>
    [Parameter] public RenderFragment<TValue>? ItemTemplate { get; set; }

    /// <summary>Text in the empty field, such as "Search countries". Also the empty option without script.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Shown when nothing matches.</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Shown while <see cref="Search"/> runs.</summary>
    [Parameter] public string? SearchingText { get; set; }

    /// <summary>The accessible name of the button that opens the list.</summary>
    [Parameter] public string? ToggleLabel { get; set; }

    private string InputId => FieldId + "-input";
    private string ListId => FieldId + "-list";
    private string LabelId => FieldId + "-label";

    // Server filtering needs a circuit; without one the browser filters the first results.
    private bool ServerFiltered => Search is not null && RendererInfo.IsInteractive;

    // Keystrokes go to the server only when it does the searching.
    private Dictionary<string, object>? SearchAttributes => ServerFiltered
        ? new() { ["oninput"] = EventCallback.Factory.Create<ChangeEventArgs>(this, OnSearchInput) }
        : null;

    private string SelectedText => HasValue ? TextFor(CurrentValue!) : "";

    private bool HasValue => !string.IsNullOrEmpty(CurrentValueAsString);

    private IEnumerable<TValue> ListOptions
    {
        get
        {
            if (Search is not null)
            {
                // The first results lead with the choice when they leave it out, so the list opens on it.
                var results = _results ?? [];
                return _resultsQuery.Length == 0 && HasValue && !results.Any(r => FormatValueAsString(r) == CurrentValueAsString)
                    ? results.Prepend(CurrentValue!)
                    : results;
            }

            if (Items is not null)
            {
                return Items;
            }

            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return type.IsEnum ? Enum.GetValues(type).Cast<object>().Select(v => (TValue)v) : [];
        }
    }

    // The select needs the chosen value even when the current results don't include it.
    private IEnumerable<TValue> SelectOptions
    {
        get
        {
            var options = ListOptions.DistinctBy(FormatValueAsString).ToList();
            if (HasValue && !options.Any(o => FormatValueAsString(o) == CurrentValueAsString))
            {
                options.Insert(0, CurrentValue!);
            }

            return options;
        }
    }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (Search is not null && _results is null)
        {
            _results = (await Search("", CancellationToken.None)).ToList();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        if (Search is null || !RendererInfo.IsInteractive)
        {
            return;
        }

        // Cancel the last search but leave disposing it to its own call, which may still be
        // about to read its token.
        _searchCts?.Cancel();
        var cts = _searchCts = new CancellationTokenSource();
        var token = cts.Token;
        var query = e.Value?.ToString() ?? "";

        try
        {
            // Also for the first results after a choice: answered at once, they'd render in the same
            // batch as the choice, and the select would fall back to the placeholder.
            await Task.Delay(Debounce, token);
            _searching = true;
            StateHasChanged();
            var results = (await Search(query, token)).ToList();
            if (!token.IsCancellationRequested)
            {
                _results = results;
                _resultsQuery = query;
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        finally
        {
            if (ReferenceEquals(_searchCts, cts))
            {
                _searching = false;
                _searchCts = null;
            }

            cts.Dispose();
        }
    }

    private string TextFor(TValue item)
    {
        if (ItemText is not null)
        {
            return ItemText(item);
        }

        if (item is Enum e)
        {
            return ChoiceOptions.EnumText(e);
        }

        return item?.ToString() ?? "";
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _searchCts?.Cancel();
            _searchCts?.Dispose();
        }

        base.Dispose(disposing);
    }
}
