@namespace IzzyBlazor
@inherits StyledComponentBase
@attribute [ModeSupport]

@*
    Groups related fields under a heading, such as a shipping address.
    <Fieldset Label="Shipping address" Description="Where we send your order.">
        <TextField @bind-Value="Model.Street" /> ...
    </Fieldset>

    Accessibility:
    - It renders a native `fieldset` with `Label` as its `legend`, which screen readers announce as
      the group's name when focus moves into it.
    - The `Description` describes the group (`aria-describedby`), so screen readers can read it
      with the name; what one field needs still goes in its `Hint`.
    - The `Icon` is decorative and hidden from screen readers.
    See also: Form, Section, Card, CheckboxGroup.
*@

<fieldset aria-describedby="@(Description is null ? null : _descriptionId)" @attributes="AdditionalAttributes" class="@_class" style="@_style">
    <legend class="ib-fieldset-legend">@Label</legend>
    @if (Icon is { } icon)
    {
        <span class="ib-fieldset-icon" aria-hidden="true"><Icon Name="icon" /></span>
    }
    @if (Description is not null)
    {
        <p class="ib-fieldset-description" id="@_descriptionId">@Description</p>
    }
    <div class="@_bodyClass" style="@_bodyStyle">
        @ChildContent
    </div>
</fieldset>

@code {
    private readonly string _descriptionId = IdGenerator.Next("ib-fieldset-desc");

    /// <summary>The group's heading. Screen readers announce it with each field in the group.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>
    /// An icon at the start of the heading, centered on the label and description, to tell sections
    /// apart. Decorative. Use icons on the sections or on the rows within them, not both.
    /// </summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>A short explanation under the heading.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Space between the fields, in spacing steps. Defaults to 4.</summary>
    [Parameter] public Responsive<int> Gap { get; set; } = 4;

    /// <summary>
    /// Lays the group's fields out in up to this many columns (1 to 4), by the group's own width,
    /// as <see cref="Form.Columns"/> does. Defaults to 1.
    /// </summary>
    [Parameter] public int Columns { get; set; } = 1;

    /// <summary>
    /// Draws a line between the fields, with the <see cref="Gap"/> above and below it, as in a list
    /// of settings. Each direct child is a row; use it instead of <c>Divider</c>s between them.
    /// Ignored when <see cref="Columns"/> is more than 1.
    /// </summary>
    [Parameter] public bool Dividers { get; set; }

    /// <summary>The fields.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _class;
    private string? _style;
    private string? _bodyClass;
    private string? _bodyStyle;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-fieldset");
        classes.Add("ib-fieldset-cols", Columns > 1);
        classes.Add("ib-fieldset-has-icon", Icon is not null);
        classes.Add("ib-fieldset-dividers", Dividers && Columns <= 1);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        (_class, _style) = BuildRootAttributes();

        // The gap applies to the body that holds the fields, not to the legend.
        var columns = Math.Clamp(Columns, 1, 4);
        var bodyClasses = new ClassBuilder().Add("ib-fieldset-body");
        if (columns > 1)
        {
            bodyClasses.Add("ib-form-grid").Add($"ib-form-grid-{columns}");
        }

        var bodyStyles = new StyleBuilder();
        ApplyResponsive(bodyClasses, bodyStyles, Gap, "ib-gap", "gap", StyleValues.Spacing);
        (_bodyClass, _bodyStyle) = (bodyClasses.Build(), bodyStyles.Build());
    }
}
