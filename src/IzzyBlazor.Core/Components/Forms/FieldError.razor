@namespace IzzyBlazor
@implements IDisposable
@typeparam TValue

@*
    Validation messages for one model property, for fields that are not IzzyBlazor fields.
    IzzyBlazor fields show their own errors.
    <input id="email" @bind="Model.Email" aria-describedby="email-error" aria-invalid="@emailInvalid" />
    <FieldError For="() => Model.Email" Id="email-error" />

    Accessibility:
    - Give it an `Id` and point the control's `aria-describedby` at it, so screen readers read the
      messages with the control; set `aria-invalid` on the control yourself. The element is there
      only while there are messages, and a reference to a missing id is ignored.
    - Messages aren't announced as they appear.
*@

@if (Messages.Count > 0)
{
    <div class="ib-field-error" id="@Id">
        @foreach (var message in Messages)
        {
            <p><Icon Role="IconRole.Error" /> @message</p>
        }
    </div>
}

@code {
    [CascadingParameter] private EditContext? EditContext { get; set; }

    /// <summary>The element's id, for the control's <c>aria-describedby</c>.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>The property whose messages to show.</summary>
    [Parameter, EditorRequired] public System.Linq.Expressions.Expression<Func<TValue>> For { get; set; } = default!;

    private IReadOnlyList<string> Messages =>
        EditContext is null ? [] : EditContext.GetValidationMessages(FieldIdentifier.Create(For)).ToList();

    private EditContext? _subscribed;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, EditContext))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
        }

        _subscribed = EditContext;
        if (_subscribed is not null)
        {
            _subscribed.OnValidationStateChanged += OnValidationStateChanged;
        }
    }

    // Validation runs after this component first renders (on submit), so re-render when it changes.
    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) => StateHasChanged();

    /// <inheritdoc />
    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
        }
    }
}
