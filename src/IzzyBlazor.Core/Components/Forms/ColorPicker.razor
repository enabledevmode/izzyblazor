@namespace IzzyBlazor
@inherits FieldBase<string?>

@*
    A color field bound to a hex string ("#2563eb").
    <ColorPicker @bind-Value="Model.Brand" Presets="@(["#2563eb", "#0f766e", "#be123c"])" />

    Underneath is a native <input type="color">, which posts with the form and works with no
    script: the swatch fills the field and opens the browser's picker (Chrome and Edge offer the
    presets in a menu first). With script the swatch shrinks to the start, a hex text box appears
    beside it, and the presets appear as swatches under the field (the menu is dropped, so the
    swatch opens the picker directly); both write into the native input, so the value posts and
    binds the same way.
*@

<FieldFrame Class="@WrapperClass("color")" Id="@FieldId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ib-color-picker class="ib-color-picker">
        <span class="ib-color-box">
            <input @attributes="ControlAttributes"
                   id="@FieldId"
                   class="ib-color-input"
                   type="color"
                   name="@(ReadOnly ? null : FormName)"
                   @bind="CurrentValueAsString"
                   list="@(HasPresets ? ListId : null)"
                   disabled="@(Disabled || ReadOnly)"
                   aria-invalid="@(Invalid ? "true" : null)"
                   aria-describedby="@DescribedBy" />
            @if (ShowHex)
            {
                <input class="ib-color-hex"
                       type="text"
                       value="@Hex"
                       maxlength="7"
                       spellcheck="false"
                       autocomplete="off"
                       disabled="@Disabled"
                       readonly="@ReadOnly"
                       aria-label="@($"{ResolvedLabel}, {HexLabel ?? TextDefaults.ColorHex}")"
                       aria-describedby="@DescribedBy" />
            }
        </span>
        @if (ReadOnly && FormName is { Length: > 0 } name)
        {
            @* A disabled input doesn't post; read-only fields do. *@
            <input type="hidden" name="@name" value="@Hex" />
        }
        @if (HasPresets)
        {
            <datalist id="@ListId">
                @foreach (var preset in _presets)
                {
                    <option value="@preset"></option>
                }
            </datalist>
            <div class="ib-color-presets" role="group" aria-label="@(PresetsLabel ?? TextDefaults.ColorPresets)">
                @foreach (var preset in _presets)
                {
                    <button type="button" class="ib-color-preset" style="--ib-color-preset:@preset"
                            data-ib-color="@preset" aria-label="@preset" title="@preset"
                            aria-pressed="@(preset == Hex ? "true" : "false")"
                            disabled="@(Disabled || ReadOnly)"></button>
                }
            </div>
        }
    </ib-color-picker>
</FieldFrame>

@code {
    /// <summary>
    /// Colors offered as swatches under the field, as hex strings. Shown with script; without it,
    /// Chrome and Edge list them in the browser's own picker.
    /// </summary>
    [Parameter] public IEnumerable<string>? Presets { get; set; }

    /// <summary>A hex text box beside the swatch (with script), for typing or pasting a value. Defaults to true.</summary>
    [Parameter] public bool ShowHex { get; set; } = true;

    /// <summary>The hex box's name after the label. Defaults to "hex".</summary>
    [Parameter] public string? HexLabel { get; set; }

    /// <summary>The presets' group name. Defaults to "Preset colors".</summary>
    [Parameter] public string? PresetsLabel { get; set; }

    private string[] _presets = [];

    /// <summary>The name the value posts under: Blazor's for the bound field, or a <c>name</c> attribute (a plain GET form).</summary>
    private string? FormName => NameAttributeValue is { Length: > 0 } bound ? bound
        : AdditionalAttributes?.TryGetValue("name", out var n) == true && n is string s && s.Length > 0 ? s : null;

    private bool HasPresets => _presets.Length > 0;

    private string ListId => FieldId + "-presets";

    /// <summary>The value as the native input shows it: black when empty, as the browser does.</summary>
    private string Hex => ColorValues.NormalizeHex(CurrentValue) ?? "#000000";

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _presets = Presets is null ? [] : Presets.Select(ColorValues.NormalizeHex).OfType<string>().Distinct().ToArray();
    }

    /// <inheritdoc />
    protected override string? FormatValueAsString(string? value) => ColorValues.NormalizeHex(value) ?? "#000000";

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }

        if (ColorValues.NormalizeHex(value) is { } hex)
        {
            result = hex;
            validationErrorMessage = null;
            return true;
        }

        result = null;
        validationErrorMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColorInvalid, ResolvedLabel ?? FieldIdentifier.FieldName);
        return false;
    }
}
