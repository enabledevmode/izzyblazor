@namespace IzzyBlazor
@inherits FieldBase<string?>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the browser's own picker stands in for the panel, and there's no hex box (unless it's read-only). It has no opacity: a color with ShowAlpha posts opaque.")]

@*
    A color field bound to a hex string ("#2563eb", or "#2563ebcc" with ShowAlpha).

    A swatch and a hex box. The swatch opens a ColorPanel in a popover: swatches, a picker and
    fields, each optional as on ColorPanel. Changes apply at once; Escape or a click outside
    closes it. With no script, a native <input type="color"> stands in for the swatch, opens the
    browser's picker and posts. UseNative keeps the browser's picker with script too, with the
    swatches under the field.

    Accessibility:
    - The swatch is a button named after the label. Its popover is a dialog named the same, with
      the panel inside (see ColorPanel); focus moves into it on opening and back on closing.
    - The hex box beside it is named after the label and "hex" ("Brand color, hex"; `HexLabel`).
    - The hint and errors are linked to the swatch, the hex box and the panel with
      `aria-describedby`, and they set `aria-invalid` when the field is invalid.
    - Read-only, the swatch is disabled and can't be focused; the hex box is shown, with
      JavaScript off and with `ShowHex` false too, and stays focusable and read-only.
    - With UseNative, the swatch is the browser's color `input`, and the swatches are buttons
      in a group named "Preset colors", each named by SwatchText or its hex value and pressed
      (`aria-pressed`) while it's the value.

    Keyboard:
    On the swatch
    - Enter, Space | Open the panel
    In the panel
    - Escape | Close the panel and go back to the swatch
    - Left, Right, Up, Down, Page Up, Page Down, Home, End | On the area, sliders and swatches, as
      in ColorPanel
    See also: ColorPanel, TextField.
*@

@if (!UseNative)
{
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/color-panel.css"]" />
}
<FieldFrame Class="@WrapperClass("color")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" NoInput="TakesNoInput"
            Hint="@Hint" HintStatus="HintStatus" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ib-color-picker class="@(ShowsReadOnlyHex ? "ib-color-picker ib-color-readonly" : "ib-color-picker")">
        <span class="ib-color-box">
            @if (UseNative)
            {
                <input @attributes="ControlAttributes"
                       id="@FieldId"
                       class="ib-color-input"
                       type="color"
                       name="@(IsReadOnly ? null : FormName)"
                       @bind="CurrentValueAsString"
                       list="@(HasPresets ? ListId : null)"
                       disabled="@(IsDisabled || IsReadOnly)"
                       aria-invalid="@(Invalid ? "true" : null)"
                       aria-describedby="@DescribedBy" />
            }
            else
            {
                @* With no script, the browser's picker, which posts; the script hands posting to the panel. *@
                <input @attributes="ControlAttributes"
                       id="@FieldId"
                       class="ib-color-input"
                       type="color"
                       data-ib-noscript
                       name="@(IsReadOnly ? null : FormName)"
                       value="@Hex"
                       disabled="@(IsDisabled || IsReadOnly)"
                       aria-invalid="@(Invalid ? "true" : null)"
                       aria-describedby="@DescribedBy" />
                <Popover Placement="Placement.BottomStart">
                    <Trigger Context="trigger">
                        <button @attributes="trigger" type="button" class="ib-color-trigger" data-ib-script
                                style="@TriggerStyle" aria-label="@ResolvedLabel" aria-describedby="@DescribedBy"
                                aria-invalid="@(Invalid ? "true" : null)" disabled="@(IsDisabled || IsReadOnly)"></button>
                    </Trigger>
                    <ChildContent>
                        <ColorPanelView Value="@_hex" OnChange="OnPanelChanged" Text="TextDefaults"
                                        ScriptName="@(IsDisabled || IsReadOnly ? null : FormName)"
                                        LabelId="@LabelId" DescribedBy="@DescribedBy" Disabled="IsDisabled" ReadOnly="IsReadOnly" Invalid="Invalid"
                                        Swatches="Swatches" SwatchText="SwatchText" ShowPicker="ShowPicker" ShowAlpha="ShowAlpha" ShowFields="ShowFields"
                                        Clearable="Clearable" ShowEyedropper="ShowEyedropper" />
                    </ChildContent>
                </Popover>
            }
            @if (ShowHex || ShowsReadOnlyHex)
            {
                <input class="ib-color-hex"
                       type="text"
                       value="@(UseNative ? Hex : _hex)"
                       maxlength="@(ShowAlpha && !UseNative ? 9 : 7)"
                       spellcheck="false"
                       autocomplete="off"
                       disabled="@IsDisabled"
                       readonly="@IsReadOnly"
                       aria-label="@($"{ResolvedLabel}, {HexLabel ?? TextDefaults.ColorHex}")"
                       aria-invalid="@(Invalid ? "true" : null)"
                       aria-describedby="@DescribedBy" />
            }
        </span>
        @if (IsReadOnly && !IsDisabled && FormName is { Length: > 0 } name)
        {
            @* A disabled input doesn't post; read-only fields do. *@
            <input type="hidden" name="@name" value="@(UseNative ? Hex : _hex)" />
        }
        @if (HasPresets)
        {
            <datalist id="@ListId">
                @foreach (var preset in _presets)
                {
                    <option value="@preset"></option>
                }
            </datalist>
            <div class="ib-color-presets" role="group" aria-label="@TextDefaults.ColorPresets">
                @foreach (var preset in _presets)
                {
                    var presetName = _presetNames.GetValueOrDefault(preset) ?? preset;
                    <button type="button" class="ib-color-preset" style="--ib-color-preset:@preset"
                            data-ib-color="@preset" aria-label="@presetName" title="@presetName"
                            aria-pressed="@(preset == Hex ? "true" : "false")"
                            disabled="@(IsDisabled || IsReadOnly)"></button>
                }
            </div>
        }
    </ib-color-picker>
</FieldFrame>

@code {
    /// <summary>Makes the field read-only: the hex text can be focused and selected, the swatch is off, and the value still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    /// <summary>
    /// The swatches, as hex strings. In the panel they default to ColorPanel's 21 colors, and an
    /// empty list shows none. With <see cref="UseNative"/> they're under the field (with
    /// script) and in Chrome's and Edge's picker (with none), and default to none.
    /// </summary>
    [Parameter] public IEnumerable<string>? Swatches { get; set; }

    /// <summary>
    /// A name for each swatch, such as "Ocean", given its string from <see cref="Swatches"/>. Screen
    /// readers hear it and it's the tooltip. Defaults to the color's name in the panel ("light
    /// green"), and to the hex value with <see cref="UseNative"/>.
    /// </summary>
    [Parameter] public Func<string, string?>? SwatchText { get; set; }

    /// <summary>The panel's picker: a saturation and brightness area and a hue slider. Defaults to true.</summary>
    [Parameter] public bool ShowPicker { get; set; } = true;

    /// <summary>An opacity slider and field in the panel; a color that isn't opaque is <c>#rrggbbaa</c>. Not with <see cref="UseNative"/>.</summary>
    [Parameter] public bool ShowAlpha { get; set; }

    /// <summary>The panel's hex, red, green and blue fields. Defaults to true.</summary>
    [Parameter] public bool ShowFields { get; set; } = true;

    /// <summary>A "no color" swatch first in the panel, which makes the value null. Not with <see cref="UseNative"/>.</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <summary>An eyedropper button in the panel, shown only in browsers that have one (Chromium).</summary>
    [Parameter] public bool ShowEyedropper { get; set; }

    /// <summary>
    /// Opens the browser's own color picker instead of the panel, with the swatches under the
    /// field. It looks different in each browser and has no opacity.
    /// </summary>
    [Parameter] public bool UseNative { get; set; }

    /// <summary>
    /// A hex text box beside the swatch (with script), for typing or pasting a value. Defaults to
    /// true. A read-only field shows it anyway, as text that can be focused.
    /// </summary>
    [Parameter] public bool ShowHex { get; set; } = true;

    /// <summary>The hex box's name after the label. Defaults to "hex".</summary>
    [Parameter] public string? HexLabel { get; set; }

    private string[] _presets = [];
    private Dictionary<string, string> _presetNames = [];

    // The value as the panel reads it: a color, and its hex ("" for none).
    private ColorPanelMath.Rgba? _rgba;
    private string _hex = "";

    // A read-only field shows its hex box, with no script too: the swatch is disabled, so it's
    // the one part that can be focused.
    private bool ShowsReadOnlyHex => IsReadOnly && !IsDisabled;

    /// <summary>The name the value posts under: Blazor's for the bound field, or a <c>name</c> attribute (a plain GET form).</summary>
    private string? FormName => NameAttributeValue is { Length: > 0 } bound ? bound
        : AdditionalAttributes?.TryGetValue("name", out var n) == true && n is string s && s.Length > 0 ? s : null;

    // Swatches under the field, with UseNative only.
    private bool HasPresets => _presets.Length > 0;

    private string ListId => FieldId + "-presets";

    private string LabelId => FieldId + "-label";

    /// <summary>The value as the native input shows it: opaque, and black when empty, as the browser does.</summary>
    private string Hex => _rgba is { } c ? ColorPanelMath.ToHex(c with { A = 1 }) : "#000000";

    // The swatch's color and opacity, over a checkerboard.
    private string TriggerStyle => $"--ib-color-current: {(_rgba is { } c ? ColorPanelMath.ToHex(c with { A = 1 }) : "transparent")}; " +
        $"--ib-color-alpha: {(_rgba?.A ?? 1).ToString(System.Globalization.CultureInfo.InvariantCulture)}";

    private void OnPanelChanged(string? value) => CurrentValueAsString = value;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _rgba = ColorPanelMath.Parse(CurrentValue);
        if (_rgba is { } color && (UseNative || !ShowAlpha)) _rgba = color with { A = 1 };
        _hex = _rgba is { } rgba ? ColorPanelMath.ToHex(rgba) : "";

        // Read once: the swatches and their names must come from the same list.
        var presets = UseNative ? Swatches?.ToArray() ?? [] : [];
        _presets = presets.Select(ColorValues.NormalizeHex).OfType<string>().Distinct().ToArray();
        _presetNames = [];
        if (SwatchText is not null)
        {
            foreach (var preset in presets)
            {
                if (ColorValues.NormalizeHex(preset) is { } hex && !_presetNames.ContainsKey(hex)
                    && SwatchText(preset) is { } name && !string.IsNullOrWhiteSpace(name))
                {
                    _presetNames[hex] = name;
                }
            }
        }
    }

    /// <inheritdoc />
    protected override string? FormatValueAsString(string? value) => UseNative ? ColorValues.NormalizeHex(value) ?? "#000000" : value;

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, out string? result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            validationErrorMessage = null;
            return true;
        }

        if (ColorPanelMath.Parse(value) is { } color)
        {
            result = ColorPanelMath.ToHex(ShowAlpha && !UseNative ? color : color with { A = 1 });
            validationErrorMessage = null;
            return true;
        }

        result = null;
        validationErrorMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ColorInvalid, ResolvedLabel ?? FieldIdentifier.FieldName);
        return false;
    }
}
