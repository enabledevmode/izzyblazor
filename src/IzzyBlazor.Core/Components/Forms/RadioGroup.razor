@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>
@attribute [ModeSupport]

@*
    A group of radio buttons in a fieldset. Options come from Items, or automatically from an enum.
    <RadioGroup @bind-Value="Model.Contact" Orientation="Orientation.Horizontal" />

    Accessibility:
    - It renders native radio buttons in a `fieldset` whose `legend` is the label, so Tab
      reaches the group and the arrow keys move the choice.
    - Each option's text is its `label`; the hint and errors are linked to the group with
      `aria-describedby`, and each radio sets `aria-invalid` when the field is invalid.
    - A read-only group is a `radiogroup` with `aria-readonly`: the script lets its radios be
      focused but stops a click or arrow key from changing the choice.
    See also: SegmentedControl, Select, CheckboxGroup.
*@

<FieldFrame Class="@WrapperClass("radio")" Style="@WrapperStyle" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" Group
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    @* Read-only radios stay focusable and readable; the group says it's read-only. *@
    <div class="@OptionsClass" role="@(ShowsReadOnly ? "radiogroup" : null)" aria-readonly="@(ShowsReadOnly ? "true" : null)" aria-label="@(ShowsReadOnly ? ResolvedLabel : null)">
        @foreach (var (item, index) in Options.Select((o, i) => (o, i)))
        {
            var value = FormatValueAsString(item);
            var id = $"{FieldId}-{index}";
            <label class="ib-check" for="@id">
                <input @attributes="RadioMessageAttributes"
                       id="@id"
                       class="ib-check-input"
                       type="radio"
                       name="@(ShowsReadOnly ? FieldId : GroupName)"
                       value="@value"
                       checked="@(value == CurrentValueAsString)"
                       @onchange="() => CurrentValue = item"
                       required="@(IsRequired && !ShowsReadOnly)"
                       disabled="@(IsDisabled || ShowsReadOnly)"
                       form="@(ShowsReadOnly ? "" : null)"
                       aria-invalid="@(Invalid ? "true" : null)" />
                <span class="ib-check-label">@TextFor(item)</span>
            </label>
        }
    </div>
    @if (PostsReadOnlyValue)
    {
        @* Read-only: the radios are outside the form (form=""), so this posts the value. *@
        <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString" />
    }
</FieldFrame>

@code {
    /// <summary>The options. Not needed for enums, whose values are listed automatically.</summary>
    [Parameter] public IEnumerable<TValue>? Items { get; set; }

    /// <summary>The text for each option. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    /// <summary>Stack options vertically (the default) or in a row.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    private string OptionsClass => Orientation == Orientation.Horizontal
        ? "ib-radio-options ib-radio-horizontal"
        : "ib-radio-options";

    private IEnumerable<TValue> Options
    {
        get
        {
            if (Items is not null)
            {
                return Items;
            }

            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return type.IsEnum ? Enum.GetValues(type).Cast<object>().Select(v => (TValue)v) : [];
        }
    }

    private string TextFor(TValue item)
    {
        if (ItemText is not null)
        {
            return ItemText(item);
        }

        if (item is Enum e)
        {
            return ChoiceOptions.EnumText(e);
        }

        return item?.ToString() ?? "";
    }
}
