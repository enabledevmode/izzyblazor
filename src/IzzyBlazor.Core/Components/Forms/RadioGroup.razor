@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>
@attribute [ModeSupport]

@*
    A group of radio buttons in a fieldset. Options come from Items, or automatically from an enum.

    Accessibility:
    - It renders native radio buttons in a `fieldset` whose `legend` is the label, so Tab
      reaches the group and the arrow keys move the choice.
    - Each option's text is its `label`; the hint and errors are linked to the group with
      `aria-describedby`, and each radio sets `aria-invalid` when the field is invalid.
    - After a post that fails with an error here, the checked radio (or the first)
      takes focus, so screen readers read the group's name and error (its description); a
      `FormErrors` earlier in the page takes it first. Not on interactive pages: there, use a
      `FormErrors`.
    - With `Chips`, the options look like chips and are still radio buttons, heard as such.
    See also: SegmentedControl, Select, CheckboxGroup.
*@

<FieldFrame Class="@WrapperClass("radio")" Style="@WrapperStyle" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" NoInput="TakesNoInput" Group
            Hint="@Hint" HintStatus="HintStatus" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <div class="@OptionsClass">
        @foreach (var (item, index) in Options.Select((o, i) => (o, i)))
        {
            var value = FormatValueAsString(item);
            var id = $"{FieldId}-{index}";
            var focus = FocusesGroup && index == FocusIndex;
            var description = ItemDescription?.Invoke(item);
            <label class="ib-check" for="@id">
                <input @attributes="RadioMessageAttributes"
                       id="@id"
                       class="ib-check-input"
                       type="radio"
                       name="@GroupName"
                       value="@value"
                       checked="@(value == CurrentValueAsString)"
                       @onchange="() => CurrentValue = item"
                       required="@IsRequired"
                       disabled="@IsDisabled"
                       aria-invalid="@(Invalid ? "true" : null)"
                       autofocus="@focus"
                       data-ib-autofocus="@(focus ? "" : null)"
                       aria-labelledby="@(description is null ? null : $"{id}-text")"
                       aria-describedby="@(description is null ? null : $"{id}-description")" />
                @if (Chips)
                {
                    <Icon Purpose="IconPurpose.Check" />
                }
                <span class="ib-check-label">
                    @if (description is null)
                    {
                        @TextFor(item)
                    }
                    else
                    {
                        @* The name is only the text before the description: the label's whole
                           content would name the radio with the description too. *@
                        <span class="ib-check-text" id="@($"{id}-text")">@TextFor(item)</span>
                        <span class="@(Chips ? "ib-visually-hidden" : "ib-check-description")" id="@($"{id}-description")">@description</span>
                    }
                </span>
            </label>
        }
    </div>
    @if (PostsReadOnlyValue)
    {
        @* In a read-only Form the radios are disabled, so this posts the value. *@
        <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString" />
    }
</FieldFrame>

@code {
    /// <inheritdoc />
    protected override bool TakesReadOnly => false;

    /// <summary>Not available: HTML has no read-only radio. Use <c>Disabled</c>; in a read-only <see cref="Form"/> it's disabled and its value still posts.</summary>
    /// <remarks>Declared only to turn a mistake into a build error; set any other way, it throws.</remarks>
    [Parameter]
    [Obsolete("HTML has no read-only radio. Use Disabled; in a read-only Form it's disabled and its value still posts.", error: true)]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    public bool ReadOnly { get; set; }

    // The radio Tab reaches: the checked one, or else the first.
    private int FocusIndex => Math.Max(0, Options.Select(FormatValueAsString).ToList().IndexOf(CurrentValueAsString));

    /// <summary>The options. Not needed for enums, whose values are listed automatically.</summary>
    [Parameter] public IEnumerable<TValue>? Items { get; set; }

    /// <summary>The text for each option. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    /// <summary>A line under each option's name, such as what choosing it means. Screen readers hear it as the radio's description, after its name. Not shown on a chip; screen readers still hear it.</summary>
    [Parameter] public Func<TValue, string?>? ItemDescription { get; set; }

    /// <summary>Stack options vertically (the default) or in a row. Not used with <see cref="Chips"/>, which wrap in a row.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    /// <summary>
    /// Shows the options as chips in a wrapping row, the chosen one filled with a check. They stay
    /// radio buttons, so posting, keys and what screen readers hear don't change.
    /// </summary>
    [Parameter] public bool Chips { get; set; }

    private string OptionsClass => Chips ? "ib-radio-options ib-chips"
        : Orientation == Orientation.Horizontal ? "ib-radio-options ib-radio-horizontal"
        : "ib-radio-options";

    private IEnumerable<TValue> Options
    {
        get
        {
            if (Items is not null)
            {
                return Items;
            }

            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return type.IsEnum ? Enum.GetValues(type).Cast<object>().Select(v => (TValue)v) : [];
        }
    }


    // A posted value that isn't one of the options is refused on the server: the browser only offers
    // these, but a crafted post can send anything.
    /// <inheritdoc />
    private protected override bool HasOwnRules => true;

    /// <inheritdoc />
    private protected override string? OwnRuleError(TValue value) =>
        Options.Select(FormatValueAsString).ToList() is { Count: > 0 } known && !known.Contains(FormatValueAsString(value))
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.ValueInvalid, ResolvedLabel ?? FieldIdentifier.FieldName)
            : null;

    private string TextFor(TValue item)
    {
        if (ItemText is not null)
        {
            return ItemText(item);
        }

        if (item is Enum e)
        {
            return ChoiceOptions.EnumText(e);
        }

        return item?.ToString() ?? "";
    }
}
