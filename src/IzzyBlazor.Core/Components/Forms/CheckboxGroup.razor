@namespace IzzyBlazor
@typeparam TValue
@typeparam TItem
@inherits FieldBase<TValue>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the SelectAll box isn't shown.")]

@*
    A group of checkboxes for picking several options, bound to a collection: an array,
    List<T>, HashSet<T> or an interface they implement. Both types are inferred, from the bound
    property and from Items; for an enum, pass its values.

    <CheckboxGroup @bind-Value="Model.Toppings" Items="Toppings" />
    <CheckboxGroup @bind-Value="Model.Days" Items="Enum.GetValues<DayOfWeek>()" Orientation="Orientation.Horizontal" />
    <CheckboxGroup @bind-Value="Model.Notify" Items="Topics" SelectAll SelectAllText="Everything" />

    Posting: each checked box posts the field's name with its value, and Blazor binds the
    repeated values to the collection, so it works on static pages with no script.

    SelectAll adds a box above the options that checks or clears them all at once, on static
    pages too: the script flips the options, then fires each one's change, as if clicked. So on an
    interactive page ValueChanged runs once per option it flips. It has no name, so it doesn't
    post. With JavaScript off it isn't shown.

    Accessibility:
    - It renders native checkboxes in a `fieldset` whose `legend` is the label; each box is a
      Tab stop, toggled with Space.
    - Each option's text is its `label`; an `ItemDescription` is the box's description, not part of
      its name. The hint and errors are linked to the group with `aria-describedby`, and each box
      sets `aria-invalid` when the field is invalid.
    - After a post that fails with an error here, the first option
      takes focus, so screen readers read the group's name and error (its description); a
      `FormErrors` earlier in the page takes it first. Not on interactive pages: there, use a
      `FormErrors`.
    - A required group's boxes can't be marked required (HTML can't require one of several), so
      screen readers hear "(required)" after its label instead (`IzzyText.Required`); the
      asterisk is hidden from them. Nothing stops a post with none checked: the server's
      validation reports it.
    - A `SelectAll` box is named by its text, and the options under it are a group with the same
      name, so screen readers hear them as its part. It's announced as "mixed" when only some are
      checked. Its text should say it stands for all of them ("Select all", "All channels").
    See also: MultiSelect, Checkbox, RadioGroup.
*@

<FieldFrame Class="@WrapperClass("checkboxes")" Style="@WrapperStyle" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" AnnounceRequired Group
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    @if (ShowsSelectAll)
    {
        var (all, some) = SelectAllState;
        @* No name: it doesn't post. The script checks or clears the options it controls and
           follows them. *@
        <label class="ib-check ib-check-all" for="@AllId">
            <input id="@AllId"
                   class="ib-check-input"
                   type="checkbox"
                   data-ib-select-all
                   checked="@all"
                   data-indeterminate="@(some ? "" : null)"
                   aria-controls="@OptionIds"
                   disabled="@IsDisabled" />
            <span class="ib-check-label" id="@($"{AllId}-text")">@(string.IsNullOrEmpty(SelectAllText) ? TextDefaults.SelectAll : SelectAllText)</span>
        </label>
    }
    <div class="@OptionsClass" role="@(ShowsSelectAll ? "group" : null)" aria-labelledby="@(ShowsSelectAll ? $"{AllId}-text" : null)">
        @foreach (var (item, index) in ChoiceOptions.Of(Items).Select((o, i) => (o, i)))
        {
            var id = $"{FieldId}-{index}";
            var focus = FocusesGroup && index == 0;
            var description = ItemDescription?.Invoke(item) is { } text && !string.IsNullOrWhiteSpace(text) ? text : null;
            <label class="ib-check" for="@id">
                <input id="@id"
                       class="ib-check-input"
                       type="checkbox"
                       name="@NameAttributeValue"
                       value="@ChoiceOptions.Value(item)"
                       checked="@IsChecked(item)"
                       @onchange="e => Toggle(item, e)"
                       disabled="@IsDisabled"
                       aria-invalid="@(Invalid ? "true" : null)"
                       autofocus="@focus"
                       data-ib-autofocus="@(focus ? "" : null)"
                       aria-labelledby="@(description is null ? null : $"{id}-text")"
                       aria-describedby="@(description is null ? null : $"{id}-description")" />
                <span class="ib-check-label">
                    @if (description is null)
                    {
                        @OptionName(item)
                    }
                    else
                    {
                        @* The name is only the text before the description: the label's whole
                           content would name the box with the description too. *@
                        <span class="ib-check-text" id="@($"{id}-text")">@OptionName(item)</span>
                        <span class="ib-check-description" id="@($"{id}-description")">@description</span>
                    }
                </span>
            </label>
        }
    </div>
    @if (PostsReadOnlyValue)
    {
        @* In a read-only Form the boxes are disabled, so these post the value. *@
        @foreach (var item in ChoiceOptions.Of(Items).Where(IsChecked))
        {
            <input type="hidden" name="@NameAttributeValue" value="@ChoiceOptions.Value(item)" />
        }
    }
</FieldFrame>

@code {
    /// <inheritdoc />
    protected override bool TakesReadOnly => false;

    /// <summary>Not available: HTML has no read-only checkbox. Use <c>Disabled</c>; in a read-only <see cref="Form"/> it's disabled and its value still posts.</summary>
    /// <remarks>Declared only to turn a mistake into a build error; set any other way, it throws.</remarks>
    [Parameter]
    [Obsolete("HTML has no read-only checkbox. Use Disabled; in a read-only Form it's disabled and its value still posts.", error: true)]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    public bool ReadOnly { get; set; }

    private RenderFragment OptionName(TItem item) => ItemTemplate is not null ? ItemTemplate(item) : builder => builder.AddContent(0, ChoiceOptions.Text(item, ItemText));

    /// <summary>The options. For an enum, pass its values: <c>Items="Enum.GetValues&lt;Topping&gt;()"</c>.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>The text for each option. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TItem, string>? ItemText { get; set; }

    /// <summary>Markup for each option's label, such as an icon or a badge beside its name. All of it names the box; put a description in <c>ItemDescription</c>.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>A line under each option's name, such as what choosing it does. Screen readers hear it as the box's description, after its name.</summary>
    [Parameter] public Func<TItem, string?>? ItemDescription { get; set; }

    /// <summary>Stack options vertically (the default) or in a row.</summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Vertical;

    /// <summary>
    /// Adds a box above the options that checks or clears them all at once and shows a dash when
    /// only some are checked. It doesn't post; the options do. It works on static pages through the
    /// script, and isn't shown with JavaScript off. On an interactive page, <c>ValueChanged</c> runs
    /// once for each option it flips, so code that saves on every change sees the steps between.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, NoScriptNotes = "With JavaScript off, the box isn't shown.")]
    public bool SelectAll { get; set; }

    /// <summary>The <see cref="SelectAll"/> box's text. Defaults to <see cref="IzzyText.SelectAll"/> ("Select all"), also when empty.</summary>
    [Parameter] public string? SelectAllText { get; set; }

    private string OptionsClass => new ClassBuilder()
        .Add("ib-radio-options")
        .Add("ib-radio-horizontal", Orientation == Orientation.Horizontal)
        .Add("ib-checks-under-all", ShowsSelectAll)
        .Build()!;

    private bool ShowsSelectAll => SelectAll && ChoiceOptions.Of(Items).Any();

    private string AllId => $"{FieldId}-all";

    private string OptionIds => string.Join(" ", ChoiceOptions.Of(Items).Select((_, i) => $"{FieldId}-{i}"));

    private (bool All, bool Some) SelectAllState
    {
        get
        {
            var options = ChoiceOptions.Of(Items).ToList();
            var count = options.Count(IsChecked);
            var all = count > 0 && count == options.Count;
            return (all, count > 0 && !all);
        }
    }

    private bool IsChecked(TItem item) =>
        ChoiceCollection<TValue, TItem>.Items(CurrentValue).Contains(item);

    private void Toggle(TItem item, ChangeEventArgs e)
    {
        var on = e.Value is true || (e.Value is string text && bool.TryParse(text, out var parsed) && parsed);
        var current = ChoiceCollection<TValue, TItem>.Items(CurrentValue).ToList();
        if (on && !current.Contains(item))
        {
            // Keep the options' order, whatever order they were checked in.
            var order = ChoiceOptions.Of(Items).ToList();
            current.Add(item);
            current = current.OrderBy(i => order.IndexOf(i) is var at && at < 0 ? int.MaxValue : at).ToList();
        }
        else if (!on)
        {
            current.Remove(item);
        }

        CurrentValue = ChoiceCollection<TValue, TItem>.Create(current);
    }
}
