@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the browser's own picker opens in place of the library's list.")]

@*
    A time of day: the browser's own time input, so it posts with the form, checks Min, Max and
    Step before posting and takes a typed time, and the library's list of times to choose from. Bind
    it to TimeOnly or TimeOnly?. For a length of time, as in a timeout, a TimeSpan isn't a time of
    day and doesn't bind here.
    <TimeField @bind-Value="Model.Opens" />
    <TimeField @bind-Value="Model.Opens" Min="@nine" Max="@five" Step="TimeSpan.FromMinutes(15)" />
    <TimeField @bind-Value="Model.Shift" Min="@ten" Max="@six" /> a window across midnight
    <TimeField @bind-Value="Model.Opens" TimeDisabled="t => t.Hour == 12" />
    <TimeField @bind-Value="Model.Opens" UseNative />

    A time has no date or zone, so nothing converts it. The input shows 12 or 24 hours as the browser
    does, which the page can't set; the list follows the page's culture.

    The list has a time every Step, or every 30 minutes with no Step, in which case the input still
    takes any minute. UseNative keeps the browser's picker. So do no script, a Step of seconds, one so
    short the list would pass 288 times, and a phone, unless the field has TimeDisabled, which a
    browser's picker can't show: there it's the library's, and on a phone the input can't be typed in.
    Min, Max and TimeDisabled are checked again on the server.

    Accessibility:
    - It renders the browser's own time `input` with a `label` linked to it: screen readers read
      each part (hour, minute) and arrow keys change it.
    - Label, hint and errors work as in `TextField`.
    - The list's button is named "Choose time" (`ChooseLabel`), or "Change time" and the time once
      there is one. Its panel is a non-modal `dialog`, named by the button, holding a `listbox`, with
      the chosen time selected. Focus goes there, or to the next time from now, and on closing back
      to where it opened from.

    Keyboard:
    In the time field
    - Up, Down | Change the focused part of the time
    - Left, Right | Move between the parts of the time
    - Alt+Down | Open the list
    In the list
    - Up, Down | Move a time
    - Home, End | Go to the first or last time
    - Enter, Space | Choose the time and close
    - Tab, Shift+Tab | Close, and go on from its button
    - Escape | Close without changing the value
    See also: DateField, TextField, Form.
*@

<FieldFrame Class="@WrapperClass("time")" Style="@WrapperStyle" Id="@FieldId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <FieldAddons StartAddon="StartAddon" EndAddon="EndAddon">
        <ib-field-control class="@ControlClass" style="@(HasPanel ? $"anchor-name:{StyleValues.AnchorName(FieldId + "-control")}" : null)">
            <input @attributes="ControlAttributes"
                   id="@FieldId"
                   class="ib-field-input"
                   type="@InputType"
                   name="@NameAttributeValue"
                   @bind="CurrentValueAsString"
                   min="@MinAttribute"
                   max="@FormatLimit(ResolvedMax)"
                   step="@StepAttribute"
                   required="@IsRequired"
                   disabled="@IsDisabled"
                   readonly="@IsReadOnly"
                   aria-invalid="@(Invalid ? "true" : null)"
                   aria-describedby="@DescribedBy" />
            @if (HasPanel)
            {
                <Popover Placement="Placement.BottomStart">
                    <Trigger Context="trigger">
                        <button @attributes="trigger" type="button" class="ib-date-toggle" aria-label="@ChooseText">
                            <Icon Role="IconRole.Clock" Class="ib-field-icon" />
                        </button>
                    </Trigger>
                    <ChildContent>
                        <ib-time-slots class="ib-time-slots"
                                       data-ib-value="@CurrentValueAsString"
                                       data-ib-change="@(ChooseLabel is null ? TextDefaults.TimeChange : null)"
                                       data-ib-choose="@ChooseText">
                            <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/date.css"]" />
                            <div class="ib-time-slots-list" role="listbox" aria-label="@TextDefaults.TimeList">
                                @foreach (var slot in Slots)
                                {
                                    var off = TimeDisabled?.Invoke(slot) == true;
                                    <button type="button" role="option" class="@(off ? "ib-time-slot ib-calendar-off" : "ib-time-slot")" tabindex="-1"
                                            data-value="@slot.ToString("HH:mm", System.Globalization.CultureInfo.InvariantCulture)"
                                            aria-selected="false"
                                            aria-disabled="@(off ? "true" : null)">@slot.ToString("t", System.Globalization.CultureInfo.CurrentCulture)</button>
                                }
                            </div>
                        </ib-time-slots>
                    </ChildContent>
                </Popover>
            }
        </ib-field-control>
    </FieldAddons>
</FieldFrame>

@code {
    /// <summary>Makes the field read-only: it can be focused, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    /// <summary>The earliest time. Defaults to <c>[Range]</c>'s minimum. After <see cref="Max"/>, the allowed times run across midnight.</summary>
    [Parameter] public TimeOnly? Min { get; set; }

    /// <summary>The latest time. Defaults to <c>[Range]</c>'s maximum.</summary>
    [Parameter] public TimeOnly? Max { get; set; }

    /// <summary>
    /// The step between allowed times, counted from <see cref="Min"/>, or from midnight with no Min.
    /// Any minute unless set. A step under a minute shows seconds; otherwise the time shows to the
    /// minute, and seconds in the bound value are dropped when it posts.
    /// </summary>
    [Parameter] public TimeSpan? Step { get; set; }

    /// <summary>Whether a time can't be chosen. Checked on the server too, and called for each time in the list on every render, so keep it cheap.</summary>
    [Parameter] public Func<TimeOnly, bool>? TimeDisabled { get; set; }

    /// <summary>Keeps the browser's picker in place of the library's list. <see cref="TimeDisabled"/> is then checked only on the server.</summary>
    [Parameter] public bool UseNative { get; set; }

    /// <summary>The name of the list's button, in place of "Choose time" and "Change time" with the time.</summary>
    [Parameter] public string? ChooseLabel { get; set; }

    /// <summary>Content attached before the control, outside its border. See <see cref="TextField.StartAddon"/>.</summary>
    [Parameter] public RenderFragment? StartAddon { get; set; }

    /// <summary>Content attached after the control, outside its border.</summary>
    [Parameter] public RenderFragment? EndAddon { get; set; }

    // A list past this would be a long way to scroll, and a lot to draw for each field.
    private const int MostSlots = 288;

    private string ChooseText => ChooseLabel ?? TextDefaults.TimeChoose;

    private bool HasPanel => !UseNative && !IsDisabled && !IsReadOnly && !ShowsSeconds && Slots.Count > 0;

    // A field whose rule a browser's picker can't show keeps the library's on a phone too.
    private string ControlClass => new ClassBuilder()
        .Add("ib-field-control")
        .Add("ib-date-control", HasPanel)
        .Add("ib-date-own", HasPanel && TimeDisabled is not null)
        .Build()!;

    // From Min, or midnight, every Step to Max, or the end of the day. With Min after Max, across
    // midnight. None if there would be too many, as the browser's picker serves those better.
    private List<TimeOnly> Slots
    {
        get
        {
            if (_slots is not null && _slotsFor == (ResolvedMin, ResolvedMax, Step))
            {
                return _slots;
            }

            var step = Step ?? TimeSpan.FromMinutes(30);
            var slots = new List<TimeOnly>();
            if (step >= TimeSpan.FromMinutes(1))
            {
                // A list holds whole minutes, so a Min with seconds starts at the next one.
                var first = TimeSpan.FromMinutes(Math.Ceiling((ResolvedMin ?? TimeOnly.MinValue).ToTimeSpan().TotalMinutes));
                var last = (ResolvedMax ?? new TimeOnly(23, 59, 59)).ToTimeSpan();
                if (last < first)
                {
                    last += TimeSpan.FromDays(1);
                }

                var count = (last - first).Ticks / step.Ticks + 1;
                for (var index = 0; index < count && count <= MostSlots; index++)
                {
                    slots.Add(TimeOnly.FromTimeSpan(TimeSpan.FromTicks((first + step * index).Ticks % TimeSpan.TicksPerDay)));
                }
            }

            _slotsFor = (ResolvedMin, ResolvedMax, Step);
            return _slots = slots;
        }
    }

    private List<TimeOnly>? _slots;
    private (TimeOnly?, TimeOnly?, TimeSpan?) _slotsFor;

    // Not written in the markup: there, Razor makes @bind format a time, and it binds text.
    private const string InputType = "time";

    private System.ComponentModel.DataAnnotations.RangeAttribute? Range =>
        Attribute<System.ComponentModel.DataAnnotations.RangeAttribute>();

    private TimeOnly? ResolvedMin => Min ?? Annotated(Range?.Minimum);

    private TimeOnly? ResolvedMax => Max ?? Annotated(Range?.Maximum);

    private bool ShowsSeconds => Step is { } step && step.Ticks % TimeSpan.TicksPerMinute != 0;

    // A browser counts steps from min, or else from the value it was drawn with, so a value off the
    // step would move them: midnight holds them where Step says.
    private string? MinAttribute => FormatLimit(ResolvedMin ?? (Step is null ? null : TimeOnly.MinValue));

    private string? StepAttribute => Step is { } step
        ? Math.Max(1, (long)Math.Round(step.TotalSeconds)).ToString(System.Globalization.CultureInfo.InvariantCulture)
        : null;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if ((Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue)) != typeof(TimeOnly))
        {
            throw new InvalidOperationException($"TimeField doesn't support {typeof(TValue)}. Bind it to TimeOnly or TimeOnly?.");
        }

        base.OnParametersSet();
    }

    /// <inheritdoc />
    private protected override bool HasOwnRules => Min is not null || Max is not null || TimeDisabled is not null;

    // As the input shows the time.
    /// <inheritdoc />
    private protected override string? OwnRuleError(TValue value)
    {
        var time = (TimeOnly)(object)value!;
        var shown = ShowsSeconds ? time : new TimeOnly(time.Hour, time.Minute);
        var culture = System.Globalization.CultureInfo.CurrentCulture;
        string Said(TimeOnly limit) => limit.ToString(HasSeconds(limit) ? "T" : "t", culture);
        if (TimeDisabled?.Invoke(shown) == true)
        {
            return string.Format(culture, TextDefaults.DateUnavailable, ResolvedLabel, Said(shown));
        }

        return (Min, Max) switch
        {
            ({ } min, { } max) when min > max => shown >= min || shown <= max
                ? null
                : string.Format(culture, TextDefaults.TimeOutsideWindow, ResolvedLabel, Said(min), Said(max)),
            ({ } min, _) when shown < min => string.Format(culture, TextDefaults.TooEarly, ResolvedLabel, Said(min)),
            (_, { } max) when shown > max => string.Format(culture, TextDefaults.TooLate, ResolvedLabel, Said(max)),
            _ => null,
        };
    }

    /// <inheritdoc />
    protected override string? FormatValueAsString(TValue? value) =>
        value is TimeOnly time ? time.ToString(ShowsSeconds ? "HH:mm:ss" : "HH:mm", System.Globalization.CultureInfo.InvariantCulture) : null;

    /// <inheritdoc />
    protected override bool TryParseValueFromString(string? value, [System.Diagnostics.CodeAnalysis.MaybeNullWhen(false)] out TValue result, [System.Diagnostics.CodeAnalysis.NotNullWhen(false)] out string? validationErrorMessage)
    {
        validationErrorMessage = null;
        result = default!;
        if (string.IsNullOrWhiteSpace(value))
        {
            if (Nullable.GetUnderlyingType(typeof(TValue)) is not null)
            {
                return true;
            }
        }
        else if (TimeOnly.TryParseExact(value.Trim(), InputFormats, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var time))
        {
            result = (TValue)(object)time;
            return true;
        }

        validationErrorMessage = string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.TimeInvalid, ResolvedLabel ?? FieldIdentifier.FieldName);
        return false;
    }

    private static bool HasSeconds(TimeOnly time) => time.Ticks % TimeSpan.TicksPerMinute != 0;

    private static string? FormatLimit(TimeOnly? limit) =>
        limit?.ToString(HasSeconds(limit.Value) ? "HH:mm:ss" : "HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    // [Range]'s end: text from Range(typeof(TimeOnly), "09:00", "17:00").
    private static TimeOnly? Annotated(object? end) => end switch
    {
        TimeOnly time => time,
        string text when TimeOnly.TryParse(text, System.Globalization.CultureInfo.InvariantCulture, out var time) => time,
        _ => null,
    };

    // What time inputs post.
    private static readonly string[] InputFormats = ["HH:mm", "HH:mm:ss", "HH:mm:ss.FFFFFFF"];
}
