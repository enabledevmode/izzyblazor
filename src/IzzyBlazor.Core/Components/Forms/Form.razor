@namespace IzzyBlazor
@inherits LayoutItemBase

@*
    A styled EditForm. Works three ways:
      - Static page, no JavaScript: a real POST, validated on the server, re-rendered with errors.
      - Static page with JavaScript: Blazor's enhanced form handling (no full reload), native
        browser validation before posting, and a loading state on the submit button.
      - Interactive page: EditForm validation as usual.
*@

@* Pass Model or EditContext, never both: EditForm's EditContext setter stores the value it's given,
   so passing null on every render replaced its EditContext each time, and a new EditContext
   makes EditForm rebuild everything inside it (losing focus on interactive pages). *@
@if (EditContext is not null)
{
    <EditForm EditContext="EditContext"
              FormName="@FormName"
              Enhance="Enhance"
              OnValidSubmit="OnValidSubmit"
              OnInvalidSubmit="OnInvalidSubmit"
              OnSubmit="OnSubmit"
              novalidate="@(NativeValidation && !_hasTabs ? null : "novalidate")"
              data-ib-validate="@(NativeValidation && _hasTabs ? "" : null)"
              enctype="@(Multipart ? "multipart/form-data" : null)"
              @attributes="AdditionalAttributes"
              class="@_class"
              style="@_style">
        @Body
    </EditForm>
}
else
{
    <EditForm Model="Model"
              FormName="@FormName"
              Enhance="Enhance"
              OnValidSubmit="OnValidSubmit"
              OnInvalidSubmit="OnInvalidSubmit"
              OnSubmit="OnSubmit"
              novalidate="@(NativeValidation && !_hasTabs ? null : "novalidate")"
              data-ib-validate="@(NativeValidation && _hasTabs ? "" : null)"
              enctype="@(Multipart ? "multipart/form-data" : null)"
              @attributes="AdditionalAttributes"
              class="@_class"
              style="@_style">
        @Body
    </EditForm>
}

@code {
    /// <summary>The object the form edits. Set this or <see cref="EditContext"/>.</summary>
    [Parameter] public object? Model { get; set; }

    /// <summary>An explicit edit context. Set this or <see cref="Model"/>.</summary>
    [Parameter] public EditContext? EditContext { get; set; }

    /// <summary>
    /// The form's name. Required on static pages, where it tells Blazor which form a POST belongs to;
    /// pair it with <c>[SupplyParameterFromForm(FormName = "...")]</c> on the model property.
    /// </summary>
    [Parameter] public string? FormName { get; set; }

    /// <summary>
    /// Posts as <c>multipart/form-data</c>, which a <see cref="FileUpload"/> needs to send its files on
    /// static pages. Without it, a post sends only the file names.
    /// </summary>
    [Parameter] public bool Multipart { get; set; }

    /// <summary>Uses Blazor's enhanced form handling on static pages (no full page reload). Defaults to true.</summary>
    [Parameter] public bool Enhance { get; set; } = true;

    /// <summary>Lets the browser check required fields, lengths and formats before posting. Defaults to true.</summary>
    [Parameter] public bool NativeValidation { get; set; } = true;

    /// <summary>Runs on the server after a submit that passes validation.</summary>
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }

    /// <summary>Runs on the server after a submit that fails validation.</summary>
    [Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }

    /// <summary>Runs on every submit, instead of the valid and invalid callbacks. You validate yourself.</summary>
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; }

    /// <summary>Replaces the default DataAnnotations validator, for example with a FluentValidation one.</summary>
    [Parameter] public RenderFragment? Validator { get; set; }

    /// <summary>How labels sit next to fields. Defaults to stacked.</summary>
    [Parameter] public FormLayout Layout { get; set; } = FormLayout.Vertical;

    /// <summary>Space between fields, in spacing steps. Defaults to 5.</summary>
    [Parameter] public Responsive<int> Gap { get; set; } = 5;

    /// <summary>
    /// Lays the fields out in up to this many columns (1 to 4). Defaults to 1. The form shows fewer
    /// when it's narrow, by its own width rather than the screen's, so the same form fits a page, a
    /// dialog and a drawer: two columns from 32rem, three from 48rem, four from 64rem. Fields take
    /// one column and anything else (text, errors, buttons, a Fieldset) the whole row; set
    /// <c>ColSpan</c> to change either.
    /// </summary>
    [Parameter] public int Columns { get; set; } = 1;

    /// <summary>
    /// Disables every field in the form. Disabled fields can't be changed or focused and aren't
    /// posted. Buttons are left as they are.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Makes every field read-only: shown and posted, but not changed, as on a page that shows a
    /// record before editing it. Selects, checkboxes, radios and switches can't be read-only in
    /// HTML, so they're disabled and their values are posted from hidden inputs.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Which fields are marked beside their labels: <see cref="RequiredMark.Required"/> (an asterisk
    /// on required fields, the default), <see cref="RequiredMark.Optional"/> ("(optional)" on the
    /// others) or <see cref="RequiredMark.None"/>. Whether a field is required still comes from
    /// <c>[Required]</c> or its own <c>Required</c>.
    /// </summary>
    [Parameter] public RequiredMark RequiredMark { get; set; } = RequiredMark.Required;

    /// <summary>The fields and buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _class;
    private string? _style;
    private string? _gridClass;
    private string? _gridStyle;
    private FormOptions _options = new(false, false, RequiredMark.Required);

    private int ColumnCount => Math.Clamp(Columns, 1, 4);

    private RenderFragment Body => __builder =>
    {
        if (Validator is null)
        {
            <DataAnnotationsValidator />
        }
        else
        {
            @Validator
        }

        <CascadingValue Value="this" IsFixed="true">
        <CascadingValue Value="_options">
            @if (ColumnCount > 1)
            {
                @* The form is the container the columns measure; an element can't query its own width. *@
                <div class="@_gridClass" style="@_gridStyle">
                    @ChildContent
                </div>
            }
            else
            {
                @ChildContent
            }
        </CascadingValue>
        </CascadingValue>
    };

    private bool _hasTabs;

    /// <summary>
    /// Called by a Tabs inside the form. The browser's own check can't focus a field in a closed
    /// tab and blocks the submit with no message, so the form renders <c>novalidate</c>: with
    /// JavaScript off the server checks it, and the script runs the browser's check itself and
    /// opens the tab of the first invalid field (<c>data-ib-validate</c>).
    /// </summary>
    internal void ContainsTabs()
    {
        if (!_hasTabs)
        {
            _hasTabs = true;
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-form");
        base.BuildAttributes(classes, styles);

        classes.Add("ib-form-horizontal", Layout == FormLayout.Horizontal);
        if (ColumnCount > 1)
        {
            classes.Add("ib-form-cols");
        }
        else
        {
            ApplyResponsive(classes, styles, Gap, "ib-gap", "gap", StyleValues.Spacing);
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        (_class, _style) = BuildRootAttributes();

        // Keep the same instance while nothing changed (fields read it on their own renders).
        var options = new FormOptions(Disabled, ReadOnly, RequiredMark);
        if (options != _options)
        {
            _options = options;
        }

        (_gridClass, _gridStyle) = (null, null);
        if (ColumnCount > 1)
        {
            var gridClasses = new ClassBuilder().Add("ib-form-grid").Add($"ib-form-grid-{ColumnCount}");
            var gridStyles = new StyleBuilder();
            ApplyResponsive(gridClasses, gridStyles, Gap, "ib-gap", "gap", StyleValues.Spacing);
            (_gridClass, _gridStyle) = (gridClasses.Build(), gridStyles.Build());
        }
    }
}
