@namespace IzzyBlazor
@inherits LayoutItemBase
@attribute [ModeSupport]

@*
    A styled EditForm. Works three ways:
      - Static page, no JavaScript: a real POST, validated on the server, re-rendered with errors.
      - Static page with JavaScript: Blazor's enhanced form handling (no full reload), native
        browser validation before posting, and a loading state on the submit button. A field's
        errors from the last post go once its value changes (a form reset brings them back), and
        the next post checks it again; a FormErrors summary keeps them.
      - Interactive page: EditForm validation as usual.
    On a static page, a field that throws while rendering is replaced with an ErrorGuard message
    inside the form, so the rest of the page still loads.

    Accessibility:
    - It renders a native `form`. With `NativeValidation` (the default), the browser stops a submit
      with a missing or malformed value, focuses that field and shows its own message.
    - Each field links its errors with `aria-describedby` and sets `aria-invalid`; errors aren't
      announced as they appear.
    - Place a `FormErrors` at the top: it takes focus after a submit that fails validation, with
      JavaScript off too, and screen readers read its title and messages then (it isn't also a
      live region, which would read it twice). Form moves no focus itself. On static pages a
      CheckboxGroup, RadioGroup or SegmentedControl with an error takes focus after the post too
      (its error belongs to the group, so no one box reads it); whichever of these comes first
      on the page keeps it.
    - The summary's messages are plain text, not links to their fields.
    - `RequiredMark` changes only what's shown: the asterisk is hidden from screen readers, which
      hear "required" from the control, and "(optional)" is read with the label.
    - `Disabled` fields can't be focused. With `ReadOnly`, text fields stay focusable and are
      announced as read only; checkboxes, switches, radios, segments and sliders are disabled.
    See also: Fieldset, TextField, Button, Alert.
*@

@* Pass Model or EditContext, never both: EditForm's EditContext setter stores the value it's given,
   so passing null on every render replaced its EditContext each time, and a new EditContext
   makes EditForm rebuild everything inside it (losing focus on interactive pages). *@
@if (EditContext is not null)
{
    <EditForm EditContext="EditContext"
              FormName="@FormName"
              Enhance="Enhance"
              OnSubmit="Dispatch"
              novalidate="@(NativeValidation ? null : "novalidate")"
              enctype="@Enctype"
              @attributes="AdditionalAttributes"
              id="@FormId"
              class="@_class"
              style="@_style">
        @Body
        @if (ConfirmLeave)
        {
            @LeaveGuard(context)
        }
    </EditForm>
}
else
{
    <EditForm Model="Model"
              FormName="@FormName"
              Enhance="Enhance"
              OnSubmit="Dispatch"
              novalidate="@(NativeValidation ? null : "novalidate")"
              enctype="@Enctype"
              @attributes="AdditionalAttributes"
              id="@FormId"
              class="@_class"
              style="@_style">
        @Body
        @if (ConfirmLeave)
        {
            @LeaveGuard(context)
        }
    </EditForm>
}

@code {
    /// <summary>The object the form edits. Set this or <see cref="EditContext"/>.</summary>
    [Parameter] public object? Model { get; set; }

    /// <summary>An explicit edit context. Set this or <see cref="Model"/>.</summary>
    [Parameter] public EditContext? EditContext { get; set; }

    /// <summary>
    /// The form's name. Required on static pages, where it tells Blazor which form a POST belongs to;
    /// pair it with <c>[SupplyParameterFromForm(FormName = "...")]</c> on the model property.
    /// </summary>
    [Parameter] public string? FormName { get; set; }

    /// <summary>
    /// Posts as <c>multipart/form-data</c>, which sends files on static pages. A form with a
    /// <see cref="FileUpload"/> in it does so by itself; set it for a file input of your own.
    /// </summary>
    [Parameter] public bool Multipart { get; set; }

    /// <summary>Uses Blazor's enhanced form handling on static pages (no full page reload). Defaults to true.</summary>
    [Parameter] public bool Enhance { get; set; } = true;

    /// <summary>Lets the browser check required fields, lengths and formats before posting. Defaults to true.</summary>
    [Parameter] public bool NativeValidation { get; set; } = true;

    /// <summary>Runs on the server after a submit that passes validation.</summary>
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }

    /// <summary>Runs on the server after a submit that fails validation.</summary>
    [Parameter] public EventCallback<EditContext> OnInvalidSubmit { get; set; }

    /// <summary>Runs on every submit, instead of the valid and invalid callbacks. You validate yourself.</summary>
    [Parameter] public EventCallback<EditContext> OnSubmit { get; set; }

    /// <summary>Replaces the default DataAnnotations validator, for example with a FluentValidation one.</summary>
    [Parameter] public RenderFragment? Validator { get; set; }

    /// <summary>How labels sit next to fields. Defaults to stacked.</summary>
    [Parameter] public FormLayout Layout { get; set; } = FormLayout.Vertical;

    /// <summary>Space between fields, in spacing steps. Defaults to 5.</summary>
    [Parameter] public Responsive<int> Gap { get; set; } = 5;

    /// <summary>
    /// Lays the fields out in up to this many columns (1 to 4). Defaults to 1. The form shows fewer
    /// when it's narrow, by its own width rather than the screen's, so the same form fits a page, a
    /// dialog and a drawer: two columns from 32rem, three from 48rem, four from 64rem. Fields take
    /// one column and anything else (text, errors, buttons, a Fieldset) the whole row; set
    /// <c>ColSpan</c> to change either.
    /// </summary>
    [Parameter] public int Columns { get; set; } = 1;

    /// <summary>
    /// Disables every field in the form. Disabled fields can't be changed or focused and aren't
    /// posted. Buttons are left as they are.
    /// </summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Makes every field read-only: shown and posted, but not changed, as on a page that shows a
    /// record before editing it. HTML has no read-only select, checkbox, radio or range, so a
    /// read-only Select, Combobox or MultiSelect shows its value in a read-only text field, and
    /// checkboxes, switches, radios, segments and sliders are disabled; their values post from
    /// hidden inputs.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Which fields are marked beside their labels: <see cref="RequiredMark.Required"/> (an asterisk
    /// on required fields, the default), <see cref="RequiredMark.Optional"/> ("(optional)" on the
    /// others) or <see cref="RequiredMark.None"/>. Whether a field is required still comes from
    /// <c>[Required]</c> or its own <c>Required</c>. A read-only or disabled field gets neither mark.
    /// </summary>
    [Parameter] public RequiredMark RequiredMark { get; set; } = RequiredMark.Required;

    /// <summary>
    /// Asks before the user leaves the page with unsaved changes: following a link, posting another
    /// form, reloading or closing the tab. Links and forms open a dialog ("Leave this page?");
    /// reload and close show the browser's own prompt, whose text can't be changed. On interactive
    /// pages <c>NavigationManager.NavigateTo</c> asks too, and so do the back and forward buttons when
    /// the whole app is interactive. Needs JavaScript. Back and forward can't be stopped under
    /// enhanced navigation, so they don't ask on static pages or interactive parts of them.
    /// </summary>
    /// <remarks>
    /// On a static page the form's values are compared with those it had when the user first
    /// touched it, so typing a value back makes it saved again; a post that fails validation comes
    /// back unsaved. On an interactive page it's <c>EditContext.IsModified()</c>, cleared after
    /// <see cref="OnValidSubmit"/> finishes; with <see cref="OnSubmit"/>, call
    /// <c>EditContext.MarkAsUnmodified()</c> once you've saved. The text comes from
    /// <see cref="IzzyText"/>: <c>LeaveTitle</c>, <c>LeaveMessage</c>, <c>Leave</c> and <c>Stay</c>.
    /// </remarks>
    [Parameter] public bool ConfirmLeave { get; set; }

    /// <summary>
    /// Adds a field bots fill and people never see. A post with it filled skips
    /// <see cref="OnValidSubmit"/> (and <see cref="OnSubmit"/>) and calls <see cref="OnSpam"/>
    /// instead, so nothing is saved. Checked on static pages, where bots post; an interactive page
    /// never posts the field.
    /// </summary>
    [Parameter] public bool Honeypot { get; set; }

    /// <summary>
    /// Called in place of <see cref="OnValidSubmit"/> when a bot filled the <see cref="Honeypot"/>.
    /// Answer it as you answer a person, such as with the same redirect, so a bot can't tell it
    /// was caught.
    /// </summary>
    [Parameter] public EventCallback<EditContext> OnSpam { get; set; }

    /// <summary>The fields and buttons.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _class;
    private string? _style;
    private string? _gridClass;
    private string? _gridStyle;
    private FormOptions _options = new(false, false, RequiredMark.Required);

    private int ColumnCount => Math.Clamp(Columns, 1, 4);

    // In a dialog the form has an id: the dialog draws a DialogFooter outside the form, and the
    // footer's submit button names its form by it.
    [CascadingParameter] private DialogContext? InDialog { get; set; }

    private FormOwner? _ownerValue;

    private FormOwner _owner
    {
        get => _ownerValue ??= new FormOwner(null) { HasFiles = HasFiles };
        set => _ownerValue = value;
    }

    // A FileUpload inside says so as it starts, and the form posts multipart from then on.
    private bool _hasFiles;

    // Always written, the default included: a FileUpload turns it to multipart after the form's first render, and
    // an attribute that only changes its value leaves the form's named submit event where it is (one that
    // appears moves it, and a static page then finds the form's name twice).
    private string Enctype => Multipart || _hasFiles ? "multipart/form-data" : "application/x-www-form-urlencoded";

    private void HasFiles()
    {
        if (_hasFiles) return;
        _hasFiles = true;
        StateHasChanged();
    }

    private string? FormId => AdditionalAttributes?.TryGetValue("id", out var id) == true ? id as string : _owner.Id;

    // OnValidSubmit, then (with ConfirmLeave, on an interactive page) the form counts as saved; a
    // filled honeypot goes to OnSpam instead.
    private EventCallback<EditContext> ValidSubmit =>
        (ConfirmLeave || Honeypot) && OnValidSubmit.HasDelegate ? _validSubmit ??= EventCallback.Factory.Create<EditContext>(this, SubmitValid) : OnValidSubmit;

    private EventCallback<EditContext>? _validSubmit;

    // OnSubmit, or OnSpam for a filled honeypot. Wrapped only when set: EditForm takes OnSubmit or OnValidSubmit, not both.
    private EventCallback<EditContext> Submit =>
        Honeypot && OnSubmit.HasDelegate ? _submit ??= EventCallback.Factory.Create<EditContext>(this, SubmitAny) : OnSubmit;

    private EventCallback<EditContext>? _submit;

    // Set from the post by the honeypot field, before the submit's handlers run.
    private bool _spam;

    private Task SubmitAny(EditContext context) => Honeypot && _spam ? OnSpam.InvokeAsync(context) : OnSubmit.InvokeAsync(context);

    // Set from the post when a FieldRepeater's Add or Remove sent it: the post only redraws the rows.
    private bool _repeat;

    // Every submit comes here, as EditForm would run it: OnSubmit as is, else validation then OnValidSubmit or
    // OnInvalidSubmit. A FieldRepeater's Add or Remove post does neither: it keeps what was typed and redraws.
    private async Task Dispatch(EditContext context)
    {
        if (_repeat)
        {
            return;
        }

        // A static post: an optional text field left empty is no value, so [Phone] or [Url] accepts a blank.
        if (!RendererInfo.IsInteractive)
        {
            PostedText.EmptyIsNoValue(context.Model);
        }

        if (OnSubmit.HasDelegate)
        {
            await Submit.InvokeAsync(context);
        }
        else if (context.Validate())
        {
            await ValidSubmit.InvokeAsync(context);
        }
        else
        {
            await OnInvalidSubmit.InvokeAsync(context);
        }
    }

    private async Task SubmitValid(EditContext context)
    {
        if (Honeypot && _spam)
        {
            await OnSpam.InvokeAsync(context);
            return;
        }

        await OnValidSubmit.InvokeAsync(context);
        if (RendererInfo.IsInteractive)
        {
            context.MarkAsUnmodified();
        }
    }

    private RenderFragment Body => builder =>
    {
        if (!string.IsNullOrEmpty(FormName))
        {
            builder.OpenComponent<FormNamedErrors>(0);
            builder.AddComponentParameter(1, nameof(FormNamedErrors.FormName), FormName);
            builder.CloseComponent();
        }

        if (Honeypot)
        {
            builder.OpenComponent<FormHoneypot>(2);
            builder.AddComponentParameter(3, nameof(FormHoneypot.Label), TextDefaults.HoneypotLabel);
            builder.AddComponentParameter(4, nameof(FormHoneypot.Report), _report ??= filled => _spam = filled);
            builder.CloseComponent();
        }

        // A FieldRepeater's Add or Remove post (static pages; on an interactive page nothing posts it).
        builder.OpenComponent<FormRepeatCommand>(5);
        builder.AddComponentParameter(6, nameof(FormRepeatCommand.Report), _reportRepeat ??= posted => _repeat = posted);
        builder.CloseComponent();

        // On a static page a field that throws is caught here, inside the form, so the form and its named
        // submit event stay. Caught by a guard outside the form, the error fails the whole request: the
        // renderer still processes the named event of the form it just removed (an ASP.NET Core bug:
        // https://github.com/dotnet/aspnetcore/issues/70640).
        if (RendererInfo.IsInteractive)
        {
            builder.AddContent(7, Fields);
        }
        else
        {
            builder.OpenComponent<ErrorGuard>(8);
            builder.AddComponentParameter(9, nameof(ErrorGuard.ChildContent), Fields);
            builder.CloseComponent();
        }
    };

    private Action<bool>? _report;
    private Action<bool>? _reportRepeat;

    private static RenderFragment LeaveGuard(EditContext context) => builder =>
    {
        builder.OpenComponent<FormLeaveGuard>(0);
        builder.AddComponentParameter(1, nameof(FormLeaveGuard.EditContext), context);
        builder.CloseComponent();
    };

    private RenderFragment Fields => __builder =>
    {
        if (Validator is null)
        {
            <DataAnnotationsValidator />
        }
        else
        {
            @Validator
        }

        <CascadingValue Value="_owner" IsFixed="true">
        <CascadingValue Value="_options">
            @if (ColumnCount > 1)
            {
                @* The form is the container the columns measure; an element can't query its own width. *@
                <div class="@_gridClass" style="@_gridStyle">
                    @ChildContent
                </div>
            }
            else
            {
                @ChildContent
            }
        </CascadingValue>
        </CascadingValue>
    };

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-form");
        base.BuildAttributes(classes, styles);

        classes.Add("ib-form-horizontal", Layout == FormLayout.Horizontal);
        if (ColumnCount > 1)
        {
            classes.Add("ib-form-cols");
        }
        else
        {
            ApplyResponsive(classes, styles, Gap, "ib-gap", "gap", StyleValues.Spacing);
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        (_class, _style) = BuildRootAttributes();

        if (_owner.Id is null && InDialog is not null)
        {
            _owner = new FormOwner(AdditionalAttributes?.TryGetValue("id", out var id) == true && id is string given ? given : IdGenerator.Next("ib-form")) { HasFiles = HasFiles };
        }

        // Keep the same instance while nothing changed (fields read it on their own renders).
        var options = new FormOptions(Disabled, ReadOnly, RequiredMark);
        if (options != _options)
        {
            _options = options;
        }

        (_gridClass, _gridStyle) = (null, null);
        if (ColumnCount > 1)
        {
            var gridClasses = new ClassBuilder().Add("ib-form-grid").Add($"ib-form-grid-{ColumnCount}");
            var gridStyles = new StyleBuilder();
            ApplyResponsive(gridClasses, gridStyles, Gap, "ib-gap", "gap", StyleValues.Spacing);
            (_gridClass, _gridStyle) = (gridClasses.Build(), gridStyles.Build());
        }
    }
}
