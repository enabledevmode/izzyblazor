@namespace IzzyBlazor
@typeparam TValue
@inherits FieldBase<TValue>
@attribute [ModeSupport]

@*
    One choice from a few, as a row of joined buttons: real radio buttons in a fieldset, styled as
    segments. Posts like a RadioGroup, arrow keys move between options, and it works with
    JavaScript off. Options come from Items, or automatically from an enum.

    <SegmentedControl @bind-Value="Model.View" HideLabel />
    <SegmentedControl @bind-Value="Model.Align" ItemIcon="AlignIcon" IconOnly />

    Accessibility:
    - Screen readers hear a radio group: a `fieldset` named by its `legend`, with a native radio
      in each segment, so Tab reaches the group and the arrow keys move the choice.
    - The focus ring is drawn around the focused segment.
    - After a post that fails with an error here, the checked segment (or the first)
      takes focus, so screen readers read the group's name and error (its description); a
      `FormErrors` earlier in the page takes it first. Not on interactive pages: there, use a
      `FormErrors`.
    - With `IconOnly`, each option's text stays for screen readers and shows as its hover
      tooltip.
    - A field with no visible label needs `HideLabel`, not an empty label, so the group keeps
      its name.
    See also: RadioGroup, Tabs, Switch, ButtonGroup.
*@

<FieldFrame Class="@WrapperClass("segmented")" Style="@WrapperStyle" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired" Group
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <div class="@SegmentsClass">
        @foreach (var (item, index) in Options.Select((o, i) => (o, i)))
        {
            var value = FormatValueAsString(item);
            var id = $"{FieldId}-{index}";
            var focus = FocusesGroup && index == FocusIndex;
            var text = TextFor(item);
            var icon = ItemIcon?.Invoke(item);
            <label class="ib-segment" for="@id" title="@(IconOnly ? text : null)">
                <input @attributes="RadioMessageAttributes"
                       id="@id"
                       class="ib-segment-input"
                       type="radio"
                       name="@GroupName"
                       value="@value"
                       checked="@(value == CurrentValueAsString)"
                       @onchange="() => CurrentValue = item"
                       required="@IsRequired"
                       disabled="@IsDisabled"
                       aria-invalid="@(Invalid ? "true" : null)"
                       autofocus="@focus"
                       data-ib-autofocus="@(focus ? "" : null)" />
                @if (icon is not null)
                {
                    <Icon Name="icon" />
                }
                <span class="@(IconOnly && icon is not null ? "ib-visually-hidden" : "ib-segment-label")">@text</span>
            </label>
        }
    </div>
    @if (PostsReadOnlyValue)
    {
        @* In a read-only Form the radios are disabled, so this posts the value. *@
        <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString" />
    }
</FieldFrame>

@code {
    /// <inheritdoc />
    protected override bool TakesReadOnly => false;

    /// <summary>Not available: HTML has no read-only radio. Use <c>Disabled</c>; in a read-only <see cref="Form"/> it's disabled and its value still posts.</summary>
    /// <remarks>Declared only to turn a mistake into a build error; set any other way, it throws.</remarks>
    [Parameter]
    [Obsolete("HTML has no read-only radio. Use Disabled; in a read-only Form it's disabled and its value still posts.", error: true)]
    [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
    public bool ReadOnly { get; set; }

    // The radio Tab reaches: the checked one, or else the first.
    private int FocusIndex => Math.Max(0, Options.Select(FormatValueAsString).ToList().IndexOf(CurrentValueAsString));

    /// <summary>The options. Not needed for enums, whose values are listed automatically.</summary>
    [Parameter] public IEnumerable<TValue>? Items { get; set; }

    /// <summary>The text for each option. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    /// <summary>An icon for each option, before its text.</summary>
    [Parameter] public Func<TValue, IconData?>? ItemIcon { get; set; }

    /// <summary>Shows only the icons; the text stays for screen readers and as a tooltip.</summary>
    [Parameter] public bool IconOnly { get; set; }

    /// <summary>Fills the available width, the segments sharing it equally.</summary>
    [Parameter] public bool FullWidth { get; set; }

    private string SegmentsClass => new ClassBuilder()
        .Add("ib-segmented")
        .Add("ib-segmented-full", FullWidth)
        .Add("ib-segmented-icon-only", IconOnly)
        .Build()!;

    private IEnumerable<TValue> Options
    {
        get
        {
            if (Items is not null)
            {
                return Items;
            }

            var type = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);
            return type.IsEnum ? Enum.GetValues(type).Cast<object>().Select(v => (TValue)v) : [];
        }
    }

    private string TextFor(TValue item)
    {
        if (ItemText is not null)
        {
            return ItemText(item);
        }

        if (item is Enum e)
        {
            return ChoiceOptions.EnumText(e);
        }

        return item?.ToString() ?? "";
    }
}
