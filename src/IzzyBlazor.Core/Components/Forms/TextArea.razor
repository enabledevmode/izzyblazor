@namespace IzzyBlazor
@inherits FieldBase<string?>
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, the character count doesn't update as you type.")]

@*
    Multi-line text with label, hint and errors.
    <TextArea @bind-Value="Model.Message" Rows="5" AutoGrow ShowCount />

    Accessibility:
    - Label, hint and errors work as in `TextField`: a linked `label`, `aria-describedby` and
      `aria-invalid`.
    - With a maximum length, the browser stops typing at the limit (`maxlength`).
    - With script, the `ShowCount` counter ("12 / 200") is the field's description, after the
      hint and errors, so screen readers read it on focus; it isn't announced as it changes. With
      JavaScript off it doesn't update, so it isn't linked.
    See also: TextField, Form, FieldFrame.
*@

<FieldFrame Class="@WrapperClass("textarea")" Style="@WrapperStyle" Id="@FieldId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <ib-field-control class="ib-field-control">
        <textarea @attributes="ControlAttributes"
                  id="@FieldId"
                  class="@InputClass"
                  name="@NameAttributeValue"
                  @bind="CurrentValueAsString"
                  rows="@Rows"
                  style="@(AutoGrow ? $"--ib-rows: {Rows}" : null)"
                  placeholder="@Placeholder"
                  required="@IsRequired"
                  maxlength="@Max"
                  minlength="@(MinLength ?? AnnotatedMinLength)"
                  disabled="@IsDisabled"
                  readonly="@IsReadOnly"
                  aria-invalid="@(Invalid ? "true" : null)"
                  aria-describedby="@DescribedBy"></textarea>
        @if (ShowsCount)
        {
            @* The script keeps the number's own text node in step as you type and adds the count
               to the textarea's aria-describedby. *@
            <span class="ib-field-count" id="@CountId"><span class="ib-field-count-current">@(CurrentValueAsString?.Length ?? 0)</span> / @Max</span>
        }
    </ib-field-control>
</FieldFrame>

@code {
    /// <summary>Makes the field read-only: it can be focused and its text selected, and it still posts.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    /// <summary>Visible lines. Defaults to 4.</summary>
    [Parameter] public int Rows { get; set; } = 4;

    /// <summary>Grows with the text instead of scrolling, from <see cref="Rows"/> lines up, where the browser supports CSS <c>field-sizing</c>.</summary>
    [Parameter] public bool AutoGrow { get; set; }

    /// <summary>Example text shown when empty.</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Maximum length. Defaults to <c>[StringLength]</c> or <c>[MaxLength]</c>.</summary>
    [Parameter] public int? MaxLength { get; set; }

    /// <summary>Minimum length. Defaults to <c>[StringLength(MinimumLength)]</c> or <c>[MinLength]</c>.</summary>
    [Parameter] public int? MinLength { get; set; }

    /// <summary>Shows "n / max" under the field. Needs a maximum length. Updates as you type once scripts run.</summary>
    [Parameter] public bool ShowCount { get; set; }

    private int? Max => MaxLength ?? AnnotatedMaxLength;

    private bool ShowsCount => ShowCount && Max is not null;

    private string CountId => FieldId + "-count";

    private string InputClass => AutoGrow ? "ib-field-input ib-field-autogrow" : "ib-field-input";
}
