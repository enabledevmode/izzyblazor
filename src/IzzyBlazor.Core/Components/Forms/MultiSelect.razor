@namespace IzzyBlazor
@typeparam TValue
@typeparam TItem
@inherits FieldBase<TValue>
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, it's a plain multi-select list, without chips or typing to filter, and AllowCustom can't take new values.")]

@*
    Pick several options from a longer list, bound to a collection: an array, List<T>,
    HashSet<T> or an interface they implement. Both types are inferred, from the bound property
    and from Items; for an enum, pass its values (Items="Enum.GetValues<Skill>()").

    <MultiSelect @bind-Value="Model.Skills" Items="AllSkills" Placeholder="Add skills" />

    How it works three ways:
    - No script: a native <select multiple> holds and posts the values (repeated form fields,
      which Blazor binds to the collection).
    - With script (<ib-combobox>): the chosen options show as chips in a field you can type in
      to filter the list; choosing toggles an option and the list stays open.
    - Interactive: the same, and @bind-Value follows every change.
    For a short list, CheckboxGroup shows every option at once.

    AllowCustom takes typed values too, for string collections (labels, email recipients), with
    or without Items as suggestions:

    <MultiSelect @bind-Value="Model.Labels" Items="KnownLabels" AllowCustom Label="Labels" />

    Enter, a comma or a semicolon adds the typed text, as does leaving the field; a paste splits
    on commas, semicolons and line breaks. Text matching an option (ignoring case) chooses it, and
    a value already chosen isn't added twice. A new value becomes a chosen option of the native
    select, so it posts and binds like the others.

    Accessibility:
    - With script, the input is a `combobox` with a multi-select `listbox`: chosen options have
      `aria-selected`, and focus stays in the input as Down and Up move through them.
    - Enter toggles the highlighted option and the list stays open; Escape or Tab closes it.
    - Backspace in the empty input removes the last chosen option. The chips' remove buttons,
      named "Remove" and the option ("Remove Design", `RemoveLabel`), are left out of the Tab
      order.
    - When nothing matches, "No matches" (`EmptyText`) is announced politely; with AllowCustom,
      a typed value is announced as it's added ("Added Design.", `IzzyText.Added`).
    - The label names the input and the list. The chosen options are the input's description,
      before the hint and errors ("Chosen: Design, Writing.", `IzzyText.Chosen`), so they're heard on focus.
    - With JavaScript off, it's a native multiple `select`, with the browser's own keys.

    Keyboard:
    In the field
    - Down | Open the list at the first option; in the open list, go to the next
    - Up | Open the list at the last option; in the open list, go to the previous
    - Alt+Down | Open the list without highlighting an option
    - Page Down, Page Up | Move ten options
    - Enter, Alt+Up | Choose or unchoose the highlighted option, keeping the list open
    - Backspace | In the empty input, remove the last chosen option
    - Escape | Close the list and clear the typed text
    - Tab | Close the list and move on
    With AllowCustom
    - Enter | With no option highlighted, add the typed text
    - Comma, Semicolon | Add the typed text
    See also: CheckboxGroup, Combobox, Select.
*@

<FieldFrame Class="@WrapperClass("multiselect")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    @if (ShowsReadOnly)
    {
        @(ReadOnlyControl(string.Join(", ", ChosenItems.Select(item => ChoiceOptions.Text(item, ItemText)))))
    }
    else
    {
    <ib-combobox class="ib-field-control ib-has-end ib-combobox ib-multiselect"
                 style="@($"anchor-name:{StyleValues.AnchorName(ListId)}")"
                 data-remove-label="@(RemoveLabel ?? TextDefaults.Remove)"
                 data-chosen-label="@TextDefaults.Chosen"
                 data-custom="@AllowCustom"
                 data-added-label="@(AllowCustom ? TextDefaults.Added : null)">
        <select @attributes="ControlAttributes"
                id="@FieldId"
                class="ib-field-input ib-combobox-select ib-multiselect-select"
                name="@NameAttributeValue"
                multiple
                size="@Math.Clamp(ItemList.Count + ChoiceOptions.Grouped(ItemList, ItemGroup).Count(g => g.Group is not null), 2, 6)"
                required="@IsRequired"
                disabled="@IsDisabled"
                aria-invalid="@(Invalid ? "true" : null)"
                aria-describedby="@DescribedBy"
                @onchange="OnSelectChanged">
            @foreach (var (group, items) in ChoiceOptions.Grouped(ItemList, ItemGroup))
            {
                if (group is null)
                {
                    @SelectOptions(items)
                }
                else
                {
                    <optgroup @key="@(("group", group))" label="@group"><legend>@group</legend>@SelectOptions(items)</optgroup>
                }
            }
            @* Typed values (AllowCustom): after the options, where the script adds new ones. Keyed,
               so removing one doesn't hand its element (and its selected state) to the next. *@
            @foreach (var item in CustomChosen)
            {
                <option @key="item" value="@ChoiceOptions.Value(item)" selected>@ChoiceOptions.Text(item, ItemText)</option>
            }
        </select>
        <div class="ib-field-input ib-multiselect-box">
            @* The chips: drawn here on a static page and in a prerender (which the interactive render
               replaces), so the field is the same before IzzyBlazor's script arrives as after; the
               script keeps them in step with the select (and leaves them when they match). An
               interactive render leaves them to the script, as a re-render would undo its changes. *@
            <span class="ib-multiselect-chips">
                @if (!RendererInfo.IsInteractive)
                {
                    @foreach (var item in ChosenItems)
                    {
                        var text = ChoiceOptions.Text(item, ItemText);
                        <span class="ib-chip" data-value="@ChoiceOptions.Value(item)"><span class="ib-chip-text">@text</span><button type="button" class="ib-chip-remove" tabindex="-1" aria-label="@($"{RemoveLabel ?? TextDefaults.Remove} {text}")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button></span>
                    }
                }
            </span>
            @* The chips for screen readers, as the input's description ("Chosen: Design, Writing."):
               the chips themselves would read their remove buttons too. Kept like the chips. *@
            <span id="@ChosenId" class="ib-multiselect-chosen" hidden>@(RendererInfo.IsInteractive ? null : ChosenText)</span>
            <input type="text"
                   id="@InputId"
                   class="ib-combobox-input ib-multiselect-input"
                   placeholder="@(string.IsNullOrEmpty(Placeholder) ? " " : Placeholder)"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   aria-controls="@ListId"
                   aria-labelledby="@LabelId"
                   aria-required="@(IsRequired ? "true" : null)"
                   aria-invalid="@(Invalid ? "true" : null)"
                   aria-describedby="@(DescribedBy is null ? ChosenId : $"{ChosenId} {DescribedBy}")"
                   autocomplete="off"
                   autocapitalize="off"
                   spellcheck="false"
                   disabled="@IsDisabled"
                   readonly="@IsReadOnly" />
        </div>
        <button type="button" class="ib-combobox-toggle" tabindex="-1" aria-label="@(ToggleLabel ?? TextDefaults.ShowOptions)" disabled="@IsDisabled">
            <Icon Purpose="IconPurpose.ChevronDown" Class="ib-field-icon" />
        </button>
        <div id="@ListId"
             class="ib-pop ib-place-bottom-start ib-combobox-list"
             style="@($"position-anchor:{StyleValues.AnchorName(ListId)}")"
             popover="manual"
             role="listbox"
             aria-multiselectable="true"
             aria-labelledby="@LabelId">
            @{ var index = 0; var groupIndex = 0; }
            @* Each run of options is one region, so its options' keys meet as siblings; groups are keyed
               by name, so a group that moves keeps its elements. *@
            @foreach (var (group, items) in ChoiceOptions.Grouped(ItemList, ItemGroup))
            {
                var run = items.Select(item => (item, index++)).ToList();
                if (group is null)
                {
                    @OptionRows(run)
                }
                else
                {
                    var labelId = $"{ListId}-g{groupIndex++}";
                    <div @key="@(("group", group))" role="group" class="ib-combobox-group" aria-labelledby="@labelId">
                        <div id="@labelId" class="ib-combobox-group-label">@group</div>
                        @OptionRows(run)
                    </div>
                }
            }
            @* Shown in the list, but read through the status below: a listbox holds only options. *@
            <div class="ib-combobox-empty" aria-hidden="true">@(EmptyText ?? TextDefaults.NoMatches)</div>
        </div>
        <span class="ib-visually-hidden ib-combobox-status" role="status"></span>
        @if (Clearable && !IsDisabled)
        {
            @ClearButton
        }
    </ib-combobox>
    }
    @if (PostsReadOnlyValue)
    {
        @* Read-only: the values show in a read-only text field, which doesn't post them; these do. *@
        @foreach (var item in ChosenItems)
        {
            <input type="hidden" name="@NameAttributeValue" value="@ChoiceOptions.Value(item)" />
        }
    }
</FieldFrame>

@code {
    /// <summary>A button in the field that removes every choice, there while there are any. Off by default.</summary>
    [Parameter] public bool Clearable { get; set; }

    /// <inheritdoc />
    private protected override bool HoldsValue => CurrentValue is System.Collections.IEnumerable values && values.Cast<object>().Any();

    /// <summary>Makes the field read-only: the chosen options show in a read-only text field, and the values still post.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    private RenderFragment SelectOptions(IEnumerable<TItem> items) => @<text>
        @foreach (var item in items)
        {
            <option value="@ChoiceOptions.Value(item)" selected="@IsChosen(item)">@ChoiceOptions.Text(item, ItemText)</option>
        }
    </text>;

    private RenderFragment OptionRows(IEnumerable<(TItem Item, int Index)> rows) => @<text>
        @foreach (var (item, index) in rows)
        {
            <div role="option"
                 id="@($"{ListId}-{index}")"
                 class="ib-combobox-option ib-multiselect-option"
                 data-value="@ChoiceOptions.Value(item)"
                 data-text="@ChoiceOptions.Text(item, ItemText)"
                 aria-selected="@(IsChosen(item) ? "true" : "false")">
                <span class="ib-multiselect-check" aria-hidden="true"></span>
                @if (ItemTemplate is null)
                {
                    @ChoiceOptions.Text(item, ItemText)
                }
                else
                {
                    @ItemTemplate(item)
                }
            </div>
        }
    </text>;

    /// <summary>
    /// The group each option is listed under, such as a team for a person; null is none. Groups show
    /// in the order they first appear, options with no group first, and a group with no match is
    /// hidden while filtering. Defaults to an enum value's <c>[Display(GroupName)]</c>.
    /// </summary>
    [Parameter] public Func<TItem, string?>? ItemGroup { get; set; }

    /// <summary>
    /// The options. For an enum, pass its values: <c>Items="Enum.GetValues&lt;Skill&gt;()"</c>. With
    /// <see cref="AllowCustom"/>, suggestions, and optional.
    /// </summary>
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>
    /// Takes typed values as well as the options, such as new labels or email recipients: Enter, a
    /// comma or a semicolon adds the text, as does leaving the field, and a paste splits on commas,
    /// semicolons and line breaks. For string collections only. Check the values with the model's
    /// validation. Needs JavaScript.
    /// </summary>
    [Parameter] public bool AllowCustom { get; set; }

    /// <summary>The text for each option, also what's typed to find it and the chip's text. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TItem, string>? ItemText { get; set; }

    /// <summary>Markup for each option in the list, such as an icon. Chips show <see cref="ItemText"/>.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>Text in the empty field, such as "Add skills".</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Shown when nothing matches.</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>The accessible name of the button that opens the list.</summary>
    [Parameter] public string? ToggleLabel { get; set; }

    /// <summary>The start of each chip's remove button name for screen readers, before the option's text. Defaults to "Remove".</summary>
    [Parameter] public string? RemoveLabel { get; set; }

    private string InputId => FieldId + "-input";
    private string ListId => FieldId + "-list";
    private string LabelId => FieldId + "-label";
    private string ChosenId => FieldId + "-chosen";

    private string? ChosenText => ChosenItems.Select(item => ChoiceOptions.Text(item, ItemText)).ToList() is { Count: > 0 } chosen
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, TextDefaults.Chosen, string.Join(", ", chosen))
        : null;

    private IReadOnlyList<TItem> ItemList => ChoiceOptions.Of(Items).ToList();

    private bool IsChosen(TItem item) => ChoiceCollection<TValue, TItem>.Items(CurrentValue).Contains(item);

    // Chosen values that aren't options: typed ones (AllowCustom).
    private IEnumerable<TItem> CustomChosen => AllowCustom
        ? ChoiceCollection<TValue, TItem>.Items(CurrentValue).Where(v => !ItemList.Contains(v)).Distinct()
        : [];

    // In the select's order: the options, then typed values.
    private IEnumerable<TItem> ChosenItems => ItemList.Where(IsChosen).Concat(CustomChosen);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (AllowCustom && typeof(TItem) != typeof(string))
        {
            throw new InvalidOperationException($"MultiSelect's AllowCustom takes typed text, so it needs string items; this one's items are {typeof(TItem).Name}. Bind it to a string collection.");
        }
    }

    // The browser reports a multiple select's change as the chosen values, in list order.
    private void OnSelectChanged(ChangeEventArgs e)
    {
        string[] values = e.Value switch
        {
            string[] many => many,
            string one => [one],
            System.Collections.IEnumerable many => many.Cast<object?>().Select(v => v?.ToString() ?? "").ToArray(),
            _ => [],
        };

        IEnumerable<TItem> chosen = ItemList.Where(i => values.Contains(ChoiceOptions.Value(i))).ToList();
        if (AllowCustom)
        {
            // Typed values: strings, checked in OnParametersSet.
            var known = chosen.Select(ChoiceOptions.Value).ToHashSet();
            chosen = chosen.Concat(values.Where(v => !known.Contains(v)).Distinct().Select(v => (TItem)(object)v));
        }

        CurrentValue = ChoiceCollection<TValue, TItem>.Create(chosen);
    }
}
