@namespace IzzyBlazor
@typeparam TValue
@typeparam TItem
@inherits FieldBase<TValue>
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, it's a plain multi-select list, without chips or typing to filter.")]

@*
    Pick several options from a longer list, bound to a collection: an array, List<T>,
    HashSet<T> or an interface they implement. Both types are inferred, from the bound property
    and from Items; for an enum, pass its values (Items="Enum.GetValues<Skill>()").

    <MultiSelect @bind-Value="Model.Skills" Items="AllSkills" Placeholder="Add skills" />

    How it works three ways:
    - No script: a native <select multiple> holds and posts the values (repeated form fields,
      which Blazor binds to the collection).
    - With script (<ib-combobox>): the chosen options show as chips in a field you can type in
      to filter the list; choosing toggles an option and the list stays open.
    - Interactive: the same, and @bind-Value follows every change.
    For a short list, CheckboxGroup shows every option at once.

    Accessibility:
    - With script, the input is a `combobox` with a multi-select `listbox`: chosen options have
      `aria-selected`, and focus stays in the input as Down and Up move through them.
    - Enter toggles the highlighted option and the list stays open; Escape or Tab closes it.
    - Backspace in the empty input removes the last chosen option. The chips' remove buttons,
      named "Remove" and the option ("Remove Design", `RemoveLabel`), are left out of the Tab
      order.
    - When nothing matches, "No matches" (`EmptyText`) is announced politely.
    - The label names the input and the list, and the hint and errors are linked with
      `aria-describedby`.
    - With JavaScript off, it's a native multiple `select`, with the browser's own keys.
    See also: CheckboxGroup, Combobox, Select.
*@

<FieldFrame Class="@WrapperClass("multiselect")" Style="@WrapperStyle" Id="@FieldId" LabelId="@LabelId" Label="@ResolvedLabel" HideLabel="HideLabel" Required="IsRequired"
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    @if (ShowsReadOnly)
    {
        @(ReadOnlyControl(string.Join(", ", ItemList.Where(IsChosen).Select(item => ChoiceOptions.Text(item, ItemText)))))
    }
    else
    {
    <ib-combobox class="ib-field-control ib-has-end ib-combobox ib-multiselect"
                 style="@($"anchor-name:{StyleValues.AnchorName(ListId)}")"
                 data-remove-label="@(RemoveLabel ?? TextDefaults.Remove)">
        <select @attributes="ControlAttributes"
                id="@FieldId"
                class="ib-field-input ib-combobox-select ib-multiselect-select"
                name="@NameAttributeValue"
                multiple
                size="@Math.Clamp(ItemList.Count, 2, 6)"
                required="@IsRequired"
                disabled="@IsDisabled"
                aria-invalid="@(Invalid ? "true" : null)"
                aria-describedby="@DescribedBy"
                @onchange="OnSelectChanged">
            @foreach (var item in ItemList)
            {
                <option value="@ChoiceOptions.Value(item)" selected="@IsChosen(item)">@ChoiceOptions.Text(item, ItemText)</option>
            }
        </select>
        <div class="ib-field-input ib-multiselect-box">
            @* The chips: drawn here on a static page and in a prerender (which the interactive render
               replaces), so the field is the same before IzzyBlazor's script arrives as after; the
               script keeps them in step with the select (and leaves them when they match). An
               interactive render leaves them to the script, as a re-render would undo its changes. *@
            <span class="ib-multiselect-chips">
                @if (!RendererInfo.IsInteractive)
                {
                    @foreach (var item in ItemList.Where(IsChosen))
                    {
                        var text = ChoiceOptions.Text(item, ItemText);
                        <span class="ib-chip" data-value="@ChoiceOptions.Value(item)"><span class="ib-chip-text">@text</span><button type="button" class="ib-chip-remove" tabindex="-1" aria-label="@($"{RemoveLabel ?? TextDefaults.Remove} {text}")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg></button></span>
                    }
                }
            </span>
            <input type="text"
                   id="@InputId"
                   class="ib-combobox-input ib-multiselect-input"
                   placeholder="@Placeholder"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   aria-controls="@ListId"
                   aria-labelledby="@LabelId"
                   aria-required="@(IsRequired ? "true" : null)"
                   aria-invalid="@(Invalid ? "true" : null)"
                   aria-describedby="@DescribedBy"
                   autocomplete="off"
                   autocapitalize="off"
                   spellcheck="false"
                   disabled="@IsDisabled"
                   readonly="@IsReadOnly" />
        </div>
        <button type="button" class="ib-combobox-toggle" tabindex="-1" aria-label="@(ToggleLabel ?? TextDefaults.ShowOptions)" disabled="@IsDisabled">
            <Icon Role="IconRole.ChevronDown" Class="ib-field-icon" />
        </button>
        <div id="@ListId"
             class="ib-pop ib-place-bottom-start ib-combobox-list"
             style="@($"position-anchor:{StyleValues.AnchorName(ListId)}")"
             popover="manual"
             role="listbox"
             aria-multiselectable="true"
             aria-labelledby="@LabelId">
            @{ var index = 0; }
            @foreach (var item in ItemList)
            {
                <div role="option"
                     id="@($"{ListId}-{index++}")"
                     class="ib-combobox-option ib-multiselect-option"
                     data-value="@ChoiceOptions.Value(item)"
                     data-text="@ChoiceOptions.Text(item, ItemText)"
                     aria-selected="@(IsChosen(item) ? "true" : "false")">
                    <span class="ib-multiselect-check" aria-hidden="true"></span>
                    @if (ItemTemplate is null)
                    {
                        @ChoiceOptions.Text(item, ItemText)
                    }
                    else
                    {
                        @ItemTemplate(item)
                    }
                </div>
            }
            @* Shown in the list, but read through the status below: a listbox holds only options. *@
            <div class="ib-combobox-empty" aria-hidden="true">@(EmptyText ?? TextDefaults.NoMatches)</div>
        </div>
        <span class="ib-visually-hidden ib-combobox-status" role="status"></span>
    </ib-combobox>
    }
    @if (PostsReadOnlyValue)
    {
        @* Read-only: the values show in a read-only text field, which doesn't post them; these do. *@
        @foreach (var item in ItemList.Where(IsChosen))
        {
            <input type="hidden" name="@NameAttributeValue" value="@ChoiceOptions.Value(item)" />
        }
    }
</FieldFrame>

@code {
    /// <summary>Makes the field read-only: the chosen options show in a read-only text field, and the values still post.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <inheritdoc />
    protected override bool OwnReadOnly => ReadOnly;

    /// <summary>The options. For an enum, pass its values: <c>Items="Enum.GetValues&lt;Skill&gt;()"</c>.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }

    /// <summary>The text for each option, also what's typed to find it and the chip's text. Defaults to the enum value's <c>[Display(Name)]</c> or its string form.</summary>
    [Parameter] public Func<TItem, string>? ItemText { get; set; }

    /// <summary>Markup for each option in the list, such as an icon. Chips show <see cref="ItemText"/>.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>Text in the empty field, such as "Add skills".</summary>
    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Shown when nothing matches.</summary>
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>The accessible name of the button that opens the list.</summary>
    [Parameter] public string? ToggleLabel { get; set; }

    /// <summary>The start of each chip's remove button name for screen readers, before the option's text. Defaults to "Remove".</summary>
    [Parameter] public string? RemoveLabel { get; set; }

    private string InputId => FieldId + "-input";
    private string ListId => FieldId + "-list";
    private string LabelId => FieldId + "-label";

    private IReadOnlyList<TItem> ItemList => ChoiceOptions.Of(Items).ToList();

    private bool IsChosen(TItem item) => ChoiceCollection<TValue, TItem>.Items(CurrentValue).Contains(item);

    // The browser reports a multiple select's change as the chosen values, in list order.
    private void OnSelectChanged(ChangeEventArgs e)
    {
        string[] values = e.Value switch
        {
            string[] many => many,
            string one => [one],
            System.Collections.IEnumerable many => many.Cast<object?>().Select(v => v?.ToString() ?? "").ToArray(),
            _ => [],
        };

        var chosen = ItemList.Where(i => values.Contains(ChoiceOptions.Value(i)));
        CurrentValue = ChoiceCollection<TValue, TItem>.Create(chosen);
    }
}
