@namespace IzzyBlazor
@inherits TextFieldBase
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, there's no show/hide button and no Caps Lock warning, and Requirements are checked when the form posts.")]

@*
    A password input with label, hint and errors, and a button that shows or hides what's typed.

    For a new password, Requirements lists what it needs under the field and checks it off as it's
    typed; the form doesn't validate until they're met, on the server too:
    <PasswordField @bind-Value="Model.NewPassword"
                   Requirements="new PasswordRules { RequiredLength = 12 }" />

    On a static page it's empty after a post: the page doesn't write the password back into its
    HTML, so it has to be typed again when the form comes back with errors.

    Accessibility:
    - It renders a native `input type="password"` with a `label` linked to it.
    - The hint and, when the field is invalid, its errors are linked with `aria-describedby`; an
      invalid field sets `aria-invalid`.
    - The show/hide button is a toggle named "Show password" (`ShowPasswordLabel`), pressed while
      the password shows.
    - With script, it says "Caps Lock is on." (`IzzyText.CapsLockOn`) under it while typing with
      Caps Lock on, announced once through a polite status.
    - `Requirements` lists what a new password needs under the field, linked as its description;
      with script each item says "met" or "not yet" in its text, not by its icon alone, and "All
      requirements met." (`IzzyText.PasswordRulesMet`) is announced once when the last one is.
    See also: TextField, PinField, Form.
*@

@{ base.BuildRenderTree(__builder); }

@code {
    /// <summary>A button that shows or hides the text. Appears once scripts run. Defaults to true.</summary>
    [Parameter] public bool Reveal { get; set; } = true;

    /// <summary>The reveal button's name; it's a toggle, pressed while the password shows. Defaults to "Show password".</summary>
    [Parameter] public string? ShowPasswordLabel { get; set; }

    /// <summary>
    /// What a new password must have, listed under the field and checked off as it's typed; the form
    /// doesn't validate until the password meets them, on the server too. Sets <see cref="TextFieldBase.AutoComplete"/>
    /// to <c>new-password</c> unless it's set (without Requirements it's <c>current-password</c>), and tells
    /// Safari the rules for the passwords it suggests.
    /// </summary>
    [Parameter] public PasswordRules? Requirements { get; set; }

    /// <inheritdoc />
    private protected override bool IsPassword => true;

    /// <inheritdoc />
    private protected override string InputType => "password";

    /// <inheritdoc />
    // A password's purpose, so browsers and password managers fill it (WCAG 1.3.5): a new one when
    // it has requirements, else the one the user has.
    private protected override string? DefaultAutoComplete => Requirements is null ? "current-password" : "new-password";

    /// <inheritdoc />
    private protected override PasswordRules? PasswordRequirements => Requirements;

    /// <inheritdoc />
    private protected override bool ShowsReveal => Reveal;

    /// <inheritdoc />
    private protected override string? RevealLabel => ShowPasswordLabel;

    /// <inheritdoc />
    private protected override bool HasOwnRules => Requirements is not null;

    /// <inheritdoc />
    private protected override string? OwnRuleError(string? value) =>
        value is { Length: > 0 } && Requirements is { } rules && !rules.IsMetBy(value) ? UnmetMessage : null;
}
