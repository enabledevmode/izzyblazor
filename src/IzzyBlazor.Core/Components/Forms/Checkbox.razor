@namespace IzzyBlazor
@inherits FieldBase<bool>

@*
    A checkbox with its label beside it.
    <Checkbox @bind-Value="Model.AcceptTerms" Label="I agree to the terms" />

    Posting: a hidden "false" follows the box, so an unchecked box posts "false" and a checked one
    posts "true" then "false" (Blazor binds the first value). Without it an unchecked box posts
    nothing, and when nothing else in the form is posted, Blazor doesn't bind the model at all:
    the page recreates it and a box that defaults to true comes back checked. A disabled box
    posts nothing, like any disabled field.

    Indeterminate shows a dash, for a "select all" box when only some are selected. It's display
    only: the box posts as unchecked ("false"), and choosing it clears the dash.
*@

<FieldFrame Class="@FrameClass" Style="@WrapperStyle" Id="@FieldId" LabelInControl
            Hint="@Hint" HintId="@HintId" Errors="Errors" ErrorId="@ErrorId">
    <label class="ib-check" for="@FieldId">
        <input @attributes="ControlAttributes"
               id="@FieldId"
               class="@(AsSwitch ? "ib-switch-input" : "ib-check-input")"
               type="checkbox"
               role="@(AsSwitch ? "switch" : null)"
               data-indeterminate="@(Indeterminate && !AsSwitch ? "" : null)"
               name="@NameAttributeValue"
               value="true"
               @bind="CurrentValue"
               required="@(IsRequired && !ShowsReadOnly)"
               disabled="@(IsDisabled || ShowsReadOnly)"
               form="@(ShowsReadOnly ? "" : null)"
               aria-readonly="@(ShowsReadOnly ? "true" : null)"
               aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@DescribedBy" />
        @if (Icon is { } icon)
        {
            <span class="ib-check-icon" aria-hidden="true"><Icon Name="icon" /></span>
        }
        <span class="ib-check-label">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @ResolvedLabel
            }
            @if (ShowRequiredMark)
            {
                <span class="ib-field-required" aria-hidden="true"> *</span>
            }
        </span>
    </label>
    @if (!IsDisabled && !string.IsNullOrEmpty(NameAttributeValue))
    {
        @* An unchecked box doesn't post, so this "false" does. A read-only box is outside the form
           (form=""), so this posts its value. *@
        <input type="hidden" name="@NameAttributeValue" value="@(IsReadOnly && CurrentValue ? "true" : "false")" />
    }
</FieldFrame>

@code {
    /// <summary>Rich label content, such as text with a link. Overrides <c>Label</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Shows the box as partly selected (a dash), such as a "select all" box when only some items
    /// are. Display only: it posts as unchecked, and choosing the box clears it. With script, screen
    /// readers announce it as "mixed". Ignored by <see cref="Switch"/>.
    /// </summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>
    /// Which side of the label the box or switch sits on. <c>End</c> puts it at the end of the row,
    /// with the hint and errors under the label, as in a list of settings. Defaults to <c>Start</c>.
    /// </summary>
    [Parameter] public ControlPosition ControlPosition { get; set; }

    /// <summary>
    /// An icon before the label, such as a key for a security setting. With
    /// <c>ControlPosition.End</c> it's centered on the label and hint, at the start of the row.
    /// Decorative: screen readers read only the label. Use icons on every row of a group or none.
    /// </summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>Renders as a switch. Use <see cref="Switch"/> instead of setting this.</summary>
    protected virtual bool AsSwitch => false;

    private string FrameClass => WrapperClass(AsSwitch ? "switch" : "checkbox",
        (ControlPosition == ControlPosition.End, Icon is not null) switch
        {
            (true, true) => "ib-field-control-end ib-check-has-icon",
            (true, false) => "ib-field-control-end",
            (false, true) => "ib-check-has-icon",
            _ => null,
        });
}
