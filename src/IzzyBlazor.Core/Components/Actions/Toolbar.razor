@namespace IzzyBlazor
@inherits LayoutItemBase
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, items move into the … menu at widths worked out on the server, and arrow keys don't move between them.")]

@*
    A row of controls that stays one row: what doesn't fit moves into a "…" menu at the end, lowest
    priority first. Its ToolbarButtons, ToolbarIconButtons, ToolbarButtonGroups and ToolbarMenus
    become menu items there, with the same links, form posts and OnClick, so it works with
    JavaScript off: the server works out the widths at which each item moves, as container
    queries. The script measures the real widths and corrects them, and adds arrow-key movement.

    <Toolbar Label="Editor">
        <ToolbarButtonGroup Label="History">
            <ToolbarIconButton Icon="Lucide.Undo2" Label="Undo" />
            <ToolbarIconButton Icon="Lucide.Redo2" Label="Redo" />
        </ToolbarButtonGroup>
        <ToolbarSeparator />
        <ToolbarButton StartIcon="Lucide.Link" Priority="1">Link</ToolbarButton>
        <ToolbarButton Position="ToolbarPosition.End" Overflow="ToolbarOverflow.Never" Accent="Accent.Primary" Variant="ButtonVariant.Solid">Publish</ToolbarButton>
        <ToolbarButton StartIcon="Lucide.Printer" Overflow="ToolbarOverflow.Always">Print</ToolbarButton>
    </Toolbar>

    Each item takes a Position (Start, the default; Center; End), a Priority (higher stays longer)
    and an Overflow: Never for the main action, Always for what's only ever in the menu. Only
    toolbar items go directly in it: other controls throw there. ToolbarText is text that stays;
    ToolbarItem holds anything else (a field, a SegmentedControl, a Tooltip), with a Width so the
    widths without script allow for it, and MenuContent for what stands in for it in the menu
    (without that, it stays). The toolbar fills its container's width; in a row, give it Grow.
    With Wrap, everything shows in the bar. With CollapseLabels, buttons with an icon drop their
    text first, and items move into the menu only once that isn't enough.

    The toolbar draws its items itself, so a cascading value or form written around one inside the
    toolbar doesn't reach it (put the form around the toolbar). Items keep the order they reach the
    toolbar in: one an @if adds on an interactive page comes after the rest of its position.
    Without script the widths are estimated from the button labels in Inter, the library's font; a
    theme with another font can be a few pixels out until the script measures.

    Accessibility:
    - With script, it's a `toolbar` named by `Label` (optional; name each one when a page has
      more than one), with one tab stop: Left and Right move between
      its controls and wrap, Home and End go to the ends (reversed on right-to-left pages), and
      focus comes back to the control last used.
    - A text field keeps Left and Right until the caret reaches its start or end, and a
      SegmentedControl until its first or last option; a Select keeps Up and Down. A Slider, and a
      number, email or date field (whose caret the script can't read), keep every arrow key, so
      put one last, or outside the toolbar.
    - The "…" button is the last control, named by `MoreLabel`; Enter, Space or Down opens its menu
      of `menuitem`s (a ToolbarButtonGroup is a labeled group, a ToolbarMenu a submenu), and
      Escape comes back.
    - If the focused control moves into the menu as the toolbar narrows, focus moves to "…".
    - With `CollapseLabels`, a button that drops its text keeps it for screen readers, and with
      script shows it as its tooltip.
    - With JavaScript off and until the script loads, it's a `group` named by `Label`, each
      control its own tab stop.
    - A dialog it opens (a ConfirmButton's) keeps its own Tab order and keys.
    See also: ButtonGroup, Menu, IconButton, AppShell.
*@

@{ (_class, _style) = BuildRootAttributes(); }
<ib-toolbar @attributes="AdditionalAttributes"
            id="@_context.RootId"
            class="@_class"
            style="@_style"
            role="@(RendererInfo.IsInteractive ? "toolbar" : "group")"
            data-ib-role="@(RendererInfo.IsInteractive ? null : "toolbar")"
            aria-label="@Label"
            data-ib-collapse="@(CollapseLabels && !Wrap ? "" : null)">
    <CascadingValue Value="_defaults">
        @* Only the items see the toolbar; what the toolbar draws (their bar and menu copies) doesn't. *@
        <CascadingValue Value="ToolbarContext.Outside" IsFixed="true">
            <div class="ib-toolbar-start">
                <CascadingValue Value="_parts" IsFixed="true">
                    <CascadingValue Value="_context" IsFixed="true">@ChildContent</CascadingValue>
                </CascadingValue>
                @Outlet(ToolbarPosition.Start)
            </div>
            @Outlet(ToolbarPosition.Center)
            <div class="ib-toolbar-end">
                @Outlet(ToolbarPosition.End)
                @if (!Wrap)
                {
                    @More
                }
            </div>
        </CascadingValue>
    </CascadingValue>
</ib-toolbar>

@code {
    /// <summary>
    /// What the toolbar is for, for screen readers: "Formatting", "Editor". Optional, as in ARIA;
    /// set it when the page has more than one toolbar, so they can be told apart.
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The buttons' accent, unless a button sets its own. Defaults to <see cref="Accent.Neutral"/>.</summary>
    [Parameter] public Accent Accent { get; set; } = Accent.Neutral;

    /// <summary>The buttons' variant, unless a button sets its own. Defaults to <see cref="ButtonVariant.Ghost"/>.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;

    /// <summary>The buttons' size, unless a button sets its own, and the "…" button's. Defaults to <see cref="ControlSize.Sm"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Sm;

    /// <summary>The space between items, in spacing steps (one step = 4px). Defaults to 2.</summary>
    [Parameter] public int Gap { get; set; } = 2;

    /// <summary>Wraps onto more rows instead of moving items into a "…" menu, for toolbars where everything must show.</summary>
    [Parameter] public bool Wrap { get; set; }

    /// <summary>
    /// Before anything moves into the "…" menu, buttons and menus with a <c>StartIcon</c> drop their
    /// text, all at once, and show only the icon (a menu keeps its chevron). The text stays for screen
    /// readers and, with script, is the tooltip. Items move into the menu only once that isn't enough.
    /// One with <see cref="ToolbarOverflow.Never"/>, such as the main action, keeps its text.
    /// </summary>
    [Parameter] public bool CollapseLabels { get; set; }

    /// <summary>The "…" button's name for screen readers and its tooltip. Defaults to "More actions".</summary>
    [Parameter] public string? MoreLabel { get; set; }

    /// <summary>
    /// A CSP nonce for the style element that holds the toolbar's widths. Defaults to the
    /// <see cref="IzzyTheme"/>'s <c>Nonce</c> on the page; set it on interactive pages, which don't
    /// see the theme's.
    /// </summary>
    [Parameter] public string? Nonce { get; set; }

    /// <summary>
    /// The items: <see cref="ToolbarButton"/>, <see cref="ToolbarIconButton"/>, <see cref="ToolbarButtonGroup"/>,
    /// <see cref="ToolbarMenu"/>, <see cref="ToolbarText"/>, <see cref="ToolbarItem"/> and
    /// <see cref="ToolbarSeparator"/>.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private PartScope? OuterScope { get; set; }

    private ToolbarContext _context = null!;
    private PartScope _parts = null!;
    private ButtonGroup _defaults = null!;
    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        var id = AdditionalAttributes?.TryGetValue("id", out var given) == true ? Convert.ToString(given, System.Globalization.CultureInfo.InvariantCulture) : null;
        _context = new ToolbarContext(id ?? IdGenerator.Next("ib-toolbar"));
        _parts = new PartScope(this, OuterScope, StateHasChanged);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _context.Gap = Gap * 4;
        _context.CollapseLabels = CollapseLabels && !Wrap;
        if (_defaults is null || _defaults.Accent != Accent || _defaults.Variant != Variant || _defaults.Size != Size)
        {
            _defaults = ButtonGroup.Defaults(Accent, Variant, Size);
        }
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-toolbar");
        classes.Add($"ib-toolbar-{Size.ToString().ToLowerInvariant()}");
        classes.Add("ib-toolbar-wrap", Wrap);
        if (Gap != 2)
        {
            styles.AddVar("toolbar-gap", $"var(--ib-space-{Gap})");
        }

        base.BuildAttributes(classes, styles);
    }

    // The items at one position. The start's are drawn after the content, so they've joined.
    private RenderFragment Outlet(ToolbarPosition position) => builder =>
    {
        builder.OpenComponent<ToolbarOutlet>(0);
        builder.AddComponentParameter(1, nameof(ToolbarOutlet.Context), _context);
        builder.AddComponentParameter(2, nameof(ToolbarOutlet.Position), position);
        builder.CloseComponent();
    };

    // The "…" menu and the widths without script, drawn last so every item has joined.
    private RenderFragment More => builder =>
    {
        builder.OpenComponent<ToolbarMore>(0);
        builder.AddComponentParameter(1, nameof(ToolbarMore.Context), _context);
        builder.AddComponentParameter(2, nameof(ToolbarMore.MoreLabel), MoreLabel ?? TextDefaults.MoreActions);
        builder.AddComponentParameter(3, nameof(ToolbarMore.Size), Size);
        builder.AddComponentParameter(4, nameof(ToolbarMore.Nonce), Nonce ?? Services.GetService<StyleNonce>()?.Value);
        builder.CloseComponent();
    };

    /// <inheritdoc />
    public void Dispose() => _context.OnMenuChanged = null;
}
