@namespace IzzyBlazor
@inherits LayoutItemBase
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager Navigation
@inject IServiceProvider Services
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, choosing a scheme reloads the page, and other open tabs don't follow.")]

@*
    Lets the user pick light, dark or system. The choice is kept in the ib-scheme cookie, which
    IzzyTheme reads on the server, so every page arrives in the chosen scheme with no flash.

    <ColorSchemeSwitch />                                         an icon button with a menu (default)
    <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Toggle" />     one icon button: light <-> dark
    <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Segmented" />  System, Light, Dark side by side
    <ColorSchemeSwitch @bind-Value="scheme" />                    interactive pages: follow it from C#

    The icon shows the page's scheme as it is (sun or moon), worked out in CSS, so it's right even
    when the device decides. Every option is a link to the endpoint app.MapIzzyBlazor() adds, which
    sets the cookie and comes back, so it works with JavaScript off. With JavaScript the switch is
    instant: the script sets the cookie and the page's scheme without a request, moves the check,
    and tells other tabs.

    Accessibility:
    - The menu button is named "Color scheme" (`Label`). With JavaScript its items are radio menu
      items with `aria-checked` and the menu's arrow keys; without it, links, the current one
      marked with `aria-current`.
    - `Toggle` is one link named for what it does, "Switch to dark mode" or "Switch to light mode";
      with JavaScript, focus stays on the switch after a click.
    - `Segmented` is a group named "Color scheme" whose current option has `aria-current`; with
      `IconOnly` screen readers still hear each option's name.
    - Every option is a link, so it works by keyboard with JavaScript off (the page reloads).
    See also: IzzyTheme, SegmentedControl, Menu.
*@

<ib-scheme-switch @attributes="AdditionalAttributes" class="@_class" style="@_style"
                  role="@(Variant == ColorSchemeSwitchVariant.Segmented ? "group" : null)"
                  aria-label="@(Variant == ColorSchemeSwitchVariant.Segmented ? GroupLabel : null)"
                  data-ib-value="@(Live && Value is { } bound ? ColorSchemes.Name(bound) : null)"
                  @onibscheme="OnSchemeAsync">
    @switch (Variant)
    {
        case ColorSchemeSwitchVariant.Toggle:
            @* Two links; CSS shows the one that leads away from the page's scheme. *@
            <a class="@ButtonClass ib-scheme-if-light" href="@Href(ColorScheme.Dark)" data-ib-scheme="dark"
               aria-label="@TextDefaults.SchemeToDark" title="@TextDefaults.SchemeToDark">
                <Icon Role="IconRole.SchemeDark" />
            </a>
            <a class="@ButtonClass ib-scheme-if-dark" href="@Href(ColorScheme.Light)" data-ib-scheme="light"
               aria-label="@TextDefaults.SchemeToLight" title="@TextDefaults.SchemeToLight">
                <Icon Role="IconRole.SchemeLight" />
            </a>
            break;

        case ColorSchemeSwitchVariant.Segmented:
            @foreach (var (scheme, icon, label) in Options)
            {
                <a class="ib-segment" href="@Href(scheme)" data-ib-scheme="@ColorSchemes.Name(scheme)"
                   aria-current="@(scheme == _current ? "true" : null)" title="@(IconOnly ? label : null)">
                    <Icon Name="icon" />
                    @if (IconOnly)
                    {
                        <span class="ib-visually-hidden">@label</span>
                    }
                    else
                    {
                        <span class="ib-segment-label">@label</span>
                    }
                </a>
            }
            break;

        default:
            <Menu Placement="Placement.BottomEnd">
                <Trigger>
                    <button type="button" class="@ButtonClass" aria-label="@GroupLabel" title="@GroupLabel" @attributes="context">
                        <Icon Role="IconRole.SchemeLight" Class="ib-scheme-if-light" />
                        <Icon Role="IconRole.SchemeDark" Class="ib-scheme-if-dark" />
                    </button>
                </Trigger>
                <ChildContent>
                    @foreach (var (scheme, icon, label) in Options)
                    {
                        var on = scheme == _current ? "true" : "false";
                        @* Radio items with a dot on every one; CSS shows the checked one's, so the
                           script moves the choice by changing attributes only. *@
                        <a class="ib-menu-item ib-menu-item-checkable" href="@Href(scheme)" data-ib-scheme="@ColorSchemes.Name(scheme)"
                           role="@(Live ? "menuitemradio" : null)" data-ib-role="@(Live ? null : "menuitemradio")"
                           aria-checked="@(Live ? on : null)" data-ib-checked="@(Live ? null : on)"
                           aria-current="@(!Live && scheme == _current ? "true" : null)">
                            <span class="ib-menu-check" aria-hidden="true"><span class="ib-menu-dot ib-scheme-check"></span></span>
                            <Icon Name="icon" />
                            <span class="ib-menu-label">@label</span>
                        </a>
                    }
                </ChildContent>
            </Menu>
            break;
    }
</ib-scheme-switch>

@code {
    /// <summary>
    /// How it looks: <see cref="ColorSchemeSwitchVariant.Menu"/> (an icon button with a menu, the
    /// default), <see cref="ColorSchemeSwitchVariant.Toggle"/> or <see cref="ColorSchemeSwitchVariant.Segmented"/>.
    /// </summary>
    [Parameter] public ColorSchemeSwitchVariant Variant { get; set; } = ColorSchemeSwitchVariant.Menu;

    /// <summary>
    /// The chosen scheme. Leave it unset to show the user's choice from the cookie. Bind it on
    /// interactive pages to follow the user's choice; setting it from C# there applies that scheme
    /// to the page, the cookie and other tabs, as a click would.
    /// </summary>
    [Parameter] public ColorScheme? Value { get; set; }

    /// <summary>Raised on interactive pages when the user picks a scheme.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<ColorScheme> ValueChanged { get; set; }

    /// <summary>Segmented only: icons without the labels (the names stay for screen readers and as tooltips).</summary>
    [Parameter] public bool IconOnly { get; set; }

    /// <summary>Height. Defaults to medium, the size of a header's icon buttons.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>The button's or group's accessible name. Defaults to "Color scheme".</summary>
    [Parameter] public string? Label { get; set; }

    private const string StateKey = "ib-scheme";

    private string? _class;
    private string? _style;
    private ColorScheme _current;
    private ColorScheme? _remembered;
    private PersistingComponentStateSubscription? _persisting;

    private bool Live => RendererInfo.IsInteractive;

    private string GroupLabel => Label ?? TextDefaults.ColorScheme;

    private string ButtonClass => Size switch
    {
        ControlSize.Sm => "ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm",
        ControlSize.Lg => "ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-lg",
        _ => "ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only",
    };

    private IEnumerable<(ColorScheme Scheme, IconData Icon, string Label)> Options =>
    [
        (ColorScheme.Auto, IconSet.Current.Get(IconRole.SchemeSystem), TextDefaults.SchemeSystem),
        (ColorScheme.Light, IconSet.Current.Get(IconRole.SchemeLight), TextDefaults.SchemeLight),
        (ColorScheme.Dark, IconSet.Current.Get(IconRole.SchemeDark), TextDefaults.SchemeDark),
    ];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // The cookie is there on the server's first render; an interactive render after a prerender
        // gets it handed over through persisted state.
        var state = Services.GetService<PersistentComponentState>();
        if (state is not null && PersistedState.TryTake(state, StateKey, PersistedStateJson.Default.ColorScheme, out var handedOver))
        {
            _remembered = handedOver;
        }
        else if (!RendererInfo.IsInteractive)
        {
            _remembered = ColorSchemes.Parse(Services.GetService<IRequestCookies>()?.Get(ColorSchemes.CookieName));
        }

        if (state is not null && _remembered is { } remembered)
        {
            _persisting = state.RegisterOnPersisting(() =>
            {
                PersistedState.Persist(state, StateKey, remembered, PersistedStateJson.Default.ColorScheme);
                return Task.CompletedTask;
            });
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _current = Value ?? _remembered ?? ColorScheme.Auto;
        (_class, _style) = BuildRootAttributes();
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-scheme-switch");
        base.BuildAttributes(classes, styles);

        classes.Add($"ib-scheme-switch-{Variant.ToString().ToLowerInvariant()}");
        if (Variant == ColorSchemeSwitchVariant.Segmented)
        {
            classes.Add("ib-segmented");
            classes.Add($"ib-scheme-switch-{Size.ToString().ToLowerInvariant()}");
            classes.Add("ib-segmented-icon-only", IconOnly);
        }
    }

    // The no-script route: the endpoint sets the cookie and redirects back to this page.
    private string Href(ColorScheme scheme) =>
        $"_izzy/scheme?value={ColorSchemes.Name(scheme)}&return={Uri.EscapeDataString(Navigation.ToBaseRelativePath(Navigation.Uri))}";

    // The script already changed the page and the cookie; keep the component (and a binding) in step.
    // Compared with the bound Value, not _current: an interactive render that wasn't prerendered
    // can't read the cookie, so _current may say System while the page is dark.
    private async Task OnSchemeAsync(IzzySchemeEventArgs e)
    {
        if (ColorSchemes.Parse(e.Scheme) is not { } scheme || (Value is { } bound && scheme == bound))
        {
            return;
        }

        _remembered = scheme;
        _current = scheme;
        await ValueChanged.InvokeAsync(scheme);
    }

    /// <inheritdoc />
    public void Dispose() => _persisting?.Dispose();
}
