@namespace IzzyBlazor
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@attribute [ModeSupport]

@*
    The theme in one place. For the app, put it in App.razor's <head>:

    <IzzyTheme Preset="ThemePreset.Compact" Brand="#0a7d5a" BodyFont="Inter, sans-serif" />

    Preset sets density, shape and type; Brand, Gray, Radius, Density and the fonts override its
    defaults; ColorScheme is the default light or dark. Brand and Gray take a built-in name or a hex
    color. Everything is server-rendered (meta tags the theme CSS matches, and a small <style> block
    for hex colors and the fonts), so it's in place on first paint, needs no script and works in
    every render mode.

    With content, it themes that part of the page instead, in a div: Brand, a built-in Gray,
    Radius, Density, Preset (shape, density and depth only) and ColorScheme; what it doesn't set
    comes from around it. Fonts, HeadingWeight and a hex Gray are app-wide only. For one exact value, use CSS:
    its variable in your stylesheet, or Style and Class on a nested IzzyTheme (docs/styling.md).

    Accessibility:
    - It renders nothing people interact with: tags in the `head`, or a `div` around its content.
    - With `ColorScheme` unset the page follows the device's light or dark setting, and a choice
      made with a ColorSchemeSwitch wins over the default.
    - It sets CSS `color-scheme`, so the browser's own controls and scrollbars match the scheme.
    - A hex `Brand` is adjusted until text on it, and the accent as text, reach 4.5:1 contrast; a
      hex `Gray` keeps muted text at 4.5:1 or more on the page and surfaces.
    See also: ColorSchemeSwitch, AppShell.
*@

@if (ChildContent is null)
{
    @if (Preset is { } preset)
    {
        <meta name="ib-preset" content="@Name(preset)" />
    }
    @if (_brand.Name is { } brand)
    {
        <meta name="ib-brand" content="@brand" />
    }
    @if (_gray.Name is { } gray)
    {
        <meta name="ib-gray" content="@gray" />
    }
    @if (Radius is { } radius)
    {
        <meta name="ib-radius" content="@Name(radius)" />
    }
    @if (Density is { } density)
    {
        <meta name="ib-density" content="@Name(density)" />
    }
    @if (Scrollbars is { } scrollbars && scrollbars != ThemeScrollbars.Auto)
    {
        <meta name="ib-scrollbars" content="@Name(scrollbars)" />
    }
    @if (_scheme is IzzyBlazor.ColorScheme.Light or IzzyBlazor.ColorScheme.Dark)
    {
        <meta name="ib-color-scheme" content="@ColorSchemes.Name(_scheme.Value)" />
    }
    @if (_css is not null)
    {
        <style nonce="@Nonce" data-ib-theme-style>@((MarkupString)_css)</style>
    }
}
else
{
    <div @attributes="AdditionalAttributes"
         class="@_partClass"
         style="@_partStyle"
         data-ib-preset="@NameOrNull(Preset)"
         data-ib-brand="@_brand.Name"
         data-ib-gray="@_gray.Name"
         data-ib-radius="@NameOrNull(Radius)"
         data-ib-density="@NameOrNull(Density)">
        @ChildContent
    </div>
}

@code {
    /// <summary>
    /// The starting set of defaults: density, shape and type, and a default accent and gray, which
    /// the other settings override. Unset: Standard.
    /// </summary>
    [Parameter] public ThemePreset? Preset { get; set; }

    /// <summary>
    /// The brand color, over the preset's: a hex color (<c>"#0a7d5a"</c>), from which the fill, the text
    /// on it, the accent as text and the soft tint are derived in light and dark, each pair at AA
    /// (see <see cref="BrandPalette"/>); or a built-in, hand-tuned one: <c>blue</c> (the default),
    /// <c>ink</c> (monochrome), <c>indigo</c>, <c>violet</c>, <c>teal</c>, <c>green</c>, <c>rose</c>.
    /// <see cref="Accent.Primary"/> controls are painted with it.
    /// </summary>
    [Parameter] public string? Brand { get; set; }

    /// <summary>
    /// The grays (page, surfaces, fills, borders and text), over the preset's: a built-in set,
    /// <c>neutral</c> (the default), <c>slate</c> (cool) or <c>stone</c> (warm paper); or a hex color
    /// for your light page background (<c>"#f4efe6"</c>), from which the rest is derived with contrast
    /// checked (see <see cref="GrayPalette"/>). A hex gray is app-wide only.
    /// </summary>
    [Parameter] public string? Gray { get; set; }

    /// <summary>The radius scale, over the preset's.</summary>
    [Parameter] public ThemeRadius? Radius { get; set; }

    /// <summary>Control heights, table rows and card padding, over the preset's.</summary>
    [Parameter] public ThemeDensity? Density { get; set; }

    /// <summary>
    /// The body font, as a CSS font-family list (<c>"Sora, system-ui, sans-serif"</c>). Inter, served
    /// with IzzyBlazor, when unset. Load any other font yourself; end the list with a generic family
    /// so text shows while it loads.
    /// </summary>
    [Parameter] public string? BodyFont { get; set; }

    /// <summary>
    /// The font for headings, card and dialog titles, as a CSS font-family list. Unset: the preset's
    /// (the body font, or Newsreader in Editorial).
    /// </summary>
    [Parameter] public string? HeadingFont { get; set; }

    /// <summary>
    /// The font for code, Kbd and the color picker's hex box, as a CSS font-family list, such as
    /// <c>"'JetBrains Mono', ui-monospace, monospace"</c>. Unset: the system's monospace font.
    /// </summary>
    [Parameter] public string? MonoFont { get; set; }

    /// <summary>The headings' weight, 100 to 900. Unset: semibold (600).</summary>
    [Parameter] public int? HeadingWeight { get; set; }

    /// <summary>
    /// The color scheme until the user picks one with a <see cref="ColorSchemeSwitch"/> (their
    /// choice, kept in the <c>ib-scheme</c> cookie, wins). Unset or <see cref="ColorScheme.Auto"/>:
    /// follow the device. <see cref="ColorScheme.Inverse"/> is for part of a page only.
    /// </summary>
    [Parameter] public ColorScheme? ColorScheme { get; set; }

    /// <summary>
    /// Whose scrollbars the app uses. Unset or <see cref="ThemeScrollbars.Auto"/>: the system's on the
    /// page, thin themed ones in the library's scroll areas. <see cref="ThemeScrollbars.Themed"/> puts
    /// the thin ones on the page too (always visible); <see cref="ThemeScrollbars.Native"/> uses the
    /// system's everywhere. App-wide only.
    /// </summary>
    [Parameter] public ThemeScrollbars? Scrollbars { get; set; }

    /// <summary>A CSP nonce for the style element, if your Content-Security-Policy needs one. Toolbars on the page use it too.</summary>
    [Parameter] public string? Nonce { get; set; }

    /// <summary>The part of the page to theme. Unset: the theme is the app's (put it in <c>&lt;head&gt;</c>).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Classes for the part's div, such as one that sets CSS variables in your stylesheet.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Inline style for the part's div, such as <c>"--ib-card-padding: 1rem"</c>.</summary>
    [Parameter] public string? Style { get; set; }

    /// <summary>Other attributes for the part's div.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string? _css;
    private IzzyBlazor.ColorScheme? _scheme;
    private string? _partClass;
    private string? _partStyle;
    private (string? Name, string? Hex) _brand;
    private (string? Name, string? Hex) _gray;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _brand = string.IsNullOrWhiteSpace(Brand) ? default : ThemeColors.Parse(Brand, ThemeColors.Brands, nameof(Brand));
        _gray = string.IsNullOrWhiteSpace(Gray) ? default : ThemeColors.Parse(Gray, ThemeColors.Grays, nameof(Gray));
        if (ChildContent is not null)
        {
            SetPart();
            return;
        }

        // Unknown attributes are mistakes on the app's theme (it renders only meta tags).
        if (AdditionalAttributes is { Count: > 0 } || Class is not null || Style is not null)
        {
            var name = AdditionalAttributes?.Keys.FirstOrDefault() ?? (Class is not null ? nameof(Class) : nameof(Style));
            throw new ArgumentException($"The app's IzzyTheme has no \"{name}\": Class, Style and other attributes are for a nested IzzyTheme (one with content).", name);
        }

        if (ColorScheme == IzzyBlazor.ColorScheme.Inverse)
        {
            throw new ArgumentException("The app's ColorScheme is Auto, Light or Dark; Inverse is for part of a page.", nameof(ColorScheme));
        }

        // A Toolbar in the same request writes its own style element with the same nonce.
        if (Nonce is not null && Services.GetService<StyleNonce>() is { } nonce)
        {
            nonce.Value = Nonce;
        }

        // The user's choice from a ColorSchemeSwitch, read on the server (the IzzyBlazor package
        // registers IRequestCookies), else the app's default.
        _scheme = ColorSchemes.Parse(Services.GetService<IRequestCookies>()?.Get(ColorSchemes.CookieName)) ?? ColorScheme;

        var declarations = new List<string>();
        if (_brand.Hex is { } brandHex)
        {
            declarations.Add(BrandPalette.From(brandHex).ToCss());
        }

        if (_gray.Hex is { } grayHex)
        {
            declarations.Add(GrayPalette.From(grayHex).ToCss());
        }

        if (!string.IsNullOrWhiteSpace(BodyFont))
        {
            declarations.Add($"--ib-font-body: {FontList(BodyFont, nameof(BodyFont))};");
        }

        if (!string.IsNullOrWhiteSpace(HeadingFont))
        {
            declarations.Add($"--ib-font-heading: {FontList(HeadingFont, nameof(HeadingFont))};");
        }

        if (!string.IsNullOrWhiteSpace(MonoFont))
        {
            declarations.Add($"--ib-font-mono: {FontList(MonoFont, nameof(MonoFont))};");
        }

        if (HeadingWeight is { } weight)
        {
            if (weight is < 100 or > 900)
            {
                throw new ArgumentOutOfRangeException(nameof(HeadingWeight), weight, "HeadingWeight is a CSS font weight, 100 to 900.");
            }

            declarations.Add(string.Create(System.Globalization.CultureInfo.InvariantCulture, $"--ib-weight-heading: {weight};"));
        }

        // In the tokens layer like the library's own values, and written as :root:root:root so it
        // beats a preset's or an accent's values on <html> whatever order the stylesheets load in.
        _css = declarations.Count == 0
            ? null
            : "@layer izzy.tokens { :root:root:root { " + string.Join(" ", declarations) + " } }";
    }

    // Part of a page: the same choices as attributes on the div, and a brand color as inline
    // variables. The colors derived from them (focus, halo, hover) follow, as they're worked out
    // where they're used.
    private void SetPart()
    {
        foreach (var (value, name) in new[] { (BodyFont, nameof(BodyFont)), (HeadingFont, nameof(HeadingFont)), (MonoFont, nameof(MonoFont)) })
        {
            if (!string.IsNullOrWhiteSpace(value))
            {
                throw new ArgumentException($"{name} is app-wide: set it on the IzzyTheme in <head>.", name);
            }
        }

        if (Scrollbars is not null)
        {
            throw new ArgumentException("Scrollbars is app-wide: set it on the IzzyTheme in <head>.", nameof(Scrollbars));
        }

        if (HeadingWeight is not null)
        {
            throw new ArgumentException("HeadingWeight is app-wide: set it on the IzzyTheme in <head>.", nameof(HeadingWeight));
        }

        if (_gray.Hex is not null)
        {
            throw new ArgumentException("A hex Gray is app-wide: set it on the IzzyTheme in <head>. Part of a page takes a built-in gray (neutral, slate, stone).", nameof(Gray));
        }

        var classes = new ClassBuilder().Add("ib-theme").Add(ColorScheme?.ClassName()).Add(Class);
        var styles = new StyleBuilder();
        if (_brand.Hex is { } brandHex)
        {
            styles.AddRaw(BrandPalette.From(brandHex).ToCss());
        }

        styles.AddRaw(Style);
        _partClass = classes.Build();
        _partStyle = styles.Build();
    }

    private static string Name<T>(T value) where T : struct, Enum => value.ToString().ToLowerInvariant();

    private static string? NameOrNull<T>(T? value) where T : struct, Enum => value is { } v ? Name(v) : null;

    // A font-family list goes into a style block as is, so it may not close the declaration,
    // the rule or the element.
    private static string FontList(string value, string parameter)
    {
        // No way out of the declaration or the style element, and no open string or block: an
        // unclosed quote, bracket or parenthesis (or a newline, which ends a CSS string) would
        // swallow every declaration after it. A font-family list needs none of ( ) [ ].
        var list = value.Trim();
        if (list.IndexOfAny([';', '{', '}', '<', '>', '\\', '(', ')', '[', ']']) >= 0 || list.Contains("/*", StringComparison.Ordinal)
            || list.Any(char.IsControl) || !QuotesClose(list))
        {
            throw new ArgumentException($"{parameter} is a CSS font-family list, such as \"Inter, system-ui, sans-serif\".", parameter);
        }

        return list;
    }

    // Every quoted family name ends with the quote it started with.
    private static bool QuotesClose(string list)
    {
        char? open = null;
        foreach (var c in list)
        {
            if (open is null && c is '\'' or '"')
            {
                open = c;
            }
            else if (c == open)
            {
                open = null;
            }
        }

        return open is null;
    }
}
