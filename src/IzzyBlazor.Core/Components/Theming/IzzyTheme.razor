@namespace IzzyBlazor
@using Microsoft.Extensions.DependencyInjection
@inherits ThemeBase
@inject IServiceProvider Services
@attribute [ModeSupport]

@*
    The app's theme in one place. Put it in App.razor's <head>:

    <IzzyTheme Preset="ThemePreset.Compact" Brand="#0a7d5a" BodyFont="Inter, sans-serif" />

    `Preset` sets density, shape and type; `Brand`, Gray, Radius, Density and the fonts override its
    defaults; ColorScheme is the default light or dark. `Brand` and Gray take a built-in name or a hex
    color. Everything is server-rendered (meta tags the theme CSS matches, and a small <style> block
    for hex colors and the fonts), so it's in place on first paint, needs no script and works in
    every render mode.

    To theme part of a page, use ThemeScope. For one exact value, use CSS: its variable in your
    stylesheet (izzyblazor.com/docs/theming/tokens).

    With the default body font, it preloads Inter's Latin file. An app that sets its own body font
    should set it here, as `BodyFont`, rather than in CSS: then nothing is preloaded.

    Accessibility:
    - It renders nothing people interact with: tags in the `head`.
    - With `ColorScheme` unset the page follows the device's light or dark setting, and a choice
      made with a ColorSchemeSwitch wins over the default.
    - It sets CSS `color-scheme`, so the browser's own controls and scrollbars match the scheme.
    - A hex `Brand` is adjusted until text on it, and the accent as text, reach 4.5:1 contrast; a
      hex `Gray` keeps muted text at 4.5:1 or more on the page and surfaces.
    See also: ThemeScope, ColorSchemeSwitch, AppShell.
*@

@if (string.IsNullOrWhiteSpace(BodyFont) && Preset != ThemePreset.Editorial)
{
    @* Inter, the default body font: its Latin file, fetched with the stylesheet rather than once text
       is laid out, so text doesn't paint in a fallback font and then rewrap. The URL is the one
       izzyblazor.css uses. *@
    <link rel="preload" href="_content/IzzyBlazor.Core/fonts/inter-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
}
@if (Preset is { } preset)
{
    <meta name="ib-preset" content="@Name(preset)" />
}
@if (BrandColor.Name is { } brand)
{
    <meta name="ib-brand" content="@brand" />
}
@if (GrayColor.Name is { } gray)
{
    <meta name="ib-gray" content="@gray" />
}
@if (Radius is { } radius)
{
    <meta name="ib-radius" content="@Name(radius)" />
}
@if (Density is { } density)
{
    <meta name="ib-density" content="@Name(density)" />
}
@if (Scrollbars is { } scrollbars && scrollbars != ThemeScrollbars.Auto)
{
    <meta name="ib-scrollbars" content="@Name(scrollbars)" />
}
@if (_scheme is IzzyBlazor.ColorScheme.Light or IzzyBlazor.ColorScheme.Dark)
{
    <meta name="ib-color-scheme" content="@ColorSchemes.Name(_scheme.Value)" />
}
@if (_css is not null)
{
    <style nonce="@Nonce" data-ib-theme-style>@((MarkupString)_css)</style>
}
@code {
    /// <summary>
    /// The body font, as a CSS font-family list (<c>"Sora, system-ui, sans-serif"</c>). Inter, served
    /// with IzzyBlazor, when unset. Load any other font yourself; end the list with a generic family
    /// so text shows while it loads.
    /// </summary>
    [Parameter] public string? BodyFont { get; set; }

    /// <summary>
    /// The font for headings, card and dialog titles, as a CSS font-family list. Unset: the preset's
    /// (the body font, or Newsreader in Editorial).
    /// </summary>
    [Parameter] public string? HeadingFont { get; set; }

    /// <summary>
    /// The font for code, Kbd and the color picker's hex box, as a CSS font-family list, such as
    /// <c>"'JetBrains Mono', ui-monospace, monospace"</c>. Unset: the system's monospace font.
    /// </summary>
    [Parameter] public string? MonoFont { get; set; }

    /// <summary>The headings' weight, 100 to 900. Unset: semibold (600).</summary>
    [Parameter] public int? HeadingWeight { get; set; }

    /// <summary>
    /// The color scheme until the user picks one with a <see cref="ColorSchemeSwitch"/> (their
    /// choice, kept in the <c>ib-scheme</c> cookie, wins). Unset or <see cref="ColorScheme.Auto"/>:
    /// follow the device. <see cref="ColorScheme.Inverse"/> is for a <see cref="ThemeScope"/>.
    /// </summary>
    [Parameter] public ColorScheme? ColorScheme { get; set; }

    /// <summary>
    /// Whose scrollbars the app uses. Unset or <see cref="ThemeScrollbars.Auto"/>: the system's on the
    /// page, thin themed ones in the library's scroll areas. <see cref="ThemeScrollbars.Themed"/> puts
    /// the thin ones on the page too (always visible); <see cref="ThemeScrollbars.Native"/> uses the
    /// system's everywhere.
    /// </summary>
    [Parameter] public ThemeScrollbars? Scrollbars { get; set; }

    /// <summary>A CSP nonce for the style element, if your Content-Security-Policy needs one. Toolbars on the page use it too.</summary>
    [Parameter] public string? Nonce { get; set; }

    private string? _css;
    private IzzyBlazor.ColorScheme? _scheme;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ColorScheme == IzzyBlazor.ColorScheme.Inverse)
        {
            throw new ArgumentException("The app's ColorScheme is Auto, Light or Dark; Inverse is for part of a page, on a ThemeScope.", nameof(ColorScheme));
        }

        // A Toolbar in the same request writes its own style element with the same nonce.
        if (Nonce is not null && Services.GetService<StyleNonce>() is { } nonce)
        {
            nonce.Value = Nonce;
        }

        // The user's choice from a ColorSchemeSwitch, read on the server (the IzzyBlazor package
        // registers IRequestCookies), else the app's default.
        _scheme = ColorSchemes.Parse(Services.GetService<IRequestCookies>()?.Get(ColorSchemes.CookieName)) ?? ColorScheme;

        var declarations = new List<string>();
        if (BrandColor.Hex is { } brandHex)
        {
            declarations.Add(BrandPalette.From(brandHex).ToCss());
        }

        if (GrayColor.Hex is { } grayHex)
        {
            declarations.Add(GrayPalette.From(grayHex).ToCss());
        }

        if (!string.IsNullOrWhiteSpace(BodyFont))
        {
            declarations.Add($"--ib-font-body: {FontList(BodyFont, nameof(BodyFont))};");
        }

        if (!string.IsNullOrWhiteSpace(HeadingFont))
        {
            declarations.Add($"--ib-font-heading: {FontList(HeadingFont, nameof(HeadingFont))};");
        }

        if (!string.IsNullOrWhiteSpace(MonoFont))
        {
            declarations.Add($"--ib-font-mono: {FontList(MonoFont, nameof(MonoFont))};");
        }

        if (HeadingWeight is { } weight)
        {
            if (weight is < 100 or > 900)
            {
                throw new ArgumentOutOfRangeException(nameof(HeadingWeight), weight, "HeadingWeight is a CSS font weight, 100 to 900.");
            }

            declarations.Add(string.Create(System.Globalization.CultureInfo.InvariantCulture, $"--ib-weight-heading: {weight};"));
        }

        // In the tokens layer like the library's own values, and written as :root:root:root so it
        // beats a preset's or an accent's values on <html> whatever order the stylesheets load in.
        _css = declarations.Count == 0
            ? null
            : "@layer izzy.tokens { :root:root:root { " + string.Join(" ", declarations) + " } }";
    }

    // A font-family list goes into a style block as is, so it may not close the declaration,
    // the rule or the element.
    private static string FontList(string value, string parameter)
    {
        // No way out of the declaration or the style element, and no open string or block: an
        // unclosed quote, bracket or parenthesis (or a newline, which ends a CSS string) would
        // swallow every declaration after it. A font-family list needs none of ( ) [ ].
        var list = value.Trim();
        if (list.IndexOfAny([';', '{', '}', '<', '>', '\\', '(', ')', '[', ']']) >= 0 || list.Contains("/*", StringComparison.Ordinal)
            || list.Any(char.IsControl) || !QuotesClose(list))
        {
            throw new ArgumentException($"{parameter} is a CSS font-family list, such as \"Inter, system-ui, sans-serif\".", parameter);
        }

        return list;
    }

    // Every quoted family name ends with the quote it started with.
    private static bool QuotesClose(string list)
    {
        char? open = null;
        foreach (var c in list)
        {
            if (open is null && c is '\'' or '"')
            {
                open = c;
            }
            else if (c == open)
            {
                open = null;
            }
        }

        return open is null;
    }
}
