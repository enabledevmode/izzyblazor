@namespace IzzyBlazor
@inherits IzzyComponentBase

@*
    The page frame. Put the parts you need inside it, in any order; the shell arranges itself
    from the parts that are present, with CSS alone, so it renders correctly on static pages:

    <AppShell>
        <AppHeader> <SidebarToggle /> <strong>My app</strong> </AppHeader>
        <AppSidebar> <NavMenu>...</NavMenu> </AppSidebar>
        <AppMain> @Body </AppMain>
        <AppAside> On this page </AppAside>
        <AppFooter> © My app </AppFooter>
    </AppShell>

    Each part owns its settings: colors, sticky header and footer, sidebar side, width,
    breakpoint and full height. The shell owns what applies to the whole frame: what scrolls
    and whether the parts are separated by lines.
*@

<ib-shell @attributes="AdditionalAttributes" class="@_class" style="@_style">
    <a class="ib-skip-link" href="@($"#{MainId}")">Skip to content</a>
    <CascadingValue Value="_context" IsFixed="true">
        @ChildContent
    </CascadingValue>
</ib-shell>

@code {
    /// <summary>The parts: <see cref="AppHeader"/>, <see cref="AppSidebar"/>, <see cref="AppMain"/>, <see cref="AppAside"/>, <see cref="AppFooter"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// What scrolls: the whole page (<see cref="ShellScroll.Page"/>, the default) or only the main
    /// area inside a window-filling frame (<see cref="ShellScroll.Main"/>).
    /// </summary>
    [Parameter] public ShellScroll ScrollMode { get; set; } = ShellScroll.Page;

    /// <summary>
    /// How the parts are layered: <see cref="ShellVariant.Tinted"/> (the default) tints the
    /// sidebar, <see cref="ShellVariant.Inset"/> raises the main area as a panel in a tinted frame,
    /// <see cref="ShellVariant.Flat"/> is all surface, <see cref="ShellVariant.Canvas"/> tints the main area.
    /// </summary>
    [Parameter] public ShellVariant Variant { get; set; } = ShellVariant.Tinted;

    /// <summary>
    /// Lines between the parts. Defaults to true; set false when the parts' colors separate them,
    /// or for one flat surface.
    /// </summary>
    [Parameter] public bool Dividers { get; set; } = true;

    /// <summary>
    /// Centers the content of the header, main area and footer at this width, such as
    /// <c>Length.Rem(48)</c> for a reading site, so their edges line up; the bars and their lines
    /// stay full width. Each part's own <c>ContentWidth</c> overrides it (a wider header over a
    /// narrow article, say). Unset by default: content fills the parts.
    /// </summary>
    [Parameter] public Length? ContentWidth { get; set; }

    /// <summary>The main area's id, which the skip link targets. Defaults to <c>ib-main</c>.</summary>
    [Parameter] public string MainId { get; set; } = "ib-main";

    private AppShellContext _context = null!;
    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-shell");
        classes.Add(ScrollMode == ShellScroll.Main ? "ib-shell-scroll-main" : "ib-shell-scroll-page");
        classes.Add(Variant switch
        {
            ShellVariant.Inset => "ib-shell-inset",
            ShellVariant.Flat => "ib-shell-flat",
            ShellVariant.Canvas => "ib-shell-canvas",
            _ => "ib-shell-tinted",
        });
        if (!Dividers)
        {
            styles.AddVar("shell-divider", "transparent");
        }

        if (ContentWidth is { } width)
        {
            classes.Add("ib-shell-measured");
            styles.AddVar("shell-content-w", StyleValues.Length(width));
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _context ??= new AppShellContext(MainId);
        (_class, _style) = BuildRootAttributes();
    }
}
