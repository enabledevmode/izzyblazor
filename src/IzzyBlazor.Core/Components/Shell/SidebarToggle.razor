@namespace IzzyBlazor
@inherits LayoutItemBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

@*
    The menu button that opens an AppShell's sidebar below its breakpoint. Hidden above it.
    It is a link to the sidebar's id, so it works with no JavaScript; with JavaScript the shell
    opens the drawer without changing the URL, and makes it a button (role, Space, aria-expanded
    kept in step). With no JavaScript it stays a link: it couldn't keep aria-expanded true.

    When the sidebar is Collapsible, a second button takes its place above the breakpoint: a
    label for the sidebar's collapse checkbox, so it works with no JavaScript too. The checkbox
    itself is the control screen readers and keyboards use; this label is a mouse shortcut.
*@

@* Links carry the page's path: a bare "#id" resolves against <base href> and leads to another page. *@
<a @attributes="AdditionalAttributes"
   class="@_class"
   style="@_style"
   href="@PageLinks.ToFragment(Navigation, For)"
   aria-controls="@For"
   aria-label="@(Label ?? TextDefaults.OpenMenu)"
   data-ib-shell-toggle>
    <Icon Role="IconRole.Menu" />
</a>
<label class="@_collapseClass" style="@_style" for="@($"{For}-collapse")" aria-hidden="true" title="@(CollapseLabel ?? TextDefaults.CollapseSidebar)">
    <Icon Role="IconRole.Menu" />
</label>
@* A sidebar that opens as a panel under the header: while it's open this close button takes the
   menu button's place (CSS), so the same spot opens and closes it, with JavaScript off too. *@
<a class="@_closeClass"
   style="@_style"
   href="@PageLinks.ToFragment(Navigation, "ib-shell-closed")"
   aria-controls="@For"
   aria-label="@(CloseLabel ?? TextDefaults.CloseMenu)"
   data-ib-shell-close>
    <Icon Role="IconRole.Close" />
</a>

@code {
    /// <summary>The accessible name. Defaults to "Open menu".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The sidebar to open. Defaults to <c>ib-sidebar</c>, AppShell's default.</summary>
    [Parameter] public string For { get; set; } = "ib-sidebar";

    /// <summary>Visual weight. Defaults to ghost.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Ghost;

    /// <summary>
    /// The name of the button that takes the menu button's place while a
    /// <see cref="SidebarSmallScreen.Panel"/> sidebar is open. Defaults to "Close menu".
    /// </summary>
    [Parameter] public string? CloseLabel { get; set; }

    /// <summary>The tooltip on the wide-screen collapse button. Defaults to "Collapse sidebar".</summary>
    [Parameter] public string? CollapseLabel { get; set; }

    private string? _class;
    private string? _collapseClass;
    private string? _closeClass;
    private string? _style;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-btn ib-btn-neutral ib-btn-icon-only ib-shell-toggle");
        classes.Add($"ib-btn-{Variant.ToString().ToLowerInvariant()}");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        (_class, _style) = BuildRootAttributes();
        _collapseClass = _class?.Replace("ib-shell-toggle", "ib-shell-collapse-toggle");
        _closeClass = _class?.Replace("ib-shell-toggle", "ib-shell-toggle-close");
    }
}
