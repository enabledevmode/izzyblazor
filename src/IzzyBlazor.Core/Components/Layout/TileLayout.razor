@namespace IzzyBlazor
@using System.Globalization
@inherits LayoutItemBase
@attribute [ModeSupport]

@*
    A grid of tiles, each placed at a column and row and spanning some of each, such as the panels
    of a dashboard. The server draws the layout as it is, with no script, and cells can stay empty.

    <TileLayout Columns="new() { Base = 1, Md = 6, Lg = 12 }" RowHeight="Length.Rem(7)" State="_layout">
        <Tile Id="revenue" Title="Revenue" Col="1" Row="1" ColSpan="8" RowSpan="2">...</Tile>
        <Tile Id="orders" Title="Orders" Col="9" Row="1" ColSpan="4">...</Tile>
        <Tile Id="tickets" Title="Open tickets" ColSpan="4">...</Tile>
    </TileLayout>

    A Tile with both Col and Row goes there; one without them takes the first free cells, row by
    row, in the order written. State, a TileLayoutState saved for this person, overrides each
    tile's place and size by its Id; tiles it doesn't name keep their own. Spans are kept inside
    the columns (and Rows, when set). Each tile is as tall as the rows it spans, and its content
    scrolls inside it when longer.

    Columns can change by breakpoint. Places and spans are for the widest count; at each narrower
    one, spans shrink in proportion (8 of 12 is 4 of 6) and the tiles wrap in reading order, by
    row and then by column, with no empty cells. At 1 column they stack. Unless Base is set, the
    tiles stack below the first breakpoint given.

    Editable lets people rearrange the tiles at the widest column count. With script, dragging a
    tile moves it (from anywhere but its controls) and dragging its corner grip resizes it, a cell at a time; without
    AllowOverlap a tile stays at its last free spot rather than cover another. Each tile's handle
    opens a menu of the same moves, which with JavaScript off post the form.

    Accessibility:
    - The layout is a list and each tile an item, named by its title, so screen readers say how
      many tiles there are and which one they're in.
    - A tile's Title is a heading (TitleLevel, 3 by default), so screen readers can jump from tile
      to tile.
    - Screen readers and the Tab key follow the order the tiles are written in, not where they're
      drawn. Write them in reading order (by row, then by column), or sort the tiles you render
      from a list by their saved place.
    - In an editable layout, each tile's handle is a button named "Move" and the tile's name, whose
      menu moves and resizes it; nothing needs dragging. Each move is announced: "Moved Revenue to
      column 3, row 1", "Resized Revenue to 6 by 2 cells".

    Keyboard:
    - Alt+Left, Alt+Right, Alt+Up, Alt+Down | On a tile's handle, move the tile a cell (Left and
      Right reversed on right-to-left pages)
    - Alt+Shift+Right, Alt+Shift+Left | On a tile's handle, make it a column wider or narrower
    - Alt+Shift+Down, Alt+Shift+Up | On a tile's handle, make it a row taller or shorter
    - Escape | While dragging, put the tile back
    See also: Grid, Card, Stat.
*@

<link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/tile-layout.css"]" />
@if (Editable)
{
    @* The script: dragging and resizing, and the menu's moves in place on a static page. *@
    <ib-tile-layout @attributes="AdditionalAttributes" class="@_class" style="@_style" role="list"
                    data-ib-at="@(Levels[^1].Breakpoint is { } at ? at.Name() : "")"
                    data-ib-cols="@Levels[^1].Columns.ToString(CultureInfo.InvariantCulture)"
                    data-ib-rows="@_context.RowLimit.ToString(CultureInfo.InvariantCulture)"
                    data-ib-overlap="@(AllowOverlap ? "" : null)"
                    data-ib-interactive="@(Live ? "" : null)"
                    data-ib-seq="@(RendererInfo.IsInteractive ? _seq.ToString(CultureInfo.InvariantCulture) : null)"
                    data-ib-moved="@TextDefaults.TileMovedTo" data-ib-resized="@TextDefaults.TileResizedTo"
                    @onibtiles="OnTilesAsync" __internal_stopPropagation_onibtiles="@RendererInfo.IsInteractive">
        @Inner
    </ib-tile-layout>
}
else
{
    <div @attributes="AdditionalAttributes" class="@_class" style="@_style" role="list">@Inner</div>
}

@code {
    /// <summary>The <see cref="Tile"/>s.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// How many columns, all the same width, per breakpoint. Defaults to 1, then 12 from
    /// <see cref="Breakpoint.Md"/>. Tiles are placed at the widest count; at narrower ones they
    /// wrap in reading order, their spans shrunk in proportion. Unless <c>Base</c> is set, it's 1.
    /// </summary>
    [Parameter] public Responsive<int> Columns { get; set; } = new() { Base = 1, Md = 12 };

    /// <summary>
    /// How many rows at the widest column count, up to 200. Tiles are kept inside them, and the
    /// layout is as tall as all of them, empty ones included. Defaults to 0: as many as the tiles
    /// need, up to 200. At fewer columns, as many as the tiles need.
    /// </summary>
    [Parameter] public int Rows { get; set; }

    /// <summary>The height of a row. Defaults to 8rem.</summary>
    [Parameter] public Length RowHeight { get; set; } = Length.Rem(8);

    /// <summary>Space between tiles, in spacing steps (0 to 16). Defaults to 4.</summary>
    [Parameter] public int Gap { get; set; } = 4;

    /// <summary>
    /// The layout saved for this person: each tile's place and size by its <see cref="Tile.Id"/>.
    /// Tiles it doesn't name keep their own; entries for tiles that aren't there are ignored.
    /// </summary>
    [Parameter] public TileLayoutState? State { get; set; }

    /// <summary>
    /// Runs with the new layout after each move on an interactive page; use <c>@bind-State</c> and
    /// save it here.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<TileLayoutState> StateChanged { get; set; }

    /// <summary>
    /// Lets the user move and resize the tiles: each gets a handle whose menu moves it a cell at a
    /// time and makes it wider, narrower, taller or shorter. Only at the widest column count; at
    /// fewer columns the handles hide. On a static page it needs a <see cref="Name"/> inside a form.
    /// </summary>
    [Parameter, ModeSupport(NoScriptNotes = "Each move from a tile's menu posts the form.")]
    public bool Editable { get; set; }

    /// <summary>While <see cref="Editable"/>, outlines every cell, so the user sees where tiles can go.</summary>
    [Parameter] public bool ShowGrid { get; set; }

    /// <summary>Lets a tile move or grow over another. By default a move that would cover a tile isn't offered.</summary>
    [Parameter] public bool AllowOverlap { get; set; }

    /// <summary>
    /// On a static page, the name an editable layout posts under: <c>{Name}.Tiles</c> (the layout
    /// shown) and <c>{Name}.Move</c> (a move from a tile's menu), bound as a
    /// <see cref="TileLayoutPost"/>. Pass that back as <see cref="Post"/>.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>
    /// On a static page, what the layout posted, bound under its <see cref="Name"/>: it shows the
    /// posted layout with the posted move made, over <see cref="State"/>.
    /// </summary>
    [Parameter] public TileLayoutPost? Post { get; set; }

    private readonly TileLayoutContext _context;

    /// <summary>Each column count and the breakpoint it starts at (null for the base), narrowest width first.</summary>
    internal IReadOnlyList<(Breakpoint? Breakpoint, int Columns)> Levels { get; private set; } = [];
    private string? _class;
    private string? _style;
    private RenderFragment Inner => __builder =>
    {
        <CascadingValue Value="_context" IsFixed="true">
            @ChildContent
            @Extras
        </CascadingValue>
    };

    // Drawn after the tiles, which it needs placed. (Internal, so built here rather than as a tag.)
    private RenderFragment Extras => builder =>
    {
        builder.OpenComponent<TileLayoutExtras>(0);
        builder.AddComponentParameter(1, nameof(TileLayoutExtras.Context), _context);
        builder.AddComponentParameter(2, nameof(TileLayoutExtras.Version), _version);
        builder.CloseComponent();
    };

    private TileLayoutState? _live;

    // The last change from the script this layout has handled (an interactive page's drag).
    private int _seq;
    private TileLayoutState? _lastState;
    private int _version;

    // Interactive (or prerendering for it): C# makes the moves.
    internal bool Live => WillBeInteractive;

    /// <summary>The layout to draw: what a static page posted, else a move made here, else <see cref="State"/>.</summary>
    internal TileLayoutState? EffectiveState => Post?.State is { } posted && !Live ? posted : _live ?? State;

    /// <summary>The move a static page posted, made as the tiles are placed.</summary>
    internal TileMove? PendingMove { get; private set; }

    /// <summary>The tile whose handle takes focus after a static page's move.</summary>
    internal string? FocusId { get; private set; }

    /// <summary>The tile that last moved, and what its live region says.</summary>
    internal (Tile Tile, string Text)? Announcement { get; private set; }

    internal void Moved(Tile tile, TileMoveKind kind, TilePlace to)
    {
        FocusId = Live ? null : tile.Id;
        var text = kind is TileMoveKind.Left or TileMoveKind.Right or TileMoveKind.Up or TileMoveKind.Down
            ? string.Format(CultureInfo.CurrentCulture, TextDefaults.TileMovedTo, tile.AccessibleName, to.Col, to.Row)
            : string.Format(CultureInfo.CurrentCulture, TextDefaults.TileResizedTo, tile.AccessibleName, to.ColSpan, to.RowSpan);
        Announcement = (tile, text);
    }

    // A tile dragged or resized on an interactive page: the script sends the whole layout.
    private async Task OnTilesAsync(IzzyTilesEventArgs e)
    {
        _seq = Math.Max(_seq, e.Seq);
        if (TileLayoutState.Parse(e.Tiles) is not { } state)
        {
            return;
        }

        if (e.Id is { } id && _context.Find(id) is { } tile && state.Find(id) is { } now)
        {
            var was = _context.PlacesOf(tile)[^1];
            Moved(tile, now.ColSpan != was.ColSpan || now.RowSpan != was.RowSpan ? TileMoveKind.Wider : TileMoveKind.Left,
                new TilePlace(now.Col, now.Row, now.ColSpan, now.RowSpan));
        }

        _live = state;
        _context.Invalidate();
        _version++;
        await StateChanged.InvokeAsync(state);
    }

    // A move from a tile's menu on an interactive page.
    internal async Task MoveAsync(Tile tile, TileMoveKind kind)
    {
        if (!_context.TryMove(tile, kind, out var to))
        {
            return;
        }

        var state = _context.CurrentState(tile, to);
        _live = state;
        Moved(tile, kind, to);
        _context.Invalidate();
        _version++;
        await StateChanged.InvokeAsync(state);
        StateHasChanged();
    }

    /// <summary>Creates the layout.</summary>
    public TileLayout() => _context = new TileLayoutContext(this);

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-tiles");
        classes.Add("ib-tiles-editing", Editable);
        if (Editable && Levels[^1].Breakpoint is { } from)
        {
            classes.Add($"ib-tiles-edit-from-{from.Name()}");
        }

        base.BuildAttributes(classes, styles);
        foreach (var (breakpoint, columns) in Levels)
        {
            var suffix = breakpoint is { } b ? "-" + b.Name() : "";
            classes.Add($"ib-tiles-at{suffix}", breakpoint is not null);
            styles.AddVar("tiles-cols" + suffix, columns.ToString(CultureInfo.InvariantCulture));
        }

        // A fixed number of rows holds its height at the widest count, empty rows included.
        if (Rows > 0)
        {
            classes.Add($"ib-tiles-rows-at-{(Levels[^1].Breakpoint is { } widest ? widest.Name() : "base")}");
            styles.AddVar("tiles-rows", Rows.ToString(CultureInfo.InvariantCulture));
        }

        styles.AddVar("tiles-row-h", RowHeight.ToString());
        styles.AddVar("tiles-gap", StyleValues.Spacing(Gap));
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        var levels = Columns.Entries.ToList();
        if (levels.Count == 0 || levels[0].Breakpoint is not null)
        {
            levels.Insert(0, (null, 1));
        }

        if (levels.Any(l => l.Value < 1))
        {
            throw new InvalidOperationException("TileLayout's Columns must be at least 1 at every breakpoint.");
        }

        Levels = [.. levels.Select(l => (l.Breakpoint, l.Value))];

        if (Rows is < 0 or > TileLayoutContext.MostRows)
        {
            throw new InvalidOperationException($"TileLayout's Rows is 0 (as many as the tiles need, up to {TileLayoutContext.MostRows}) to {TileLayoutContext.MostRows}.");
        }

        if (Editable && !Live && string.IsNullOrEmpty(Name))
        {
            throw new InvalidOperationException("An Editable TileLayout on a static page needs a Name inside a form: its moves post the form, and the posted TileLayoutPost comes back as Post.");
        }

        // A new State from the page replaces moves made here.
        if (!ReferenceEquals(State, _lastState))
        {
            _lastState = State;
            _live = null;
        }

        PendingMove = Editable && !Live && TileMove.TryParse(Post?.Move, out var move) ? move : null;
        base.OnParametersSet();
        _context.BeginPass();
        (_class, _style) = BuildRootAttributes();
    }
}
