@namespace IzzyBlazor
@using System.Globalization
@inherits IzzyComponentBase
@implements IDisposable

@*
    One tile of a TileLayout: a header with an icon, title and actions, over its content. It sits
    at Col and Row and spans ColSpan columns and RowSpan rows; without Col and Row it takes the
    first free cells.

    <Tile Id="revenue" Title="Revenue" Icon="Lucide.ChartLine" Col="1" Row="1" ColSpan="8" RowSpan="2">
        <Actions>
            <IconButton Icon="Lucide.RefreshCw" Label="Refresh" />
        </Actions>
        <ChildContent>...</ChildContent>
    </Tile>

    Header replaces the icon and title with your own content; Actions stay at the end of the
    header. A tile with none of these has no header. In an Editable layout the tile's handle
    starts its header, or sits in its top corner when it has none. The handle's menu moves the tile a cell at a time and resizes
    it, within MinColSpan, MaxColSpan, MinRowSpan and MaxRowSpan.
*@

<div @attributes="AdditionalAttributes" class="@_class" style="@PlacedStyle" role="listitem"
     aria-labelledby="@(HasTitle ? _titleId : null)" aria-label="@(HasTitle ? null : Label)" data-tile-id="@Id"
     data-ib-label="@(Editing ? AccessibleName : null)" data-ib-limits="@(Editing ? Limits : null)">
    @if (Editing && !HasHeader)
    {
        @* No header to hold it: the handle sits in the corner, so editing doesn't change the tile's size. *@
        <div class="ib-tile-corner">@HandleMenu</div>
    }
    @if (HasHeader)
    {
        <div class="ib-tile-header">
            @if (Editing)
            {
                @HandleMenu
            }
            @if (Header is not null)
            {
                <div class="ib-tile-heading" id="@_titleId">@Header</div>
            }
            else if (HasTitle || Icon is not null)
            {
                <div class="ib-tile-heading">
                    @if (Icon is { } icon)
                    {
                        <span class="ib-tile-icon" aria-hidden="true"><Icon Name="icon" /></span>
                    }
                    @if (HasTitle)
                    {
                        @TitleElement
                    }
                </div>
            }
            @if (Actions is not null)
            {
                <div class="ib-tile-actions">@Actions</div>
            }
        </div>
    }
    <div class="ib-tile-body">@ChildContent</div>
    @if (Editing)
    {
        @* The resize grip: dragged with script; without, the menu resizes. *@
        <span class="ib-tile-grip" aria-hidden="true"></span>
        <div class="ib-visually-hidden" role="status">@(Context!.Owner.Announcement is { } said && said.Tile == this ? said.Text : null)</div>
    }
</div>

@code {
    /// <summary>
    /// The tile's id in the layout's <see cref="TileLayout.State"/>, which saves its place and
    /// size. Keep it the same across visits: a saved layout finds the tile by it.
    /// </summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>Its first column, from 1. Set both <see cref="Col"/> and <see cref="Row"/>, or neither to take the first free cells.</summary>
    [Parameter] public int? Col { get; set; }

    /// <summary>Its first row, from 1. Set both <see cref="Col"/> and <see cref="Row"/>, or neither to take the first free cells.</summary>
    [Parameter] public int? Row { get; set; }

    /// <summary>How many columns it spans. Defaults to 1.</summary>
    [Parameter] public int ColSpan { get; set; } = 1;

    /// <summary>How many rows it spans. Defaults to 1.</summary>
    [Parameter] public int RowSpan { get; set; } = 1;

    /// <summary>
    /// Names the tile for screen readers when it has no <see cref="Title"/>, such as a tile holding
    /// a <c>Stat</c>, and its handle in an editable layout ("Move Revenue").
    /// </summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The fewest columns its menu can narrow it to. Defaults to 1.</summary>
    [Parameter] public int MinColSpan { get; set; } = 1;

    /// <summary>The most columns its menu can widen it to. Defaults to the layout's columns.</summary>
    [Parameter] public int? MaxColSpan { get; set; }

    /// <summary>The fewest rows its menu can shorten it to. Defaults to 1.</summary>
    [Parameter] public int MinRowSpan { get; set; } = 1;

    /// <summary>The most rows its menu can make it. Defaults to no limit (the layout's <c>Rows</c>, when set).</summary>
    [Parameter] public int? MaxRowSpan { get; set; }

    /// <summary>The heading in its header. Names the tile for screen readers.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The heading level of <see cref="Title"/>, 2 to 6. Defaults to 3.</summary>
    [Parameter] public int TitleLevel { get; set; } = 3;

    /// <summary>An icon before the title.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>Your own header content in place of the icon and title. It names the tile for screen readers.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Buttons at the end of the header, such as a refresh or a <c>Menu</c>.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The tile's content. It scrolls inside the tile when longer.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private TileLayoutContext? Context { get; set; }

    private readonly string _titleId = IdGenerator.Next("ib-tile-title");
    private string? _class;

    private bool HasTitle => Header is not null || Title is { Length: > 0 };

    private bool HasHeader => HasTitle || Icon is not null || Actions is not null;

    private bool Editing => Context?.Owner.Editable == true;

    /// <summary>The tile's name in its handle and announcements: its <see cref="Title"/>, else its <see cref="Label"/>.</summary>
    internal string AccessibleName => Title is { Length: > 0 } title ? title : Label ?? Id ?? "";

    // The handle: a button whose menu moves and resizes the tile. Each move it can't make is
    // disabled. On a static page each posts the form; on an interactive one it moves in place.
    private RenderFragment HandleMenu => __builder =>
    {
        var focus = !Context!.Owner.Live && Id is not null && Id == Context.Owner.FocusId;
        <Menu>
            <Trigger Context="wire">
                <IconButton Icon="Lucide.GripVertical" Label="@string.Format(CultureInfo.CurrentCulture, TextDefaults.MoveItem, AccessibleName)"
                            Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" Class="ib-tile-handle"
                            aria-keyshortcuts="Alt+ArrowLeft Alt+ArrowRight Alt+ArrowUp Alt+ArrowDown Alt+Shift+ArrowLeft Alt+Shift+ArrowRight Alt+Shift+ArrowUp Alt+Shift+ArrowDown"
                            autofocus="@focus" data-ib-autofocus="@(focus ? "" : null)" @attributes="wire" />
            </Trigger>
            <ChildContent>
                @MoveItem(TileMoveKind.Left, TextDefaults.MoveLeft, Lucide.ArrowLeft, "Alt+←")
                @MoveItem(TileMoveKind.Right, TextDefaults.MoveRight, Lucide.ArrowRight, "Alt+→")
                @MoveItem(TileMoveKind.Up, TextDefaults.MoveUp, Lucide.ArrowUp, "Alt+↑")
                @MoveItem(TileMoveKind.Down, TextDefaults.MoveDown, Lucide.ArrowDown, "Alt+↓")
                <MenuDivider />
                @MoveItem(TileMoveKind.Wider, TextDefaults.TileWider, Lucide.ChevronsLeftRight, "Alt+Shift+→")
                @MoveItem(TileMoveKind.Narrower, TextDefaults.TileNarrower, Lucide.ChevronsRightLeft, "Alt+Shift+←")
                @MoveItem(TileMoveKind.Taller, TextDefaults.TileTaller, Lucide.ChevronsUpDown, "Alt+Shift+↓")
                @MoveItem(TileMoveKind.Shorter, TextDefaults.TileShorter, Lucide.ChevronsDownUp, "Alt+Shift+↑")
            </ChildContent>
        </Menu>
    };

    // Each move carries its kind (data-ib-move) for the script: Alt+arrows click it, and on a static
    // page with script it moves the tile in place instead of posting. The shortcuts need the script.
    private RenderFragment MoveItem(TileMoveKind kind, string text, IconData icon, string shortcut) => __builder =>
    {
        var disabled = !Context!.TryMove(this, kind, out _);
        var move = kind.ToString().ToLowerInvariant();
        if (Context.Owner.Live)
        {
            <MenuItem Icon="icon" Shortcut="@shortcut" Disabled="disabled" data-ib-move="@move" OnClick="() => Context.Owner.MoveAsync(this, kind)">@text</MenuItem>
        }
        else
        {
            <MenuItem Icon="icon" Shortcut="@shortcut" Disabled="disabled" data-ib-move="@move" Submit Name="@($"{Context.Owner.Name}.Move")" Value="@(new TileMove(kind, Id!).ToString())">@text</MenuItem>
        }
    };

    // The span limits for the script: min and max columns, then rows (0 for none).
    private string Limits => string.Create(CultureInfo.InvariantCulture, $"{MinColSpan},{MaxColSpan ?? 0},{MinRowSpan},{MaxRowSpan ?? 0}");

    // Where the tile goes depends on the tiles around it, which have all said they're there by the
    // time any of them renders; so it's worked out here, not when the parameters are set.
    private string? PlacedStyle
    {
        get
        {
            var styles = new StyleBuilder();
            var places = Context!.PlacesOf(this);
            for (var i = 0; i < places.Length; i++)
            {
                var place = places[i];
                var suffix = Context.Owner.Levels[i].Breakpoint is { } b ? "-" + b.Name() : "";
                styles.AddVar("tile-col" + suffix, place.Col.ToString(CultureInfo.InvariantCulture))
                    .AddVar("tile-row" + suffix, place.Row.ToString(CultureInfo.InvariantCulture))
                    .AddVar("tile-cs" + suffix, place.ColSpan.ToString(CultureInfo.InvariantCulture))
                    .AddVar("tile-rs" + suffix, place.RowSpan.ToString(CultureInfo.InvariantCulture));
            }

            styles.AddRaw(Style);
            return styles.ToString();
        }
    }

    private RenderFragment TitleElement => builder =>
    {
        builder.OpenElement(0, $"h{TitleLevel}");
        builder.AddAttribute(1, "class", "ib-tile-title");
        builder.AddAttribute(2, "id", _titleId);
        builder.AddContent(3, Title);
        builder.CloseElement();
    };

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Context is null)
        {
            throw new InvalidOperationException("Tile must be inside a TileLayout.");
        }

        Context.Register(this);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (TitleLevel is < 2 or > 6)
        {
            throw new InvalidOperationException("Tile's TitleLevel is 2 to 6.");
        }

        if (ColSpan < 1 || RowSpan < 1)
        {
            throw new InvalidOperationException("A Tile's ColSpan and RowSpan are at least 1.");
        }

        if (Col < 1 || Row < 1)
        {
            throw new InvalidOperationException("A Tile's Col and Row start at 1.");
        }

        if ((Context!.Owner.State is not null || Context.Owner.Editable) && string.IsNullOrEmpty(Id))
        {
            throw new InvalidOperationException("A Tile in a TileLayout with State or Editable needs an Id: the saved layout finds the tile by it.");
        }

        if (Context.Owner.Editable && Title is not { Length: > 0 } && string.IsNullOrEmpty(Label))
        {
            throw new InvalidOperationException($"Tile \"{Id}\" in an Editable TileLayout needs a Title or a Label: it names the tile's handle (\"Move ...\") for screen readers.");
        }

        if (MinColSpan < 1 || MinRowSpan < 1 || MaxColSpan < MinColSpan || MaxRowSpan < MinRowSpan)
        {
            throw new InvalidOperationException("A Tile's MinColSpan and MinRowSpan are at least 1, and each Max at least its Min.");
        }

        Context.Seen(this);
        _class = new ClassBuilder().Add("ib-tile").Add(VisibilityClasses).Add(Class).ToString();
    }

    /// <summary>Draws again at its new place, after a move on an interactive page.</summary>
    internal void Refresh() => StateHasChanged();

    /// <inheritdoc />
    public void Dispose() => Context?.Unregister(this);
}
