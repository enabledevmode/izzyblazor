@namespace IzzyBlazor
@inherits ToggleComponentBase
@attribute [ModeSupport]

@*
    A single show-and-hide section without accordion styling: "Show more", "Advanced options",
    a FAQ entry. A native <details>, so it works with JavaScript off.

    <Collapsible Label="Advanced options">...</Collapsible>

    Accessibility:
    - The `summary` takes Enter and Space and is announced as expanded or collapsed by the browser,
      with JavaScript off too.
    - `Label` or `Trigger` is the trigger's name, and one is required; the chevron is hidden.
    - `Trigger` content is drawn inside the `summary`, so keep it to inline content, with no links
      or buttons.
    - The trigger isn't a heading; put a Heading before it if the section needs one.
    See also: Accordion, Popover.
*@

<details @attributes="AdditionalAttributes"
         id="@ElementId"
         class="@_class"
         style="@_style"
         open="@(IsOpen && !IsInteractive)"
         data-open="@(IsOpen && IsInteractive ? "" : null)"
         data-ib-interactive="@(IsInteractive ? "" : null)"
         data-ib-seq="@ToggleSeq"
         @onibtoggle="HandleToggle">
    <summary class="ib-collapsible-trigger">
        @if (Trigger is not null)
        {
            @Trigger
        }
        else
        {
            <Icon Role="IconRole.ChevronRight" Class="ib-collapsible-chevron" />
            <span>@Label</span>
        }
    </summary>
    <div class="ib-collapsible-panel">
        @ChildContent
    </div>
</details>

@code {
    /// <summary>The trigger text, after a chevron.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Custom trigger content, in place of <see cref="Label"/> and the chevron. Inline content only.</summary>
    [Parameter] public RenderFragment? Trigger { get; set; }

    /// <summary>The hidden content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override string IdPrefix => "ib-collapsible";

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-collapsible");
        classes.Add("ib-disclosure");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Label is null && Trigger is null)
        {
            throw new InvalidOperationException("Collapsible needs a Label or a Trigger.");
        }

        (_class, _style) = BuildRootAttributes();
    }
}
