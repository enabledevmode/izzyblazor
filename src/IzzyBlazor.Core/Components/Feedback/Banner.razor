@namespace IzzyBlazor
@inherits LayoutItemBase
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, a dismissed banner comes back on the next page, its close button is a checkbox to screen readers, and focus doesn't move on when it closes.")]

@*
    A full-width strip for a message about the whole app or site: planned maintenance, a trial
    that is ending, a license warning. Put it at the top of the page, or inside an AppShell, where
    it takes a row of its own above the header. For a message about part of a page, use Alert.

    <Banner Status="Status.Warning" Dismissible>Maintenance on Saturday, 2 to 4 AM UTC.</Banner>

    Dismissible adds a close button that works with no script: a visually hidden checkbox and its
    label, with CSS :has(:checked) hiding the banner. With the script it is a real button
    (<ib-dismiss>), and focus moves to the next control when the banner closes. A dismissal is remembered, for the browser
    session by default (Remember): <ib-banner> writes a cookie when it is closed, and the server reads
    the cookie and leaves the banner out of later pages, static or interactive. The cookie is named
    by RememberKey, or by a key made from the title and text, so a new message shows again. Where the server can't read
    cookies (WebAssembly), the element hides a remembered banner as soon as it connects.

    Position="BarPosition.Sticky" keeps it at the top while the page scrolls. In an AppShell the
    sticky header and sidebar then sit below it: CSS assumes one line (37px), and <ib-banner>
    measures it when the message wraps.

    Accessibility:
    - It's a `region` landmark named "Announcement" (`Label`), so screen readers can find it.
    - It isn't announced by default; `Announce` makes the message `role="alert"` (Danger,
      Warning) or `role="status"`, for a banner shown after the page loads.
    - Screen readers hear the status in words before the message ("Warning: "), from
      `StatusLabel`.
    - With script, the close control is a `button` named "Dismiss" (`DismissLabel`), and focus
      moves to the next control when it closes the banner. With JavaScript off it's a visually
      hidden checkbox, as on Alert, and focus isn't moved.
    See also: Alert, ToastRegion, AppShell.
*@

@if (!_dismissed)
{
    <ib-banner @attributes="AdditionalAttributes" id="@ElementId" class="@_class" style="@_style"
               role="region" aria-label="@(Label ?? TextDefaults.Announcement)">
        @if (!HideIcon)
        {
            <Icon Name="@(Icon ?? Alert.DefaultIcon(Status))" Class="ib-banner-icon" />
        }
        <div class="ib-banner-body" role="@(Announce ? (IsUrgent ? "alert" : "status") : null)">
            <span class="ib-banner-text">
                @if (ResolvedStatusLabel is { } statusLabel)
                {
                    <span class="ib-visually-hidden">@(statusLabel + ": ")</span>
                }
                @if (Title is not null)
                {
                    <strong class="ib-banner-title">@Title</strong>
                }
                <CascadingValue Value="_scope" IsFixed="true">@ChildContent</CascadingValue>
            </span>
            @if (_scope.Shown<BannerActions>() is { } actions)
            {
                <span class="ib-banner-actions">@_scope.Outlet(actions)</span>
            }
        </div>
        @if (Dismissible)
        {
            <input type="checkbox"
                   id="@($"{ElementId}-dismiss")"
                   class="ib-banner-dismiss ib-visually-hidden"
                   aria-label="@(DismissLabel ?? TextDefaults.Dismiss)"
                   data-ib-remember="@(_key is null ? null : CookieName)"
                   data-ib-remember-for="@(_key is not null && Remember == DismissMemory.Session ? "session" : null)"
                   @onchange="OnDismiss" />
            <label for="@($"{ElementId}-dismiss")" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm ib-banner-close" aria-hidden="true" title="@(DismissLabel ?? TextDefaults.Dismiss)">
                <Icon Role="IconRole.Close" />
            </label>
            @* With the script: a real button in place of the checkbox (CSS swaps them on :defined). *@
            <ib-dismiss>
                <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm ib-banner-close" aria-label="@(DismissLabel ?? TextDefaults.Dismiss)" title="@(DismissLabel ?? TextDefaults.Dismiss)">
                    <Icon Role="IconRole.Close" />
                </button>
            </ib-dismiss>
        }
    </ib-banner>
}

@code {
    /// <summary>What the message means; sets the color and icon. Defaults to <see cref="IzzyBlazor.Status.Info"/>.</summary>
    [Parameter] public Status Status { get; set; } = Status.Info;

    /// <summary>
    /// A color in place of the status's own, such as <c>Accent.Primary</c> for a product
    /// announcement, or <c>Accent.Of("#0d9488")</c>. The status still sets the icon and what
    /// screen readers hear.
    /// </summary>
    [Parameter] public Accent? Accent { get; set; }

    /// <summary>How it's drawn. Defaults to <see cref="AlertVariant.Soft"/>.</summary>
    [Parameter] public AlertVariant Variant { get; set; } = AlertVariant.Soft;

    /// <summary>
    /// Whether it stays at the top of the window while the page scrolls
    /// (<see cref="BarPosition.Sticky"/>) or scrolls away with it. Defaults to
    /// <see cref="BarPosition.Static"/>.
    /// </summary>
    [Parameter] public BarPosition Position { get; set; } = BarPosition.Static;

    /// <summary>A short bold lead-in before the message, on the same line.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The message. Keep it to a line or two.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private PartScope _scope = null!;

    [CascadingParameter] private PartScope? OuterScope { get; set; }

    /// <summary>An icon in place of the status's own.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>Leaves out the icon.</summary>
    [Parameter] public bool HideIcon { get; set; }

    /// <summary>Adds a close button. Works with JavaScript off.</summary>
    [Parameter] public bool Dismissible { get; set; }

    /// <summary>
    /// How long a dismissal lasts, with <see cref="Dismissible"/>: <see cref="DismissMemory.Session"/>
    /// (the default) until the browser closes, <see cref="DismissMemory.Persistent"/> for a year,
    /// <see cref="DismissMemory.None"/> only on the page (it shows again on the next one).
    /// </summary>
    [Parameter] public DismissMemory Remember { get; set; } = DismissMemory.Session;

    /// <summary>
    /// Names the cookie that remembers a dismissal: <c>ib-banner-{key}</c>. Change the key
    /// (<c>"maintenance-2026-11"</c>) to show a new message to everyone again. Unset, the key comes
    /// from the <see cref="Title"/>, text and links, so changing the message shows it again; a
    /// banner whose text comes from a component of the app's own (a localizer) is remembered only
    /// with a key, since its text can't be read. Letters,
    /// digits, <c>-</c>, <c>_</c> and <c>.</c> only.
    /// </summary>
    [Parameter] public string? RememberKey { get; set; }

    /// <summary>Whether it has been dismissed. Use <c>@bind-Dismissed</c> on interactive pages.</summary>
    [Parameter] public bool Dismissed { get; set; }

    /// <summary>Called when someone dismisses it (interactive pages), and when a remembered dismissal is found.</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<bool> DismissedChanged { get; set; }

    /// <summary>
    /// Whether screen readers announce the message when it appears (<c>role="alert"</c> for
    /// danger and warning, <c>role="status"</c> otherwise). Off by default: a banner is usually
    /// there when the page loads, and screen readers find it as a labeled region. Turn it on
    /// for a banner you show in response to something, such as a lost connection.
    /// </summary>
    [Parameter] public bool Announce { get; set; }

    /// <summary>
    /// What kind of message it is, read to screen readers before it. Defaults to "Info",
    /// "Success", "Warning" or "Error" by <see cref="Status"/> (from <see cref="IzzyText"/>), and
    /// nothing for Neutral. Set it to "" to leave it out.
    /// </summary>
    [Parameter] public string? StatusLabel { get; set; }

    /// <summary>The region's accessible name. Defaults to "Announcement".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The close button's accessible name. Defaults to "Dismiss".</summary>
    [Parameter] public string? DismissLabel { get; set; }

    /// <summary>The element id. Generated when not set.</summary>
    [Parameter] public string? Id { get; set; }

    private string? _generatedId;
    private bool _dismissed;
    private bool _remembered;
    private bool? _lastDismissedParam;
    private string? _class;
    private string? _style;
    private PersistingComponentStateSubscription? _persisting;

    private string ElementId => Id ?? (_generatedId ??= IdGenerator.Next("ib-banner"));

    // The key the dismissal is remembered under, or null when it isn't remembered.
    private string? _key;

    internal string CookieName => $"ib-banner-{_key}";

    /// <summary>A key from the banner's title and text (FNV-1a), for banners with no RememberKey.</summary>
    private string? AutoKey() => AutoKeyFor(Title, ChildContent);

    // Null when the text holds a component whose output can't be read: two different messages
    // could then get the same key, so such a banner is remembered only under a RememberKey.
    internal static string? AutoKeyFor(string? title, RenderFragment? content)
    {
        var read = PageOutline.ReadText(content);
        if (read.Opaque)
        {
            return null;
        }

        var text = $"{title}\n{read.Text}\n{read.Links}";
        var hash = 2166136261u;
        foreach (var c in text)
        {
            hash = (hash ^ c) * 16777619u;
        }

        return $"auto-{hash:x8}";
    }

    private string? ResolvedStatusLabel => StatusLabel is { } label
        ? (label.Length > 0 ? label : null)
        : Status switch
        {
            Status.Info => TextDefaults.StatusInfo,
            Status.Success => TextDefaults.StatusSuccess,
            Status.Warning => TextDefaults.StatusWarning,
            Status.Danger => TextDefaults.StatusError,
            _ => null,
        };

    private bool IsUrgent => Status is Status.Danger or Status.Warning;

    internal static bool IsValidKey(string key) =>
        key.Length > 0 && key.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_' or '.');

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        _scope = new PartScope(this, OuterScope, StateHasChanged);
        if (RememberKey is not null && !IsValidKey(RememberKey))
        {
            throw new ArgumentException(
                $"Banner RememberKey \"{RememberKey}\" can only contain letters, digits, '-', '_' and '.'.",
                nameof(RememberKey));
        }

        if (!Dismissible || Remember == DismissMemory.None)
        {
            return;
        }

        _key = RememberKey ?? AutoKey();
        if (_key is null)
        {
            return;
        }

        // The cookie is there on the server's first render (read through IRequestCookies, which the
        // IzzyBlazor package registers); an interactive render that follows a prerender gets the
        // answer handed over through persisted state.
        var state = Services.GetService<PersistentComponentState>();
        var key = $"ib-banner:{_key}";
        if (state is not null && PersistedState.TryTake(state, key, PersistedStateJson.Default.Boolean, out var handedOver) && handedOver)
        {
            _remembered = true;
        }
        else if (Services.GetService<IRequestCookies>() is { } cookies && !RendererInfo.IsInteractive && cookies.Get(CookieName) == "1")
        {
            _remembered = true;
        }

        if (state is not null && _remembered)
        {
            _persisting = state.RegisterOnPersisting(() =>
            {
                try
                {
                    PersistedState.Persist(state, key, true, PersistedStateJson.Default.Boolean);
                }
                catch (ArgumentException)
                {
                    // Another banner with the same key already handed it over.
                }

                return Task.CompletedTask;
            });
        }

        // A bound parent learns about the remembered dismissal once the page is interactive.
        if (_remembered && !Dismissed && RendererInfo.IsInteractive && DismissedChanged.HasDelegate)
        {
            await DismissedChanged.InvokeAsync(true);
        }
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        // The alert's status and variant classes supply the colors; the banner adds its own shape.
        classes.Add("ib-banner");
        base.BuildAttributes(classes, styles);

        classes.Add($"ib-alert-{Status.ToString().ToLowerInvariant()}");
        classes.Add($"ib-alert-{Variant.ToString().ToLowerInvariant()}");
        classes.Add("ib-banner-sticky", Position == BarPosition.Sticky);
        if (Accent is { } accent)
        {
            ColorOverride.Apply(styles, accent.ToColor());
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (_lastDismissedParam != Dismissed)
        {
            _lastDismissedParam = Dismissed;
            // A remembered dismissal wins on the first render; after that, setting Dismissed
            // from C# hides or shows it again.
            _dismissed = Dismissed || (_remembered && !_rememberApplied);
            _rememberApplied = true;
        }

        (_class, _style) = BuildRootAttributes();
    }

    private bool _rememberApplied;

    private Task OnDismiss(ChangeEventArgs e)
    {
        _dismissed = true;
        return DismissedChanged.InvokeAsync(true);
    }

    /// <inheritdoc />
    public void Dispose() => _persisting?.Dispose();
}
