@namespace IzzyBlazor
@inherits ProgressBase
@attribute [ModeSupport]

@*
    A progress bar. With a Value it shows how far along something is; without one it's
    indeterminate (a bar that moves, for "working on it"). Rendered on the server, so it works on
    static pages; on interactive pages, update Value from C#.

    <Progress Value="40" Label="Uploading" ShowValue />
    <Progress Value="3" Max="5" ValueText="3 of 5 files" Accent="Accent.From(Color.Success)" />
    <Progress Label="Preparing export" />                       (indeterminate)

    Accessibility:
    - It renders `role="progressbar"` with `aria-valuenow`, `aria-valuemin` and `aria-valuemax`;
      screen readers hear `ValueText` or the percentage.
    - `Label` is the bar's accessible name (through `aria-labelledby`); without one, an `aria-label`
      on the component names the bar.
    - Without a `Value` it has no value attributes, which marks it as indeterminate.
    - With reduced motion, the indeterminate bar moves more slowly.
    See also: ProgressCircle, Spinner, Stepper, Skeleton.
*@

@{ base.BuildRenderTree(__builder); }

@code {
    /// <summary>The bar's thickness. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <inheritdoc />
    private protected override ControlSize ShownSize => Size;
}
