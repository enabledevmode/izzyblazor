@namespace IzzyBlazor
@inherits MenuBase
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the menu opens and closes, but arrow keys and type-ahead don't move between items.")]

@*
    A dropdown of actions or links, built on the Popover API: a button with popovertarget
    opens a [popover] panel in the top layer. Opening, Escape and clicking outside are all
    native, so the menu works with JavaScript off. The script adds arrow-key navigation and
    positioning in browsers without CSS anchor positioning.

    <Menu Label="Options">
        <MenuItem Href="/settings" Icon="Lucide.Settings">Settings</MenuItem>
        <MenuDivider />
        <MenuItem Submit FormAction="/logout" Icon="Lucide.LogOut">Sign out</MenuItem>
    </Menu>

    A custom trigger takes the wiring attributes as its context:

    <Menu>
        <Trigger>
            <IconButton Icon="Lucide.Ellipsis" Label="More" @attributes="context" />
        </Trigger>
        ...
    </Menu>

    Accessibility:
    - With script, it's a `menu` named by its trigger, with `menuitem`, `menuitemcheckbox` and
      `menuitemradio` items (`aria-checked`); a MenuGroup is a `group` named by its `Label`.
    - Opening it focuses an item, and closing it brings focus back to the trigger. Disabled items
      are skipped.
    - With JavaScript off, items are plain links and buttons with no menu roles; a checked one
      has `aria-pressed` (buttons) or `aria-current` (links).
    - With `ContextFor`, right-click, a long press, the menu key or Shift+F10 in that element also
      opens the menu at the pointer (or under the focused element), and Escape or a choice puts
      focus back where it was. The menu's button stays the way in that can be seen. For a menu with
      no button, use ContextMenu.
    - A custom `Trigger` needs a name of its own, such as an IconButton's `Label`. A `Shortcut`
      is display only: the app handles the keys.

    Keyboard:
    On the trigger
    - Enter, Space, Down | Open the menu at its first item
    - Up | Open the menu at its last item
    In the ContextFor element
    - Shift+F10, Menu key | Open the menu under the focused element
    In the menu
    - Up, Down | Move through the items, wrapping
    - Home, End | Go to the first or last item
    - Letters | Jump to the next item starting with them
    - Enter, Space | Choose the item
    - Escape | Close the menu and go back to the trigger; in a submenu, close just the submenu and
      go back to its item
    - Tab | Close the menu and move on
    - Right | On a MenuSub's item, open the submenu at its first item (Left on right-to-left pages)
    - Left | In a submenu, close it (Right on right-to-left pages)
    See also: ContextMenu, Popover, NavMenu, ButtonGroup, IconButton, SplitButton.
*@

@{ base.BuildRenderTree(__builder); }

@code {
    /// <summary>The default trigger's text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// The id of an element whose right-click, long press, menu key or Shift+F10 also opens this
    /// menu, at the pointer, such as the card it acts on. Needs script; with JavaScript off the
    /// browser's own menu shows. For a menu with no button, use <see cref="ContextMenu"/>.
    /// </summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None)]
    public string? ContextFor { get; set; }

    /// <summary>The default trigger's color. Defaults to <see cref="Accent.Neutral"/>.</summary>
    [Parameter] public Accent Accent { get; set; } = Accent.Neutral;

    /// <summary>The default trigger's weight. Defaults to <see cref="ButtonVariant.Outline"/>.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;

    /// <summary>The default trigger's size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>An icon before the default trigger's text.</summary>
    [Parameter] public IconData? StartIcon { get; set; }

    /// <summary>
    /// A custom trigger in place of the default button. Its context holds the attributes that
    /// wire it to the menu; pass them on with <c>@attributes="context"</c>. It must be a <c>button</c>.
    /// </summary>
    [Parameter] public RenderFragment<IReadOnlyDictionary<string, object>>? Trigger { get; set; }

    /// <summary>Where the menu opens. Defaults to <see cref="Placement.BottomStart"/>.</summary>
    [Parameter] public Placement Placement { get; set; } = Placement.BottomStart;

    private bool _accentSet;
    private bool _variantSet;
    private bool _sizeSet;

    // The default trigger's look: the menu's own where set, else a ButtonGroup's or Toolbar's around it.
    private Accent TriggerAccent => !_accentSet && Group?.DefaultAccent is { } accent ? accent : Accent;

    private ButtonVariant TriggerVariant => !_variantSet && Group?.DefaultVariant is { } variant ? variant : Variant;

    /// <summary>A class for the default trigger: a ToolbarMenu's, when its label collapses.</summary>
    private protected virtual string? TriggerClass => null;

    private protected ControlSize TriggerSize => !_sizeSet && Group?.DefaultSize is { } size ? size : Size;

    /// <inheritdoc />
    private protected override RenderFragment TriggerContent => Trigger is not null ? Trigger(TriggerAttributes) : DefaultTrigger;

    // Built in C#, not markup: with markup in @code, the .NET 11 SDK's Razor compiler doesn't see a C#
    // subclass (ToolbarMenu) as a component, so <ToolbarMenu> in the library's own .razor files fails.
    private RenderFragment DefaultTrigger => builder =>
    {
        builder.OpenComponent<Button>(0);
        builder.AddComponentParameter(1, nameof(Button.Accent), TriggerAccent);
        builder.AddComponentParameter(2, nameof(Button.Variant), TriggerVariant);
        builder.AddComponentParameter(3, nameof(Button.Size), TriggerSize);
        builder.AddComponentParameter(4, nameof(Button.StartIcon), StartIcon);
        builder.AddComponentParameter(5, nameof(Button.EndIcon), IconSet.Current.Get(IconPurpose.ChevronDown));
        builder.AddComponentParameter(6, nameof(Button.Class), TriggerClass);
        builder.AddMultipleAttributes(7, TriggerAttributes);
        builder.AddComponentParameter(8, nameof(Button.ChildContent), (RenderFragment)(label => label.AddContent(0, Label)));
        builder.CloseComponent();
    };

    /// <inheritdoc />
    private protected override string? ContextTarget => ContextFor;

    /// <inheritdoc />
    private protected override Placement PanelPlacement => Placement;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Trigger is null && string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException("Menu needs a Label for its button, or a Trigger. For a menu with no button, use ContextMenu.");
        }

        base.OnParametersSet();
    }

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        _accentSet = parameters.TryGetValue<Accent>(nameof(Accent), out _);
        _variantSet = parameters.TryGetValue<ButtonVariant>(nameof(Variant), out _);
        _sizeSet = parameters.TryGetValue<ControlSize>(nameof(Size), out _);
        return base.SetParametersAsync(parameters);
    }
}
