@namespace IzzyBlazor
@inherits ToggleComponentBase
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, the menu opens and closes, but arrow keys and type-ahead don't move between items.")]

@*
    A dropdown of actions or links, built on the Popover API: a button with popovertarget
    opens a [popover] panel in the top layer. Opening, Escape and clicking outside are all
    native, so the menu works with JavaScript off. The script adds arrow-key navigation and
    positioning in browsers without CSS anchor positioning.

    <Menu Label="Options">
        <MenuItem Href="/settings" Icon="Lucide.Settings">Settings</MenuItem>
        <MenuDivider />
        <MenuItem Submit FormAction="/logout" Icon="Lucide.LogOut">Sign out</MenuItem>
    </Menu>

    A custom trigger takes the wiring attributes as its context:

    <Menu>
        <Trigger><IconButton Icon="Lucide.Ellipsis" Label="More" @attributes="context" /></Trigger>
        ...
    </Menu>

    Accessibility:
    - With script, it's a `menu` named by its trigger, with `menuitem`, `menuitemcheckbox` and
      `menuitemradio` items (`aria-checked`); a MenuGroup is a `group` named by its `Label`.
    - Opening it focuses the first item; Down and Up on the trigger open it at the first or last.
      Escape closes it, and focus goes back to the trigger.
    - Down and Up move through the items and wrap, Home and End go to the ends, typing jumps to
      the next item starting with those letters, and Tab closes the menu. Disabled items are
      skipped.
    - Right opens a MenuSub and focuses its first item; Left closes it (the other way round on
      right-to-left pages).
    - With JavaScript off, items are plain links and buttons with no menu roles; a checked one
      has `aria-pressed` (buttons) or `aria-current` (links).
    - A custom `Trigger` needs a name of its own, such as an IconButton's `Label`. A `Shortcut`
      is display only: the app handles the keys.
    See also: Popover, NavMenu, ButtonGroup, IconButton.
*@

<ib-popover class="@_outerClass"
            style="@_outerStyle"
            data-placement="@Placement.Name()"
            data-open="@(IsOpen ? "" : null)"
            data-ib-interactive="@(IsInteractive ? "" : null)"
            data-ib-seq="@ToggleSeq">
    @if (Trigger is not null)
    {
        @Trigger(_triggerAttributes)
    }
    else
    {
        <Button Accent="TriggerAccent" Variant="TriggerVariant" Size="TriggerSize" StartIcon="StartIcon" EndIcon="IconSet.Current.Get(IconRole.ChevronDown)" Class="@TriggerClass" @attributes="_triggerAttributes">@Label</Button>
    }
    <div @attributes="AdditionalAttributes"
         id="@ElementId"
         popover="auto"
         role="@(RendererInfo.IsInteractive ? "menu" : null)"
         data-ib-role="@(RendererInfo.IsInteractive ? null : "menu")"
         aria-labelledby="@TriggerId"
         class="@_class"
         style="@_style"
         @onibtoggle="HandleToggle">
        <CascadingValue Value="_context" IsFixed="true">
            <CascadingValue Value="ToolbarContext.Outside" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </CascadingValue>
    </div>
</ib-popover>

@code {
    /// <summary>The default trigger's text.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The default trigger's color. Defaults to <see cref="Accent.Neutral"/>.</summary>
    [Parameter] public Accent Accent { get; set; } = Accent.Neutral;

    /// <summary>The default trigger's weight. Defaults to <see cref="ButtonVariant.Outline"/>.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Outline;

    /// <summary>The default trigger's size.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>An icon before the default trigger's text.</summary>
    [Parameter] public IconData? StartIcon { get; set; }

    /// <summary>
    /// A custom trigger in place of the default button. Its context holds the attributes that
    /// wire it to the menu; pass them on with <c>@attributes="context"</c>. It must be a <c>button</c>.
    /// </summary>
    [Parameter] public RenderFragment<IReadOnlyDictionary<string, object>>? Trigger { get; set; }

    /// <summary>Where the menu opens. Defaults to <see cref="Placement.BottomStart"/>.</summary>
    [Parameter] public Placement Placement { get; set; } = Placement.BottomStart;

    /// <summary>
    /// The width of the menu panel, such as <c>Length.Rem(16)</c> for a column of long labels.
    /// Defaults to the content's width, at least 10rem and the trigger's width, up to 24rem.
    /// Never wider than the screen.
    /// </summary>
    [Parameter] public Length? PanelWidth { get; set; }

    /// <summary>The <see cref="MenuItem"/>s, <see cref="MenuGroup"/>s and <see cref="MenuDivider"/>s.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private ButtonGroup? Group { get; set; }

    /// <summary>The <see cref="Toolbar"/> it's directly in, where only a ToolbarMenu goes.</summary>
    [CascadingParameter] internal ToolbarContext? Toolbar { get; set; }

    private bool _accentSet;
    private bool _variantSet;
    private bool _sizeSet;

    // The default trigger's look: the menu's own where set, else a ButtonGroup's or Toolbar's around it.
    private Accent TriggerAccent => !_accentSet && Group?.DefaultAccent is { } accent ? accent : Accent;

    private ButtonVariant TriggerVariant => !_variantSet && Group?.DefaultVariant is { } variant ? variant : Variant;

    /// <summary>A class for the default trigger: a ToolbarMenu's, when its label collapses.</summary>
    private protected virtual string? TriggerClass => null;

    private protected ControlSize TriggerSize => !_sizeSet && Group?.DefaultSize is { } size ? size : Size;

    private IReadOnlyDictionary<string, object> _triggerAttributes = new Dictionary<string, object>();
    private MenuContext _context = null!;
    private string? _class;
    private string? _style;
    private string? _outerClass;
    private string? _outerStyle;

    private string TriggerId => $"{ElementId}-trigger";

    /// <inheritdoc />
    protected override string IdPrefix => "ib-menu";


    /// <inheritdoc />
    protected override bool VisibilityOnRoot => false;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-pop");
        classes.Add("ib-menu");
        classes.Add($"ib-place-{Placement.Name()}");
        styles.AddRaw($"position-anchor:{StyleValues.AnchorName(ElementId)}");
        if (PanelWidth is { } width)
        {
            classes.Add("ib-pop-sized");
            styles.AddVar("pop-w", StyleValues.Length(width));
        }

        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ToolbarControl.Refuse(this, Toolbar, Group);
        if (Trigger is null && string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException("Menu needs a Label for its button, or a Trigger.");
        }

        _context ??= new MenuContext(ElementId);
        _triggerAttributes = new Dictionary<string, object>
        {
            ["id"] = TriggerId,
            ["popovertarget"] = ElementId,
            ["aria-controls"] = ElementId,
            // Menu semantics need the script; see MenuItem.
            [RendererInfo.IsInteractive ? "aria-haspopup" : "data-ib-haspopup"] = "menu",
        };
        (_class, _style) = BuildRootAttributes();
        (_outerClass, _outerStyle) = BuildOuterAttributes("ib-pop-root", $"anchor-name:{StyleValues.AnchorName(ElementId)}");
    }

    /// <inheritdoc />
    public override Task SetParametersAsync(ParameterView parameters)
    {
        _accentSet = parameters.TryGetValue<Accent>(nameof(Accent), out _);
        _variantSet = parameters.TryGetValue<ButtonVariant>(nameof(Variant), out _);
        _sizeSet = parameters.TryGetValue<ControlSize>(nameof(Size), out _);
        return base.SetParametersAsync(parameters);
    }
}
