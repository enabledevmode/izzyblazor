@namespace IzzyBlazor
@inherits IzzyComponentBase
@using Microsoft.AspNetCore.Components.Web

@*
    One entry in a Menu. Three kinds, so items act on static pages too:
      - Href: a link.
      - Submit: posts the surrounding form (or Form="id"), optionally to FormAction.
      - OnClick: runs C# on interactive pages; the item closes the menu natively.

    Checkable: @bind-Checked makes it a checkbox item (menuitemcheckbox). Inside a MenuRadioGroup
    it's one of a set (menuitemradio), identified by Value. On static pages the action still
    comes from Href or a form post, and the server decides what's checked.

    Menu roles promise arrow keys, which need the script. So static pages render them as data-ib-*
    attributes, and <ib-popover> turns them into roles when it adds the keys; with JavaScript off,
    items are plain links and buttons, a checked one marked aria-pressed (buttons) or aria-current
    (links). Interactive pages always have the script, so they render the roles directly.
*@

@if (ResolvedHref is { } href)
{
    <a @attributes="AdditionalAttributes"
       role="@(Live ? Role : null)"
       data-ib-role="@(Live ? null : Role)"
       aria-checked="@(Live ? AriaChecked : null)"
       data-ib-checked="@(Live ? null : AriaChecked)"
       aria-current="@(!Live && IsCheckable && IsChecked ? "true" : null)"
       class="@_class"
       style="@_style"
       href="@(Disabled ? null : href)"
       data-ib-keep-open="@(KeepOpen ? "" : null)"
       aria-disabled="@(Disabled ? "true" : null)">
        @Content
    </a>
}
else
{
    var submit = Submit || RadioGroup?.Name is not null;
    var closes = !submit && Menu is not null && !KeepOpen;
    <button @attributes="AdditionalAttributes"
            type="@(submit ? "submit" : "button")"
            role="@(Live ? Role : null)"
            data-ib-role="@(Live ? null : Role)"
            aria-checked="@(Live ? AriaChecked : null)"
            data-ib-checked="@(Live ? null : AriaChecked)"
            aria-pressed="@(!Live && IsCheckable ? AriaChecked : null)"
            class="@_class"
            style="@_style"
            disabled="@Disabled"
            name="@(RadioGroup?.Name ?? Name)"
            value="@Value"
            formaction="@FormAction"
            form="@Form"
            popovertarget="@(closes ? Menu!.Id : null)"
            popovertargetaction="@(closes ? "hide" : null)"
            data-ib-keep-open="@(KeepOpen ? "" : null)"
            @onclick="HandleClick">
        @Content
    </button>
}

@code {
    /// <summary>Makes the item a link to this URL.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>For button items: posts the surrounding form (or <c>Form</c>), optionally to <c>FormAction</c>.</summary>
    [Parameter] public bool Submit { get; set; }

    /// <summary>Replaced by <see cref="Submit"/>. Kept for one release so old markup fails to build.</summary>
    [Parameter, Obsolete("Buttons take a bare Submit now: <MenuItem Submit>. Type and ButtonType go in a later release.", error: true)]
    public ButtonType Type { get; set; }

    /// <summary>
    /// Makes this a checkbox item that shows a check when true, with <c>@bind-Checked</c> on
    /// interactive pages. Null (the default) is an ordinary item.
    /// </summary>
    [Parameter] public bool? Checked { get; set; }

    /// <summary>Runs with the new state when a checkbox item is chosen on an interactive page.</summary>
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// Posted as <c>Name=Value</c> when a submit item is chosen. Not <c>action</c>, <c>method</c> or <c>target</c>: a control with one of those
    /// names hides the form's own property, and Blazor's enhanced form handling then posts to the
    /// wrong address.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>The value posted with <see cref="Name"/>; in a <see cref="MenuRadioGroup"/>, the option this item picks.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Submits to this URL instead of the form's own action.</summary>
    [Parameter] public string? FormAction { get; set; }

    /// <summary>The id of the form to submit, when the menu is not inside it.</summary>
    [Parameter] public string? Form { get; set; }

    /// <summary>An icon before the text.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>
    /// A keyboard hint shown at the end in a key cap, such as "Ctrl+C" or "⌘+C". Display only. The
    /// Mac modifier symbols ⌘ ⌥ ⇧ ⌃ are drawn as icons, so they look the same on every system.
    /// </summary>
    [Parameter] public string? Shortcut { get; set; }

    /// <summary>
    /// The text color. <see cref="Accent.Neutral"/> (the default) is plain; use
    /// <see cref="Accent.Danger"/> for destructive items. A custom color is used as text, mixed
    /// toward the text color so it stays readable.
    /// </summary>
    [Parameter] public Accent Accent { get; set; } = Accent.Neutral;

    /// <summary>
    /// Leaves the menu open when the item is chosen, so several checkbox items can be ticked in a
    /// row. A link item still navigates (with JavaScript off the page reloads and the menu closes).
    /// </summary>
    [Parameter] public bool KeepOpen { get; set; }

    /// <summary>Shows the item but stops it from being chosen.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Runs on click on interactive pages.</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>The item text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private MenuContext? Menu { get; set; }

    [CascadingParameter] private MenuRadioGroup? RadioGroup { get; set; }

    private bool IsRadio => RadioGroup is not null;

    private bool IsCheckable => IsRadio || Checked is not null;

    private bool IsChecked => IsRadio ? RadioGroup!.IsSelected(Value) : Checked == true;

    private string Role => IsRadio ? "menuitemradio" : Checked is not null ? "menuitemcheckbox" : "menuitem";

    private bool Live => RendererInfo.IsInteractive;

    private string? AriaChecked => IsCheckable ? (IsChecked ? "true" : "false") : null;

    // In a radio group with a QueryKey, each option links to the page with that value set.
    private string? ResolvedHref => Href ?? (IsRadio && Value is not null ? RadioGroup!.HrefFor(Value) : null);

    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-menu-item");
        var accent = Accent ?? Accent.Neutral;
        classes.Add($"ib-menu-item-{accent.Role}", accent.Role is not null && accent != Accent.Neutral);
        if (accent.Custom is { } custom)
        {
            // A class and a variable, not an inline color, so the disabled style still wins.
            classes.Add("ib-menu-item-custom");
            styles.AddVar("menu-item-color", ColorOverride.TextTint(custom));
        }
        classes.Add("ib-menu-item-checkable", IsCheckable);
    }

    /// <inheritdoc />
    protected override void OnParametersSet() => (_class, _style) = BuildRootAttributes();

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        if (Checked is not null && CheckedChanged.HasDelegate)
        {
            await CheckedChanged.InvokeAsync(!Checked.Value);
        }

        if (IsRadio && Value is not null)
        {
            await RadioGroup!.SelectAsync(Value);
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }

    private RenderFragment Content => @<text>
        @if (IsCheckable)
        {
            @* Always there for checkable items, so labels line up whether checked or not. *@
            <span class="ib-menu-check" aria-hidden="true">
                @if (IsChecked)
                {
                    @if (IsRadio)
                    {
                        <span class="ib-menu-dot"></span>
                    }
                    else
                    {
                        <Icon Role="IconRole.Check" />
                    }
                }
            </span>
        }
        @if (Icon is { } icon)
        {
            <Icon Name="icon" />
        }
        <span class="ib-menu-label">@ChildContent</span>
        @if (Shortcut is not null)
        {
            <kbd class="ib-menu-shortcut">
                @* Mac modifier symbols as icons: no web font has them, and system fallbacks draw them
                   at very different sizes. The character stays for screen readers. *@
                @foreach (var c in Shortcut)
                {
                    if (ModifierIcon(c) is { } modifier)
                    {
                        <Icon Name="modifier" Class="ib-menu-key-icon" /><span class="ib-visually-hidden">@c</span>
                    }
                    else
                    {
                        @c
                    }
                }
            </kbd>
        }
    </text>;

    private static IconData? ModifierIcon(char c) => c switch
    {
        '\u2318' => Lucide.Command,
        '\u2325' => Lucide.Option,
        '\u21E7' => Lucide.ArrowBigUp,
        '\u2303' => Lucide.ChevronUp,
        _ => null,
    };
}
