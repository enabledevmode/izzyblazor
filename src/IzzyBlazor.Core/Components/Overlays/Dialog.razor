@namespace IzzyBlazor
@inherits ToggleComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, a dialog opened from the server isn't modal: focus can leave it, and Escape or a click outside closes it only in browsers with closedby (not Safari).")]

@*
    A modal built on the native <dialog>: the browser traps focus, makes the page behind it
    inert, closes it on Escape and returns focus afterwards.

    <DialogTrigger For="confirm-delete" Accent="Accent.Danger">Delete</DialogTrigger>

    <Dialog Id="confirm-delete" Title="Delete this project?" Size="DialogSize.Sm">
        This can't be undone.
        <DialogFooter>
            <DialogClose>Cancel</DialogClose>
            <Button Submit Form="delete-form" Accent="Accent.Danger">Delete</Button>
        </DialogFooter>
    </Dialog>

    Parts written among the content: DialogHeader (heading content in place of Title, drawn in the
    header row) and DialogFooter (the button row, written last, where it is: last in the dialog or
    last in a form that's last in it, so a form's submit button can be in the footer).

    Ways to open it:
      - DialogTrigger: a button with commandfor="id" command="show-modal" (native, with a
        script fallback for older browsers).
      - A link that adds ?dialog=id to the URL: the server renders it already open. Works
        with JavaScript off.
      - Open="true" or @bind-Open, for confirmations the server or C# decides to show.

    Put forms inside the Dialog rather than the Dialog inside a form. When it has to be inside
    one (a confirmation for that form's own submit button, say), set InsideForm: forms can't
    nest, so it then closes with the native close command instead of its own form.

    Accessibility:
    - `Title` (an `h2`) or a DialogHeader (a level-2 heading) names the dialog with
      `aria-labelledby`. Without either it has no name: pass an `aria-label`.
    - The close button is named "Close" (`CloseLabel`). Escape closes the dialog even when
      `ShowCloseButton` and `CloseOnBackdrop` are off.
    - DialogTrigger is a native `button` with `aria-haspopup="dialog"`, and focus comes back to
      it when the dialog closes.
    - Put `autofocus` on the field to start in. After an enhanced post that comes back with
      errors, the dialog reopens with focus on the first invalid field.
    - With JavaScript off, a dialog opened from the server (`?dialog=id`, `Open`) isn't modal:
      focus can leave it for the page behind. In browsers with the `closedby` attribute (Chrome
      and Edge 134, Firefox 141; not Safari), Escape closes it, and so does a click outside while
      `CloseOnBackdrop` is on. DialogTrigger needs no script in current browsers.
    - DialogService's dialogs (shown by DialogHost) are named by the title passed to `OpenAsync`,
      or by `DialogOptions.Label` without one; `ConfirmAsync` without a title is named by its
      message.
    See also: Drawer, ConfirmButton, Popover, Alert.
*@

<ib-dialog data-open="@(IsOpen ? "" : null)"
           data-query-key="@QueryKey"
           data-ib-interactive="@(RendererInfo.IsInteractive ? "" : null)"
           data-close-on-backdrop="@(CloseOnBackdrop ? "" : null)">
    <dialog @attributes="AdditionalAttributes"
            id="@ElementId"
            class="@_class"
            style="@_style"
            aria-labelledby="@(Title is not null || ShownHeader is not null ? TitleId : null)"
            closedby="@(CloseOnBackdrop ? "any" : "closerequest")"
            open="@(IsOpen && !IsInteractive)"
            @onibtoggle="HandleToggle">
        @* Close buttons submit this form: method="dialog" closes the dialog natively in every
           browser, with or without script. They also carry the native close command, which
           browsers use when there's no form (InsideForm). *@
        @if (!InsideForm)
        {
            <form method="dialog" id="@($"{ElementId}-close")" hidden></form>
        }
        <CascadingValue Value="_context" IsFixed="true">
        @* Buttons in the dialog don't take the style of a ButtonGroup around its trigger, or become a toolbar's items. *@
        <CascadingValue Value="ButtonGroup.Reset" IsFixed="true">
        <CascadingValue Value="ToolbarContext.Outside" IsFixed="true">
            @if (Title is not null || ShownHeader is not null || ShowCloseButton)
            {
                <header class="ib-dialog-header">
                    @if (ShownHeader is not null)
                    {
                        @* A heading, but a div: a DialogHeader may hold layout (a Row) that an h2 can't. *@
                        <div class="ib-dialog-title" id="@TitleId" role="heading" aria-level="2">@_scope.Outlet(ShownHeader!)</div>
                    }
                    else if (Title is not null)
                    {
                        <h2 class="ib-dialog-title" id="@TitleId">@Title</h2>
                    }
                    @if (ShowCloseButton)
                    {
                        <button type="@(InsideForm ? "button" : "submit")"
                                form="@(InsideForm ? null : $"{ElementId}-close")"
                                commandfor="@ElementId"
                                command="close"
                                class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-btn-sm ib-dialog-close"
                                aria-label="@(CloseLabel ?? TextDefaults.Close)">
                            <Icon Role="IconRole.Close" />
                        </button>
                    }
                </header>
            }
            <div class="@_bodyClass" style="@_bodyStyle">
                <CascadingValue Value="_scope" IsFixed="true">@ChildContent</CascadingValue>
            </div>
        </CascadingValue>
        </CascadingValue>
        </CascadingValue>
    </dialog>
</ib-dialog>

@code {
    /// <summary>The heading, which also names the dialog for screen readers.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The close button's name. Defaults to "Close".</summary>
    [Parameter] public string? CloseLabel { get; set; }

    /// <summary>The body, plus any <see cref="DialogHeader"/> and <see cref="DialogFooter"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Padding inside the body, in spacing steps, in place of the dialog's. <c>0</c> lets content
    /// such as a table or image run edge to edge.
    /// </summary>
    [Parameter] public Responsive<int> ContentPadding { get; set; }

    /// <summary>The width. Defaults to <see cref="DialogSize.Md"/>.</summary>
    [Parameter] public DialogSize Size { get; set; } = DialogSize.Md;

    /// <summary>
    /// Center (the default), a full-height drawer on the start or end side, or a full-width sheet along
    /// the top or bottom. A <see cref="Drawer"/> defaults to <see cref="DialogPlacement.End"/>.
    /// </summary>
    [Parameter] public DialogPlacement Placement { get; set; } = DialogPlacement.Center;

    /// <summary>Closes when the backdrop is clicked. Defaults to true. Escape always closes it.</summary>
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;

    /// <summary>Shows the close button in the header. Defaults to true.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    /// <summary>
    /// Set when the dialog is inside a <c>&lt;form&gt;</c>. Forms can't nest, so the dialog then
    /// closes with the native <c>close</c> command (with a script fallback in older browsers)
    /// instead of its own <c>method="dialog"</c> form, and its buttons don't submit the outer form.
    /// </summary>
    [Parameter] public bool InsideForm { get; set; }

    /// <summary>
    /// The query-string key that opens a dialog from a link: <c>?dialog=my-id</c> renders the
    /// dialog with that id already open. Defaults to <c>dialog</c>; null turns it off.
    /// </summary>
    [Parameter] public string? QueryKey { get; set; } = "dialog";

    private DialogContext _context = null!;
    private PartScope _scope = null!;

    [CascadingParameter] private PartScope? OuterScope { get; set; }

    private DialogHeader? ShownHeader => _scope.Shown<DialogHeader>();
    private string? _lastQueryValue;
    private bool _openedByQuery;
    private string? _class;
    private string? _style;
    private string? _bodyClass;
    private string? _bodyStyle;

    private string TitleId => $"{ElementId}-title";

    /// <inheritdoc />
    protected override string IdPrefix => "ib-dialog";

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-dialog");
        classes.Add($"ib-dialog-{Size.Name()}");
        classes.Add($"ib-dialog-{Placement.Name()}");
        base.BuildAttributes(classes, styles);
    }

    /// <summary>
    /// A dialog isn't in the page layout: <c>Width</c> replaces the <see cref="Size"/>'s width
    /// through the size's own variables, which keep a margin on small screens. Top and bottom
    /// sheets span the screen and ignore it.
    /// </summary>
    private protected override void BuildLayoutAttributes(ClassBuilder classes, StyleBuilder styles, bool itemProps) =>
        ApplyResponsive(classes, styles, Width, "ib-dialog-sized", "dlgw", StyleValues.Length);

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!Margin.IsEmpty || !MarginX.IsEmpty || !MarginY.IsEmpty || !MarginTop.IsEmpty || !MarginBottom.IsEmpty
            || !MarginStart.IsEmpty || !MarginEnd.IsEmpty || !MinWidth.IsEmpty || !MaxWidth.IsEmpty
            || Grow || !Shrink || !Basis.IsEmpty || !AlignSelf.IsEmpty)
        {
            throw new InvalidOperationException(
                $"A {GetType().Name} isn't laid out in the page, so margins, MinWidth, MaxWidth and the flex props don't apply. Set its Size, or Width for a width the sizes don't cover.");
        }

        _context ??= new DialogContext(ElementId, !InsideForm);

        // ?dialog=id opens it. Only a change in the URL does, so closing it in the browser sticks.
        if (QueryKey is not null)
        {
            var query = QueryString.Of(Navigation.Uri);
            var value = query.TryGetValue(QueryKey, out var values) ? values.ToString() : null;
            if (value != _lastQueryValue)
            {
                _lastQueryValue = value;
                if (value == ElementId && !IsOpen)
                {
                    IsOpen = true;
                    _openedByQuery = true;
                }
            }
        }

        (_class, _style) = BuildRootAttributes();

        var bodyClasses = new ClassBuilder().Add("ib-dialog-body");
        var bodyStyles = new StyleBuilder();
        ApplyResponsive(bodyClasses, bodyStyles, ContentPadding, "ib-px", "px", StyleValues.Spacing);
        ApplyResponsive(bodyClasses, bodyStyles, ContentPadding, "ib-py", "py", StyleValues.Spacing);
        // The same value for a DialogFooter in the body, which reaches out to the body's edges.
        ApplyResponsive(bodyClasses, bodyStyles, ContentPadding, "ib-dialog-pad", "dlgpad", StyleValues.Spacing);
        _bodyClass = bodyClasses.Build();
        _bodyStyle = bodyStyles.Build();
    }

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _scope = new PartScope(this, OuterScope, StateHasChanged);

        // On interactive pages the address can change without new parameters (a ?dialog= link
        // clicked again after the dialog was closed); follow it.
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (QueryKey is null)
        {
            return;
        }

        var value = QueryString.Of(e.Location).TryGetValue(QueryKey, out var values) ? values.ToString() : null;
        _lastQueryValue = value;
        if (value != ElementId || IsOpen)
        {
            return;
        }

        IsOpen = true;
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            if (!Open)
            {
                await OpenChanged.InvokeAsync(true);
            }
        });
    }

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        // Tell @bind-Open that the address opened it, so the page's state matches.
        if (_openedByQuery)
        {
            _openedByQuery = false;
            if (!Open)
            {
                await OpenChanged.InvokeAsync(true);
            }
        }
    }
}
