@namespace IzzyBlazor
@inherits LayoutItemBase
@implements IDisposable
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, it shows on hover and focus, but Escape doesn't hide it and screen readers don't announce it.")]

@*
    Short text shown on hover and keyboard focus. With JavaScript off it is pure CSS; with
    JavaScript it moves to the top layer (popover="hint"), so overflow never clips it, and
    links itself to the trigger with aria-describedby.

    <Tooltip Text="Copy to clipboard">
        <IconButton Icon="Lucide.Copy" Label="Copy" />
    </Tooltip>

    Accessibility:
    - It's a `tooltip` the script links to the first focusable element inside with
      `aria-describedby`, unless that element's `aria-label` already says the same.
    - It shows at once on keyboard focus, after `Delay` on hover, and Escape hides it.
    - The trigger must be focusable, such as a button or link; text alone can't be reached from
      the keyboard.
    - It describes, it doesn't name: an icon-only button still needs its own `Label`.
    - Never put essential content in it: touch screens can't hover, and it can't hold links or
      buttons.
    - With JavaScript off, it shows on hover and focus, but screen readers don't hear it and
      Escape doesn't hide it.
    See also: Popover, IconButton, Button.
*@

@_toolbar.Wrap(@<ib-tooltip class="@_outerClass"
            style="@_outerStyle"
            data-placement="@Placement.Name()"
            data-delay="@Delay">
    @* An IconButton in here leaves out its own title, so hovering shows one tooltip. *@
    @* In a toolbar the tooltip is the unit, and the control inside it reports to it. *@
    <CascadingValue Value="TooltipScope.Instance" IsFixed="true">
        <CascadingValue Value="_toolbar.Inner()">@ChildContent</CascadingValue>
    </CascadingValue>
    <span @attributes="AdditionalAttributes" id="@_id" role="tooltip" class="@_class" style="@_style">
        @if (Content is not null)
        {
            @Content
        }
        else
        {
            @Text
        }
    </span>
</ib-tooltip>)

@code {
    /// <summary>The tooltip text.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Tooltip content in place of <see cref="Text"/>. Inline content only, nothing interactive.</summary>
    [Parameter] public RenderFragment? Content { get; set; }

    /// <summary>Where it appears. Defaults to <see cref="Placement.Top"/>.</summary>
    [Parameter] public Placement Placement { get; set; } = Placement.Top;

    /// <summary>Milliseconds of hover before it appears. Defaults to 300. Keyboard focus shows it at once.</summary>
    [Parameter] public int Delay { get; set; } = 300;

    /// <summary>The element the tooltip describes, usually a button or link.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _id = IdGenerator.Next("ib-tooltip");
    private readonly ToolbarMember _toolbar;

    /// <summary>Creates the tooltip.</summary>
    public Tooltip() => _toolbar = new ToolbarMember(this);

    [CascadingParameter] private ToolbarScope? ToolbarScope { get; set; }
    private string? _class;
    private string? _style;
    private string? _outerClass;
    private string? _outerStyle;


    /// <inheritdoc />
    protected override bool VisibilityOnRoot => false;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-tooltip");
        classes.Add($"ib-tooltip-{Placement.Name()}");
        styles.AddRaw($"position-anchor:{StyleValues.AnchorName(_id)}");
        styles.AddVar("tooltip-delay", $"{Delay}ms");
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (Text is null && Content is null)
        {
            throw new InvalidOperationException("Tooltip needs Text or Content.");
        }

        if (Delay < 0)
        {
            throw new ArgumentOutOfRangeException(nameof(Delay), Delay, "Delay can't be negative.");
        }

        (_class, _style) = BuildRootAttributes();
        (_outerClass, _outerStyle) = BuildOuterAttributes("ib-tooltip-root", $"anchor-name:{StyleValues.AnchorName(_id)}");
        _toolbar.Update(ToolbarScope, entry: null);
    }

    /// <inheritdoc />
    public void Dispose() => _toolbar.Dispose();
}
