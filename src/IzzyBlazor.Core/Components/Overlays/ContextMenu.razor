@namespace IzzyBlazor
@inherits MenuBase
@attribute [ModeSupport(NoScript = ModeLevel.None, NoScriptNotes = "With JavaScript off, right-click shows the browser's own menu, so give the actions another way in.")]

@*
    A menu with no button, opened at the pointer by right-click, a long press, the menu key or
    Shift+F10 anywhere in the element whose id is For, such as a file list or a canvas. Links,
    fields and selected text keep the browser's menu, as does Shift+right-click.

    <ContextMenu For="files" Label="Folder actions">
        <MenuItem Href="?new=folder" Icon="Lucide.FolderPlus">New folder</MenuItem>
        <MenuItem Href="?upload" Icon="Lucide.Upload">Upload</MenuItem>
    </ContextMenu>

    Right-click can't be seen, so its actions need another way in, such as a toolbar. For the
    usual case, a menu with a button that also opens by right-click, use Menu's ContextFor.

    Accessibility:
    - With script, it's a `menu` named by `Label`, with `menuitem`, `menuitemcheckbox` and
      `menuitemradio` items; a MenuGroup is a `group` named by its `Label`.
    - Opening it focuses its first item; Escape or a choice puts focus back where it was.

    Keyboard:
    In the For element
    - Shift+F10, Menu key | Open the menu under the focused element
    In the menu
    - Up, Down | Move through the items, wrapping
    - Home, End | Go to the first or last item
    - Letters | Jump to the next item starting with them
    - Enter, Space | Choose the item
    - Escape | Close the menu and go back to where focus was
    - Right | On a MenuSub's item, open the submenu at its first item (Left on right-to-left pages)
    - Left | In a submenu, close it (Right on right-to-left pages)
    See also: Menu, Popover.
*@

@{ base.BuildRenderTree(__builder); }

@code {
    /// <summary>The id of the element whose right-click, long press, menu key or Shift+F10 opens the menu.</summary>
    [Parameter, EditorRequired] public string For { get; set; } = "";

    /// <summary>The menu's name for screen readers, such as "Folder actions".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <inheritdoc />
    private protected override string ContextTarget => For;

    /// <inheritdoc />
    private protected override string MenuName => Label;

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(For))
        {
            throw new InvalidOperationException("ContextMenu needs For: the id of the element whose right-click opens it.");
        }

        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException("ContextMenu needs a Label: it names the menu.");
        }

        base.OnParametersSet();
    }
}
