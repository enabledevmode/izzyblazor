@namespace IzzyBlazor
@inherits IzzyComponentBase
@using Microsoft.AspNetCore.Components.Web

@*
    One action in an ActionSheet: a full-width outlined button. It takes MenuItem's parameters, so
    it acts on static pages too: Href is a link, Submit posts the surrounding form (or Form="id"),
    and OnClick runs C# on interactive pages, after which the sheet closes.
*@

<Button Href="@Href" Submit="Submit" Name="@Name" Value="@Value" FormAction="@FormAction" Form="@Form"
        StartIcon="Icon" Accent="Accent" Disabled="Disabled" Variant="ButtonVariant.Outline" FullWidth
        OnClick="HandleClick" Class="@Class" Style="@Style" @attributes="AdditionalAttributes">@ChildContent</Button>

@code {
    /// <summary>Makes the item a link to this URL.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Posts the surrounding form (or <see cref="Form"/>), optionally to <see cref="FormAction"/>.</summary>
    [Parameter] public bool Submit { get; set; }

    /// <summary>
    /// Posted as <c>Name=Value</c> when the item is chosen. Not <c>action</c>, <c>method</c> or
    /// <c>target</c>: a control with one of those names hides the form's own property, and
    /// Blazor's enhanced form handling then posts to the wrong address.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>The value posted with <see cref="Name"/>.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>Submits to this URL instead of the form's own action.</summary>
    [Parameter] public string? FormAction { get; set; }

    /// <summary>The id of the form to submit, when the sheet is not inside it.</summary>
    [Parameter] public string? Form { get; set; }

    /// <summary>An icon before the text.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>
    /// The color. <see cref="Accent.Neutral"/> (the default) is plain; use
    /// <see cref="Accent.Danger"/> for a destructive action.
    /// </summary>
    [Parameter] public Accent Accent { get; set; } = Accent.Neutral;

    /// <summary>Shows the item but stops it from being chosen.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Runs on click on interactive pages; then the sheet closes.</summary>
    [Parameter, ModeSupport(NoScript = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>The item's text.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private ActionSheet? Sheet { get; set; }

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        await OnClick.InvokeAsync(e);
        if (Sheet is not null)
        {
            await Sheet.CloseAsync();
        }
    }
}
