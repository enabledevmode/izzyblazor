@namespace IzzyBlazor
@implements IDisposable
@attribute [System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessage("Trimming", "IL2111", Justification = "The renderer sets DynamicComponent.Type as a parameter. The type comes from DialogService.OpenAsync, which keeps the component's members for the trimmer.")]
@inject IServiceProvider Services
@attribute [ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None, Notes = "A static page can't show dialogs from code: put the host on an interactive page.")]

@*
    Where DialogService shows its dialogs. Put one on an interactive page or in an interactive
    layout, with @rendermode on the host where the layout is static:

    <DialogHost />

    Each dialog is a Dialog, so focus is trapped, Escape and the backdrop cancel it, and focus
    returns to where it was.
*@

@if (_service is not null && _service.IsActiveHost(this))
{
    @foreach (var entry in _service.Open)
    {
        <Dialog @key="entry.Instance.Id"
                Id="@entry.Instance.Id"
                Title="@entry.Title"
                Size="entry.Options.Size"
                Width="@(entry.Options.Width is { } width ? width : default(Responsive<Length>))"
                Placement="entry.Options.Placement"
                CloseOnBackdrop="entry.Options.CloseOnBackdrop"
                ShowCloseButton="entry.Options.ShowCloseButton"
                QueryKey="@null"
                Open="entry.IsOpen"
                OpenChanged="open => OnOpenChanged(entry, open)"
                Class="@entry.Options.ColorScheme.ClassName()"
                Style="@BrandStyle(entry.Options)"
                data-ib-brand="@BrandName(entry.Options)"
                data-ib-density="@(entry.Options.Density?.ToString().ToLowerInvariant())"
                aria-label="@(entry.Title is null ? entry.Options.Label : null)">
            <CascadingValue Value="entry.Instance" IsFixed="true">
                <DynamicComponent Type="entry.Component" Parameters="entry.Parameters" />
            </CascadingValue>
        </Dialog>
    }
}

@code {
    private DialogService? _service;
    private bool _registered;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _service = Services.GetService(typeof(DialogService)) as DialogService
            ?? throw new InvalidOperationException("DialogHost needs DialogService: call AddIzzyBlazorCore() (or AddIzzyBlazor() on the server).");

        // A static render can't show dialogs, so only an interactive host counts.
        if (RendererInfo.IsInteractive)
        {
            _service.Changed += OnChanged;
            _service.AddHost(this);
            _registered = true;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private static string? BrandName(DialogOptions options) =>
        string.IsNullOrWhiteSpace(options.Brand) ? null : ThemeColors.Parse(options.Brand, ThemeColors.Brands, nameof(DialogOptions.Brand)).Name;

    private static string? BrandStyle(DialogOptions options) =>
        string.IsNullOrWhiteSpace(options.Brand) || ThemeColors.Parse(options.Brand, ThemeColors.Brands, nameof(DialogOptions.Brand)).Hex is not { } hex
            ? null
            : BrandPalette.From(hex).ToCss();

    // Escape, the backdrop or the close button: the dialog is canceled.
    private void OnOpenChanged(DialogEntry entry, bool open)
    {
        if (!open)
        {
            entry.Instance.Cancel();
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (_registered && _service is not null)
        {
            _service.Changed -= OnChanged;
            _service.RemoveHost(this);
        }
    }
}
