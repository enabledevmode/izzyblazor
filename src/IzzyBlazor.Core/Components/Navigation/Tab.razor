@namespace IzzyBlazor
@inherits IzzyComponentBase
@implements IDisposable

@*
    One tab of a Tabs: its label goes in the tab list and its content in a panel. All panels
    are rendered; CSS shows the selected one.
*@

@if (Context is not null)
{
    @* Tab roles come from <ib-tabs> with script; with no script the tabs are a radio group. *@
    <div @attributes="AdditionalAttributes"
         id="@Context.PanelId(this)"
         class="@_class"
         style="@_style">
        @* Fields inside register with their tab, so Tabs can count each tab's errors. *@
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
}

@code {
    /// <summary>The label in the tab list.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>
    /// The value that identifies this tab in <c>@bind-Selected</c> and in the URL. Defaults to
    /// the title in lower case with dashes, such as <c>billing-history</c>. Tabs that end up
    /// with the same value get <c>-2</c>, <c>-3</c>... added.
    /// </summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>An icon before the label.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>A small count or label after the title, such as "3".</summary>
    [Parameter] public string? Badge { get; set; }

    /// <summary>Shows the tab but stops it being selected.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Padding inside this tab's panel, in spacing steps, in place of the tabs' <c>ContentPadding</c>.</summary>
    [Parameter] public Responsive<int> ContentPadding { get; set; }

    /// <summary>The panel content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] internal TabsContext? Context { get; set; }

    private string? _class;
    private string? _style;
    // Fields inside this tab, counted: two fields can edit the same property (one shown under a
    // condition), and removing one mustn't drop the other.
    private readonly Dictionary<FieldIdentifier, int> _fields = [];

    /// <summary>The tab this one is nested in: fields in an inner tab count toward the outer one too.</summary>
    [CascadingParameter] internal Tab? ParentTab { get; set; }

    /// <summary>A field inside this tab, so its errors count toward the tab's.</summary>
    internal void AddField(FieldIdentifier field)
    {
        _fields[field] = _fields.GetValueOrDefault(field) + 1;
        ParentTab?.AddField(field);
        Context?.FieldsChanged();
    }

    internal void RemoveField(FieldIdentifier field)
    {
        if (!_fields.TryGetValue(field, out var count))
        {
            return;
        }

        if (count > 1)
        {
            _fields[field] = count - 1;
        }
        else
        {
            _fields.Remove(field);
        }

        ParentTab?.RemoveField(field);
        Context?.FieldsChanged();
    }

    /// <summary>The validation messages on this tab's fields.</summary>
    internal int ErrorCount(EditContext context) => _fields.Keys.Sum(field => context.GetValidationMessages(field).Count());

    /// <summary>The value used for ids and selection.</summary>
    internal string Key => Value ?? Slug(Label);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException($"{nameof(Tab)} needs a {nameof(Label)}.");
        }

        Context?.Register(this);
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-tab-panel");
        var padding = ContentPadding.IsEmpty ? Context?.ContentPadding ?? default : ContentPadding;
        ApplyResponsive(classes, styles, padding, "ib-px", "px", StyleValues.Spacing);
        ApplyResponsive(classes, styles, padding, "ib-py", "py", StyleValues.Spacing);
    }

    private (string, string?, IconData?, string?, bool)? _shown;

    /// <summary>The tabs' <c>ContentPadding</c> changed: recompute the panel's padding.</summary>
    internal void ContentPaddingChanged()
    {
        if (ContentPadding.IsEmpty)
        {
            (_class, _style) = BuildRootAttributes();
            StateHasChanged();
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        (_class, _style) = BuildRootAttributes();

        // The tab list is rendered by Tabs, so tell it when what it shows has changed.
        var shown = (Label, Value, Icon, Badge, Disabled);
        if (_shown is { } previous && previous != shown)
        {
            Context?.Changed();
        }

        _shown = shown;
    }

    internal static string Slug(string text)
    {
        var chars = new System.Text.StringBuilder(text.Length);
        var dash = false;
        foreach (var c in text.Trim().ToLowerInvariant())
        {
            if (char.IsLetterOrDigit(c))
            {
                chars.Append(c);
                dash = false;
            }
            else if (!dash && chars.Length > 0)
            {
                chars.Append('-');
                dash = true;
            }
        }

        return chars.ToString().TrimEnd('-') is { Length: > 0 } slug ? slug : "tab";
    }

    /// <inheritdoc />
    public void Dispose() => Context?.Unregister(this);
}
