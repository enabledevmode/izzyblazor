@namespace IzzyBlazor
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable

@*
    A tab in a TabNav: a link to its own page, marked current from the URL on the server.

    <TabNav Label="Settings">
        <TabLink Href="settings/profile" Label="Profile" Icon="Lucide.User" />
        <TabLink Href="settings/billing" Label="Billing" Badge="2" />
    </TabNav>
*@

@code {
    /// <summary>The page the tab links to.</summary>
    [Parameter, EditorRequired] public string Href { get; set; } = "";

    /// <summary>The tab's text.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>An icon before the label.</summary>
    [Parameter] public IconData? Icon { get; set; }

    /// <summary>A small count or label after the text, such as "3".</summary>
    [Parameter] public string? Badge { get; set; }

    /// <summary>Shows the tab but not as a link.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// How the current URL must match <see cref="Href"/> for the tab to be selected. <c>Prefix</c>
    /// (the default) also selects it on pages below it. A link with a query string (<c>?tab=billing</c>)
    /// is selected only when the current query string is the same, and then a tab whose link has no
    /// query isn't, so tabs for one page told apart by the query select one at a time.
    /// </summary>
    [Parameter] public NavLinkMatch Match { get; set; } = NavLinkMatch.Prefix;

    /// <summary>
    /// Marks the tab current (<c>true</c>) or not (<c>false</c>) whatever the URL, for a choice the
    /// page knows from elsewhere, such as a cookie. Unset (the default): from the URL, by
    /// <see cref="Match"/>, unless another tab is set current. A current tab set this way has
    /// <c>aria-current="true"</c> (a choice, not necessarily this page); a disabled tab is never current.
    /// </summary>
    [Parameter] public bool? Current { get; set; }

    /// <summary>Extra attributes for the link, such as <c>data-enhance-nav</c>.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    [CascadingParameter] internal TabNav? Context { get; set; }

    private (string, string, IconData?, string?, bool, NavLinkMatch, bool?)? _shown;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Label))
        {
            throw new InvalidOperationException($"{nameof(TabLink)} needs a {nameof(Label)}.");
        }

        if (Context is null)
        {
            throw new InvalidOperationException($"{nameof(TabLink)} goes inside a {nameof(TabNav)}.");
        }

        Context.Register(this);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        // TabNav renders the link, so tell it when what it shows has changed.
        var shown = (Href, Label, Icon, Badge, Disabled, Match, Current);
        if (_shown is { } previous && previous != shown)
        {
            Context?.Changed();
        }

        _shown = shown;
    }

    /// <inheritdoc />
    public void Dispose() => Context?.Unregister(this);
}
