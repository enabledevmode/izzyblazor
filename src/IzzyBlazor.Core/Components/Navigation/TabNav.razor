@namespace IzzyBlazor
@inherits TabsBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@attribute [ModeSupport(NoScript = ModeLevel.Partial, NoScriptNotes = "With JavaScript off, links that don't fit scroll by touch, trackpad or Shift+wheel only, and the current one isn't scrolled into view.")]

@*
    Tabs that are links to pages of their own, for sections split across routes
    (/settings/profile, /settings/billing): a nav of real links drawn as tabs, with no panels and
    no script needed. The server marks the tab for the current URL.

    Accessibility:
    - It's a `nav` of plain links that Tab moves between (no arrow keys, as these aren't ARIA tabs).
    - The current page's link has `aria-current`; a disabled one is a link with no `href`, announced
      as disabled (`aria-disabled`).
    - `Label` names the `nav`. Give each its own when a page has more than one, or when the
      purpose isn't clear from the heading before it.
    See also: Tabs, NavMenu, SegmentedControl.
*@

<nav @attributes="AdditionalAttributes"
     id="@Id"
     class="@_class"
     style="@_style"
     aria-label="@Label">
    <div class="ib-tabs-list">
        @{ var current = CurrentLinks(); }
        @for (var i = 0; i < _links.Count; i++)
        {
            var link = _links[i];
            @if (link.Disabled)
            {
                @* A link without an href, as Button does: role="link" keeps it in the list of links, disabled. *@
                <span class="ib-tab ib-tab-disabled" role="link" aria-disabled="true">@TabContent(link.Icon, link.Label, link.Badge)</span>
            }
            else
            {
                <a @attributes="link.AdditionalAttributes"
                   class="ib-tab"
                   href="@link.Href"
                   aria-current="@LinkMatch.AriaCurrent(current[i])">@TabContent(link.Icon, link.Label, link.Badge)</a>
            }
        }
    </div>
    <CascadingValue Value="this" IsFixed="true">
        @ChildContent
    </CascadingValue>
</nav>

@code {
    private readonly List<TabLink> _links = [];
    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    /// <inheritdoc />
    protected override void OnParametersSet() => (_class, _style) = BuildRootAttributes();

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-tabs-nav");
        base.BuildAttributes(classes, styles);
    }

    // The current link follows the address on interactive pages.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    internal void Register(TabLink link)
    {
        if (!_links.Contains(link))
        {
            _links.Add(link);
            StateHasChanged();
        }
    }

    internal void Unregister(TabLink link)
    {
        if (_links.Remove(link))
        {
            StateHasChanged();
        }
    }

    internal void Changed() => StateHasChanged();

    // Each link's match. A link's own Current wins; the others follow the URL, unless a link is
    // Current, which leaves them unmarked so only one tab is current. Tabs on one page told apart
    // by the query (?view=billing): a link without a query matches its page whatever the query, so
    // when a link with one matches, the one without gives way.
    private (bool Active, bool Exact)[] CurrentLinks()
    {
        var links = _links;
        var fromUrl = links.Select(l => !l.Disabled && l.Current is null).ToArray();
        var states = links.Select((l, i) => fromUrl[i] ? LinkMatch.Of(Navigation, l.Href, Navigation.Uri, l.Match) : (Active: false, Exact: false)).ToArray();
        var queried = links.Select((l, i) => fromUrl[i] && Navigation.ToAbsoluteUri(l.Href).Query.Length > 1).ToArray();
        if (states.Where((state, i) => state.Active && queried[i]).Any())
        {
            for (var i = 0; i < states.Length; i++)
            {
                if (!queried[i])
                {
                    states[i] = (false, false);
                }
            }
        }

        var chosen = links.Any(l => !l.Disabled && l.Current == true);
        for (var i = 0; i < states.Length; i++)
        {
            if (links[i].Disabled)
            {
                continue;
            }

            if (links[i].Current is { } current)
            {
                states[i] = (current, false);
            }
            else if (chosen)
            {
                states[i] = (false, false);
            }
        }

        return states;
    }
}
