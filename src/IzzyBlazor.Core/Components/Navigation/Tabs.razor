@namespace IzzyBlazor
@inherits LayoutItemBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation
@inject IServiceProvider Services
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, tabs switch as a radio group, but screen readers don't hear them as tabs, the URL doesn't follow, and tabs that don't fit scroll by touch, trackpad or Shift+wheel only, with the selected one not scrolled into view.")]

@*
    A set of tabs, in three layers:
      - No script: each tab holds a radio button and its label, and CSS :has(:checked) shows the
        matching panel. Switching is instant and keeps form input; arrow keys move between tabs
        like any radio group.
      - With script: <ib-tabs> turns the list into ARIA tabs (tablist, tab, aria-selected,
        roving focus) and, with QueryKey, keeps the URL in step so the tab can be linked to.
      - Interactive: @bind-Selected follows the radios' change events and can set the tab from C#.

    <Tabs @bind-Selected="tab" Label="Account">
        <Tab Label="Profile" Icon="Lucide.User">...</Tab>
        <Tab Label="Billing" Badge="2">...</Tab>
    </Tabs>

    Orientation="Orientation.Vertical" puts the tabs in a column beside the panels from 640px up
    (a scrolling row above them on phones). With TabLink children instead of Tab, it renders a
    nav of links to separate pages; see TabLink. Up to 30 tabs show their panels: the CSS has a
    rule for each position.

    Accessibility:
    - With script, the list is ARIA tabs (`tablist`, `tab`, `tabpanel`, `aria-selected`) with only
      the selected tab in the tab order; with JavaScript off it's heard as a radio group.
    - Arrow keys select the next or previous tab, skipping disabled ones; with script, Home and End
      go to the first and last, and vertical tabs laid out as a column use Up and Down.
    - In a form with JavaScript off, there are no tabs: every panel shows in order, each after its
      tab's label as plain text, so every field can be filled in.
    - With script, each panel is named by its tab and takes focus, so Tab moves from the tab to the
      panel.
    - `Label` names the tab list (or the `nav` of TabLinks). It's optional, as in ARIA and other
      libraries, with no default; set it when the tabs' purpose isn't clear from the heading
      before them, and give each `nav` of TabLinks its own when a page has more than one.
    - In a form, with script, a tab whose fields have errors shows a count, read as part of its
      name ("Billing (1 error)").
    - TabLinks render a `nav` of plain links that Tab moves between (no arrow keys); the current
      page's link has `aria-current`, and a disabled one is a link with no `href`, announced as
      disabled (`aria-disabled`).
    See also: SegmentedControl, NavMenu, Accordion.
*@

@if (_context.Links.Count > 0)
{
    if (_context.Items.Count > 0)
    {
        throw new InvalidOperationException("A Tabs holds either Tab (panels on this page) or TabLink (links to other pages), not both.");
    }

    <nav @attributes="AdditionalAttributes"
         id="@Id"
         class="@_class"
         style="@_style"
         aria-label="@Label">
        <div class="ib-tabs-list">
            @{ var current = CurrentLinks(); }
            @for (var i = 0; i < _context.Links.Count; i++)
            {
                var link = _context.Links[i];
                @if (link.Disabled)
                {
                    @* A link without an href, as Button does: role="link" keeps it in the list of links, disabled. *@
                    <span class="ib-tab ib-tab-disabled" role="link" aria-disabled="true">@TabContent(link.Icon, link.Label, link.Badge)</span>
                }
                else
                {
                    <a @attributes="link.AdditionalAttributes"
                       class="ib-tab"
                       href="@link.Href"
                       aria-current="@LinkMatch.AriaCurrent(current[i])">@TabContent(link.Icon, link.Label, link.Badge)</a>
                }
            }
        </div>
        <CascadingValue Value="_context" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </nav>
}
else
{
<ib-tabs @attributes="AdditionalAttributes"
         id="@RootId"
         class="@_class"
         style="@_style"
         data-selected="@SelectedValue"
         data-query-key="@QueryKey">
    <div class="ib-tabs-list" role="radiogroup" aria-label="@Label" aria-orientation="@(Orientation == Orientation.Vertical ? "vertical" : null)">
        @foreach (var tab in _context.Items)
        {
            var selected = _context.IsSelected(tab);
            var key = _context.KeyOf(tab);
            @* A span, not the label, takes role="tab" with script (a label can't have a role); the
               label inside is stretched over it (CSS), so the whole tab checks the radio. *@
            <span class="@(tab.Disabled ? "ib-tab ib-tab-disabled" : "ib-tab")" id="@_context.TabId(tab)" data-value="@key">
                <input type="radio"
                       class="ib-tab-input ib-visually-hidden"
                       name="@RootId"
                       id="@_context.InputId(tab)"
                       value="@key"
                       checked="@selected"
                       disabled="@tab.Disabled"
                       aria-controls="@_context.PanelId(tab)"
                       @onchange="() => SelectAsync(key)" />
                <label class="ib-tab-label" for="@_context.InputId(tab)">@TabContent(tab.Icon, tab.Label, tab.Badge, _subscribed is null || tab.Disabled ? 0 : tab.ErrorCount(_subscribed))</label>
            </span>
        }
    </div>
    <CascadingValue Value="_context" IsFixed="true">
        @ChildContent
    </CascadingValue>
</ib-tabs>
}

@code {
    /// <summary>The selected tab's <see cref="Tab.Value"/>. Defaults to the first tab that isn't disabled.</summary>
    [Parameter] public string? Selected { get; set; }

    /// <summary>Called when someone picks a tab (interactive pages).</summary>
    [Parameter, ModeSupport(Off = ModeLevel.None, Static = ModeLevel.None)]
    public EventCallback<string> SelectedChanged { get; set; }

    /// <summary>The tab list's (or the TabLinks' <c>nav</c>'s) name for screen readers, such as "Account settings".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Keeps the selected tab in the URL under this query-string key, such as <c>tab</c>: a link
    /// to <c>?tab=billing</c> opens that tab, and with JavaScript switching tabs updates the URL.
    /// </summary>
    [Parameter] public string? QueryKey { get; set; }

    /// <summary>How the tabs look. Defaults to <see cref="TabsVariant.Line"/>.</summary>
    [Parameter] public TabsVariant Variant { get; set; } = TabsVariant.Line;

    /// <summary>Tab height and text size, shared with buttons and fields. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    /// <summary>Stretches the tabs to share the full width (or, vertical, the list's width).</summary>
    [Parameter] public bool FullWidth { get; set; }

    /// <summary>
    /// Padding on every side of each panel, in spacing steps, in place of the default space above
    /// and below (the default has none at the sides). <c>0</c> lets content such as a table run edge
    /// to edge. A <see cref="Tab"/> can set its own.
    /// </summary>
    [Parameter] public Responsive<int> ContentPadding { get; set; }

    /// <summary>
    /// A row above the panels (the default), or a column beside them from 640px up. Vertical tabs
    /// stay a scrolling row on phones, where a column would crowd the content.
    /// </summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>The element id; tab and panel ids build on it. Generated when not set.</summary>
    [Parameter] public string? Id { get; set; }

    /// <summary>The <see cref="Tab"/>s.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private TabsContext _context = null!;
    private string? _generatedId;
    private string? _selected;
    private string? _lastSelectedParam;
    private bool _initialized;
    private string? _class;
    private string? _style;
    private Responsive<int> _lastContentPadding;

    internal string RootId => Id ?? (_generatedId ??= IdGenerator.Next("ib-tabs"));

    /// <summary>The selected tab: the chosen one if it exists and isn't disabled, else the first that isn't.</summary>
    internal string? SelectedValue =>
        _context.Items.Where(t => !t.Disabled).Select(_context.KeyOf).FirstOrDefault(k => k == _selected)
        ?? _context.Items.Where(t => !t.Disabled).Select(_context.KeyOf).FirstOrDefault();

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _context = new TabsContext(this);
        Navigation.LocationChanged += OnLocationChanged;
    }

    // Link tabs mark the current page, and a QueryKey tab follows the address (a link to
    // ?tab=billing on the same page); follow navigation on interactive pages.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_context.Links.Count > 0)
        {
            InvokeAsync(StateHasChanged);
            return;
        }

        if (QueryKey is not null
            && QueryString.Of(e.Location).TryGetValue(QueryKey, out var values)
            && values.ToString() is { Length: > 0 } value
            && value != _selected)
        {
            InvokeAsync(async () =>
            {
                _selected = value;
                StateHasChanged();
                try
                {
                    await SelectedChanged.InvokeAsync(value);
                }
                catch (Exception ex)
                {
                    await DispatchExceptionAsync(ex);
                }
            });
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Unsubscribe();
    }

    // Inside a Form: each tab shows how many errors its fields have, and after a submit that fails
    // the first tab with errors opens, unless the open one has some. Only after a submit: errors
    // that appear while someone types on one tab never switch them to another.
    [CascadingParameter] private EditContext? EditContext { get; set; }

    private EditContext? _subscribed;
    private bool _submitPending;
    private int[] _counts = [];

    private void Subscribe()
    {
        if (ReferenceEquals(EditContext, _subscribed))
        {
            return;
        }

        Unsubscribe();
        _subscribed = EditContext;
        if (_subscribed is not null)
        {
            _subscribed.OnValidationRequested += OnValidationRequested;
            _subscribed.OnValidationStateChanged += OnValidationStateChanged;
            _subscribed.OnFieldChanged += OnFieldChanged;
        }
    }

    private void Unsubscribe()
    {
        if (_subscribed is not null)
        {
            _subscribed.OnValidationRequested -= OnValidationRequested;
            _subscribed.OnValidationStateChanged -= OnValidationStateChanged;
            _subscribed.OnFieldChanged -= OnFieldChanged;
            _subscribed = null;
        }
    }

    // A submit. Its validation pass runs inside this event: the default validator subscribed
    // first, so its messages are usually in already, and one placed after Tabs reports them
    // through OnValidationStateChanged before Validate returns. The submit stays pending until the
    // pass ends (a yield), so a later edit never switches tabs, whatever its validator checks.
    private void OnValidationRequested(object? sender, ValidationRequestedEventArgs e)
    {
        _submitPending = true;
        Refresh();
        _ = EndSubmitAsync();
    }

    private async Task EndSubmitAsync()
    {
        await Task.Yield();
        _submitPending = false;
    }

    private void OnValidationStateChanged(object? sender, ValidationStateChangedEventArgs e) => Refresh();

    private void OnFieldChanged(object? sender, FieldChangedEventArgs e) => _submitPending = false;

    // Opens the first tab with errors after a submit, and renders again only when that or a
    // tab's count changed (rendering Tabs renders every field in every panel). On the renderer's
    // dispatcher, where it runs at once when called from it: a validator may report from another
    // thread.
    private void Refresh() => _ = InvokeAsync(async () =>
    {
        if (_subscribed is not { } context)
        {
            return;
        }

        string? target = null;
        if (_submitPending && context.GetValidationMessages().Any())
        {
            _submitPending = false;
            target = TabToOpen();
        }

        var counts = _context.Items.Select(t => t.ErrorCount(context)).ToArray();
        if (target is null && counts.SequenceEqual(_counts))
        {
            return;
        }

        _counts = counts;
        if (target is not null)
        {
            _selected = target;
        }

        StateHasChanged();
        if (target is not null)
        {
            try
            {
                await SelectedChanged.InvokeAsync(target);
            }
            catch (Exception ex)
            {
                await DispatchExceptionAsync(ex);
            }
        }
    });

    // The first tab with errors, or null when the open tab has some (or none has).
    private string? TabToOpen()
    {
        if (_subscribed is not { } context)
        {
            return null;
        }

        var tabs = _context.Items.Where(t => !t.Disabled).ToList();
        var open = tabs.FirstOrDefault(t => _context.KeyOf(t) == SelectedValue);
        if (open is not null && open.ErrorCount(context) > 0)
        {
            return null;
        }

        return tabs.FirstOrDefault(t => t.ErrorCount(context) > 0) is { } tab ? _context.KeyOf(tab) : null;
    }

    // A field registered with a tab: its errors may need showing.
    internal void FieldsChanged() => Refresh();

    // Each link's match. A link's own Current wins; the others follow the URL, unless a link is
    // Current, which leaves them unmarked so only one tab is current. Tabs on one page told apart
    // by the query (?view=billing): a link without a query matches its page whatever the query, so
    // when a link with one matches, the one without gives way.
    private (bool Active, bool Exact)[] CurrentLinks()
    {
        var links = _context.Links;
        var fromUrl = links.Select(l => !l.Disabled && l.Current is null).ToArray();
        var states = links.Select((l, i) => fromUrl[i] ? LinkMatch.Of(Navigation, l.Href, Navigation.Uri, l.Match) : (Active: false, Exact: false)).ToArray();
        var queried = links.Select((l, i) => fromUrl[i] && Navigation.ToAbsoluteUri(l.Href).Query.Length > 1).ToArray();
        if (states.Where((state, i) => state.Active && queried[i]).Any())
        {
            for (var i = 0; i < states.Length; i++)
            {
                if (!queried[i])
                {
                    states[i] = (false, false);
                }
            }
        }

        var chosen = links.Any(l => !l.Disabled && l.Current == true);
        for (var i = 0; i < states.Length; i++)
        {
            if (links[i].Disabled)
            {
                continue;
            }

            if (links[i].Current is { } current)
            {
                states[i] = (current, false);
            }
            else if (chosen)
            {
                states[i] = (false, false);
            }
        }

        return states;
    }

    private RenderFragment TabContent(IconData? icon, string label, string? badge, int errors = 0) => __builder =>
    {
        if (icon is { } shown)
        {
            <Icon Name="shown" />
        }
        <span class="ib-tab-text">@label</span>
        if (badge is not null)
        {
            <Badge Size="BadgeSize.Sm" Pill>@badge</Badge>
        }
        if (errors > 0)
        {
            var text = IzzyText.From(Services);
            <Badge Size="BadgeSize.Sm" Pill Status="Status.Danger" Class="ib-tab-errors"><span aria-hidden="true">@errors</span><span class="ib-visually-hidden">(@(errors == 1 ? text.OneError : string.Format(System.Globalization.CultureInfo.CurrentCulture, text.ErrorCount, errors)))</span></Badge>
        }
    };

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        Subscribe();
        if (!_initialized)
        {
            _initialized = true;
            _selected = FromQuery() ?? Selected;
            _lastSelectedParam = Selected;
            _lastContentPadding = ContentPadding;
            (_class, _style) = BuildRootAttributes();

            // A tab named in the URL wins; a bound parent hears about it once the page is interactive.
            if (_selected != Selected && _selected is not null && RendererInfo.IsInteractive && SelectedChanged.HasDelegate)
            {
                await SelectedChanged.InvokeAsync(_selected);
            }

            return;
        }

        if (Selected != _lastSelectedParam)
        {
            _selected = Selected;
            _lastSelectedParam = Selected;
        }

        // Tabs compute their panel's padding from this; a tab whose own parameters didn't change
        // isn't rendered again, so tell each one.
        if (!ContentPadding.Equals(_lastContentPadding))
        {
            _lastContentPadding = ContentPadding;
            foreach (var tab in _context.Items)
            {
                tab.ContentPaddingChanged();
            }
        }

        (_class, _style) = BuildRootAttributes();
    }

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-tabs");
        classes.Add($"ib-tabs-{Variant.Name()}");
        classes.Add("ib-tabs-sm", Size == ControlSize.Sm);
        classes.Add("ib-tabs-lg", Size == ControlSize.Lg);
        classes.Add("ib-tabs-fitted", FullWidth);
        classes.Add("ib-tabs-vertical", Orientation == Orientation.Vertical);
        classes.Add("ib-tabs-nav", _context.Links.Count > 0);
        base.BuildAttributes(classes, styles);
    }

    internal void TabsChanged()
    {
        // Link tabs register after the first render and change the root's classes (ib-tabs-nav).
        (_class, _style) = BuildRootAttributes();
        StateHasChanged();
    }

    private string? FromQuery()
    {
        if (QueryKey is null)
        {
            return null;
        }

        var query = QueryString.Of(Navigation.Uri);
        return query.TryGetValue(QueryKey, out var value) ? value.ToString() : null;
    }

    private Task SelectAsync(string value)
    {
        // The script writes ?{QueryKey}= with history.replaceState, on interactive pages too: going
        // through NavigationManager would reload the page on each click where there's no
        // interactive router. The cost: Navigation.Uri doesn't see the tab until the next navigation.
        _selected = value;
        return SelectedChanged.InvokeAsync(value);
    }
}
