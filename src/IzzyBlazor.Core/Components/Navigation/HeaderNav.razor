@namespace IzzyBlazor
@inherits IzzyComponentBase
@implements IDisposable

@*
    A site's links in an AppHeader: a row of links on wide screens and, below Breakpoint, a menu
    button that opens the same links as a sheet from the top of the screen. For sites with no
    sidebar; an app with a sidebar puts its links there and uses SidebarToggle.

    <AppHeader>
        <strong>Acme</strong>
        <Box Grow />
        <HeaderNav>
            <NavItem Href="/projects">Projects</NavItem>
            <NavItem Href="/articles">Articles</NavItem>
        </HeaderNav>
    </AppHeader>

    The items render twice, once in the row and once in the sheet; only one of them shows at a time.
    The sheet is a native popover opened by its button, so it works with JavaScript off (light
    dismiss and Escape come from the browser). With script, <ib-header-nav> also closes it when a
    link is followed (enhanced navigation keeps the page) or the screen grows past the breakpoint,
    and moves focus into it.

    Inside an AppShell with an AppSidebar, the menu button and sheet stay hidden: below the
    breakpoint the links show at the top of the sidebar (its drawer on phones), so there is one menu.
*@

<ib-header-nav @attributes="AdditionalAttributes" class="@_class" style="@_style">
    <nav class="ib-header-nav-bar" aria-label="@NavLabel">
        <ul class="ib-nav ib-nav-horizontal">
            @ChildContent
        </ul>
    </nav>
    <button type="button"
            class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-header-nav-toggle"
            popovertarget="@PanelId"
            aria-label="@(MenuLabel ?? TextDefaults.OpenMenu)">
        <Icon Role="IconRole.Menu" />
    </button>
    <div id="@PanelId" popover class="ib-header-nav-panel">
        <div class="ib-header-nav-top">
            @if (PanelHeader is not null)
            {
                <div class="ib-header-nav-head">@PanelHeader</div>
            }
            <button type="button"
                    class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-icon-only ib-header-nav-close"
                    popovertarget="@PanelId"
                    popovertargetaction="hide"
                    aria-label="@(CloseLabel ?? TextDefaults.CloseMenu)">
                <Icon Role="IconRole.Close" />
            </button>
        </div>
        <nav class="ib-header-nav-body" aria-label="@NavLabel">
            <ul class="ib-nav ib-nav-vertical">
                @ChildContent
            </ul>
        </nav>
        @if (PanelFooter is not null)
        {
            <div class="ib-header-nav-foot">@PanelFooter</div>
        }
    </div>
</ib-header-nav>

@code {
    /// <summary>The links: <see cref="NavItem"/>, plus <see cref="NavDivider"/> or <see cref="NavLabel"/>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Below this width the links fold into the menu button. Defaults to <see cref="Breakpoint.Md"/>.</summary>
    [Parameter] public Breakpoint Breakpoint { get; set; } = Breakpoint.Md;

    /// <summary>The navigation landmark's name for screen readers. Defaults to "Main".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>The menu button's name. Defaults to "Open menu".</summary>
    [Parameter] public string? MenuLabel { get; set; }

    /// <summary>The sheet's close button name. Defaults to "Close menu".</summary>
    [Parameter] public string? CloseLabel { get; set; }

    /// <summary>
    /// Puts the menu button at the end of the header on small screens, where people look for it,
    /// whatever comes after the links. Defaults to true; false leaves it where the links are.
    /// </summary>
    [Parameter] public bool MenuButtonAtEnd { get; set; } = true;

    /// <summary>Shown at the start of the sheet's top bar, beside the close button: the site's name or logo.</summary>
    [Parameter] public RenderFragment? PanelHeader { get; set; }

    /// <summary>Shown below the links in the sheet only: social links, a color scheme switch, a call to action.</summary>
    [Parameter] public RenderFragment? PanelFooter { get; set; }

    /// <summary>The sheet's id. Generated when not set.</summary>
    [Parameter] public string? Id { get; set; }

    private string NavLabel => Label ?? TextDefaults.MainNavigation;
    private string PanelId => Id ?? (_generatedId ??= IdGenerator.Next("ib-header-nav"));
    private string? _generatedId;
    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-header-nav");
        classes.Add($"ib-header-nav-bp-{Breakpoint.Name()}");
        classes.Add("ib-header-nav-end", MenuButtonAtEnd);
    }

    [CascadingParameter] private ShellHeaderLinks? ShellLinks { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        (_class, _style) = BuildRootAttributes();
        ShellLinks?.Set(ChildContent, Breakpoint);
    }

    /// <inheritdoc />
    public void Dispose() => ShellLinks?.Set(null, Breakpoint);
}
