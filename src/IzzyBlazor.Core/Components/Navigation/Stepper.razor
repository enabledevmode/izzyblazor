@namespace IzzyBlazor
@inherits LayoutItemBase
@attribute [ModeSupport]

@*
    Where someone is in a process, such as a checkout or a setup wizard: an ordered list of steps,
    those before Current marked done, Current marked with aria-current="step". Steps with an Href
    are links (to go back to a finished step, say). A row; on phones only the current step's text
    shows, beside a row of markers. No script.

    <Stepper Current="2">
        <Step Label="Account" Href="/signup/account" />
        <Step Label="Profile" Description="Name and photo" />
        <Step Label="Done" />
    </Stepper>

    Accessibility:
    - It renders an ordered list named "Progress" (`Label`); the current step has
      `aria-current="step"`.
    - The markers are hidden from screen readers; a finished step's check mark is heard as
      "(completed)" after its label (`CompletedLabel`).
    - A step with `Href` is a plain link; the others are text and don't take focus.
    - It doesn't move focus or announce anything when `Current` changes: a wizard moves focus
      itself, such as to the new step's heading.
    See also: Progress, Tabs, Timeline.
*@

<ol @attributes="AdditionalAttributes" class="@_class" style="@_style" aria-label="@(Label ?? TextDefaults.Progress)">
    @* Not fixed: steps have only simple parameters, so this is what re-renders them when Current
       changes on an interactive page. *@
    <CascadingValue Value="_context">
        @ChildContent
    </CascadingValue>
</ol>

@code {
    /// <summary>The <see cref="Step"/>s, in order.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The current step, counting from 1. Steps before it show as done. Past the last step, every
    /// step is done; 0 means none has started.
    /// </summary>
    [Parameter] public int Current { get; set; } = 1;

    /// <summary>
    /// A row (the default) or a column. On phones a row shows only the current step's label; the other
    /// steps are markers, and a finished step with an <see cref="Step.Href"/> is still a link on its marker.
    /// </summary>
    [Parameter] public Orientation Orientation { get; set; } = Orientation.Horizontal;

    /// <summary>The list's accessible name. Defaults to "Progress".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Read after a finished step's label, in place of its check mark. Defaults to "(completed)".</summary>
    [Parameter] public string? CompletedLabel { get; set; }

    internal string EffectiveCompletedLabel => CompletedLabel ?? TextDefaults.Completed;

    /// <summary>The marker and text size. Defaults to <see cref="ControlSize.Md"/>.</summary>
    [Parameter] public ControlSize Size { get; set; } = ControlSize.Md;

    private StepperContext _context = null!;
    private string? _class;
    private string? _style;

    /// <inheritdoc />
    protected override void OnInitialized() => _context = new StepperContext(this);

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add("ib-steps");
        classes.Add("ib-steps-horizontal", Orientation == Orientation.Horizontal);
        classes.Add("ib-steps-sm", Size == ControlSize.Sm);
        classes.Add("ib-steps-lg", Size == ControlSize.Lg);
        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet() => (_class, _style) = BuildRootAttributes();
}
