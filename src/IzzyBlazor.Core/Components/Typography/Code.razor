@namespace IzzyBlazor
@inherits LayoutItemBase
@using System.Net
@using Microsoft.AspNetCore.Components.RenderTree
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@attribute [ModeSupport(Off = ModeLevel.Partial, Notes = "With JavaScript off, code blocks have no copy button.")]

@*
    Code: inline (a <code> in running text) or a Block (<pre><code>) that scrolls sideways.
    A block's copy button needs script, so it only appears once <ib-code> is defined; with no
    script the code is still there to select and copy by hand.

    With a Language the highlighter knows (C#, Razor, HTML, CSS, JavaScript/TypeScript, JSON,
    shell), the code is colored on the server: spans with ib-tok-* classes, so it works with no
    script and never flashes plain first.

    LineNumbers and HighlightLines put each line in its own span (a <mark> when highlighted), with
    its newline inside, so copying still gives the code as written; the numbers are CSS counters,
    never selected or copied. A Title turns the floating bar into a header row.

    Accessibility:
    - Inline code is a `code`; a block is a `pre` holding a `code`.
    - A block is a tab stop, so a long line or a block with `MaxHeight` can be scrolled from the
      keyboard.
    - The copy button is named "Copy code" (`CopyLabel`); after copying, its name becomes "Copied"
      (`CopiedLabel`) for a moment, and it shows a check.
    - With JavaScript off there's no copy button; the code is still there to select.
    - Line numbers are CSS with empty alt text, so they're never copied and screen readers skip
      them where the browser supports it.
    See also: CodeExample, CopyButton, Kbd.
*@

@if (Block)
{
    <ib-code @attributes="AdditionalAttributes" class="@_class" style="@_style">
        @if (Title is not null)
        {
            <div class="ib-code-bar ib-code-head">
                <span class="ib-code-title" id="@TitleId">@Title</span>
                @CopyControl
            </div>
        }
        else if (Language is not null || Copyable)
        {
            <div class="ib-code-bar">
                @if (Language is not null)
                {
                    <span class="ib-code-language">@Language</span>
                }
                @CopyControl
            </div>
        }
        <pre class="ib-code-pre" tabindex="0" aria-labelledby="@(Title is null ? null : TitleId)"><code>@Content</code></pre>
    </ib-code>
}
else
{
    <code @attributes="AdditionalAttributes" class="@_class" style="@_style">@Content</code>
}

@code {
    private RenderFragment CopyControl => __builder =>
    {
        @if (Copyable)
        {
            <button type="button" class="ib-btn ib-btn-neutral ib-btn-ghost ib-btn-sm ib-btn-icon-only ib-code-copy" aria-label="@(CopyLabel ?? TextDefaults.CopyCode)" title="@(CopyLabel ?? TextDefaults.CopyCode)" data-copied-label="@(CopiedLabel ?? TextDefaults.Copied)">
                <Icon Role="IconRole.Copy" Class="ib-code-copy-icon" />
                <Icon Role="IconRole.Copied" Class="ib-code-copied-icon" />
            </button>
        }
    };

    /// <summary>The code. In a block, whitespace and line breaks are kept as written.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>A block of code on its own lines (<c>pre</c>), scrolling sideways when long.</summary>
    [Parameter] public bool Block { get; set; }

    /// <summary>
    /// The tallest a block gets before its code scrolls, such as <c>Length.Rem(20)</c> for a long
    /// file. The language label and copy button stay in place. Blocks only.
    /// </summary>
    [Parameter] public Length? MaxHeight { get; set; }

    /// <summary>
    /// The language, such as "razor", "csharp", "css" or "bash": shown above a block, and used to
    /// color the code when the highlighter knows it (see <see cref="IzzyCodeHighlighter.Languages"/>).
    /// </summary>
    [Parameter] public string? Language { get; set; }

    /// <summary>
    /// Colors the code by <see cref="Language"/>. Defaults to true. The code must be plain text
    /// (or a string expression); content with markup in it is shown as written.
    /// </summary>
    [Parameter] public bool Highlight { get; set; } = true;

    /// <summary>
    /// A file name or caption for a block, such as "Program.cs", shown in a header row above the
    /// code in place of <see cref="Language"/> (which still sets the colors).
    /// </summary>
    [Parameter] public string? Title { get; set; }

    // Names the scrolling block (a tab stop) after the title.
    private string? _titleId;

    private string TitleId => _titleId ??= IdGenerator.Next("ib-code-title");

    /// <summary>Numbers a block's lines. The numbers aren't selected or copied with the code.</summary>
    [Parameter] public bool LineNumbers { get; set; }

    /// <summary>
    /// Lines of a block to highlight, by number from 1: single lines and ranges, such as
    /// <c>"3-5,9"</c>. Highlighted lines are <c>mark</c> elements with a tinted background.
    /// </summary>
    [Parameter] public string? HighlightLines { get; set; }

    /// <summary>Adds a copy button to a block (with JavaScript). Defaults to true.</summary>
    [Parameter] public bool Copyable { get; set; } = true;

    /// <summary>The copy button's name. Defaults to "Copy code".</summary>
    [Parameter] public string? CopyLabel { get; set; }

    /// <summary>Announced after copying. Defaults to "Copied".</summary>
    [Parameter] public string? CopiedLabel { get; set; }

    private string? _class;
    private string? _style;
    private IReadOnlyList<CodeToken>? _tokens;
    private string? _source;
    private string? _sourceLanguage;

    private List<List<CodeToken>>? _lines;
    private HashSet<int>? _highlighted;

    private RenderFragment? Content => _lines is not null ? RenderLines : _tokens is null ? ChildContent : RenderTokens;

    /// <inheritdoc />
    protected override void BuildAttributes(ClassBuilder classes, StyleBuilder styles)
    {
        classes.Add(Block ? "ib-code-block" : "ib-code");
        if (Block && MaxHeight is { } maxHeight)
        {
            classes.Add("ib-code-sized");
            styles.AddVar("code-maxh", StyleValues.Length(maxHeight));
        }

        if (_lines is not null)
        {
            classes.Add("ib-code-lined");
            classes.Add("ib-code-numbered", LineNumbers);
            if (LineNumbers)
            {
                styles.AddVar("code-digits", _lines.Count.ToString(System.Globalization.CultureInfo.InvariantCulture).Length.ToString(System.Globalization.CultureInfo.InvariantCulture));
            }

            if (_highlighted is { Count: > 0 } highlighted)
            {
                classes.Add("ib-code-has-hl");
                styles.AddVar("code-hl-stops", HighlightStops(highlighted, _lines.Count, "var(--ib-code-hl)"));
                styles.AddVar("code-hl-bar-stops", HighlightStops(highlighted, _lines.Count, "var(--ib-code-hl-bar)"));
            }
        }

        base.BuildAttributes(classes, styles);
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _highlighted = HighlightLines is null ? null : ParseLines(HighlightLines);
        _tokens = null;
        _lines = null;
        var text = ChildContent is null ? null : ReadText(ChildContent);
        if (Highlight && Language is not null && text is not null)
        {
            // Re-highlight only when the code or language changes.
            if (text != _source || Language != _sourceLanguage || _lastTokens is null)
            {
                var highlighter = Services.GetService<ICodeHighlighter>() ?? IzzyCodeHighlighter.Instance;
                _source = text;
                _sourceLanguage = Language;
                _lastTokens = highlighter.TryHighlight(text, Language, out var tokens) ? tokens : null;
            }

            _tokens = _lastTokens;
        }

        if (Block && text is not null && (LineNumbers || _highlighted is not null))
        {
            _lines = SplitLines(_tokens ?? [new CodeToken(CodeTokenKind.Text, text)]);
        }

        (_class, _style) = BuildRootAttributes();
    }

    /// <summary>Splits tokens into lines at each newline; a newline at the very end adds no line.</summary>
    private static List<List<CodeToken>> SplitLines(IReadOnlyList<CodeToken> tokens)
    {
        var lines = new List<List<CodeToken>> { new() };
        foreach (var token in tokens)
        {
            var parts = token.Text.Split('\n');
            for (var i = 0; i < parts.Length; i++)
            {
                if (i > 0)
                {
                    lines.Add([]);
                }

                if (parts[i].Length > 0)
                {
                    lines[^1].Add(token with { Text = parts[i] });
                }
            }
        }

        if (lines.Count > 1 && lines[^1].Count == 0)
        {
            lines.RemoveAt(lines.Count - 1);
        }

        return lines;
    }

    /// <summary>
    /// Gradient stops that tint the highlighted lines, measured in lines (lh) from the top of the
    /// code: the lines themselves stay inline, so selecting and copying gives the code as written.
    /// </summary>
    private static string HighlightStops(HashSet<int> lines, int count, string color)
    {
        var stops = new List<string>();
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        for (var line = 1; line <= count; line++)
        {
            if (!lines.Contains(line) || lines.Contains(line - 1))
            {
                continue;
            }

            var end = line;
            while (end < count && lines.Contains(end + 1))
            {
                end++;
            }

            var from = string.Create(ic, $"calc(var(--ib-code-pad-top) + {line - 1}lh)");
            var to = string.Create(ic, $"calc(var(--ib-code-pad-top) + {end}lh)");
            stops.Add($"transparent {from}, {color} {from}, {color} {to}, transparent {to}");
        }

        return string.Join(", ", stops);
    }

    // Past any real block; also keeps a range from running away.
    private const int MaxLine = 100_000;

    /// <summary>"3-5, 9" becomes {3, 4, 5, 9}.</summary>
    private static HashSet<int> ParseLines(string spec)
    {
        var lines = new HashSet<int>();
        foreach (var part in spec.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var range = part.Split('-', StringSplitOptions.TrimEntries);
            if (range.Length is 1 or 2
                && int.TryParse(range[0], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var from)
                && int.TryParse(range[^1], System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var to)
                && from >= 1 && to >= from && to <= MaxLine)
            {
                for (var line = from; line <= to; line++)
                {
                    lines.Add(line);
                }

                continue;
            }

            throw new ArgumentException($"Code HighlightLines takes line numbers and ranges from 1 to {MaxLine}, such as \"3-5,9\" (got \"{spec}\").", nameof(HighlightLines));
        }

        return lines;
    }

    private void RenderLines(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
    {
        for (var i = 0; i < _lines!.Count; i++)
        {
            var highlighted = _highlighted?.Contains(i + 1) == true;
            builder.OpenElement(0, highlighted ? "mark" : "span");
            builder.AddAttribute(1, "class", highlighted ? "ib-code-line ib-code-line-hl" : "ib-code-line");
            foreach (var token in _lines[i])
            {
                RenderToken(builder, token);
            }

            if (i < _lines.Count - 1)
            {
                builder.AddContent(2, "\n");
            }

            builder.CloseElement();
        }
    }

    private IReadOnlyList<CodeToken>? _lastTokens;

    private void RenderTokens(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder)
    {
        foreach (var token in _tokens!)
        {
            RenderToken(builder, token);
        }
    }

    private static void RenderToken(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, CodeToken token)
    {
        if (token.Kind == CodeTokenKind.Text)
        {
            builder.AddContent(10, token.Text);
            return;
        }

        builder.OpenElement(11, "span");
        builder.AddAttribute(12, "class", ClassOf(token.Kind));
        builder.AddContent(13, token.Text);
        builder.CloseElement();
    }

    private static string ClassOf(CodeTokenKind kind) => kind switch
    {
        CodeTokenKind.Comment => "ib-tok-comment",
        CodeTokenKind.Keyword => "ib-tok-keyword",
        CodeTokenKind.String => "ib-tok-string",
        CodeTokenKind.Number => "ib-tok-number",
        CodeTokenKind.Type => "ib-tok-type",
        CodeTokenKind.Function => "ib-tok-function",
        CodeTokenKind.Tag => "ib-tok-tag",
        CodeTokenKind.Attribute => "ib-tok-attr",
        CodeTokenKind.Meta => "ib-tok-meta",
        _ => "ib-tok",
    };

    /// <summary>
    /// The code as plain text, when the content is only text: literal text, encoded text such as
    /// "&amp;lt;" (decoded), or string expressions. Null when it holds elements or components.
    /// </summary>
    private static string? ReadText(RenderFragment fragment)
    {
#pragma warning disable BL0006 // Reading render frames: the content is rendered here only to read its text.
        using var builder = new Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder();
        fragment(builder);
        var frames = builder.GetFrames();
        var text = new System.Text.StringBuilder();
        for (var i = 0; i < frames.Count; i++)
        {
            ref var frame = ref frames.Array[i];
            switch (frame.FrameType)
            {
                case RenderTreeFrameType.Text:
                    text.Append(frame.TextContent);
                    break;
                case RenderTreeFrameType.Markup when !frame.MarkupContent.Contains('<'):
                    text.Append(WebUtility.HtmlDecode(frame.MarkupContent));
                    break;
                default:
                    return null;
            }
        }
#pragma warning restore BL0006

        return text.ToString();
    }
}
