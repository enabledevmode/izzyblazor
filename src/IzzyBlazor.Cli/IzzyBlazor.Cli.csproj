<Project Sdk="Microsoft.NET.Sdk">

  <!-- The izzy CLI: a .NET tool over the generation engine, with the free catalog inside it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackageId>IzzyBlazor.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>izzy</ToolCommandName>
    <Title>IzzyBlazor CLI</Title>
    <Description>The izzy command: new IzzyBlazor apps, and blocks and pages added to the app you have, from IzzyBlazor's catalog. Every change can be shown first as a diff or as JSON.</Description>
    <PackageTags>blazor;cli;scaffolding;templates;blocks;izzyblazor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- The catalog's dotfiles (.mcp.json, .dockerignore) are templates too: pack them. -->
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <!-- Roslyn's messages in English only: the tool doesn't show them, and the rest are megabytes. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <!-- The components izzy knows (list, describe, add component): made by DocsGen at build time. -->
    <ComponentsFile>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)$(Configuration)/components.json</ComponentsFile>
    <DocsGenHost>$(DOTNET_HOST_PATH)</DocsGenHost>
    <DocsGenHost Condition="'$(DocsGenHost)' == ''">dotnet</DocsGenHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IzzyBlazor.Generation\IzzyBlazor.Generation.csproj" />
    <!-- izzy add crud reads the model from source: syntax trees only, no build or MSBuild. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <!-- izzy mcp: the commands as tools for a coding agent, over stdio. -->
    <PackageReference Include="ModelContextProtocol.Core" Version="2.2.0" />
    <InternalsVisibleTo Include="IzzyBlazor.Generation.Tests" />
    <!-- Built first and run by GenerateComponents below; not referenced as code. It builds the library, whose
         build runs npm: -p:IzzyComponents=false leaves the components out, for the release job that only
         bundles the catalog and must run nothing from npm. -->
    <ProjectReference Condition="'$(IzzyComponents)' != 'false'" Include="$(RepoRoot)site/IzzyBlazor.DocsGen/IzzyBlazor.DocsGen.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- izzy theme vars renders the app's IzzyTheme (its restored IzzyBlazor.Core) with ASP.NET Core's HtmlRenderer. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- The library izzy falls back to when the app's isn't restored: built, then copied beside the tool as
         library/IzzyBlazor.Core.dll (IncludeLibrary below), not referenced as code. Its build runs npm, so it's
         left out with the components. -->
    <ProjectReference Condition="'$(IzzyComponents)' != 'false'" Include="$(RepoRoot)src/IzzyBlazor.Core/IzzyBlazor.Core.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The skill izzy agent writes. -->
    <EmbeddedResource Include="Agent/SKILL.md" LogicalName="SKILL.md" />
    <!-- izzy audit's engine: axe-core, unmodified (MPL 2.0; see THIRD-PARTY-NOTICES.md). Replace the file to update it. -->
    <EmbeddedResource Include="Audit/axe.min.js" LogicalName="axe.min.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The free catalog, beside the tool's dll: catalog/<item-id>/izzy.json and files/. -->
    <None Include="$(RepoRoot)catalog/**/*" LinkBase="catalog" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- The components, beside the tool's dll and beside whatever references it (the tests). -->
    <None Condition="'$(IzzyComponents)' != 'false'" Include="$(ComponentsFile)" Link="components.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <!-- What each release removed or renamed (izzy update, izzy upgrade), beside the dll like the components. -->
    <None Include="$(RepoRoot)site/IzzyBlazor.Site/Api/changes.json" Link="changes.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(RepoRoot)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepoRoot)docs/nuget-readme-cli.md" Pack="true" PackagePath="\README.md" Visible="false" />
    <None Include="$(RepoRoot)brand/nuget/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- components.json, from the library's API, the docs site's registry and its examples. DocsGen rewrites
       it only when it changed. Not in design-time builds, where DocsGen may not be built. -->
  <Target Name="GenerateComponents" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' And '$(IzzyComponents)' != 'false'">
    <MSBuild Projects="$(RepoRoot)site/IzzyBlazor.DocsGen/IzzyBlazor.DocsGen.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="DocsGenAssembly" />
    </MSBuild>
    <Exec Command="&quot;$(DocsGenHost)&quot; &quot;@(DocsGenAssembly)&quot; --out &quot;$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)$(Configuration)/izzyblazor.api.json&quot; --source &quot;$(RepoRoot)src&quot; --cli-out &quot;$(ComponentsFile)&quot; --registry &quot;$(RepoRoot)site/IzzyBlazor.Site/components.json&quot; --examples &quot;$(RepoRoot)site/IzzyBlazor.Site/Examples&quot;" />
  </Target>

  <!-- The library's copy, beside the tool's dll and beside whatever references it (the tests). -->
  <Target Name="IncludeLibrary" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true' And '$(IzzyComponents)' != 'false'">
    <MSBuild Projects="$(RepoRoot)src/IzzyBlazor.Core/IzzyBlazor.Core.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="LibraryAssembly" />
    </MSBuild>
    <ItemGroup>
      <None Include="@(LibraryAssembly)" Link="library/IzzyBlazor.Core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- The catalog beside the built tool: cleared, then copied, so a removed item leaves the tool too. -->
  <Target Name="CopyCatalog" AfterTargets="Build">
    <ItemGroup>
      <CatalogFile Include="$(RepoRoot)catalog/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)catalog" ContinueOnError="true" />
    <Copy SourceFiles="@(CatalogFile)" DestinationFiles="@(CatalogFile->'$(OutDir)catalog/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
