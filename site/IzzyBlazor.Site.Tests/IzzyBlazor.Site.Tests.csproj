<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the docs site: the registry covers the library, every example has a file and renders
       in each mode it claims, Off frames carry no script, internal links resolve, and toolbars don't
       move when their script arrives (in a browser). -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- The Toolbar's width sweep runs in Chromium (ToolbarWidthTests). -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\IzzyBlazor.Site\IzzyBlazor.Site.csproj" />
  </ItemGroup>

  <!-- DocsGen's logic, compiled here against the model the site links (one copy of ApiFile). -->
  <ItemGroup>
    <Compile Include="..\IzzyBlazor.DocsGen\ReleaseComparer.cs" Link="DocsGen\ReleaseComparer.cs" />
    <Compile Include="..\IzzyBlazor.DocsGen\XmlDocs.cs" Link="DocsGen\XmlDocs.cs" />
    <Compile Include="..\IzzyBlazor.DocsGen\RazorHeaders.cs" Link="DocsGen\RazorHeaders.cs" />
    <Compile Include="..\IzzyBlazor.DocsGen\ApiReader.cs" Link="DocsGen\ApiReader.cs" />
    <Compile Include="..\IzzyBlazor.DocsGen\TypeNames.cs" Link="DocsGen\TypeNames.cs" />
  </ItemGroup>

</Project>
