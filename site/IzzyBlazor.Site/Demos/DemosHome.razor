@page "/demos"
@layout DemosLayout
@inject Registry Registry

<PageTitle>Demos · IzzyBlazor</PageTitle>
<HeadContent><meta name="description" content="IzzyBlazor demos: realistic scenarios as plain HTML, on a static SSR page with no circuit, and on an interactive page." /></HeadContent>

<article class="site-article site-article-wide">
    <Stack Gap="3" Class="site-pagehead">
        <Heading Level="1" Size="TextSize.Xl3">Demos</Heading>
        <TextBlock Size="TextSize.Lg" Color="Color.Muted">
            Realistic scenarios, each in all three modes with its source. Demos always show the latest release.
        </TextBlock>
    </Stack>
    @foreach (var category in Registry.Categories)
    {
        var components = Registry.InCategory(category).Where(c => c.Scenarios.Count > 0).ToList();
        if (components.Count == 0)
        {
            continue;
        }

        <Heading Level="2">@category</Heading>
        @* One grid per category, so its demos fill the row whichever component they're under. *@
        <Grid MinChildWidth="Length.Rem(16)" Gap="3">
            @foreach (var component in components)
            {
                @foreach (var scenario in component.Scenarios)
                {
                    @* Text only: a component's picture would repeat on each of its demos' cards. *@
                    <Card Title="@scenario.Title" Href="@Registry.ScenarioHref(component, scenario)" Description="@scenario.Description" Size="ControlSize.Sm">
                        <CardHeader><Badge Size="BadgeSize.Sm">@component.Name</Badge></CardHeader>
                    </Card>
                }
            }
        </Grid>
    }
</article>
