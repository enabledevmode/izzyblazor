@page "/demos/{Id}"
@layout DemosLayout
@inject Registry Registry
@inject NavigationManager Navigation

@if (_component is not null)
{
    <PageTitle>@_component.Name demos · IzzyBlazor</PageTitle>

    <article class="site-article site-article-wide">
        <Stack Gap="3" Class="site-pagehead">
            <Breadcrumb>
                <BreadcrumbItem Href="demos">Demos</BreadcrumbItem>
                <BreadcrumbItem>@_component.Category</BreadcrumbItem>
            </Breadcrumb>
            <Heading Level="1" Size="TextSize.Xl3">@_component.Name demos</Heading>
            <Row Gap="3" Wrap>
                <Button Href="@Registry.OverviewHref(_component)" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.BookOpen">Overview</Button>
                <Button Href="@Registry.ApiPageHref(_component)" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" StartIcon="Lucide.CodeXml">API</Button>
            </Row>
        </Stack>
        @if (_component.Scenarios.Count == 0)
        {
            <EmptyState Icon="Lucide.LayoutGrid" Title="No demos yet" Description="@($"{_component.Name}'s examples are on its Overview.")" Bordered>
                <EmptyStateActions><Button Href="@Registry.OverviewHref(_component)">Open the Overview</Button></EmptyStateActions>
            </EmptyState>
        }
        else
        {
            <Grid MinChildWidth="Length.Rem(16)" Gap="3">
                @foreach (var scenario in _component.Scenarios)
                {
                    <Card Title="@scenario.Title" Href="@Registry.ScenarioHref(_component, scenario)" Description="@scenario.Description" Size="ControlSize.Sm" />
                }
            </Grid>
        }
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private RegistryComponent? _component;

    protected override void OnParametersSet()
    {
        _component = Registry.ById(Id);
        if (_component is null)
        {
            Navigation.NotFound();
        }
    }
}
