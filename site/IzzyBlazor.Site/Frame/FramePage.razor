@page "/frame/{ExampleId}"
@layout FrameLayout
@inject ExampleCatalog Catalog
@inject Registry Registry
@inject NavigationManager Navigation

@*
    A demo scenario (components.json "page") on a bare page, for the example viewer's frame: a page
    of its own, sized by the window. No script and Static render it in static SSR (no script is the same page
    in a sandbox without script, and App leaves the script tags out); Interactive renders it in an
    interactive render mode from this static page. Other examples render in the docs page itself.
*@

<PageTitle>@_title</PageTitle>
<HeadContent><meta name="robots" content="noindex" /></HeadContent>

@if (_type is not null)
{
    <div class="@_class" data-mode="@_mode">
        @if (_mode == "interactive")
        {
            <ExampleHost ExampleId="@ExampleId" @rendermode="InteractiveServer" />
        }
        else
        {
            <DynamicComponent Type="_type" />
        }
    </div>
}

@code {
    [Parameter] public string ExampleId { get; set; } = "";

    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private Type? _type;
    private string _mode = "static";
    private string _class = "frame";
    private string _title = "";

    protected override void OnParametersSet()
    {
        _type = Catalog.TypeOf(ExampleId);
        var entry = Registry.Example(ExampleId);
        // Demos show in a frame (ExampleViewer); other examples render in the docs page, and here
        // only for what fetches its own example again, such as a live chart's RefreshFrom.
        if (_type is null || entry is null)
        {
            Navigation.NotFound();
            return;
        }

        _mode = Mode is "noscript" or "static" or "interactive" && entry.Value.Example.Modes.Contains(Mode) ? Mode : entry.Value.Example.StartMode;
        _class = entry.Value.Example.Page ? "frame frame-page" : "frame";
        _title = $"{entry.Value.Example.Title} ({ModeChip.Name(_mode)})";
    }
}
