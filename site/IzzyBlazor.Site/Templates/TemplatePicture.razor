@* A template's card picture, in the scheme the site is in. *@
<Image Src="@Template.Picture" DarkSrc="@Template.PictureDark" Alt="@Alt" Ratio="16 / 10.0" Fit="ImageFit.Cover" Class="site-block-picture" />

@code {
    [Parameter, EditorRequired] public Template Template { get; set; } = null!;

    [Parameter] public string Alt { get; set; } = "";
}
