@* A block's card picture in the scheme the site is in: both are on the page, and CSS shows the one
   that matches (an explicit choice on the root, else the system's). *@
<Image Src="@Block.Picture" Alt="@Alt" Ratio="16 / 10.0" Fit="ImageFit.Cover" Class="site-block-picture site-pic-light" />
<Image Src="@Block.PictureDark" Alt="@Alt" Ratio="16 / 10.0" Fit="ImageFit.Cover" Class="site-block-picture site-pic-dark" />

@code {
    [Parameter, EditorRequired] public Block Block { get; set; } = null!;

    [Parameter] public string Alt { get; set; } = "";
}
