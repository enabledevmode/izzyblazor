@* Generated from catalog/contact by BlockPreviewTests: don't edit. *@
@using System.ComponentModel.DataAnnotations
@inject ToastService Toasts
@inject NavigationManager Navigation

@* A way to start a conversation, from izzy add contact: three ways to reach you beside a form.
   It's yours: change the ways in @code, and send or store the message in Send. The form posts
   with no circuit, is checked on the server, and has a honeypot for bots. *@
<Section Spacing="SectionSpacing.Lg" aria-labelledby="Contact-title">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        <Grid Template="@(new Responsive<string> { Base = "1fr", Md = "5fr 6fr" })" Gap="new() { Base = 10, Md = 16 }" Align="Align.Start">
            <Column Gap="new() { Base = 8, Md = 10 }">
                <SectionHeader Title="Talk to us" TitleId="Contact-title" Description="Tell us what you need, and a person replies within one working day." Align="TextAlign.Start" />
                <Column As="ul" Gap="7">
                    @foreach (var way in Ways)
                    {
                        <Row As="li" Gap="4" Align="Align.Start">
                            <Center Width="Length.Rem(2.75)" Height="Length.Rem(2.75)" Bg="Color.PrimarySoft" Radius="Radius.Md" Shrink="false">
                                <Icon Name="way.Icon" Size="IconSize.Lg" Color="Color.PrimaryText" />
                            </Center>
                            <Column Gap="1">
                                <Heading Level="3" Size="TextSize.Lg">@way.Title</Heading>
                                <TextBlock Color="Color.Muted">@way.Text</TextBlock>
                                <TextBlock Weight="FontWeight.Medium"><Anchor Href="@way.Href" Underline="AnchorUnderline.Hover">@way.Link <Icon Name="Lucide.ArrowRight" /></Anchor></TextBlock>
                            </Column>
                        </Row>
                    }
                </Column>
            </Column>
            @* A bordered panel from 768px up; on phones the form sits in the page's column. *@
            <Box Border="new() { Base = 0, Md = 1 }" Radius="Radius.Lg" Padding="new() { Base = 0, Md = 8 }">
                <Form Model="Model" FormName="Contact-message" Honeypot OnValidSubmit="Send" OnSpam="Done" RequiredMark="RequiredMark.Optional">
                    <FormErrors />
                    <Grid Columns="new() { Base = 1, Sm = 2 }" Gap="4">
                        <TextField @bind-Value="Model!.Name" AutoComplete="name" />
                        <TextField @bind-Value="Model!.Email" Type="TextFieldType.Email" AutoComplete="email" />
                    </Grid>
                    <TextField @bind-Value="Model!.Company" AutoComplete="organization" />
                    <TextArea @bind-Value="Model!.Message" Rows="5" />
                    <Column Gap="3">
                        <Button Submit Size="ControlSize.Lg" AlignSelf="Align.Start">Send message</Button>
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">We use your details only to reply to you.</TextBlock>
                    </Column>
                </Form>
            </Box>
        </Grid>
    </Container>
</Section>

@code {
    // The ways to reach you: an icon, a name, one line on what it's for, and a link.
    private static readonly Way[] Ways =
    [
        new(Lucide.Mail, "Email us", "For questions about plans, billing or your account.", "hello@example.com", "mailto:hello@example.com"),
        new(Lucide.CalendarDays, "Book a demo", "Thirty minutes with someone who builds the product.", "Choose a time", "blocks/contact?way=demo"),
        new(Lucide.LifeBuoy, "Help center", "Guides and answers for every feature.", "Read the guides", "blocks/contact?way=help"),
    ];

    [SupplyParameterFromForm(FormName = "Contact-message")]
    private ContactMessage? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private void Send()
    {
        // Send or store the message here.
        Done();
    }

    // A person and a caught bot get the same answer: a toast after a redirect, so reloading
    // doesn't post again.
    private void Done()
    {
        Toasts.Success("We'll reply within one working day.", "Message sent");
        Navigation.NavigateTo(Navigation.Uri);
    }

    private sealed record Way(IconData Icon, string Title, string Text, string Link, string Href);

    public sealed class ContactMessage
    {
        [Required(ErrorMessage = "Enter your name."), StringLength(80)]
        public string? Name { get; set; }

        [Required(ErrorMessage = "Enter your work email."), EmailAddress(ErrorMessage = "Enter an email address, like name@example.com."), Display(Name = "Work email")]
        public string? Email { get; set; }

        [StringLength(80)]
        public string? Company { get; set; }

        [Required(ErrorMessage = "Tell us how we can help."), StringLength(2000), Display(Name = "How can we help?")]
        public string? Message { get; set; }
    }
}
