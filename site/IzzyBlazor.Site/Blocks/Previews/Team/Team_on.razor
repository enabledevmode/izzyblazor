@* Generated from catalog/team by BlockPreviewTests: don't edit. *@
@* The people behind the product, from izzy add team. It's yours: change the people in @code
   below. A photo goes in Photo (from wwwroot); without one, the initials show on a tint. *@
<Section Spacing="SectionSpacing.Lg" aria-labelledby="Team_on-title">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        <Column Gap="new() { Base = 10, Md = 12 }" Align="Align.Center">
            <SectionHeader Title="Meet the team" TitleId="Team_on-title" Description="A small team that answers its own support email." AlignSelf="Align.Stretch" />
            <Grid As="ul" Columns="new() { Base = 2, Md = 4 }" Gap="new() { Base = 8, Md = 10 }" AlignSelf="Align.Stretch">
                @foreach (var person in People)
                {
                    <Column As="li" Align="Align.Center">
                        <Avatar Name="@person.Name" Src="@person.Photo" Size="AvatarSize.Xl2" Decorative MarginBottom="3" />
                        <TextBlock Weight="FontWeight.Semibold" Align="TextAlign.Center">@person.Name</TextBlock>
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">@person.Role</TextBlock>
                    </Column>
                }
            </Grid>
            <TextBlock Weight="FontWeight.Medium" Align="TextAlign.Center"><Anchor Href="blocks/team" Underline="AnchorUnderline.Hover">We're hiring: see open roles <Icon Name="Lucide.ArrowRight" /></Anchor></TextBlock>
        </Column>
    </Container>
</Section>

@code {
    // Each person: name, role and an optional photo from wwwroot, such as "images/team/ana.jpg".
    private static readonly Person[] People =
    [
        new("Ana Souza", "Founder and CEO"),
        new("Kenji Watanabe", "Head of Engineering"),
        new("Priya Raman", "Head of Design"),
        new("Daniel Okafor", "Customer Success"),
        new("Lena Fischer", "Product Manager"),
        new("Mateo García", "Software Engineer"),
        new("Hannah Kim", "Software Engineer"),
        new("Omar Haddad", "Support Lead"),
    ];

    private sealed record Person(string Name, string Role, string? Photo = null);
}
