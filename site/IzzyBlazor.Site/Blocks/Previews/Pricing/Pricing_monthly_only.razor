@* Generated from catalog/pricing by BlockPreviewTests: don't edit. *@
@inject NavigationManager Navigation

@* Plans side by side, from izzy add pricing. It's yours: change the plans in @code below. The
   button sits under the price, so buttons line up whatever the lengths of the lists. *@
<Section Spacing="SectionSpacing.Lg" aria-labelledby="Pricing_monthly_only-title">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        <Column Gap="new() { Base = 8, Md = 10 }" Align="Align.Center">
            <SectionHeader Title="Plans that grow with your team" TitleId="Pricing_monthly_only-title" TitleLevel="2" Description="Start free. Upgrade when you need more people or single sign-on." AlignSelf="Align.Stretch" />
            <Grid Columns="new() { Base = 1, Md = 2, Lg = Tiers.Length }" Gap="5" AlignSelf="Align.Stretch">
                @foreach (var tier in Tiers)
                {
                    <Card Description="@tier.For" Size="ControlSize.Lg"
                          Border="@(tier.Popular ? 2 : default(Responsive<int>))" BorderColor="@(tier.Popular ? Color.Primary : default(Responsive<Color>))">
                        @* The badge shares the name's line, so the sentence under it runs the card's full width. *@
                        <CardHeader>
                            <Row Gap="3" Align="Align.Center" Justify="Justify.Between" Wrap>
                                <Heading Level="TierLevel" Size="TextSize.Xl">@tier.Name</Heading>
                                @if (tier.Popular)
                                {
                                    <Badge Accent="Accent.Primary">Most popular</Badge>
                                }
                            </Row>
                        </CardHeader>
                        <CardBody Gap="6">
                            <Column MarginTop="4">
                                <TextBlock>
                                    <TextBlock As="span" Size="TextSize.Xl4" Weight="FontWeight.Semibold" TabularNums>@Amount(tier)</TextBlock>
                                    @if (tier.Monthly == 0)
                                    {
                                        <TextBlock As="span" Color="Color.Muted"> forever</TextBlock>
                                    }
                                    else if (Period(tier) is { } period)
                                    {
                                        <TextBlock As="span" Color="Color.Muted" aria-hidden="true"> / @period</TextBlock>
                                        <VisuallyHidden> per @period</VisuallyHidden>
                                    }
                                </TextBlock>
                                @* Always there, empty or not, so prices and buttons line up across the plans. *@
                                <TextBlock Size="TextSize.Sm" Color="Color.Muted">@(tier.Note ?? " ")</TextBlock>
                            </Column>
                            @if (tier.Popular)
                            {
                                <Button Href="@tier.Href" FullWidth>@tier.Action</Button>
                            }
                            else
                            {
                                <Button Href="@tier.Href" FullWidth Variant="ButtonVariant.Outline" Accent="Accent.Neutral">@tier.Action</Button>
                            }
                            <Divider />
                            @if (tier.Includes is not null)
                            {
                                <TextBlock Weight="FontWeight.Medium">@tier.Includes</TextBlock>
                            }
                            <List Plain Icon="Lucide.Check" IconColor="Color.SuccessText" Gap="3">
                                @foreach (var feature in tier.Features)
                                {
                                    <ListItem>@feature</ListItem>
                                }
                            </List>
                        </CardBody>
                    </Card>
                }
            </Grid>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">
                @* The link in ink, not the accent: it isn't the section's focus. *@
                Prices in USD, before tax. Free trials last 14 days, no card needed.
                <TextBlock As="span" Color="Color.OnSurface"><Anchor Href="blocks/pricing" InheritColor>Compare all features</Anchor></TextBlock>
            </TextBlock>
        </Column>
    </Container>
</Section>

@code {
    // Each plan: name, who it's for, the price a month and a year (null for Custom; 0 is free),
    // a line under the price, the button, whether it's the one to pick, and what it includes.
    private static readonly Tier[] Tiers =
    [
        new("Free", "For trying MyApp on your own.", 0, 0, null, "Start free", "blocks/pricing?plan-link=sign-up", false,
            null, ["One person", "Three projects", "Community help"]),
        new("Team", "For small teams shipping together.", 29, 290, "per person", "Start a free trial", "blocks/pricing?plan-link=sign-up?plan=team", true,
            "Everything in Free, plus:", ["Up to 25 people", "Unlimited projects", "Roles and permissions", "Help by email in one working day"]),
        new("Business", "For companies with more to manage.", 79, 790, "per person", "Talk to sales", "blocks/pricing?plan-link=contact", false,
            "Everything in Team, plus:", ["Single sign-on", "Audit log", "Data kept in the EU or US", "A named contact for help"]),
    ];

    private const int TierLevel = 2 + 1;

    [SupplyParameterFromQuery(Name = "billing")]
    private string? Billing { get; set; }

    private bool _yearly;

    protected override void OnParametersSet() => _yearly = Billing == "yearly";

    private string BillingHref(string billing) => Navigation.GetUriWithQueryParameter("billing", billing);

    // A free plan doesn't change with the period; yearly shows what's charged for the year.
    private string Amount(Tier tier) => tier.Monthly switch
    {
        null => "Custom",
        0 => "$0",
        _ => $"${(_yearly ? tier.Yearly : tier.Monthly):N0}",
    };

    private string? Period(Tier tier) => tier.Monthly is null or 0 ? null : _yearly ? "year" : "month";

    private sealed record Tier(string Name, string For, decimal? Monthly, decimal? Yearly, string? Note, string Action, string Href,
        bool Popular, string? Includes, string[] Features);
}
