@* Generated from catalog/footer by BlockPreviewTests: don't edit. *@
@* The end of every page, from izzy add block footer. It's yours: change the links below. It belongs
   to the layout: put <Footer_off /> in MainLayout, after the page's body, so every page gets it. *@
<Section Spacing="SectionSpacing.None" PaddingY="new() { Base = 6, Md = 4 }" BorderTop="1">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        <Stack Direction="new() { Base = Direction.Column, Md = Direction.Row }" Gap="new() { Base = 3, Md = 6 }" Align="new() { Base = Align.Start, Md = Align.Center }">
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">© @DateTime.UtcNow.Year MyApp, Inc.</TextBlock>
            <Spacer />
            <nav aria-label="Footer">
                <Row As="ul" Wrap Gap="new() { Base = 4, Md = 5 }">
                    @foreach (var (text, href) in Links)
                    {
                        <li><TextBlock Size="TextSize.Sm" Color="Color.Muted"><Anchor Href="@href" InheritColor Underline="AnchorUnderline.Hover">@text</Anchor></TextBlock></li>
                    }
                </Row>
            </nav>
        </Stack>
    </Container>
</Section>

@code {
    // The links at the end: text and address.
    private static readonly (string Text, string Href)[] Links =
    [
        ("Privacy", "#privacy"),
        ("Terms", "#terms"),
        ("Cookie settings", "#cookies"),
        ("Contact", "#contact"),
    ];
}
