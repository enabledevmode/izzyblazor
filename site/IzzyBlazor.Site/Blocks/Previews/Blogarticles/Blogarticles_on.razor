@* Generated from catalog/articles by BlockPreviewTests: don't edit. *@
@* The latest posts, from izzy add block articles. It's yours: change the posts in @code below, or load
   them from your blog. A post without a Cover shows a placeholder drawn in its Tint. *@
<Section Spacing="SectionSpacing.Lg" aria-labelledby="Blogarticles_on-title">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        <Column Gap="new() { Base = 10, Md = 12 }">
            <Stack Direction="new() { Base = Direction.Column, Md = Direction.Row }" Gap="4" Align="new() { Base = Align.Start, Md = Align.End }" Justify="Justify.Between">
                <SectionHeader Title="From the blog" TitleId="Blogarticles_on-title" Description="Guides, product news and how we build MyApp." Align="TextAlign.Start" />
                <TextBlock Weight="FontWeight.Medium"><Anchor Href="#" Underline="AnchorUnderline.Hover">All posts <Icon Name="Lucide.ArrowRight" /></Anchor></TextBlock>
            </Stack>
            <Grid As="ul" Columns="new() { Base = 1, Md = 3 }" Gap="new() { Base = 10, Md = 8 }">
                @foreach (var (post, i) in Posts.Select((p, i) => (p, i)))
                {
                    <Column As="li" Gap="2">
                        @* The cover repeats the title's link, so it's skipped by screen readers and the Tab key. *@
                        <Box As="a" href="@post.Href" aria-hidden="true" tabindex="-1" MarginBottom="3">
                            @if (post.Cover is not null)
                            {
                                <Image Src="@post.Cover" Alt="" Ratio="1.6" Fit="ImageFit.Cover" Radius="Radius.Lg" />
                            }
                            else
                            {
                                @* A placeholder in the page's own colors, so it follows light and dark: a circle
                                   and a card on a tint, arranged differently for each post. *@
                                var (cx, cy) = Circles[i % Circles.Length];
                                <AspectRatio Ratio="1.6" Radius="Radius.Lg" Overflow="Overflow.Hidden" Bg="@Color.Token(post.Tint + "-soft")">
                                    <svg viewBox="0 0 160 100" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
                                        <circle cx="@cx" cy="@cy" r="30" style="@($"fill: color-mix(in oklab, var(--ib-color-{post.Tint}) 40%, var(--ib-color-{post.Tint}-soft))")" />
                                        <rect x="102" y="44" width="40" height="40" rx="4" style="fill: var(--ib-color-surface); opacity: 0.7" />
                                    </svg>
                                </AspectRatio>
                            }
                        </Box>
                        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium" Color="Color.PrimaryText">@post.Category</TextBlock>
                        <Heading Level="3" Size="TextSize.Xl"><Anchor Href="@post.Href" InheritColor Underline="AnchorUnderline.Hover">@post.Title</Anchor></Heading>
                        <TextBlock Color="Color.Muted" LineClamp="2" MarginTop="1">@post.Excerpt</TextBlock>
                        <Spacer />
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted" MarginTop="3">
                            @post.Author · <time datetime="@post.Date.ToString("yyyy-MM-dd")">@post.Date.ToString("MMM d, yyyy")</time> · @post.Minutes min read
                        </TextBlock>
                    </Column>
                }
            </Grid>
        </Column>
    </Container>
</Section>

@code {
    // Each post: where it lives, its category, title, a sentence or two, who wrote it, when, how
    // long it takes to read, the placeholder's tint (primary, success, warning, info or danger),
    // and a cover image from wwwroot to show instead.
    private static readonly Post[] Posts =
    [
        new("#blog/static-pages-live-feel", "Engineering", "Static pages, live feel: how we built MyApp",
            "Most of MyApp renders on the server. Here's how a small script makes it feel instant anyway.",
            "Jonas Weber", new DateOnly(2026, 11, 10), 6, "primary"),
        new("#blog/shorter-planning-meetings", "Guides", "Five ways to run a shorter planning meeting",
            "Agendas, owners and a hard stop: the habits our customers swear by.",
            "Sara Costa", new DateOnly(2026, 11, 3), 4, "success"),
        new("#blog/whats-new-in-november", "Product", "What's new in November",
            "Invoices, a faster dashboard and a dozen smaller fixes.",
            "Fatima Ali", new DateOnly(2026, 11, 1), 3, "warning"),
    ];

    // Where each placeholder's circle sits, post by post.
    private static readonly (int X, int Y)[] Circles = [(44, 50), (86, 20), (48, 82)];

    private sealed record Post(string Href, string Category, string Title, string Excerpt, string Author, DateOnly Date, int Minutes, string Tint, string? Cover = null);
}
