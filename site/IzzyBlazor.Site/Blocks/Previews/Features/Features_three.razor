@* Generated from catalog/features by BlockPreviewTests: don't edit. *@
@* What the product does, from izzy add block features. It's yours: change the intro and the features
   in @code below. Three to nine read well; each is an icon, a title and one sentence. *@
<Section Spacing="SectionSpacing.Lg" aria-labelledby="Features_three-title">
    <Container Size="ContainerSize.Lg" Align="ContainerAlign.Center" Gutters="false">
        @* The intro is centered over the grid from 768px up; on phones it starts at the edge, like the features. *@
        <Column Gap="new() { Base = 10, Md = 12 }" Align="new() { Base = Align.Start, Md = Align.Center }">
            <SectionHeader Title="Everything your team needs to ship" TitleId="Features_three-title" Description="Plan, track and release in one place, without the busywork." Align="new() { Base = TextAlign.Start, Md = TextAlign.Center }" AlignSelf="Align.Stretch" />
            <Grid As="ul" Columns="new() { Base = 1, Md = 2, Lg = 3 }" Gap="10" AlignSelf="Align.Stretch">
                @foreach (var feature in Items)
                {
                    <Column As="li" Gap="2" Align="Align.Start">
                        <Center Width="Length.Rem(2.5)" Height="Length.Rem(2.5)" Bg="Color.PrimarySoft" Radius="Radius.Md">
                            <Icon Name="feature.Icon" Size="IconSize.Lg" Color="Color.PrimaryText" />
                        </Center>
                        <Heading Level="3" Size="TextSize.Lg">@feature.Title</Heading>
                        <TextBlock Color="Color.Muted" Wrap="TextWrap.Pretty">@feature.Text</TextBlock>
                    </Column>
                }
            </Grid>
        </Column>
    </Container>
</Section>

@code {
    // Each feature: an icon (any Lucide icon), a title and one sentence.
    private static readonly Feature[] Items =
    [
        new(Lucide.Calendar, "Plans that stay current", "Roadmaps update as work moves, so nobody chases status."),
        new(Lucide.Zap, "Fast by default", "Pages render on the server and load in a blink."),
        new(Lucide.Plug, "Works with your tools", "Connect GitHub, Slack and your calendar in minutes."),
        new(Lucide.Shield, "Private by design", "Roles and single sign-on keep the right people in."),
        new(Lucide.ChartColumn, "Reports without spreadsheets", "See progress by team, project or week."),
        new(Lucide.LifeBuoy, "Help when you need it", "Real people answer, usually within the hour."),
    ];

    private sealed record Feature(IconData Icon, string Title, string Text);
}
