@page "/docs/components/{Id}"
@attribute [FollowsModeSwitch]
@inject Registry Registry
@inject ApiMetadata Api
@inject NavigationManager Navigation

@*
    A component's Overview: a hand-written one where there is one (Docs/Overviews/{Name}Overview),
    else one generated from the doc comment and components.json (Parts/GeneratedOverview). The mode
    switch shows where there are previews.
*@

@if (_component is not null)
{
    @* The doc comment's first sentence (OverviewText.Sentence): Google shows about 155 characters. *@
    <PageMeta Title="@($"{_component.Name} · IzzyBlazor")" Description="@(OverviewText.Sentence(ApiMetadata.PlainText(_api?.Summary)) ?? _component.Summary)" />

    <article class="site-article">
        <ComponentHeader Component="_component" ApiComponent="_api" />

        @if (_api is not null)
        {
            @if (FollowsSwitch(_component))
            {
                @* In the right column from 1024px, at the top of the content below that. Only with
                   examples of its own (FollowsModeSwitchAttribute.PageMode): demos have their own
                   switch. An example of a whole page (AppShell's) is a frame in the picked mode. *@
                <SectionContent SectionName="@ModeSwitch.AsideSection"><ModeSwitch Placement="aside" /></SectionContent>
                <ModeSwitch Placement="top" />
            }
            @if (_overview is not null)
            {
                <DynamicComponent Type="_overview" Parameters="_parameters" />
            }
            else
            {
                <GeneratedOverview Component="_component" ApiComponent="_api" Context="_context" />
            }
        }

        <PrevNext PreviousHref="@(_previous is null ? null : Registry.OverviewHref(_previous))" PreviousTitle="@_previous?.Name"
                  NextHref="@(_next is null ? null : Registry.OverviewHref(_next))" NextTitle="@_next?.Name" />
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private RegistryComponent? _component;
    private ApiComponent? _api;
    private ApiPageContext _context = null!;
    private Type? _overview;
    private Dictionary<string, object?> _parameters = [];
    private RegistryComponent? _previous;
    private RegistryComponent? _next;

    /// <summary>
    /// Whether the page has previews, so it shows and follows the mode switch: examples of its own,
    /// or demos that its hand-written Overview shows (SiteNav's, in frames).
    /// </summary>
    public static bool FollowsSwitch(RegistryComponent component) =>
        component.Examples.Count > 0
        || (component.Scenarios.Count > 0 && OverviewType(component) is not null);

    private static Type? OverviewType(RegistryComponent component) =>
        typeof(ComponentPage).Assembly.GetType($"IzzyBlazor.Site.Docs.Overviews.{component.Name}Overview");

    protected override void OnParametersSet()
    {
        _component = Registry.ById(Id);
        if (_component is null)
        {
            Navigation.NotFound();
            return;
        }

        _api = Api.Component(_component.Name);
        var page = Registry.ApiPageHref(_component);
        _context = _api is null ? new ApiPageContext(page, _component.Name, new HashSet<string>(), new HashSet<string>()) : ApiMetadata.ContextFor(page, _api);
        _overview = OverviewType(_component);
        _parameters = new()
        {
            ["Component"] = _component,
            ["ApiComponent"] = _api,
            ["Context"] = _context,
        };
        (_previous, _next) = Registry.Around(_component);
    }
}
