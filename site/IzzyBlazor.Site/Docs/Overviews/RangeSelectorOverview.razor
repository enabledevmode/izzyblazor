<Heading Level="2">Parameters</Heading>
<ParameterTable ApiComponent="ApiComponent" ApiHref="@Registry.ApiPageHref(Component)" Context="Context" Compact />

<OverviewSeeAlso Component="Component" ApiComponent="ApiComponent" />

@code {
    [Parameter, EditorRequired] public RegistryComponent Component { get; set; } = null!;

    [Parameter, EditorRequired] public ApiComponent ApiComponent { get; set; } = null!;

    [Parameter, EditorRequired] public ApiPageContext Context { get; set; } = null!;

    // RangeSelector is a .cs component, whose doc comment can't carry keys (see RazorHeaders).
    private static readonly ApiKeyboardGroup HandleKeys = new("On a handle",
    [
        new(["Right", "Up"], "Move the handle one item later"),
        new(["Left", "Down"], "Move the handle one item earlier"),
        new(["Page Up", "Page Down"], "Move the handle a tenth of the range later or earlier"),
        new(["Home", "End"], "Move the handle to the first or last item, as far as the other handle allows"),
    ]);

    private const string Usage = """
        @* In a chart: a strip under the plot that zooms it. *@
        <Chart Items="days" Argument="d => d.Date" Title="Daily visits">
            <ChartLineSeries Value="d => d.Visits" />
            <RangeSelector />
        </Chart>

        @* On its own: range is the ChartView chosen. *@
        <RangeSelector Items="days" Argument="d => d.Date" Label="Dates" @bind-View="range">
            <ChartAreaSeries Value="d => d.Visits" />
        </RangeSelector>
        """;

    private const string Presets = """
        <RangeSelector Presets="quarters" />

        @code {
            private readonly DateRangePreset[] quarters =
            [
                new("Q1 FY26", new(2025, 7, 1), new(2025, 9, 30)),
                new("Q2 FY26", new(2025, 10, 1), new(2025, 12, 31)),
                new("Q3 FY26", new(2026, 1, 1), new(2026, 3, 31)),
            ];
        }
        """;
}
