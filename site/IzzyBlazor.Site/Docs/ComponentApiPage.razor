@page "/docs/components/{Id}/api"
@page "/docs/components/{Id}/{Topic}/api"
@inject Registry Registry
@inject ApiMetadata Api
@inject NavigationManager Navigation

@*
    One generic page for every component's API, built from the metadata alone: properties,
    events, methods, the parts documented with it, and the types they use. The filter is a GET
    form (FilterForm), so it works with JavaScript off and applies as you type with it.
    A topic's (components.json "members") is the same page with only the members it's about.
*@

@if (_component is not null && _api is not null)
{
    <PageMeta Title="@PageTitle" Description="@($"Parameters, events, methods and types of the IzzyBlazor {_component.Name} component.")" Indexed="!_component.Preview" />

    <article class="site-article">
        <ComponentHeader Component="_component" ApiComponent="_api" Topic="_topic" />

        @if (_topic is not null)
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                The members for @_topic.Title.ToLowerInvariant(), and the types they use. Every member of
                <Code>IzzyBlazor.@_api.DisplayName</Code> is on the <Anchor Href="@Registry.ApiPageHref(_component)">@_component.Name API</Anchor>.
            </TextBlock>
        }
        else
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                <Code>IzzyBlazor.@_api.DisplayName</Code> in the @_api.Package package, generated from the @Api.Version assembly
                and its doc comments.
            </TextBlock>
        }

        <FilterForm Label="Filter members">
            <FilterSearch Placeholder="Filter members" Label="Filter members" />
            @if (_topic is null)
            {
                <FilterCheckbox Name="inherited" Label="Show inherited" />
            }
        </FilterForm>

        @if (_properties.Count > 0 || _topic is null)
        {
            <Heading Level="2" id="properties">Properties (@_properties.Count)</Heading>
            <ApiMemberList Members="_properties" Context="_context" ShowDeclaredOn EmptyText="@NoMatch" />
        }
        @if (_topic is not null)
        {
            @* No inherited members: none is about a topic. *@
        }
        else if (Inherited)
        {
            @foreach (var (title, members, name) in _inherited)
            {
                <Heading Level="3" id="@($"inherited-{ApiMetadata.Anchor(name)}")">@title</Heading>
                <ApiMemberList Members="members" Context="_context" EmptyText="@NoMatch" />
            }
        }
        else
        {
            <InheritedLine ApiComponent="_api">
                @if (_api.Bases.Count > 0)
                {
                    <Button Href="@ShowInheritedHref" Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral">Show them here</Button>
                }
            </InheritedLine>
        }

        @if (_events.Count > 0 || (Query is null && _topic is null))
        {
            <Heading Level="2" id="events">Events (@_events.Count)</Heading>
            <ApiMemberList Members="_events" Context="_context" ShowDeclaredOn EmptyText="@(Query is null ? "No events." : NoMatch)" />
        }

        @if (_methods.Count > 0)
        {
            <Heading Level="2" id="methods">Methods (@_methods.Count)</Heading>
            <ApiMemberList Members="_methods" Context="_context" IsMethod />
        }

        @if (_parts.Count > 0)
        {
            <Heading Level="2" id="parts">Parts (@_parts.Count)</Heading>
            <TextBlock Color="Color.Muted">@PartsLine</TextBlock>
            @foreach (var (part, members) in _parts)
            {
                var anchor = ApiMetadata.Anchor(part.Name);
                <div class="site-part" id="@anchor">
                    <Heading Level="3" Outline="false" Anchor="false">
                        <code>@part.DisplayName</code>
                    </Heading>
                    <DocHtml Html="@part.Summary" Context="_context" />
                    <ApiMemberList Members="members" Context="_context" AnchorPrefix="@($"{anchor}-")" ShowDeclaredOn EmptyText="@(Query is null ? "No parameters of its own." : NoMatch)" />
                    @if (part.Bases.Count > 0)
                    {
                        <InheritedLine ApiComponent="part" />
                    }
                </div>
            }
        }

        @if (_types.Count > 0)
        {
            <Heading Level="2" id="types">Types (@_types.Count)</Heading>
            @foreach (var type in _types)
            {
                <div class="site-type-block" id="@($"type-{ApiMetadata.Anchor(type.Name)}")">
                    <Row Gap="2" Align="Align.Center">
                        <Heading Level="3" Outline="false" Anchor="false"><code>@type.Name</code></Heading>
                        <Badge Variant="BadgeVariant.Outline" Size="BadgeSize.Sm">@type.Kind</Badge>
                    </Row>
                    <DocHtml Html="@type.Summary" Context="_context" />
                    @if (type.Members.Any(m => m.Obsolete is null))
                    {
                        <Table Items="type.Members.Where(m => m.Obsolete is null).ToList()" Caption="@($"{type.Name} {(type.Kind == "enum" ? "values" : "members")}")" Size="ControlSize.Sm">
                            <TemplateColumn Title="@(type.Kind == "enum" ? "Value" : "Member")" Width="Length.Rem(14)">
                                <code>@TypeMember(type, context!)</code>
                            </TemplateColumn>
                            <TemplateColumn Title="Description"><DocHtml Html="@context!.Summary" Context="_context" /></TemplateColumn>
                        </Table>
                    }
                </div>
            }
        }

        @if (_topic is null)
        {
        <PrevNext PreviousHref="@(_previous is null ? null : Registry.ApiPageHref(_previous))" PreviousTitle="@(_previous is null ? null : $"{_previous.Name} API")"
                  NextHref="@(_next is null ? null : Registry.ApiPageHref(_next))" NextTitle="@(_next is null ? null : $"{_next.Name} API")" />
        }
    </article>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    [Parameter] public string? Topic { get; set; }

    private RegistryTopic? _topic;

    private string PageTitle => _topic is null ? $"{_component!.Name} API · IzzyBlazor" : $"{_topic.Title} API · {_component!.Name} · IzzyBlazor";

    private string PartsLine => _topic is null
        ? $"Components written inside {_component!.Name}, documented here with it."
        : $"Components written inside {_component!.Name}, and the columns' members, which PropertyColumn, TemplateColumn and DynamicColumn share.";

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "inherited")] public bool Inherited { get; set; }

    private RegistryComponent? _component;
    private ApiComponent? _api;
    private ApiPageContext _context = null!;
    private List<ApiMember> _properties = [];
    private List<ApiMember> _events = [];
    private List<ApiMember> _methods = [];
    private List<(string Title, List<ApiMember> Members, string Name)> _inherited = [];
    private List<(ApiComponent Part, List<ApiMember> Members)> _parts = [];
    private List<ApiType> _types = [];
    private RegistryComponent? _previous;
    private RegistryComponent? _next;

    // A type's member as code: a method's signature, a preset's name (Accent.Primary is an Accent),
    // or an instance property as a declaration (Page int, Accent Accent = Accent.Primary).
    private static string TypeMember(ApiType type, ApiMember member)
    {
        if (member.Type.Contains($" {member.Name}(", StringComparison.Ordinal) || member.Type.Contains($" {member.Name}<", StringComparison.Ordinal))
        {
            return member.Type[(member.Type.IndexOf(' ') + 1)..];
        }

        if (type.Kind == "enum" || member.Type == type.Name)
        {
            return member.Name;
        }

        return member.Default is { } value and not "computed" ? $"{member.Name} {member.Type} = {value}" : $"{member.Name} {member.Type}";
    }

    private string? NoMatch => Query is null ? null : $"Nothing matches \"{Query}\".";

    private string ShowInheritedHref => Navigation.GetUriWithQueryParameter("inherited", true);

    protected override void OnParametersSet()
    {
        _component = Registry.ById(Id);
        _api = _component is null ? null : Api.Component(_component.Name);
        _topic = Topic is null ? null : _component?.Topics.FirstOrDefault(t => t.Id == Topic && t.Members.Count > 0);
        if (_component is null || _api is null || (Topic is not null && _topic is null))
        {
            Navigation.NotFound();
            return;
        }

        var parts = _component.Parts.Select(Api.Component).OfType<ApiComponent>().ToList();
        var typeNames = _api.Types.Concat(parts.SelectMany(p => p.Types)).Distinct().ToList();
        _context = ApiMetadata.ContextFor(Registry.ApiPageHref(_component), _api, typeNames);

        _properties = Filter(_api.Properties.Where(p => p.Obsolete is null));
        _events = Filter(_api.Events.Where(e => e.Obsolete is null));
        _methods = Filter(_api.Methods.Where(m => m.Obsolete is null));
        _inherited = SharedProps.Sections
            .Where(s => _api.Bases.Contains(s.Base))
            .Select(s => (Title: $"{s.Title} (from {s.Base})", Members: Filter((Api.Base(s.Base)?.Properties ?? []).Where(p => p.Obsolete is null)), Name: s.Base))
            .ToList();
        _parts = parts.Select(p => (p, Filter(p.Properties.Concat(p.Events).Where(m => m.Obsolete is null)))).ToList();
        _types = typeNames.Select(Api.Type).OfType<ApiType>().OrderBy(t => t.Name, StringComparer.Ordinal).ToList();
        (_previous, _next) = Registry.Around(_component);
        if (_topic is not null)
        {
            ForTopic(_topic, parts);
        }
    }

    // Only the topic's members, and the types those use.
    private void ForTopic(RegistryTopic topic, List<ApiComponent> parts)
    {
        var own = topic.Members.Where(m => !m.Contains('.') && !_component!.Parts.Contains(m)).ToHashSet();
        _properties = _properties.Where(m => own.Contains(m.Name)).ToList();
        _events = _events.Where(m => own.Contains(m.Name)).ToList();
        _methods = _methods.Where(m => own.Contains(m.Name)).ToList();

        // Whole parts, a part's members, and the columns' (on PropertyColumn, which TemplateColumn and
        // DynamicColumn share). A component named whole that isn't a part, such as Table's DynamicColumn
        // on DataGrid's Columns topic, comes in too.
        var column = Api.Component("PropertyColumn");
        var named = topic.Members.Where(m => !m.Contains('.') && !_component!.Parts.Contains(m)).Select(Api.Component).OfType<ApiComponent>();
        var owners = (column is null ? parts : [.. parts, column]).Concat(named).Distinct().ToList();
        _parts = owners
            .Select(p =>
            {
                var prefix = p == column ? "Column." : p.Name + ".";
                var all = Filter(p.Properties.Concat(p.Events).Where(m => m.Obsolete is null));
                return (Part: p, Members: topic.Members.Contains(p.Name) ? all : all.Where(m => topic.Members.Contains(prefix + m.Name)).ToList());
            })
            .Where(p => p.Members.Count > 0 || topic.Members.Contains(p.Part.Name))
            .ToList();

        var used = _properties.Concat(_events).Concat(_methods).Concat(_parts.SelectMany(p => p.Members)).Select(m => m.Type).ToList();
        var known = _types.Concat((column?.Types ?? []).Select(Api.Type).OfType<ApiType>()).DistinctBy(t => t.Name);
        _types = known
            .Where(t => topic.Members.Contains(t.Name) || used.Any(u => System.Text.RegularExpressions.Regex.IsMatch(u, $@"\b{System.Text.RegularExpressions.Regex.Escape(t.Name)}\b")))
            .OrderBy(t => t.Name, StringComparer.Ordinal)
            .ToList();

        // Its members' own links are to this page.
        _context = ApiMetadata.ContextFor(Registry.TopicApiHref(_component!, topic), _api!, _types.Select(t => t.Name))
            with { Listed = _properties.Concat(_events).Concat(_methods).Select(m => m.Name).ToHashSet() };
    }

    private List<ApiMember> Filter(IEnumerable<ApiMember> members) =>
        string.IsNullOrWhiteSpace(Query)
            ? members.ToList()
            : members.Where(m => m.Name.Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
}
