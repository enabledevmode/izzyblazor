    private static readonly DragAlternative[] Drags =
    [
        new("DataGrid: move or resize a column", "The column menu's Move left, Move right, Width and Fit to content items"),
        new("DataGrid: reorder rows", "The row handle's menu: Move up, Move down, Move to top, Move to bottom"),
        new("DataGrid: group by a column", "The column menu's Group by this column"),
        new("DataGrid: change the order of grouping levels", "Click a level's chip to open its menu: Move left, Move right"),
        new("DataGrid: choose and order columns", "The column picker's checkboxes and each row's handle menu"),
        new("ListView and DropZoneGroup: move an item", "The handle's or the item's menu, including Move to another zone"),
        new("PickList: move items across, or reorder the chosen ones", "The move buttons between the lists, a double-click, or the Move up and Move down buttons"),
        new("TreeList: move a row under another", "Click the row's handle or its Move action to open a dialog, then choose the new parent"),
        new("TileLayout: move or resize a tile", "The tile handle's menu: Move left, Move right, Move up, Move down, Wider, Narrower, Taller and Shorter"),
        new("Scheduler: move or resize an appointment", "Click it and change its times in the form"),
        new("Splitter: resize a pane", "Click the bar to open its menu: Wider, Narrower, Reset size and Collapse"),
        new("Chart: zoom and pan", "The Zoom in, Zoom out and Reset zoom buttons, next to the title or as ChartZoom and ChartResetZoom in a tile or card, or a ChartRangeSelector's preset ranges"),
        new("Carousel: swipe", "The previous and next buttons and the dots"),
        new("Slider, RangeSlider, ColorPanel", "Click where you want the value"),
