            <ListItem><Anchor Href="docs/components/table">Table</Anchor>: sorting, filters, paging by cursor and Load more, with state in the URL.</ListItem>
            <ListItem><Anchor Href="docs/common/render-modes">Render modes</Anchor>: why the Table keeps its state in the URL.</ListItem>
        </List>
    </ChildContent>
</ArticlePage>

@code {
    private const string Result = """
        new DataResult<Order>(rows, total)                 // numbered pages
        new DataResult<Order>(rows) { Next = cursor }      // by cursor, no total needed
        """;

    private const string FromDatabase = """
        <Table TItem="Order" ItemsProvider="LoadOrders" PageSize="20">...</Table>

        @code {
            async ValueTask<DataResult<Order>> LoadOrders(DataRequest<Order> request)
            {
                var query = db.Orders.AsNoTracking().Where(o => o.ShopId == shopId);
                return await request.ToResultAsync(query,
                    count: (q, ct) => q.CountAsync(ct),
                    list: (q, ct) => q.ToListAsync(ct));
            }
        }
        """;

    private const string InCode = """
        Filter.Where("status", FilterOperator.Equals, "Paid")
        Filter.Between("total", 100, 500)                    // either end may be null
        Filter.In("status", ["Paid", "Pending"])
        Filter.All(                                          // and; Filter.Any is or
            Filter.Where("placed", FilterOperator.OnDay, DateOnly.FromDateTime(DateTime.Today)),
            Filter.Not(Filter.Where("customer", FilterOperator.StartsWith, "test")))
        new FieldFilter("sku", FilterOperator.Equals, "AB-1", MatchCase: true)
        """;

    private const string Bound = """
        <Table Items="orders" @bind-Filter="filter">...</Table>

        @code {
            Filter? filter = Filter.Any(
                Filter.Where("status", FilterOperator.Equals, "Failed"),
                Filter.Where("total", FilterOperator.GreaterThan, 1000));   // a tag, not a panel
        }
        """;

    private const string Find = """
        var who = request.Filter?.Find("who")?.Value as string;   // the Who column's text, or null
        var (items, next) = await api.ListEventsAsync(request.Cursor, request.Take ?? 50, who);
        return new DataResult<AuditEvent>(items) { Next = next };
        """;

    private const string Declared = """
        IReadOnlyList<DataField<Order>> fields =
        [
            new() { Key = "customer", Value = (Expression<Func<Order, string>>)(o => o.Customer.Name),
                    Sortable = true, Filterable = true, Searchable = true },
            new() { Key = "total", Value = (Expression<Func<Order, decimal>>)(o => o.Total),
                    Sortable = true, Filterable = true,
                    Operators = [FilterOperator.GreaterThanOrEqual,
                                 FilterOperator.LessThanOrEqual, FilterOperator.Between] },
        ];
        """;

    private const string Custom = """
        <PropertyColumn Property="o => o.Tags" Filterable Filter="TagFilter" />

        @code {
            // Tags are stored lower case, as "red;green": "Green" in the filter finds it.
            static Expression<Func<Order, bool>>? TagFilter(FieldFilter f) =>
                f.Operator == FilterOperator.Contains && f.Value is string tag
                    ? o => (";" + o.Tags + ";").Contains(";" + tag.ToLower() + ";")
                    : null;
        }
        """;
}
