    private const string GridMud = """
        <MudDataGrid T="Server" ServerData="LoadAsync"
                     RowsPerPage="25" Filterable="true">
            <Columns>
                <PropertyColumn Property="s => s.Name" />
                <PropertyColumn Property="s => s.CreatedAt"
                                Title="Created" Format="d" />
                <TemplateColumn Title="Status"
                                SortBy="s => s.Online">
                    <CellTemplate>
                        @(context.Item.Online ? "Online" : "Offline")
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <PagerContent>
                <MudDataGridPager T="Server" />
            </PagerContent>
        </MudDataGrid>

        @code {
            private async Task<GridData<Server>> LoadAsync(
                GridState<Server> state, CancellationToken token)
            {
                var query = Db.Servers.AsNoTracking();
                // Apply state.SortDefinitions and
                // state.FilterDefinitions here, by hand.
                var total = await query.CountAsync(token);
                var items = await query
                    .Skip(state.Page * state.PageSize)
                    .Take(state.PageSize).ToListAsync(token);
                return new GridData<Server>
                    { Items = items, TotalItems = total };
            }
        }
        """;

