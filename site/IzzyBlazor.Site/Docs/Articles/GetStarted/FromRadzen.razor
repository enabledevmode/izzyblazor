    private const string DiffBefore = """
        @if (LineDiff.Compare(older, newer)
            is not { } lines)
        {
          <p>The texts differ by too many lines.</p>
        }
        else if (lines.All(l => l.Kind == DiffKind.Same))
        {
          <p>The two texts are the same.</p>
        }
        else
        {
          <div class="rb-diff">
            @foreach (var hunk in LineDiff.Hunks(lines))
            {
              <div class="rb-diff-gap">⋯</div>
              @foreach (var line in hunk)
              {
                <div class="@LineClass(line.Kind)">
                  <span>@line.Old</span>
                  <span>@line.New</span>
                  <span>@Mark(line.Kind)</span>
                  <code>@line.Text</code>
                </div>
              }
            }
          </div>
        }
        """;

