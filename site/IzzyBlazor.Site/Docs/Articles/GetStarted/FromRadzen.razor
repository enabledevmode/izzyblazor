    private const string BunitRadzen = """
        Services.AddRadzenComponents();
        Services.AddScoped<DialogService,
            RecordingDialogs>();

        var dialog = Render<KeyDialog>(
            p => p.Add(d => d.View, view));
        dialog.Find("#key-name").Input("Primary");
        await dialog.Find("#key-create")
            .ClickAsync(new());

        Assert.IsType<ApiKey>(
            Assert.Single(Dialogs.Closed));

        // Records what the dialog closed with.
        class RecordingDialogs(
            NavigationManager navigation, IJSRuntime js)
            : DialogService(navigation, js)
        {
            public List<object?> Closed { get; } = [];
            public override void Close(
                dynamic? result = null) =>
                Closed.Add(result);
        }
        """;

    private const string BunitIzzy = """
        Services.AddIzzyBlazorCore();
        SetRendererInfo(new RendererInfo("Server",
            isInteractive: true));
        var dialogs =
            Services.GetRequiredService<DialogService>();

        var host = Render<DialogHost>();
        Task<DialogResult> closed = null!;
        await host.InvokeAsync(() =>
        {
            closed = dialogs.OpenAsync<KeyDialog>(
                "Create a key",
                new() { ["View"] = view });
        });
        host.WaitForAssertion(() =>
            host.Find("#key-name"));
        host.Find("#key-name").Change("Primary");
        await host.Find("#key-create")
            .ClickAsync(new());

        var result = await closed;
        Assert.IsType<ApiKey>(result.Data);
        """;

