    private const string CursorBefore = """
        <table class="rb-table" id="decisions">
          @foreach (var decision in _decisions)
          {
            ...
          }
        </table>
        @if (_next is not null)
        {
          <RadzenButton id="load-earlier"
            Text="Load earlier"
            Click="LoadEarlierAsync"
            Disabled="_loading" ... />
        }
        @if (_failure is not null)
        {
          <p role="alert">@_failure</p>
        }

        @code {
          private readonly List<DecisionSummary>
            _decisions = [];
          private string? _next;

          private async Task LoadEarlierAsync()
          {
            _loading = true;
            var page = await Api.SearchAsync(
              _query, _next);
            if (page.Failed)
            {
              _failure = "The log couldn't load.";
            }
            else
            {
              _decisions.AddRange(page.Items);
              _next = page.Next;
            }
            _loading = false;
          }
        }
        """;

    private const string CursorIzzy = """
        <Table @ref="_log" ItemsProvider="LoadAsync"
          PageSize="50"
          Paging="TablePaging.LoadMore"
          LoadMoreText="Load earlier"
          ItemKey="d => d.Id" Caption="Decisions"
          id="decisions">
          <TemplateColumn Title="When"
            Context="decision">
            @ConsoleText.Instant(decision.At)
          </TemplateColumn>
          ...
        </Table>

        @code {
          private Table<DecisionSummary>? _log;

          // A failure throws: the table shows it,
          // with Retry.
          private async
            ValueTask<DataResult<DecisionSummary>>
            LoadAsync(DataRequest<DecisionSummary> r)
          {
            var page = await Api.SearchAsync(
              _query, r.Cursor);
            if (page.Failed)
            {
              throw new HttpRequestException(
                "The log couldn't load.");
            }
            return new(page.Items)
            {
              Next = page.Next,
            };
          }

          // A new search starts over.
          private Task SearchAsync() =>
            _log!.ReloadAsync();
        }
        """;

