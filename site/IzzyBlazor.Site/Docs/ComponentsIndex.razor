@page "/docs/components"
@inject Registry Registry
@inject ApiMetadata Api

@* Every component by category: a row per category, its icon at the start and its components'
   links after it, so the library fits on a few screens and a name can be found by eye. A filter
   at the top (a GET form, ?q=) narrows the links as you type, with JavaScript off too. *@

<PageMeta Title="Components · IzzyBlazor" Description="Every IzzyBlazor component, by category. Each one renders on static pages, and a label marks the ones limited in a render mode." />

<article class="site-article site-article-wide">
    <Stack Gap="3" Class="site-pagehead">
        <Heading Level="1" Size="TextSize.Xl3">Components</Heading>
        <TextBlock Size="TextSize.Lg" Color="Color.Muted">
            IzzyBlazor has @Registry.AllComponents.Count components in @Registry.Categories.Count groups. Every one renders on
            <Anchor Href="docs/common/render-modes">static pages</Anchor>. A label marks a component that works only on
            interactive pages, or only partly in one render mode.
        </TextBlock>
    </Stack>

    <FilterForm Label="Filter the components">
        <FilterSearch Label="Filter the components" Placeholder="Filter by name or purpose" Grow />
    </FilterForm>
    <p role="status" class="site-search-count">@CountText</p>

    @if (_groups.Count == 0)
    {
        <EmptyState Icon="Lucide.SearchX" Title="@($"No components match “{_query}”")" TitleLevel="2"
                    Description="Try a shorter word, or search the whole docs." Bordered>
            <EmptyStateActions>
                <Button Href="@($"search?q={Uri.EscapeDataString(_query)}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Search the docs</Button>
            </EmptyStateActions>
        </EmptyState>
    }

    <div class="site-index">
        @foreach (var (category, components) in _groups)
        {
            <section class="site-index-row" aria-labelledby="@Anchor(category)">
                <Pictogram Name="@Registry.CategoryIcon(category)" Size="ControlSize.Lg" />
                <div class="site-index-body">
                    <h2 class="site-index-heading" id="@Anchor(category)">@category <span class="site-index-count">@components.Count</span></h2>
                    <ul class="site-index-list">
                        @foreach (var component in components)
                        {
                            var api = Api.Component(component.Name);
                            <li>
                                <a href="@Registry.OverviewHref(component)" title="@component.Summary">@component.DisplayName</a>
                                @if (component.Preview)
                                {
                                    <Badge Size="BadgeSize.Sm" Variant="BadgeVariant.Outline">Preview</Badge>
                                }
                                @if (api?.Modes is { } modes)
                                {
                                    <ModeChips Modes="modes" Compact />
                                }
                            </li>
                        }
                    </ul>
                </div>
            </section>
        }
    </div>
</article>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private List<(string Category, List<RegistryComponent> Components)> _groups = [];
    private string _query = "";
    private int _shown;

    // The breadcrumb links to docs/components#forms; "Date & time" is date-time.
    private static string Anchor(string category) => Registry.CategoryAnchor(category);

    private string CountText => _query.Length == 0 ? "" : $"{_shown} {(_shown == 1 ? "component matches" : "components match")} “{_query}”";

    protected override void OnParametersSet()
    {
        _query = Q?.Trim() ?? "";
        _groups = Registry.Categories
            .Select(c => (Category: c, Components: Registry.AllComponents.Where(x => x.Category == c && Matches(x)).ToList()))
            .Where(g => g.Components.Count > 0)
            .ToList();
        _shown = _groups.Sum(g => g.Components.Count);
    }

    // A name, title, summary or keyword containing the filter's text.
    private bool Matches(RegistryComponent component) =>
        _query.Length == 0
        || component.DisplayName.Contains(_query, StringComparison.OrdinalIgnoreCase)
        || component.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)
        || component.Summary.Contains(_query, StringComparison.OrdinalIgnoreCase)
        || component.Keywords.Any(k => k.Contains(_query, StringComparison.OrdinalIgnoreCase));
}
