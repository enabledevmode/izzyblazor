@page "/docs/components"
@inject Registry Registry
@inject ApiMetadata Api

@* Every component by category, from the registry, as one dense list to find a name by eye. The only
   list with the previews, each marked. *@

<PageMeta Title="Components · IzzyBlazor" Description="Every IzzyBlazor component, by category. Each one renders on static pages, and a label marks the ones limited in a render mode." />

<article class="site-article site-article-wide">
    <Stack Gap="3" Class="site-pagehead">
        <Heading Level="1" Size="TextSize.Xl3">Components</Heading>
        <TextBlock Size="TextSize.Lg" Color="Color.Muted">
            IzzyBlazor has @Registry.AllComponents.Count components in @Registry.Categories.Count groups. Every one renders on
            <Anchor Href="docs/common/render-modes">static pages</Anchor>. A label marks a component that works only on
            interactive pages, or only partly in one render mode.
        </TextBlock>
    </Stack>

    @* Categories flow down columns as one list, so the whole library fits on a screen or two and
       a name can be found by eye; each link's title is the component's one-line summary. *@
    <div class="site-index">
        @foreach (var (category, components) in _groups)
        {
            <section class="site-index-group" aria-labelledby="@Anchor(category)">
                <h2 class="site-index-heading" id="@Anchor(category)">@category</h2>
                <ul class="site-index-list">
                    @foreach (var component in components)
                    {
                        var api = Api.Component(component.Name);
                        <li>
                            <a href="@Registry.OverviewHref(component)" title="@component.Summary">@component.DisplayName</a>
                            @if (component.Preview)
                            {
                                <Badge Size="BadgeSize.Sm" Variant="BadgeVariant.Outline">Preview</Badge>
                            }
                            @if (api?.Modes is { } modes)
                            {
                                <ModeChips Modes="modes" Compact />
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</article>

@code {
    private List<(string Category, List<RegistryComponent> Components)> _groups = [];

    // The breadcrumb links to docs/components#forms; "Date & time" is date-time.
    private static string Anchor(string category) => Registry.CategoryAnchor(category);

    protected override void OnInitialized() =>
        _groups = Registry.Categories
            .Select(c => (Category: c, Components: Registry.AllComponents.Where(x => x.Category == c).ToList()))
            .Where(g => g.Components.Count > 0)
            .ToList();
}
