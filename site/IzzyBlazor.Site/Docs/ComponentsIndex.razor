@page "/docs/components"
@inject Registry Registry
@inject ApiMetadata Api

@* Every component as a card, A to Z (after Chakra's overview): its picture, its name and its
   one-line summary; the sidebar keeps the groups. A filter at the top (a GET form, ?q=) narrows
   the cards, with JavaScript off too, and ?group= shows one group, for the breadcrumb. *@

<PageMeta Title="Components · IzzyBlazor" Description="Every IzzyBlazor component, A to Z. Each one renders on static pages, and a label marks the ones limited in a render mode." />

<article class="site-article site-article-wide">
    <Stack Gap="3" Class="site-pagehead">
        <Heading Level="1" Size="TextSize.Xl3">@(_group ?? "Components")</Heading>
        <TextBlock Size="TextSize.Lg" Color="Color.Muted">
            @if (_group is null)
            {
                @($"IzzyBlazor has {Registry.AllComponents.Count} components. Every one renders on ")
            }
            else
            {
                @($"{Registry.InCategory(_group).Count()} of IzzyBlazor's {Registry.AllComponents.Count} components. ")<Anchor Href="docs/components">See them all</Anchor>@(". Every one renders on ")
            }
            <Anchor Href="docs/common/render-modes">static pages</Anchor>. A label marks a component that works only on
            interactive pages, or only partly in one render mode.
        </TextBlock>
    </Stack>

    <FilterForm Label="Filter the components">
        @if (_group is not null)
        {
            <input type="hidden" name="group" value="@Group" />
        }
        <FilterSearch Label="Filter the components" Placeholder="Filter by name or purpose" Grow />
    </FilterForm>
    <p role="status" class="site-search-count">@CountText</p>

    @if (_cards.Count == 0)
    {
        <EmptyState Icon="Lucide.SearchX" Title="@($"No components match “{_query}”")" TitleLevel="2"
                    Description="Try a shorter word, or search the whole docs." Bordered>
            <EmptyStateActions>
                <Button Href="@($"search?q={Uri.EscapeDataString(_query)}")" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Search the docs</Button>
            </EmptyStateActions>
        </EmptyState>
    }
    else
    {
        <Grid MinChildWidth="Length.Rem(15)" Gap="5" Class="site-cards">
            @foreach (var component in _cards)
            {
                var api = Api.Component(component.Name);
                <Card Title="@component.DisplayName" TitleLevel="2" Description="@component.Summary" Href="@Registry.OverviewHref(component)">
                    <CardMedia><ComponentPicture Id="@component.Id" /></CardMedia>
                    @if (component.Preview || ModeChips.LabelOf(api?.Modes) is not null)
                    {
                        <div class="site-card-marks">
                            @if (component.Preview)
                            {
                                <Badge Size="BadgeSize.Sm" Variant="BadgeVariant.Outline">Preview</Badge>
                            }
                            <ModeChips Modes="api?.Modes" />
                        </div>
                    }
                </Card>
            }
        </Grid>
    }
</article>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    /// <summary>A group's anchor, such as <c>date-time</c>: the breadcrumb's link to a component's group.</summary>
    [SupplyParameterFromQuery(Name = "group")] public string? Group { get; set; }

    private List<RegistryComponent> _cards = [];
    private string _query = "";
    private string? _group;

    private string CountText => _query.Length == 0 ? "" : $"{_cards.Count} {(_cards.Count == 1 ? "component matches" : "components match")} “{_query}”";

    protected override void OnParametersSet()
    {
        _query = Q?.Trim() ?? "";
        _group = Registry.Categories.FirstOrDefault(c => Registry.CategoryAnchor(c) == Group);
        _cards = Registry.AllComponents
            .Where(c => (_group is null || c.Category == _group) && Matches(c))
            .OrderBy(c => c.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    // A name, title, summary or keyword containing the filter's text.
    private bool Matches(RegistryComponent component) =>
        _query.Length == 0
        || component.DisplayName.Contains(_query, StringComparison.OrdinalIgnoreCase)
        || component.Name.Contains(_query, StringComparison.OrdinalIgnoreCase)
        || component.Summary.Contains(_query, StringComparison.OrdinalIgnoreCase)
        || component.Keywords.Any(k => k.Contains(_query, StringComparison.OrdinalIgnoreCase));
}
