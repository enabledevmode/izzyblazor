@page "/docs/components"
@inject Registry Registry
@inject ApiMetadata Api

@* Every component by category, from the registry, as one dense list to find a name by eye. *@

<PageMeta Title="Components · IzzyBlazor" Description="Every IzzyBlazor component by category: what works as plain HTML, on static SSR pages with no circuit, and on interactive pages." />

<article class="site-article site-article-wide">
    <Stack Gap="3" Class="site-pagehead">
        <Heading Level="1" Size="TextSize.Xl3">Components</Heading>
        <TextBlock Size="TextSize.Lg" Color="Color.Muted">
            @Registry.Components.Count components in @Registry.Categories.Count groups. Every one renders in static SSR;
            a label says so where one needs JavaScript or an interactive page.
        </TextBlock>
    </Stack>

    @* Categories flow down columns as one list, so the whole library fits on a screen or two and
       a name can be found by eye; each link's title is the component's one-line summary. *@
    <div class="site-index">
        @foreach (var (category, components) in _groups)
        {
            <section class="site-index-group" aria-labelledby="@Anchor(category)">
                <h2 class="site-index-heading" id="@Anchor(category)">@category</h2>
                <ul class="site-index-list">
                    @foreach (var component in components)
                    {
                        var api = Api.Component(component.Name);
                        <li>
                            <a href="@Registry.OverviewHref(component)" title="@component.Summary">@component.Name</a>
                            @if (api?.Modes is { } modes)
                            {
                                <ModeChips Modes="modes" Compact />
                            }
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
</article>

@code {
    private List<(string Category, List<RegistryComponent> Components)> _groups = [];

    // The breadcrumb links to docs/components#forms; "App shell" is app-shell.
    private static string Anchor(string category) => category.ToLowerInvariant().Replace(' ', '-');

    protected override void OnInitialized() =>
        _groups = Registry.Categories
            .Select(c => (Category: c, Components: Registry.InCategory(c).ToList()))
            .Where(g => g.Components.Count > 0)
            .ToList();
}
