@using Microsoft.AspNetCore.WebUtilities
@inject Registry Registry
@inject NavigationManager Navigation

@* The docs sidebar, one of two by the header's area (as ng-zorro's): on the articles, every
   article under its section's heading, except a section that keeps growing, which is one link to
   its index; on docs/components/..., every component under its
   category's heading. All of it shows, so a page is found without opening anything; a component
   with topics is a group of its own, open on its pages. *@

<NavMenu>
    @if (_area == DocsArea.Components)
    {
        <NavItem Href="docs/components" Icon="Lucide.LayoutGrid" Match="NavLinkMatch.All" Current="@(_group is null ? null : false)">All components</NavItem>
        @foreach (var category in Registry.Categories)
        {
            @* Each heading links to the components page showing its group alone. *@
            var anchor = Registry.CategoryAnchor(category);
            <NavLabel Icon="@Pictogram.Lookup(Registry.CategoryIcon(category))" Href="@($"docs/components?group={anchor}")" Current="@(_group == anchor)">@category</NavLabel>
            @* A preview isn't listed, but on its own pages it needs its topics. *@
            @foreach (var component in Registry.InCategory(category).Concat(_current is { Preview: true } && _current.Category == category ? [_current] : []))
            {
                @if (component.Topics.Count > 0)
                {
                    <NavGroup Label="@component.DisplayName" Open="@(component == _current)">
                        <NavItem Href="@Registry.OverviewHref(component)" Match="NavLinkMatch.All">Overview</NavItem>
                        @foreach (var topic in component.Topics)
                        {
                            <NavItem Href="@Registry.TopicHref(component, topic)">@topic.Title</NavItem>
                        }
                    </NavGroup>
                }
                else
                {
                    <NavItem Href="@Registry.OverviewHref(component)">@component.DisplayName</NavItem>
                }
            }
            @* Planned, not built yet: shown, not a link. *@
            @foreach (var planned in Registry.Roadmap.Where(r => r.Category == category))
            {
                <NavItem Disabled Badge="Roadmap">@planned.Name</NavItem>
            }
        }
    }
    else
    {
        <NavItem Href="docs" Icon="Lucide.BookOpen" Match="NavLinkMatch.All">Overview</NavItem>
        @* A section that keeps growing (Troubleshooting) is one link to its index, current on its articles too. *@
        @foreach (var group in Articles.Sections.Where(g => g.IndexOnly))
        {
            <NavItem Href="@group.Href" Icon="@Pictogram.Lookup(group.Icon)">@group.Title</NavItem>
        }
        @foreach (var group in Articles.Sections.Where(g => !g.IndexOnly))
        {
            <NavLabel>@group.Title</NavLabel>
            @foreach (var article in group.Articles)
            {
                <NavItem Href="@group.HrefOf(article)">@article.Title</NavItem>
            }
        }

    }
</NavMenu>

@code {
    private RegistryComponent? _current;
    private DocsArea _area;

    // On docs/components, the group it shows (?group=), whose heading is current.
    private string? _group;

    /// <summary>Which sidebar a docs page has: the components' under docs/components, else the articles'.</summary>
    public static DocsArea AreaOf(NavigationManager navigation) =>
        Parts(navigation) is ["docs", "components", ..] ? DocsArea.Components : Parts(navigation) is ["docs", ..] ? DocsArea.Articles : DocsArea.None;

    private static string[] Parts(NavigationManager navigation) =>
        navigation.ToBaseRelativePath(navigation.Uri).Split('?', '#')[0].Split('/');

    protected override void OnParametersSet()
    {
        // docs/components/{id}[/api, /{topic}]
        _area = AreaOf(Navigation);
        _current = Parts(Navigation) is ["docs", "components", var id, ..] ? Registry.ById(id) : null;
        _group = Parts(Navigation) is ["docs", "components"]
            && QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue("group", out var group)
            && Registry.Categories.Any(c => Registry.CategoryAnchor(c) == group.ToString())
                ? group.ToString()
                : null;
    }
}
