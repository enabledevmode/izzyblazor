@using Microsoft.AspNetCore.WebUtilities
@inject Registry Registry
@inject BlockCatalog Blocks
@inject TemplateCatalog Templates
@inject NavigationManager Navigation

@* The docs sidebar, one of two by the header's area (as ng-zorro's): on the articles, every
   article under its section's heading, except a section that keeps growing, which is one link to
   its index; on docs/components/..., every component under its
   category's heading. All of it shows, so a page is found without opening anything; a component
   with topics is a group of its own, open on its pages. *@

@if (_area == DocsArea.Components)
{
    @* "All components" and, beside it, the list's order: by group, or every component A to Z. The
       button's icon is the order the list is in now, and its name is the order it switches to. The
       link is a list of its own, so the button sits next to it and not inside it. *@
    <Row Gap="1" Align="Align.Center">
        <NavMenu Grow MinWidth="Length.Px(0)">
            <NavItem Href="docs/components" Match="NavLinkMatch.All" Current="@(_group is null ? null : false)">All components</NavItem>
        </NavMenu>
        <form method="post" action="docs/components/order" data-enhance>
            <input type="hidden" name="return" value="@_here" />
            <IconButton Submit Name="az" Value="@(_az ? "false" : "true")" Label="@(_az ? "List by group" : "List A to Z")" Icon="@(_az ? Lucide.ArrowDownAZ : Lucide.ListTree)" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" />
        </form>
    </Row>
    <NavMenu>
        @if (_az)
        {
            @foreach (var entry in AtoZ)
            {
                @if (entry.Component is { } component)
                {
                    @ComponentItem(component)
                }
                else
                {
                    <NavItem Disabled Badge="Roadmap">@entry.Name</NavItem>
                }
            }
        }
        else
        {
            @foreach (var category in Registry.Categories)
            {
                @* Each heading links to the components page showing its group alone. *@
                var anchor = Registry.CategoryAnchor(category);
                <NavLabel Icon="@Pictogram.Lookup(Registry.CategoryIcon(category))" Href="@($"docs/components?group={anchor}")" Current="@(_group == anchor)">@category</NavLabel>
                @* A preview isn't listed, but on its own pages it needs its topics. *@
                @foreach (var component in Registry.InCategory(category).Concat(_current is { Preview: true } && _current.Category == category ? [_current] : []))
                {
                    @ComponentItem(component)
                }
                @* Planned, not built yet: shown, not a link. *@
                @foreach (var planned in Registry.Roadmap.Where(r => r.Category == category))
                {
                    <NavItem Disabled Badge="Roadmap">@planned.Name</NavItem>
                }
            }
        }
    </NavMenu>
}
else
{
<NavMenu>
    @if (_area == DocsArea.Blocks)
    {
        @* Every block under its category's heading; the free ones say so, in small text, not a chip. *@
        <NavItem Href="blocks" Match="NavLinkMatch.All">Overview</NavItem>
        @foreach (var category in Blocks.Categories)
        {
            <NavLabel>@category</NavLabel>
            @foreach (var block in Blocks.InCategory(category))
            {
                <NavItem Href="@block.Href">
                    @block.Name
                    @if (!block.Free)
                    {
                        <Badge Size="BadgeSize.Sm" Accent="Accent.Neutral" Variant="BadgeVariant.Solid" Pill Class="site-nav-pro">Pro</Badge>
                    }
                </NavItem>
            }
        }
    }
    else if (_area == DocsArea.Templates)
    {
        @* Every starter and kit under its group's heading, as the blocks are. *@
        <NavItem Href="templates" Match="NavLinkMatch.All">Overview</NavItem>
        @foreach (var group in Templates.Groups)
        {
            <NavLabel>@group</NavLabel>
            @foreach (var template in Templates.InGroup(group))
            {
                <NavItem Href="@template.Href">
                    @template.Name
                    @if (!template.Free)
                    {
                        <Badge Size="BadgeSize.Sm" Accent="Accent.Neutral" Variant="BadgeVariant.Solid" Pill Class="site-nav-pro">Pro</Badge>
                    }
                    else if (!template.Account)
                    {
                        <Badge Size="BadgeSize.Sm" Accent="Accent.Neutral" Variant="BadgeVariant.Soft" Pill Class="site-nav-pro">No account</Badge>
                    }
                </NavItem>
            }
        }
    }
    else
    {
        <NavItem Href="docs" Icon="Lucide.BookOpen" Match="NavLinkMatch.All">Overview</NavItem>
        @* A section that keeps growing (Troubleshooting) is one link to its index, current on its articles too. *@
        @foreach (var group in Articles.Sections.Where(g => g.IndexOnly))
        {
            <NavItem Href="@group.Href" Icon="@Pictogram.Lookup(group.Icon)">@group.Title</NavItem>
        }
        @foreach (var group in Articles.Sections.Where(g => !g.IndexOnly))
        {
            <NavLabel>@group.Title</NavLabel>
            @* Articles with an Area (the audit's pages) are one group under its name, open on its pages. *@
            @foreach (var article in group.Articles.Where(a => a.Area is null || a == group.Articles.First(b => b.Area == a.Area)))
            {
                @if (article.Area is { } area)
                {
                    var inArea = group.Articles.Where(a => a.Area == area).ToList();
                    <NavGroup Label="@area" Open="@inArea.Any(a => _path == group.HrefOf(a))">
                        @foreach (var item in inArea)
                        {
                            <NavItem Href="@group.HrefOf(item)" Match="NavLinkMatch.All">@item.Title</NavItem>
                        }
                    </NavGroup>
                }
                else
                {
                    <NavItem Href="@group.HrefOf(article)">@article.Title</NavItem>
                }
            }
        }

    }
</NavMenu>
}

@code {
    /// <summary>The cookie that keeps the components list A to Z ("az"); without it, by group.</summary>
    public const string OrderCookie = "ib-docs-order";

    [CascadingParameter] private HttpContext? Http { get; set; }

    // The components list's order, and this page's path for the toggle's way back.
    private bool _az;
    private string _here = "/";

    // This page's path with no query, as an article's Href is written: for the group that is open.
    private string _path = "";

    private IEnumerable<(string Name, RegistryComponent? Component)> AtoZ => Registry.Components
        .Concat(_current is { Preview: true } ? [_current] : [])
        .Select(c => (c.DisplayName, (RegistryComponent?)c))
        .Concat(Registry.Roadmap.Select(r => (r.Name, (RegistryComponent?)null)))
        .OrderBy(e => e.Item1, StringComparer.OrdinalIgnoreCase);

    // A component's row: a group of its own when it has topics, open on its pages.
    private RenderFragment ComponentItem(RegistryComponent component) => __builder =>
    {
        @if (component.Topics.Count > 0)
        {
            <NavGroup Label="@component.DisplayName" Open="@(component == _current)">
                <NavItem Href="@Registry.OverviewHref(component)" Match="NavLinkMatch.All">Overview</NavItem>
                @foreach (var topic in component.Topics)
                {
                    <NavItem Href="@Registry.TopicHref(component, topic)">@topic.Title</NavItem>
                }
            </NavGroup>
        }
        else
        {
            <NavItem Href="@Registry.OverviewHref(component)">@component.DisplayName</NavItem>
        }
    };

    private RegistryComponent? _current;
    private DocsArea _area;

    // On docs/components, the group it shows (?group=), whose heading is current.
    private string? _group;

    /// <summary>Which sidebar a docs page has: the components' under docs/components, the blocks' under blocks, the templates' under templates, else the articles'.</summary>
    public static DocsArea AreaOf(NavigationManager navigation) => Parts(navigation) switch
    {
        ["docs", "components", ..] => DocsArea.Components,
        ["docs", ..] => DocsArea.Articles,
        ["blocks", ..] => DocsArea.Blocks,
        ["templates", ..] => DocsArea.Templates,
        _ => DocsArea.None,
    };

    private static string[] Parts(NavigationManager navigation) =>
        navigation.ToBaseRelativePath(navigation.Uri).Split('?', '#')[0].Split('/');

    protected override void OnParametersSet()
    {
        // docs/components/{id}[/api, /{topic}]
        _area = AreaOf(Navigation);
        _az = Http?.Request.Cookies[OrderCookie] == "az";
        _here = new Uri(Navigation.Uri).PathAndQuery;
        _path = string.Join('/', Parts(Navigation));
        _current = Parts(Navigation) is ["docs", "components", var id, ..] ? Registry.ById(id) : null;
        _group = Parts(Navigation) is ["docs", "components"]
            && QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue("group", out var group)
            && Registry.Categories.Any(c => Registry.CategoryAnchor(c) == group.ToString())
                ? group.ToString()
                : null;
    }
}
