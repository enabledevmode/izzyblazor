@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* The design's column (SiteWidths.Home, boards D3 and D4): the hero and every section on the same
   1216px, centered. The header is the docs' (SiteWidths.Bars), so it doesn't move between pages. *@
<AppShell ContentWidth="Length.Rem(SiteWidths.Home)" Class="site-shell-home">
    <SiteHeader ContentWidth="Length.Rem(SiteWidths.Bars)" />
    <AppMain>
        @Body
    </AppMain>
    @* The landing page has the newsletter in a band of its own. *@
    <SiteFooter Newsletter="@(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Length > 0)" />
</AppShell>
