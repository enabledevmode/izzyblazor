@inherits LayoutComponentBase

@* The same header and footer width as the docs and demos (SiteWidths.Bars), so the logo doesn't
   move between pages, with the page's content lined up to it. *@
<AppShell ContentWidth="Length.Rem(SiteWidths.Bars)" Class="site-shell-home">
    <SiteHeader />
    <AppMain>
        @Body
    </AppMain>
    <SiteFooter />
</AppShell>
