@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* /docs: articles, component pages and API reference, with the docs sidebar and "On this page". *@

<AppShell Variant="ShellVariant.Flat" Class="site-shell site-shell-docs">
    <SiteHeader Sidebar ContentWidth="Length.Rem(SiteWidths.Bars)" />
    <AppSidebar Label="@(DocsNav.AreaOf(Navigation) switch { DocsArea.Components => "Components", DocsArea.Blocks => "Blocks", _ => "Docs" })">
        <DocsNav />
    </AppSidebar>
    <AppMain>
        @Body
    </AppMain>
    @* "On this page" from 1536px: below, its room goes to the content. *@
    <AppAside Breakpoint="Breakpoint.Xxl">
        @* The page's Static · Interactive, from a component page with examples (SectionContent). *@
        <SectionOutlet SectionName="@ModeSwitch.AsideSection" />
        <OnThisPage />
    </AppAside>
</AppShell>

@* The app's one ToastRegion, for the ToastRegion examples, which render in the page (they show it
   in their code as a comment). *@
<ToastRegion />
