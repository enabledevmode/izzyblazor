@inherits LayoutComponentBase
@inject Registry Registry

@* /demos: scenarios by category, then component. A sidebar of its own so the area reads as
   separate from the docs. One level: each category's demos, whatever component they're under
   (each demo's page and card name its component). *@

<AppShell Variant="ShellVariant.Flat" Class="site-shell site-shell-demos">
    <SiteHeader Sidebar Demos ContentWidth="Length.Rem(SiteWidths.Bars)" />
    <AppSidebar Label="Demos">
        <NavMenu aria-label="Demos">
            <NavItem Href="demos" Icon="Lucide.LayoutGrid" Match="NavLinkMatch.All">All demos</NavItem>
            @foreach (var category in Registry.Categories)
            {
                var components = Registry.InCategory(category).Where(c => c.Scenarios.Count > 0).ToList();
                if (components.Count == 0)
                {
                    continue;
                }

                <NavLabel>@category</NavLabel>
                @foreach (var component in components)
                {
                    @foreach (var scenario in component.Scenarios)
                    {
                        <NavItem Href="@Registry.ScenarioHref(component, scenario)">@scenario.Title</NavItem>
                    }
                }
            }
        </NavMenu>
    </AppSidebar>
    <AppMain>
        @Body
    </AppMain>
    <SiteFooter ContentWidth="Length.Rem(SiteWidths.Bars)" />
</AppShell>
