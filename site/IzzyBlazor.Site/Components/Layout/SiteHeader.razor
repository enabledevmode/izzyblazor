@inject ApiMetadata Api
@inject NavigationManager Navigation

@* The header every page shares: brand, version, the four areas next to them, then search, GitHub
   and the scheme switch. Below Md the version and GitHub move to the top of the menu (SiteNavHeader:
   the sidebar's drawer on docs pages, SiteNav's panel on the others). *@

<AppHeader ContentWidth="ContentWidth">
    @if (Sidebar)
    {
        <SidebarToggle />
    }
    <AppBrand Href="/" Label="IzzyBlazor" HideLabel>
        <Logo>
            <SiteLogo />
        </Logo>
    </AppBrand>
    @* A version selector (a Menu on a Ghost Sm button) will take this spot. *@
    <VersionTag Demos="Demos" VisibleFrom="Breakpoint.Md" />
    @* Pages with no sidebar (home) use SiteNav's own menu button; it goes first, where the other
       pages have SidebarToggle, so the button doesn't change sides between pages. *@
    <SiteNav Label="Site" MenuButtonPosition="MenuButtonPosition.Start" Class="site-header-nav">
        <NavItem Href="docs" Current="@(Area == DocsArea.Articles)">Docs</NavItem>
        <NavItem Href="docs/components" Current="@(Area == DocsArea.Components)">Components</NavItem>
        <NavItem Href="blocks" Current="@(Area == DocsArea.Blocks)">Blocks</NavItem>
        <NavItem Href="demos">Demos</NavItem>
        <SiteNavHeader>
            <VersionTag Demos="Demos" />
            <Box Grow />
            <GitHubLink />
        </SiteNavHeader>
    </SiteNav>
    <Box Grow />
    <SiteSearch />
    <GitHubLink VisibleFrom="Breakpoint.Md" />
    <ColorSchemeSwitch />
</AppHeader>

@code {
    /// <summary>The page has a sidebar, so the header needs its menu button.</summary>
    [Parameter] public bool Sidebar { get; set; }

    /// <summary>In the demos area, which always shows the latest release.</summary>
    [Parameter] public bool Demos { get; set; }

    /// <summary>Lines the header's content up with the page's centered columns.</summary>
    [Parameter] public Length? ContentWidth { get; set; }

    // Docs is current on the articles (docs/...), Components on docs/components/..., Blocks on
    // blocks/...; each has its own sidebar (DocsNav). Null elsewhere, so each link matches its own path.
    private DocsArea Area => DocsNav.AreaOf(Navigation);
}
