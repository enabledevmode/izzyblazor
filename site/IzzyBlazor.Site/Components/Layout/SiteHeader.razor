@inject ApiMetadata Api
@inject NavigationManager Navigation

@* The header every page shares (design board, page A · Access, HF): the brand, the five areas after it, then
   search, the examples' mode (docs pages), GitHub, the scheme switch and Sign in. The version is in the docs
   sidebar (VersionMenu) and on home's hero.
   Below Lg the areas leave the row: on docs pages they go to the top of the sidebar (its drawer below Md), on
   the others to the menu button's panel, which ends with Sign in and GitHub. Search is a field from Xl and an
   icon button below. *@

<AppHeader ContentWidth="ContentWidth">
    @if (Sidebar)
    {
        <SidebarToggle />
    }
    <AppBrand Href="/" Label="IzzyBlazor" HideLabel>
        <Logo>
            <SiteLogo />
        </Logo>
    </AppBrand>
    @* Pages with no sidebar (home) use SiteNav's own menu button; it goes first, where the other
       pages have SidebarToggle, so the button doesn't change sides between pages. *@
    <SiteNav Label="Site" MenuLabel="Open menu" Breakpoint="Breakpoint.Lg" MenuButtonPosition="MenuButtonPosition.Start" Class="site-header-nav">
        <NavItem Href="docs" Current="@(Area == DocsArea.Articles)">Docs</NavItem>
        <NavItem Href="docs/components" Current="@(Area == DocsArea.Components)">Components</NavItem>
        <NavItem Href="blocks" Current="@(Area == DocsArea.Blocks)">Blocks</NavItem>
        <NavItem Href="templates" Current="@(Area == DocsArea.Templates)">Templates</NavItem>
        <NavItem Href="pricing">Pricing</NavItem>
        @if (Sidebar)
        {
            @* The drawer's top, on phones: the header has no room for GitHub there. *@
            <SiteNavHeader>
                <Box Grow />
                <GitHubLink HiddenFrom="Breakpoint.Md" />
            </SiteNavHeader>
        }
        else
        {
            <SiteNavFooter>
                @if (Account is null)
                {
                    <Button Href="@AccountService.SignIn" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Lg" FullWidth>Sign in</Button>
                }
                <Anchor Href="https://github.com/IzzyBlazor/izzyblazor" Underline="AnchorUnderline.None" HideExternalIcon Class="site-header-github">GitHub</Anchor>
            </SiteNavFooter>
        }
    </SiteNav>
    <Box Grow />
    @* Search, 4px, the icon buttons 2px apart, then 8px to Sign in. *@
    <div class="site-header-tools">
        <SiteSearch />
        @if (Examples)
        {
            <ModeSwitch />
        }
        <GitHubLink VisibleFrom="@(Sidebar ? Breakpoint.Md : Breakpoint.Lg)" />
        <ColorSchemeSwitch />
        @if (Account is { } account)
        {
            @* Signed in at the account service: the avatar and its menu take Sign in's place at every width. *@
            <Menu Placement="Placement.BottomEnd" Class="site-header-signin">
                <Trigger Context="trigger">
                    <IconButton Label="@($"Account: {account.Display}")" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="trigger">
                        <Avatar Name="@account.Display" Size="AvatarSize.Sm" Decorative />
                    </IconButton>
                </Trigger>
                <ChildContent>
                    <MenuGroup Label="@(account.Name is null ? account.Email : $"{account.Name} ({account.Email})")">
                        <MenuItem Href="@AccountService.Address" Icon="Lucide.User">Account</MenuItem>
                    </MenuGroup>
                    <MenuDivider />
                    <MenuItem Submit Form="site-signout" Icon="Lucide.LogOut">Sign out</MenuItem>
                </ChildContent>
            </Menu>
            <form id="site-signout" action="@AccountService.SignOut" method="post" hidden></form>
        }
        else
        {
            @* Outline, and plain on a phone, where the row is full. *@
            <Button Href="@AccountService.SignIn" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" VisibleFrom="Breakpoint.Sm" Class="site-header-signin">Sign in</Button>
            <Button Href="@AccountService.SignIn" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" Size="ControlSize.Sm" HiddenFrom="Breakpoint.Sm" Class="site-header-signin">Sign in</Button>
        }
    </div>
</AppHeader>

@code {
    /// <summary>The page has a sidebar, so the header needs its menu button.</summary>
    [Parameter] public bool Sidebar { get; set; }

    /// <summary>Shows the Static · Interactive menu: on the docs pages, whose examples it sets.</summary>
    [Parameter] public bool Examples { get; set; }

    /// <summary>Lines the header's content up with the page's centered columns.</summary>
    [Parameter] public Length? ContentWidth { get; set; }

    // Docs is current on the articles (docs/...), Components on docs/components/..., Blocks on
    // blocks/...; each has its own sidebar (DocsNav). Null elsewhere, so each link matches its own path.
    private DocsArea Area => DocsNav.AreaOf(Navigation);

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Who the account service's cookie says is signed in. Null on an interactive render, which has no request.
    private SignedInAccount? Account => AccountService.SignedIn(HttpContext?.Request);
}
