@page "/"
@layout HomeLayout
@inject Registry Registry

<PageMeta Title="IzzyBlazor: Blazor components for every render mode"
          Description="@Description">
    @* The brand's display face, for the hero's headline only. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&display=swap" />
</PageMeta>

@* The landing page tells one story (design board, page SB · Story drafts, Story 1): the hero, what a circuit
   or a download costs, what IzzyBlazor does instead, the components, who made it, three steps to a running app,
   the free account, Pro, and a closing call. Every heading is a sentence or an instruction. After the hero
   the sections alternate, page then band: each band answers the plain section before it, and the change of
   color is the divider (the hero's own bottom border is the one line, between it and the plain section after). *@

@* The hero (L1): a centered column (the headline with its Ember line, what it is and the two ways in) over
   the app the library builds, as pictures: a desktop window with its phone over the window's lower start
   corner, both cut off by the hero's end. The brand's knob glows behind the headline, from under the header. *@
<Section Spacing="SectionSpacing.None" Class="site-hero">
    <img class="site-hero-knob" src="img/brand/izzyblazor-knob.svg" alt="" aria-hidden="true" />
    <div class="site-hero-grid">
        <div class="site-hero-intro">
            <Heading Level="1" Size="TextSize.Xl6" MinSize="TextSize.Xl3" Wrap="TextWrap.Balance" Class="site-hero-title">
                Blazor components.<br /><span>No circuit required.</span>
            </Heading>
            <TextBlock Color="Color.Muted" Class="site-hero-sub">
                Most components need a server circuit or a WebAssembly download to be interactive. IzzyBlazor’s components are interactive in every render mode, even static SSR.
            </TextBlock>
            <div class="site-hero-actions">
                <Button Href="docs/get-started/create-app" Size="ControlSize.Lg">Get started</Button>
                @if (SignedIn)
                {
                    <Button Href="templates" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Browse templates</Button>
                }
                else
                {
                    <Button Href="@AccountService.SignIn" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Create free account</Button>
                }
            </div>
        </div>
        @* Pictures of the page /frame/home-store, at a desktop's width and a phone's (HomePosterTests takes them),
           each in the light and the dark scheme. The desktop window is left out below 1024px, where only the
           phone fits. *@
        <div class="site-hero-demo">
            @* The caption sits on the picture it names: what the app is (shorter on phones, so the pill stays
               one line), and the link that opens it as a page. *@
            <p class="site-hero-caption">
                <span class="site-hero-caption-wide">A store dashboard, built with IzzyBlazor</span>
                <span class="site-hero-caption-narrow">Built with IzzyBlazor</span>
                <a href="@RunningHref">See it running<Icon Name="Lucide.ArrowRight" /></a>
            </p>
            <div class="site-hero-stage">
                <div class="site-hero-window">
                    <div class="site-hero-window-bar" aria-hidden="true">
                        <span class="site-hero-window-dots"><i></i><i></i><i></i></span>
                    </div>
                    <Image Src="img/home/store-desktop-light.webp" DarkSrc="img/home/store-desktop-dark.webp" Alt="The store dashboard: revenue, orders and top products" Lazy="false" />
                </div>
                <div class="site-hero-phone">
                    <Image Src="img/home/store-phone-light.webp" DarkSrc="img/home/store-phone-dark.webp" Alt="The store dashboard on a phone" Lazy="false" />
                </div>
            </div>
        </div>
    </div>
</Section>

@* The stakes: three plain facts about circuits and WebAssembly. The hero ends on its own border. *@
<Section Class="site-story">
    <div class="site-story-col">
        <div class="site-story-head">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Interactivity shouldn’t need a circuit or a download</Heading>
            <TextBlock Color="Color.Muted">Most Blazor components only respond to a click when the page runs over a circuit or in WebAssembly. Your users and your server pay for that.</TextBlock>
        </div>
        <StoryPoints Items="Stakes" />
    </div>
</Section>

@* The value: what the components do instead. *@
<Section Class="site-band site-story">
    <div class="site-story-col">
        <div class="site-story-head">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Your pages stay interactive without a circuit</Heading>
            <TextBlock Color="Color.Muted">IzzyBlazor’s components are interactive in every render mode, including static SSR.</TextBlock>
        </div>
        <StoryPoints Items="Value" />
    </div>
</Section>

@* The components by what they're for: an index of four groups, each with its count and a way into the docs. *@
<Section Class="site-story-show">
    <Stack Gap="6">
        <Row Gap="4" Justify="Justify.Between" Align="Align.End" Wrap>
            <Stack Gap="2">
                <Heading Level="2" Size="TextSize.Xl3">Browse @Registry.ComponentCountLabel components</Heading>
                <TextBlock Size="TextSize.Lg" Color="Color.Muted">Each one comes with live examples, its code and the full API.</TextBlock>
            </Stack>
            <Anchor Href="docs/components" Underline="AnchorUnderline.Hover" Class="site-action site-action-accent">Browse all components<Icon Name="Lucide.ArrowRight" /></Anchor>
        </Row>
        <Grid Columns="new() { Base = 1, Md = 2, Lg = 4 }" Gap="5">
            @foreach (var group in Showcase)
            {
                <div class="site-show">
                    <Stack Gap="2" Class="site-show-body">
                        <Row Gap="4" Justify="Justify.Between" Align="Align.Baseline" Class="site-show-head">
                            <Heading Level="3" Size="TextSize.Lg">@group.Title</Heading>
                            <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">@Count(group) components</TextBlock>
                        </Row>
                        <TextBlock Color="Color.Muted">@group.Lead</TextBlock>
                        <Row Gap="3" Wrap Class="site-show-links">
                            @foreach (var name in group.Names)
                            {
                                if (Registry.ByName(name) is { } component)
                                {
                                    <Anchor Href="@Registry.OverviewHref(component)">@component.DisplayName</Anchor>
                                }
                            }
                        </Row>
                    </Stack>
                </div>
            }
        </Grid>
    </Stack>
</Section>

@* The guide: a note from the maker, then four facts as proof. Each fact opens its page. *@
<Section Class="site-band site-story">
    <div class="site-guide">
        <div class="site-guide-note">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-guide-title">I built the library I needed</Heading>
            <p>I couldn’t find a library that let me use rich, interactive components without a circuit. The leading Blazor libraries were built before static server rendering existed, and most still need an interactive render mode for everyday things like opening a menu. I built IzzyBlazor to fill that gap. Now I use a circuit only where a page needs one, and the components work the same everywhere else.</p>
            <div class="site-guide-by">
                <Avatar Name="Israel Dryer" Src="img/avatar-israel.webp" Decorative />
                <div>
                    <span>Israel Dryer</span>
                    <span>Maker of IzzyBlazor</span>
                </div>
            </div>
        </div>
        <div class="site-proofs">
            @foreach (var proof in Proofs)
            {
                <a class="site-proof" href="@proof.Href">
                    <span>@(proof.Fact ?? Registry.ComponentCountLabel)</span>
                    <span>@proof.Line</span>
                </a>
            }
        </div>
    </div>
</Section>

@* The plan: three steps, two with the command that does them. *@
<Section Class="site-story">
    <div class="site-story-col site-story-col-steps">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Get a running app in three steps</Heading>
        <StorySteps Items="Plan" />
        <div class="site-free-actions">
            <Button Href="docs/get-started/create-app" Size="ControlSize.Lg">Get started</Button>
            <Anchor Href="docs" Underline="AnchorUnderline.Hover" Class="site-action">Read the docs<Icon Name="Lucide.ArrowRight" /></Anchor>
        </div>
    </div>
</Section>

@* L4, free with an account: the offer between the library and Pro. *@
<Section Class="site-band site-free">
    <div class="site-free-col">
        <div class="site-free-intro">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Free with an account</Heading>
            <TextBlock Color="Color.Muted">Start from a running app instead of a blank page. A free account adds app starters, page blocks and a sample CRM, all generated on your machine as code you own.</TextBlock>
        </div>
        <div class="site-free-cards">
            @foreach (var item in Free)
            {
                <article class="site-free-card">
                    <Image Src="@($"img/{item.Picture}.webp")" DarkSrc="@($"img/{item.Picture}-dark.webp")" Alt="@item.Alt" Ratio="1.6" Class="site-free-picture" />
                    <div class="site-free-body">
                        <Heading Level="3" Class="site-free-name"><span>@item.Count</span> @item.Name</Heading>
                        <p>@item.Line</p>
                        <Anchor Href="@item.Href" Underline="AnchorUnderline.Hover" Class="site-action">@item.Link<Icon Name="Lucide.ArrowRight" /></Anchor>
                    </div>
                </article>
            }
        </div>
        <div class="site-free-actions">
            @if (SignedIn)
            {
                <Button Href="templates" Size="ControlSize.Lg">Browse templates</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">You’re signed in. Run <code>izzy login</code> once on each machine.</TextBlock>
            }
            else
            {
                <Button Href="@AccountService.SignIn" Size="ControlSize.Lg">Create free account</Button>
                <Anchor Href="pricing" Underline="AnchorUnderline.Hover" Class="site-action">See pricing<Icon Name="Lucide.ArrowRight" /></Anchor>
            }
        </div>
        <p class="site-free-note">
            <Icon Name="Lucide.LockOpen" />
            <span>You don’t need an account for the components, the docs or the IzzyBlazor App starter. They’re open source under MIT and will stay that way.</span>
        </p>
    </div>
</Section>

@* The bridge to Pro: one card, and where to read more. *@
<Section Class="site-story site-story-tight">
    <div class="site-bridge">
        <div class="site-bridge-text">
            <div class="site-bridge-for">
                <Badge Accent="Accent.Neutral" Variant="BadgeVariant.Solid" Pill>Pro</Badge>
                <span>For developers who build with IzzyBlazor every day</span>
            </div>
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-bridge-title">Build faster with Pro, and maintain with confidence</Heading>
            <p>Pro gives you project-aware tools to create pages, fix accessibility problems and upgrade safely, from your IDE, the CLI or your coding agent.</p>
        </div>
        <div class="site-bridge-action">
            <Button Href="pricing" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">See what Pro adds</Button>
            <p>Reserve the founding price of $199 a year now. It’s free until launch.</p>
        </div>
    </div>
</Section>

@* The close. The newsletter's form is in the footer. *@
<Section Class="site-band site-story">
    <div class="site-close">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Build Blazor apps that load fast and work for everyone</Heading>
        <TextBlock Color="Color.Muted">Start with the components today. They’re free, open source and interactive in every render mode, including static SSR.</TextBlock>
        <div class="site-close-actions">
            <Button Href="docs/get-started/create-app" Size="ControlSize.Lg">Get started</Button>
            @if (SignedIn)
                {
                    <Button Href="templates" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Browse templates</Button>
                }
                else
                {
                    <Button Href="@AccountService.SignIn" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Create free account</Button>
                }
        </div>
    </div>
</Section>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The account service's cookie says this browser is signed in: the prompts to make an account go.
    private bool SignedIn => AccountService.SignedIn(HttpContext?.Request) is not null;

    // The hero's dashboard, as a page of its own.
    private const string RunningHref = "frame/home-store";

    private string Description => $"Open-source Blazor components, {Registry.ComponentCountLabel} of them, that are interactive in every render mode, even static SSR, with no circuit and no WebAssembly download required.";

    // L4's cards: a picture, the count beside its name (Izzy CRM is its own count), a line and a link.
    private sealed record FreeItem(string Picture, string Alt, string Count, string Name, string Line, string Link, string Href);

    private static readonly FreeItem[] Free =
    [
        new("templates/rail", "Six starters", "6", "app starters", "Six layouts, from a sidebar app to a docs site, each ready to run as soon as it’s generated.", "Browse templates", "templates"),
        new("blocks/pricing", "The pricing block", "15", "blocks", "Finished page sections, such as a hero, pricing and an FAQ, that you add to any page with izzy add.", "Browse blocks", "blocks"),
        new("templates/crm", "Izzy CRM’s dashboard", "Izzy CRM", "", "A complete app with a deal pipeline, contacts, reports and sign-in that you can build on.", "See Izzy CRM", "templates/crm"),
    ];

    private static readonly StoryPoints.Point[] Stakes =
    [
        new(Lucide.Server, "Interactive Server uses memory for every tab", "Every tab on an Interactive Server page holds a circuit in your server’s memory."),
        new(Lucide.Download, "WebAssembly makes users wait", "The browser downloads the .NET runtime before the page can respond, which is slow on phones."),
        new(Lucide.Unplug, "A dropped connection stalls the page", "When a circuit drops, a reconnect overlay covers the page. If it can’t reconnect, anything typed into a form is lost."),
    ];

    private static readonly StoryPoints.Point[] Value =
    [
        new(Lucide.MousePointerClick, "Components are interactive on static pages", "The components handle clicks, typing and keyboard navigation in the browser, with no circuit to keep open and no runtime to download."),
        new(Lucide.Zap, "Pages load fast", "Pages arrive as HTML from the server and respond as soon as they load, on any phone and any connection."),
        new(Lucide.ArrowLeftRight, "Switch render modes freely", "Move a page to Interactive Server, WebAssembly or Auto when it needs to. The components behave the same way."),
    ];

    // The guide's facts: the first is the count of components (Fact is null).
    private sealed record Proof(string? Fact, string Line, string Href);

    private static readonly Proof[] Proofs =
    [
        new(null, "components", "docs/components"),
        new("Accessible", "with a keyboard and a screen reader", "docs/accessibility/overview"),
        new("MIT", "licensed, free for any project", "https://github.com/IzzyBlazor/izzyblazor/blob/main/LICENSE"),
        new("Docs MCP", "for coding agents", "docs/get-started/ai-assistants"),
    ];

    private static readonly StorySteps.Step[] Plan =
    [
        new("Create the app", "Start a new app in any render mode, with sign-in if you need it. For an app you already have, run izzy init instead.", "dotnet new starter-blazor"),
        new("Build your pages", "Use the components in your pages, and generate a grid page for any model when you need one.", "izzy add crud Product"),
        new("Ship it", "Deploy wherever ASP.NET Core runs. Static pages need no open connection, so they scale like any website."),
    ];

    // The index: each card counts the catalog groups it covers.
    private sealed record ShowGroup(string Title, string Lead, string[] Groups, string[] Names);

    private static readonly ShowGroup[] Showcase =
    [
        new("Data", "Grids, trees, lists and scheduling, with sorting, filtering, editing and export.",
            ["Data", "Display", "Media", "Conversation & AI"], ["DataGrid", "TreeList", "Table", "Scheduler", "TreeView", "ListView"]),
        new("Charts", "More than twenty chart types and gauges, drawn on the server as SVG, with zoom and drill-down.",
            ["Charts"], ["Chart", "SankeyChart", "PieChart", "HeatmapChart", "Gauge", "Sparkline"]),
        new("Forms and inputs", "Validated fields, selection, dates and file uploads, for static and interactive forms.",
            ["Inputs", "Date and time", "Dropdowns", "Buttons"], ["Form", "TextField", "DateField", "Combobox", "MultiSelect", "FileUpload"]),
        new("App structure", "App shells, navigation, tabs, dialogs, drawers and feedback.",
            ["Layout", "Navigation", "Disclosure", "Overlays", "Feedback"], ["AppShell", "TileLayout", "Tabs", "Dialog", "Drawer", "ToastRegion"]),
    ];

    private int Count(ShowGroup group) => group.Groups.Sum(g => Registry.InCategory(g).Count());
}
