@page "/"
@layout HomeLayout
@inject Registry Registry

<PageTitle>IzzyBlazor: Blazor components. No circuit required.</PageTitle>
<HeadContent>
    <meta name="description" content="Rich Blazor components for static SSR: real HTML first, interactive without a circuit, and bound to C# where you need it." />
    @* The brand's display face, for the hero's headline only. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&display=swap" />
</HeadContent>

@* The brand's hero (brand/hero/hero-dark): an ink band in either scheme, the wordmark, the headline
   with its ember line, and the glowing knob behind the live example. Drawn rather than placed as
   the image, so the headline stays text and the example stays live. *@
<Section Spacing="SectionSpacing.Lg" ColorScheme="ColorScheme.Dark" Class="site-hero">
    <svg class="site-hero-glow" viewBox="0 0 800 800" aria-hidden="true" focusable="false">
        <circle cx="400" cy="400" r="364" fill="#F26A1B" fill-opacity="0.05" />
        <circle cx="400" cy="400" r="280" fill="#F26A1B" fill-opacity="0.07" />
        <circle cx="400" cy="400" r="210" fill="#F26A1B" fill-opacity="0.1" />
        <circle cx="400" cy="400" r="197.3" fill="#F26A1B" fill-opacity="0.22" />
        <circle cx="400" cy="400" r="140" fill="#F26A1B" />
        <circle cx="400" cy="400" r="57.3" fill="#FFB020" />
    </svg>
    <Grid Columns="new() { Base = 1, Lg = 2 }" Gap="10" Align="Align.Start" Class="site-hero-grid">
        <Stack Gap="6">
            <img class="site-hero-wordmark" src="img/izzyblazor-wordmark-dark.svg" alt="" width="944" height="210" />
            <Heading Level="1" Size="TextSize.Xl5" MinSize="TextSize.Xl3" Wrap="TextWrap.Balance" Class="site-hero-title">
                Blazor components.<br /><span>No circuit required.</span>
            </Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted" Wrap="TextWrap.Pretty">
                Rich components for static SSR. Pages arrive as real HTML, a small script brings them to life, and
                the same markup binds to C# on the pages you make interactive.
            </TextBlock>
            <Row Gap="3" Wrap>
                <Button Href="docs" Size="ControlSize.Lg" Accent="@Ember">Get started</Button>
                <Button Href="docs/components" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Browse components</Button>
            </Row>
            <Row Gap="2" Align="Align.Center" Class="site-install">
                <TextBlock As="span" Color="Color.Muted" aria-hidden="true">$</TextBlock>
                <Code>@Install</Code>
                <CopyButton Text="@Install" Label="Copy the install command" Size="ControlSize.Sm" />
            </Row>
        </Stack>
        <ExampleViewer Example="home-settings" Scheme="light" />
    </Grid>
</Section>

<Section Bg="Color.SurfaceContainerLow" Class="site-band">
    <Stack Gap="6">
        <Stack Gap="2">
            <Heading Level="2" Size="TextSize.Xl2">Progressive by design</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted">Every component works at each layer and gets better at the next.</TextBlock>
        </Stack>
        <Grid Columns="new() { Base = 1, Md = 3 }" Gap="4">
            <Card Title="Real HTML first" Variant="CardVariant.Outline">
                <CardMedia><div class="site-media"><ComponentPicture Id="mode-off" /><span class="site-media-tag"><ModeChip Mode="off" Level="ModeLevel.Full" /></span></div></CardMedia>
                <TextBlock>Components render complete HTML on the server: a fast first paint, readable by search engines, and working before the script loads or if it fails.</TextBlock>
            </Card>
            <Card Title="Interactive without a circuit" Variant="CardVariant.Outline">
                <CardMedia><div class="site-media"><ComponentPicture Id="mode-static" /><span class="site-media-tag"><ModeChip Mode="static" Level="ModeLevel.Full" /></span></div></CardMedia>
                <TextBlock>Small custom elements add keyboard handling, live values and drop zones on static pages. No SignalR, no WebAssembly.</TextBlock>
            </Card>
            <Card Title="C# where you need it" Variant="CardVariant.Outline">
                <CardMedia><div class="site-media"><ComponentPicture Id="mode-live" /><span class="site-media-tag"><ModeChip Mode="live" Level="ModeLevel.Full" /></span></div></CardMedia>
                <TextBlock>Make a page Server, WebAssembly or Auto and the same components take <Code>@("@bind-Value")</Code> and events. Nothing to rewrite.</TextBlock>
            </Card>
        </Grid>
    </Stack>
</Section>

<Section>
    <Stack Gap="6">
        <Stack Gap="2">
            <Heading Level="2" Size="TextSize.Xl2">Why SSR first</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted">
                Interactive Server keeps a SignalR circuit open for every visitor; WebAssembly downloads a runtime first.
                Static SSR does neither, and IzzyBlazor makes it enough for most pages.
            </TextBlock>
        </Stack>
        <Grid Columns="new() { Base = 1, Sm = 2, Lg = 4 }" Gap="6" Class="site-why">
            <Stack Gap="2">
                <Pictogram Icon="Lucide.MemoryStick" />
                <Heading Level="3" Size="TextSize.Md">No per-visitor state</Heading>
                <TextBlock Color="Color.Muted">No circuit holds server memory for each open tab. Pages scale like any web app, behind any load balancer.</TextBlock>
            </Stack>
            <Stack Gap="2">
                <Pictogram Icon="Lucide.WifiOff" />
                <Heading Level="3" Size="TextSize.Md">No reconnect dialog</Heading>
                <TextBlock Color="Color.Muted">Nothing to drop when a laptop sleeps or a phone changes networks. A static page just keeps working.</TextBlock>
            </Stack>
            <Stack Gap="2">
                <Pictogram Icon="Lucide.Zap" />
                <Heading Level="3" Size="TextSize.Md">Fast first paint</Heading>
                <TextBlock Color="Color.Muted">The server sends finished HTML, with no runtime to download first. Good for users and for search.</TextBlock>
            </Stack>
            <Stack Gap="2">
                <Pictogram Icon="Lucide.Layers" />
                <Heading Level="3" Size="TextSize.Md">One set of components</Heading>
                <TextBlock Color="Color.Muted">The same components on static, Server, WebAssembly and Auto pages. Opt a page into interactivity when it needs C#.</TextBlock>
            </Stack>
        </Grid>
    </Stack>
</Section>

<Section>
    <Stack Gap="6">
        <Heading Level="2" Size="TextSize.Xl2">Start from your project</Heading>
        <Grid Columns="new() { Base = 1, Sm = 2, Lg = 4 }" Gap="4">
            <Card Title="New Blazor Web App" Href="@GettingStarted" Description="Install IzzyBlazor, add IzzyTheme to the head, map the endpoints." Size="ControlSize.Sm" Class="site-linkcard">
                <CardHeader><Pictogram Icon="Lucide.Rocket" /></CardHeader>
            </Card>
            <Card Title="WebAssembly or Auto" Href="@($"{GettingStarted}#webassembly-and-auto-render-modes")" Description="Reference IzzyBlazor.Core from the .Client project; the server keeps IzzyBlazor." Size="ControlSize.Sm" Class="site-linkcard">
                <CardHeader><Pictogram Icon="Lucide.Cpu" /></CardHeader>
            </Card>
            <Card Title="Every component" Href="docs/components" Description="Each one's API, generated from the library, and an Overview with live examples." Size="ControlSize.Sm" Class="site-linkcard">
                <CardHeader><Pictogram Icon="Lucide.LayoutGrid" /></CardHeader>
            </Card>
            <Card Title="Demos" Href="demos" Description="Realistic scenarios, each in all three modes, with the source." Size="ControlSize.Sm" Class="site-linkcard">
                <CardHeader><Pictogram Icon="Lucide.MonitorPlay" /></CardHeader>
            </Card>
        </Grid>
    </Stack>
</Section>

<Section>
    <Stack Gap="4">
        <Row Gap="4" Align="Align.Baseline" Wrap>
            <Heading Level="2" Size="TextSize.Xl2">Components</Heading>
            <Anchor Href="docs/components">All @Registry.Components.Count components</Anchor>
        </Row>
        <Row Gap="2" Wrap>
            @foreach (var component in Registry.Components.Where(c => Featured.Contains(c.Name)))
            {
                <Tag Href="@Registry.OverviewHref(component)">@component.Name</Tag>
            }
        </Row>
    </Stack>
</Section>

@code {
    // The brand's Ember, on the hero's call to action only (it isn't a component accent).
    private static readonly Accent Ember = Accent.Of("#F26A1B");

    private const string Install = "dotnet add package IzzyBlazor --prerelease";
    private const string GettingStarted = "https://github.com/enabledevmode/izzyblazor/blob/main/docs/getting-started.md";

    private static readonly HashSet<string> Featured =
    [
        "AppShell", "Button", "Form", "TextField", "NumberField", "Select", "Combobox", "FileUpload", "Tabs", "Menu",
        "Dialog", "Drawer", "ToastRegion", "Table", "Card", "Stat", "Timeline", "Code",
    ];
}
