@page "/"
@layout HomeLayout
@inject Registry Registry
@inject ApiMetadata Api
@using Rows = IzzyBlazor.Site.Examples.Table.Orders

<PageMeta Title="IzzyBlazor: Blazor components for every render mode"
          Description="@Description">
    @* The brand's display face, for the hero's headline only. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,700&display=swap" />
</PageMeta>

@* The hero (L1): a centered column (the headline with its Ember line, what it is and the two ways in) over
   the app the library builds, as pictures: a desktop window with its phone over the window's lower start
   corner, both cut off by the hero's end. The brand's knob rises from behind the window's top edge. *@
<Section Spacing="SectionSpacing.None" Class="site-hero">
    <div class="site-hero-grid">
        <div class="site-hero-intro">
            <Heading Level="1" Size="TextSize.Xl6" MinSize="TextSize.Xl3" Wrap="TextWrap.Balance" Class="site-hero-title">
                Blazor components.<br /><span>No circuit required.</span>
            </Heading>
            <TextBlock Color="Color.Muted" Class="site-hero-sub">
                @Registry.ComponentCountLabel components that work in every Blazor render mode, including static SSR.
            </TextBlock>
            <div class="site-hero-actions">
                <Button Href="docs/get-started" Size="ControlSize.Lg" Accent="@Ember">Get started</Button>
                <Button Href="docs/components" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Browse components</Button>
            </div>
        </div>
        @* Pictures of the page /frame/home-store, at a desktop's width and a phone's (HomePosterTests takes them),
           each in the light and the dark scheme. The desktop window is left out below 1024px, where only the
           phone fits. *@
        <div class="site-hero-demo">
            @* The caption sits on the picture it names: what the app is (shorter on phones, so the pill stays
               one line), and the link that opens it as a page. *@
            <p class="site-hero-caption">
                <span class="site-hero-caption-wide">A store dashboard, built with IzzyBlazor</span>
                <span class="site-hero-caption-narrow">Built with IzzyBlazor</span>
                <a href="@RunningHref">See it running<Icon Name="Lucide.ArrowRight" /></a>
            </p>
            <div class="site-hero-stage">
                <img class="site-hero-knob" src="img/brand/izzyblazor-knob.svg" alt="" aria-hidden="true" />
                <div class="site-hero-window">
                    <div class="site-hero-window-bar" aria-hidden="true">
                        <span class="site-hero-window-dots"><i></i><i></i><i></i></span>
                    </div>
                    <Image Src="img/home/store-desktop-light.webp" DarkSrc="img/home/store-desktop-dark.webp" Alt="The store dashboard: revenue, orders and top products" Lazy="false" />
                </div>
                <div class="site-hero-phone">
                    <Image Src="img/home/store-phone-light.webp" DarkSrc="img/home/store-phone-dark.webp" Alt="The store dashboard on a phone" Lazy="false" />
                </div>
            </div>
        </div>
    </div>
</Section>

@* How it works: the band's title and intro, then a picture of each mode. *@
<Section Bg="Color.FillSubtle" Class="site-band">
    <Stack Gap="6">
        <Stack Gap="2">
            <Heading Level="2" Size="TextSize.Xl3">Use interactivity only where you need it.</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted" Wrap="TextWrap.Pretty" Class="site-why-intro">
                Many Blazor components require interactive rendering to function. IzzyBlazor works with static SSR, Interactive Server, WebAssembly, and Auto, so you can add Blazor interactivity where it's needed without requiring it everywhere.
            </TextBlock>
        </Stack>
        <Grid Columns="new() { Base = 1, Md = 2 }" Gap="4">
            <Card Title="Static: no circuit" Variant="CardVariant.Outline">
                <CardMedia><div class="site-media"><ComponentPicture Id="mode-static" /></div></CardMedia>
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">Pages render as HTML on the server. The browser's own elements, links and forms do the work, and IzzyBlazor's small script adds keyboard controls, live values and dragging. No SignalR connection, no WebAssembly runtime.</TextBlock>
            </Card>
            <Card Title="Interactive: bound to C#" Variant="CardVariant.Outline">
                <CardMedia><div class="site-media"><ComponentPicture Id="mode-interactive" /></div></CardMedia>
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">Choose Server, WebAssembly or Auto for a page that needs C#. The same components take <Code Style="white-space: nowrap">@("@bind-Value")</Code> and events, and prerender as the same working HTML.</TextBlock>
            </Card>
        </Grid>
    </Stack>
</Section>

@* The components by what they're for: each card's top is the real component, inert (a picture of
   it, so the page has no extra tab stops), cropped and fading at the bottom. *@
<Section>
    <Stack Gap="6">
        <Row Gap="4" Justify="Justify.Between" Align="Align.End" Wrap>
            <Stack Gap="2">
                <Heading Level="2" Size="TextSize.Xl3">Components for real applications</Heading>
                <TextBlock Size="TextSize.Lg" Color="Color.Muted">@Registry.ComponentCountLabel components, each with live examples, their code and the full API.</TextBlock>
            </Stack>
            <Anchor Href="docs/components" Underline="AnchorUnderline.Hover" Class="site-action site-action-accent">Browse all components<Icon Name="Lucide.ArrowRight" /></Anchor>
        </Row>
        <Grid Columns="new() { Base = 1, Md = 2 }" Gap="5">
            @foreach (var group in Showcase)
            {
                <div class="site-show">
                    <div class="site-show-preview" inert>
                        @switch (group.Key)
                        {
                            case "data":
                                <DataGrid Items="Rows.All" ItemKey="o => o.Number.ToString()" PageSize="5" Caption="Recent orders" QueryPrefix="home-" Size="ControlSize.Sm"
                                          InitialSort="-total" SelectionMode="SelectionMode.Multiple" @bind-Selection="_picked" RowLabel='o => $"order {o.Number}"'>
                                    <SelectionActions>
                                        <Button Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" StartIcon="Lucide.Archive">Archive</Button>
                                    </SelectionActions>
                                    <Columns>
                                        <PropertyColumn Property="o => o.Customer" Sortable Filterable MinWidth="9.Rem" />
                                        <TemplateColumn Title="Status" Width="7.Rem">
                                            <Badge Status="Rows.StatusOf(context.Status)" Dot>@context.Status</Badge>
                                        </TemplateColumn>
                                        <PropertyColumn Property="o => o.Total" Format="C" Sortable Width="6.Rem" />
                                    </Columns>
                                </DataGrid>
                                break;
                            case "charts":
                                @Budget
                                break;
                            case "forms":
                                <Grid Columns="2" Gap="3">
                                    <TextField Label="Full name" @bind-Value="_name" />
                                    <TextField Label="Email" @bind-Value="_email" />
                                    <Select Label="Plan" Items="Plans" @bind-Value="_plan" />
                                    <DateField Label="Start date" @bind-Value="_start" />
                                    <SegmentedControl Label="Billing" @bind-Value="_billing" FullWidth />
                                    <Switch Label="Send me product updates" @bind-Value="_updates" />
                                </Grid>
                                break;
                            case "app":
                                <Stack Gap="3">
                                    <Breadcrumb>
                                        <BreadcrumbItem Href="#">Store</BreadcrumbItem>
                                        <BreadcrumbItem Href="#">Orders</BreadcrumbItem>
                                        <BreadcrumbItem>#1064</BreadcrumbItem>
                                    </Breadcrumb>
                                    <Stepper Current="3" Label="Order progress">
                                        <Step Label="Ordered" />
                                        <Step Label="Packed" />
                                        <Step Label="Shipped" />
                                        <Step Label="Delivered" />
                                    </Stepper>
                                    <Tabs Label="Order">
                                        <Tab Label="Details" Icon="Lucide.ReceiptText"><TextBlock Color="Color.Muted">Contoso Ltd · 3 items · $412.80</TextBlock></Tab>
                                        <Tab Label="Shipping" Icon="Lucide.Truck">Shipping</Tab>
                                        <Tab Label="History" Icon="Lucide.Clock">History</Tab>
                                    </Tabs>
                                    <Alert Status="Status.Warning" Title="2 items are waiting on stock" />
                                </Stack>
                                break;
                        }
                    </div>
                    <Stack Gap="2" Class="site-show-body">
                        <Row Gap="4" Justify="Justify.Between" Align="Align.Baseline">
                            <Heading Level="3" Size="TextSize.Lg">@group.Title</Heading>
                            <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">@Count(group) components</TextBlock>
                        </Row>
                        <TextBlock Color="Color.Muted">@group.Lead</TextBlock>
                        <Row Gap="3" Wrap Class="site-show-links">
                            @foreach (var name in group.Names)
                            {
                                if (Registry.ByName(name) is { } component)
                                {
                                    <Anchor Href="@Registry.OverviewHref(component)">@component.DisplayName</Anchor>
                                }
                            }
                        </Row>
                    </Stack>
                </div>
            }
        </Grid>
    </Stack>
</Section>

@* L4, free with an account: after the components, so the offer reads as more on top of a free library. *@
<Section Class="site-band site-free">
    <div class="site-free-col">
        <div class="site-free-intro">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Free with an account</Heading>
            <TextBlock Color="Color.Muted">Start from a running app instead of a blank page. A free account adds app starters, page blocks and a sample CRM, all generated on your machine as code you own.</TextBlock>
        </div>
        <div class="site-free-cards">
            @foreach (var item in Free)
            {
                <article class="site-free-card">
                    <Image Src="@($"img/{item.Picture}.webp")" DarkSrc="@($"img/{item.Picture}-dark.webp")" Alt="@item.Alt" Ratio="1.6" Class="site-free-picture" />
                    <div class="site-free-body">
                        <Heading Level="3" Class="site-free-name"><span>@item.Count</span> @item.Name</Heading>
                        <p>@item.Line</p>
                        <Anchor Href="@item.Href" Underline="AnchorUnderline.Hover" Class="site-action">@item.Link<Icon Name="Lucide.ArrowRight" /></Anchor>
                    </div>
                </article>
            }
        </div>
        <div class="site-free-actions">
            <Button Href="@AccountService.SignIn" Size="ControlSize.Lg">Create a free account</Button>
            <Anchor Href="pricing" Underline="AnchorUnderline.Hover" Class="site-action">See pricing<Icon Name="Lucide.ArrowRight" /></Anchor>
        </div>
        <p class="site-free-note">
            <Icon Name="Lucide.LockOpen" />
            <span>You don’t need an account for the components, the docs or the IzzyBlazor App starter. They’re open source under MIT and will stay that way.</span>
        </p>
    </div>
</Section>

<Section>
    <Stack Gap="6">
        <Stack Gap="2">
            <Heading Level="2" Size="TextSize.Xl3">Built for developers. Ready for agents.</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted">Accessible from the first render, and documented for your coding agent.</TextBlock>
        </Stack>
        <Grid Columns="new() { Base = 1, Md = 2 }" Gap="4">
            <Card Title="Accessible from the start" Href="docs/accessibility/overview" Size="ControlSize.Sm" Class="site-linkcard"
                  Description="Components build to WCAG 2.2 level AA on the browser's own elements, with keyboard support, visible focus and screen reader announcements. Each documents its keyboard and ARIA behavior, and the guide lists the gaps that remain.">
                <CardHeader><Pictogram Icon="Lucide.Accessibility" /></CardHeader>
            </Card>
            <Card Title="Docs your coding agent can use" Href="docs/get-started/ai-assistants" Size="ControlSize.Sm" Class="site-linkcard"
                  Description="IzzyBlazor's MCP server at izzyblazor.com/mcp gives agents component search, each component's API and working examples, checks known issues, and reports gaps it finds.">
                <CardHeader><Pictogram Icon="Lucide.Bot" /></CardHeader>
            </Card>
        </Grid>
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">
            IzzyBlazor is in preview (@Api.Version): APIs may change before 1.0. It's MIT licensed, for .NET 10 and later.
            <Anchor Href="https://github.com/enabledevmode/izzyblazor">Source and issues on GitHub</Anchor>
        </TextBlock>
    </Stack>
</Section>


@* L6, the close: the three ways in, each with its command. Then L7, the newsletter's band (the footer here has no form). *@
<Section Class="site-start">
    <div class="site-start-col">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Start building</Heading>
        <Grid Columns="new() { Base = 1, Lg = 3 }" Gap="4">
            @foreach (var way in Ways)
            {
                <Card Size="ControlSize.Sm">
                    <CardBody Gap="3">
                        <Row Gap="2" Align="Align.Center" Wrap>
                            <Heading Level="3" Class="site-start-name">@way.Title</Heading>
                            @if (way.Account)
                            {
                                <Badge Size="BadgeSize.Sm" Accent="Accent.Neutral" Variant="BadgeVariant.Soft" StartIcon="Lucide.User" Pill>Free account</Badge>
                            }
                        </Row>
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">@way.Line</TextBlock>
                        <Code Block>@way.Command</Code>
                        <Anchor Href="@way.Href" Underline="AnchorUnderline.Hover" Class="site-action">@way.Link<Icon Name="Lucide.ArrowRight" /></Anchor>
                    </CardBody>
                </Card>
            }
        </Grid>
    </div>
</Section>

<Section Class="site-band site-news">
    <div class="site-news-col">
        <div class="site-news-intro">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-news-title">One email a month</Heading>
            <TextBlock Color="Color.Muted">Once a month, we’ll tell you what’s new in IzzyBlazor. Subscribers see new blocks and kits first and hear about the founding price when Pro goes on sale.</TextBlock>
        </div>
        <Newsletter Source="home" />
    </div>
</Section>

@code {
    // The brand's Ember, on the hero's call to action only (it isn't a component accent).
    private static readonly Accent Ember = Accent.Of("#F26A1B");

    // The hero's dashboard, as a page of its own.
    private const string RunningHref = "frame/home-store";

    private string Description => $"Open-source Blazor components, {Registry.ComponentCountLabel} of them, that work in static SSR, Interactive Server, WebAssembly and Auto. Pick each page's render mode for the page.";

    // L4's cards: a picture, the count beside its name (Izzy CRM is its own count), a line and a link.
    private sealed record FreeItem(string Picture, string Alt, string Count, string Name, string Line, string Link, string Href);

    private static readonly FreeItem[] Free =
    [
        new("templates/rail", "Six starters", "6", "app starters", "Six layouts, from a sidebar app to a docs site, each ready to run as soon as it’s generated.", "Browse templates", "templates"),
        new("blocks/pricing", "The pricing block", "15", "blocks", "Finished page sections, such as a hero, pricing and an FAQ, that you add to any page with izzy add.", "Browse blocks", "blocks"),
        new("templates/crm", "Izzy CRM’s dashboard", "Izzy CRM", "", "A complete app with a deal pipeline, contacts, reports and sign-in that you can build on.", "See Izzy CRM", "templates/crm"),
    ];

    // L6's cards.
    private sealed record Way(string Title, bool Account, string Line, string Command, string Link, string Href);

    private static readonly Way[] Ways =
    [
        new("New app", false, "The base starter works in every render mode, with sign-in if you need it.", "dotnet new starter-blazor -n MyApp", "Start a new app", "docs/get-started/create-app"),
        new("Existing app", false, "Add IzzyBlazor’s theme and components to a Blazor app you already have.", "izzy init", "Add to an app", "docs/get-started/existing-app"),
        new("An app shell, blocks or the CRM", true, "Start from an app shell or Izzy CRM, or add finished blocks to the pages you have.", "izzy new starter sidebar -n MyApp", "Create a free account", AccountService.SignIn),
    ];

    // The showcase: each card counts the catalog groups it covers.
    private sealed record ShowGroup(string Key, string Title, string Lead, string[] Groups, string[] Names);

    private static readonly ShowGroup[] Showcase =
    [
        new("data", "Data", "Grids, trees, lists and scheduling, with sorting, filtering, editing and export.",
            ["Data", "Display", "Media", "Conversation & AI"], ["DataGrid", "TreeList", "Table", "Scheduler", "TreeView", "ListView"]),
        new("charts", "Charts", "More than twenty chart types and gauges, drawn on the server as SVG, with zoom and drill-down.",
            ["Charts"], ["Chart", "SankeyChart", "PieChart", "HeatmapChart", "Gauge", "Sparkline"]),
        new("forms", "Forms and inputs", "Validated fields, selection, dates and file uploads, for static and interactive forms.",
            ["Inputs", "Date and time", "Dropdowns", "Buttons"], ["Form", "TextField", "DateField", "Combobox", "MultiSelect", "FileUpload"]),
        new("app", "App structure", "App shells, navigation, tabs, dialogs, drawers and feedback.",
            ["Layout", "Navigation", "Disclosure", "Overlays", "Feedback"], ["AppShell", "TileLayout", "Tabs", "Dialog", "Drawer", "ToastRegion"]),
    ];

    private int Count(ShowGroup group) => group.Groups.Sum(g => Registry.InCategory(g).Count());

    // The Charts card's Sankey: the docs' own example.
    private static readonly RenderFragment Budget = b =>
    {
        b.OpenComponent<global::IzzyBlazor.Site.Examples.SankeyChart.Usage>(0);
        b.CloseComponent();
    };

    // The Data card's grid: two orders ticked. The Forms card's fields.
    private Selection? _picked = Selection.Of("1011", "1022");
    private static readonly string[] Plans = ["Starter", "Team", "Business"];
    private string? _name = "Ada Lovelace", _email = "ada@example.com", _plan = "Team";
    private DateOnly? _start = new DateOnly(2026, 12, 1);
    private bool _updates = true;
    private Billing _billing = Billing.Yearly;

    private enum Billing { Monthly, Yearly }
}
