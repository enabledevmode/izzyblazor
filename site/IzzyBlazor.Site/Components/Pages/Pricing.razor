@page "/pricing"
@layout HomeLayout
@using System.ComponentModel.DataAnnotations
@inject AccountService Account
@inject FormLimit Limit

<PageMeta Title="Pricing · IzzyBlazor"
          Description="Pro adds tools to build faster and maintain with confidence. Every component is free and open source, and a free account adds starters, blocks and a sample app." />

@* The pricing page tells why to get Pro (design board, page SB · Story drafts, Story 2): the hero, the work
   every new page adds, what Pro does about it, three steps to get it, then the plans (PR1, page A · Access):
   the three levels, the founding price with the form that reserves it, what each level makes, Enterprise and
   the questions. The three cards share their rows (site.css, .site-pricing-levels), so prices, actions and
   lists line up whatever each one holds. *@
<Section Spacing="SectionSpacing.None">
    <div class="site-pricing-hero">
        <div class="site-pricing-hero-text">
            <div class="site-pricing-hero-badges">
                <Badge Accent="Accent.Neutral" Variant="BadgeVariant.Solid" Pill>Pro</Badge>
                <Badge Variant="BadgeVariant.Outline" Pill>Preview</Badge>
            </div>
            <Heading Level="1" Wrap="TextWrap.Balance" Class="site-pricing-title">Build faster. Maintain with confidence.</Heading>
            <TextBlock Color="Color.Muted" Class="site-pricing-hero-lead">Pro gives you project-aware tools to create pages, fix accessibility problems and upgrade safely, from your IDE, the CLI or your coding agent.</TextBlock>
            <div class="site-pricing-hero-actions">
                <Button Href="pricing#reserve" Size="ControlSize.Lg">Reserve the founding price</Button>
                <Button Href="pricing#plans" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Compare plans</Button>
            </div>
            <p class="site-pricing-note">$199 a year at the founding price, instead of $299. Reserving is free, and you pay nothing until launch.</p>
        </div>
        @* A drawing of the plugin's wizard, to show the idea: the form, then the changes to review. In a
           project window from 1024px, on its own below. *@
        <div class="site-ide" role="img" aria-label="Illustration: the IDE plugin’s Add CRUD pages wizard, with a model, the pages to make, a layout and four changes to review">
            <div class="site-ide-bar"><i></i><i></i><i></i><span>MyApp</span></div>
            <div class="site-ide-back">
                <div class="site-ide-tree">
                    <span>MyApp</span>
                    <span data-depth="1">Components</span>
                    <span data-depth="1">Pages</span>
                    <span data-depth="2" data-current>Products</span>
                    <span data-depth="1">Models</span>
                    <span data-depth="2">Product.cs</span>
                    <span data-depth="1">Program.cs</span>
                </div>
                <pre class="site-ide-code">public class Product
{
    public int Id { get; set; }
    public string Name { get; set; }
    public decimal Price { get; set; }
    public int Stock { get; set; }
}</pre>
            </div>
            <div class="site-wizard">
                <div class="site-wizard-head">
                    <Icon Name="Lucide.Wand" />
                    <span>Add CRUD pages</span>
                    <Badge Size="BadgeSize.Sm" Accent="Accent.Neutral" Variant="BadgeVariant.Solid" Pill>Pro</Badge>
                </div>
                <div class="site-wizard-body">
                    <div>
                        <span class="site-wizard-label">Model</span>
                        <span class="site-wizard-select">Product<Icon Name="Lucide.ChevronDown" /></span>
                    </div>
                    <div>
                        <span class="site-wizard-label">Pages</span>
                        @foreach (var made in (string[])["List, with search and paging", "Detail", "Create and edit form"])
                        {
                            <span class="site-wizard-check"><i><Icon Name="Lucide.Check" /></i>@made</span>
                        }
                    </div>
                    <div>
                        <span class="site-wizard-label">Layout</span>
                        <span class="site-wizard-select">Sidebar app<Icon Name="Lucide.ChevronDown" /></span>
                    </div>
                    <div>
                        <span class="site-wizard-label">Changes to review</span>
                        <span class="site-wizard-changes">
                            <span><b data-kind="add">+</b> Pages/Products/List.razor</span>
                            <span><b data-kind="add">+</b> Pages/Products/Detail.razor</span>
                            <span><b data-kind="add">+</b> Pages/Products/Edit.razor</span>
                            <span><b data-kind="edit">~</b> Layout/NavMenu.razor</span>
                        </span>
                    </div>
                </div>
                <div class="site-wizard-foot">
                    <span>Cancel</span>
                    <span data-primary>Apply 4 changes</span>
                </div>
            </div>
            <span class="site-ide-caption">Illustration: the IDE plugin’s wizard</span>
        </div>
    </div>
</Section>

@* The stakes: work every developer knows, never the free levels' limits. *@
<Section Class="site-band site-story site-story-88">
    <div class="site-story-col">
        <div class="site-story-head">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Every new page adds more work</Heading>
            <TextBlock Color="Color.Muted">The components are the quick part. Here’s where the time goes once you build with IzzyBlazor every day.</TextBlock>
        </div>
        <StoryPoints Items="Stakes" />
    </div>
</Section>

<Section Class="site-story site-story-88">
    <div class="site-story-col">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">What Pro does for you</Heading>
        <StoryPoints Items="Value" />
    </div>
</Section>

<Section Class="site-band site-story site-story-88">
    <div class="site-story-col site-story-col-steps">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Getting Pro takes three steps</Heading>
        <StorySteps Items="Plan" />
    </div>
</Section>

<Section Spacing="SectionSpacing.None" id="plans">
    <div class="site-pricing-col site-pricing-top">
        <div class="site-pricing-intro">
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Start free, and add Pro when you need it</Heading>
            <TextBlock Color="Color.Muted" Class="site-pricing-lead">
                Every component is open source under the MIT license, and you don’t need an account to use them. A free account adds app starters, page blocks and a complete sample app. Pro adds tools to build faster and maintain with confidence.
            </TextBlock>
        </div>
        <div class="site-pricing-preview">
            <Badge Variant="BadgeVariant.Outline" Pill>Preview</Badge>
            <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">IzzyBlazor is in preview, and Pro goes on sale with the beta. You can reserve the founding price now.</TextBlock>
        </div>
        <div class="site-pricing-levels">
            @foreach (var level in Levels)
            {
                var pro = level.Name == "Pro";
                <article class="site-pricing-level" data-pick="@(level.Pick ? "true" : null)" aria-labelledby="level-@level.Id">
                    <div class="site-pricing-level-name">
                        <div>
                            <Heading Level="3" Size="TextSize.Lg" id="@($"level-{level.Id}")">@level.Name</Heading>
                            @if (pro)
                            {
                                <Badge Variant="BadgeVariant.Outline" Size="BadgeSize.Sm" Pill>Founding price</Badge>
                            }
                            else if (level.Id == "free" && SignedIn)
                            {
                                <Badge Status="Status.Success" Size="BadgeSize.Sm" Pill>Your plan</Badge>
                            }
                        </div>
                        <p>@level.For</p>
                    </div>
                    <div class="site-pricing-level-price">
                        <p>
                            <span class="site-pricing-amount">@level.Price</span>
                            <span class="site-pricing-unit">@level.Unit[0],<br />@level.Unit[1]</span>
                        </p>
                        @if (level.PriceNote is not null)
                        {
                            <p class="site-pricing-note">@level.PriceNote</p>
                        }
                    </div>
                    <div class="site-pricing-level-action">
                        @if (pro && _reserved is not null)
                        {
                            <Button Size="ControlSize.Lg" StartIcon="Lucide.Check" FullWidth Disabled>Reserved</Button>
                            <p class="site-pricing-note">We’ll email @_reserved at launch.</p>
                        }
                        else if (level.Id == "free" && SignedIn)
                        {
                            <Button Href="templates" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" FullWidth>Browse templates</Button>
                            <p class="site-pricing-note">@level.Note</p>
                        }
                        else
                        {
                            @if (level.Pick || pro)
                            {
                                <Button Href="@level.Href" Size="ControlSize.Lg" FullWidth>@level.Action</Button>
                            }
                            else
                            {
                                <Button Href="@level.Href" Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" FullWidth>@level.Action</Button>
                            }
                            <p class="site-pricing-note" data-mono="@(level.NoteIsCode ? "true" : null)">@level.Note</p>
                        }
                    </div>
                    <div class="site-pricing-level-list">
                        @if (level.Includes is not null)
                        {
                            <p>@level.Includes</p>
                        }
                        <List Plain Icon="Lucide.Check" IconColor="Color.SuccessText" Gap="2">
                            @foreach (var item in level.Items)
                            {
                                <ListItem>@item</ListItem>
                            }
                        </List>
                    </div>
                </article>
            }
        </div>
    </div>
</Section>

<Section Spacing="SectionSpacing.None" Bg="Color.FillSubtle" id="reserve">
    <div class="site-pricing-col site-pricing-founding">
        <div>
            <Heading Level="2" Wrap="TextWrap.Balance" Class="site-pricing-founding-title">The founding price</Heading>
            <TextBlock Color="Color.Muted">
                Pro launches at $199 a year per developer instead of $299. If you renew each year, you keep paying $199 for as long as you have Pro, even after the price goes up. The founding price is available while the Pro catalog fills out and ends when the catalog is complete.
            </TextBlock>
            <TextBlock Color="Color.Muted">
                Reserving includes Pro as a preview, free until Pro goes on sale: sign in to your account with the address you reserve and run <Code>izzy login</Code>. The preview ends at launch unless you buy Pro, and the code you generated stays yours.
            </TextBlock>
        </div>
        <Card Size="ControlSize.Lg">
            @if (_reserved is not null)
            {
                <Alert Status="Status.Success" Title="Reserved.">We’ll email @_reserved when Pro goes on sale and hold the $199 price for you.</Alert>
            }
            else
            {
                <Form Model="Model" FormName="reserve" Honeypot OnValidSubmit="Reserve" OnSpam="Caught" NativeValidation="false" RequiredMark="RequiredMark.None" Gap="3">
                    @if (_failed)
                    {
                        <Alert Status="Status.Danger">We couldn’t save your reservation. Try again in a few minutes.</Alert>
                    }
                    <TextField @bind-Value="Model!.Email" Label="Email address" Type="TextFieldType.Email" AutoComplete="email" Placeholder="you@example.com" />
                    <Button Submit Size="ControlSize.Lg" FullWidth>Reserve the founding price</Button>
                    <p class="site-pricing-note">Reserving is free, and you won’t pay anything until Pro goes on sale.</p>
                </Form>
            }
        </Card>
    </div>
</Section>

<Section Spacing="SectionSpacing.None">
    <div class="site-pricing-col site-pricing-make">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-pricing-h2">What you can make</Heading>
        <table class="site-pricing-table">
            <caption class="ib-visually-hidden">What each level lets you make</caption>
            <thead>
                <tr>
                    <th scope="col"><span class="ib-visually-hidden">Item</span></th>
                    <th scope="col">Open</th>
                    <th scope="col">Free account</th>
                    <th scope="col">Pro</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Makes)
                {
                    <tr>
                        <th scope="row">@row.Item</th>
                        @Cell("Open", row.Open)
                        @Cell("Free account", row.Free)
                        @Cell("Pro", row.Pro)
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="site-pricing-col site-pricing-enterprise">
        <div>
            <div>
                <Heading Level="2" Class="site-pricing-enterprise-title">Enterprise</Heading>
                <p>For teams that need guaranteed support response times, accessibility conformance reports or long-term support releases.</p>
            </div>
            <Button Href="mailto:support@izzyblazor.com?subject=IzzyBlazor%20Enterprise" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Contact us</Button>
        </div>
    </div>
</Section>

<Section Spacing="SectionSpacing.None" Class="site-pricing-band">
    <div class="site-pricing-col site-pricing-questions">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-pricing-h2">Questions people ask</Heading>
        <div>
            @foreach (var (question, answer) in Questions)
            {
                <div>
                    <Heading Level="3" Size="TextSize.Md">@question</Heading>
                    <p>@answer</p>
                </div>
            }
        </div>
    </div>
</Section>

<Section Class="site-band site-story">
    <div class="site-close">
        <Heading Level="2" Wrap="TextWrap.Balance" Class="site-h2">Spend your days on features</Heading>
        <TextBlock Color="Color.Muted">Let Pro handle the scaffolding, the fixes and the upgrades, so your time goes to your app.</TextBlock>
        <Button Href="pricing#reserve" Size="ControlSize.Lg">Reserve the founding price</Button>
    </div>
</Section>

@code {
    private static readonly StoryPoints.Point[] Stakes =
    [
        new(Lucide.Copy, "Pages repeat for every model", "Each model needs a list, a detail page and a form, and wiring each one up by hand takes an afternoon."),
        new(Lucide.CircleArrowUp, "Upgrades take careful work", "Every library upgrade means finding what changed and updating your code by hand, one file at a time."),
        new(Lucide.Accessibility, "Accessibility fixes take time", "An audit tells you what’s wrong. Tracing each problem to the component behind it and fixing it by hand is the slow part."),
    ];

    private static readonly StoryPoints.Point[] Value =
    [
        new(Lucide.AppWindow, "See each page before you add it", "Change a block’s or page’s settings and watch a preview update in your IDE. Then review every file Pro will add or edit before it touches your project."),
        new(Lucide.Layers, "Get every page, variant and kit", "Get list, detail and form pages for any model, plus every variant of every block and every app kit."),
        new(Lucide.Accessibility, "Find and fix accessibility problems", "Audit the whole site in one run, see each problem traced to its component, and preview the fix before you apply it."),
        new(Lucide.RefreshCw, "Upgrade without surprises", "izzy upgrade finds every place your app uses something a release renamed or removed, and shows you each change for review before it’s applied."),
        new(Lucide.Bot, "Your coding agent can use it too", "Pro adds skills that take an agent through an upgrade, an accessibility fix or a migration from start to finish, with the tools you use."),
        new(Lucide.FileCode, "The code stays yours", "Everything Pro generates lives in your project and keeps working if you stop paying."),
    ];

    // Before Pro is on sale: reserve, buy at launch, generate.
    private static readonly StorySteps.Step[] Plan =
    [
        new("Reserve the founding price", "It takes your email address and nothing else. Reserving is free."),
        new("Buy Pro at launch", "We’ll email you when Pro goes on sale, with $199 a year held for you."),
        new("Generate from your IDE", "Sign in once on each machine, then create pages from the IDE or the CLI.", "izzy login"),
    ];

    private const string Yes = "yes", No = "no";

    // Each level: who it's for, its price and unit, the line under the price, its action and the line under
    // that, and what it adds.
    private static readonly Level[] Levels =
    [
        new("open", "Open", "For every Blazor project.", "$0", ["forever", "no account"], null,
            "Get started", "docs/get-started/create-app", "dotnet new starter-blazor", true, false, null,
            [
                "Every component, under the MIT license",
                "The docs, plus the docs MCP server for coding agents",
                "The IzzyBlazor App starter, with dotnet new",
                "A grid page for any model, with izzy add crud",
                "Docs and pictures for every template and block",
                "Inline docs and previews in the IDE plugins",
            ]),
        new("free", "Free account", "For starting real apps faster.", "$0", ["forever", "free account"], null,
            "Create free account", AccountService.SignIn, "Code is generated on your machine, offline.", false, true, "Everything in Open, plus:",
            [
                "Six app starters, from a sidebar app to a docs site",
                "15 page blocks, including hero, pricing and FAQ sections",
                "Izzy CRM, a complete sample app to build on",
            ]),
        new("pro", "Pro", "For building faster and maintaining with confidence.", "$199", ["a year", "per developer"], "Instead of $299, for as long as you renew.",
            "Reserve the founding price", "pricing#reserve", "It’s free, and you pay nothing until launch.", false, false, "Everything in the free account, plus:",
            [
                "All blocks",
                "All app kits",
                "CRUD as full list, detail and form pages",
                "Safe upgrades, with every change shown for review",
                "Live previews, quick fixes and upgrade reviews in your IDE",
                "Edit any component’s options from a side panel in your IDE",
                "The accessibility audit for your whole site in one run",
                "Agent skills for upgrades, accessibility fixes and migrations",
            ]),
    ];

    // A row of the table: "yes" draws a check, "no" a dash, anything else is the cell's words.
    private static readonly Make[] Makes =
    [
        new("Every component", Yes, Yes, Yes),
        new("Docs, and the docs MCP for coding agents", Yes, Yes, Yes),
        new("IzzyBlazor App, the base starter", Yes, Yes, Yes),
        new("CRUD pages (izzy add crud)", "A grid page", "A grid page", "List, detail and form pages"),
        new("App-shell starters", No, "6", "All"),
        new("Blocks", No, "15", "All"),
        new("App kits", No, "Izzy CRM", "All"),
        new("Safe upgrades (izzy upgrade)", No, No, Yes),
        new("IDE plugins: inline docs and previews", Yes, Yes, Yes),
        new("Generate and customize with the CLI", Yes, Yes, Yes),
        new("Generate and customize with the IDE", "Open items", "Free items", "Everything"),
        new("Component inspector in the IDE", No, "View options", "View and edit"),
        new("Coding agents (izzy mcp)", No, "Free items", "Everything"),
        new("Accessibility audit", "One page", "One page, with verdicts", "The whole site"),
    ];

    private static readonly (string Question, string Answer)[] Questions =
    [
        ("Are the components really free?", "Yes. Every component is open source under the MIT license, and you can use them in any project, including commercial ones. You don’t need an account or a key, and there are no limits now or later."),
        ("Why does a free account need an email?", "The account is how izzy knows you can generate starters and blocks, so it doesn’t have to ask every time. You can sign in with a link we email you or with your Microsoft or GitHub account. There are no passwords, and from Microsoft or GitHub we only read your name, email address and avatar."),
        ("What do you do with my email?", "We use it to run your account: to sign you in and, if you buy Pro, to bill you. We only send product news if you ask for it, and you can turn it off at any time. We never sell or share your address."),
        ("Does generated code need a license to run?", "No. izzy writes the code into your project, and it belongs to you. Nothing checks a license when it builds or runs, and the code never contacts us."),
        ("Can I use it offline?", "Yes. Once you’ve run izzy login, starters and blocks are generated on your own machine without a connection. The components themselves never need one."),
        ("What happens to my code if I stop paying?", "Nothing happens to it. The code you’ve generated is yours and keeps working. You stop getting new Pro items and izzy upgrade, and you keep your free account."),
        ("Is it per developer or per project?", "Per developer. One Pro key covers every project you build, at work and at home."),
        ("Can my company buy several?", "Yes. You can buy a key for each developer in a single order. If you need an invoice or have ten or more developers, contact us."),
    ];

    [SupplyParameterFromForm(FormName = "reserve")]
    private Reservation? Model { get; set; }

    // The address that was just reserved: the form's answer, and the Pro card's.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The account service's cookie says this browser is signed in: the free account is its plan.
    private bool SignedIn => AccountService.SignedIn(HttpContext?.Request) is not null;

    private string? _reserved;
    private bool _failed;

    protected override void OnInitialized() => Model ??= new();

    private async Task Reserve()
    {
        var email = Model!.Email!.Trim();
        if (Limit.Allow(HttpContext) && await Account.ReserveAsync(email)) _reserved = email;
        else _failed = true;
    }

    // A caught bot gets a person's answer, and nothing is saved.
    private void Caught() => _reserved = Model!.Email?.Trim();

    // A level's cell: on a phone the level's name sits above it (site.css reads data-level).
    private static RenderFragment Cell(string level, string value) => value switch
    {
        Yes => @<td data-level="@level"><Icon Name="Lucide.Check" Class="site-pricing-yes" /><span class="ib-visually-hidden">Included</span></td>,
        No => @<td data-level="@level"><Icon Name="Lucide.Minus" Class="site-pricing-no" /><span class="ib-visually-hidden">Not included</span></td>,
        _ => @<td data-level="@level">@value</td>,
    };

    private sealed record Level(string Id, string Name, string For, string Price, string[] Unit, string? PriceNote,
        string Action, string Href, string Note, bool NoteIsCode, bool Pick, string? Includes, string[] Items);

    private sealed record Make(string Item, string Open, string Free, string Pro);

    public sealed class Reservation
    {
        [Required(ErrorMessage = "Enter an email address, like name@example.com."), EmailAddress(ErrorMessage = "Enter an email address, like name@example.com."), StringLength(254)]
        public string? Email { get; set; }
    }
}
