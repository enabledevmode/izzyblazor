@* The top of a component's pages, the same on each: breadcrumb, name with tier and version, the
   summary, and Overview · API · Demos as links. *@

<Stack Gap="4" Class="site-pagehead">
    <Breadcrumb>
        <BreadcrumbItem Href="docs">Docs</BreadcrumbItem>
        <BreadcrumbItem Href="docs/components">Components</BreadcrumbItem>
        <BreadcrumbItem Href="@($"docs/components#{ApiMetadata.Anchor(Component.Category).Replace(' ', '-')}")">@Component.Category</BreadcrumbItem>
        @if (Topic is not null)
        {
            <BreadcrumbItem Href="@Registry.OverviewHref(Component)">@Component.Name</BreadcrumbItem>
        }
    </Breadcrumb>
    <Row Gap="3" Align="Align.Center" Wrap>
        <Pictogram Name="@Component.Icon" Size="ControlSize.Lg" />
        <Heading Level="1" Size="TextSize.Xl3">@(Topic?.Title ?? Component.Name)</Heading>
        @if (Component.Preview)
        {
            <Badge Variant="BadgeVariant.Outline">Preview</Badge>
        }
        @if (ApiComponent is not null)
        {
            @* Only Pro is marked: nearly everything is free, so "Free" would say nothing. *@
            @if (ApiComponent.Tier == "Pro")
            {
                <Badge Accent="Accent.Primary" Variant="BadgeVariant.Solid">Pro</Badge>
            }
            @if (ApiComponent.AddedIn is { } added)
            {
                <Badge Variant="BadgeVariant.Outline">Since @added</Badge>
            }
        }
    </Row>
    @* The registry's one-line summary, the same on every tab, so switching between Overview and
       API changes only what's below. A generated Overview shows the doc comment's fuller summary
       in its body. *@
    <div class="site-lead">@(Topic?.Summary ?? Component.Summary)</div>
    @* A topic's own: its page and the API it's about. *@
    <Tabs Label="@($"{Topic?.Title ?? Component.Name} pages")">
        <TabLink Href="@(Topic is null ? Registry.OverviewHref(Component) : Registry.TopicHref(Component, Topic))" Label="Overview" Match="NavLinkMatch.All" />
        <TabLink Href="@(Topic is { Members.Count: > 0 } ? Registry.TopicApiHref(Component, Topic) : Registry.ApiPageHref(Component))" Label="API" Match="NavLinkMatch.All" />
        @if (Component.Scenarios.Count > 0)
        {
            <TabLink Href="@Registry.DemosHref(Component)" Label="Demos" />
        }
    </Tabs>
</Stack>

@code {
    [Parameter, EditorRequired] public RegistryComponent Component { get; set; } = null!;

    [Parameter] public ApiComponent? ApiComponent { get; set; }

    /// <summary>On a topic's page: it takes the name's and summary's place, and the breadcrumb leads back to the component.</summary>
    [Parameter] public RegistryTopic? Topic { get; set; }
}
