@inject Registry Registry
@inject ExampleCatalog Catalog

@*
    One example, three ways. Each mode is a frame of /frame/{example}:

      Off     the static page in an iframe sandboxed without allow-scripts, so the browser really
              runs no script in it;
      Static  the static page, with IzzyBlazor's script;
      Live    the example in an interactive render mode (Blazor Server), loaded only when shown
              and in view, so a page of examples doesn't open a circuit for each.

    The page picks the mode, not each example: one ModeSwitch per page (the right column on docs
    pages; this viewer's own row with ModeSwitch, for a page that is one example), and CSS shows
    each viewer's frame for the checked mode, so it works with no script.

    Above the box is one row: Preview · Code tabs at the left (a line Tabs: radios and CSS), and at
    the right the example's note for the mode where it has one, and the width and mode switches
    where asked for (on a page that is one example, the note goes under the box). The box itself
    holds only the preview, or the code: it fits what it shows, and the controls above it don't
    move when that changes. With SourceOpen (demos) there are no tabs: the code shows under the
    preview, with a Hide code toggle in the row. site.js sizes each frame to its content; without
    script the frames keep the example's height from components.json.
*@

@if (_example is not null)
{
    <section class="@_class" data-ex="@_example.Id" aria-label="@($"Example: {Title}")">
        @if (SourceOpen || _source is null)
        {
            @if (!HideTitle)
            {
                <span class="ex-title">@Title</span>
            }
            <div class="ex-panels">
                @Preview
                @if (_source is not null)
                {
                    @Source
                }
            </div>
        }
        else
        {
            <Tabs Label="@($"{Title}: preview or code")" Size="ControlSize.Sm" ContentPadding="0" Class="ex-tabs">
                <Tab Label="Preview" Value="preview">@Preview</Tab>
                <Tab Label="Code" Value="code">@Source</Tab>
            </Tabs>
        }
        <div class="ex-tools">
            @if (_example.Modes.Count == 1)
            {
                @* Shown in its one mode whatever the page's (an example of Live-only behavior). *@
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-fixed-mode">Always @ModeChip.Name(_example.Modes[0])</TextBlock>
            }
            @if (!ModeSwitch)
            {
                @Notes
            }
            @if (SourceOpen && _source is not null)
            {
                @* Demos show the code under the preview; this hides it. It sits above both, so hiding
                   the code doesn't move it. *@
                <label class="ex-code-toggle">
                    <input type="checkbox" class="ex-code-input" checked />
                    <Icon Name="Lucide.CodeXml" />
                    <span class="ex-code-hide">Hide code</span>
                    <span class="ex-code-show">Show code</span>
                </label>
            }
            @if (WidthSwitch)
            {
                <fieldset class="ex-widths">
                    <legend class="ib-visually-hidden">Preview width</legend>
                    <label title="Desktop width"><input type="radio" name="@($"{_uid}-width")" value="desktop" checked /><Icon Name="Lucide.Monitor" /><span class="ib-visually-hidden">Desktop</span></label>
                    <label title="Phone width"><input type="radio" name="@($"{_uid}-width")" value="phone" /><Icon Name="Lucide.Smartphone" /><span class="ib-visually-hidden">Phone</span></label>
                </fieldset>
            }
            @if (ModeSwitch)
            {
                <IzzyBlazor.Site.Components.Parts.ModeSwitch Placement="example" Compact />
            }
        </div>
        @if (ModeSwitch)
        {
            @* Beside the mode switch the row has no room: the note goes under the box. *@
            <div class="ex-below">@Notes</div>
        }
    </section>
}

@code {
    /// <summary>The example's id in components.json, such as <c>button-variants</c>.</summary>
    [Parameter, EditorRequired] public string Example { get; set; } = "";

    /// <summary>
    /// Shows the example in this scheme ("light" or "dark") whatever the page's, for a viewer on a
    /// band of its own scheme, such as the home page's dark hero.
    /// </summary>
    [Parameter] public string? Scheme { get; set; }

    /// <summary>
    /// Puts the example on the site's near-black page color rather than the library's background,
    /// for a viewer on a band of its own, such as the home page's Ink hero: darker than the band, so
    /// the window reads as set into it.
    /// </summary>
    [Parameter] public bool Deep { get; set; }

    /// <summary>
    /// Leaves the title out of the bar, for an example under a heading that already names it. Screen
    /// readers still hear it, from the section's label.
    /// </summary>
    [Parameter] public bool HideTitle { get; set; }

    /// <summary>Shows the code under the preview, with no Preview · Code tabs, as on demos.</summary>
    [Parameter] public bool SourceOpen { get; set; }

    /// <summary>Adds a Desktop/Phone width switch, for demo scenarios.</summary>
    [Parameter] public bool WidthSwitch { get; set; }

    /// <summary>
    /// Puts the page's mode switch in this viewer's strip, for a page that is this one example (a
    /// demo, the home page's hero). Elsewhere the page has its own.
    /// </summary>
    [Parameter] public bool ModeSwitch { get; set; }

    /// <summary>Lines of the source to highlight, such as <c>"3-5"</c>.</summary>
    [Parameter] public string? HighlightLines { get; set; }

    private RegistryExample? _example;
    private (string FileName, string Source)? _source;
    private string _class = "";
    private string _height = "";
    private string _uid = "";

    private string Title => _example!.Title;

    protected override void OnParametersSet()
    {
        if (Registry.Example(Example) is not { } found)
        {
            throw new InvalidOperationException($"No example \"{Example}\" in components.json.");
        }

        if (Catalog.TypeOf(Example) is null)
        {
            throw new InvalidOperationException($"Example \"{Example}\" is in components.json but has no Examples/.../*.razor file.");
        }

        _example = found.Example;
        _source = Catalog.SourceOf(Example);
        _class = (_example.Page ? "ex ex-page" : "ex") + (_example.Modes.Count == 1 ? " ex-fixed" : "");
        _height = $"height: {_example.Height}px";
        _uid = $"ex-{Example}";
    }

    private string Src(string mode) =>
        $"frame/{Example}?mode={mode}" + (Scheme is "light" or "dark" ? $"&scheme={Scheme}" : "") + (Deep ? "&bg=deep" : "");

    // A note shows only where the example has its own, for a mode that changes what it does: a note
    // on every example would say the same thing a page over.
    private string? NoteFor(string mode) => _example!.Notes.TryGetValue(mode, out var note) ? note : null;

    // The box with a frame per mode; CSS shows the page's mode.
    private RenderFragment Preview => __builder =>
    {
        <div class="ex-box ex-stage">
            @foreach (var mode in _example!.Modes)
            {
                <div class="ex-mode" data-mode="@mode">
                    @if (mode == "off")
                    {
                        <iframe class="ex-frame" src="@Src(mode)" sandbox="allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation" loading="lazy"
                                title="@($"{Title}, JavaScript off")" style="@_height"></iframe>
                    }
                    else if (mode == "static")
                    {
                        <iframe class="ex-frame" src="@Src(mode)" loading="lazy" title="@($"{Title}, static page")" style="@_height"></iframe>
                    }
                    else
                    {
                        <iframe class="ex-frame ex-frame-live" data-src="@Src(mode)" title="@($"{Title}, interactive page")" style="@_height"></iframe>
                        <div class="ex-needs-js" style="@_height">
                            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">
                                Live examples run over a Blazor Server connection, which needs JavaScript. Turn it on to try this one.
                            </TextBlock>
                        </div>
                    }
                </div>
            }
        </div>
    };

    private RenderFragment Source => __builder =>
    {
        <div class="ex-box ex-source">
            <Code Block Language="razor" Title="@_source!.Value.FileName" HighlightLines="@HighlightLines" MaxHeight="Length.Rem(32)">@_source.Value.Source</Code>
        </div>
    };

    // The example's own note for each mode it has one for; CSS shows the current mode's.
    private RenderFragment Notes => __builder =>
    {
        @foreach (var mode in _example!.Modes)
        {
            @if (NoteFor(mode) is { } note)
            {
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-note" data-mode="@mode">@note</TextBlock>
            }
        }
    };
}
