@inject Registry Registry
@inject ExampleCatalog Catalog
@inject NavigationManager Navigation

@*
    One example, in the page's mode (ModeSwitch), rendered into the page itself:

      Static       rendered with the page, which has IzzyBlazor's script;
      Interactive  an interactive island (Blazor Server), prerendered with the page;
      no script    (hidden) the page sends no Blazor and no IzzyBlazor script, and reads the
                   library's stylesheet as JavaScript off would (App, NoScriptCss).

    So an example arrives with the page at its own size: nothing to measure, nothing that moves.
    An example pinned to one mode (components.json "modes") shows in it whatever the page's; a
    Interactive-only one on a no-script page, which has no Blazor, shows a link to the page as Interactive instead.

    A demo scenario (components.json "page") is a page of its own, sized by the window: it shows in
    a frame of /frame/{example} at a fixed height, scrolling inside like a window, with a phone
    width when WidthSwitch is on. no-script frame are sandboxed without allow-scripts.

    Around the preview: one row (Preview · Code tabs at the left; "Always Interactive" and any width or
    mode switch at the right), the box, then the example's note for its mode. With SourceOpen
    (demos) there are no tabs: the code shows under the preview, with a Hide code toggle.

    The preview is a CodeExample with no source: it keeps the example's headings out of the page's
    "On this page". A nested IzzyTheme gives it the library's default accent inside the site's
    monochrome chrome.
*@

@if (_example is not null)
{
    <section class="@_class" id="@_uid" data-ex="@_example.Id" aria-label="@($"Example: {Title}")">
        @if (SourceOpen || _source is null)
        {
            <span class="ex-title">@Title</span>
        }
        @* Before the preview in reading order ("Always Interactive", the switches); the grid puts it at the
           right of the row. *@
        <div class="ex-tools">
            @if (_example.Modes.Count == 1)
            {
                @* Shown in its one mode whatever the page's (an example of Interactive-only behavior). *@
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-fixed-mode">Always @ModeChip.Name(_example.Modes[0])</TextBlock>
            }
            @if (SourceOpen && _source is not null)
            {
                @* Demos show the code under the preview; this hides it. It sits above both, so hiding
                   the code doesn't move it. *@
                @* One name for screen readers, "Show code", checked while it shows; the visible text
                   says what clicking does. *@
                <label class="ex-code-toggle">
                    <input type="checkbox" class="ex-code-input" checked aria-label="Show code" />
                    <Icon Name="Lucide.CodeXml" />
                    <span class="ex-code-hide" aria-hidden="true">Hide code</span>
                    <span class="ex-code-show" aria-hidden="true">Show code</span>
                </label>
            }
            @if (WidthSwitch)
            {
                <fieldset class="ex-widths">
                    <legend class="ib-visually-hidden">Preview width</legend>
                    <label title="Desktop width"><input type="radio" name="@($"{_uid}-width")" value="desktop" checked /><Icon Name="Lucide.Monitor" /><span class="ib-visually-hidden">Desktop</span></label>
                    <label title="Phone width"><input type="radio" name="@($"{_uid}-width")" value="phone" /><Icon Name="Lucide.Smartphone" /><span class="ib-visually-hidden">Phone</span></label>
                </fieldset>
            }
            @if (ModeSwitch)
            {
                <IzzyBlazor.Site.Components.Parts.ModeSwitch Placement="example" Compact />
            }
        </div>
        @if (SourceOpen || _source is null)
        {
            <div class="ex-panels">
                @Preview
                @if (_source is not null)
                {
                    @Source
                }
            </div>
        }
        else
        {
            <Tabs Label="@($"{Title}: preview or code")" Size="ControlSize.Sm" ContentPadding="0" Class="ex-tabs">
                <Tab Label="Preview" Value="preview">@Preview</Tab>
                <Tab Label="Code" Value="code">@Source</Tab>
            </Tabs>
        }
        @if (Note is not null)
        {
            @* Under the box, labeled with its mode, so it reads as what that mode does here. *@
            <div class="ex-below">@Notes</div>
        }
    </section>
}

@code {
    /// <summary>The example's id in components.json, such as <c>button-variants</c>.</summary>
    [Parameter, EditorRequired] public string Example { get; set; } = "";

    /// <summary>
    /// Shows the example in this scheme ("light" or "dark") whatever the page's, for a viewer on a
    /// band of its own scheme, such as the home page's dark hero. Not for demos, whose frame follows
    /// the page.
    /// </summary>
    [Parameter] public string? Scheme { get; set; }

    /// <summary>
    /// Puts the example on the site's near-black page color rather than the library's background,
    /// for a viewer on a band of its own, such as the home page's Ink hero: darker than the band, so
    /// the window reads as set into it.
    /// </summary>
    [Parameter] public bool Deep { get; set; }

    /// <summary>Shows the code under the preview, with no Preview · Code tabs, as on demos.</summary>
    [Parameter] public bool SourceOpen { get; set; }

    /// <summary>Adds a Desktop/Phone width switch, for demo scenarios.</summary>
    [Parameter] public bool WidthSwitch { get; set; }

    /// <summary>
    /// Puts the page's mode switch in this viewer's row, for a page that is this one example (a
    /// demo, the home page's hero). Elsewhere the page has its own.
    /// </summary>
    [Parameter] public bool ModeSwitch { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>Lines of the source to highlight, such as <c>"3-5"</c>.</summary>
    [Parameter] public string? HighlightLines { get; set; }

    private RegistryExample? _example;
    private (string FileName, string Source)? _source;
    private Type? _type;
    private string _class = "";
    private string _uid = "";
    private string _pageMode = "static";
    private string _mode = "static";

    private string Title => _example!.Title;

    protected override void OnParametersSet()
    {
        if (Registry.Example(Example) is not { } found)
        {
            throw new InvalidOperationException($"No example \"{Example}\" in components.json.");
        }

        _type = Catalog.TypeOf(Example)
            ?? throw new InvalidOperationException($"Example \"{Example}\" is in components.json but has no Examples/.../*.razor file.");
        _example = found.Example;
        _source = Catalog.SourceOf(Example);
        _class = (_example.Page ? "ex ex-page" : "ex") + (_example.Modes.Count == 1 ? " ex-fixed" : "") + (Deep ? " ex-deep" : "");
        _uid = $"ex-{Example}";
        // A page with the switch shows its mode (?mode=, then the cookie); any other page, Static.
        _pageMode = FollowsModeSwitchAttribute.PageMode(HttpContext, Registry);
        // The page's mode where the example has it, else its own (one pinned to Interactive, say).
        _mode = _example.Modes.Contains(_pageMode) ? _pageMode : _example.StartMode;
    }

    // A no-script page runs no Blazor, so a Interactive-only example can't run on it.
    private bool NeedsLivePage => _mode == "interactive" && _pageMode == "noscript" && !_example!.Page;

    private IzzyBlazor.ColorScheme? FixedScheme => Scheme switch
    {
        "light" => IzzyBlazor.ColorScheme.Light,
        "dark" => IzzyBlazor.ColorScheme.Dark,
        _ => null,
    };

    private string Src => $"frame/{Example}?mode={_mode}";

    // A note shows only where the example has its own, for a mode that changes what it does: a note
    // on every example would say the same thing a page over.
    private string? Note => !NeedsLivePage && _example!.Notes.TryGetValue(_mode, out var note) ? note : null;

    private RenderFragment Preview => __builder =>
    {
        @if (_example!.Page)
        {
            @* A page of its own: a window onto it, a fixed height that scrolls inside. *@
            <div class="ex-box ex-stage ex-window">
                @if (_mode == "noscript")
                {
                    <iframe class="ex-frame" src="@Src" sandbox="allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation"
                            title="@($"{Title}, JavaScript off")" style="@($"height: {_example.Height}px")"></iframe>
                }
                else
                {
                    <iframe class="ex-frame" src="@Src" title="@($"{Title}, {(_mode == "interactive" ? "interactive page" : "static page")}")" style="@($"height: {_example.Height}px")"></iframe>
                }
            </div>
        }
        else if (NeedsLivePage)
        {
            <div class="ex-box ex-stage ex-needs-live">
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">
                    This example runs C# over a Blazor Server connection, which a no-script page doesn't have.
                    <Anchor Href="@Navigation.GetUriWithQueryParameter("mode", "interactive")">Show this page as Interactive</Anchor>
                </TextBlock>
            </div>
        }
        else
        {
            <IzzyTheme Brand="blue" ColorScheme="FixedScheme" Class="ex-theme">
                <CodeExample Center Class="ex-box ex-stage">
                    @if (_mode == "interactive")
                    {
                        @* Keyed by the example: enhanced navigation would otherwise keep the last page's island in
                           this place, showing its example until this one rendered over it. *@
                        <IzzyBlazor.Site.Frame.ExampleHost @key="Example" ExampleId="@Example" @rendermode="InteractiveServer" />
                    }
                    else
                    {
                        <DynamicComponent Type="_type" />
                    }
                </CodeExample>
            </IzzyTheme>
        }
    };

    private RenderFragment Source => __builder =>
    {
        <div class="ex-box ex-source">
            <Code Block Language="razor" Title="@_source!.Value.FileName" HighlightLines="@HighlightLines" MaxHeight="Length.Rem(32)">@_source.Value.Source</Code>
        </div>
    };

    // The example's own note for its mode, labeled with the mode.
    private RenderFragment Notes => __builder =>
    {
        @if (Note is { } note)
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-note"><span class="ex-note-mode">@ModeChip.Name(_mode)<span class="ib-visually-hidden">:</span></span> @note</TextBlock>
        }
    };
}
