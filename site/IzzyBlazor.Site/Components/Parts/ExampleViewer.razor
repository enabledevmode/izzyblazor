@inject Registry Registry
@inject ExampleCatalog Catalog
@inject NavigationManager Navigation

@*
    One example, in the page's mode (ModeSwitch), rendered into the page itself:

      Static       rendered with the page, which has IzzyBlazor's script;
      Interactive  an interactive island (Blazor Server), prerendered with the page;
      no script    (hidden) the page sends no Blazor and no IzzyBlazor script, and reads the
                   library's stylesheet as JavaScript off would (App, NoScriptCss).

    So an example arrives with the page at its own size: nothing to measure, nothing that moves.
    An example pinned to one mode (components.json "modes") shows in it whatever the page's; a
    Interactive-only one on a no-script page, which has no Blazor, shows a link to the page as Interactive instead.

    A page example (components.json "page"), such as an AppShell's, is a page of its own, sized by
    the window: it shows in a frame of /frame/{example} at a fixed height, scrolling inside like a
    window, with a phone width when WidthSwitch is on. no-script frames are sandboxed without allow-scripts.

    Around the preview: one row (Preview · Code tabs at the left; "Always Interactive" or the mode it
    runs in, and any width switch, at the right), the box, then the example's note for its mode. An example with no
    source has no tabs.

    The preview is a CodeExample with no source: it keeps the example's headings out of the page's
    "On this page". A ThemeScope gives it the library's default accent inside the site's
    monochrome chrome.
*@

@if (_example is not null)
{
    <section class="@_class" id="@_uid" data-ex="@_example.Id" data-page-mode="@_pageMode" aria-label="@($"Example: {Title}")">
        @if (_source is null)
        {
            <span class="ex-title">@Title</span>
        }
        @* Before the preview in reading order ("Always Interactive" or the mode, the width switch); the grid puts it at the
           right of the row. *@
        <div class="ex-tools">
            @if (_example.Modes.Count == 1)
            {
                @* Shown in its one mode whatever the page's (an example of Interactive-only behavior). *@
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-fixed-mode">Always @ModeChip.Name(_example.Modes[0])</TextBlock>
            }
            else
            {
                @* How this preview runs: the mode picked in the header. *@
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-mode">@ModeChip.Name(_mode)</TextBlock>
            }
            @if (WidthSwitch || _example.WidthSwitch)
            {
                @* Links, with the choice in the address (?phone=), so it stays through the example's own
                   links, such as a grid row's button on a static page, and works with no script. *@
                <nav class="ex-widths" aria-label="@($"Preview width: {Title}")">
                    <a href="@WidthHref(false)" title="Desktop width" aria-current="@(_phone ? null : "true")"><Icon Name="Lucide.Monitor" /><span class="ib-visually-hidden">Desktop</span></a>
                    <a href="@WidthHref(true)" title="Phone width" aria-current="@(_phone ? "true" : null)"><Icon Name="Lucide.Smartphone" /><span class="ib-visually-hidden">Phone</span></a>
                </nav>
            }
        </div>
        @if (_source is null)
        {
            <div class="ex-panels">
                @Preview
            </div>
        }
        else
        {
            <Tabs Label="@($"{Title}: preview or code")" Size="ControlSize.Sm" ContentPadding="0" Class="ex-tabs">
                <Tab Label="Preview" Value="preview">@Preview</Tab>
                <Tab Label="Code" Value="code">@Source</Tab>
            </Tabs>
        }
        @if (Note is not null || _cli is not null)
        {
            @* Under the box: the note, labeled with its mode, so it reads as what that mode does here; and on a
               component's own page, the command that puts its usage example on a page of the reader's app. *@
            <div class="ex-below">
                @Notes
                @if (_cli is not null)
                {
                    <div class="ex-cli">
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Add this example to a page with the <Anchor Href="docs/tools/components">izzy CLI</Anchor>:</TextBlock>
                        <Code Block Language="bash">@_cli</Code>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    /// <summary>The example's id in components.json, such as <c>button-variants</c>.</summary>
    [Parameter, EditorRequired] public string Example { get; set; } = "";

    /// <summary>Adds a Desktop/Phone width switch, for page examples. An example can ask for one in components.json.</summary>
    [Parameter] public bool WidthSwitch { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    /// <summary>Lines of the source to highlight, such as <c>"3-5"</c>.</summary>
    [Parameter] public string? HighlightLines { get; set; }

    private RegistryExample? _example;
    private (string FileName, string Source)? _source;
    private Type? _type;
    private string _class = "";
    private string _uid = "";
    private string _pageMode = "static";
    private string _mode = "static";
    private bool _phone;
    private List<string> _phones = [];

    // The command for a component's usage example, on that component's own page.
    private string? _cli;

    // The address with this example at a phone's width or not; the others keep theirs.
    private string WidthHref(bool phone)
    {
        var list = _phones.Where(p => p != Example).ToList();
        if (phone)
        {
            list.Add(Example);
        }

        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["phone"] = list.Count == 0 ? null : list.ToArray() });
        return $"{uri}#{_uid}";
    }

    private string Title => _example!.Title;

    protected override void OnParametersSet()
    {
        if (Registry.Example(Example) is not { } found)
        {
            throw new InvalidOperationException($"No example \"{Example}\" in components.json.");
        }

        _type = Catalog.TypeOf(Example)
            ?? throw new InvalidOperationException($"Example \"{Example}\" is in components.json but has no Examples/.../*.razor file.");
        _example = found.Example;
        _cli = Example == $"{found.Component.Id}-usage" && Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/') == Registry.OverviewHref(found.Component)
            ? $"izzy add component {found.Component.Name} --at <file>:<line>"
            : null;
        _source = Catalog.SourceOf(Example);
        _phones = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query).TryGetValue("phone", out var phones) ? phones.OfType<string>().ToList() : [];
        _phone = (WidthSwitch || _example.WidthSwitch) && _phones.Contains(Example);
        _class = (_example.Page ? "ex ex-page" : "ex") + (_example.Modes.Count == 1 ? " ex-fixed" : "") + (_phone ? " ex-phone" : "");
        _uid = $"ex-{Example}";
        // A page with the switch shows its mode (?mode=, then the cookie); any other page, Static.
        _pageMode = FollowsModeSwitchAttribute.PageMode(HttpContext, Registry);
        // The page's mode where the example has it, else its own (one pinned to Interactive, say).
        _mode = _example.Modes.Contains(_pageMode) ? _pageMode : _example.StartMode;
    }

    // A no-script page runs no Blazor, so a Interactive-only example can't run on it.
    private bool NeedsLivePage => _mode == "interactive" && _pageMode == "noscript" && !_example!.Page;

    private string Src => $"frame/{Example}?mode={_mode}";

    // A note shows only where the example has its own, for a mode that changes what it does: a note
    // on every example would say the same thing a page over.
    private string? Note => !NeedsLivePage && _example!.Notes.TryGetValue(_mode, out var note) ? note : null;

    private RenderFragment Preview => __builder =>
    {
        @if (_example!.Page)
        {
            @* A page of its own: a window onto it, a fixed height that scrolls inside. *@
            <div class="ex-box ex-stage ex-window">
                @if (_mode == "noscript")
                {
                    <iframe class="ex-frame" src="@Src" sandbox="allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-top-navigation-by-user-activation"
                            title="@($"{Title}, JavaScript off")" style="@($"height: {_example.Height}px")"></iframe>
                }
                else
                {
                    <iframe class="ex-frame" src="@Src" title="@($"{Title}, {(_mode == "interactive" ? "interactive page" : "static page")}")" style="@($"height: {_example.Height}px")"></iframe>
                }
            </div>
        }
        else if (NeedsLivePage)
        {
            <div class="ex-box ex-stage ex-needs-live">
                <TextBlock Size="TextSize.Sm" Color="Color.Muted" Align="TextAlign.Center">
                    This example runs C# over a Blazor Server connection, which a no-script page doesn't have.
                    <Anchor Href="@Navigation.GetUriWithQueryParameter("mode", "interactive")">Show this page as Interactive</Anchor>
                </TextBlock>
            </div>
        }
        else
        {
            @* The library's own grays (Neutral, its default), not the site's: an example shows what an app gets. *@
            <ThemeScope Brand="blue" Gray="neutral" Class="ex-theme">
                <CodeExample Center Class="ex-box ex-stage">
                    @if (_mode == "interactive")
                    {
                        @* Keyed by the example: enhanced navigation would otherwise keep the last page's island in
                           this place, showing its example until this one rendered over it. *@
                        <IzzyBlazor.Site.Frame.ExampleHost @key="Example" ExampleId="@Example" @rendermode="InteractiveServer" />
                    }
                    else
                    {
                        <DynamicComponent Type="_type" />
                    }
                </CodeExample>
            </ThemeScope>
        }
    };

    private RenderFragment Source => __builder =>
    {
        <div class="ex-box ex-source">
            @if (Catalog.FilesOf(Example) is { Count: > 0 } files)
            {
                <Tabs Label="Source files" Size="ControlSize.Sm" ContentPadding="0" Class="ib-example-files">
                    <Tab Label="@_source!.Value.FileName">
                        <Code Block Language="razor" HighlightLines="@HighlightLines" MaxHeight="Length.Rem(32)">@_source.Value.Source</Code>
                    </Tab>
                    @foreach (var file in files)
                    {
                        <Tab Label="@file.FileName">
                            <Code Block Language="csharp" MaxHeight="Length.Rem(32)">@file.Source</Code>
                        </Tab>
                    }
                </Tabs>
            }
            else
            {
                <Code Block Language="razor" Title="@_source!.Value.FileName" HighlightLines="@HighlightLines" MaxHeight="Length.Rem(32)">@_source.Value.Source</Code>
            }
        </div>
    };

    // The example's own note for its mode, labeled with the mode.
    private RenderFragment Notes => __builder =>
    {
        @if (Note is { } note)
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="ex-note"><Badge Size="BadgeSize.Sm" Variant="BadgeVariant.Outline" Class="ex-note-mode">@ModeChip.Name(_mode)<span class="ib-visually-hidden">:</span></Badge> @note</TextBlock>
        }
    };
}
