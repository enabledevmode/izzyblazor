@inject Registry Registry
@inject ApiMetadata Api

@* An Overview's See also section, from the doc comment's See also: each documented component
   linked to its Overview with its components.json summary, a part to its place on its owner's
   API page with its doc summary, then a link to each of the component's demos and the troubleshooting articles about it. Nothing when
   there's nothing to list. *@

@if (_entries.Count > 0 || Component.Scenarios.Count > 0 || TroubleshootingLinks.Any(Component.Name))
{
    <Heading Level="2">See also</Heading>
    <List Gap="2">
        @foreach (var (name, href, text) in _entries)
        {
            <ListItem>
                @if (href is not null)
                {
                    <Anchor Href="@href">@name</Anchor>
                }
                else
                {
                    <Code>@name</Code>
                }
                @if (text is not null)
                {
                    <text>: @text</text>
                }
            </ListItem>
        }
        @if (Component.Scenarios.Count > 0)
        {
            <ListItem>
                Demos:
                @for (var i = 0; i < Component.Scenarios.Count; i++)
                {
                    var scenario = Component.Scenarios[i];
                    <Anchor Href="@Registry.ScenarioHref(Component, scenario)">@scenario.Title</Anchor>@(i < Component.Scenarios.Count - 1 ? ", " : ".")
                }
            </ListItem>
        }
        <TroubleshootingLinks Component="@Component.Name" />
    </List>
}

@code {
    [Parameter, EditorRequired] public RegistryComponent Component { get; set; } = null!;

    [Parameter, EditorRequired] public ApiComponent ApiComponent { get; set; } = null!;

    private List<(string Name, string? Href, string? Text)> _entries = [];

    protected override void OnParametersSet() =>
        _entries = (ApiComponent.SeeAlso ?? []).Where(n => n != Component.Name).Select(Entry).ToList();

    private (string, string?, string?) Entry(string name)
    {
        if (Registry.ByName(name) is { } component)
        {
            return (name, Registry.OverviewHref(component), OverviewText.Lower(Api, component.Summary));
        }

        var summary = Api.Component(name)?.Summary;
        return (name, Registry.ApiHref(name, null), summary is null ? null : OverviewText.Lower(Api, OverviewText.FirstSentence(summary)));
    }
}
