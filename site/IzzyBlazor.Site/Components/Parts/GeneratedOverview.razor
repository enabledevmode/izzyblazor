@inject ApiMetadata Api
@inject Registry Registry

@* The Overview of a component without a hand-written one, built from its doc comment and
   components.json in the order CONTRIBUTING's "Writing an Overview" gives: the summary, Usage (the
   doc comment's example, then the {id}-usage example), the topics, a section per other registered
   example, the remarks, the parts, then Mode support, Accessibility, Keyboard, Parameters and See
   also. A section with nothing to show is left out. *@

@* A chart opens with when to use it; its doc comment's summary, which says what it draws, is on the API page. *@
@if (Component.Use is { } use)
{
    <TextBlock><InlineCode Text="@use" /></TextBlock>
}
else if (ApiComponent.Summary is not null)
{
    <DocHtml Html="@ApiComponent.Summary" Context="_prose" Size="ProseSize.Md" />
}

@if (ApiComponent.Examples is { Count: > 0 } usage)
{
    <Heading Level="2">Usage</Heading>
    @foreach (var snippet in usage)
    {
        <Code Block Language="razor">@snippet</Code>
    }
}

@if (_usage is not null)
{
    @Section(_usage)
}

@if (Component.Topics.Count > 0)
{
    <Heading Level="2">Topics</Heading>
    <OverviewTopics Component="Component" />
}

@foreach (var example in Component.Examples.Where(e => e != _usage))
{
    @Section(example)
}

@if (ApiComponent.Remarks is not null)
{
    <Heading Level="2">Details</Heading>
    <DocHtml Html="@ApiComponent.Remarks" Context="_prose" Size="ProseSize.Md" />
}

@if (OverviewParts.Of(Component, Api).Count > 0)
{
    <Heading Level="2">Parts</Heading>
}
<OverviewParts Component="Component" />

<Heading Level="2">Mode support</Heading>
@if (ApiComponent.Modes is null && Component.Features.Count == 0)
{
    <TextBlock Color="Color.Muted">Not recorded yet for @Component.DisplayName.</TextBlock>
}
else
{
    <ModeSupportTable Component="Component" ApiComponent="ApiComponent" />
}

@if (ApiComponent.Accessibility is not null || ApiComponent.Keyboard is { Count: > 0 })
{
    <Heading Level="2">Accessibility</Heading>
    @if (ApiComponent.Accessibility is not null)
    {
        <DocHtml Html="@ApiComponent.Accessibility" Context="_prose" Size="ProseSize.Md" />
    }
    @KeyboardTable.Section(ApiComponent)
}

<Heading Level="2">Parameters</Heading>
<ParameterTable ApiComponent="ApiComponent" ApiHref="@Registry.ApiPageHref(Component)" Context="Context" Compact />

<OverviewSeeAlso Component="Component" ApiComponent="ApiComponent" />

@code {
    [Parameter, EditorRequired] public RegistryComponent Component { get; set; } = null!;

    [Parameter, EditorRequired] public ApiComponent ApiComponent { get; set; } = null!;

    [Parameter, EditorRequired] public ApiPageContext Context { get; set; } = null!;

    private ApiPageContext _prose = null!;

    // The {id}-usage example opens the page, ahead of the topics.
    private RegistryExample? _usage;

    protected override void OnParametersSet()
    {
        _prose = Context with { Overview = true };
        _usage = Component.Examples.FirstOrDefault() is { } first && first.Id == $"{Component.Id}-usage" ? first : null;
    }

    private static RenderFragment Section(RegistryExample example) => @<text>
        <Heading Level="2">@example.Title</Heading>
        @if (example.Lead is { } lead)
        {
            <TextBlock><InlineCode Text="@lead" /></TextBlock>
        }
        @if (example.Info is { } info)
        {
            <Alert Status="Status.Info" Title="@info.Title"><InlineCode Text="@info.Text" /></Alert>
        }
        <ExampleViewer Example="@example.Id" />
        @foreach (var paragraph in example.After)
        {
            <TextBlock><InlineCode Text="@paragraph" /></TextBlock>
        }
    </text>;
}
