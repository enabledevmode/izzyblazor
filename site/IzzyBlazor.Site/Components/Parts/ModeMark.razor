@* A table cell's mark for one mode: a check where it works, a dash where it partly does, and nothing
   where it doesn't (an empty cell reads as "no", with less clutter). Screen readers hear the word. *@

@if (Level == ModeLevel.None)
{
    <span class="ib-visually-hidden">No</span>
}
else
{
    <span class="@($"site-mark site-mark-{_kind}")" title="@_word">
        <IzzyBlazor.Icon Name="_icon" /><span class="ib-visually-hidden">@_word</span>
    </span>
}

@code {
    [Parameter] public ModeLevel Level { get; set; }

    private IconData _icon;
    private string _kind = "";
    private string _word = "";

    protected override void OnParametersSet() => (_icon, _kind, _word) = Level == ModeLevel.Partial
        ? (Lucide.Minus, "partly", "Partly")
        : (Lucide.Check, "yes", "Yes");
}
