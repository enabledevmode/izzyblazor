@* A component's or member's mode support, from its [ModeSupport], as one label shown only when
   it's limited in one of the two modes: "Interactive only" (needs a circuit or WebAssembly),
   "Static: partly", and so on. Works in both says nothing; what the plain HTML does with no script
   is the fallback, not a mode, and is in the Overview's Mode support section. With a Subject, the
   label is about that part of the member, as in "@bind: Interactive only". *@

@if (Label is { } label)
{
    @if (Compact && Short(label) is { } brief)
    {
        @* A dense list (the components index): the short form shows, the full one is read. *@
        <Badge Size="BadgeSize.Sm" Variant="BadgeVariant.Outline" Class="site-modes" title="@(Modes!.Notes ?? label)"><span aria-hidden="true">@brief</span><span class="ib-visually-hidden">@label</span></Badge>
    }
    else
    {
        <Badge Size="BadgeSize.Sm" Variant="BadgeVariant.Outline" Class="site-modes" title="@(Modes!.Notes ?? label)">@(Subject is null ? label : $"{Subject}: {label}")</Badge>
    }
}

@code {
    [Parameter] public ApiModes? Modes { get; set; }

    /// <summary>What the label is about when it isn't the whole member, such as <c>@bind</c>.</summary>
    [Parameter] public string? Subject { get; set; }

    /// <summary>Shows "Interactive" for "Interactive only", for dense lists.</summary>
    [Parameter] public bool Compact { get; set; }

    private static string? Short(string label) => label == "Interactive only" ? "Interactive" : null;

    private string? Label
    {
        get
        {
            if (Modes is null)
            {
                return null;
            }

            var (inStatic, inInteractive) = (ModeChip.Parse(Modes.Static), ModeChip.Parse(Modes.Interactive));
            if (inStatic == ModeLevel.Full && inInteractive == ModeLevel.Full)
            {
                return null;
            }

            if (inStatic == ModeLevel.None && inInteractive == ModeLevel.Full)
            {
                return "Interactive only";
            }

            if (inInteractive == ModeLevel.None && inStatic == ModeLevel.Full)
            {
                return "Static only";
            }

            // "Static: partly", "Interactive: partly", or both limited.
            var text = string.Join("; ", new[] { ("Static", inStatic), ("Interactive", inInteractive) }
                .Where(m => m.Item2 != ModeLevel.Full)
                .Select(m => $"{m.Item1}: {(m.Item2 == ModeLevel.Partial ? "partly" : "no")}"));
            return text;
        }
    }
}
