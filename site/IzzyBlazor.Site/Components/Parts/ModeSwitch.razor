@inject NavigationManager Navigation

@*
    The site's Static · Interactive choice: how every page's examples run. It's a site preference,
    so it sits in the docs header beside the color-scheme switch, as a menu whose button shows the
    current mode; on phones it's a segmented pair of links at the top of the drawer. Both are links
    that load the page again in that mode, the current one marked; site.js keeps the place on the
    page. Every example renders in the page's mode (ExampleViewer) and says which at the end of its
    row.

    A third mode, no script (?mode=noscript: neither Blazor's nor IzzyBlazor's script), isn't
    offered: it's how every page looks before its scripts run, kept for checking the fallback, and
    shows as a choice only while it's the mode.

    The mode comes from ?mode=, then the "site-mode" cookie, then Static. The server stores ?mode=
    in the cookie (SiteApp), so the next page opens in the same mode, with JavaScript off too, and
    an example's own links and forms, which drop ?mode= from the address, keep it.

    No-script pages run no Blazor (App), so a link into or out of one is a full page load: enhanced
    navigation would patch the no-script page into a page that's still running script.
*@

<div class="@($"site-modeswitch site-modeswitch-{Placement}")">
    @if (Placement == "drawer")
    {
        @* The nav is named "Examples run" too, so the visible label isn't read twice. *@
        <span class="site-modeswitch-label" aria-hidden="true">Examples run</span>
        <TabNav Label="Examples run" Variant="TabsVariant.Segmented" Size="ControlSize.Sm" FullWidth Class="site-modeswitch-options">
            @foreach (var mode in Choices)
            {
                <TabLink Href="@Href(mode)" Label="@ModeChip.Name(mode)" Current="@(mode == _mode)"
                         data-mode="@mode" data-enhance-nav="@EnhanceNav(mode)" />
            }
        </TabNav>
    }
    else
    {
        <Menu Placement="IzzyBlazor.Placement.BottomEnd" PanelWidth="Length.Rem(21)">
            <Trigger>
                @* "Static" alone says nothing out of context: the name is "Examples: Static". *@
                <Button Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" StartIcon="@Icon(_mode)" EndIcon="Lucide.ChevronDown" @attributes="context">
                    <VisuallyHidden>Examples: </VisuallyHidden>@ModeChip.Name(_mode)
                </Button>
            </Trigger>
            <ChildContent>
                <MenuRadioGroup Label="Examples run" Value="@_mode">
                    @foreach (var mode in Choices)
                    {
                        <MenuItem Value="@mode" Href="@Href(mode)" Icon="@Icon(mode)" data-mode="@mode" data-enhance-nav="@EnhanceNav(mode)">
                            <Stack Gap="0">
                                <span>@ModeChip.Name(mode)</span>
                                <TextBlock Size="TextSize.Xs" Color="Color.Muted">@Meaning(mode)</TextBlock>
                            </Stack>
                        </MenuItem>
                    }
                </MenuRadioGroup>
            </ChildContent>
        </Menu>
    }
</div>

@code {
    /// <summary>Every mode a page can be in, the hidden no-script one too.</summary>
    public static readonly string[] Modes = ["static", "interactive", "noscript"];

    /// <summary>The modes the switch offers.</summary>
    public static readonly string[] Offered = ["static", "interactive"];

    /// <summary>The cookie that remembers the mode.</summary>
    public const string Cookie = "site-mode";

    /// <summary>Where it sits: <c>header</c> (a menu) or <c>drawer</c> (the phone drawer's pair of links).</summary>
    [Parameter] public string Placement { get; set; } = "header";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string _mode = "static";

    protected override void OnInitialized() => _mode = Current(Navigation, HttpContext);

    private IEnumerable<string> Choices => Offered.Concat(_mode == "noscript" ? ["noscript"] : []);

    private string? EnhanceNav(string mode) => mode == "noscript" || _mode == "noscript" ? "false" : null;

    private static IconData Icon(string mode) => mode switch
    {
        "noscript" => Lucide.Code,
        "interactive" => Lucide.Zap,
        _ => Lucide.FileText,
    };

    // The same page in that mode, keeping the rest of its address (an example's ?q=, say).
    private string Href(string mode) => Navigation.GetUriWithQueryParameter("mode", mode);

    /// <summary>The page's mode: <c>?mode=</c>, then the cookie, then Static.</summary>
    public static string Current(NavigationManager navigation, HttpContext? context)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(navigation.Uri).Query);
        if (query.TryGetValue("mode", out var value) && Modes.Contains(value.ToString()))
        {
            return value.ToString();
        }

        return Current(context);
    }

    /// <summary>The mode from a request alone: <c>?mode=</c>, then the cookie, then Static.</summary>
    public static string Current(HttpContext? context)
    {
        if (context?.Request.Query["mode"].ToString() is { } linked && Modes.Contains(linked))
        {
            return linked;
        }

        return context?.Request.Cookies[Cookie] is { } cookie && Modes.Contains(cookie) ? cookie : "static";
    }

    private static string Meaning(string mode) => mode switch
    {
        "noscript" => "The HTML and CSS on their own, no script.",
        "interactive" => "C# runs over a Blazor Server connection.",
        _ => "Rendered on the server, no connection.",
    };
}
