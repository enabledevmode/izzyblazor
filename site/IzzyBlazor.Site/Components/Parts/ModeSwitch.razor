@inject NavigationManager Navigation

@*
    The page's Off · Static · Live switch: three links that load the page in that mode, the current
    one marked. Every example on the page renders in the page's mode (ExampleViewer), so picking
    another loads the page again in it; site.js keeps the scroll position.

    A component page has two copies, the right column's on wide screens and one at the top of the
    content on narrow ones. A page that is one example (demos, the home hero, the docs overview)
    has one copy, in the example's row.

    The mode comes from ?mode=, then the "site-mode" cookie, then Static. The server stores ?mode=
    in the cookie (SiteApp), so the next page opens in the same mode, with JavaScript off too, and
    an example's own links and forms, which drop ?mode= from the address, keep it.

    Off pages run no Blazor (App), so the link into Off is a full page load: enhanced navigation
    would patch the Off page into a page that's still running script.
*@

<div class="@($"site-modeswitch site-modeswitch-{Placement}")">
    @if (!Compact)
    {
        <span class="site-modeswitch-label" id="@_labelId">Examples run</span>
    }
    <nav class="site-modeswitch-options" aria-labelledby="@(Compact ? null : _labelId)" aria-label="@(Compact ? "Examples run" : null)">
        @foreach (var mode in Modes)
        {
            <a class="site-modeswitch-option site-mode-link" href="@Href(mode)" aria-current="@(mode == _mode ? "true" : null)"
               data-mode="@mode" data-enhance-nav="@(mode == "off" || _mode == "off" ? "false" : null)">@ModeChip.Name(mode)</a>
        }
    </nav>
    @if (!Compact)
    {
        <TextBlock Size="TextSize.Sm" Color="Color.Muted" Class="site-modeswitch-text">@Meaning(_mode)</TextBlock>
    }
</div>

@code {
    public static readonly string[] Modes = ["off", "static", "live"];

    /// <summary>The docs layout's right-column section a component page puts its switch in.</summary>
    public const string AsideSection = "site-mode-aside";

    /// <summary>The cookie that remembers the mode.</summary>
    public const string Cookie = "site-mode";

    /// <summary>Where it sits, for CSS: <c>aside</c> (wide screens), <c>top</c> (narrow) or <c>example</c>.</summary>
    [Parameter] public string Placement { get; set; } = "top";

    /// <summary>Only the three options, for an example's own row.</summary>
    [Parameter] public bool Compact { get; set; }

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private readonly string _labelId = $"site-modes-{Guid.NewGuid():N}"[..20];
    private string _mode = "static";

    protected override void OnInitialized() => _mode = Current(Navigation, HttpContext);

    // The same page in that mode, keeping the rest of its address (an example's ?q=, say).
    private string Href(string mode) => Navigation.GetUriWithQueryParameter("mode", mode);

    /// <summary>The page's mode: <c>?mode=</c>, then the cookie, then Static.</summary>
    public static string Current(NavigationManager navigation, HttpContext? context)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(navigation.Uri).Query);
        if (query.TryGetValue("mode", out var value) && Modes.Contains(value.ToString()))
        {
            return value.ToString();
        }

        return Current(context);
    }

    /// <summary>The mode from a request alone: <c>?mode=</c>, then the cookie, then Static.</summary>
    public static string Current(HttpContext? context)
    {
        if (context?.Request.Query["mode"].ToString() is { } linked && Modes.Contains(linked))
        {
            return linked;
        }

        return context?.Request.Cookies[Cookie] is { } cookie && Modes.Contains(cookie) ? cookie : "static";
    }

    private static string Meaning(string mode) => mode switch
    {
        "off" => "JavaScript off: what the HTML and CSS do on their own.",
        "live" => "An interactive page: C# runs over a Blazor Server connection.",
        _ => "A static page with IzzyBlazor's script. No circuit.",
    };
}
