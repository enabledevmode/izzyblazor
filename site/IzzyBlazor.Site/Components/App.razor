<!DOCTYPE html>
<html lang="en" class="@(IsFrame ? null : "site")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.ico" sizes="48x48" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#14161A" />
    <meta property="og:image" content="@($"{Navigation.BaseUri}og-image.png")" />
    <meta property="og:site_name" content="IzzyBlazor" />
    <meta name="twitter:card" content="summary_large_image" />
    @* An Off page reads the library's stylesheet as JavaScript off would (NoScriptCss). *@
    <link rel="stylesheet" href="@(OffPage ? NoScript.Href : Assets[NoScriptCss.LibraryPath])" />
    <link rel="stylesheet" href="@Assets["site.css"]" />
    @* The site's chrome is Ink (monochrome): the brand's Ember is kept for brand moments (the logo,
       the hero, its call to action, the pictograms), and examples keep the component default (Blue:
       ExampleViewer's nested IzzyTheme, and a demo's frame), so the examples are the docs' only
       colored accent and show what the library gives. *@
    <IzzyTheme Brand="@(IsFrame ? null : "ink")" />
    @if (Blazor)
    {
        <ImportMap />
    }
    <HeadOutlet />
    @if (!IsFrame)
    {
        @* Before the page is parsed: an example whose link or form loaded this page again
           (site.js) gets a scroll margin of where it was on the screen, so the browser's jump to
           its #id puts it back there rather than at the top. *@
        <script>try{var r=JSON.parse(sessionStorage.getItem("site-return")||"null");if(r&&r.path===location.pathname&&Date.now()-r.at<15000&&typeof r.top==="number"&&location.hash==="#"+r.id)document.documentElement.style.setProperty("--site-return-top",r.top+"px")}catch(e){}</script>
    }
</head>

<body>
    <Routes />
    @if (OffPage)
    {
        @* site.js reloads a page that enhanced navigation patched in from a page running Blazor. *@
        <div hidden data-site-off></div>
    }
    @if (Blazor)
    {
        <ReconnectDialog />
        <script src="_framework/blazor.web.js"></script>
    }
    @if (!OffFrame)
    {
        <script src="@Assets["site.js"]"></script>
    }
</body>

</html>

@inject NavigationManager Navigation
@inject NoScriptCss NoScript
@inject Registry Registry

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool IsFrame => HttpContext?.Request.Path.StartsWithSegments("/frame") == true;

    // A demo's frame in Off mode sends no script at all: the frame is sandboxed without
    // allow-scripts anyway, and leaving the tags out keeps the console quiet.
    private bool OffFrame => IsFrame && HttpContext?.Request.Query["mode"].ToString() == "off";

    // A page in Off mode renders its examples in the page with no Blazor and no IzzyBlazor script,
    // so they do what the HTML and CSS do on their own. The site's own script still runs (it never
    // touches an example), and the stylesheet's scripting rules apply as with JavaScript off. Only
    // a page with the mode switch ([FollowsModeSwitch]) is ever Off.
    private bool OffPage => !IsFrame && FollowsModeSwitchAttribute.PageMode(HttpContext, Registry) == "off";

    private bool Blazor => !OffFrame && !OffPage;
}
