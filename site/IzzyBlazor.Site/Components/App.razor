<!DOCTYPE html>
<html lang="en" data-ib-color-scheme="@FrameScheme" class="@(IsFrame ? (Deep ? "frame-deep" : null) : "site")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.ico" sizes="48x48" />
    <link rel="icon" href="favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <meta name="theme-color" content="#14161A" />
    <meta property="og:image" content="@($"{Navigation.BaseUri}og-image.png")" />
    <meta property="og:site_name" content="IzzyBlazor" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="stylesheet" href="@Assets["_content/IzzyBlazor.Core/izzyblazor.css"]" />
    <link rel="stylesheet" href="@Assets["site.css"]" />
    @* The site's chrome takes the brand's Ember; example frames keep the component default (Blue),
       so readers see what the library gives them. IzzyTheme derives contrast-checked shades. *@
    <IzzyTheme Brand="@(IsFrame ? null : "#F26A1B")" />
    @if (Scripts)
    {
        <ImportMap />
    }
    <HeadOutlet />
</head>

<body>
    <Routes />
    @if (Scripts)
    {
        <script src="_framework/blazor.web.js"></script>
        <script src="@Assets["site.js"]"></script>
    }
</body>

</html>

@inject NavigationManager Navigation

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private bool IsFrame => HttpContext?.Request.Path.StartsWithSegments("/frame") == true;

    // An example frame on the site's near-black (?bg=deep), for the hero's viewer.
    private bool Deep => IsFrame && HttpContext?.Request.Query["bg"].ToString() == "deep";

    private string? FrameScheme =>
        HttpContext?.Request.Path.StartsWithSegments("/frame") == true && HttpContext.Request.Query["scheme"].ToString() is "light" or "dark"
            ? HttpContext.Request.Query["scheme"].ToString()
            : null;

    // An example frame in Off mode sends no script at all: the frame is sandboxed without
    // allow-scripts anyway, and leaving the tags out keeps the console quiet.
    private bool Scripts =>
        !(HttpContext?.Request.Path.StartsWithSegments("/frame") == true && HttpContext.Request.Query["mode"] == "off");
}
