      "examples": [
        { "id": "spacer-app-bar", "title": "In a row", "lead": "Put a `Spacer` between groups in a `Row` to push everything after it to the end, here the header's buttons." },
        { "id": "spacer-plans", "title": "In a column", "lead": "In a `Column` it takes the free height instead, so both buttons sit at the bottom of their cards however long the text above them." }
      ]
    },
    {
      "id": "aspect-ratio", "icon": "Ratio", "name": "AspectRatio", "category": "Layout", "summary": "Keeps media at a shape, 16:9 by default.",
      "examples": [
        { "id": "aspect-ratio-shapes", "title": "Shapes", "lead": "Use `Ratio` for the shape, width over height: the same picture at 16:9 (the default), 1:1 and 4:5, cropped to fill each." }
      ]
    },
    {
      "id": "divider", "icon": "SeparatorHorizontal", "name": "Divider", "category": "Layout", "summary": "A line: plain, dashed, labeled or vertical.",
      "examples": [
        { "id": "divider-receipt", "title": "Plain and dashed", "lead": "A `Divider` is an `hr` line; set `Dashed` for a lighter break, as before the total." },
        { "id": "divider-labeled", "title": "With a label", "lead": "Use `Label` to put text in the middle of the line, such as `or` between two ways to sign in." },
        { "id": "divider-vertical", "title": "Vertical", "lead": "Set `Orientation=\"Orientation.Vertical\"` for a separator between items in a `Row`; it takes the row's height." }
      ]
