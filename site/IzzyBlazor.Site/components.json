      "id": "gauge", "icon": "Gauge", "name": "Gauge", "category": "Charts", "summary": "Shows a value on a dial between a start and an end, with the value in the middle.", "parts": ["GaugeBand"], "keywords": ["meter", "dial", "speedometer", "radial progress"],
