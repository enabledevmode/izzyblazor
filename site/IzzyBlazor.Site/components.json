    {
      "id": "scheduler", "icon": "CalendarDays", "name": "Scheduler", "category": "Data", "parts": ["SchedulerToday", "SchedulerArrows", "SchedulerPeriod", "SchedulerCategories", "SchedulerViews", "SchedulerNew"], "summary": "Shows appointments in a day, a week, a month or a list, drawn on the server, with its view and date in the page's address.", "keywords": ["scheduler", "calendar", "event calendar", "appointments", "bookings", "week view", "month view", "agenda"],
      "features": [
        { "feature": "Day, week, work week, month and agenda views" },
        { "feature": "All-day and several-day appointments as bars across their days" },
        { "feature": "Overlapping appointments side by side" },
        { "feature": "The view and date in the page's address, so the toolbar is links and Back works" },
        { "feature": "Adding, editing and deleting in a form, on a static page too", "member": "OnSave" },
        { "feature": "A click on empty time to add, and dragging to move or resize", "member": "OnSave", "noscript": "none" },
        { "feature": "Categories with colors, shown or hidden from a menu", "member": "Category" },
        { "feature": "A detail after each title, such as where; times in the boxes with ShowTime", "member": "Detail" },
        { "feature": "A form of your own in the edit dialog", "member": "EditDialogForm" },
        { "feature": "A card about each appointment when there's no form" },
        { "feature": "Going to any date from the period's title" },
        { "feature": "Only the days shown read: an IQueryable in the database, or an ItemsProvider", "member": "ItemsProvider" },
        { "feature": "The view and date bindable on interactive pages", "member": "ViewChanged" },
        { "feature": "Templates for appointments and for each day's header", "member": "AppointmentTemplate" },
        { "feature": "Your own toolbar items, and the toolbar's parts placed among them", "member": "ToolbarContent" },
        { "feature": "A card on hover, as Outlook's", "noscript": "none" },
        { "feature": "Google Calendar's keyboard shortcuts", "member": "Shortcuts", "noscript": "none" }
      ],
      "examples": [
        { "id": "scheduler-usage", "title": "Appointments and views", "lead": "Give `Scheduler` the `Items` and how to read each one's `Start`, `End` and `Title`. `AllDay`, `Color` and `Detail` are optional.",
          "after": ["`Detail` goes under the title, here the room, or after it in a short box. The boxes leave out their times, since the hours beside them say when; `ShowTime` adds them.", "Overlapping appointments sit side by side, and those a day long or more are bars across their days. The toolbar's arrows, Today and view menu are links, with the view and date in the page's address, so Back goes back.", "The day and week views open scrolled to `DayStart`, 8:00 by default. The period's title opens a month to go to any date.", "With no form, selecting an appointment opens a card beside it with its whole time, `Detail`, category and `Description`. It's a popover, so it works without script too."] },
        { "id": "scheduler-booking", "title": "Adding and editing", "lead": "To add and change appointments, give an `ItemKey` and handle `OnSave`. Each booking opens a form, and New or a click on empty time adds one.",
          "after": ["`OnSave` gets the form's values and the booking, none for a new one. `CopyTo` sets the mapped properties, and `AddError` keeps the form open with a message. `OnDelete` adds a Delete button, which asks first.", "The form has a field for each mapping: All day with `AllDay`, which hides the times, a Category choice with `Category`, here the room, and a description with `Description`.", "Drag a booking to move it, or its bottom edge to change its end, by quarter hours. The form posts on a static page too, so it all works without a circuit."],
          "notes": { "noscript": "Bookings open the form and save as with script; a click on empty time and dragging don't." } },
        { "id": "scheduler-family", "title": "Categories and colors", "lead": "To color appointments by what they are, map `Category` and pass `Categories`, a `SchedulerCategory` for each kind. The Categories menu shows or hides each.",
          "after": ["`Categories` is a list, so it can come from your data: `kinds.Select(k => new SchedulerCategory(k.Id, k.Name, k.Color))`.", "An appointment's own `Color` comes first, then its category's, then the palette's. A month's day shows `MonthLimit` lines, bars and \"+N more\" included, and \"+N more\" opens the day."] },
        { "id": "scheduler-own-form", "title": "A form of your own", "lead": "For what a use case needs, such as a patient and a reason, give an `EditDialogForm`: your form in the Scheduler's dialog, which it opens and closes as before.",
          "after": ["The context has the appointment (none for a new one) and its times (the time clicked, for a new one). Call `CloseAsync` when your form has saved: the dialog closes, the days shown load again, and focus goes back to the appointment.", "The form, its model and its `[SupplyParameterFromForm]` are yours. On a static page, so is guarding against forged fields: a model that holds only what the form edits.", "Dragging to new times still saves through `OnSave`. A form without times leaves it out, so moving stays something a keyboard can do; this one has the date and time."] },
        { "id": "scheduler-loading", "title": "Loading by date range", "lead": "To load only the days shown, give an `ItemsProvider`: it gets a `SchedulerRequest` with the range, the view and the hidden categories, and returns the appointments in it.",
          "after": ["It's asked for each page drawn: another week or view, and after a save or a move. An exception shows \"Couldn't load the appointments.\" with Retry. While it loads on an interactive page, the appointments shown stay, and the Scheduler is `aria-busy`.", "With EF Core there's no provider to write: pass the query as `Items`, and the Scheduler filters it to the days shown in the database.", "`@bind-View` and `@bind-Date` keep the view and date in the component on an interactive page, instead of the address."] },
        { "id": "scheduler-team", "title": "Templates", "lead": "`DayHeaderTemplate` adds to each day's header after its date: here, who's out. `AppointmentTemplate` draws each appointment's text: here, marks for meetings that repeat or are private.",
          "after": ["The appointment template gets the item, the view and `OneLine`, true where there's one line: a short box, a bar, a month's row. It's drawn inside the appointment's link or button, so no links or buttons of its own.", "Screen readers hear an appointment's title, `Detail`, category and time, not the template, so `Detail` says what the marks mean. The day header's content is read, and can hold links."] },
        { "id": "scheduler-toolbar", "title": "Toolbar items", "lead": "`ToolbarContent` adds your own toolbar items. Write the Scheduler's parts there too, such as `SchedulerNew`, to place them among yours.",
          "after": ["The parts are `SchedulerToday`, `SchedulerArrows`, `SchedulerPeriod`, `SchedulerCategories`, `SchedulerViews` and `SchedulerNew`. A part you don't write keeps its place, and the Scheduler still decides whether it shows."] },
        { "id": "scheduler-agenda", "title": "Agenda view", "lead": "The agenda lists the coming days' appointments by day and leaves out empty days. `AgendaDays` sets how many it covers.",
          "after": ["`ViewOptions` limits the view menu, here to the day, the week and the agenda. With one view there's no menu."] }
      ]
    },
    {
      "id": "comment", "icon": "MessageSquareText", "name": "Comment", "category": "Display", "summary": "Shows a comment in a discussion, with who wrote it, when, and replies nested under it.", "keywords": ["comments", "discussion", "thread", "reply", "feedback", "review"],
      "examples": [
        { "id": "comment-actions", "title": "Author, time and actions", "lead": "Set `Author`, `Time` and `Text`. The avatar shows the author's initials, or a picture from `Avatar`. To add buttons such as Reply under the comment, set `Actions`." },
        { "id": "comment-replies", "title": "Replies", "lead": "To answer a comment, put `Comment`s in its `Replies`. Each level steps in by one avatar.", "after": ["To load the rest of a long thread, put a link button after the replies. As a link, it works with JavaScript off.", "`RelativeTime` shows how long ago (\"5 hours ago\") with the full date on hover, worked out when the page renders. Comments older than a week show their date."] },
