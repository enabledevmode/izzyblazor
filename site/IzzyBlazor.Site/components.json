      ],
      "examples": [
        { "id": "calendar-heatmap-usage", "title": "Commits over a year", "lead": "A calendar heatmap shows a value for each day, so weekly and seasonal patterns stand out. Give `CalendarHeatmap` the `Items`, each one's `Date` and `Value`, and a `Title`.", "after": ["The calendar runs from the first item's day to the last's; `From` and `To` set the range yourself, such as the last twelve months. Weeks start on the culture's first day, Sunday here, or `FirstDayOfWeek`.", "A day with no value is gray, not the lightest shade: an empty day isn't a zero. Here days without commits aren't in the items, so the shades start at one commit and the quiet days read as gaps. To shade zeros instead, include them.", "Point at a day, or move with the arrow keys, for its date and value."],
          "notes": { "noscript": "There are no tooltips, and the legend keys don't hide days. \"Show data\" lists every value." } },
        { "id": "calendar-heatmap-diverging", "title": "Above and below normal", "lead": "For values on either side of a meaningful middle, such as each day's temperature against the normal, set `Palette` to `ChartPalette.Diverging`. The scale turns gray at `Midpoint` (0 by default).", "after": ["Here the weeks start on Monday (`FirstDayOfWeek`). To compare years, draw one calendar per year with the same `Min` and `Max`, so their colors mean the same values."] }
