      ],
      "examples": [
        { "id": "gauge-usage", "title": "Server load in bands", "lead": "Give `Gauge` a `Value` and a `Label`. Each `GaugeBand` marks a range along the dial's edge in its `Accent`, and a value in it fills in that color.", "after": ["The dial runs from `Min` to `Max`, 0 to 1 by default, so a share reads as a percent with `ValueFormat=\"P0\"`. A gauge is 12rem wide; `Width` sets another.", "A dial alone is a number in a ring; bands give the value something to be read against. A band's `Label` shows under the value, so the color isn't the only cue."] },
        { "id": "gauge-range", "title": "Another range, and a target", "lead": "To measure on another scale, set `Min` and `Max`. `Target` marks a goal with a tick across the dial, read with the value as \"target 50\". A value past either end fills none or all of the dial, and still shows as it is." }
