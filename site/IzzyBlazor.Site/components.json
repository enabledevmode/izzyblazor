    {
      "id": "divider", "icon": "SeparatorHorizontal", "name": "Divider", "category": "Layout", "summary": "Separates content with a line: plain, dashed, labeled or vertical.", "keywords": ["separator", "rule"],
      "examples": [
        { "id": "divider-receipt", "title": "Plain and dashed", "lead": "A `Divider` is an `hr` line. For a lighter break, such as the one before the total, set `Dashed`." },
        { "id": "divider-labeled", "title": "With a label", "lead": "To put text in the middle of the line, such as `or` between two ways to sign in, set `Label`." },
        { "id": "divider-vertical", "title": "Vertical", "lead": "To separate items in a `Row`, set `Orientation=\"Orientation.Vertical\"`. The line is as tall as the row." }
      ]
