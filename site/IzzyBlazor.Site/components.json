      "topics": [
        {
          "id": "selection", "title": "Selection", "summary": "Checkboxes or a single choice. The keys post with a form or bind to C#.", "members": ["ItemKey", "SelectionMode", "Selection", "SelectionName", "Cascade", "ItemSelectable"],
          "examples": [
            { "id": "tree-view-permissions", "title": "Checkboxes", "lead": "To give each item a checkbox, set `SelectionMode` to `Multiple` and `ItemKey`. In a form the checked keys post under `SelectionName`; on an interactive page, bind them with `@bind-Selection`.", "after": ["Checking a parent checks its branch, and a parent with part of its branch checked shows a mixed box. To make each box its own, set `Cascade` to `false`.", "The selection holds every checked key, parents included."] },
            { "id": "tree-view-category", "title": "One choice", "lead": "To choose one item, set `SelectionMode` to `Single`. A click, Space or Enter selects it, and the branch holding it starts open." }
