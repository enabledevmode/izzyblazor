// The site's registry: every documented component's id (its URL), category and one-line summary,
// the parts documented on its page, and its examples and demo scenarios. Navigation, the
// Components index and cross-links read it; the API metadata (izzyblazor.api.json) supplies the
// rest. Every public component is either listed here or a part of one that is (a test checks).
//
// An example's id names its file: "button-multi-submit" is Examples/Button/MultiSubmit.razor.
{
  "categories": ["Layout", "App shell", "Typography", "Actions", "Forms", "Selection", "Overlays", "Navigation", "Feedback", "Data display"],
  "components": [
    {
      "id": "box", "icon": "Square", "name": "Box", "category": "Layout", "summary": "A plain block that takes every style prop.",
      "examples": [
        { "id": "box-borders", "title": "Bands, borders and a dashed card" },
        { "id": "box-scheme", "title": "A scheme for part of a page" },
        { "id": "box-surfaces", "title": "Surfaces", "lead": "Use `Bg` with the surface colors to raise or sink part of a page: `SurfaceRaised` for menus and popovers (with a `Shadow`), then three container fills, each a step stronger." },
        { "id": "box-contrast", "title": "Text on a color", "lead": "Set `Bg` to a theme color and the text takes its matching on-color by itself; set `Color` to choose your own, as on the soft box." },
        { "id": "box-element", "title": "Element and reading width", "lead": "Use `As` to render another element, here an `article`, and `MaxWidth=\"Length.Prose\"` to stop at a comfortable line length (68ch)." },
        { "id": "box-visibility", "title": "Showing by breakpoint", "lead": "Use `HiddenFrom` and `VisibleFrom` to swap content at a breakpoint: from Sm (640px), the button shows its label; on phones it's an icon button." }
      ]
    },
    {
      "id": "row", "icon": "Columns3", "name": "Row", "category": "Layout", "summary": "Lays its children out in a row, always.",
      "examples": [
        { "id": "row-alignment", "title": "Alignment", "lead": "Use `Align` for where children sit across the row: `Align.Center` puts the avatar, the text and the button on one center line, where the default would stretch the button to the row's height." },
        { "id": "row-distribute", "title": "Spreading out", "lead": "Use `Justify` to share the free space along the row: `Justify.Between` puts the count at the start and the buttons at the end." },
        { "id": "row-wrapping", "title": "Wrapping", "lead": "Set `Wrap` to let children flow onto more lines when they don't fit; without it they stay on one line." },
        { "id": "row-stats", "title": "Sharing the width", "lead": "Give children `Grow` and a `Basis` in a wrapping row to share the width: each stat is at least 10rem and stretches to fill its line, and one that doesn't fit wraps to the next." }
      ]
    },
    {
      "id": "column", "icon": "Rows3", "name": "Column", "category": "Layout", "summary": "Lays its children out in a column, always.",
      "examples": [
        { "id": "column-spacing", "title": "Gap", "lead": "Use `Gap` for the space between children, and nest a column for a tighter group: the plan's name and description are 4px apart (`Gap=\"1\"`), the groups 20px (`Gap=\"5\"`)." },
        { "id": "column-alignment", "title": "Alignment", "lead": "Children stretch to the column's width by default; use `Align=\"Align.Start\"` to keep each at its own width, as the button here." }
      ]
    },
    {
      "id": "stack", "icon": "Layers", "name": "Stack", "category": "Layout", "summary": "A row or a column, changing with the screen width.",
      "examples": [
        { "id": "stack-breakpoints", "title": "Direction by breakpoint", "lead": "Use `Direction` with a breakpoint map to change direction with the screen: these features sit side by side from Sm (640px), and stack in a column on phones." },
        { "id": "stack-page-header", "title": "Page header", "lead": "Give `Align` a breakpoint map too: from Sm the title and actions share a line, spread apart by `Justify.Between`; on phones they stack, with the actions under the title." }
      ]
    },
    {
      "id": "grid", "icon": "LayoutGrid", "name": "Grid", "category": "Layout", "summary": "Columns by breakpoint, by minimum width, or by template.", "parts": ["GridItem"],
      "examples": [
        { "id": "grid-breakpoints", "title": "Columns by breakpoint", "lead": "Use `Columns` with a breakpoint map for a set number of equal columns: one on phones, two from Sm (640px), and three from Lg (1024px)." },
        { "id": "grid-min-width", "title": "As many columns as fit", "lead": "Use `MinChildWidth` to fit as many columns as there's room for, each at least that wide, with no breakpoints to pick." },
        { "id": "grid-few-items", "title": "A short row", "lead": "With `MinChildWidth`, a row with fewer items keeps its empty columns so every item is the same width (top); add `Stretch` to let them fill the row (bottom)." },
        { "id": "grid-side-column", "title": "Your own column sizes", "lead": "Use `Template` for CSS column sizes per breakpoint: from Sm, a 12rem side column beside the results; on phones, one column." },
        { "id": "grid-spans", "title": "Spanning cells", "lead": "Set `ColSpan` on any child to span columns, and wrap one in a `GridItem` for `RowSpan`: from Sm the revenue card takes two columns and two rows, and the activity card spans the row with `GridSpan.Full`." }
      ]
    },
    {
      "id": "container", "icon": "RectangleHorizontal", "name": "Container", "category": "Layout", "summary": "Centers content at a readable width.",
      "examples": [
        { "id": "container-reading", "title": "Width", "lead": "Use `Size` to cap the width, from Sm (40rem) for forms and short text to Xl (80rem, the default); narrower than that it fills its parent, with 16px of side padding (24px from 768px)." }
      ]
    },
    {
      "id": "section", "icon": "PanelTop", "name": "Section", "category": "Layout", "summary": "A full-width band of a page, such as a hero.",
      "examples": [
        { "id": "section-hero", "title": "A hero", "lead": "Use `Spacing=\"SectionSpacing.Lg\"` and a `Bg` for a hero or a closing call to action (64px of padding, 96px from 768px), with a `Container` to keep its content at a readable width." },
        { "id": "section-bands", "title": "Spacing", "lead": "Use `Spacing` for a band's vertical padding: Md, the default, is 48px (64px from 768px), and Sm is 32px, for a slimmer band like this sign-up." }
      ]
    },
    {
      "id": "center", "icon": "Crosshair", "name": "Center", "category": "Layout", "summary": "Centers its content both ways.",
      "examples": [
        { "id": "center-icon-tiles", "title": "Icon tiles", "lead": "Give `Center` a `Width` and `Height` to put an icon in the middle of a square tile; `Bg` and `Radius` style the tile." },
        { "id": "center-loading", "title": "In a panel", "lead": "Give `Center` a `Height` to center content in a panel, such as a spinner while a report loads." }
      ]
    },
    {
