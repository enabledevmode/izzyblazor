    {
      "id": "data-grid", "icon": "Table2", "name": "DataGrid", "category": "Data display", "parts": ["ActionColumn", "RowAction", "EditAction", "DeleteAction", "EditField", "DataGridAdd", "DataGridSearch", "DataGridExport", "DataGridFilterBuilder", "DataGridColumnPicker"], "summary": "Displays rows of data in a grid users can sort, filter, group, edit and rearrange.", "keywords": ["data grid", "datagrid", "grid", "dynamic columns", "DataTable", "dictionary", "ExpandoObject", "column bands", "column groups", "grouped headers", "multi-column headers", "stacked headers"],
      "features": [
        { "feature": "Sort, filter and page through the URL" },
        { "feature": "Column widths and sideways scrolling, set by the server" },
        { "feature": "Frozen columns" },
        { "feature": "Grouping over all the data, a page of groups at a time", "member": "Groupable" },
        { "feature": "Aggregates over everything the filters match, in the footer and on groups" },
        { "feature": "Virtual rows on interactive pages; loading on scroll on static pages", "member": "Virtualize" },
        { "feature": "A toolbar with search, and room for your own buttons" },
        { "feature": "CSV and Excel export, streamed from an endpoint you map", "member": "ExportCsvHref" },
        { "feature": "Editing a row in a dialog, saved by a form post", "member": "EditMode" },
        { "feature": "Row menus, also opened by right-click, long press or the keyboard", "member": "ActionColumn" },
        { "feature": "Resizing, moving and hiding columns, saved per user", "member": "ResizableColumns" },
        { "feature": "Selected rows post with a form" },
        { "feature": "Shift+click sorts by several columns", "noscript": "none" },
        { "feature": "One Tab stop and arrow keys between cells, with selection keys", "noscript": "none" }
      ],
      "examples": [
        { "id": "data-grid-basic", "title": "A basic grid", "lead": "A data grid shows records as rows that the user can sort, filter and page. Set `Items` and an `ItemKey`, and add a `PropertyColumn` for each property to show.", "after": ["Add `Sortable` to a column to sort by it and `Filterable` to filter it. Set `PageSize` for the rows per page.", "The sort, filters and page are kept in the URL, so the grid works on static pages and with JavaScript off.", "For a plain list of records, use Table, which DataGrid is built on. Choose DataGrid when users edit, group or arrange columns."] },
        { "id": "data-grid-columns", "title": "Columns", "lead": "Columns share the grid's width. To give a column a fixed width, set `Width`.", "after": ["Columns without one share the remaining space, down to their `MinWidth`; below that, the grid scrolls sideways. Shift+click a header to add that column to the sort."] },
        { "id": "data-grid-appearance", "title": "Row appearance", "lead": "Stripes, lines and a shaded header make rows easier to follow. Set `Striped`, `ColumnLines` or `ShadedHeader`, or set `RowLines` to false to remove the lines between rows.", "after": ["To highlight the row under the pointer, which helps on wide rows, set `RowHover`. It's off by default, because a highlight suggests the row can be clicked. Rows with a `RowHref` always have it."] },
        { "id": "data-grid-toolbar", "title": "Toolbar and search", "lead": "The toolbar sits above the grid. To add buttons, put `ToolbarButton`s in `ToolbarContent`; to add a box that searches the text columns, set `Searchable`.", "after": ["The search is kept in the URL. While rows are selected, `SelectionActions` replaces the toolbar.", "`SelectAllMode` sets what the header checkbox selects: the current page, or every row that matches the filters."] },
        { "id": "data-grid-row-menu", "title": "Row menus", "lead": "A row menu is a ⋮ button on each row that opens the row's actions. Add an `ActionColumn` of `RowAction`s and set its `Overflow` to `RowActionOverflow.Always`.", "after": ["With IzzyBlazor's script, a right-click or a long press opens the same menu. The menu acts on the row it was opened from, whatever is selected.", "Right-clicking a link still opens the browser's own menu."] },
        { "id": "data-grid-cells", "title": "Controls in cells", "lead": "To put buttons, links or fields in cells, use a `TemplateColumn`. The keys that reach them are in the Keyboard table." },
        { "id": "data-grid-virtual-rows", "title": "Virtual rows", "lead": "Virtual rows render only the rows in view, so 100,000 rows scroll as easily as 100. Set `Virtualize`, which works on interactive pages.", "after": ["It needs a `MaxHeight`, and each row must fit one line of `RowHeight`. On static pages the same grid loads more rows as the user scrolls.", "This example is static unless you switch the page to Interactive."] },
        { "id": "data-grid-toolbar-order", "title": "Placing the toolbar's tools", "lead": "To place the grid's own tools among your buttons, add `DataGridSearch`, `DataGridExport` or `DataGridColumnPicker` to `ToolbarContent`. They appear in the order written.", "after": ["Add them directly, not inside a component of your own. A tool you don't add stays in its usual place, and the grid's parameter still turns it on.", "Export and Columns show only an icon with a tooltip. To add text to both, set `ToolbarLabels`; to add it to one, set its `ShowLabel`."] }
      ],
      "topics": [
        {
          "id": "columns", "title": "Columns", "summary": "Users resize, move, hide and freeze columns, and the grid saves their layout for the next visit.", "members": ["LayoutKey", "Layout", "LayoutSaveUrl", "ResizableColumns", "ReorderableColumns", "ColumnPicker", "DataGridColumnPicker", "Column.Title", "Column.Align", "Column.Width", "Column.MinWidth", "Column.MaxWidth", "Column.Frozen", "Column.Resizable", "Column.Reorderable", "Column.Pickable", "Column.Visible", "DynamicColumn", "ColumnBand"],
          "examples": [
            { "id": "data-grid-arrange", "title": "Rearranging columns", "lead": "To let users resize, move and hide columns, set `ResizableColumns`, `ReorderableColumns` and `ColumnPicker`. To save each user's layout, set `LayoutKey`.", "after": ["The user drags a header or its edge, or uses the keys and the ⋮ menu in each header, which also sorts, freezes, fits columns to their content and hides a column.", "The Columns button opens a list of the columns in the grid's order, with a search. Check a column to show it, and drag a row's handle, or open its menu, to move it.", "`LayoutKey` saves the layout in a cookie, per user and per page. The server renders it from the first paint.", "A column with `Visible` set to false starts hidden, and the user can show it from the picker. With `Pickable` false too, it stays hidden."] },
            { "id": "data-grid-frozen", "title": "Frozen columns", "lead": "A frozen column stays in view at the grid's start or end while the rest scroll sideways. Set `Frozen` on the column; it works with JavaScript off.", "after": ["A frozen column needs a `Width`, and sits at its edge wherever it's declared.", "With `ReorderableColumns`, users freeze columns from a header's ⋮ menu too, as with a spreadsheet's frozen panes. Freeze columns › To the left freezes every column to that column's left, and To the right every column to its right.", "Freezing again moves the line, and Unfreeze removes it. The columns don't change places."],
              "info": { "title": "When frozen columns scroll", "text": "Frozen columns scroll like the rest on a screen narrower than 640px, and when together they'd leave less than 3rem of the grid for the columns that scroll, which would leave no way to reach them. The line where frozen columns stop shows only while they stay put. Once the grid is wide enough again, they're frozen again." } },
            { "id": "data-grid-column-bands", "title": "Column bands", "lead": "A column band is a header over several columns, such as a quarter over its revenue and margin. Put the columns in a `ColumnBand` with a `Title`; a band can hold bands for another row of headers.", "after": ["Sorting, filtering and widths stay on the columns. A column outside any band has an empty cell above its header.", "Users move a column only among its band's columns, and move a band as a whole.", "A band is frozen as one: freezing any of its columns freezes all of them. Give a band's columns the same `Frozen`."] },
            { "id": "data-grid-dynamic-columns", "title": "Columns at run time", "lead": "To add columns known only at run time, such as one for each quarter in the data, write a `DynamicColumn` for each in a loop. Set `Field` to the name to read and `Type` to its values' type, such as `typeof(decimal)`.", "after": ["Rows can be dictionaries, `DataRow`s (`Items=\"table.Rows.Cast<DataRow>()\"`) or `ExpandoObject`s, so an `IEnumerable<dynamic>` works too.", "`Type` works as a property's type does for `PropertyColumn`: it picks the filter, the alignment, grouping and aggregates, and what `Format` applies to. Without a `Type`, values are text. A value that's missing, or doesn't convert, shows empty.", "The sort key in the URL is the field's letters and digits in lower case, with an underscore for anything else, so `Q1 2026` sorts as `?sort=q1_2026`.", "The columns sort, filter and search as any others, but they aren't edited."] }
          ]
        },
        {
          "id": "editing", "title": "Editing", "summary": "Users add, edit and delete rows in a dialog, in the row itself, or one cell at a time.", "members": ["EditMode", "FindItem", "NewItem", "ItemEditable", "ItemDeletable", "EditKey", "EditCopy", "OnSave", "OnDelete", "ActionColumn", "RowAction", "EditAction", "DeleteAction", "EditDialog", "EditField", "EditColumns", "EditLayout", "EditDialogSize", "EditDialogTitle", "EditDialogForm", "DataGridAdd", "Column.Editable", "Column.EditTemplate"],
          "intro": [
            "Choose a mode by what there is to edit. `DataGridEditMode.Dialog` has room for many fields, including ones the table doesn't show, and works with rows that load as they're needed. `DataGridEditMode.Row` keeps the row in place, for a few short fields.",
            "`DataGridEditMode.Cell` is the quickest way to change one value at a time, on interactive pages. Dialog and Row also work on static pages and with JavaScript off.",
            "A field shows the value itself, not what the column's `Format` makes of it: a number has no currency sign, and a date follows the browser's language, which can differ from the server's culture the column formats with."
          ],
          "examples": [
            { "id": "data-grid-editing", "title": "Editing rows", "lead": "Dialog editing opens a form in a dialog where the user adds or edits a row. Set `EditMode` to `DataGridEditMode.Dialog`, and handle `OnSave`.", "after": ["Each column, shown or not, gets a field that matches its type. To lock one, such as the key, set its `Editable` to false. A save is a form post, and only editable columns receive a value from it.", "To reject a save, call `AddError` in `OnSave`. The dialog stays open with the error on its field.", "To add an Add button, set `NewItem`. To add a Delete action that asks first, set `OnDelete`. To limit editing or deleting by row, set `ItemEditable` or `ItemDeletable`.", "To order the actions or add your own, write an `ActionColumn`.", "The grid needs an explicit `TItem`. On static pages, the row type also needs a parameterless constructor."] },
            { "id": "data-grid-edit-in-row", "title": "Editing in the row", "lead": "Row editing changes a row where it stands, with Save and Cancel in place of its actions, and suits a few short fields. Set `EditMode` to `DataGridEditMode.Row`; it works with JavaScript off.", "after": ["Only the columns shown have a field, so a hidden column keeps its value. A new row starts at the top of the page.", "Sorting or changing page ends the edit and drops what was typed. It can't be used with `Virtualize` or loading on scroll."] },
            { "id": "data-grid-edit-cells", "title": "Editing one cell at a time", "modes": ["interactive"], "lead": "Cell editing changes one value at a time, the quickest way to make small changes. Set `EditMode` to `DataGridEditMode.Cell`.", "after": ["A click, Enter, F2 or typing opens a cell. Tab, Enter or a click elsewhere saves it.", "`OnSave` runs for each cell that changed, and an invalid cell stays open. A new row is edited as with `Row`.", "Cell editing is for interactive pages. On static pages the same grid edits a row at a time, as with `Row`."] },
            { "id": "data-grid-two-columns", "title": "Laying out the edit dialog", "lead": "To lay out the edit dialog's form, set `EditColumns`, `EditLayout`, `EditDialogSize` and `EditDialogTitle`. This example uses two columns in a large dialog.", "after": ["In `EditDialog`, an `EditField` sets each field's place, `ColSpan`, `Label` and `Hint`. A column's `EditTemplate` replaces its field with your own.", "To show a disabled Delete with a tooltip instead of hiding it, set `DisabledReason` on the `DeleteAction`."] },
            { "id": "data-grid-own-form", "title": "A custom form in the dialog", "lead": "For a form that isn't fields of the row, write it in `EditDialogForm`; its context's `CloseAsync` closes the dialog once you've saved. The grid opens and closes the dialog; the form, its model and its post are yours. On static pages, guard against forged fields with a view model, as this example does." }
          ]
        },
        {
          "id": "filtering", "title": "Filtering", "summary": "Users filter each column from its header or from a filter row under the titles. A filter builder combines conditions across columns.", "members": ["Filter", "FilterCase", "FilterPanel", "FilterRow", "FilterBuilder", "FilterFromQuery", "Searchable", "Search", "SearchLabel", "DataGridSearch", "DataGridFilterBuilder", "Column.Filterable", "Column.FilterOperators", "Column.Filter", "Column.FilterValues", "Column.FilterList", "Column.FilterTemplate", "Column.FilterText"],
          "examples": [
            { "id": "data-grid-filters", "title": "Column filters", "lead": "A column filter narrows the rows by the values in one column, from a panel the filter icon in its header opens. Set `Filterable` on a column to add one.", "after": ["In the panel, the user picks an operator, such as contains or between, and enters a value.", "To limit the operators a column offers, set `FilterOperators`; the first one is the default. To list every active filter below the rows, set `FilterPanel`."],
          "notes": {
            "noscript": "Press Enter or Apply in the filter to submit it. An operator with no value is no filter.",
            "static": "A panel's changes wait for Apply or Enter, and closing it any other way drops them." } },
            { "id": "data-grid-filter-row", "title": "A row of filters", "lead": "A filter row puts a field under each filterable column's title, so the user filters without opening a panel. To add it, set `FilterRow` on the grid.", "after": ["The funnel beside each field opens the column's full filter, where the user can change the operator.", "A column that filters by a list, a range or a date shows its current value in the field. Clicking the field opens the full filter.", "To set the titles and the filter row apart from the rows, set `ShadedHeader`."],
          "notes": {
            "noscript": "Press Enter in a field to filter." } },
            { "id": "data-grid-custom-filter", "title": "A column's own filter", "lead": "To replace a column's standard filter controls with your own, put them in its `FilterTemplate`. This example offers checkboxes for a few customers and a select of minimum totals.", "after": ["Your controls appear above Clear and Apply. Spread the context's `Attributes` on each control, or `CheckboxAttributes` on a native checkbox. Its value filters the column with the column's first operator.", "Several values filter with Is any of. A library field also needs the context's `SetAsync` as its `ValueChanged`.", "To show readable text for the filter in the filter row and its tag, set `FilterText`. To decide yourself what a value matches, build the condition with the column's `Filter`."],
          "notes": {
            "noscript": "Press Apply to submit it." } },
            { "id": "data-grid-filter-builder", "title": "A filter builder", "lead": "A filter builder combines conditions across columns with and or or, such as a status of Paid or a total over 1,000, which column filters can't express. Set `FilterBuilder` to add a button that opens it. The conditions it builds apply together with the column filters, and are kept in the URL as `?filter=`.",
          "notes": { "noscript": "The button is hidden. A `?filter=` link still applies." } }
          ]
        },
        {
          "id": "aggregates", "title": "Aggregates", "summary": "Aggregates show totals, averages and counts in the footer, calculated over every row the filters match.", "members": ["Column.Aggregate", "Column.GroupAggregate", "Column.GroupFooterAggregate", "Column.AggregateBy", "Column.AggregateFormat", "Column.AggregateLabel", "Column.AggregateTemplate", "Column.FooterText", "Column.Footer"],
          "examples": [
            { "id": "data-grid-aggregates", "title": "Footer totals", "lead": "An aggregate shows a sum, average, lowest, highest or count in the footer. Set `Aggregate` on a column, or `AggregateBy` for your own, as an expression that runs in the database.", "after": ["It covers every row the filters match, not just the page, and needs no grouping. With an `ItemsProvider`, add a `GroupsProvider` to calculate the totals."] }
          ]
        },
        {
          "id": "grouping", "title": "Grouping", "summary": "Grouping puts rows under a heading row for each value of a column, with a count or total on each group.", "members": ["Groupable", "Group", "InitialGroup", "ExpandAllGroups", "ExpandedGroups", "GroupRowLimit", "GroupPanel", "ShowGroupedColumns", "GroupsProvider", "Column.Groupable", "Column.GroupBy", "Column.GroupFormat", "Column.GroupTemplate"],
          "examples": [
            { "id": "data-grid-grouping", "title": "Groups", "lead": "Grouping puts rows under a heading row for each value of a column. To offer grouping in each header's menu, set `Groupable`; to start grouped, set `InitialGroup`.", "after": ["The grouping is kept in the URL, as `?group=status`, and each group's row is a link that opens it. Grouping works on static pages and with JavaScript off.", "A page counts top-level groups, so a group is never split across pages. A group's count covers the whole group.", "To show a value on each group's row, set `GroupAggregate`. For one under an open group's rows, set `GroupFooterAggregate`.", "With an `ItemsProvider`, add a `GroupsProvider`. Rows still come from your provider, with the group's value in the filter."] }
