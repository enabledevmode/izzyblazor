        { "feature": "Months named along the top, thinning as the calendar narrows" },
        { "feature": "Days with no data told apart from zeros, and days outside the range left out" },
        { "feature": "A HeatmapChart's colors: even steps, a diverging scale, named ranges or a blend" },
        { "feature": "Square days that fit the width" },
