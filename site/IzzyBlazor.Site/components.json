    {
      "id": "bar-chart", "icon": "ChartColumn", "name": "ChartBarSeries", "title": "Bar chart", "category": "Charts", "summary": "Compares values across names as bars: ranked across, grouped or stacked as columns.", "use": "Use bars to compare amounts across names, such as revenue by region. Bars start at zero, so their lengths compare fairly. Sort them when the order matters, as in a ranking. For many dates, use a line chart instead.", "keywords": ["bar chart", "column chart", "bar graph", "stacked bar chart", "grouped bar chart"],
      "features": [
        { "feature": "Bars across, or upright columns" },
        { "feature": "Grouped side by side, stacked, or stacked to 100%" },
        { "feature": "A target tick across each bar, such as a quota" },
        { "feature": "Drawn on the server, as wide as its container, with labels that thin out as it narrows" },
        { "feature": "A table of the values in a \"Show data\" disclosure" },
        { "feature": "Tooltips on hover and from the keyboard", "noscript": "none" },
        { "feature": "Legend items that hide and show a series", "noscript": "none" }
      ],
      "examples": [
        { "id": "chart-horizontal", "title": "Ranked bars across", "lead": "`ChartBarSeries` in a `Chart` draws a bar for each item's `Value`. Ranked names read best as bars across, longest first: set `Orientation` to `Horizontal`.", "after": ["Long names have room down the side, ending in an ellipsis past a third of the chart's width.", "With `Labels` writing each value at its bar's end, the value axis's labels and grid lines only repeat them. Here `HideLabels` and `GridLines=\"false\"` on `ChartValueAxis` leave them out.", "Everything on the Chart page works with every series type."] },
        { "id": "chart-grouped", "title": "Grouped columns", "lead": "Two or more `ChartBarSeries` stand side by side in each band, to compare the series name by name. To compare this year with last, draw last year first and in gray with `Color`, so the current year stands out in the chart's first color." },
        { "id": "chart-stacked", "title": "Stacked", "lead": "`Stacking=\"ChartStacking.Normal\"` stacks the series, so each column's height is the total and each segment one part of it. The bottom segment reads most exactly, since it alone starts at zero: put the largest or most important part first. Keep to a few parts." },
        { "id": "chart-stacked-percent", "title": "Shares of 100%", "lead": "`Stacking=\"ChartStacking.Percent\"` draws each stack to 100%, to compare how a whole divides rather than how big it is. As bars across, each runs the full width and the shares read left to right." },
        { "id": "chart-pareto", "title": "A Pareto chart", "lead": "A Pareto chart ranks causes by count, with a line of their running share of the total, so the few that make most of it stand out. Sort the items largest first and work out each running share; draw the counts as `ChartBarSeries` and the share as a `ChartLineSeries` on a second `ChartValueAxis` from 0 to 1." },
        { "id": "chart-target", "title": "Bars with targets", "lead": "`Target` on `ChartBarSeries` draws a tick across each bar at the item's target, such as a team's quota, and names it in the tooltip and the data table. The value axis takes in every target, so one past every bar still shows.", "after": ["Targets go on bars side by side; with `Stacking` they're an error.", "For one measure against its target with qualitative ranges behind it (poor, satisfactory, good), use a Bullet chart."] }
      ]
    },
