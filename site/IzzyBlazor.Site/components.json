        {
          "id": "master-detail", "title": "Master-detail", "summary": "A row's detail opens underneath it, such as an order's lines in a grid of their own.", "members": ["DetailTemplate", "ItemHasDetail", "ExpandedDetails", "ExpandAllDetails", "SingleDetail", "ItemKey"],
          "examples": [
            { "id": "data-grid-master-detail", "title": "A row's detail", "lead": "A row's detail opens under the row, across the grid, such as an order's lines. Set `DetailTemplate`, and an `ItemKey` to keep track of open rows.", "after": ["Each row gets a button in a column of its own, and the header's button opens them all.", "Open rows are kept in the URL, as `?detail=1004`, so details work on static pages and with JavaScript off. To keep them in the component instead, bind `ExpandedDetails`.", "Only open rows render their detail, so a nested grid loads its rows, from an `ItemsProvider` too, only when its row opens. Give a nested grid its own `QueryPrefix`, or every row's grid shares one sort and page."] },
            { "id": "data-grid-grouped-detail", "title": "Details in groups", "lead": "In a grouped grid, a row's detail opens under it, inside its group, and its button sits one level in from the group's. To keep one detail open at a time, set `SingleDetail`.", "after": ["To leave the button off rows with nothing to show, set `ItemHasDetail`. To start with every row open, set `ExpandAllDetails`."] }
          ]
        },
        {
          "id": "reordering", "title": "Reordering rows", "summary": "Users put rows in their own order by dragging a handle or from its menu, and the grid posts or binds the new order.", "members": ["ReorderableRows", "OrderName", "Order", "SubmitOnMove", "OnMove", "ItemMovable", "ItemKey", "RowLabel"],
          "examples": [
            { "id": "data-grid-reorder-rows", "title": "Reordering rows, and saving the order", "lead": "To let users put rows in their own order, set `ReorderableRows` and an `ItemKey`, and give the grid every row in `Items`. Each row gets a drag handle at its start, which also opens a menu of moves.", "after": ["On static pages, give the grid an `OrderName` inside a form and pass the posted `ListOrder` back as `Order`. `Order.Arrange` puts your rows in the posted order.", "On interactive pages, bind `@bind-Items` to keep the new order.", "Rows move only in the grid's own order. While it's sorted, filtered, searched or grouped, the handles are disabled, so leave those off."], "notes": {"noscript": "Each move in a handle's menu posts the form. The page reloads with the row moved and its handle focused. Save order saves.", "static": "Drag a handle, or use its menu or Alt+arrow keys. Rows move on the page and the move is announced. Save order posts the new order.", "interactive": "Drag a handle, or use its menu or Alt+arrow keys. C# updates the grid at once and the move is announced. Save order shows the order @bind-Items keeps."}}
          ]
        },
        {
          "id": "adaptability", "title": "Adaptability", "summary": "On a phone or in a narrow panel, the grid hides the columns that don't fit and shows their values under the row.", "members": ["SmallScreen", "Nonce", "ItemKey", "Column.Priority", "ActionColumn.Overflow"],
          "examples": [
            { "id": "data-grid-hide-columns", "widthSwitch": true, "title": "Columns that hide", "lead": "To hide the columns that don't fit a narrow screen instead of scrolling sideways, set `SmallScreen=\"DataGridSmallScreen.HideColumns\"` and an `ItemKey`. A button at the start of each row then opens its detail, with the hidden columns' values in it.", "after": ["Columns hide lowest `Priority` first. The first column and frozen ones never hide.", "The row's actions move into its ⋮ menu, unless one sets `Overflow=\"RowActionOverflow.Never\"`. The toolbar moves your buttons and Export into its … menu.", "The grid goes by its own width, so this works in a side panel too, and with JavaScript off. To sort or filter a hidden column, use the column picker or the filter chips.", "It can't be used with `Virtualize`."] },
            { "id": "data-grid-hide-columns-detail", "widthSwitch": true, "title": "With groups and a detail", "lead": "In a grouped grid, a row's button sits one level in from its group's, as for any detail. With a `DetailTemplate`, the button column is always there, and the hidden values come first in the detail, above the template. A frozen column, here the total at the end, never hides." },
            { "id": "data-grid-hide-columns-edit", "widthSwitch": true, "title": "Editing a row", "lead": "With `DataGridEditMode.Row`, editing a row opens its detail, with fields for the hidden columns, while Save and Cancel stay in the row. Adding a row works the same way.",
          "notes": {
            "noscript": "The detail shows the hidden columns' values and any message instead of fields, as it does if IzzyBlazor's script fails to load. An edited row keeps those values, and a new row gets their defaults. Edit them where the grid is wide enough to show them."
          } }
          ]
        },
