      "id": "pie-chart", "icon": "ChartPie", "name": "PieChart", "title": "Pie chart", "category": "Charts", "summary": "Shows parts of a whole as slices of a circle or a ring, with each slice's value and share beside it.", "keywords": ["pie", "donut", "doughnut", "ring chart", "share", "breakdown"],
      "features": [
        { "feature": "A pie, or a donut with content in its middle" },
        { "feature": "A legend with each slice's value and share, beside the circle or under it" },
        { "feature": "Legend items that hide and show slices, the rest closing up", "noscript": "none" },
        { "feature": "Labels by their slices with short lines, or in the slices, beside a legend or in its place" },
        { "feature": "Labels you write with a template" },
        { "feature": "A table of the values in a \"Show data\" disclosure" },
        { "feature": "Tooltips on hover and from the keyboard", "noscript": "none" }
      ],
      "examples": [
        { "id": "pie-chart-usage", "title": "A donut with the total", "lead": "Give `PieChart` the `Items`, each slice's name as `Argument`, its size as `Value`, and a `Title`. `Donut` cuts a hole in the middle, and `Center` fills it, here with the total.", "after": ["The legend names each slice with its value and share, beside the ring when there's room and under it when there isn't. Point at a slice for its tooltip."],
          "notes": { "noscript": "There are no tooltips. Each slice still shows its value on hover, and the legend lists them all." } },
        { "id": "pie-chart-pie", "title": "A pie with its slices named", "lead": "Without `Donut`, the slices meet in the middle. To write each label just outside its slice, joined to it by a short line, set `Labels=\"ChartLabels.Outside\"`.", "after": ["Slices run clockwise from the top in item order, so sort the items largest first. `StartAngle` turns the circle, here by 180° so the largest slice fills the left half.", "A label is the slice's share, and the legend names the slices. Here `Legend=\"ChartLegend.None\"`, so each label names its slice too. Labels that would collide are nudged apart.", "`ChartLabels.Inside` writes each share in its slice instead, and a slice too thin for it gets its label outside. To write the labels yourself, such as \"English: 56%\" beside a legend, set `LabelTemplate`.", "Under 30rem there's no room outside the circle, so the labels are left out and the legend names the slices.", "Past about six slices they're hard to tell apart: group the smallest as \"Other\", or use a `Chart` with bars across."] }
      ]
    },
    {
      "id": "nested-donut-chart", "icon": "Donut", "name": "NestedDonutChart", "title": "Nested donut chart", "category": "Charts", "summary": "Shows how the same items split two or three wholes, as rings of one donut, one ring per measure.", "keywords": ["donut", "doughnut", "rings", "multi-series pie", "nested pie", "share"],
      "parts": ["DonutRing"],
      "features": [
