      "scenarios": [
        { "id": "kanban", "title": "Kanban board", "member": "SubmitOnMove",
          "description": "A team's board in an app shell: four columns with counts, In progress limited to three, and cards with a label, a due date and an owner. Cards drag from anywhere, and the column under the pointer opens a space where the card will land. A click opens a card beside the board (a link), and every move saves, so the link shows the board as it was left. The ⋯ menu has Assign to me and Archive, which post the form on static pages.",
          "example": { "id": "drop-zone-group-kanban", "title": "Spring conference", "height": 760, "page": true } }
