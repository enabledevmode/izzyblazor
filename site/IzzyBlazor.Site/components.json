    {
      "id": "tile-layout", "icon": "LayoutDashboard", "name": "TileLayout", "category": "Layout", "summary": "Places a dashboard's panels on a grid of columns and rows, each spanning as many as it needs.", "keywords": ["dashboard", "tiles", "widgets", "panels", "grid layout", "dashboard layout"],
      "parts": ["Tile"],
      "examples": [
        { "id": "tile-layout-dashboard", "title": "A dashboard", "lead": "For a dashboard people rearrange and keep, put a `Tile` for each panel in a `TileLayout`; one that never changes is a `Grid` of `Card`s. `Col` and `Row` place it, from 1, and `ColSpan` and `RowSpan` size it. `Columns` and `RowHeight` set the grid.", "after": ["A tile's `Title` and `Icon` make its header, and `HeaderEnd` puts buttons or a figure at its end. `Header` replaces the title with your own content. `Flush` runs the content to the tile's edges, for `Tabs` or a `DataGrid`.", "A `Chart` that is a tile's only content, with no `Height`, fills the tile. Name it by the tile's title: set the tile's `TitleId` and the chart's `TitledBy`. Put its buttons in `HeaderEnd`: `ChartDownload`, `ChartResetZoom`, `ChartZoom` and `ChartPause` act on the tile's chart.", "A tile without `Col` and `Row` takes the first free cells, row by row, in the order written. Cells no tile covers stay empty.", "`Columns` can change by breakpoint. Places and spans are for the widest count; at fewer columns, spans shrink in proportion and the tiles wrap in reading order, by row and then by column. At one column they stack."] },
        { "id": "tile-layout-edit", "title": "Rearranging the tiles", "lead": "Set `Editable` to let people move and resize the tiles. Dragging a tile moves it a cell at a time, and dragging its corner grip resizes it. Its handle opens a menu of the same moves.", "after": ["A move that would leave the grid, break a tile's `MinColSpan`, `MaxColSpan`, `MinRowSpan` or `MaxRowSpan`, or cover another tile is disabled. `AllowOverlap` lets tiles cover each other.", "`ShowGrid` outlines every cell while editing, and `Rows` keeps the empty rows. Editing works at the widest column count; with fewer columns the handles hide.", "Each tile needs an `Id`, and a `Title` or `Label` to name its handle."],
          "notes": {
            "noscript": "Give the layout a `Name` inside a form, and pass the posted `TileLayoutPost` back as `Post`. Each move posts the form and the page comes back with the tile moved. Save `Post.State` when the form's own button posted.",
            "static": "Tiles move in place, and the form posts the layout when it's submitted.",
            "interactive": "Tiles move in place, and `@bind-State` gets the new layout after each move."
          } },
        { "id": "tile-layout-saved-layout", "title": "A saved layout", "lead": "To show a layout someone arranged, pass it as `State`. It places and sizes each tile by its `Id`, over the tile's own values.", "after": ["`ToString` writes a `TileLayoutState` as a short string, for a cookie or a database column, and `TileLayoutState.Parse` reads it back.", "Tiles the state doesn't name keep their own place, and entries for tiles that aren't there are ignored."] }
      ]
    },
