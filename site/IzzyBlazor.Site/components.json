            { "id": "table-load-on-scroll", "title": "Loading on scroll",
          "notes": {
            "noscript": "Nothing loads on scroll: Load more shows under the rows, a link that reloads the table with one more page.",
            "static": "Scroll the rows: the next page loads as the last one comes into view, through the Load more link, which enhanced navigation swaps in with the scroll position kept. Tab to the hidden button to load from the keyboard.",
            "interactive": "Scroll the rows: the next page loads as the last one comes into view. Tab to the hidden Load more button to load from the keyboard." } },
            { "id": "table-load-error", "title": "When loading fails",
          "notes": {
            "noscript": "Retry is a link, and the page reloads. Once the API is back, the rows load.",
            "static": "Retry is a link; enhanced navigation swaps the page in without a full reload.",
            "interactive": "Retry asks again. Once the API is back, the table reloads." } }
          ]
        }
      ],
      "scenarios": [
        { "id": "activity-log", "title": "Activity log", "member": "Paging",
          "description": "An admin's activity log from an API that pages by cursor, with no total: the next page loads as you scroll, and the column filters go to the API with the cursor.",
          "example": { "id": "table-activity-log", "title": "Activity", "height": 720, "page": true,
            "notes": {
              "noscript": "Load more is a link: the page reloads with one more page of rows. The filters apply with their button.",
              "static": "Load more is a link, swapped in without a full reload.",
              "interactive": "Scroll down: each page loads under the last as its last row comes into view. A filter starts the list over."
            } } }
      ]
    },
    {
      "id": "card", "icon": "SquareStack", "name": "Card", "category": "Display", "summary": "Groups media, a header, body sections, actions and a footer in a box.", "keywords": ["panel", "tile"], "parts": ["CardMedia", "CardHeader", "CardActions", "CardBody", "CardFooter"],
      "examples": [
        { "id": "card-variants", "title": "Variants", "lead": "A variant sets the card's look: `Outline` (the default), `Elevated` or `Filled`. To choose one, set `Variant`. To give the card a header, set `Title` and `Description`." },
        { "id": "card-sizes", "title": "Sizes", "lead": "A card's size sets its padding and its title's size. To change it, set `Size`." },
        { "id": "card-linked", "title": "A linked card", "lead": "To make the whole card a link through its title, set `Href`. Buttons in `CardActions` stay clickable, and `CardMedia` goes on top." },
        { "id": "card-post", "title": "Header content", "lead": "For content above the title, such as who wrote the post, add a `CardHeader`. For a menu at the end of the heading row, add `CardActions`." },
        { "id": "card-footer", "title": "Body and footer", "lead": "To lay out the body, such as with a `Gap`, put it in a `CardBody`. For a row of buttons at the bottom, add a `CardFooter`." },
        { "id": "card-flush", "title": "Flush content", "lead": "To run a table or list to the card's edges, set `Flush` on `CardBody`." },
        { "id": "card-sections", "title": "Sections and a footer bar", "lead": "To make each `CardBody` a section, set `Dividers`. For a bar across the bottom, give a `CardFooter` a `Bg`." },
        { "id": "card-settings", "title": "A form in a card", "lead": "To submit from a button in the `CardFooter`, put the `Form` around the `Card`, so the button is inside the form.",
          "notes": {
            "noscript": "Save posts the form, and the page reloads with the result under the card.",
            "static": "Save posts the form without a full reload.",
            "interactive": "Save runs C# on the server, and nothing is posted." } },
        { "id": "card-projects", "title": "Cards in a grid", "lead": "To fit as many cards to a row as there's room for, put them in a `Grid` with `MinChildWidth`. Cards in a row share its height, and each `CardFooter` stays at the bottom." }
      ],
      "scenarios": [
        { "id": "profile-card", "title": "Profile card",
          "description": "A team member's card: a cover, an avatar with an online dot, a role badge, contact details in a DescriptionList, skills as tags and two actions in the footer.",
          "example": { "id": "card-profile", "title": "Team member", "height": 600, "page": true } }
      ]
    },
    {
      "id": "stat", "icon": "TrendingUp", "name": "Stat", "category": "Display", "summary": "Shows a figure with its trend, read as words.",
      "examples": [
        { "id": "stat-trends", "title": "Trends", "lead": "A trend shows which way the figure moved and by how much. Set `Trend` for the direction and `Change` for the amount. When a drop is good news, such as for costs, set `ChangeStatus` to color it as good news." },
        { "id": "stat-sizes", "title": "Sizes", "lead": "To change the text size of the label and the figure, set `Size`." },
        { "id": "stat-spark", "title": "A sparkline", "lead": "To show the figure's recent history under it, give `Sparkline` the values, such as the last twelve weeks. `SparklineType` draws them as a line, an area or bars. Screen readers hear it as an image named by `SparklineLabel`, with its first, last, lowest and highest values formatted by `SparklineFormat`; give the period there, as \"Weekly revenue, last 12 weeks\" does." }
      ],
      "scenarios": [
        { "id": "store-dashboard", "title": "Store dashboard", "member": "Trend",
          "description": "Stat cards for revenue, orders, refunds and conversion over a monthly goal and top products. The period is a link, so it works in every mode, and refunds going down shows as good news.",
          "example": { "id": "stat-dashboard", "title": "Store overview", "height": 600, "page": true } }
      ]
    },
    {
      "id": "chart", "icon": "ChartNoAxesCombined", "name": "Chart", "category": "Charts", "base": true, "summary": "Draws a chart on the server from a list of items, with axes, value labels, reference lines, trends and a table of the values, for every chart type.", "use": "Choose the series by the question. For change over time, use lines or areas. To compare amounts, use bars. To show how two measures relate, use a scatter or bubble chart. To show how values spread, use a histogram, box plot or violin. To explain how a total was reached, use a waterfall. Parts of a whole, flows and targets have components of their own, such as `PieChart`, `SankeyChart` and `BulletChart`.", "keywords": ["graph", "plot", "chart axis", "data labels", "legend", "tooltip", "reference line", "trend line", "zoom", "pan", "drag to zoom", "synchronized charts", "sync", "linked charts", "shared tooltip", "live data", "real-time", "streaming", "auto refresh", "drill-down", "drill down", "breadcrumb"],
      "parts": ["ChartValueAxis", "ChartArgumentAxis", "ChartTooltip", "ChartReferenceLine", "ChartReferenceBand", "ChartAnnotation", "ChartDrillLevel", "ChartDownload", "ChartResetZoom", "ChartZoom", "ChartPause"],
      "features": [
        { "feature": "Drawn on the server, as wide as its container, with labels that thin out as it narrows" },
        { "feature": "Axis titles, set steps, log scales, grid lines and a second axis" },
        { "feature": "Value labels, reference lines and bands, notes and trends" },
        { "feature": "A table of the values in a \"Show data\" disclosure" },
        { "feature": "Tooltips from a template, on hover and from the keyboard", "noscript": "none" },
        { "feature": "Legend items that hide and show a series", "noscript": "none" },
        { "feature": "Zoom and pan by dragging, Ctrl+wheel, a pinch or the keys, with no round trip", "noscript": "none" },
        { "feature": "Opening zoomed into part of the arguments, such as the last quarter", "member": "View" },
        { "feature": "The part in view reported to C# as each zoom ends", "noscript": "none", "static": "none" },
        { "feature": "Synchronized charts: a shared `Sync` name zooms them together and shows the same item in each", "member": "Sync", "noscript": "none" },
        { "feature": "Live data read again on an interval, on a static page too, with a Pause button", "member": "Refresh", "noscript": "none" },
        { "feature": "Drill-down by levels, with a breadcrumb back up, from links in the address that work with no script", "member": "ChartDrillLevel" },
        { "feature": "A button that saves the chart as a PNG, or a button of your own", "member": "Download", "noscript": "none" },
        { "feature": "On a right-to-left page, the plot keeps its direction while the legend, title and tooltip follow the page; `Reverse` on `ChartArgumentAxis` runs the arguments right to left" }
      ],
      "examples": [],
      "topics": [
        {
          "id": "series", "title": "Bars and lines", "summary": "Bar and line series in one chart, such as each month's revenue against its plan, each in its own color and dash, with formatted values.", "members": ["ChartBarSeries", "ChartLineSeries", "ChartBarSeries.Color", "ChartLineSeries.LineStyle", "ChartValueAxis.Format"],
          "examples": [
            { "id": "chart-usage", "title": "Bar and line series", "lead": "Give `Chart` the `Items`, what each is plotted at as `Argument`, and a `Title`. Each series draws one `Value` per item: `ChartBarSeries` as bars, and `ChartLineSeries` as a line, here the plan each month's revenue is measured against.", "after": ["`Color` sets a series' color in place of the palette's next one. Here the revenue is in the theme's primary color and the plan in its text color, and `LineStyle` dashes the plan's line.", "A `ChartValueAxis` with a `Format` formats the values on the axis and in the Show data table under the chart. Leave the axes out and they take their defaults.", "The chart is rendered on the server with the page, so it shows with JavaScript off."] }
          ]
        },
        {
          "id": "titles", "title": "Titles", "summary": "A chart's title, or a heading on the page that titles it, such as a card's, so the title isn't written twice, and the title's size and alignment.", "members": ["Title", "TitledBy", "HideTitle", "TitleAlign"],
          "examples": [
            { "id": "chart-in-card", "title": "Titled by a heading", "lead": "When a heading on the page already says what the chart shows, such as a card's title, set `TitledBy` to the heading's id instead of giving the chart a `Title`. A `Card` gives its heading an id with `TitleId`.", "after": ["The chart and its Show data are named from the heading, so the title isn't written twice. For a chart with no heading near it, `HideTitle` keeps a `Title` for screen readers only.", "To size every chart's own title at once, set `--ib-chart-title-size` (the theme's `--ib-text-lg` by default) and `--ib-chart-title-weight` in your CSS. `TitleAlign` moves the title to the `Center` or `End`."] }
          ]
        },
        {
          "id": "labels", "title": "Value labels", "summary": "Each value written beside its bar or point, on any series, past a bar's end or in the middle of a stacked segment, with labels that would overlap left out.", "members": ["ChartBarSeries.Labels", "ChartBarSeries.LabelFormat", "ChartBarSeries.LabelOverlap"],
          "examples": [
            { "id": "chart-labels", "title": "Labels on bars", "lead": "To write each value beside its bar, set `Labels` on the series to `Auto`. A label goes past the end of the bar, or inside it when there's no room above.", "after": ["`LabelFormat` formats the labels apart from the axis. A label that would overlap another is left out at the widths where it would; narrow the window to see them go. To show every label anyway, set `LabelOverlap` to `Show`.", "With every series labeled, the chart has no tooltips, which would repeat the labels. To keep them, set `Tooltip` to true."] },
            { "id": "chart-labels-stacked", "title": "Labels in a stack", "lead": "In a stack, `Auto` puts each label in the middle of its segment, and leaves it out when the segment is too small to hold it. `Inside` puts labels inside the bar at its end, and `Outside` past it." }
          ]
        },
        {
          "id": "reference", "title": "Reference lines", "summary": "Lines at a target or an average, and shaded ranges of values or arguments such as a season, each labeled in text and said in the chart's description.", "members": ["ChartReferenceLine", "ChartReferenceBand"],
          "examples": [
            { "id": "chart-reference", "title": "Reference lines and bands", "lead": "To mark a value, such as a target, put a `ChartReferenceLine` in the chart with its series and set its `Value`. It's a dashed line with its `Label` just above it at the left, or where `LabelAlign` puts it: `Start`, `Center` or `End`.", "after": ["The value axis always reaches a reference line, so a target above every value still shows. With `Statistic` and a series' name as `Series`, the line is that series' `Average` or `Median`.", "`ChartReferenceBand` shades a range of values from `From` to `To`, or of arguments from `ArgumentFrom` to `ArgumentTo`, here November and December."] }
          ]
        },
        {
          "id": "annotations", "title": "Annotations", "summary": "Short notes at a point, and lines at an argument such as a launch day, which move with the chart when the legend rescales it.", "members": ["ChartAnnotation", "ChartReferenceLine.Argument"],
          "examples": [
            { "id": "chart-annotations", "title": "Annotations", "lead": "`ChartAnnotation` puts a short `Text` at an `Argument` and `Value`, with a line down to the point. A `ChartReferenceLine` with an `Argument` in place of a `Value` draws a line at an argument, here the day of a launch. Hiding a series from the legend rescales the chart, and the marks move with it." }
          ]
        },
        {
          "id": "trends", "title": "Trends", "summary": "A dashed line through any series' values: the straight line or curve that fits them best, or a moving average that smooths out the ups and downs.", "members": ["ChartBarSeries.Trend", "ChartBarSeries.TrendOrder", "ChartBarSeries.TrendPeriod", "ChartBarSeries.TrendColor"],
          "examples": [
            { "id": "chart-trend", "title": "A linear trend", "lead": "To draw a series' trend as a dashed line, set `Trend` on the series: `Linear`, the straight line that fits best, or `Polynomial`, a curve of `TrendOrder` (2, a parabola, by default).", "after": ["The trend is named after the series, here \"Revenue trend\", in the legend, the tooltip and Show data. The legend hides it like any series.", "It's drawn in the series' color mixed toward the text color, so it reads over the series' own bars. `TrendColor` sets a color of your own."] },
            { "id": "chart-moving-average", "title": "A moving average", "lead": "`MovingAverage` makes each point the average of the last `TrendPeriod` values, here 7 days, which smooths out the weekend dips. It starts once the first window is full." }
          ]
        },
        {
          "id": "second-axis", "title": "A second axis", "summary": "A second value axis across the plot from the first, for a measure in other units read against the same arguments, with ticks on the first axis's grid lines.", "members": ["ChartValueAxis.Name", "ChartLineSeries.ValueAxis"],
          "examples": [
            { "id": "chart-second-axis", "title": "A second value axis", "lead": "To plot a series in other units, such as a margin read against its revenue, add a second `ChartValueAxis` with a `Name`, here `margin`. Then give that series the name as its `ValueAxis`.", "after": ["Two charts side by side usually read better than one with two axes: readers compare the lines' heights, which mean nothing across scales. Use a second axis when one chart is the better fit.", "The second axis has its own `Format`, `Min`, `Max` and `Title`. Its ticks fall on the first axis's grid lines, each a round step. Each title has a key in its series' color.", "A second axis needs an upright chart, and a stacked chart's bars and areas stay on one axis. Reference lines, bands and notes are read on the second axis with the same `ValueAxis`; a statistic line follows its series."] }
          ]
        },
        {
          "id": "axes", "title": "Axes", "summary": "Titles beside the axes, a set gap between ticks, a log scale, grid lines, values on either side, and names that turn or wrap when they crowd.", "members": ["ChartValueAxis", "ChartArgumentAxis", "ChartValueAxis.Position"],
          "examples": [
            { "id": "chart-axes", "title": "Titles, a set step and grid lines", "lead": "`ChartValueAxis` and `ChartArgumentAxis` set up each axis. `Title` puts a title beside it, and the value axis's `Step` sets the gap between its ticks, here $25,000.", "after": ["The value axis ends on a multiple of its step. The argument axis's title also heads the first column of the data table.", "`GridLines` on the argument axis adds lines between the months; on the value axis, `GridLines=\"false\"` leaves only the zero line."] },
            { "id": "chart-log-scale", "title": "A log scale", "lead": "For values that span several powers of ten, set `Logarithmic` on the `ChartValueAxis`: each power of ten is an equal step up, so growth from hundreds to thousands shows as clearly as from hundreds of thousands to millions. A log scale has no zero, so values at or under zero aren't drawn." },
            { "id": "chart-rotated", "title": "Long names along the bottom", "lead": "Names that don't fit side by side are skipped, every other one first. To turn them 45° before any are skipped, set the `ChartArgumentAxis`'s `LabelFit` to `Rotate`; narrow the window to see them turn. `Wrap` shows every name, wrapped onto more lines in its band, which suits a few long names." },
            { "id": "chart-formatters", "title": "Your own label text", "lead": "When a format string can't say it, an axis's `Formatter` writes its text. Here the `ChartValueAxis` writes revenue in millions, and the `ChartArgumentAxis` names each quarter from its start date.", "after": ["The text shows on the axis, in tooltips and in the data table. Hiding a series from the legend then keeps the value axis as it is, since the browser can't run your formatter.", "`HideLabels` leaves an axis's labels out. `--ib-chart-tick-color` and `--ib-chart-tick-size` set the labels' color and size."] },
            { "id": "chart-reversed", "title": "Arguments right to left", "lead": "To run the arguments right to left, set `Reverse` on `ChartArgumentAxis`, here January at the right and December at the left. `Position=\"ChartAxisPosition.Right\"` on the `ChartValueAxis` moves the values to the right, beside January, where the reading starts.", "after": ["On a right-to-left page the plot keeps its direction, as most charts in Arabic and Hebrew apps do; the legend, title and tooltip follow the page. `Reverse` works on its own, with no `dir` set.", "With the values on the right, a second axis takes the left. On a horizontal chart, `Reverse` puts the first item at the bottom, and `Top` puts the values above the bars."] }
          ]
        },
        {
          "id": "colors", "title": "Colors", "summary": "Series take the theme's eight colors, shades of one color for series in an order, two colors either side of a middle, or your own.", "members": ["Palette", "ChartBarSeries.Color"],
          "examples": [
            { "id": "chart-shades", "title": "Shades for tiers", "lead": "When the series are in an order, such as plan tiers, set `Palette` to `ChartPalette.Shades` with one color, here the theme's primary. The first series is the lightest and each one after is darker.", "after": ["In dark mode the ramp turns round, so the last series is the brightest. The shades are spread over as many series as the chart has. Past about six they're hard to tell apart; for series in no order, keep the default `ChartPalette.Colors`."] },
            { "id": "chart-diverging", "title": "Diverging colors", "lead": "For series on either side of a middle, such as answers from disagree to agree, set `Palette` to `ChartPalette.Diverging` with the two ends' colors.", "after": ["The first series is the strongest of the first color and the last the strongest of the second. With an odd count, the middle one is gray.", "`ChartPalette.Of` takes your own colors in order, and a series' `Color` still sets that one series."] }
          ]
        },
        {
          "id": "tooltips", "title": "Tooltips", "summary": "Each series' value for the item under the pointer or keyboard focus, said to screen readers, from a template of your own if you like.", "members": ["Tooltip", "ChartTooltip", "DataTable"],
          "examples": [
            { "id": "chart-tooltips", "title": "A tooltip template", "lead": "To write the tooltip yourself, put a `ChartTooltip` in the chart. Its context has the `Item`, the formatted `Argument`, and each series' `Points` with their names, values and colors.", "after": ["To show the tooltips from the keyboard, Tab to the chart and use the arrow keys. A screen reader hears each value as they move.", "The tooltip is rendered on the server with the page, so keep the template to text and inline content. To leave the tooltips out, set `Tooltip` to false. They're off by default when every series has value labels."], "notes": {"noscript": "There are no tooltips. Each bar and marker still shows its value on hover, and Show data lists every value."} }
          ]
        },
        {
          "id": "crosshair", "title": "Crosshair", "summary": "Lines at the item under the pointer and at its nearest value, with both in badges on the axes, to read values off the axes exactly.", "members": ["Crosshair"],
          "examples": [
            { "id": "chart-crosshair", "title": "A crosshair", "lead": "`Crosshair` draws a line at the item under the pointer and one at the value nearest it, with the item's argument and that value in badges on the axes, so a reader can read a line's value off the axis exactly.", "after": ["The value line snaps to the series nearest the pointer; from the keyboard it stays on the series it was on.", "On a scatter or bubble chart, both lines run through the nearest point. The crosshair goes with the tooltip, so with `Tooltip` false there's none, and it's left out of downloads."], "notes": {"noscript": "There's no crosshair."} }
          ]
        },
        {
          "id": "legend", "title": "Legend", "summary": "A legend above, below or beside the chart whose items hide and show their series, with series that can start hidden.", "members": ["Legend", "LegendAlign", "ChartBarSeries.Hidden"],
          "examples": [
            { "id": "chart-legend", "title": "A legend beside the chart", "lead": "`Legend` places the legend: `Top`, `Bottom`, `Start`, `End` or `None`. `Start` and `End` put it beside the chart, and above or below it under 30rem wide. By default it's above, under the title, with two series or more.", "after": ["Click a legend item to hide its series, and again to show it. The chart is drawn again without it, so stacks close up and the value axis rescales. To start a series hidden, set `Hidden`, here the small Other channel, which would flatten the rest.", "`LegendAlign` sets where the legend sits along its edge: `Start` (the default, lined up with the title), `Center` or `End`. Above or below the chart, that's left, center or right; beside it, top, middle or bottom."], "notes": {"noscript": "The legend doesn't hide series."} }
          ]
        },
        {
          "id": "zoom", "title": "Zoom", "summary": "Zooming shows part of the arguments up close, such as a month of a year of days, from a drag, the wheel, a pinch or the keys, with no round trip.", "members": ["ChartArgumentAxis.Zoom", "ChartArgumentAxis.MinZoomSpan", "View", "ChartView", "RangeSelector"],
          "examples": [
            { "id": "chart-zoom-range", "title": "A range selector and a starting view", "lead": "To zoom a chart from a strip under its plot, put a `ChartRangeSelector` in it. The strip draws the whole range small, with a window over the part in view: drag the window to pan, or a handle to widen or narrow it. `View` opens the chart zoomed, here on the last three months.",
              "after": ["A `ChartView` takes the first and last argument in view, such as two dates, and null for the data's own end. `Ranges` adds buttons for the last 1, 3 and 6 months, the year to date, a year, and everything. A button whose span would show everything is left out.", "The value axis refits to the values in view, so a quiet month fills the plot. On interactive pages, `@bind-View` reports the part in view as each zoom ends, not while dragging; null means everything is in view.", "A range selector needs an upright chart. See RangeSelector for spans of your own and for choosing a range apart from a chart."],
              "notes": { "noscript": "The chart opens on `View` and doesn't zoom. The range selector shows the part in view." } },
            { "id": "chart-zoom-box", "title": "Zoom to a box", "lead": "To zoom with no range selector, set `Zoom` on the `ChartArgumentAxis`. Drag across the plot to zoom into that span, here the afternoon slowdown, or use the Zoom in and Zoom out buttons by the title; Reset zoom shows the whole day again.",
              "after": ["Hold Ctrl (⌘ on a Mac) and turn the wheel, or pinch on a trackpad, to zoom at the pointer; Shift and the wheel pan. On a touch screen, two fingers pinch and pan. One finger and the plain wheel still scroll the page.", "From the keyboard, Tab to the chart: + and − zoom around the item shown, 0 zooms out, and an arrow key pans to an item out of view. Screen readers hear the range now in view after each zoom.", "A zoom stops at 2 items; `MinZoomSpan` sets another least span. Bars across zoom down the side. Waterfall charts don't zoom in the browser, but `View` works on them."],
              "notes": { "noscript": "The chart doesn't zoom." } }
          ]
        },
        {
          "id": "sync", "title": "Synchronized charts", "summary": "Charts that share a Sync name zoom together and show the same date, number or name when one is pointed at, with no round trip.", "members": ["Sync", "SyncView", "SyncHover", "RangeSelector.Sync"],
          "examples": [
            { "id": "chart-sync-range", "title": "One range selector for several charts", "lead": "To zoom several charts together, give each the same `Sync` name, and a `RangeSelector` on its own the name too. Here one strip zooms the revenue and orders charts, which open on the last quarter.",
              "after": ["The charts match by argument, not by position, so a bar chart of days follows a line over the same days, and a chart that covers only part of the range shows its part.", "A chart needs no `Zoom` of its own to follow the others. With `Zoom` on its `ChartArgumentAxis`, dragging or pinching it zooms the whole group too, and Reset zoom on any of them resets them all. To start them on the same part, give each the same `View`.", "On interactive pages each chart reports `@bind-View` as a zoom ends. To keep a chart out of the zooming but still show the hovered item, set `SyncView` to false."],
              "notes": { "noscript": "Each chart opens on its `View`, and nothing zooms or moves together." } },
            { "id": "chart-sync-hover", "title": "The same hour in two charts", "lead": "Point at an hour in either chart to see that hour's tooltip in both, here requests and response time, which read together explain a slow afternoon.",
              "after": ["Arrow keys on a focused chart move the other charts too. Screen readers hear only the focused chart; the others' tooltips are hidden from them.", "Charts match items by name, or by the nearest date or number within their range, and show nothing where they have no item. To keep a chart's tooltip to itself, set `SyncHover` to false.", "`LabelWidth` on each `ChartValueAxis` gives the value labels the same room, so the plots line up and the hovered hour sits at the same place in both."],
              "notes": { "noscript": "There are no tooltips. Each bar and marker still shows its value on hover." } }
          ]
        },
        {
          "id": "live", "title": "Live data", "summary": "A chart that reads its data again every few seconds, on a static page with no circuit too, with a Pause button and the item shown kept as data comes and goes.", "members": ["Refresh", "RefreshFrom", "OnRefresh", "Live", "Paused", "HidePause"],
          "examples": [
            { "id": "chart-live-refresh", "title": "Requests per second", "lead": "To read a chart's data again on an interval, set `Refresh` and give the chart an `id`. Here the last two minutes of requests come in every 5 seconds.",
              "after": ["On a static page the page is fetched again and the chart drawn from it, found by its `id`. `RefreshFrom` names a lighter page that renders the same chart, here the example's own frame. A failed fetch keeps the last drawing.", "Nothing is fetched while the tab is hidden or the chart is off-screen. On a static page an update also waits while your pointer or focus is in the chart, so nothing moves while you read it.", "On an interactive page `Refresh` raises `OnRefresh` instead, for you to load new `Items`. When your app pushes data on its own, from a timer or SignalR, set `Live` and change `Items`.", "Pause updates keeps the chart still, as WCAG asks of content that updates on its own. `Paused` starts it paused, and `@bind-Paused` with `HidePause` pauses it from your own control.", "The item you point at or reach with the keys stays the same item as new data arrives. Zoomed in at the latest item, the view moves on with new data; zoomed into the past, it stays there. Screen readers hear nothing on each update.", "The other charts, Sparkline and Gauge take `Refresh`, `RefreshFrom` and `OnRefresh` too, with no Pause button or kept item: on a dashboard, give them the same interval as its charts."],
              "notes": { "noscript": "The chart shows the data as the page was rendered, and doesn't update." } }
          ]
        },
        {
          "id": "drill", "title": "Drill-down", "summary": "Bars, slices and tiles that open the level below them, such as a year's months, with the level in the page's address.", "members": ["ChartDrillLevel", "Drill", "HideBreadcrumb"],
          "examples": [
            { "id": "chart-drill-revenue", "title": "Revenue by year, month and day", "lead": "To drill into a chart, put a `ChartDrillLevel` in it for each level, from the top, in place of the chart's `Argument`. Select a year's bar to see its months, and a month's to see its days.",
              "after": ["The chart groups its items by each level's argument and adds up every series. `Aggregate` on a series sets how: `Sum` by default, or `Avg`, `Min`, `Max` or `Count`.", "The level is in the page's address, here `?revenue=2025&revenue=Nov`, so a level can be bookmarked and the browser's Back goes up one. `Drill` names the address's key; give each chart that drills on a page its own.", "From the keyboard, move to an item and press Enter: the plot keeps focus and says the new level. The data table's first column links each item to its level, with or without script. The breadcrumb links back up.", "`PieChart`, `FunnelChart` and `TreemapChart` drill the same way."],
              "notes": { "noscript": "Every bar and the data table's rows are links, so drilling works as it does with script, without the Enter key on the plot." } }
          ]
        },
        {
          "id": "download", "title": "Download", "summary": "Download puts a button by the title that saves the chart as a PNG named after it. A button of your own can save it too, on a static page as well.", "members": ["Download"],
          "examples": [
            { "id": "chart-download", "title": "A download button", "lead": "To let readers save a chart as an image, set `Download`. A button across from the title saves it as a PNG named after the title, here \"Revenue by region, 2026.png\".",
              "after": ["The image is the chart as it shows: twice its size on screen for sharp text, in the light or dark scheme the page is in, with any series the legend hid left out. The buttons, the tooltip and Show data are left out.", "Every chart type takes `Download`: `PieChart`, `NestedDonutChart`, `FunnelChart`, `HeatmapChart`, `CalendarHeatmap`, `TreemapChart`, `SankeyChart` and `RadarChart` too.", "For a PDF, print the page and choose Save as PDF, or send the chart's picture in a form to a PDF your server builds, as the Downloads article shows."],
              "notes": { "noscript": "There's no button." } },
            { "id": "chart-download-button", "title": "Your own button", "lead": "To save a chart from a button of your own, such as one in a card's header, give the chart an `id` and the button `data-ib-chart-download` set to that id.",
              "after": ["A chart titled by a heading (`TitledBy`) or with `HideTitle` gets its title written above it in the image, so the picture says what it shows.", "The button works on a static page with no circuit, as on an interactive one."],
              "notes": { "noscript": "The button does nothing." } }
          ]
        }
      ]
