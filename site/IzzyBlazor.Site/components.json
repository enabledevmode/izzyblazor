      "id": "pie-chart", "icon": "ChartPie", "name": "PieChart", "title": "Pie chart", "category": "Charts", "summary": "Shows how one total splits into a few shares, such as customers by plan, each labeled with its share.", "use": "Use a pie when the point is how one total splits, and there are five or fewer parts with clearly different shares. People judge angles poorly. To compare similar shares or rank them, use a bar chart.", "keywords": ["pie", "donut", "doughnut", "ring chart", "share", "breakdown", "half donut", "semicircle", "semi-circle pie"],
      "features": [
        { "feature": "A pie, or a donut with content in its middle" },
        { "feature": "A half circle, or any part of one, that takes only its own height" },
        { "feature": "A legend with each slice's value and share, beside the circle or under it" },
        { "feature": "Legend items that hide and show slices, the rest closing up", "noscript": "none" },
        { "feature": "Labels by their slices with short lines, or in the slices, beside a legend or in its place" },
        { "feature": "Labels you write with a template" },
        { "feature": "A table of the values in a \"Show data\" disclosure" },
        { "feature": "Tooltips on hover and from the keyboard", "noscript": "none" }
      ],
      "examples": [
        { "id": "pie-chart-usage", "title": "A donut with the total", "lead": "Give `PieChart` the `Items`, each slice's name as `Argument`, its size as `Value`, and a `Title`. `Donut` cuts a hole in the middle, and `Center` fills it, here with the total.", "after": ["The legend names each slice with its value and share, beside the ring when there's room and under it when there isn't. Point at a slice for its tooltip."],
          "notes": { "noscript": "There are no tooltips. Each slice still shows its value on hover, and the legend lists them all." } },
        { "id": "pie-chart-pie", "title": "A pie with its slices named", "lead": "To write each label just outside its slice, joined to it by a short line, set `Labels=\"ChartLabels.Outside\"`.", "after": ["Slices run clockwise from the top in item order, so sort the items largest first. `StartAngle` turns the circle, here by 180° so the largest slice fills the left half.", "A label is the slice's share, and the legend names the slices. Here `Legend=\"ChartLegend.None\"`, so each label names its slice too. Labels that would collide are nudged apart.", "`ChartLabels.Inside` writes each share in its slice instead, and a slice too thin for it gets its label outside. To write the labels yourself, such as \"English: 56%\" beside a legend, set `LabelTemplate`.", "Under 30rem there's no room outside the circle, so the labels are left out and the legend names the slices."] },
        { "id": "pie-chart-half", "title": "A half donut", "lead": "`Sweep` sets how far round the slices go, in degrees: 180 is a half circle. With `StartAngle=\"-90\"` they start at the left and run over the top to the right, and the chart takes only the half's height.", "after": ["A donut's `Center` sits in the hole, on the flat edge.", "A half circle suits a whole that has a midpoint people read against, as a majority here. For most breakdowns a whole circle, or bars, compare better."] }
      ]
    },
    {
      "id": "nested-donut-chart", "icon": "Donut", "name": "NestedDonutChart", "title": "Nested donut chart", "category": "Charts", "summary": "Shows how the same items split two or three totals, such as a country's exports and imports.", "use": "Use rings to compare how the same items split two or three totals, such as exports and imports. They show the overall mix, not exact shares. The same share looks bigger on the outer ring. For exact comparisons, use 100% stacked bars.", "keywords": ["donut", "doughnut", "rings", "multi-series pie", "nested pie", "share"],
      "parts": ["DonutRing"],
      "features": [
        { "feature": "A ring for each measure, the first outside, with the rings named under the title" },
        { "feature": "One color and one legend row per item, in every ring" },
        { "feature": "Legend items that hide and show an item's slices in every ring", "noscript": "none" },
        { "feature": "A table of each ring's values and shares in a \"Show data\" disclosure" },
        { "feature": "Tooltips on hover and from the keyboard, along a ring and between rings", "noscript": "none" }
      ],
      "examples": [
        { "id": "nested-donut-chart-usage", "title": "A ring per measure", "lead": "Give `NestedDonutChart` the `Items`, each slice's name as `Argument`, and a `DonutRing` for each measure, with its `Value` and `Name`. The first ring is the outer one, and each item keeps its color in every ring.", "after": ["The line under the title names each ring by its place."],
          "notes": { "noscript": "There are no tooltips. Each slice still shows its ring, value and share on hover, and Show data lists them all." } }
      ]
    },
    {
      "id": "sparkline", "icon": "ChartSpline", "name": "Sparkline", "category": "Charts", "summary": "Puts a trend beside a number or in a table row, in the space of a word.", "use": "Use a sparkline to show the trend beside a number or in a table row. It has no scale, and each one fits its own values. To compare levels between rows, use a line chart.", "keywords": ["spark", "trend line", "micro chart", "inline chart"],
      "features": [
        { "feature": "A line, an area, bars or win-loss bars, as wide as its container" },
        { "feature": "The latest value marked, and the first, lowest or highest when they matter" },
        { "feature": "One scale for a column of sparklines, so their heights compare" },
        { "feature": "A name that says the first, last, lowest and highest values" }
      ],
      "examples": [
        { "id": "sparkline-types", "title": "Line, area, bars and win-loss", "lead": "Give `Sparkline` the `Values` and a `Label`, and set `Type` to draw them: `Line` (the default), `Area`, `Bar` or `WinLoss`.", "after": ["Win-loss bars are all one height: up for a value over `Threshold` (0 by default), down for one under, and a tick for one at it. They show only which way each value went.", "Up bars take `--ib-chart-increase` and down bars `--ib-chart-decrease`, as a waterfall's do. `Height` sets how tall a sparkline is, 2rem by default, and `Color` sets its color in place of the theme's primary color.", "To put a sparkline in a `Stat`, set the stat's `Sparkline`."] },
        { "id": "sparkline-points", "title": "Marking values", "lead": "`Points` marks values with a dot: `Last` by default, or any of `First`, `Last`, `Low` and `High` combined with `|`, or `None`. On bars, the marked ones are solid and the rest lighter. `Curve` runs the line smooth, or in steps for a value that holds until it changes, as a price does." },
        { "id": "sparkline-shared-scale", "title": "One scale for a column", "lead": "Each sparkline spans its own lowest to highest value, which suits one alone but makes a column of them misleading: a product that sells little looks as busy as one that sells a lot. Give them all the same `Min` and `Max` so their heights compare." },
        { "id": "sparkline-usage", "title": "A trend beside each row", "lead": "In a table, a sparkline in each row shows that row's trend beside its numbers. Each fills its cell's width, with a dot on the last value, the current one.", "after": ["A missing value, null, breaks the line, as the image resizer's outage does here.", "A sparkline has no axes or tooltip. `ValueFormat` formats the values screen readers hear with the label."] }
      ]
    },
    {
      "id": "gauge", "icon": "Gauge", "name": "Gauge", "category": "Charts", "summary": "Shows one value against its range, such as progress toward a goal.", "use": "Use a gauge to show one value against its range, such as progress toward a goal. It takes a lot of space for one number and has no history. Several readings side by side read better as bullet graphs. Add a sparkline to show the trend.", "parts": ["GaugeBand", "GaugePointer"], "keywords": ["meter", "dial", "speedometer", "radial progress"],
      "features": [
        { "feature": "A 240° dial with the value in the middle and the ends under it" },
        { "feature": "Bands along the dial that color the fill and name the value's range" },
        { "feature": "A target tick, and more values as pointers on the same dial" },
        { "feature": "Read as a meter, with its value in words" }
      ],
      "examples": [
        { "id": "gauge-usage", "title": "Bands", "lead": "Give `Gauge` a `Value` and a `Label`. Each `GaugeBand` marks a range along the dial's edge in the next of `Palette`'s colors, and a value in it fills in that color.", "after": ["The dial runs from `Min` to `Max`, 0 to 1 by default, so a share reads as a percent with `ValueFormat=\"P0\"`. A gauge is 12rem wide; `Width` sets another.", "A dial alone is a number in a ring; bands give the value something to be read against. A band's `Label` shows under the value, so the color isn't the only cue.", "A band's own `Accent` takes the place of its palette color, such as `Accent=\"Accent.Danger\"` on one band among grays."] },
        { "id": "gauge-range", "title": "Range and target", "lead": "To measure on another scale, set `Min` and `Max`. `Target` marks a goal with a tick across the dial, read with the value as \"target 50\". A value past either end fills none or all of the dial, and still shows as it is.", "after": ["Without a `Palette`, bands are grays, darkest first: they mark the ranges without calling one good or bad, and the value keeps the primary color. The band's label names where it falls."] },
        { "id": "gauge-pointers", "title": "Pointers", "lead": "For another value on the same dial, such as the gusts beside the mean wind, write a `GaugePointer` inside the gauge with its `Value` and `Label`. It's written under the label as \"Gusts 44 km/h\".", "after": ["The gauge's own `Value` stays the one that fills. Each pointer is a meter of its own, named by its label; its `Accent` sets another color.", "For one goal, `Target` is simpler: a tick in the text color, read with the value."] }
      ]
    },
    {
      "id": "linear-gauge", "icon": "Ruler", "name": "LinearGauge", "title": "Linear gauge", "category": "Charts", "summary": "Shows one reading on a scale, such as a tank's level or the air pressure.", "use": "Use a linear gauge for one reading on a known scale, such as a temperature or a tank's level. A length reads more exactly than a dial's angle, in less space. Against a target with ranges, use a bullet graph. For history, use a line chart.", "parts": ["GaugeBand", "GaugePointer"], "keywords": ["linear gauge", "meter", "thermometer", "level", "scale", "horizontal gauge", "vertical gauge"],
      "features": [
        { "feature": "A bar from the scale's start, a marker at the value, or a needle into the bands" },
        { "feature": "Bands along the track that color the value and name its range" },
        { "feature": "Round ticks by default, or your own step, with minor ticks, beside the track or over it" },
        { "feature": "Across or standing up, either way round" },
        { "feature": "A target tick, and more values as pointers" },
        { "feature": "Read as a meter, with its value in words" }
      ],
      "examples": [
        { "id": "linear-gauge-usage", "title": "Bands", "lead": "Give `LinearGauge` a `Value` and a `Label`. The scale runs from `Min` to `Max`, 0 to 1 by default, with round ticks; `ValueFormat` formats the value and the ticks. Each `GaugeBand` marks a range on the track, and a value in it colors the bar.", "after": ["`Palette` colors the bands in order; without it they're grays, darkest first, and the bar keeps the primary color. A band's `Label` shows beside the value, so the color isn't the only cue.", "The gauge is as wide as its container."] },
        { "id": "linear-gauge-marker", "title": "Marker and ticks", "lead": "For a reading that isn't an amount, set `Pointer=\"LinearGaugePointer.Marker\"`: a triangle points at the value in place of a bar from the start. `Step` sets the numbered ticks, and `MinorStep` adds shorter ones between them.", "after": ["`Target` marks a goal with a tick across the track. `Reversed` runs the scale the other way. `HideScale` leaves out the ticks and their numbers, for a gauge small enough for a table cell."] },
        { "id": "linear-gauge-needle", "title": "Needle and ticks inside", "lead": "When the bands are the reading, set `Pointer=\"LinearGaugePointer.Needle\"`. `TickPlacement=\"TickPlacement.Inside\"` draws the ticks over the bands.", "after": ["`ChartPalette.Tints` colors the bands from a light tint up to the full color, with no black mixed in, so a large area stays clear; `Shades`, which darkens toward black, suits a chart's series better.", "The needle takes the gauge's `Accent`, or the text color. The band's label names where the value falls.", "`ScaleSide=\"ScaleSide.Start\"` puts the numbers above the scale, and the inside ticks hang from the top edge."] },
        { "id": "linear-gauge-vertical", "title": "Vertical, with pointers", "lead": "To stand the scale up, low at the bottom, set `Orientation=\"Orientation.Vertical\"`. It's 12rem tall; `Height` sets another.", "after": ["A `GaugePointer` is another value on the same scale, written under the gauge as \"Dew point 12°C\". Each pointer is a meter of its own, named by its label."] }
      ]
    },
    {
      "id": "range-selector", "icon": "UnfoldHorizontal", "name": "RangeSelector", "category": "Charts", "parts": ["ChartRangeSelector"], "summary": "Chooses a span of dates, numbers or names on a strip that draws the whole range small: on its own it picks a range to filter by, and as ChartRangeSelector it zooms a chart.", "keywords": ["range selector", "range navigator", "navigator", "zoom", "time range", "date range", "brush", "range buttons"],
      "features": [
        { "feature": "Under a chart's plot, the chart's series drawn small, zooming the chart" },
        { "feature": "On its own, a range over its own items, to filter a grid or sum a total" },
        { "feature": "A window with two handles, each with its value in a flag (under a chart, while the handle is in use), and the rest shaded" },
        { "feature": "Buttons for the last 1, 3 and 6 months, the year to date, a year and everything, or spans of your own", "noscript": "none" },
        { "feature": "Dragging the window or a handle, a click on the strip, and the keys on each handle", "noscript": "none" },
        { "feature": "The range chosen reported to C# (@bind-View)", "noscript": "none", "static": "none" },
        { "feature": "On its own, zooming several charts at once by their `Sync` name", "member": "Sync", "noscript": "none" }
      ],
      "examples": [
        { "id": "range-selector-strip", "title": "A strip under a chart", "lead": "Put `ChartRangeSelector` in an upright `Chart`, after its series, to zoom the chart from a strip under the plot. Drag the window to pan, or a handle to widen or narrow it.", "after": ["`View` opens the chart on the last three months, so the plot shows the days and the strip the three years of seasons around them. A range selector suits a long series like this one, read up close a part at a time."] },
        { "id": "range-selector-in-chart", "title": "Range buttons in a chart", "lead": "To add buttons for common spans back from the last date, set `Ranges` on the `ChartRangeSelector`.",
          "notes": { "noscript": "The strip shows the part in view, and nothing moves." } },
        { "id": "range-selector-filter", "title": "Filtering by a date range", "lead": "On its own, give `RangeSelector` the `Items`, an `Argument`, a `Label` and a series to draw. `@bind-View` is the range chosen, here the dates whose orders the grid lists.", "modes": ["interactive"] }
      ]
    },
    {
      "id": "data-grid", "icon": "Table2", "name": "DataGrid", "category": "Data", "parts": ["ActionColumn", "RowAction", "EditAction", "DeleteAction", "EditField", "DataGridAdd", "DataGridSearch", "DataGridExport", "DataGridExportFormat", "DataGridFilterBuilder", "DataGridColumnPicker"], "summary": "Runs admin screens and back-office lists: large sets of records people search, edit and export.", "keywords": ["data grid", "datagrid", "grid", "dynamic columns", "DataTable", "dictionary", "ExpandoObject", "column bands", "column groups", "grouped headers", "multi-column headers", "stacked headers"],
      "features": [
        { "feature": "Sort, filter and page through the URL" },
        { "feature": "Column widths and sideways scrolling, set by the server" },
        { "feature": "Frozen columns" },
        { "feature": "Grouping over all the data, a page of groups at a time", "member": "Groupable" },
        { "feature": "Aggregates over everything the filters match, in the footer and on groups" },
        { "feature": "Virtual rows on interactive pages; loading on scroll on static pages", "member": "Virtualize" },
        { "feature": "A toolbar with search, and room for your own buttons" },
        { "feature": "CSV and Excel export, streamed from an endpoint you map", "member": "ExportCsvHref" },
        { "feature": "Editing a row in a dialog, saved by a form post", "member": "EditMode" },
        { "feature": "Row menus, also opened by right-click, long press or the keyboard", "member": "ActionColumn" },
        { "feature": "Resizing, moving and hiding columns, saved per user", "member": "ResizableColumns" },
        { "feature": "Selected rows post with a form" },
        { "feature": "Selecting rows by a click, with or without boxes", "member": "SelectOnClick", "noscript": "partial" },
        { "feature": "Sorting by several columns: Shift+click a header, or Add to sort in its column menu" },
        { "feature": "One Tab stop and arrow keys between cells, with selection keys", "noscript": "none" }
      ],
      "examples": [
        { "id": "data-grid-basic", "title": "A basic grid", "lead": "A data grid shows records as rows that the user can sort, filter and page. Set `Items` and an `ItemKey`, and add a `PropertyColumn` for each property to show.", "after": ["Add `Sortable` to a column to sort by it and `Filterable` to filter it. Set `PageSize` for the rows per page.", "The sort, filters and page are kept in the URL, so the grid works on static pages and with JavaScript off.", "For a plain list of records, use Table, which DataGrid is built on. Choose DataGrid when users edit, group or arrange columns."] },
        { "id": "data-grid-columns", "title": "Columns", "lead": "Columns share the grid's width. To give a column a fixed width, set `Width`.", "after": ["Columns without one share the remaining space, down to their `MinWidth`; below that, the grid scrolls sideways. Shift+click a header to add that column to the sort, or, with another column sorted, pick Add to sort in its column menu."] },
        { "id": "data-grid-appearance", "title": "Row appearance", "lead": "Stripes, lines and a shaded header make rows easier to follow. Set `Striped`, `ColumnLines` or `ShadedHeader`, or set `RowLines` to false to remove the lines between rows.", "after": ["To highlight the row under the pointer, which helps on wide rows, set `RowHover`. It's off by default, because a highlight suggests the row can be clicked. Rows with a `RowHref` always have it."] }
      ],
      "topics": [
        {
          "id": "columns", "title": "Columns", "summary": "Users resize, move, hide and freeze columns, and the grid saves their layout for the next visit.", "members": ["WrapCells", "Column.Wrap", "LayoutKey", "Layout", "LayoutSaveUrl", "ResizableColumns", "ReorderableColumns", "ColumnPicker", "DataGridColumnPicker", "Column.Title", "Column.Align", "Column.Width", "Column.MinWidth", "Column.MaxWidth", "Column.Frozen", "Column.Resizable", "Column.Reorderable", "Column.Pickable", "Column.Visible", "DynamicColumn", "ColumnBand"],
          "examples": [
            { "id": "data-grid-arrange", "title": "Rearranging columns", "lead": "To let users resize, move and hide columns, set `ResizableColumns`, `ReorderableColumns` and `ColumnPicker`. To save each user's layout, set `LayoutKey`.", "after": ["The user drags a header or its edge, or uses the keys and the ⋮ menu in each header, which also sorts, freezes, fits columns to their content and hides a column.", "The Columns button opens a list of the columns in the grid's order, with a search. Check a column to show it, and drag a row's handle, or open its menu, to move it.", "`LayoutKey` saves the layout in a cookie, per user and per page. The server renders it from the first paint.", "A column with `Visible` set to false starts hidden, and the user can show it from the picker. With `Pickable` false too, it stays hidden."] },
            { "id": "data-grid-frozen", "title": "Frozen columns", "lead": "A frozen column stays in view at the grid's start or end while the rest scroll sideways. Set `Frozen` on the column; it works with JavaScript off.", "after": ["A frozen column needs a `Width`, and sits at its edge wherever it's declared.", "With `ReorderableColumns`, users freeze columns from a header's ⋮ menu too, as with a spreadsheet's frozen panes. Freeze columns › To the left freezes every column to that column's left, and To the right every column to its right.", "Freezing again moves the line, and Unfreeze removes it. The columns don't change places."],
              "info": { "title": "When frozen columns scroll", "text": "Frozen columns scroll like the rest on a screen narrower than 640px, and when together they'd leave less than 3rem of the grid for the columns that scroll, which would leave no way to reach them. The line where frozen columns stop shows only while they stay put. Once the grid is wide enough again, they're frozen again." } },
            { "id": "data-grid-column-bands", "title": "Column bands", "lead": "A column band is a header over several columns, such as a quarter over its revenue and margin. Put the columns in a `ColumnBand` with a `Title`; a band can hold bands for another row of headers.", "after": ["Sorting, filtering and widths stay on the columns. A column outside any band has an empty cell above its header.", "Users move a column only among its band's columns, and move a band as a whole.", "A band is frozen as one: freezing any of its columns freezes all of them. Give a band's columns the same `Frozen`."] },
            { "id": "data-grid-dynamic-columns", "title": "Columns at run time", "lead": "To add columns known only at run time, such as one for each quarter in the data, write a `DynamicColumn` for each in a loop. Set `Field` to the name to read and `Type` to its values' type, such as `typeof(decimal)`.", "after": ["Rows can be dictionaries, `DataRow`s (`Items=\"table.Rows.Cast<DataRow>()\"`) or `ExpandoObject`s, so an `IEnumerable<dynamic>` works too.", "`Type` works as a property's type does for `PropertyColumn`: it picks the filter, the alignment, grouping and aggregates, and what `Format` applies to. Without a `Type`, values are text. A value that's missing, or doesn't convert, shows empty.", "The sort key in the URL is the field's letters and digits in lower case, with an underscore for anything else, so `Q1 2026` sorts as `?sort=q1_2026`.", "The columns sort, filter and search as any others, but they aren't edited."] },
            { "id": "data-grid-one-line", "title": "Text on one line", "lead": "Text too long for its column wraps by default, making the row taller. To keep every row one line high, set `WrapCells` to false: long text ends in an ellipsis, and the whole of it shows in a tooltip.", "after": ["The tooltip shows only when the text is cut off: on hover, and at once when the cell has focus, by the keys or a tap. Escape hides it. Header titles that don't fit get the same tooltip.", "To set one column apart, set its `Wrap`. Numbers stay on one line either way, and with `Virtualize` every cell does."] }
          ]
        },
        {
          "id": "toolbar", "title": "Toolbar", "summary": "The toolbar above the grid holds your buttons, a search box and the grid's own tools, in the order you choose.", "members": ["ToolbarContent", "Searchable", "ToolbarLabels", "DataGridSearch", "DataGridExport", "DataGridColumnPicker"],
          "examples": [
            { "id": "data-grid-toolbar", "title": "Toolbar and search", "lead": "The toolbar sits above the grid. To add buttons, put `ToolbarButton`s in `ToolbarContent`; to add a box that searches the text columns, set `Searchable`.", "after": ["The search is kept in the URL, so a link or a reload keeps it. It looks for the words in every text column."] },
            { "id": "data-grid-toolbar-order", "title": "Placing the toolbar's tools", "lead": "To place the grid's own tools among your buttons, add `DataGridSearch`, `DataGridExport` or `DataGridColumnPicker` to `ToolbarContent`. They appear in the order written.", "after": ["Add them directly, not inside a component of your own. A tool you don't add stays in its usual place, and the grid's parameter still turns it on.", "Export and Columns show only an icon with a tooltip. To add text to both, set `ToolbarLabels`; to add it to one, set its `ShowLabel`."] }
          ]
        },
        {
          "id": "selection", "title": "Selection", "summary": "Checkboxes select rows to act on, and a bar of actions takes the toolbar's place. The selection posts with a form or binds to C#.", "members": ["ItemKey", "SelectionMode", "SelectionName", "Selection", "ItemSelectable", "SelectAllMode", "SelectionActions", "SelectAllLabel", "SelectRowLabel", "SelectOnClick"],
          "examples": [
            { "id": "data-grid-select-rows", "title": "Selecting rows", "lead": "Row selection adds a checkbox to each row, so the user can pick rows to act on. Set `SelectionMode=\"SelectionMode.Multiple\"` and an `ItemKey`. For a radio button on each row instead, set `SelectionMode.Single`.", "after": ["While rows are selected, the buttons in `SelectionActions` take the toolbar's place, so the rows don't move.", "In a form, the checked rows post their keys, so selection works with JavaScript off. Read them as a `Selection` with `[SupplyParameterFromForm]`, or bind `@bind-Selection` on interactive pages, then call its `Apply` to find the rows.", "The header checkbox selects the rows on the current page. To make it select every row the filters match, on any page, set `SelectAllMode=\"SelectAllMode.All\"`."] },
            { "id": "data-grid-pick-row", "title": "Selecting a row by a click", "modes": ["interactive"], "lead": "To select a row by clicking it, set `SelectOnClick`. With `SelectionMode.Single` the rows have no radio buttons, and the selected row shows by its tint. A click or Space selects a row, and Space on the selected row clears it.", "after": ["Clicks on the row's links, buttons and fields stay theirs. With `SelectionMode.Multiple` the checkboxes stay: a click selects only that row, Ctrl+click adds or removes one, and Shift+click selects a range.", "It needs IzzyBlazor's script. With JavaScript off, each row shows its radio button again. A row with a `RowHref` opens its link on a click, so it can't take both."] }
          ]
        },
        {
          "id": "row-actions", "title": "Row actions", "summary": "Each row's actions sit at its end or in a ⋮ menu, and cells can hold your own buttons, links and fields.", "members": ["ActionColumn", "RowAction", "RowLabel", "RowHref"],
          "examples": [
            { "id": "data-grid-row-menu", "title": "Row menus", "lead": "A row menu is a ⋮ button on each row that opens the row's actions. Add an `ActionColumn` of `RowAction`s and set its `Overflow` to `RowActionOverflow.Always`.", "after": ["With IzzyBlazor's script, a right-click or a long press opens the same menu. The menu acts on the row it was opened from, whatever is selected.", "Right-clicking a link still opens the browser's own menu."] },
            { "id": "data-grid-cells", "title": "Controls in cells", "lead": "To put buttons, links or fields in cells, use a `TemplateColumn`. The keys that reach them are in the Keyboard table." }
          ]
        },
        {
          "id": "editing", "title": "Editing", "summary": "Users add, edit and delete rows in a dialog, in the row itself, or one cell at a time.", "members": ["EditMode", "FindItem", "NewItem", "ItemEditable", "ItemDeletable", "EditKey", "EditCopy", "OnSave", "OnDelete", "ActionColumn", "RowAction", "EditAction", "DeleteAction", "EditDialog", "EditField", "EditColumns", "EditLayout", "EditDialogSize", "EditDialogTitle", "EditDialogForm", "DataGridAdd", "Column.Editable", "Column.EditTemplate"],
          "intro": [
            "Choose a mode by what there is to edit. `DataGridEditMode.Dialog` has room for many fields, including ones the table doesn't show, and works with rows that load as they're needed. `DataGridEditMode.Row` keeps the row in place, for a few short fields.",
            "`DataGridEditMode.Cell` is the quickest way to change one value at a time, on interactive pages. Dialog and Row also work on static pages and with JavaScript off.",
            "A field shows the value itself, not what the column's `Format` makes of it: a number has no currency sign, and a date follows the browser's language, which can differ from the server's culture the column formats with."
          ],
          "examples": [
            { "id": "data-grid-editing", "title": "Editing rows", "lead": "Dialog editing opens a form in a dialog where the user adds or edits a row. Set `EditMode` to `DataGridEditMode.Dialog`, and handle `OnSave`.", "after": ["Each column, shown or not, gets a field that matches its type. To lock one, such as the key, set its `Editable` to false. A save is a form post, and only editable columns receive a value from it.", "To reject a save, call `AddError` in `OnSave`. The dialog stays open with the error on its field.", "To add an Add button, set `NewItem`. To add a Delete action that asks first, set `OnDelete`. To limit editing or deleting by row, set `ItemEditable` or `ItemDeletable`.", "To order the actions or add your own, write an `ActionColumn`.", "The grid needs an explicit `TItem`. On static pages, the row type also needs a parameterless constructor."] },
            { "id": "data-grid-edit-in-row", "title": "Editing in the row", "lead": "Row editing changes a row where it stands, with Save and Cancel in place of its actions, and suits a few short fields. Set `EditMode` to `DataGridEditMode.Row`; it works with JavaScript off.", "after": ["Only the columns shown have a field, so a hidden column keeps its value. A new row starts at the top of the page.", "Sorting or changing page ends the edit and drops what was typed. It can't be used with `Virtualize` or loading on scroll."] },
            { "id": "data-grid-edit-cells", "title": "Editing one cell at a time", "modes": ["interactive"], "lead": "Cell editing changes one value at a time, the quickest way to make small changes. Set `EditMode` to `DataGridEditMode.Cell`.", "after": ["A click, Enter, F2 or typing opens a cell. Tab, Enter or a click elsewhere saves it.", "`OnSave` runs for each cell that changed, and an invalid cell stays open. A new row is edited as with `Row`.", "Cell editing is for interactive pages. On static pages the same grid edits a row at a time, as with `Row`."] },
            { "id": "data-grid-two-columns", "title": "Laying out the edit dialog", "lead": "To lay out the edit dialog's form, set `EditColumns`, `EditLayout`, `EditDialogSize` and `EditDialogTitle`. This example uses two columns in a large dialog.", "after": ["In `EditDialog`, an `EditField` sets each field's place, `ColSpan`, `Label` and `Hint`. A column's `EditTemplate` replaces its field with your own.", "To show a disabled Delete with a tooltip instead of hiding it, set `DisabledReason` on the `DeleteAction`."] },
            { "id": "data-grid-own-form", "title": "A custom form in the dialog", "lead": "For a form that isn't fields of the row, write it in `EditDialogForm`; its context's `CloseAsync` closes the dialog once you've saved. The grid opens and closes the dialog; the form, its model and its post are yours. On static pages, guard against forged fields with a view model, as this example does." }
          ]
        },
        {
          "id": "filtering", "title": "Filtering", "summary": "Users filter each column from its header or from a filter row under the titles. A filter builder combines conditions across columns.", "members": ["Filter", "FilterCase", "FilterPanel", "FilterRow", "FilterBuilder", "FilterFromQuery", "Searchable", "Search", "SearchLabel", "DataGridSearch", "DataGridFilterBuilder", "Column.Filterable", "Column.FilterOperators", "Column.Filter", "Column.FilterValues", "Column.FilterList", "Column.FilterTemplate", "Column.FilterText"],
          "examples": [
            { "id": "data-grid-filters", "title": "Column filters", "lead": "A column filter narrows the rows by the values in one column, from a panel the filter icon in its header opens. Set `Filterable` on a column to add one.", "after": ["In the panel, the user picks an operator, such as contains or between, and enters a value.", "To limit the operators a column offers, set `FilterOperators`; the first one is the default. To list every active filter below the rows, set `FilterPanel`."],
          "notes": {
            "noscript": "Press Enter or Apply in the filter to submit it. An operator with no value is no filter.",
            "static": "A panel's changes wait for Apply or Enter, and closing it any other way drops them." } },
            { "id": "data-grid-filter-row", "title": "A row of filters", "lead": "A filter row puts a field under each filterable column's title, so the user filters without opening a panel. To add it, set `FilterRow` on the grid.", "after": ["The funnel beside each field opens the column's full filter, where the user can change the operator.", "A column that filters by a list, a range or a date shows its current value in the field. Clicking the field opens the full filter.", "To set the titles and the filter row apart from the rows, set `ShadedHeader`."],
          "notes": {
            "noscript": "Press Enter in a field to filter." } },
            { "id": "data-grid-custom-filter", "title": "A column's own filter", "lead": "To replace a column's standard filter controls with your own, put them in its `FilterTemplate`. This example offers checkboxes for a few customers and a select of minimum totals.", "after": ["Your controls appear above Clear and Apply. Spread the context's `Attributes` on each control, or `CheckboxAttributes` on a native checkbox. Its value filters the column with the column's first operator.", "Several values filter with Is any of. A library field also needs the context's `SetAsync` as its `ValueChanged`.", "To show readable text for the filter in the filter row and its tag, set `FilterText`. To decide yourself what a value matches, build the condition with the column's `Filter`."],
          "notes": {
            "noscript": "Press Apply to submit it." } },
            { "id": "data-grid-filter-builder", "title": "A filter builder", "lead": "A filter builder combines conditions across columns with and or or, such as a status of Paid or a total over 1,000, which column filters can't express. Set `FilterBuilder` to add a button that opens it. The conditions it builds apply together with the column filters, and are kept in the URL as `?filter=`.",
          "notes": { "noscript": "The button is hidden. A `?filter=` link still applies." } }
          ]
        },
        {
          "id": "aggregates", "title": "Aggregates", "summary": "Aggregates show totals, averages and counts in the footer, calculated over every row the filters match.", "members": ["Column.Aggregate", "Column.GroupAggregate", "Column.GroupFooterAggregate", "Column.AggregateBy", "Column.AggregateFormat", "Column.AggregateLabel", "Column.AggregateTemplate", "Column.FooterText", "Column.Footer"],
          "examples": [
            { "id": "data-grid-aggregates", "title": "Footer totals", "lead": "An aggregate shows a sum, average, lowest, highest or count in the footer. Set `Aggregate` on a column, or `AggregateBy` for your own, as an expression that runs in the database.", "after": ["It covers every row the filters match, not just the page, and needs no grouping. With an `ItemsProvider`, add a `GroupsProvider` to calculate the totals."] }
          ]
        },
        {
          "id": "grouping", "title": "Grouping", "summary": "Grouping puts rows under a heading row for each value of a column, with a count or total on each group.", "members": ["Groupable", "Group", "InitialGroup", "ExpandAllGroups", "ExpandedGroups", "GroupRowLimit", "GroupPanel", "ShowGroupedColumns", "GroupsProvider", "Column.Groupable", "Column.GroupBy", "Column.GroupFormat", "Column.GroupTemplate"],
          "examples": [
            { "id": "data-grid-grouping", "title": "Groups", "lead": "Grouping puts rows under a heading row for each value of a column. To offer grouping in each header's menu, set `Groupable`; to start grouped, set `InitialGroup`.", "after": ["The grouping is kept in the URL, as `?group=status`, and each group's row is a link that opens it. Grouping works on static pages and with JavaScript off.", "A page counts top-level groups, so a group is never split across pages. A group's count covers the whole group.", "To show a value on each group's row, set `GroupAggregate`. For one under an open group's rows, set `GroupFooterAggregate`.", "With an `ItemsProvider`, add a `GroupsProvider`. Rows still come from your provider, with the group's value in the filter."] }
          ]
        },
        {
          "id": "master-detail", "title": "Master-detail", "summary": "A row's detail opens underneath it, such as an order's lines in a grid of their own.", "members": ["DetailTemplate", "ItemHasDetail", "ExpandedDetails", "ExpandAllDetails", "SingleDetail", "ItemKey"],
          "examples": [
            { "id": "data-grid-master-detail", "title": "A row's detail", "lead": "A row's detail opens under the row, across the grid, such as an order's lines. Set `DetailTemplate`, and an `ItemKey` to keep track of open rows.", "after": ["Each row gets a button in a column of its own, and the header's button opens them all.", "Open rows are kept in the URL, as `?detail=1004`, so details work on static pages and with JavaScript off. To keep them in the component instead, bind `ExpandedDetails`.", "Only open rows render their detail, so a nested grid loads its rows, from an `ItemsProvider` too, only when its row opens. Give a nested grid its own `QueryPrefix`, or every row's grid shares one sort and page."] },
            { "id": "data-grid-grouped-detail", "title": "Details in groups", "lead": "In a grouped grid, a row's detail opens under it, inside its group, and its button sits one level in from the group's. To keep one detail open at a time, set `SingleDetail`.", "after": ["To leave the button off rows with nothing to show, set `ItemHasDetail`. To start with every row open, set `ExpandAllDetails`."] }
          ]
        },
        {
          "id": "reordering", "title": "Reordering rows", "summary": "Users put rows in their own order by dragging a handle or from its menu, and the grid posts or binds the new order.", "members": ["ReorderableRows", "OrderName", "Order", "SubmitOnMove", "OnMove", "ItemMovable", "ItemKey", "RowLabel"],
          "examples": [
            { "id": "data-grid-reorder-rows", "title": "Reordering rows, and saving the order", "lead": "To let users put rows in their own order, set `ReorderableRows` and an `ItemKey`, and give the grid every row in `Items`. Each row gets a drag handle at its start, which also opens a menu of moves.", "after": ["On static pages, give the grid an `OrderName` inside a form and pass the posted `ListOrder` back as `Order`. `Order.Arrange` puts your rows in the posted order.", "On interactive pages, bind `@bind-Items` to keep the new order.", "Rows move only in the grid's own order. While it's sorted, filtered, searched or grouped, the handles are disabled, so leave those off."], "notes": {"noscript": "Each move in a handle's menu posts the form. The page reloads with the row moved and its handle focused. Save order saves.", "static": "Drag a handle, or use its menu or Alt+arrow keys. Rows move on the page and the move is announced. Save order posts the new order.", "interactive": "Drag a handle, or use its menu or Alt+arrow keys. C# updates the grid at once and the move is announced. Save order shows the order @bind-Items keeps."}}
          ]
        },
        {
          "id": "adaptability", "title": "Adaptability", "summary": "On a phone or in a narrow panel, the grid hides the columns that don't fit and shows their values under the row.", "members": ["SmallScreen", "Nonce", "ItemKey", "Column.Priority", "ActionColumn.Overflow"],
          "examples": [
            { "id": "data-grid-hide-columns", "widthSwitch": true, "title": "Columns that hide", "lead": "To hide the columns that don't fit a narrow screen instead of scrolling sideways, set `SmallScreen=\"DataGridSmallScreen.HideColumns\"` and an `ItemKey`. A button at the start of each row then opens its detail, with the hidden columns' values in it.", "after": ["Columns hide lowest `Priority` first. The first column and frozen ones never hide.", "The row's actions move into its ⋮ menu, unless one sets `Overflow=\"RowActionOverflow.Never\"`. The toolbar moves your buttons and Export into its … menu.", "The grid goes by its own width, so this works in a side panel too, and with JavaScript off. To sort or filter a hidden column, use the column picker or the filter chips.", "It can't be used with `Virtualize`."] },
            { "id": "data-grid-hide-columns-detail", "widthSwitch": true, "title": "With groups and a detail", "lead": "In a grouped grid, a row's button sits one level in from its group's, as for any detail. With a `DetailTemplate`, the button column is always there, and the hidden values come first in the detail, above the template. A frozen column, here the total at the end, never hides." },
            { "id": "data-grid-hide-columns-edit", "widthSwitch": true, "title": "Editing a row", "lead": "With `DataGridEditMode.Row`, editing a row opens its detail, with fields for the hidden columns, while Save and Cancel stay in the row. Adding a row works the same way.",
          "notes": {
            "noscript": "The detail shows the hidden columns' values and any message instead of fields, as it does if IzzyBlazor's script fails to load. An edited row keeps those values, and a new row gets their defaults. Edit them where the grid is wide enough to show them."
          } }
          ]
        },
        {
          "id": "export", "title": "Export", "summary": "Export downloads the rows the user sees, with the same filters and sort, as an Excel or CSV file, or a format of your own.", "members": ["ExportCsvHref", "ExportExcelHref", "DataGridExport", "DataGridExportFormat", "ExportHref", "Column.Exportable"],
          "examples": [
            { "id": "data-grid-export", "title": "Export to Excel", "lead": "Export downloads the rows the user sees as an Excel file. Set `ExportExcelHref` to an endpoint you map with `DataExport.WriteExcelAsync`.", "after": ["The endpoint streams rows from the database without loading them all into memory. The link carries the filter, sort, search and visible columns, and works with JavaScript off.", "The fields you give `DataExport` decide what can be written, whatever the URL asks for, and their captions head the file.", "Give them the grid's keys so a download matches the screen. A filter on a key they don't have matches nothing."] },
            { "id": "data-grid-export-both", "title": "Excel and CSV", "lead": "To offer CSV too, add `ExportCsvHref`. One button with a chevron then opens a menu of both formats, Excel first." },
            { "id": "data-grid-export-formats", "title": "Other formats", "lead": "Add a `DataGridExportFormat` among the columns for a format the library doesn't write, such as JSON or PDF. It joins the menu after Excel and CSV, and its link carries the same filter, sort, search and columns.", "after": ["Its endpoint calls `DataExport.Read` with the address and your fields, and writes the columns and rows it gets: the same ones the Excel and CSV writers get. The Downloads article has a PDF endpoint built this way.", "For a button of your own on an interactive page, `ExportHref` gives the same address. A column with `Exportable=\"false\"`, such as an internal cost, stays out of every format's file.", "For rows read by `DynamicColumn`, build the endpoint's fields with `DataFields.ByName`, which reads and keys them the same way."] }
          ]
        },
        {
          "id": "server-data", "title": "Server data", "summary": "Rows, groups and totals load from your database a page at a time, or as the user scrolls.", "members": ["ItemsProvider", "GroupsProvider", "Virtualize", "RowHeight", "MaxHeight", "PageSize"],
          "examples": [
            { "id": "data-grid-server-data", "title": "Loading from a database", "lead": "To load rows from a database, set `ItemsProvider`. It gets a `DataRequest` with the page, sort and filters, and `request.ToResultAsync` runs them as one query. For grouping and footer totals, add a `GroupsProvider`, which `DataGroupRequest.ToResultAsync` answers the same way.", "after": ["To skip the providers, pass an EF Core `IQueryable` as `Items`; the grid builds the same queries. Table's Loading data page covers the request in full, including rows from an API."] },
            { "id": "data-grid-virtual-rows", "title": "Virtual rows", "lead": "Virtual rows render only the rows in view, so 100,000 rows scroll as easily as 100. Set `Virtualize`, which works on interactive pages.", "after": ["It needs a `MaxHeight`, and each row must fit one line of `RowHeight`. On static pages the same grid loads more rows as the user scrolls.", "This example is static unless you switch the page to Interactive."] }
          ]
        }
      ]
    },
    {
      "id": "tree-list", "icon": "FolderTree", "name": "TreeList", "category": "Data", "parts": ["AddChildAction", "MoveAction"], "summary": "Shows rows nested in rows, such as an org chart or a folder tree, in a grid's columns.", "keywords": ["tree list", "treelist", "tree grid", "treegrid", "tree table", "hierarchy", "parent id", "self-referencing", "org chart", "bill of materials"],
      "features": [
        { "feature": "Nested rows from a flat list with a parent key, or from children", "member": "ItemParentKey" },
        { "feature": "Open rows in the URL, so a static page opens them by a link" },
        { "feature": "Open rows bound to C#", "member": "ExpandedItems", "noscript": "none" },
        { "feature": "Sorting within each row's children" },
        { "feature": "Filters and search that keep the rows above a match", "member": "FilterBranch" },
        { "feature": "Pages of top rows, so a branch is never split" },
        { "feature": "Rows from a database a level at a time, loaded as rows open", "member": "ItemsProvider" },
        { "feature": "Up to 200 rows under a row, then Show more", "member": "ChildRowLimit" },
        { "feature": "Virtual rows over every open branch, on interactive pages", "member": "Virtualize", "noscript": "none", "static": "none" },
        { "feature": "Checking a row checks the rows under it, open or not", "member": "Cascade" },
        { "feature": "A row's total of its branch, and the footer's of every match", "member": "Column.RollUp" },
        { "feature": "Excel and CSV export that keeps the tree's levels", "member": "ExportExcelHref" },
        { "feature": "Editing as in a DataGrid, and adding a row under another", "member": "NewChild" },
        { "feature": "Moving a row under a new parent from a dialog, with no script needed", "member": "OnReparent" },
        { "feature": "Dragging a row before, after or into another", "member": "MoveByDrag", "noscript": "none" },
        { "feature": "Treegrid keys: Right opens a row, Left closes it or goes to its parent", "noscript": "none" }
      ],
      "examples": [
        { "id": "tree-list-org-chart", "title": "A flat list with parent keys", "lead": "For rows stored with a parent's id, as in most databases, pass every row as `Items` and set `ItemParentKey`. A row with no parent, or one that isn't in the list, is a top row. `ItemExpanded` chooses the rows that start open.", "after": ["Sorting orders each row's children among themselves, so a row never leaves its parent. Open rows are in the address, so a link or a reload keeps them."] },
        { "id": "tree-list-files", "title": "Nested rows and icons", "lead": "For rows that hold their children, pass the top rows as `Items` and set `ItemChildren`. `ItemIcon` draws an icon before a row's value in the first column, and is told whether the row is open." }
      ],
      "topics": [
        {
          "id": "filtering", "title": "Filtering", "summary": "Filters and search keep each match with the rows above it, so the user sees where it belongs.", "members": ["Searchable", "FilterBranch", "Filter", "FilterPanel", "Column.Filterable"],
          "examples": [
            { "id": "tree-list-tasks", "title": "Matches and the rows above them", "lead": "A filter or search in a tree list keeps each matching row and the rows above it, open, so the user sees where the match belongs. Set `Filterable` on a column, or `Searchable` on the tree list.", "after": ["The rows above a match are muted, because they don't match themselves. Screen readers still read them.", "The filters and the search are in the address, as in a DataGrid. While a filter is on, every row with a match under it opens; clearing the filter closes them again."] },
            { "id": "tree-list-catalog", "title": "Keeping a match's branch", "lead": "To keep the rows under a match too, set `FilterBranch`. A search for a category then lists its products, not just the category's row." }
          ]
        },
        {
          "id": "open-rows", "title": "Open rows", "summary": "Rows open from the address, from a link, or from C# when the open rows are bound.", "members": ["ExpandedItems", "ExpandAll", "ItemExpanded"],
          "examples": [
            { "id": "tree-list-budget", "title": "Opening rows from C#", "modes": ["interactive"], "lead": "To open and close rows from your code, bind `@bind-ExpandedItems` on an interactive page. It holds the keys of the open rows, and the tree list keeps it in step as the user opens and closes them.", "after": ["`*` in the list opens every row, `!*` closes every row, and `!key` closes one row that would otherwise start open.", "To choose the rows that start open, set `ExpandAll` for every row or `ItemExpanded` for some, such as the top level. Without a binding, the open rows are in the address as `?open=`, which works on static pages and with JavaScript off."] }
          ]
        },
        {
          "id": "selection", "title": "Selection", "summary": "Checkboxes select rows, and checking a row checks the rows under it.", "members": ["SelectionMode", "Selection", "SelectionName", "Cascade", "SelectOnClick", "SelectionActions", "ItemSelectable"],
          "examples": [
            { "id": "tree-list-backup", "title": "Checking a branch", "lead": "Checking a row checks the rows under it, and a row with some of them checked shows a mixed box. Set `SelectionMode=\"SelectionMode.Multiple\"`; to make each box its own, set `Cascade` to false.", "after": ["A checked row stands for its whole branch, opened or not: rows under it come in checked when they open, and unchecking one unchecks the rows above it. A row whose rows are all checked is checked too.", "To find every row the selection means, call `selection.ApplyTree` with the key and the parent key. It adds the rows under each checked row, a level at a time.", "While filtering, the muted rows above a match have no box, so the selection holds only matches."] }
          ]
        },
        {
          "id": "editing", "title": "Editing", "summary": "Rows are edited as in a DataGrid, an action adds a row under another, and Move puts a row under a new parent.", "members": ["EditMode", "OnSave", "NewItem", "NewChild", "OnReparent", "MoveByDrag", "ItemMovable", "OnDelete", "ItemEditable", "ItemDeletable"],
          "examples": [
            { "id": "tree-list-edit-plan", "title": "Editing and adding rows under others", "lead": "A tree list edits as a DataGrid does: set `EditMode` and handle `OnSave`. To add a row under another, set `NewChild` and put an `AddChildAction` in the `ActionColumn`.", "after": ["`NewChild` gets the row the new one goes under, so it can set the parent's id. The new row opens under it, which opens if it was closed, and `OnSave` gets it with `IsNew` set.", "`NewItem` adds a top row, from the toolbar's Add. Deleting a row is yours to handle, so decide there what happens to the rows under it: this example deletes them too.", "To move a row under another, add a `MoveAction` and handle `OnReparent`. Its dialog offers every row but the moving one and its branch, under Top level; `OnReparent` gets the new parent, or none, and the row's place after its new siblings.", "To drag rows too, set `MoveByDrag`: each row gets a handle, and a drop on a row's top or bottom edge puts it before or after, its middle under it. A drop moves the row at once, on a static page too; pressing a handle opens the Move dialog."] }
          ]
        },
        {
          "id": "totals-and-export", "title": "Totals and export", "summary": "Rows show the totals of their branches, the footer the totals of every match, and exports keep the tree's levels.", "members": ["Column.RollUp", "Column.Aggregate", "GroupsProvider", "ExportExcelHref", "ExportCsvHref"],
          "examples": [
            { "id": "tree-list-totals", "title": "Totals and export", "lead": "To show a row's total of the rows under it, such as a phase's hours, set `RollUp` on the column. The footer's `Aggregate` works as in a DataGrid, over every row the filters match.", "after": ["A rolled-up row shows the sum, average, lowest, highest or count of the rows at the ends of its branch, the ones with nothing under them, so no value is counted twice. While filtering, it counts only the rows kept. It needs `Items`: with an `ItemsProvider`, give the rows their totals, and add a `GroupsProvider` for the footer.", "The export keeps the tree: give the endpoint's `DataExport.WriteExcelAsync` or `WriteCsvAsync` a `tree: DataExportTree<T>.Of(key, parent)`. Excel shows the levels as an outline, so the rows fold, and CSV indents the first column.", "While filtering, the rows above a match come too. To write the rolled-up totals, add `.RollUp(\"hours\", DataAggregate.Sum)` for each such column."] }
          ]
        },
        {
          "id": "server-data", "title": "Server data", "summary": "Rows load from your database a level at a time, as the user opens them, and large trees draw only the rows in view.", "members": ["ItemsProvider", "ItemHasChildren", "ChildRowLimit", "ItemKey", "Virtualize", "RowHeight", "MaxHeight"],
          "examples": [
            { "id": "tree-list-file-storage", "title": "Loading a level at a time", "lead": "To load rows from a database as they open, set `ItemsProvider` instead of `Items`. The tree list asks for the top rows, then for the children of each open row, with that row's key in `request.Parent`. `request.ToTreeResult` answers it from a query, given the key and the parent key.", "after": ["Set `ItemHasChildren` so a row shows its chevron before its children load. Without it, every row gets one, and a row that opens to none loses it.", "Sorting, filters and search go with every request. While filtering, `ToTreeResult` keeps the rows that match and the rows above them, which takes a query for each level above a match. With EF Core, use `ToTreeResultAsync` with `CountAsync` and `ToListAsync`.", "A row shows at most 200 rows under it, then Show more, which adds as many again. Set `ChildRowLimit` to change it."] },
            { "id": "tree-list-directory", "title": "Virtual rows", "modes": ["interactive"], "lead": "Virtual rows draw only the rows in view, so a tree with thousands of rows open scrolls as easily as a short one. Set `Virtualize`, with a `MaxHeight` and a `RowHeight`; it works on interactive pages.", "after": ["Every visible row is worked out from `Items`, open branches included, and opening or closing a row keeps the place in the list. There's no Show more, and each row is one line high.", "On a static page the same tree pages by its top rows."] }
          ]
        },
        {
          "id": "adaptability", "title": "Adaptability", "summary": "On a phone or in a narrow panel, the tree list hides the columns that don't fit and shows their values under the row.", "members": ["SmallScreen", "Column.Priority", "ItemKey"],
          "examples": [
            { "id": "tree-list-narrow", "widthSwitch": true, "title": "Columns that hide", "lead": "To hide the columns that don't fit a narrow screen instead of scrolling sideways, set `SmallScreen=\"DataGridSmallScreen.HideColumns\"`. Columns hide lowest `Priority` first, and a button at the end of each row shows their values under it.", "after": ["The first column stays, with each row's indent and chevron, so the tree still reads; the button is at the row's end, as a DataGrid's would sit beside the tree's chevron. A row's hidden values open under it at its level, and stay open as the rows around it open and close."] }
          ]
        }
      ]
    },
    {
      "id": "list-view", "icon": "List", "name": "ListView", "category": "Data", "summary": "Displays a list of items users can open, select, page through and reorder.", "keywords": ["data list", "list box", "reorder", "drag and drop", "sortable"],
      "features": [
        { "feature": "Links, the current item, actions and a ⋯ menu on each item" },
        { "feature": "Selection that posts with a form or binds in C#" },
        { "feature": "Paging, Load more and loading on scroll" },
        { "feature": "Reordering from each handle's menu (with JavaScript off, each move posts the form)" },
        { "feature": "Dragging, Alt+arrow shortcuts and announcements", "noscript": "none" },
        { "feature": "The new order bound to C#", "member": "Items" }
      ],
      "examples": [
        {"id": "list-view-contacts", "title": "Links and the current item", "lead": "Each item can show text, a description and an icon without a template: set `ItemText`, `ItemDescription` and `ItemIcon`. To make each item a link, set `ItemHref`; to mark the item the page is showing, set `ItemCurrent`."},
        {"id": "list-view-actions", "title": "Actions on items", "lead": "For content at the end of each item, such as a badge or an icon button, set `ItemActions`. For a ⋯ menu of `MenuItem`s, set `ItemMenu`.", "after": ["Keep one or two actions visible and put the rest in the menu. An item whose menu renders nothing has no ⋯ button."], "notes": {"noscript": "Star and each menu item post the form with their Name and Value. The menu opens and closes, but has no arrow keys.", "static": "Star and each menu item post the form with their Name and Value. The menu has arrow keys and type-ahead.", "interactive": "Each button's OnClick runs C#, and nothing is posted."}},
        {"id": "list-view-cards", "title": "Cards in columns", "lead": "To show the items as cards, such as a product gallery, set `Columns`. That many cards fit across from 640px up, and one on phones. With `ItemHref`, each card is a link, and the controls inside it still work."}
      ],
      "topics": [
        {
          "id": "selection", "title": "Selection", "summary": "Checkboxes or radio buttons select items. The selection posts with a form or binds to C#.", "members": ["ItemKey", "SelectionMode", "SelectionName", "Selection", "ItemSelectable", "SelectAllMode", "SelectionActions", "SelectAllLabel", "SelectRowLabel"],
          "examples": [
            {"id": "list-view-select-items", "title": "Selection", "lead": "To give each item a checkbox, set `SelectionMode` to `Multiple`. For a single choice with radio buttons, set it to `Single`.", "after": ["Inside a form, the selected items post their `ItemKey` as a `Selection`. On interactive pages, `@bind-Selection` reads and sets it from C#.", "`SelectAllMode` sets what select-all selects: the current page, or every matching item. With IzzyBlazor's script, a checkbox above the list selects the page."]}
          ]
        },
        {
          "id": "loading-data", "title": "Loading data", "summary": "The list loads items a page at a time, from memory or a database, with a Load more button or as the user scrolls.", "members": ["Items", "ItemsProvider", "ItemKey", "PageSize", "PageSizeOptions", "Page", "Paging", "LoadMoreText", "Cursor", "QueryPrefix", "Loading", "EmptyContent", "EmptyText", "ErrorContent", "ReloadAsync"],
          "intro": [
            "Give the list its items with `Items`, or load them a page at a time with an `ItemsProvider`, which works as it does in Table (see Table's Loading data page). Numbered pages and `DataPaging.NextPrevious` work as in Table too; this page shows the two paging styles that suit a list."
          ],
          "examples": [
            {"id": "list-view-load-more", "title": "Load more", "lead": "To add a Load more button that adds the next page with each press, set `PageSize`, and set `Paging` to `DataPaging.LoadMore`.", "after": ["To make the list scroll inside its box, set `MaxHeight`; the button scrolls with the items.", "The page is kept in the URL, so give each list on a page its own `QueryPrefix`."], "notes": {"noscript": "Load more is a link, and the page reloads with four more items.", "static": "Load more is a link. The list updates without a full reload, and focus moves to the first new item.", "interactive": "Each press adds four items after the ones shown, and focus moves to the first new one."}},
            {"id": "list-view-load-on-scroll", "title": "Loading on scroll", "lead": "The list can load the next page when the last item scrolls into view. Set `Paging` to `DataPaging.LoadOnScroll`, with a `MaxHeight`. A Load more button stays for keyboard users, hidden until it has focus.", "notes": {"noscript": "Nothing loads on scroll. A Load more link after the items reloads the list with one more page.", "static": "Scroll the list: the next page loads as the last item comes into view, without a full reload, and the scroll position is kept.", "interactive": "Scroll the list: the next page loads as the last item comes into view, with a spinner after the items while it loads."}}
          ]
        },
        {
          "id": "reordering", "title": "Reordering", "summary": "Users reorder items by dragging or from the keyboard, and the list posts or binds the new order.", "members": ["Reorderable", "Name", "Order", "SubmitOnMove", "DragWholeItem", "OnMove", "Zone", "Accepts", "MaxItems"],
          "intro": [
            "Every move can be made three ways: by dragging, from a menu of moves, or with Alt+arrow keys. The menu also works with JavaScript off, where each move posts the form. To move items between lists, such as the columns of a board, put the lists in a `DropZoneGroup`."
          ],
          "examples": [
            {"id": "list-view-save-order", "title": "Reordering, and saving the order", "lead": "To let the user reorder the items, set `Reorderable`: each item gets a drag handle with a menu of moves. On interactive pages, `@bind-Items` keeps the new order.", "after": ["On static pages, give the list a `Name` and pass the posted `ListOrder` back as `Order`. `Order.Arrange` puts your items in the posted order."], "notes": {"noscript": "Each move in a handle's menu posts the form. The page reloads with the item moved and its handle focused. Save order saves.", "static": "Drag a handle, or use its menu or Alt+arrow keys. Items move on the page and the move is announced. Save order posts the new order.", "interactive": "Drag a handle, or use its menu or Alt+arrow keys. C# updates the list at once and the move is announced. Save order shows the order @bind-Items keeps."}},
            {"id": "list-view-drag-cards", "title": "Dragging the whole item", "lead": "To let a drag start anywhere on an item, such as a card, set `DragWholeItem`.", "after": ["With a mouse, the drag starts after a small move. On touch, it starts after a long press, so a swipe still scrolls the page. Links, buttons and fields inside the item still work.", "If the list has an `ItemMenu`, there are no handles. Each ⋯ menu ends with a Move submenu, and Alt+arrow keys move the item from the ⋯ button."], "notes": {"noscript": "Nothing drags. The moves under Move in each card's ⋯ menu post the form, and the page reloads with the card moved and its ⋯ button focused.", "static": "Drag a card, or press and hold one on a phone; the other cards move aside to show where it will land. Move in its ⋯ menu and Alt+arrow keys on the ⋯ button move it too. Save layout posts the new order.", "interactive": "Drag a card, press and hold one on a phone, or use Move in its ⋯ menu. C# updates the list and the move is announced."}}
          ]
        }
      ]
    },
    {
      "id": "drop-zone-group", "icon": "Columns3", "name": "DropZoneGroup", "category": "Data", "summary": "Builds kanban boards and available-to-chosen lists, with items dragged between them.", "keywords": ["drag and drop", "kanban", "board", "drop zone", "transfer list"],
      "features": [
