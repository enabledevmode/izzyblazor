    {
      "id": "chat", "icon": "MessagesSquare", "name": "Chat", "category": "Display", "summary": "Builds an AI assistant's chat panel or a conversation between people.", "keywords": ["ai chat", "assistant", "chatbot", "messages", "conversation", "copilot", "llm", "prompt"],
