// The site's registry: every documented component's id (its URL), category and one-line summary,
// the parts documented on its page, and its examples and demo scenarios. Navigation, the
// Components index and cross-links read it; the API metadata (izzyblazor.api.json) supplies the
// rest. Every public component is either listed here or a part of one that is (a test checks).
//
// An example's id names its file: "button-multi-submit" is Examples/Button/MultiSubmit.razor.
{
  "categories": ["Layout", "App shell", "Typography", "Actions", "Forms", "Selection", "Overlays", "Navigation", "Feedback", "Data display", "Charts"],
  "components": [
    {
      "id": "box", "icon": "Square", "name": "Box", "category": "Layout", "summary": "Renders a block that accepts every style prop.",
      "examples": [
        { "id": "box-borders", "title": "Bands, borders and a dashed card" },
        { "id": "box-scheme", "title": "A color scheme for part of a page" },
        { "id": "box-surfaces", "title": "Surfaces", "lead": "To set a background by its place on the page, set `Bg`: `Background` for the page and `Surface` for cards on it.", "after": ["Inside a surface, the three fills, `FillSubtle`, `Fill` and `FillStrong`, each sit a step further from it.", "`SurfaceSunken` sits below the surface in light and dark, for an area that has cards of its own, such as a board's columns. `SurfaceOverlay` is for what floats above, with a `Border` and a `Shadow`."] },
        { "id": "box-contrast", "title": "Text on a color", "lead": "When `Bg` is a theme color, the text uses its matching on-color by itself. To choose your own text color, set `Color`, as this example does on the soft box." },
        { "id": "box-element", "title": "Element and reading width", "lead": "To render another element, such as an `article`, set `As`. To stop text at a comfortable line length (68ch), set `MaxWidth=\"Length.Prose\"`." },
        { "id": "box-visibility", "title": "Showing by breakpoint", "lead": "To hide content from a breakpoint up, set `HiddenFrom`. To show it only from a breakpoint up, set `VisibleFrom`.", "after": ["In this example the button shows its label from Sm (640px) and is an icon button on phones."] }
      ]
    },
    {
      "id": "row", "icon": "Columns3", "name": "Row", "category": "Layout", "summary": "Lays out its children in a row.",
      "examples": [
        { "id": "row-alignment", "title": "Alignment", "lead": "Alignment sets where children sit across the row, between its top and bottom. By default they stretch to the row's height. To line them up on one center line, as the avatar, text and button are here, set `Align` to `Align.Center`." },
        { "id": "row-distribute", "title": "Distributing the free space", "lead": "To share the free space along the row, set `Justify`. `Justify.Between` puts the count at the start and the buttons at the end." },
        { "id": "row-wrapping", "title": "Wrapping", "lead": "Children stay on one line by default. To let them flow onto more lines when they don't fit, set `Wrap`." },
        { "id": "row-stats", "title": "Sharing the width", "lead": "In a wrapping row, children can share the width: give each one a `Grow` and a `Basis`. Here each stat is at least 10rem wide and stretches to fill its line, and one that doesn't fit wraps to the next." }
      ]
    },
    {
      "id": "column", "icon": "Rows3", "name": "Column", "category": "Layout", "summary": "Lays out its children in a column.",
      "examples": [
        { "id": "column-spacing", "title": "Space between children", "lead": "To change the space between a column's children, set `Gap`. For a tighter group inside the column, nest a column with a smaller gap.", "after": ["Here the plan's name and description use `Gap=\"1\"` (4px), and the groups `Gap=\"5\"` (20px)."] },
        { "id": "column-alignment", "title": "Alignment", "lead": "Children stretch to the column's width by default. To keep each one at its own width, as the button here, set `Align=\"Align.Start\"`." }
      ]
    },
    {
      "id": "stack", "icon": "Layers", "name": "Stack", "category": "Layout", "summary": "Lays out its children in a row or a column, changing with the screen width.",
      "examples": [
        { "id": "stack-breakpoints", "title": "Direction by breakpoint", "lead": "A stack can be a row on wide screens and a column on phones. Set `Direction` with a breakpoint map: these features sit side by side from Sm (640px) and stack in a column on phones." },
        { "id": "stack-page-header", "title": "Page header", "lead": "Alignment can change with the screen width too, since `Align` accepts a breakpoint map. In this page header, the title and actions share a line from Sm, spread apart by `Justify.Between`. On phones the actions stack under the title." }
      ]
    },
    {
      "id": "grid", "icon": "LayoutGrid", "name": "Grid", "category": "Layout", "summary": "Lays out its children in columns set by breakpoint, by minimum width or by template.", "parts": ["GridItem"],
      "examples": [
        { "id": "grid-breakpoints", "title": "Columns by breakpoint", "lead": "To set a number of equal columns per breakpoint, set `Columns` with a breakpoint map. Here there's one column on phones, two from Sm (640px) and three from Lg (1024px)." },
        { "id": "grid-min-width", "title": "As many columns as fit", "lead": "To fit as many columns as there's room for, set `MinChildWidth`. Each column is at least that wide, and there are no breakpoints to pick." },
        { "id": "grid-few-items", "title": "Fewer items than columns", "lead": "With `MinChildWidth`, a row with fewer items keeps its empty columns, so every item has the same width (top). To let the items fill the row, add `Stretch` (bottom)." },
        { "id": "grid-side-column", "title": "Custom column sizes", "lead": "To set CSS column sizes per breakpoint, set `Template`. Here, from Sm, a 12rem side column sits beside the results; on phones there's one column." },
        { "id": "grid-spans", "title": "Spanning cells", "lead": "A child can span several columns or rows. Set `ColSpan` on any child to span columns, and wrap a child in a `GridItem` to set `RowSpan`. Here, from Sm, the revenue card spans two columns and two rows, and the activity card spans the whole row with `GridSpan.Full`." }
      ]
    },
    {
      "id": "container", "icon": "RectangleHorizontal", "name": "Container", "category": "Layout", "summary": "Centers content at a readable width.",
      "examples": [
        { "id": "container-reading", "title": "Content width", "lead": "A container caps the content's width and centers it. To change the cap, set `Size`, from Sm (40rem) for forms and short text to Xl (80rem, the default). Where the parent is narrower, the container fills it, with padding at the sides." },
        { "id": "container-bands", "title": "Bands that reach the edges", "lead": "For bands of color that reach the page's edges, put the color on a `Box` around each `Container`. The bands run the full width, and their content keeps the same width and side padding, so the edges line up." }
      ]
    },
    {
      "id": "section", "icon": "PanelTop", "name": "Section", "category": "Layout", "summary": "Renders a full-width band of a page, such as a hero.",
      "examples": [
        { "id": "section-hero", "title": "A hero", "lead": "A hero or a closing call to action needs more room. Set `Spacing=\"SectionSpacing.Lg\"` and a `Bg`, and put a `Container` inside to keep the content at a readable width." },
        { "id": "section-bands", "title": "Band spacing", "lead": "A band's spacing is its padding above and below. `Md`, the default, suits most bands. For a slimmer band, such as this sign-up, set `Spacing` to `SectionSpacing.Sm`." }
      ]
    },
    {
      "id": "center", "icon": "Crosshair", "name": "Center", "category": "Layout", "summary": "Centers its content both ways.",
      "examples": [
        { "id": "center-icon-tiles", "title": "Icon tiles", "lead": "To put an icon in the middle of a square tile, give `Center` a `Width` and `Height`. `Bg` and `Radius` style the tile." },
        { "id": "center-loading", "title": "Centering in a panel", "lead": "To center content in a panel, such as a spinner while a report loads, give `Center` a `Height`." }
      ]
    },
    {
      "id": "spacer", "icon": "MoveHorizontal", "name": "Spacer", "category": "Layout", "summary": "Pushes the rest of a row to the end.",
      "examples": [
        { "id": "spacer-app-bar", "title": "Pushing items to a row's end", "lead": "A `Spacer` between groups in a `Row` pushes everything after it to the end, here the header's buttons." },
        { "id": "spacer-plans", "title": "Pushing items to a column's bottom", "lead": "In a `Column`, a `Spacer` fills the free height instead, so both buttons sit at the bottom of their cards however long the text above them." }
      ]
    },
    {
      "id": "aspect-ratio", "icon": "Ratio", "name": "AspectRatio", "category": "Layout", "summary": "Keeps media at a fixed shape, 16:9 by default.",
      "examples": [
        { "id": "aspect-ratio-shapes", "title": "Shapes", "lead": "The ratio is the box's shape, as width over height. To change it from 16:9, the default, set `Ratio`. Here the same picture shows at 16:9, 1:1 and 4:5, cropped to fill each." },
        { "id": "aspect-ratio-thumbnails", "title": "Matching thumbnails", "lead": "Thumbnails with the same shape keep a grid's rows lined up. Give each one the same `Ratio`, and pictures of any shape, here a wide one and a tall one, crop to it. Other content fills the box too, such as a `Center` with an icon where there's no picture." }
      ]
    },
    {
      "id": "divider", "icon": "SeparatorHorizontal", "name": "Divider", "category": "Layout", "summary": "Separates content with a line: plain, dashed, labeled or vertical.", "keywords": ["separator", "rule"],
      "examples": [
        { "id": "divider-receipt", "title": "Plain and dashed", "lead": "A `Divider` is an `hr` line. For a lighter break, such as the one before the total, set `Dashed`." },
        { "id": "divider-labeled", "title": "With a label", "lead": "To put text in the middle of the line, such as `or` between two ways to sign in, set `Label`." },
        { "id": "divider-vertical", "title": "Vertical", "lead": "To separate items in a `Row`, set `Orientation=\"Orientation.Vertical\"`. The line is as tall as the row." }
      ]
    },
