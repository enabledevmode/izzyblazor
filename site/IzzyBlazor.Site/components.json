          "examples": [
            { "id": "tree-view-load-children", "title": "Children that load", "lead": "For a tree too large to send at once, set `ItemHasChildren` and `ChildrenProvider`. The first time a branch opens, the provider gets the item's key and returns its children.", "after": ["On static pages, IzzyBlazor's script asks the page for the children, so there's no endpoint to write. Give each tree on the page that loads children an `id`.", "With JavaScript off, those branches say to turn it on."] },
            { "id": "tree-view-search", "title": "Search", "lead": "To add a search box, set `Searchable`. Typing narrows the tree to the matches and the branches that hold them, and marks the matched text. It searches the items in the page, so children still to load aren't found." }
          ]
        }
