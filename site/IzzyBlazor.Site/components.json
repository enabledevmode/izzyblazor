          ],
          "examples": [
            {"id": "list-view-load-more", "title": "Load more", "lead": "A Load more button after the last item adds the next page with each press. Set `PageSize` and `Paging` to `DataPaging.LoadMore`. To make the list scroll inside its box, set `MaxHeight`; the button scrolls with the items. The page is kept in the URL, so give each list on a page its own `QueryPrefix`.", "notes": {"noscript": "Load more is a link, and the page reloads with four more items.", "static": "Load more is a link. The list updates without a full reload, and focus moves to the first new item.", "interactive": "Each press adds four items after the ones shown, and focus moves to the first new one."}},
