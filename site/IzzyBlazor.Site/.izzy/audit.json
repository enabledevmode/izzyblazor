{
  // What izzy audit should know about this site. A docs page shows components in examples, so a
  // landmark inside an example may share its name with another, or with the site's own. An example
  // that is a page of its own is drawn in an iframe, in .ex-window.
  "demoPages": [
    { "pages": "/docs/**", "examples": ".ib-example-preview, .ex-window" }
  ],
  "accepted": [
    {
      "rule": "color-contrast",
      "selector": "[style*=\"--ib-color-disabled\"]",
      "pages": "/docs/**",
      "reason": "The docs show the disabled color on text, to show what Color.Disabled looks like",
      "by": "Israel Dryer",
      "on": "2026-11-24"
    },
    {
      "rule": "color-contrast",
      "pages": "/docs/components/rich-text-editor/styling",
      "reason": "The example gives the editor's headings a color of its own, to show the styling hooks",
      "by": "Israel Dryer",
      "on": "2026-11-24"
    }
  ]
}
