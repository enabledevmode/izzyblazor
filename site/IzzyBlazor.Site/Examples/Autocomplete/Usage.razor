@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="autocomplete-usage" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <Autocomplete @bind-Value="Model!.City" Items="CityNames" Placeholder="Start typing a city"
                  Hint="Pick one, or type a city that isn't listed." />
    <Row><Button Submit>Save</Button></Row>
    @if (_saved is { } saved)
    {
        <Alert Status="Status.Success">Saved: @(saved.Length == 0 ? "no city" : saved).</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "autocomplete-usage")]
    private Trip? Model { get; set; }

    // What was saved, not the field: on an interactive page it follows each change.
    private string? _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = Model!.City?.Trim() ?? "";

    public sealed class Trip
    {
        [Display(Name = "City"), StringLength(80)]
        public string? City { get; set; }
    }

    private static readonly string[] CityNames =
    [
        "Amsterdam", "Athens", "Barcelona", "Berlin", "Brussels", "Budapest", "Copenhagen", "Dublin",
        "Edinburgh", "Florence", "Helsinki", "Istanbul", "Kraków", "Lisbon", "London", "Madrid",
        "Milan", "Munich", "Oslo", "Paris", "Porto", "Prague", "Reykjavík", "Rome", "Seville",
        "Stockholm", "Tallinn", "Valencia", "Venice", "Vienna", "Warsaw", "Zürich",
    ];
}
