<Row Gap="3" Wrap Justify="Justify.Center" PaddingY="10">
    <Tooltip Text="Saved to your drafts">
        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Top</Button>
    </Tooltip>
    <Tooltip Text="Opens in a new tab" Placement="Placement.Bottom">
        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Bottom</Button>
    </Tooltip>
    <Tooltip Text="Back to the inbox" Placement="Placement.Start">
        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Start</Button>
    </Tooltip>
    <Tooltip Text="On to the next message" Placement="Placement.End">
        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">End</Button>
    </Tooltip>
</Row>
