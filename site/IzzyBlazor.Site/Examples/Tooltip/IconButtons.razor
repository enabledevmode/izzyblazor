<Row Gap="1" Align="Align.Center" PaddingTop="10">
    <Tooltip>
        <Content>Bold <Kbd Keys="Ctrl+B" /></Content>
        <ChildContent><IconButton Icon="Lucide.Bold" Label="Bold" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" /></ChildContent>
    </Tooltip>
    <Tooltip>
        <Content>Italic <Kbd Keys="Ctrl+I" /></Content>
        <ChildContent><IconButton Icon="Lucide.Italic" Label="Italic" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" /></ChildContent>
    </Tooltip>
    <Tooltip>
        <Content>Insert link <Kbd Keys="Ctrl+K" /></Content>
        <ChildContent><IconButton Icon="Lucide.Link" Label="Insert link" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" /></ChildContent>
    </Tooltip>
    <Tooltip Text="3 unread" Delay="0">
        <IconButton Icon="Lucide.Bell" Label="Notifications" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" />
    </Tooltip>
</Row>
