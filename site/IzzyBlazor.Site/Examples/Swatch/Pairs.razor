@* The status colors a design page lists: each fill, then its soft color with the status's text on
   it, the pair alerts and badges use. *@
<Grid Columns="new() { Base = 2, Sm = 4 }" Gap="4" Grow>
    <Swatch Color="Color.Success" Label="Success" />
    <Swatch Color="Color.SuccessSoft" TextColor="Color.SuccessText" Label="Success soft" />
    <Swatch Color="Color.Danger" Label="Danger" />
    <Swatch Color="Color.DangerSoft" TextColor="Color.DangerText" Label="Danger soft" />
</Grid>
