    <CodeExampleFile Title="SaveButton.razor" Code="@Markup" />
    <CodeExampleFile Title="SaveButton.razor.cs" Language="csharp" Code="@CodeBehind" HighlightLines="3" />
</CodeExample>

@* hide *@
@code {
    private const string Markup =
        """
        <Button StartIcon="Lucide.Save" OnClick="Save">Save</Button>
        """;

