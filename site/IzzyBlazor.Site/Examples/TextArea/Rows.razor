<Form Model="Model" FormName="text-area-rows" MaxWidth="28.Rem" Grow>
    <TextArea @bind-Value="Model!.Notes" Rows="6" Placeholder="Steps to reproduce, what you expected, what happened" />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "text-area-rows")]
    private BugReport? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class BugReport
    {
        public string? Notes { get; set; }
    }
}
