@using System.ComponentModel.DataAnnotations

<Card Grow MaxWidth="24.Rem">
    <CardBody>
        <Form Model="Model" FormName="text-field-masks" OnValidSubmit="Save">
            <TextField @bind-Value="Model!.Telephone" Mask="(000) 000-0000" Placeholder="(000) 000-0000" AutoComplete="tel-national" />
            <TextField @bind-Value="Model!.CardNumber" Mask="0000 0000 0000 0000" Placeholder="0000 0000 0000 0000" AutoComplete="cc-number" />
            <TextField @bind-Value="Model!.Ssn" Mask="000-00-0000" Placeholder="000-00-0000" AutoComplete="off" />
            <Row>
                <Button Submit StartIcon="Lucide.Save">Save</Button>
                <Button Reset StartIcon="Lucide.CircleX" Variant="ButtonVariant.Soft" Accent="Accent.Neutral">Cancel</Button>
            </Row>
            @if (_saved is not null)
            {
                <Alert Status="Status.Success">@_saved</Alert>
            }
        </Form>
    </CardBody>
</Card>

@code {
    [SupplyParameterFromForm(FormName = "text-field-masks")]
    private Applicant? Model { get; set; }

    private string? _saved;

    protected override void OnInitialized() => Model ??= new();

    // What was saved, not the fields: on an interactive page they change as people type.
    private void Save() => _saved = $"Saved. We'll call {Model!.Telephone} and charge the card ending {Model.CardNumber![^4..]}.";
    @* hide *@
    public sealed class Applicant
    {
        [Required]
        public string? Telephone { get; set; }

        [Required, Display(Name = "Credit card")]
        public string? CardNumber { get; set; }

        [Required, Display(Name = "SSN")]
        public string? Ssn { get; set; }
    }
    @* /hide *@
}
