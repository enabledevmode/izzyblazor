@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="text-field-masks" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <TextField @bind-Value="Model!.Phone" Mask="(000) 000-0000" Placeholder="(000) 000-0000" Hint="10 digits" AutoComplete="tel-national" />
    <TextField @bind-Value="Model!.PostalCode" Mask=">L0L 0L0" Placeholder="A1A 1A1" Hint="Letters and digits, such as M5V 2T6" AutoComplete="postal-code" />
    <Row><Button Submit>Save address</Button></Row>
    @if (_saved)
    {
        <Alert Status="Status.Success">We'll call @Model!.Phone about the delivery to @Model.PostalCode.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "text-field-masks")]
    private Delivery? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = true;

    public sealed class Delivery
    {
        [Required, Phone]
        public string? Phone { get; set; }

        [Required, Display(Name = "Postal code")]
        public string? PostalCode { get; set; }
    }
}
