@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="sign-in" OnValidSubmit="TrySignIn" MaxWidth="24.Rem" Grow>
    @if (_failed)
    {
        <Alert Status="Status.Danger">That email and password don't match. Enter your password again.</Alert>
    }
    <TextField @bind-Value="Model!.Email" AutoComplete="username" />
    <TextField @bind-Value="Model!.Password" AutoComplete="current-password" Hint="This example turns every password down." />
    <Button Submit>Sign in</Button>
</Form>

@code {
    [SupplyParameterFromForm(FormName = "sign-in")]
    private Credentials? Model { get; set; }

    private bool _failed;

    protected override void OnInitialized() => Model ??= new() { Email = "ana@example.com" };

    // A real app checks the password here; this one always fails, to show what comes back.
    private void TrySignIn() => _failed = true;

    public sealed class Credentials
    {
        [Required, EmailAddress]
        public string? Email { get; set; }

        [Required, DataType(DataType.Password)]
        public string? Password { get; set; }
    }
}
