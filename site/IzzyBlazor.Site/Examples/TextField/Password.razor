@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="password" MaxWidth="24.Rem" Grow>
    <TextField @bind-Value="Model!.Password" AutoComplete="new-password" Hint="At least 12 characters." />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "password")]
    private Account? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Account
    {
        [Required, MinLength(12), DataType(DataType.Password)]
        public string? Password { get; set; }
    }
}
