<Form Model="Model" FormName="states" MaxWidth="24.Rem" Grow>
    <TextField @bind-Value="Model!.Small" Label="Small" Size="ControlSize.Sm" />
    <TextField @bind-Value="Model!.Large" Label="Large" Size="ControlSize.Lg" />
    <TextField @bind-Value="Model!.Id" Label="Account ID" ReadOnly Hint="Read-only: posted, but can't be changed." />
    <TextField @bind-Value="Model!.Plan" Label="Plan" Disabled Hint="Disabled: not posted." />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "states")]
    private Settings? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Settings
    {
        public string? Small { get; set; }
        public string? Large { get; set; }
        public string? Id { get; set; } = "acct_48213";
        public string? Plan { get; set; } = "Team";
    }
}
