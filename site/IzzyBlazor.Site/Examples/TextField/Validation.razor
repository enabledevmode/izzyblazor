@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="signup" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <TextField @bind-Value="Model!.Username" AutoComplete="username" />
    <TextField @bind-Value="Model!.Email" AutoComplete="email" />
    <Row><Button Submit>Create account</Button></Row>
    @if (_saved)
    {
        <Alert Status="Status.Success">Welcome, @Model!.Username.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "signup")]
    private Signup? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = true;

    public sealed class Signup
    {
        [Required(ErrorMessage = "Choose a username")]
        [StringLength(20, MinimumLength = 3, ErrorMessage = "Use 3 to 20 characters")]
        public string? Username { get; set; }

        [Required(ErrorMessage = "Enter your email"), EmailAddress(ErrorMessage = "Enter an email like name@example.com")]
        public string? Email { get; set; }
    }
}
