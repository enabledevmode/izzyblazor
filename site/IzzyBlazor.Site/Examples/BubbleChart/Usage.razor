@* A product portfolio: each product's revenue growth against its margin, sized by its revenue and
   named on the chart, so the big earners and the fast growers stand out at once. *@
<Chart Items="_products" Argument="p => p.Growth" Title="Product portfolio: growth, margin and revenue, 2026">
    <ChartValueAxis Format="P0" Title="Gross margin" />
    <ChartArgumentAxis Format="+0%;−0%;0%" Title="Revenue growth" />
    <ChartBubbleSeries Value="p => p.Margin" Size="p => p.Revenue" SizeFormat="$#,##0,,M" LabelText="p => p.Name" Name="Products" />
    <ChartTooltip>
        <div class="ib-chart-tooltip-title">@context.Item.Name</div>
        <div>Revenue @context.Item.Revenue.ToString("$#,##0,,M"), growth @context.Argument</div>
        <div>Gross margin @context.Item.Margin.ToString("P0")</div>
    </ChartTooltip>
</Chart>

@code {
    private record Product(string Name, double Growth, double Margin, decimal Revenue);

    private readonly Product[] _products =
    [
        new("Analytics", 0.34, 0.71, 18_000_000),
        new("Payments", 0.22, 0.38, 46_000_000),
        new("Mobile SDK", 0.41, 0.62, 6_000_000),
        new("Data export", 0.08, 0.66, 9_000_000),
        new("Support plans", 0.04, 0.29, 22_000_000),
        new("Hosting", 0.15, 0.24, 31_000_000),
        new("Integrations", 0.27, 0.55, 11_000_000),
        new("Training", -0.06, 0.41, 4_000_000),
        new("Legacy CRM", -0.14, 0.52, 14_000_000),
    ];
}
