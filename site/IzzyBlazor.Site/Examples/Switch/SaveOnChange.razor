<Form Model="Model" FormName="switch-save-on-change" OnValidSubmit="Save" MaxWidth="32.Rem" Grow>
    <Switch @bind-Value="Model!.Maintenance" SubmitOnChange ControlPosition="ControlPosition.End"
            Label="Maintenance mode" Hint="Visitors see a maintenance page until you turn it off." />
    <Row Gap="3" Align="Align.Center" Wrap>
        @* With JavaScript off, nothing posts the form as the switch changes, so this does. *@
        <noscript><Button Submit Size="ControlSize.Sm">Save</Button></noscript>
        @if (_saved is not null)
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">@_saved</TextBlock>
        }
    </Row>
</Form>

@code {
    [SupplyParameterFromForm(FormName = "switch-save-on-change")]
    private SiteStatus? Model { get; set; }

    private string? _saved;

    protected override void OnInitialized() => Model ??= new();

    // Runs each time the switch changes, on static and interactive pages.
    private void Save() => _saved = Model!.Maintenance ? "Last saved: in maintenance mode." : "Last saved: live.";

    public sealed class SiteStatus
    {
        public bool Maintenance { get; set; }
    }
}
