@* A server's load against the same two bands: past 70% is high, past 90% critical. Each gauge fills
   in the color of the band its value is in, and names the band under the value. *@
<Row Gap="8" Wrap Justify="Justify.Center">
    @foreach (var (label, value) in _load)
    {
        <Gauge Label="@label" Value="value" ValueFormat="P0" Palette="ChartPalette.Of(Color.Warning, Color.Danger)">
            <GaugeBand From="0.7" To="0.9" Label="High" />
            <GaugeBand From="0.9" To="1" Label="Critical" />
        </Gauge>
    }
</Row>

@code {
    private readonly (string Label, double Value)[] _load = [("CPU", 0.42), ("Memory", 0.78), ("Disk", 0.93)];
}
