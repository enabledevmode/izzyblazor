@* Wind at a weather station: the ten-minute mean fills the dial, and the strongest gust in that
   time is a pointer on the same scale. *@
<Gauge Label="Wind" Value="27" Max="100" ValueFormat="0 km/h">
    <GaugeBand From="39" To="62" Label="Strong" />
    <GaugeBand From="62" To="100" Label="Gale" />
    <GaugePointer Value="44" Label="Gusts" />
</Gauge>
