@using Rows = IzzyBlazor.Site.Examples.Table.Orders
@using Status = IzzyBlazor.Site.Examples.Table.OrderStatus
@* The footer covers every order the filters match, not just this page. Filter by status and it follows.
   The last column's is your own: the share of orders paid, worked out in the database. *@
<DataGrid Items="Rows.All" PageSize="5" Caption="Orders with totals" QueryPrefix="totals-" Grow>
    <Columns>
        <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Width="7.Rem" Aggregate="DataAggregate.Count" />
        <PropertyColumn Property="o => o.Customer" Width="12.Rem" />
        <PropertyColumn Property="o => o.Status" Filterable />
        <PropertyColumn Property="o => o.Date" Format="MMM d" Aggregate="DataAggregate.Max" AggregateLabel="Latest" />
        <PropertyColumn Property="o => o.Total" Format="C" Width="9.Rem" Aggregate="DataAggregate.Sum" />
        <TemplateColumn Title="Paid" Width="6.Rem" Align="CellAlign.End" AggregateLabel="" AggregateFormat="P0"
                        AggregateBy="g => g.Any() ? (double)g.Count(o => o.Status == Status.Paid) / g.Count() : 0">
            @(context.Status == Status.Paid ? "Yes" : "No")
        </TemplateColumn>
    </Columns>
</DataGrid>
