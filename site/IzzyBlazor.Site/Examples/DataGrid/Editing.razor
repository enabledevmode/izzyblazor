@* Edit a row with the pencil: a dialog, with no script needed, that saves by a form post. Only the
   editable columns take a value from it: every visible one but the key here, and the two hidden
   ones that opt in. A total over 10,000 comes back as an error on its field. *@
<DataGrid TItem="EditableOrder" Items="_orders" PageSize="5" Caption="Orders you can edit" ItemKey="o => o.Number.ToString()" QueryPrefix="edits-"
          EditMode="DataGridEditMode.Dialog" OnSave="Save" Grow>
    <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Width="6.Rem" Editable="false" />
    <PropertyColumn Property="o => o.Customer" />
    <PropertyColumn Property="o => o.Status" />
    <PropertyColumn Property="o => o.Total" Format="C" Width="8.Rem" />
    <PropertyColumn Property="o => o.Date" Visible="false" Editable="true" />
    <PropertyColumn Property="o => o.Notes" Visible="false" Editable="true" />
</DataGrid>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private List<EditableOrder> _orders = [];

    protected override void OnInitialized() => _orders = EditableOrders.For(Http);

    private void Save(DataGridSave<EditableOrder> save)
    {
        if (save.Item.Total > 10_000)
        {
            save.AddError(o => o.Total, "An order can't be over 10,000.");
            return;
        }

        // A real page would read the row from its database here.
        save.CopyTo(_orders.First(o => o.Number == save.Item.Number));
    }
}
