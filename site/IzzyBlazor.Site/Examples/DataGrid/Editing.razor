@* file: EditableOrder.cs *@
@using Rows = IzzyBlazor.Site.Examples.Table.Orders
@* Edit a row with the pencil: a dialog, with no script needed, that saves by a form post. Only the
   editable columns take a value from it: all of them but the key here, including the two that
   aren't shown. A total over 10,000 comes back as an error on its field. Add and Delete come
   from NewItem and OnDelete, and a paid order can't be deleted. *@
<DataGrid TItem="EditableOrder" Items="_orders" PageSize="5" Caption="Orders you can edit" ItemKey="o => o.Number.ToString()" QueryPrefix="edits-"
          EditMode="DataGridEditMode.Dialog" OnSave="Save" NewItem="NewOrder" OnDelete="Delete" ItemDeletable="o => o.Status != OrderStatus.Paid" Grow>
    <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Width="6.Rem" Editable="false" />
    <PropertyColumn Property="o => o.Customer" />
    <PropertyColumn Property="o => o.Status" />
    <PropertyColumn Property="o => o.Total" Format="C" Width="8.Rem" />
    <PropertyColumn Property="o => o.Date" Visible="false" />
    <PropertyColumn Property="o => o.Notes" Visible="false" />
</DataGrid>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private List<EditableOrder> _orders = [];

    // Stands in for your database, with a copy of the rows for each visitor to this site.
    protected override void OnInitialized() => _orders = ExampleRows.For(Http, "editing", () => Rows.All
        .Select(o => new EditableOrder { Number = o.Number, Customer = o.Customer, Date = o.Date, Status = (OrderStatus)o.Status, Total = o.Total })
        .ToList());

    private void Save(DataGridSave<EditableOrder> save)
    {
        if (save.Item.Total > 10_000)
        {
            save.AddError(o => o.Total, "An order can't be over 10,000.");
            return;
        }

        // A real page would read the row from its database here.
        if (save.IsNew)
        {
            _orders.Insert(0, save.Item);
            return;
        }

        save.CopyTo(_orders.First(o => o.Number == save.Item.Number));
    }

    private EditableOrder NewOrder() => new() { Number = _orders.Max(o => o.Number) + 1, Date = DateOnly.FromDateTime(DateTime.Today) };

    private void Delete(DataGridDelete<EditableOrder> delete) => _orders.RemoveAll(o => o.Number == delete.Item.Number);
}
