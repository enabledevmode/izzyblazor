@using IzzyBlazor.Site.Examples.Table
@* The dialog in sections: a label and a hint on a field, one field written by hand, and the others as
   they come. A paid order's Delete stays, disabled, with a reason. *@
<DataGrid TItem="EditableOrder" Items="_orders" PageSize="5" Caption="Orders in sections" ItemKey="o => o.Number.ToString()" QueryPrefix="sections-"
          EditMode="DataGridEditMode.Dialog" OnSave="Save" OnDelete="Delete" ItemDeletable="o => o.Status != OrderStatus.Paid"
          EditDialogSize="DialogSize.Lg" EditDialogTitle="@(o => $"Order {o?.Number}")" Grow>
    <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Width="6.Rem" Editable="false" />
    <PropertyColumn Property="o => o.Customer" EditHint="As it appears on the invoice" />
    <PropertyColumn Property="o => o.Status">
        <EditTemplate>
            <SegmentedControl @bind-Value="context.Item.Status" Items="Enum.GetValues<OrderStatus>()" @attributes="context.Attributes" />
        </EditTemplate>
    </PropertyColumn>
    <PropertyColumn Property="o => o.Total" Format="C" Width="8.Rem" EditLabel="Order total" />
    <PropertyColumn Property="o => o.Date" Visible="false" Editable="true" />
    <PropertyColumn Property="o => o.Notes" Visible="false" Editable="true" />
    <EditLayout>
        <Fieldset Label="Customer" Columns="2">
            <EditField Key="customer" />
            <EditField Key="status" />
        </Fieldset>
        <Fieldset Label="Order" Columns="2">
            <EditField Key="total" />
            <EditField Key="date" />
        </Fieldset>
    </EditLayout>
    <ActionColumn Context="order">
        <EditAction />
        <DeleteAction DisabledReason="A paid order can't be deleted." />
    </ActionColumn>
</DataGrid>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private List<EditableOrder> _orders = [];

    protected override void OnInitialized() => _orders = EditableOrders.For(Http);

    private void Save(DataGridSave<EditableOrder> save) => save.CopyTo(_orders.First(o => o.Number == save.Item.Number));

    private void Delete(DataGridDelete<EditableOrder> delete) => _orders.RemoveAll(o => o.Number == delete.Item.Number);
}
