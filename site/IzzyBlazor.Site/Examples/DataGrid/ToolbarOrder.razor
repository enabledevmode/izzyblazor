@* The grid's own tools among yours, in the order written. Export has its text; the others are as usual. *@
@using Rows = IzzyBlazor.Site.Examples.Table.Orders
<DataGrid Items="Rows.All" PageSize="5" Caption="Orders with placed tools" Searchable ColumnPicker LayoutKey="order-tools" QueryPrefix="placed-" ExportCsvHref="/examples/orders.csv" ExportExcelHref="/examples/orders.xlsx" Grow>
    <ToolbarContent>
        <ToolbarButton StartIcon="Lucide.Plus" Variant="ButtonVariant.Outline" Priority="1">Add order</ToolbarButton>
        <DataGridSearch />
        <DataGridColumnPicker Position="ToolbarPosition.End" />
        <ToolbarIconButton Icon="Lucide.CircleQuestionMark" Label="Help" Position="ToolbarPosition.End" />
        <DataGridExport Position="ToolbarPosition.End" ShowText />
    </ToolbarContent>
    <ChildContent>
        <PropertyColumn Property="o => o.Number" Align="CellAlign.Start" Width="8.Rem" />
        <PropertyColumn Property="o => o.Customer" Sortable />
        <PropertyColumn Property="o => o.Total" Format="C" Sortable Width="8.Rem" />
    </ChildContent>
</DataGrid>
