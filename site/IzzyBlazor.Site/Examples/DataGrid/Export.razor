@* Sort or page it, then download: the file has every matching row, in the columns on screen. The
   endpoints are in the app: DataExport.WriteCsvAsync and WriteExcelAsync, in Results.Stream. *@
@using Rows = IzzyBlazor.Site.Examples.Table.Orders
<DataGrid Items="Rows.All" PageSize="5" Caption="Orders to export" ExportCsvHref="/examples/orders.csv" ExportExcelHref="/examples/orders.xlsx" QueryPrefix="export-" Grow>
    <PropertyColumn Property="o => o.Number" Align="CellAlign.Start" Width="6.Rem" />
    <PropertyColumn Property="o => o.Customer" Sortable />
    <PropertyColumn Property="o => o.Total" Format="C" Sortable Width="8.Rem" />
</DataGrid>
