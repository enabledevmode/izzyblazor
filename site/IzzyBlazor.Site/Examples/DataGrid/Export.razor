@* The usual setup: Excel alone, one icon that downloads. Sort or page it, then download: the file has
   every matching row, in the columns on screen. The endpoint is in the app: DataExport.WriteExcelAsync,
   in Results.Stream. *@
@using Rows = IzzyBlazor.Site.Examples.Table.Orders
<DataGrid Items="Rows.All" PageSize="5" Caption="Orders for Excel" ExportExcelHref="/examples/orders.xlsx" QueryPrefix="excel-" Grow>
    <PropertyColumn Property="o => o.Number" Align="CellAlign.Start" Width="6.Rem" />
    <PropertyColumn Property="o => o.Customer" Sortable />
    <PropertyColumn Property="o => o.Total" Format="C" Sortable Width="8.Rem" />
</DataGrid>
