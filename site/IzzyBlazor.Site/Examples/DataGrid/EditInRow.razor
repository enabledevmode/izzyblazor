@* file: EditableOrder.cs *@
@using Rows = IzzyBlazor.Site.Examples.Table.Orders
@* Edit where the row stands. Only the columns shown have a field; Notes keeps its value. A total over
   10,000 comes back as an error under its field. Escape cancels, and F2 starts from a cell of text. *@
<DataGrid TItem="EditableOrder" Items="_orders" PageSize="5" Caption="Orders edited in the row" ItemKey="o => o.Number.ToString()" QueryPrefix="row-"
          EditMode="DataGridEditMode.Row" OnSave="Save" NewItem="NewOrder" OnDelete="Delete" Grow>
    <Columns>
        <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Width="6.Rem" Editable="false" Sortable />
        <PropertyColumn Property="o => o.Customer" Sortable />
        <PropertyColumn Property="o => o.Status" />
        <PropertyColumn Property="o => o.Date" />
        <PropertyColumn Property="o => o.Total" Format="C" Width="9.Rem" />
        <PropertyColumn Property="o => o.Notes" Visible="false" />
    </Columns>
</DataGrid>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    private List<EditableOrder> _orders = [];

    // Stands in for your database, with a copy of the rows for each visitor to this site.
    protected override void OnInitialized() => _orders = ExampleRows.For(Http, "edit-in-row", () => Rows.All
        .Select(o => new EditableOrder { Number = o.Number, Customer = o.Customer, Date = o.Date, Status = (OrderStatus)o.Status, Total = o.Total, Notes = "Keeps its value" })
        .ToList());

    private void Save(DataGridSave<EditableOrder> save)
    {
        if (save.Item.Total > 10_000)
        {
            save.AddError(o => o.Total, "An order can't be over 10,000.");
            return;
        }

        if (save.IsNew)
        {
            _orders.Insert(0, save.Item);
            return;
        }

        save.CopyTo(_orders.First(o => o.Number == save.Item.Number));
    }

    private EditableOrder NewOrder() => new() { Number = _orders.Max(o => o.Number) + 1, Date = DateOnly.FromDateTime(DateTime.Today) };

    private void Delete(DataGridDelete<EditableOrder> delete) => _orders.RemoveAll(o => o.Number == delete.Item.Number);
}
