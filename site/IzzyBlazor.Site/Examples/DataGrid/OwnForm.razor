@using System.ComponentModel.DataAnnotations
@using Rows = IzzyBlazor.Site.Examples.Table.Orders
@* A form of your own in the dialog: its model holds only what it edits, so no other field can be
   forged, and it says when it has saved. *@
<DataGrid TItem="Order" Items="_orders" PageSize="5" Caption="Orders with your form" ItemKey="o => o.Number.ToString()" QueryPrefix="own-"
          EditMode="DataGridEditMode.Dialog" Grow>
    <Columns>
        <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Width="6.Rem" />
        <PropertyColumn Property="o => o.Customer" />
        <PropertyColumn Property="o => o.Quantity" />
    </Columns>
    <EditDialogForm Context="edit">
        <Form Model="ModelFor(edit.Item!)" FormName="own-form" OnValidSubmit="() => SaveAsync(edit)">
            <FormErrors />
            <NumberField @bind-Value="Model!.Quantity" />
            <DialogFooter>
                @edit.Cancel
                <Button Submit>Save</Button>
            </DialogFooter>
        </Form>
    </EditDialogForm>
</DataGrid>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }

    [SupplyParameterFromForm(FormName = "own-form")]
    private QuantityEdit? Model { get; set; }

    private List<Order> _orders = [];

    // Stands in for your database, with a copy of the rows for each visitor to this site.
    protected override void OnInitialized() => _orders = ExampleRows.For(Http, "own-form", () => Rows.All
        .Select(o => new Order { Number = o.Number, Customer = o.Customer })
        .ToList());

    // The row the model was made for: another one opened (after this one was closed unsaved) gets
    // its own. A static post's model is the one posted.
    private int? _modelFor;

    private QuantityEdit ModelFor(Order order)
    {
        if (Model is null || (_modelFor is { } was && was != order.Number)) Model = new() { Quantity = order.Quantity };
        _modelFor = order.Number;
        return Model;
    }

    private async Task SaveAsync(DataGridEditFormContext<Order> edit)
    {
        edit.Item!.Quantity = Model!.Quantity;
        await edit.CloseAsync();
        (Model, _modelFor) = (null, null);
    }

    public sealed class Order
    {
        public int Number { get; set; }

        public string? Customer { get; set; }

        public int Quantity { get; set; } = 1;
    }

    public sealed class QuantityEdit
    {
        [Range(1, 1000)]
        public int Quantity { get; set; }
    }
}
