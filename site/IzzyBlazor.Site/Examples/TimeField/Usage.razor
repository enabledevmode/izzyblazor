@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="time-field-usage" OnValidSubmit="Save" MaxWidth="20.Rem" Grow>
    <TimeField @bind-Value="Model!.Opens" Hint="Doors open in the morning." />
    <TimeField @bind-Value="Model!.Closes" Min="Model!.Opens" />
    <TimeField @bind-Value="Model!.Night" Label="Night shift starts" Min="new TimeOnly(22, 0)" Max="new TimeOnly(6, 0)" Hint="Between 10 PM and 6 AM." />
    <Row><Button Submit>Save hours</Button></Row>
    @if (_saved is { } saved)
    {
        <Alert Status="Status.Success">Saved: open @saved.Opens.ToString("HH:mm") to @(saved.Closes?.ToString("HH:mm") ?? "late"), night shift from @(saved.Night?.ToString("HH:mm") ?? "no one").</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "time-field-usage")]
    private Hours? Model { get; set; }

    // What was saved, not the fields: on an interactive page they follow typing.
    private (TimeOnly Opens, TimeOnly? Closes, TimeOnly? Night)? _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = (Model!.Opens!.Value, Model.Closes, Model.Night);

    public sealed class Hours
    {
        [Required, Range(typeof(TimeOnly), "06:00", "12:00", ErrorMessage = "Pick a time between 6 AM and noon.")]
        public TimeOnly? Opens { get; set; } = new TimeOnly(9, 0);

        public TimeOnly? Closes { get; set; }

        public TimeOnly? Night { get; set; }
    }
}
