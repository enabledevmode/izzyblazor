@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="duration-field-limits" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <DurationField @bind-Value="Model!.Timeout" Hint="From a second to an hour." />
    <DurationField @bind-Value="Model!.Retention" LargestUnit="DurationUnit.Days" SmallestUnit="DurationUnit.Hours" Max="TimeSpan.FromDays(90)" Hint="Up to 90 days." />
    <Row><Button Submit>Save settings</Button></Row>
    @if (_saved is { } saved)
    {
        <Alert Status="Status.Success">Saved: time out after @saved.Timeout, keep for @(saved.Retention?.ToString() ?? "no time").</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "duration-field-limits")]
    private Settings? Model { get; set; }

    // What was saved, not the fields: on an interactive page they follow typing.
    private (TimeSpan Timeout, TimeSpan? Retention)? _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = (Model!.Timeout!.Value, Model.Retention);

    public sealed class Settings
    {
        [Required, Range(typeof(TimeSpan), "00:00:01", "01:00:00", ErrorMessage = "Pick from a second to an hour.")]
        public TimeSpan? Timeout { get; set; } = TimeSpan.FromSeconds(90);

        public TimeSpan? Retention { get; set; }
    }
}
