@* hide *@
@using IzzyBlazor.Site.Examples.Table
@* /hide *@

@* A store admin's orders page: the filters above a sortable, paged table. *@
<AppShell Variant="ShellVariant.Flat">
    <AppHeader>
        <AppBrand Icon="Lucide.Store" Label="Acme Store" />
        <Box Grow />
        <Avatar Name="Ada Lovelace" />
    </AppHeader>

    <AppMain>
        <Stack Padding="new() { Base = 4, Md = 8 }">
            <Stack Gap="4">
                <Row Gap="3" Align="Align.Center" Wrap>
                    <Heading Level="1" Size="TextSize.Xl2">Orders</Heading>
                    <Spacer />
                    <Button StartIcon="Lucide.Download" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Export</Button>
                </Row>
                <FilterForm Label="Filter orders">
                    <FilterSearch Placeholder="Search customers" />
                    <FilterSelect Name="status" Label="Status" EnumType="typeof(OrderStatus)" />
                    <FilterDate Name="from" Label="Placed from" />
                    <FilterDate Name="to" Label="Placed to" Min="From" />
                    <FilterCheckbox Name="large" Label="Over $300" />
                </FilterForm>
                <Table Items="Filtered" PageSize="6" InitialSort="-date" Caption="Orders" EmptyText="No orders match these filters">
                    <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" />
                    <PropertyColumn Property="o => o.Customer" Sortable />
                    <PropertyColumn Property="o => o.Date" Format="MMM d, yyyy" Sortable />
                    <TemplateColumn Title="Status" SortBy="o => o.Status" SortKey="status" Sortable>
                        <Badge Status="Orders.StatusOf(context.Status)" Dot>@context.Status</Badge>
                    </TemplateColumn>
                    <PropertyColumn Property="o => o.Total" Format="C" Sortable />
                </Table>
            </Stack>
        </Stack>
    </AppMain>
</AppShell>

@code {
    [SupplyParameterFromQuery(Name = "q")] private string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "status")] private string? StatusFilter { get; set; }
    [SupplyParameterFromQuery(Name = "large")] private bool Large { get; set; }
    // Dates in the address are what the browser posts (2026-09-14), read as DateOnly.
    [SupplyParameterFromQuery(Name = "from")] private DateOnly? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] private DateOnly? To { get; set; }

    // The page filters its own data; the table sorts and pages what it's given.
    private IEnumerable<Order> Filtered => Orders.All
        .Where(o => string.IsNullOrWhiteSpace(Search) || o.Customer.Contains(Search, StringComparison.OrdinalIgnoreCase))
        .Where(o => !Enum.TryParse<OrderStatus>(StatusFilter, out var status) || o.Status == status)
        .Where(o => (From is null || o.Date >= From) && (To is null || o.Date <= To))
        .Where(o => !Large || o.Total > 300);
}
