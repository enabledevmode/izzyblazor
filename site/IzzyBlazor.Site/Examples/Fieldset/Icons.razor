@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="fieldset-icons" MaxWidth="32.Rem" Grow>
    <Fieldset Label="Notifications" Description="What we email you about." Icon="Lucide.Bell" Dividers Gap="3">
        <Switch @bind-Value="Model!.Mentions" ControlPosition="ControlPosition.End" />
        <Switch @bind-Value="Model!.Digest" ControlPosition="ControlPosition.End" />
    </Fieldset>
    <Fieldset Label="Security" Description="How you sign in." Icon="Lucide.Shield" Dividers Gap="3">
        <Switch @bind-Value="Model!.TwoFactor" ControlPosition="ControlPosition.End" />
        <Switch @bind-Value="Model!.NewDevice" ControlPosition="ControlPosition.End" />
    </Fieldset>
</Form>

@code {
    [SupplyParameterFromForm(FormName = "fieldset-icons")]
    private Preferences? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Preferences
    {
        [Display(Name = "Mentions and replies")]
        public bool Mentions { get; set; } = true;

        [Display(Name = "Weekly digest")]
        public bool Digest { get; set; }

        [Display(Name = "Two-step sign-in")]
        public bool TwoFactor { get; set; } = true;

        [Display(Name = "Email me about new devices")]
        public bool NewDevice { get; set; } = true;
    }
}
