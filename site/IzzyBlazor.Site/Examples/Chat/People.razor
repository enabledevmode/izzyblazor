@* A support thread with a customer, as the agent sees it: your replies at the end, theirs with
   their name and picture, and the day above each day's first message. *@
<Chat Label="Conversation with Dana Whitfield" FormName="support-thread" OnSend="Send"
      Height="Length.Rem(28)" Placeholder="Reply to Dana">
    @foreach (var message in _messages)
    {
        <ChatEntry Mine="message.Mine" Author="@(message.Mine ? null : "Dana Whitfield")" Text="@message.Text"
                   Time="message.Time" Copyable="false" />
    }
</Chat>

@* hide *@
@code {
    private sealed record Message(bool Mine, string Text, DateTimeOffset Time);

    private static readonly DateTimeOffset Today = DateTimeOffset.Now.Date;

    private readonly List<Message> _messages =
    [
        new(false, "Hi, my order #4821 arrived without the charger.", Today.AddDays(-1).AddHours(16).AddMinutes(12)),
        new(true, "Sorry about that, Dana. I've sent a charger by express; it should arrive tomorrow morning.", Today.AddDays(-1).AddHours(16).AddMinutes(20)),
        new(false, "It came this morning, thanks!", Today.AddHours(9).AddMinutes(5)),
        new(true, "Great to hear. Is there anything else I can help with?", Today.AddHours(9).AddMinutes(7)),
    ];

    private void Send(ChatSendArgs message) => _messages.Add(new Message(true, message.Text, DateTimeOffset.Now));
}
@* /hide *@
