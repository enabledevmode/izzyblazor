@* ToolbarToggleButtons: in the … menu they're checkbox items, which toggle the same value. *@
<Card Size="ControlSize.Sm" Width="Length.Full">
    <CardBody Gap="3">
        <Toolbar Label="Format">
            <ToolbarButtonGroup Label="Text style" Priority="1">
                <ToolbarToggleButton Icon="Lucide.Bold" Label="Bold" IconOnly @bind-Value="_bold" />
                <ToolbarToggleButton Icon="Lucide.Italic" Label="Italic" IconOnly @bind-Value="_italic" />
            </ToolbarButtonGroup>
            <ToolbarSeparator />
            <ToolbarToggleButton Icon="Lucide.Pilcrow" @bind-Value="_marks">Show marks</ToolbarToggleButton>
            <ToolbarToggleButton Icon="Lucide.SpellCheck" @bind-Value="_spelling">Check spelling</ToolbarToggleButton>
        </Toolbar>
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">
            Bold @OnOff(_bold), italic @OnOff(_italic), marks @OnOff(_marks), spelling @OnOff(_spelling)
        </TextBlock>
    </CardBody>
</Card>

@code {
    private bool _bold = true;
    private bool _italic;
    private bool _marks;
    private bool _spelling = true;

    private static string OnOff(bool on) => on ? "on" : "off";
}
