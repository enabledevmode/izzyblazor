<Card Size="ControlSize.Sm" Width="Length.Full">
    <CardBody Gap="4">
        <Toolbar Label="Document">
            <IconButton Icon="Lucide.ArrowLeft" Label="Back to files" Href="docs/components/toolbar" />
            <ToolbarCenter>
                <ToolbarItem Overflow="ToolbarOverflow.Never" Width="Length.Rem(9)">
                    <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium" Truncate>Q3 report.pdf</TextBlock>
                </ToolbarItem>
            </ToolbarCenter>
            <ToolbarEnd>
                <ButtonGroup Label="Zoom">
                    <IconButton Icon="Lucide.ZoomOut" Label="Zoom out" />
                    <IconButton Icon="Lucide.ZoomIn" Label="Zoom in" />
                </ButtonGroup>
                <IconButton Icon="Lucide.Printer" Label="Print" />
                <IconButton Icon="Lucide.Download" Label="Download" />
            </ToolbarEnd>
        </Toolbar>
        <AspectRatio Ratio="5.0" Bg="Color.SurfaceContainer" Radius="Radius.Md" />
    </CardBody>
</Card>
