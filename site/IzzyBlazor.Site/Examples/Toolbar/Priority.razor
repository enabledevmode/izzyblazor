<Card Size="ControlSize.Sm" Width="Length.Full">
    <CardBody>
        <Toolbar Label="File">
            <ToolbarItem Overflow="ToolbarOverflow.Never">
                <Button StartIcon="Lucide.Upload" Accent="Accent.Primary" Variant="ButtonVariant.Solid">Upload</Button>
            </ToolbarItem>
            <ToolbarItem Priority="1">
                <Button StartIcon="Lucide.Share2">Share</Button>
            </ToolbarItem>
            <Button StartIcon="Lucide.Pencil">Rename</Button>
            <ToolbarItem Priority="-1">
                <Button StartIcon="Lucide.FolderInput">Move</Button>
            </ToolbarItem>
            <ToolbarSeparator />
            <ToolbarItem Overflow="ToolbarOverflow.Always">
                <Button StartIcon="Lucide.Printer">Print</Button>
            </ToolbarItem>
            <ToolbarItem Overflow="ToolbarOverflow.Always">
                <Button StartIcon="Lucide.FileClock">Version history</Button>
            </ToolbarItem>
        </Toolbar>
    </CardBody>
</Card>
