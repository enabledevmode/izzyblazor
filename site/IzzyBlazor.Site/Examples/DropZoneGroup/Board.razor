@* Each column is a ListView with a Zone; the group holds every task and ZoneOf says which column
   it's in. On a static page every move posts the form (SubmitOnMove) and Order shows it. *@
<Stack Grow>
    <Form Model="this" FormName="drop-zone-board">
        <DropZoneGroup @bind-Items="_tasks" ItemKey="t => t.Id" ZoneOf="t => t.Status" Name="board" Order="Order" SubmitOnMove>
            <Grid Columns="new() { Base = 1, Md = 3 }" Gap="3">
                @foreach (var (zone, label) in Columns)
                {
                    <Stack Gap="3" Padding="3" Bg="Color.SurfaceSunken" Radius="Radius.Lg">
                        <Heading Level="3" Size="TextSize.Md">@label</Heading>
                        <ListView Zone="@zone" AriaLabel="@label" Cards ItemText="t => t.Title" Size="ControlSize.Sm" />
                    </Stack>
                }
            </Grid>
        </DropZoneGroup>
    </Form>
</Stack>

@code {
    [SupplyParameterFromForm(FormName = "drop-zone-board", Name = "board")]
    private ListOrder? Order { get; set; }

    private static readonly (string Zone, string Label)[] Columns = [("todo", "To do"), ("doing", "Doing"), ("done", "Done")];

    private IReadOnlyList<BoardTask> _tasks =
    [
        new("1", "Write the brief", "todo"),
        new("2", "Pick a venue", "todo"),
        new("3", "Book the speakers", "doing"),
        new("4", "Set the date", "done"),
    ];
    @* hide *@
    private sealed record BoardTask(string Id, string Title, string Status);
    @* /hide *@
}
