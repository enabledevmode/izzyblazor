@* Six weeks of a stock's trading days as candlesticks. *@
<Chart Items="_days" Argument="d => d.Date" Title="Northwind Traders (NWND), Sep to Oct 2026">
    <ChartValueAxis Format="C2" />
    <ChartCandlestickSeries Open="d => d.Open" High="d => d.High" Low="d => d.Low" Close="d => d.Close" Name="NWND" />
</Chart>

@code {
    private record Day(DateOnly Date, decimal Open, decimal High, decimal Low, decimal Close);

    private static readonly HashSet<DateOnly> Holidays = [new(2026, 9, 7)];

    private readonly Day[] _days;

    public Usage()
    {
        // Trading days: a random walk with a slow climb, each day opening near the last close.
        var random = new Random(26);
        var days = new List<Day>();
        var close = 204m;
        for (var date = new DateOnly(2026, 9, 14); date <= new DateOnly(2026, 10, 23); date = date.AddDays(1))
        {
            if (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday || Holidays.Contains(date)) continue;
            var open = Math.Round(close * (1 + (decimal)(random.NextDouble() - 0.5) * 0.012m), 2);
            close = Math.Round(open * (1 + (decimal)(random.NextDouble() - 0.47) * 0.04m), 2);
            var high = Math.Round(Math.Max(open, close) * (1 + (decimal)random.NextDouble() * 0.012m), 2);
            var low = Math.Round(Math.Min(open, close) * (1 - (decimal)random.NextDouble() * 0.012m), 2);
            days.Add(new Day(date, open, high, low, close));
        }

        _days = [.. days];
    }
}
