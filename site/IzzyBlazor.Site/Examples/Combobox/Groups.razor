@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="combobox-groups" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <Combobox @bind-Value="Model!.OwnerId" Items="People.Keys" ItemText="id => People.GetValueOrDefault(id)?.Name ?? id.ToString()"
              ItemGroup="id => People.GetValueOrDefault(id)?.Team" />
    <Row><Button Submit>Save</Button></Row>
    @if (_saved is { } saved)
    {
        <Alert Status="Status.Success">Saved: @(People.GetValueOrDefault(saved)?.Name).</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "combobox-groups")]
    private Issue? Model { get; set; }

    private int? _saved;

    protected override void OnInitialized() => Model ??= new() { OwnerId = 1 };

    private void Save() => _saved = Model!.OwnerId;

    public sealed class Issue
    {
        [Display(Name = "Owner")]
        public int OwnerId { get; set; }
    }

    @* hide *@
    private sealed record Person(string Name, string Team);

    private static readonly Dictionary<int, Person> People = new()
    {
        [1] = new("Ada Lovelace", "Engineering"), [2] = new("Grace Hopper", "Engineering"), [3] = new("Linus Torvalds", "Engineering"),
        [4] = new("Alan Turing", "Research"), [5] = new("Barbara Liskov", "Research"),
        [6] = new("Margaret Hamilton", "Flight software"), [7] = new("Katherine Johnson", "Flight software"),
    };
    @* /hide *@
}
