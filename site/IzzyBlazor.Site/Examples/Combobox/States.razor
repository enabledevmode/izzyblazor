<Form Model="Model" FormName="combobox-states" MaxWidth="24.Rem" Grow>
    <Combobox @bind-Value="Model!.Small" Items="Timezones.Keys" ItemText="Name"
              Label="Small" Size="ControlSize.Sm" />
    <Combobox @bind-Value="Model!.Large" Items="Timezones.Keys" ItemText="Name"
              Label="Large" Size="ControlSize.Lg" />
    <Combobox @bind-Value="Model!.Office" Items="Timezones.Keys" ItemText="Name"
              Label="Office time zone" ReadOnly Hint="Read-only: posted, but can't be changed." />
    <Combobox @bind-Value="Model!.Backup" Items="Timezones.Keys" ItemText="Name"
              Label="Backup time zone" Disabled Hint="Disabled: not posted." />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "combobox-states")]
    private Settings? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private static string Name(string? id) => Timezones.GetValueOrDefault(id!, id!);

    public sealed class Settings
    {
        public string? Small { get; set; } = "Europe/London";
        public string? Large { get; set; } = "Asia/Tokyo";
        public string? Office { get; set; } = "Europe/Paris";
        public string? Backup { get; set; } = "America/New_York";
    }

    @* hide *@
    private static readonly Dictionary<string, string> Timezones = new()
    {
        ["America/Los_Angeles"] = "Los Angeles", ["America/New_York"] = "New York", ["America/Sao_Paulo"] = "São Paulo",
        ["Europe/London"] = "London", ["Europe/Paris"] = "Paris", ["Asia/Kolkata"] = "Kolkata",
        ["Asia/Tokyo"] = "Tokyo", ["Australia/Sydney"] = "Sydney",
    };
    @* /hide *@
}
