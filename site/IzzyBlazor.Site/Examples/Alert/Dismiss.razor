<Stack Gap="3" Grow MaxWidth="36.Rem">
    <Alert Status="Status.Warning" Title="Unverified email" Dismissible @bind-Dismissed="_dismissed">
        Check your inbox for the link we sent to ada@example.com.
        <AlertActions>
            <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Resend email</Button>
        </AlertActions>
    </Alert>
    @* Interactive pages only (and their prerender, so nothing moves): C# shows it again. *@
    @if (RendererInfo.IsInteractive || AssignedRenderMode is not null)
    {
        <Switch @bind-Value="ShowReminder" Label="Show the reminder" />
    }
</Stack>

@code {
    private bool _dismissed;

    private bool ShowReminder
    {
        get => !_dismissed;
        set => _dismissed = !value;
    }
}
