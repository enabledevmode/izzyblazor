@* A clinic's coming two weeks of appointments as a list by day: the agenda leaves out empty days,
   and each day links to its day view. *@
<Scheduler Items="_visits" Start="v => v.Start" End="v => v.End" Title="v => v.Patient" Category="v => v.Kind"
           View="SchedulerView.Agenda" AgendaDays="14" ViewOptions="[SchedulerView.Day, SchedulerView.Week, SchedulerView.Agenda]" QueryPrefix="clinic-"
           Categories="_kinds" />

@code {
    private readonly SchedulerCategory[] _kinds =
    [
        new("checkup", "Checkup"), new("followup", "Follow-up"), new("new", "New patient"),
    ];

    private record Visit(string Patient, DateTime Start, DateTime End, string Kind);

    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);

    private static Visit At(int day, int hour, int minute, int length, string patient, string kind)
    {
        var start = Today.AddDays(day).ToDateTime(new TimeOnly(hour, minute));
        return new Visit(patient, start, start.AddMinutes(length), kind);
    }

    private readonly Visit[] _visits =
    [
        At(0, 9, 0, 30, "M. Alvarez", "checkup"), At(0, 9, 30, 30, "J. Chen", "followup"), At(0, 11, 0, 45, "R. Okafor", "new"),
        At(1, 8, 30, 30, "S. Novak", "checkup"), At(1, 14, 0, 30, "T. Brooks", "followup"),
        At(3, 10, 0, 45, "A. Haddad", "new"), At(3, 10, 45, 30, "L. Moreau", "checkup"),
        At(6, 9, 0, 30, "J. Chen", "followup"), At(8, 13, 30, 30, "K. Ito", "checkup"),
        At(9, 15, 0, 45, "P. Singh", "new"), At(12, 9, 30, 30, "S. Novak", "followup"),
    ];
}
