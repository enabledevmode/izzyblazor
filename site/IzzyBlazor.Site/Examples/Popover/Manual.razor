@* The Stack only gives the panel room in this frame. *@
<Stack Justify="Justify.Center" MinHeight="13.Rem" Grow>
    <Row>
        <Popover Label="Release checklist" StartIcon="Lucide.Pin" Title="Before you release" Mode="PopoverMode.Manual" Placement="Placement.End">
            <Stack Gap="2">
                <TextBlock Size="TextSize.Sm">1. Bump the version in the project file.</TextBlock>
                <TextBlock Size="TextSize.Sm">2. Update the changelog.</TextBlock>
                <TextBlock Size="TextSize.Sm">3. Tag the commit and push the tag.</TextBlock>
            </Stack>
        </Popover>
    </Row>
</Stack>
