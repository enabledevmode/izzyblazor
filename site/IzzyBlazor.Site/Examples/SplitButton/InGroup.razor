<Column Gap="3" Width="Length.Full">
    <ButtonGroup Label="Row" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">
        <Button>Before</Button>
        <SplitButton Label="Middle" MenuLabel="Middle options"><MenuItem>Option</MenuItem></SplitButton>
        <Button>After</Button>
    </ButtonGroup>
    <Row Gap="3" Wrap Align="Align.Center">
        <ButtonGroup Label="Row starting with it" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">
            <SplitButton Label="First" MenuLabel="First options"><MenuItem>Option</MenuItem></SplitButton>
            <Button>After</Button>
        </ButtonGroup>
        <ButtonGroup Label="Row ending with it" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">
            <Button>Before</Button>
            <SplitButton Label="Last" MenuLabel="Last options"><MenuItem>Option</MenuItem></SplitButton>
        </ButtonGroup>
        <ButtonGroup Label="Row of one" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">
            <SplitButton Label="Alone" MenuLabel="Alone options"><MenuItem>Option</MenuItem></SplitButton>
        </ButtonGroup>
    </Row>
    <ButtonGroup Label="Solid row">
        <Button>Before</Button>
        <SplitButton Label="Solid middle" MenuLabel="Solid middle options"><MenuItem>Option</MenuItem></SplitButton>
    </ButtonGroup>
    <SplitButton Label="Full width" FullWidth MenuLabel="Full width options" Variant="ButtonVariant.Soft"><MenuItem>Option</MenuItem></SplitButton>
</Column>
