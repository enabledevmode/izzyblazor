@using System.ComponentModel.DataAnnotations

<Card Title="Sign in" TitleLevel="2" MaxWidth="24.Rem" Grow>
    <Form Model="Model" FormName="sign-in" OnValidSubmit="Submit">
        <TextField @bind-Value="Model!.Email" AutoComplete="username" />
        <TextField @bind-Value="Model!.Password" AutoComplete="current-password" />
        <Checkbox @bind-Value="Model!.RememberMe" Label="Remember me" />
        <Button Submit FullWidth>Sign in</Button>
        @if (_signedIn)
        {
            <Alert Status="Status.Success">Signed in as @Model!.Email.</Alert>
        }
    </Form>
</Card>

@code {
    [SupplyParameterFromForm(FormName = "sign-in")]
    private Credentials? Model { get; set; }

    private bool _signedIn;

    protected override void OnInitialized() => Model ??= new();

    private void Submit() => _signedIn = true;

    public sealed class Credentials
    {
        [Required(ErrorMessage = "Enter your email"), EmailAddress]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Enter your password"), DataType(DataType.Password)]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; }
    }
}
