@* C# follows the selected tab, and a button selects one from C#. *@
<Stack Gap="3" Grow>
    <Tabs @bind-Selected="_tab" Label="Account">
        <Tab Label="Profile" Value="profile" Icon="Lucide.User">
            <TextBlock Color="Color.Muted">Your name, photo and the email people see.</TextBlock>
        </Tab>
        <Tab Label="Billing" Value="billing" Icon="Lucide.CreditCard">
            <TextBlock Color="Color.Muted">Your plan, payment method and invoices.</TextBlock>
        </Tab>
        <Tab Label="Security" Value="security" Icon="Lucide.Shield">
            <TextBlock Color="Color.Muted">Your password, passkeys and sessions.</TextBlock>
        </Tab>
    </Tabs>
    <Row Gap="3" Align="Align.Center">
        <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" OnClick="@(() => _tab = "billing")">Go to Billing</Button>
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">C# has the tab as <Code>@_tab</Code></TextBlock>
    </Row>
</Stack>

@code {
    private string? _tab = "profile";
}
