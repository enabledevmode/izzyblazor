@inject DialogService Dialogs

<DialogHost />

<Tabs @bind-Selected="_selected" OnClose="CloseAsync" OnAdd="Add" AddLabel="New invoice" Label="Open invoices" Grow>
    <Tab Label="All invoices" Value="all" Icon="Lucide.List" Closable="false">
        <TextBlock Color="Color.Muted">@_open.Count invoices open. Close one with its button, or with Delete on its tab.</TextBlock>
    </Tab>
    @foreach (var invoice in _open)
    {
        <Tab @key="invoice.Number" Label="@invoice.Number" Value="@invoice.Number" Badge="@(invoice.Draft ? "Draft" : null)">
            <TextBlock>@invoice.Customer: @invoice.Amount.ToString("C", Usd)</TextBlock>
        </Tab>
    }
</Tabs>

@code {
    private string? _selected = "INV-1043";
    private int _next = 1046;

    private readonly List<Invoice> _open =
    [
        new("INV-1042", "Northwind Traders", 1_280.00m),
        new("INV-1043", "Contoso Pharmacy", 642.50m),
        new("INV-1045", "Fabrikam Garden Supply", 3_915.75m),
    ];

    // The tab goes when it leaves the list; a draft asks first, and stays open on Cancel.
    private async Task CloseAsync(string number)
    {
        var invoice = _open.First(i => i.Number == number);
        if (invoice.Draft && !await Dialogs.ConfirmAsync($"{number} hasn't been saved.", "Discard draft?",
                new() { ConfirmText = "Discard", Accent = Accent.Danger }))
        {
            return;
        }

        _open.Remove(invoice);
    }

    private void Add()
    {
        var draft = new Invoice($"INV-{_next++}", "New customer", 0m, Draft: true);
        _open.Add(draft);
        _selected = draft.Number;
    }

    private sealed record Invoice(string Number, string Customer, decimal Amount, bool Draft = false);

    @* hide *@
    private static readonly System.Globalization.CultureInfo Usd = new("en-US");
    @* /hide *@
}
