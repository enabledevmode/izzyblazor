@* A software company's cloud bill for the year, by category, then service, then environment:
   each tile opens what it's made of, laid out again at full size. *@
<TreemapChart id="cloud-drill" Items="_costs" Value="c => c.Amount" ValueFormat="C0" Values Title="Cloud costs, 2026" Drill="cloud">
    <ChartDrillLevel Argument="c => c.Category" Name="Category" />
    <ChartDrillLevel Argument="c => c.Service" Name="Service" />
    <ChartDrillLevel Argument="c => c.Environment" Name="Environment" />
</TreemapChart>

@code {
    private record Cost(string Category, string Service, string Environment, decimal Amount);

    // Each service's bill for the year, split between production and the environments that test it.
    private static readonly (string Category, string Service, decimal Yearly, decimal Production)[] Services =
    [
        ("Compute", "App servers", 220800, 0.72m), ("Compute", "Background jobs", 86400, 0.81m), ("Compute", "Build runners", 37200, 0.2m),
        ("Database", "Primary database", 151200, 0.78m), ("Database", "Read replicas", 75600, 1m), ("Database", "Cache", 28800, 0.66m),
        ("Storage", "Object storage", 62400, 0.85m), ("Storage", "Backups", 34800, 1m), ("Storage", "Block volumes", 21600, 0.6m),
        ("Network", "Data transfer", 73200, 0.93m), ("Network", "Load balancers", 18000, 0.5m), ("Network", "CDN", 14400, 1m),
        ("Monitoring", "Logs", 45600, 0.64m), ("Monitoring", "Metrics", 16800, 0.7m), ("Monitoring", "Tracing", 8400, 0.75m),
    ];

    // The rest of each bill, two parts staging to one part development; services only in production have no others.
    private static readonly Cost[] _costs = Services.SelectMany(s => new[]
    {
        new Cost(s.Category, s.Service, "Production", Math.Round(s.Yearly * s.Production)),
        new Cost(s.Category, s.Service, "Staging", Math.Round(s.Yearly * (1 - s.Production) * 2 / 3)),
        new Cost(s.Category, s.Service, "Development", Math.Round(s.Yearly * (1 - s.Production) / 3)),
    }.Where(c => c.Amount > 0)).ToArray();
}
