<Grid Columns="new() { Base = 1, Sm = 2 }" Gap="4" Grow>
    <Column Gap="3" Padding="5" Border="1" Radius="Radius.Lg">
        <Heading Level="3">Starter</Heading>
        <TextBlock Color="Color.Muted">For side projects.</TextBlock>
        <Spacer />
        <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Choose Starter</Button>
    </Column>
    <Column Gap="3" Padding="5" Border="1" Radius="Radius.Lg">
        <Heading Level="3">Team</Heading>
        <TextBlock Color="Color.Muted">For teams that ship every day: shared projects, roles, audit logs and priority support.</TextBlock>
        <Spacer />
        <Button>Choose Team</Button>
    </Column>
</Grid>
