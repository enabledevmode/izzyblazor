@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="rating-usage" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <Rating @bind-Value="Model!.Stars" Hint="Click your rating again to clear it." />
    <Row><Button Submit>Save</Button></Row>
    @if (_saved)
    {
        <Alert Status="Status.Success">Saved: @(_stars is { } stars ? $"{stars} of 5 stars" : "no rating").</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "rating-usage")]
    private ProductReview? Model { get; set; }

    // What was saved, not the field: on an interactive page it follows each click.
    private bool _saved;
    private int? _stars;

    protected override void OnInitialized() => Model ??= new() { Stars = 4 };

    private void Save() => (_saved, _stars) = (true, Model!.Stars);

    public sealed class ProductReview
    {
        [Display(Name = "Your rating")]
        public int? Stars { get; set; }
    }
}
