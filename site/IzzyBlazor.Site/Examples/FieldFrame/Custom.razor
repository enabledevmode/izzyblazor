@using System.ComponentModel.DataAnnotations

@* NativeValidation="false" skips the browser's check, so the server's message shows. The form takes
   an EditContext so the frame can show the field's messages and the input can point at them. *@
<Form EditContext="_edit" FormName="field-frame-custom" OnValidSubmit="Save" NativeValidation="false" MaxWidth="20.Rem" Grow>
    <FieldFrame Class="ib-field" Id="due-date" Label="Due date" Required Hint="Reminders go out the day before." HintId="due-date-hint"
                Errors="Errors" ErrorId="due-date-error">
        <div class="ib-field-control">
            <InputDate @bind-Value="Model!.Due" id="due-date" class="ib-field-input" required
                       aria-invalid="@(Errors.Count > 0 ? "true" : null)"
                       aria-describedby="@(Errors.Count > 0 ? "due-date-hint due-date-error" : "due-date-hint")" />
        </div>
    </FieldFrame>
    <Row><Button Submit>Set due date</Button></Row>
    @if (_saved)
    {
        <Alert Status="Status.Success">Due @(Model!.Due?.ToString("MMMM d")).</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "field-frame-custom")]
    private Assignment? Model { get; set; }

    private EditContext _edit = null!;
    private bool _saved;

    private IReadOnlyList<string> Errors => _edit.GetValidationMessages(new FieldIdentifier(Model!, nameof(Assignment.Due))).ToList();

    protected override void OnInitialized()
    {
        Model ??= new();
        _edit = new EditContext(Model);
    }

    private void Save() => _saved = true;

    public sealed class Assignment
    {
        [Required(ErrorMessage = "Pick a due date")]
        public DateOnly? Due { get; set; }
    }
}
