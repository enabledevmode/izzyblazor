<Box MaxWidth="26.Rem" Grow>
    <FieldFrame Class="ib-field" Id="subdomain" Label="Workspace address" Hint="Lowercase letters, numbers and dashes." HintId="subdomain-hint">
        <FieldAddons>
            <StartAddon>https://</StartAddon>
            <EndAddon>.acme.app</EndAddon>
            <ChildContent>
                <div class="ib-field-control">
                    <input id="subdomain" class="ib-field-input" name="subdomain" value="design-team" autocomplete="off" aria-describedby="subdomain-hint" />
                </div>
            </ChildContent>
        </FieldAddons>
    </FieldFrame>
</Box>
