@* One choice: a click, Space or Enter selects an item, and its branch opens on the way back. *@
<Stack Gap="3" MaxWidth="20.Rem" Grow>
    <TreeView Items="_categories" ItemChildren="c => c.Children" ItemKey="c => c.Name" ItemText="c => c.Name"
              SelectionMode="SelectionMode.Single" @bind-Selection="_category" Label="Category" />
    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Chosen: @(_category?.Keys?.FirstOrDefault() ?? "none")</TextBlock>
</Stack>

@code {
    private Selection? _category = Selection.Of("Laptops");

    private readonly Kind[] _categories =
    [
        new("Computers", [new("Laptops", []), new("Desktops", []), new("Monitors", [])]),
        new("Phones", [new("Cases", []), new("Chargers", [])]),
        new("Audio", [new("Headphones", []), new("Speakers", [])]),
    ];
    @* hide *@
    private sealed record Kind(string Name, Kind[] Children);
    @* /hide *@
}
