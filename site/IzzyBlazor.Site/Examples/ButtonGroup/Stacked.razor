<Row Gap="6" Align="Align.Center" Wrap Justify="Justify.Center" Grow>
    <ButtonGroup Label="Zoom" Orientation="Orientation.Vertical" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">
        <IconButton Icon="Lucide.ZoomIn" Label="Zoom in" />
        <IconButton Icon="Lucide.ZoomOut" Label="Zoom out" />
    </ButtonGroup>
    <Box Grow MaxWidth="20.Rem">
        <ButtonGroup Label="Export" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" FullWidth>
            <Button StartIcon="Lucide.FileSpreadsheet">Export CSV</Button>
            <Button StartIcon="Lucide.FileText">Export PDF</Button>
        </ButtonGroup>
    </Box>
</Row>
