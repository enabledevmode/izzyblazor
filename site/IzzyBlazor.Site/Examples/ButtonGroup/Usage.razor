        <IconButton Icon="Lucide.Undo2" Label="Undo" />
        <IconButton Icon="Lucide.Redo2" Label="Redo" />
    </ButtonGroup>
    <ButtonGroup Label="Pages" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">
