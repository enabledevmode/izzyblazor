@* A help article: larger text, and the article's own heading style on both the editor and the
   published page. *@
<Grid Columns="new() { Base = 1, Md = 2 }" Gap="6" Grow>
    <RichTextEditor @bind-Value="_article" Label="Article" TextSize="ProseSize.Lg" ContentClass="help-article" />
    <RichText Html="@_article" Size="ProseSize.Lg" Class="help-article" />
</Grid>

<style>
    .help-article h3 { color: var(--ib-color-primary); }
</style>

@code {
    private string? _article = "<h3>Changing your plan</h3><p>Go to <strong>Settings › Billing</strong> and choose a plan. The change starts on your next bill.</p>";
}
