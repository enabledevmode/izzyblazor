@* A ticket's description: read-only once the ticket is closed. *@
<Stack Gap="4" Grow>
    <RichTextEditor @bind-Value="_closed" Label="Description" ReadOnly Rows="3" />
    <RichTextEditor @bind-Value="_archived" Label="Description" Disabled Rows="3" />
</Stack>

@code {
    private string? _closed = "<p>Exports fail for reports with more than <strong>10,000 rows</strong>. Fixed in 2.4.1.</p>";
    private string? _archived = "<p>Exports fail for reports with more than <strong>10,000 rows</strong>. Fixed in 2.4.1.</p>";
}
