@* A column for each status: Value is the status as the data stores it, Title what the header
   shows. ColumnOf says which column a task is in. OnMove gives a moved task its
   new status, which is where an app saves it. *@
<Stack Grow>
    <Kanban TItem="LaunchTask" @bind-Items="_tasks" ItemKey="t => t.Id" ColumnOf="t => t.Status" ItemText="t => t.Title" ItemDescription="t => t.Owner"
            OnMove="Moved" Label="Launch tasks">
        <Columns>
            <KanbanColumn Value="todo" Title="To do" />
            <KanbanColumn Value="doing" Title="In progress" />
            <KanbanColumn Value="done" Title="Done" />
        </Columns>
    </Kanban>
</Stack>

@code {
    private IReadOnlyList<LaunchTask> _tasks =
    [
        new("1", "Write the release notes", "Ada Lovelace", "todo"),
        new("2", "Record the demo video", "Alan Turing", "todo"),
        new("3", "Update the pricing page", "Grace Hopper", "doing"),
        new("4", "Email the beta list", "Ada Lovelace", "doing"),
        new("5", "Set the launch date", "Grace Hopper", "done"),
    ];

    // Where an app saves the move.
    private void Moved(KanbanMoveEventArgs<LaunchTask> move) => move.Item.Status = move.ToColumn;
    @* hide *@
    private sealed class LaunchTask(string id, string title, string owner, string status)
    {
        public string Id { get; } = id;
        public string Title { get; } = title;
        public string Owner { get; } = owner;
        public string Status { get; set; } = status;
    }
    @* /hide *@
}
