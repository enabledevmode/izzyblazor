@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="slider-value" MaxWidth="24.Rem" Grow>
    <Slider @bind-Value="Model!.Volume" ValueTooltip="SliderTooltip.Active" />
    <Slider @bind-Value="Model!.Discount" Step="5" ValueFormat="{0}%" ValueTooltip="SliderTooltip.Always" ShowEnds Hint="In steps of 5, up to 50%." />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "slider-value")]
    private Settings? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Settings
    {
        [Display(Name = "Alert volume")]
        public int Volume { get; set; } = 60;

        [Range(0, 50), Display(Name = "Launch discount")]
        public int Discount { get; set; } = 15;
    }
}
