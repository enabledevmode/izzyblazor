@using Microsoft.AspNetCore.Http

<Form Model="Model" FormName="file-upload-preview" OnValidSubmit="Save" MaxWidth="30.Rem" Grow>
    <FileUpload Name="Logo" Label="Logo" Size="ControlSize.Sm" Accept=".png,.jpg,.jpeg" AcceptText="PNG or JPG · up to 2 MB" MaxFileSize="2_000_000" OnChange="Chosen">
        <Preview><Avatar Icon="Lucide.BuildingComplex" Size="AvatarSize.Lg" Accent="Accent.Neutral" Square Decorative /></Preview>
    </FileUpload>
    <TextField @bind-Value="Model!.Name" Label="Company name" />
    <Row><Button Submit>Save company</Button></Row>
    @if (_result is not null)
    {
        <Alert Status="Status.Success">@_result</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "file-upload-preview")]
    private Company? Model { get; set; }

    // Static pages: the logo posts with the form, bound by its Name.
    [SupplyParameterFromForm(FormName = "file-upload-preview")]
    private IFormFile? Logo { get; set; }

    // Interactive pages: OnChange gets the logo as it's chosen.
    private IBrowserFile? _chosen;
    private string? _result;

    protected override void OnInitialized() => Model ??= new();

    private void Chosen(IReadOnlyList<IBrowserFile> files) => _chosen = files.FirstOrDefault();

    // Your app would check the file and store it here (see Types, size and posting), then show it as the Avatar's Src.
    private void Save() => _result = (Logo?.FileName ?? _chosen?.Name) is { } file
        ? $"Saved {Model!.Name} with {file}."
        : $"Saved {Model!.Name}. It keeps the logo it had.";

    public sealed class Company
    {
        public string Name { get; set; } = "Acme Co.";
    }
}
