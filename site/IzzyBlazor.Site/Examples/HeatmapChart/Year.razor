@* A site's visitors in each hour of each day of 2025: busy weekday mornings and evenings, quiet nights, a summer dip. *@
<HeatmapChart Items="_visits" Column="v => v.Day" Row="v => v.Hour" Value="v => v.Visitors"
              RowFormat="HH:mm" CellHeight="Length.Rem(0.75)" Steps="0" ValueFormat="N0"
              Title="Visitors by hour, 2025" />

@code {
    private record HourlyVisits(DateOnly Day, TimeOnly Hour, int Visitors);

    private readonly HourlyVisits[] _visits = Build();

    private static HourlyVisits[] Build()
    {
        var start = new DateOnly(2025, 1, 1);
        var visits = new List<HourlyVisits>();
        for (var d = 0; d < 365; d++)
        {
            var day = start.AddDays(d);
            var weekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
            // Fewer visitors in the summer weeks and over the holidays.
            var season = 1 - 0.35 * Math.Exp(-Math.Pow((d - 215) / 22.0, 2)) - (d > 354 ? 0.4 : 0);
            for (var h = 0; h < 24; h++)
            {
                // A morning peak and an evening peak; weekends later and flatter.
                var shape = weekend
                    ? 0.15 + 0.6 * Math.Exp(-Math.Pow((h - 14) / 4.5, 2))
                    : 0.08 + Math.Exp(-Math.Pow((h - 10) / 2.5, 2)) + 0.7 * Math.Exp(-Math.Pow((h - 20) / 2.0, 2));
                var noise = 0.85 + 0.3 * ((d * 7919 + h * 104729) % 97) / 97.0;
                visits.Add(new HourlyVisits(day, new TimeOnly(h, 0), (int)(1200 * shape * season * noise)));
            }
        }

        return [.. visits];
    }
}
