@* How far each month's average temperature was from the city's 1991–2020 normal, in °C. *@
<HeatmapChart Items="_months" Column="m => m.Month" Row="m => m.City" Value="m => m.Difference"
              Palette="ChartPalette.Diverging(Color.Primary, Color.Danger)"
              ValueFormat="+0.0;−0.0;0.0" Legend="ChartLegend.End"
              Title="Temperature against normal, 2025 (°C)" />

@code {
    private record CityMonth(string City, string Month, double Difference);

    private static readonly string[] Months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

    private static readonly (string City, double[] Differences)[] Cities =
    [
        ("London", [0.8, 1.2, 1.9, 2.4, 1.1, 1.8, 2.6, 0.9, -0.3, 0.7, 1.4, 0.2]),
        ("Madrid", [1.1, 0.4, -0.8, 0.6, 2.3, 3.1, 2.8, 3.4, 1.6, 0.9, 0.5, -0.2]),
        ("Chicago", [-2.6, -1.4, 1.8, 0.4, -0.9, 1.2, 1.6, 0.8, 2.1, 1.9, -0.6, -1.8]),
        ("Tokyo", [0.3, -0.6, 1.4, 1.8, 0.9, 2.2, 2.9, 3.3, 2.6, 1.7, 0.8, 0.4]),
        ("Sydney", [1.2, 0.9, 1.6, 0.4, -0.7, 0.3, 0.6, 1.1, 1.8, 2.0, 1.3, 2.4]),
    ];

    private readonly CityMonth[] _months =
        [.. Cities.SelectMany(c => c.Differences.Select((d, m) => new CityMonth(c.City, Months[m], d)))];
}
