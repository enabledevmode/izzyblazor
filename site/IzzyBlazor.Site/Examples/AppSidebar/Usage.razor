@inject NavigationManager Navigation

@* From 768px up the sidebar is a column beside the page; below it, a drawer behind the menu
   button, with SidebarHeader in its top row beside the close button. SidebarFooter stays at the
   bottom while the links between scroll. *@
<AppShell>
    <AppHeader>
        <SidebarToggle />
        <AppBrand Href="@To(null)" Icon="Lucide.Zap" Label="Acme" />
    </AppHeader>

    <AppSidebar>
        <SidebarHeader>
            <Row Gap="2" Align="Align.Center">
                <Avatar Name="Marketing" Size="AvatarSize.Sm" Square Decorative />
                <TextBlock As="span" Weight="FontWeight.Semibold">Marketing</TextBlock>
            </Row>
        </SidebarHeader>
        <NavMenu>
            <NavItem Href="@To(null)" Icon="Lucide.House">Home</NavItem>
            <NavItem Href='@To("campaigns")' Icon="Lucide.Megaphone" Badge="3">Campaigns</NavItem>
            <NavItem Href='@To("audiences")' Icon="Lucide.Users">Audiences</NavItem>
            <NavItem Href='@To("reports")' Icon="Lucide.ChartColumn">Reports</NavItem>
        </NavMenu>
        <SidebarFooter>
            <NavMenu aria-label="Account">
                <NavItem Href='@To("account")' Icon="Lucide.CircleUser">Ada Lovelace</NavItem>
            </NavMenu>
        </SidebarFooter>
    </AppSidebar>

    <AppMain>
        <Stack Gap="4" Padding="new() { Base = 4, Md = 8 }" MaxWidth="Length.Prose">
            <Heading Level="1" Size="TextSize.Xl2">Home</Heading>
            <TextBlock Color="Color.Muted">On a phone, the menu button at the top opens the sidebar as a drawer over the page. Its close button or a link closes it again, and with the script, Escape.</TextBlock>
            <Card Title="Spring launch" Description="Scheduled for March 3, three channels." />
        </Stack>
    </AppMain>
</AppShell>

@code {
    // Links within this example: ?view= in its own address, so they stay here.
    private string To(string? page) => Navigation.GetUriWithQueryParameter("view", page);
}
