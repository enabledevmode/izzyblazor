@* The most visited pages, ranked as bars across so their paths have room, each bar labeled with its value. *@
<Chart Items="_pages" Argument="p => p.Path" Title="Most visited pages, October" Orientation="Orientation.Horizontal">
    <ChartValueAxis HideLabels GridLines="false" />
    <ChartBarSeries Value="p => p.Views" Name="Views" Labels="ChartLabels.Auto" LabelFormat="N0" />
</Chart>

@code {
    private record PageViews(string Path, int Views);

    private readonly PageViews[] _pages =
    [
        new("/docs/get-started/install", 48_210),
        new("/docs/components/data-grid", 31_904),
        new("/docs/components/table", 22_470),
        new("/docs/get-started/from-radzen", 17_366),
        new("/docs/components/chart", 12_085),
        new("/pricing", 9_412),
    ];
}
