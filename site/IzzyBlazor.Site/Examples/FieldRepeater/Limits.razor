@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="price-tiers" OnValidSubmit="Save" Grow MaxWidth="36.Rem">
    <FormErrors />
    <FieldRepeater @bind-Items="Model!.Tiers" NewItem="() => new Tier()" Label="Volume pricing" AddText="Add tier" MinItems="1" MaxItems="4"
                   ItemLabel="@(i => $"Tier {i + 1}")" Context="tier">
        <NumberField @bind-Value="tier.UpToSeats" Label="Up to seats" />
        <NumberField @bind-Value="tier.PricePerSeat" Label="Price per seat" Step="0.01">
            <StartAddon>$</StartAddon>
        </NumberField>
    </FieldRepeater>
    <FormActions><Button Submit>Save pricing</Button></FormActions>
    @if (_saved)
    {
        <Alert Status="Status.Success">Saved @Model.Tiers.Count tiers.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "price-tiers")]
    private Pricing? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new()
    {
        Tiers = [new() { UpToSeats = 10, PricePerSeat = 12 }, new() { UpToSeats = 50, PricePerSeat = 10 }],
    };

    private void Save() => _saved = true;

    public sealed class Pricing
    {
        public List<Tier> Tiers { get; set; } = [];
    }

    public sealed class Tier
    {
        [Display(Name = "Up to seats"), Range(1, 10_000, ErrorMessage = "Enter a seat count from 1 to 10,000.")]
        public int UpToSeats { get; set; }

        [Display(Name = "Price per seat"), Range(0, 10_000)]
        public decimal PricePerSeat { get; set; }
    }
}
