@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="emergency-contacts" OnValidSubmit="Save" Grow MaxWidth="32.Rem">
    <FieldRepeater @bind-Items="Model!.Contacts" Label="Emergency contacts" AddText="Add contact" Layout="RepeaterLayout.Stacked"
                   ItemLabel="@(i => $"Contact {i + 1}")" Context="contact">
        <TextField @bind-Value="contact.Name" Label="Name" />
        <TextField @bind-Value="contact.Relationship" Label="Relationship" />
        <TextField @bind-Value="contact.Phone" Label="Phone" Type="TextFieldType.Tel" />
    </FieldRepeater>
    <FormActions><Button Submit>Save contacts</Button></FormActions>
    @if (_saved)
    {
        <Alert Status="Status.Success">Saved @Model.Contacts.Count emergency contacts.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "emergency-contacts")]
    private Profile? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new()
    {
        Contacts = [new() { Name = "Ana Ruiz", Relationship = "Partner", Phone = "+1 415 555 0142" }],
    };

    private void Save() => _saved = true;

    public sealed class Profile
    {
        public List<Contact> Contacts { get; set; } = [];
    }

    public sealed class Contact
    {
        [Required(ErrorMessage = "Enter a name.")]
        public string? Name { get; set; }

        public string? Relationship { get; set; }

        [Required(ErrorMessage = "Enter a phone number."), Phone]
        public string? Phone { get; set; }
    }
}
