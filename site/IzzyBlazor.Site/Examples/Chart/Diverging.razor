@* A customer survey: each statement's answers as shares, from disagree to agree. *@
<Chart Items="_answers" Argument="a => a.Statement" Title="Customer survey, Q3"
       Stacking="ChartStacking.Percent" Orientation="Orientation.Horizontal"
       Palette="ChartPalette.Diverging(Color.Danger, Color.Success)">
    <ChartBarSeries Value="a => a.StronglyDisagree" Name="Strongly disagree" />
    <ChartBarSeries Value="a => a.Disagree" />
    <ChartBarSeries Value="a => a.Neutral" />
    <ChartBarSeries Value="a => a.Agree" />
    <ChartBarSeries Value="a => a.StronglyAgree" Name="Strongly agree" />
</Chart>

@code {
    private record Answers(string Statement, int StronglyDisagree, int Disagree, int Neutral, int Agree, int StronglyAgree);

    private readonly Answers[] _answers =
    [
        new("Setup was easy", 12, 31, 58, 164, 135),
        new("The docs answered my question", 21, 47, 82, 151, 99),
        new("Support replied quickly", 9, 18, 61, 140, 172),
        new("I'd recommend it", 15, 26, 70, 128, 161),
    ];
}
