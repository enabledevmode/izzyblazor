@* Revenue each month as columns, against the revenue plan as a line. *@
<Chart Items="_months" Argument="m => m.Month" Title="Revenue against plan, 2026">
    <ChartValueAxis Format="C0" />
    <ChartBarSeries Value="m => m.Revenue" Color="var(--ib-color-primary)" />
    <ChartLineSeries Value="m => m.Plan" Color="var(--ib-color-on-surface)" LineStyle="ChartLineStyle.Dashed" />
</Chart>

@code {
    private record MonthRevenue(string Month, decimal Revenue, decimal Plan);

    private readonly MonthRevenue[] _months =
    [
        new("January", 42_100, 45_000),
        new("February", 45_800, 46_000),
        new("March", 51_300, 48_000),
        new("April", 48_700, 50_000),
        new("May", 55_200, 52_000),
        new("June", 58_900, 54_000),
        new("July", 54_400, 56_000),
        new("August", 61_700, 58_000),
        new("September", 66_300, 60_000),
        new("October", 63_800, 62_000),
        new("November", 70_200, 65_000),
        new("December", 78_600, 70_000),
    ];
}
