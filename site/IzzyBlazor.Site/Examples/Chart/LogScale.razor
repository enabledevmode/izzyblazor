@* Active users since launch, which grew from hundreds to millions: on a log scale, each power of
   ten is an equal step, so the early months' growth shows as clearly as the later ones'. *@
<Chart Items="_months" Argument="m => m.Month" SeriesType="ChartType.Line" Title="Monthly active users since launch"
       ValueLog ValueTitle="Active users">
    <ChartSeries Value="m => m.Users" />
</Chart>

