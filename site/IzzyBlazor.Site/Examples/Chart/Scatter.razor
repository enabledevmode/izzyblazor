@* Each page's load time against its bounce rate: the slower pages lose more visitors. *@
<Chart Items="_pages" Argument="p => p.LoadSeconds" SeriesType="ChartType.Scatter"
       Label="Load time against bounce rate, by page" ArgumentFormat="0.0' s'" ValueFormat="P0">
    <TooltipTemplate>
        <div class="ib-chart-tooltip-title">@context.Item.Path</div>
        <div>Loads in @context.Argument</div>
        <div>@context.Points[0].Text bounce</div>
    </TooltipTemplate>
    <ChildContent>
        <ChartSeries Value="p => p.BounceRate" Name="Bounce rate" />
    </ChildContent>
</Chart>

@code {
    private record PageStats(string Path, double LoadSeconds, double BounceRate);

    private static readonly string[] Sections = ["docs", "blog", "products", "pricing", "guides", "changelog", "help", "customers"];

    private readonly PageStats[] _pages = Pages();

    // 80 pages: bounce rate rises with load time, with some spread and a few outliers.
    private static PageStats[] Pages()
    {
        var random = new Random(42);
        return Enumerable.Range(0, 80).Select(i =>
        {
            var load = Math.Round(0.6 + random.NextDouble() * random.NextDouble() * 5.4, 1);
            var bounce = Math.Clamp(0.18 + load * 0.075 + (random.NextDouble() - 0.5) * 0.18, 0.08, 0.92);
            return new PageStats($"/{Sections[i % Sections.Length]}/page-{i / Sections.Length + 1}", load, Math.Round(bounce, 3));
        }).ToArray();
    }
}
