@* Each sales team's bookings against its quota: the tick across each bar is the team's quota. *@
<Chart Items="_teams" Argument="t => t.Team" Title="Bookings against quota by team, Q3 2026" Orientation="Orientation.Horizontal">
    <ChartValueAxis Format="$#,##0,,.00M" />
    <ChartBarSeries Value="t => t.Bookings" Target="t => t.Quota" Name="Bookings" />
</Chart>

@code {
    private record TeamBookings(string Team, decimal Bookings, decimal Quota);

    private readonly TeamBookings[] _teams =
    [
        new("Enterprise East", 1_240_000, 1_100_000),
        new("Enterprise West", 1_085_000, 1_200_000),
        new("Mid-market", 812_000, 750_000),
        new("Public sector", 596_000, 700_000),
        new("Partners", 431_000, 400_000),
        new("Small business", 288_000, 350_000),
    ];
}
