@* Days from order to delivery for a month's parcels with four carriers: most arrive in two to
   four days, and the parcels held up by a missed scan or a weather delay show as outliers. *@
<Chart Items="_parcels" Argument="p => p.Carrier" Title="Delivery time by carrier, March">
    <ChartValueAxis Title="Days from order to delivery" />
    <ChartBoxPlotSeries Value="p => p.Days" Name="Delivery time" />
</Chart>

@code {
    private record Parcel(string Carrier, double Days);

    // Sample data: each carrier's typical time and spread, skewed late, with a few parcels delayed.
    private readonly Parcel[] _parcels =
    [
        .. Parcels("Northwind Post", 2.4, 0.3, 0.03, 180, seed: 1),
        .. Parcels("Parcelwise", 3.1, 0.35, 0.05, 140, seed: 2),
        .. Parcels("Swift Freight", 1.8, 0.3, 0.02, 160, seed: 3),
        .. Parcels("Coastline Express", 3.6, 0.35, 0.06, 120, seed: 4),
    ];

    private static IEnumerable<Parcel> Parcels(string carrier, double median, double spread, double delayed, int count, int seed)
    {
        var random = new Random(seed);
        return Enumerable.Range(0, count).Select(_ =>
        {
            var normal = Math.Sqrt(-2 * Math.Log(1 - random.NextDouble())) * Math.Cos(2 * Math.PI * random.NextDouble());
            var days = median * Math.Exp(spread * normal) + (random.NextDouble() < delayed ? 1.5 + random.NextDouble() * 3 : 0);
            return new Parcel(carrier, Math.Round(days, 1));
        }).ToList();
    }
}
