@* Daily signups over 90 days, noisy by weekday, with a 7-day moving average that shows the direction. *@
<Chart Items="_days" Argument="d => d.Date" Title="Daily signups, last 90 days">
    <ChartLineSeries Value="d => d.Signups" Name="Signups" Trend="ChartTrend.MovingAverage" TrendPeriod="7" />
</Chart>

@code {
    private record Day(DateOnly Date, int Signups);

    private readonly Day[] _days = Enumerable.Range(0, 90).Select(i =>
    {
        var date = new DateOnly(2026, 8, 6).AddDays(i);
        var weekend = date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
        return new Day(date, 140 + i + (int)(18 * Math.Sin(i / 9.0)) + (i * 37 % 23) - (weekend ? 55 : 0));
    }).ToArray();
}
