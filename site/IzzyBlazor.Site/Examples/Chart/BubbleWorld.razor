@* Income per person against life expectancy for 32 countries, each sized by its population and
   colored by its region, income on a log scale: each step of ten in income counts alike.
   Figures are rounded, around 2023. *@
<Chart Items="_countries" Argument="c => c.Income" Title="Income and life expectancy by country, around 2023" Height="Length.Rem(24)">
    <ChartValueAxis Format="0" Title="Life expectancy (years)" />
    <ChartArgumentAxis Format="$#,##0" Title="GDP per person (US$, log scale)" Logarithmic />
    <ChartBubbleSeries Value="c => c.LifeExpectancy" Size="c => c.Population" SizeFormat="#,##0,,M" SeriesBy="c => c.Region" LabelText="c => c.Name" ShowSizeKey />
    <ChartTooltip>
        <div class="ib-chart-tooltip-title">@context.Item.Name</div>
        <div>@context.Item.Income.ToString("$#,##0") per person</div>
        <div>Lives to @context.Item.LifeExpectancy.ToString("0.0") years</div>
        <div>@context.Item.Population.ToString("#,##0,,") million people</div>
    </ChartTooltip>
</Chart>

@code {
    private record Country(string Name, string Region, double Income, double LifeExpectancy, double Population);

    // Largest first, so the most populous countries are named when names crowd.
