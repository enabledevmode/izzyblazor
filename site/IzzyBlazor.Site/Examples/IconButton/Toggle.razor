@* Call controls: each @bind-Pressed toggles on its own, and its label stays the same. *@
<Stack Gap="3" Align="Align.Center">
    <Row Gap="2">
        <IconButton Icon="Lucide.MicOff" Label="Mute" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" @bind-Pressed="_muted" />
        <IconButton Icon="Lucide.VideoOff" Label="Turn off camera" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" @bind-Pressed="_cameraOff" />
        <IconButton Icon="Lucide.Captions" Label="Captions" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" @bind-Pressed="_captions" />
    </Row>
    <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Status</TextBlock>
</Stack>

@code {
    private bool _muted = true;
    private bool _cameraOff;
    private bool _captions;

    private string Status => string.Join(" · ", new[]
    {
        _muted ? "Muted" : "Mic on",
        _cameraOff ? "Camera off" : "Camera on",
        _captions ? "Captions on" : "Captions off",
    });
}
