@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="color-picker-presets" MaxWidth="20.Rem" Grow>
    <ColorPicker @bind-Value="Model!.Brand" Presets="BrandColors.Keys" PresetText="hex => BrandColors[hex]" Hint="Used for buttons, links and focus rings." />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "color-picker-presets")]
    private Branding? Model { get; set; }

    // Each preset's name, which screen readers hear instead of its hex value. In order.
    private static readonly OrderedDictionary<string, string> BrandColors = new()
    {
        ["#2563eb"] = "Blue", ["#4f46e5"] = "Indigo", ["#7c3aed"] = "Violet", ["#0f766e"] = "Teal",
        ["#15803d"] = "Green", ["#be123c"] = "Rose", ["#ea580c"] = "Orange", ["#18181b"] = "Black",
    };

    protected override void OnInitialized() => Model ??= new();

    public sealed class Branding
    {
        [Display(Name = "Brand color")]
        public string? Brand { get; set; } = "#2563eb";
    }
}
