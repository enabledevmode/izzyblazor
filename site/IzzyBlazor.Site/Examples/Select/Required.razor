@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="required" OnValidSubmit="Save" MaxWidth="24.Rem" Grow>
    <Select @bind-Value="Model!.Plan" Placeholder="Choose a plan" />
    <Row><Button Submit>Continue</Button></Row>
    @if (_saved)
    {
        <Alert Status="Status.Success">You chose @Model!.Plan.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "required")]
    private Signup? Model { get; set; }

    private bool _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = true;

    public sealed class Signup
    {
        // Nullable, so nothing is chosen until someone picks one.
        [Required(ErrorMessage = "Choose a plan")]
        public Plan? Plan { get; set; }
    }

    public enum Plan { Free, Pro, Team }
}
