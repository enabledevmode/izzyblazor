@* A floating action button: fixed to the window's bottom corner, raised, where it stays as the
   list scrolls. *@
<Stack Gap="4" Padding="4">
    <Heading Level="1" Size="TextSize.Xl">Invoices</Heading>
    <Stack Gap="2">
        @foreach (var i in Enumerable.Range(1, 12))
        {
            <Card Padding="3">Invoice @(1040 + i)</Card>
        }
    </Stack>
</Stack>
<FloatingButton Icon="Lucide.Plus" Label="New invoice" />
