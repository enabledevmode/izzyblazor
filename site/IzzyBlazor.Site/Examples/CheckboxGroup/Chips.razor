@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="checkbox-group-chips" MaxWidth="32.Rem" Grow>
    <CheckboxGroup @bind-Value="Model!.Cuisines" Items="Enum.GetValues<Cuisine>()" Chips />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "checkbox-group-chips")]
    private Search? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Search
    {
        [Display(Name = "Cuisine")]
        public List<Cuisine> Cuisines { get; set; } = [Cuisine.Thai, Cuisine.Mexican];
    }

    public enum Cuisine { Italian, Thai, Mexican, Indian, Japanese, Greek, [Display(Name = "Middle Eastern")] MiddleEastern }
}
