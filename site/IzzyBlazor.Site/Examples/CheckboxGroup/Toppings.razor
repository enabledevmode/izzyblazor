@using Microsoft.AspNetCore.Http

<Form Model="Model" FormName="checkbox-group-toppings" OnValidSubmit="Save" Grow>
    <CheckboxGroup @bind-Value="Model!.Toppings" Items="Enum.GetValues<Topping>()" ItemText="ToppingText" Orientation="Orientation.Horizontal" />
    <Row Gap="3" Align="Align.Center" Wrap>
        <Button Submit>Add to order</Button>
        @if (_saved)
        {
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                Added: @(Model!.Toppings.Count == 0 ? "a plain pizza" : string.Join(", ", Model.Toppings.Select(ToppingText)))
            </TextBlock>
        }
    </Row>
</Form>

@code {
    [SupplyParameterFromForm(FormName = "checkbox-group-toppings")]
    private Pizza? Model { get; set; }

    private bool _saved;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // A post with no box checked sends nothing for the group, so the model isn't filled from it:
    // give the defaults only when this form didn't post.
    protected override void OnInitialized()
    {
        // This form's own post: another form on the page posts too.
        var posted = HttpContext?.Request.HasFormContentType == true
            && HttpContext.Request.Form["_handler"] == "checkbox-group-toppings";
        Model ??= posted ? new() : new() { Toppings = [Topping.Cheese] };
    }

    private void Save() => _saved = true;

    private static string ToppingText(Topping topping) => topping == Topping.ExtraSauce ? "Extra sauce" : topping.ToString();

    public sealed class Pizza
    {
        public List<Topping> Toppings { get; set; } = [];
    }

    public enum Topping
    {
        Cheese,
        Mushrooms,
        Olives,
        Peppers,
        ExtraSauce,
    }
}
