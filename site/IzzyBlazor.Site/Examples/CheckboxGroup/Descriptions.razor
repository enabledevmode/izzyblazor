@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="checkbox-group-descriptions" MaxWidth="28.Rem" Grow>
    <CheckboxGroup @bind-Value="Model!.Channels" Items="Enum.GetValues<Channel>()"
                   ItemText="channel => Details[channel].Name" ItemDescription="channel => Details[channel].Detail" />
</Form>

@code {
    [SupplyParameterFromForm(FormName = "checkbox-group-descriptions")]
    private Alerts? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    private static readonly Dictionary<Channel, (string Name, string Detail)> Details = new()
    {
        [Channel.Email] = ("Email", "To ada@example.com, within a minute."),
        [Channel.Sms] = ("SMS", "To your phone, for failed deploys only."),
        [Channel.Slack] = ("Slack", "To #deploys in the Acme workspace."),
    };

    public sealed class Alerts
    {
        [Display(Name = "Send alerts by")]
        public HashSet<Channel> Channels { get; set; } = [Channel.Email, Channel.Slack];
    }

    public enum Channel { Email, Sms, Slack }
}
