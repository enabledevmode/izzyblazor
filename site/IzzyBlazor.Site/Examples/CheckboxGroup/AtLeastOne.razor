@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="checkbox-group-at-least-one" OnValidSubmit="Save" OnInvalidSubmit="() => _saved = null" MaxWidth="32.Rem" Grow>
    <CheckboxGroup @bind-Value="Model!.Days" Items="Weekdays" Orientation="Orientation.Horizontal"
                   Hint="Choose at least one." />
    <Row><Button Submit>Save</Button></Row>
    @if (_saved is { Length: > 0 })
    {
        <Alert Status="Status.Success">Saved: @_saved.</Alert>
    }
    else if (_saved is not null)
    {
        <Alert Status="Status.Danger">Choose days from the list.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "checkbox-group-at-least-one")]
    private Availability? Model { get; set; }

    private string? _saved;

    protected override void OnInitialized() => Model ??= new();

    // What was saved, not the field: on an interactive page it changes as boxes are checked.
    // Posted values can be anything: keep the weekdays, once each.
    private void Save() => _saved = string.Join(", ", Weekdays.Where(Model!.Days!.Contains));

    public sealed class Availability
    {
        // [Required] catches an empty choice on a static page, where nothing posts and the list
        // is null; [MinLength] on an interactive page, where it's an empty list.
        [Required(ErrorMessage = "Choose at least one day")]
        [MinLength(1, ErrorMessage = "Choose at least one day")]
        [Display(Name = "Days you can work")]
        public List<DayOfWeek>? Days { get; set; }
    }

    private static readonly DayOfWeek[] Weekdays =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday,
    ];
}
