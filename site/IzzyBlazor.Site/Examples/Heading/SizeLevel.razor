   smoothly with the screen. *@
<Stack Gap="4" Grow>
    <Heading Level="2" Size="TextSize.Sm" Color="Color.Muted" Transform="TextTransform.Uppercase" LetterSpacing="LetterSpacing.Wider">Billing</Heading>
    <Heading Level="1" Size="new() { Base = TextSize.Xl3, Md = TextSize.Xl5 }" LetterSpacing="LetterSpacing.Tight">Ship faster, sleep better</Heading>
    <Heading Level="1" Size="TextSize.Xl5" MinSize="TextSize.Xl3" LetterSpacing="LetterSpacing.Tight">Forms that work offline</Heading>
</Stack>
