@* Feedback on a help article: a count, then each comment, newest first, with a line between.
   The writer's answer is marked as theirs, and an edited comment says so. *@
<Stack Gap="5" Grow>
    <Heading Level="2" Size="TextSize.Md">@_comments.Length comments</Heading>
    @foreach (var (comment, i) in _comments.Select((c, i) => (c, i)))
    {
        @if (i > 0)
        {
            <Divider />
        }
        <Comment Author="@comment.Author" Initials="@comment.Initials" Time="comment.Time" RelativeTime Text="@comment.Text"
                 Extra="@(comment.Edited ? _edited : null)" Replies="@(comment.Answer is { } answer ? WritersAnswer(answer) : null)" />
    }
</Stack>

@code {
    private readonly RenderFragment _edited = @<span>Edited</span>;

    private static RenderFragment WritersAnswer(Answer answer) =>
        @<Comment Author="Noor Haddad" Initials="NH" Time="answer.Time" RelativeTime Text="@answer.Text">
            <Extra><Badge Size="BadgeSize.Sm">Writer</Badge></Extra>
        </Comment>;

    private sealed record Answer(DateTimeOffset Time, string Text);

    private sealed record Feedback(string Author, string Initials, DateTimeOffset Time, string Text, bool Edited = false, Answer? Answer = null);

    private readonly Feedback[] _comments =
    [
        new("Tomás Rivera", "TR", DateTimeOffset.UtcNow.AddHours(-2), "Step 3 still shows the old Settings menu. It's under Account now.", Edited: true),
        new("Grace Liu", "GL", DateTimeOffset.UtcNow.AddDays(-1), "This fixed my export. The note about time zones was the missing piece."),
        new("Sam Patel", "SP", DateTimeOffset.UtcNow.AddDays(-3), "Could you add how to export only the selected rows?",
            Answer: new(DateTimeOffset.UtcNow.AddDays(-2), "Added under Selected rows, with a screenshot of the menu.")),
    ];
}
