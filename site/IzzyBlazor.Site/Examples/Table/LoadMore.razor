@* Load more from an API that pages by cursor and has no total: the provider passes the cursor on
   and hands back the next one. On interactive pages each load adds rows under the ones shown. *@
<Table TItem="AuditEvent" ItemsProvider="LoadEvents" PageSize="8" Paging="TablePaging.LoadMore" LoadMoreText="Load earlier"
       ItemKey="e => e.Id.ToString()" Caption="Audit log" QueryPrefix="log-" Grow>
    <PropertyColumn Property="e => e.At" Title="Time (UTC)" Format="MMM d, HH:mm" />
    <PropertyColumn Property="e => e.Who" />
    <PropertyColumn Property="e => e.What" Title="Action" />
</Table>

@code {
    private static async ValueTask<TableResult<AuditEvent>> LoadEvents(TableRequest<AuditEvent> request)
    {
        var (items, next) = await Events.ListAsync(request.Cursor, request.PageSize ?? 8);
        return new TableResult<AuditEvent>(items) { Next = next };
    }
}
