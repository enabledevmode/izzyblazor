@* Column filters: a funnel in each Filterable header opens the filter, and is marked while it's
   in use. FilterPanel lists them all below the rows. Text matches anywhere, enums get a list of checkboxes, numbers take a range. *@
<Table Items="Orders.All" PageSize="5" InitialSort="-number" Caption="Filtered orders" QueryPrefix="orders-" FilterPanel Grow>
    <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Sortable />
    <PropertyColumn Property="o => o.Customer" Sortable Filterable />
    <PropertyColumn Property="o => o.Status" Sortable Filterable />
    <PropertyColumn Property="o => o.Total" Format="C" Sortable Filterable />
</Table>
