@* State in the component, on an interactive page: headers and page numbers become buttons, filters
   apply after a pause in typing, and the URL doesn't change. *@
<Stack Gap="3" Grow>
    <Table Items="Orders.All" PageSize="5" InitialSort="-number" Caption="Order history" QueryPrefix="bound-"
           @bind-Sort="_sort" @bind-Page="_page" @bind-Filter="_filter">
        <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" Sortable />
        <PropertyColumn Property="o => o.Customer" Sortable Filterable />
        <PropertyColumn Property="o => o.Date" Format="MMM d" Sortable Filterable />
        <PropertyColumn Property="o => o.Total" Format="C" Sortable Filterable />
    </Table>
    <TextBlock Size="TextSize.Sm" Color="Color.Muted">
        C# has sort <Code>@(_sort ?? "-number")</Code>, page <Code>@_page</Code>, filter
        <Code>@(_filter?.ToString() ?? "none")</Code>
    </TextBlock>
</Stack>

@code {
    private string? _sort;
    private int _page = 1;
    private Filter? _filter;
}
