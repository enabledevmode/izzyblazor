@* Selection in a form: each checked row posts its ItemKey, so Archive works with JavaScript off. A
   footer row shows the total. *@
<form method="post" @onsubmit="Archive" @formname="archive" style="width: 100%">
    <AntiforgeryToken />
    <Stack Gap="3">
        <Table Items="Recent" Caption="Recent orders" SelectionMode="SelectionMode.Multiple" ItemKey="o => o.Number.ToString()"
               RowLabel='o => $"order {o.Number}"' @bind-Selection="_selected">
            <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" FooterText="Total" />
            <PropertyColumn Property="o => o.Customer" />
            <PropertyColumn Property="o => o.Total" Format="C" FooterText="@Recent.Sum(o => o.Total).ToString("C")" />
        </Table>
        <Row Gap="3" Align="Align.Center" Wrap>
            <Button Submit Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Archive">Archive selected</Button>
            @if (_archived is not null)
            {
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                    Archived: @(_archived.Length == 0 ? "nothing selected" : string.Join(", ", _archived.Select(k => "#" + k)))
                </TextBlock>
            }
        </Row>
    </Stack>
</form>

@code {
    private static readonly IReadOnlyList<Order> Recent = Orders.All.Take(5).ToList();

    // Static pages: the checked rows post as "selected".
    [SupplyParameterFromForm(FormName = "archive", Name = "selected")]
    private Selection? Posted { get; set; }

    // Interactive pages: bound to the checkboxes.
    private Selection? _selected;
    private string[]? _archived;

    protected override void OnInitialized() => _selected = Posted;

    private void Archive()
    {
        var selection = Posted ?? _selected ?? Selection.None;
        _archived = [.. selection.Apply(Recent.AsQueryable(), o => o.Number.ToString()).Select(o => o.Number.ToString())];
    }
}
