@* Bulk actions: select rows on any page, or, with the header checkbox, every order the filters
   match. The bar above the rows holds Archive, which posts the selection; Selection.Apply finds
   the orders it means. *@
<form method="post" @onsubmit="Archive" @formname="bulk-archive" style="width: 100%">
    <AntiforgeryToken />
    <Stack Gap="3">
        <Table Items="Orders.All" PageSize="5" Caption="Orders to archive" QueryPrefix="bulk-" Grow
               ItemKey="o => o.Number.ToString()" RowLabel='o => $"order {o.Number}"'
               SelectionMode="SelectionMode.Multiple" SelectAllMode="SelectAllMode.All" @bind-Selection="_selection">
            <SelectionActions>
                <Button Submit Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" StartIcon="Lucide.Archive">Archive</Button>
            </SelectionActions>
            <Columns>
                <PropertyColumn Property="o => o.Number" Title="Order" Align="CellAlign.Start" />
                <PropertyColumn Property="o => o.Customer" Filterable />
                <PropertyColumn Property="o => o.Status" Filterable />
                <PropertyColumn Property="o => o.Total" Format="C" />
            </Columns>
        </Table>
        <TextBlock Size="TextSize.Sm" Color="Color.Muted" role="status">@_status</TextBlock>
    </Stack>
</form>

@code {
    // Static pages: the selection posts under the table's SelectionName ("{QueryPrefix}selected").
    [SupplyParameterFromForm(FormName = "bulk-archive", Name = "bulk-selected")]
    private Selection? Posted { get; set; }

    // Interactive pages: bound to the table.
    private Selection? _selection;
    private string? _status;

    protected override void OnInitialized() => _selection = Posted;

    private void Archive()
    {
        var orders = (Posted ?? _selection ?? Selection.None).Apply(Orders.All.AsQueryable(), o => o.Number.ToString()).ToList();
        _status = orders.Count switch
        {
            0 => "Select the orders to archive first.",
            1 => $"Archived order #{orders[0].Number}.",
            _ => $"Archived {orders.Count} orders.",
        };
        _selection = Selection.None;
    }
}
