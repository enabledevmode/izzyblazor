@* Loading as you scroll: the next page loads when the last row comes into view in the table's own
   scroll box (MaxHeight), with a spinner under the rows while it does. The Load more button is
   there for the keyboard, out of sight until it has focus. The Who and Action filters go to the
   API with the cursor, and a new filter starts the list over. *@
<Table TItem="AuditEvent" ItemsProvider="LoadEvents" PageSize="8" Paging="DataPaging.LoadOnScroll" MaxHeight="Length.Rem(18)"
       ItemKey="e => e.Id.ToString()" Caption="Audit log, loading on scroll" QueryPrefix="scroll-" EmptyText="No events match these filters" Grow>
    <Columns>
        <PropertyColumn Property="e => e.At" Title="Time (UTC)" Format="MMM d, HH:mm" />
        <PropertyColumn Property="e => e.Who" Filterable />
        <PropertyColumn Property="e => e.What" Title="Action" Filterable />
    </Columns>
</Table>

@code {
    // The filters go to the API with the cursor; the table drops the cursor when one changes.
    private static async ValueTask<DataResult<AuditEvent>> LoadEvents(DataRequest<AuditEvent> request)
    {
        var (items, next) = await Events.ListAsync(request.Cursor, request.Take ?? 8,
            request.Filter?.Find("who")?.Value as string, request.Filter?.Find("what")?.Value as string);
        return new DataResult<AuditEvent>(items) { Next = next };
    }
}
