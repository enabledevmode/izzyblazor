<Grid Columns="3" Gap="4" Grow>
    <Column Gap="2">
        <AspectRatio Ratio="4 / 3.0" Radius="Radius.Lg">
            <svg viewBox="0 0 400 150" preserveAspectRatio="xMidYMid slice" role="img" aria-label="A sailboat on a calm sea">
                <rect width="400" height="150" fill="#bae6fd" />
                <path d="M0 110 H400 V150 H0 Z" fill="#0369a1" />
                <path d="M150 110 L185 60 L220 110 Z" fill="#f8fafc" />
            </svg>
        </AspectRatio>
        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium">Sailboat</TextBlock>
    </Column>
    <Column Gap="2">
        <AspectRatio Ratio="4 / 3.0" Radius="Radius.Lg">
            <svg viewBox="0 0 150 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label="A tall lighthouse">
                <rect width="150" height="300" fill="#fde68a" />
                <path d="M60 300 L67 110 H83 L90 300 Z" fill="#dc2626" />
                <rect x="62" y="90" width="26" height="20" fill="#1f2937" />
            </svg>
        </AspectRatio>
        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium">Lighthouse</TextBlock>
    </Column>
    <Column Gap="2">
        <AspectRatio Ratio="4 / 3.0" Radius="Radius.Lg" Bg="Color.FillSubtle">
            <Center>
                <Icon Name="Lucide.ImageOff" Color="Color.Muted" Size="IconSize.Xl2" />
            </Center>
        </AspectRatio>
        <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium">Pier (no photo)</TextBlock>
    </Column>
</Grid>
