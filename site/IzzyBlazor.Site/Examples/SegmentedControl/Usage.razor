@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="project-view" OnValidSubmit="Save" Grow>
    <SegmentedControl @bind-Value="Model!.View" />
    <Row><Button Submit>Save</Button></Row>
    @if (_saved is { } saved)
    {
        <Alert Status="Status.Success">Projects open as a @saved.ToString().ToLowerInvariant().</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "project-view")]
    private Settings? Model { get; set; }

    private ProjectView? _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = Model!.View;

    public sealed class Settings
    {
        [Display(Name = "Default view")]
        public ProjectView View { get; set; } = ProjectView.Board;
    }

    public enum ProjectView { List, Board, Calendar }
}
