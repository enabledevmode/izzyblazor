@inject NavigationManager Navigation

@* One menu for every file: the card pressed says which with data-menu-value. *@
<form method="post" @onsubmit="Posted" @formname="shared-files" data-enhance>
    <AntiforgeryToken />
    <Stack Gap="3" Grow>
        <Grid MinChildWidth="13.Rem" Gap="3">
            @foreach (var file in Files)
            {
                <Card Class="shared-file" data-menu-value="@file.Name" Size="ControlSize.Sm">
                    <Row Gap="2" Align="Align.Center">
                        <Icon Name="file.Icon" />
                        <Stack Gap="0" Grow>
                            <TextBlock Weight="FontWeight.Medium">@file.Name</TextBlock>
                            <TextBlock Size="TextSize.Sm" Color="Color.Muted">@file.Size</TextBlock>
                        </Stack>
                    </Row>
                </Card>
            }
        </Grid>
        <ContextMenu For=".shared-file" Label="File actions" OnOpen="file => _file = file">
            <MenuItem Href="@Navigation.GetUriWithQueryParameter("open", "{0}")" Icon="Lucide.ExternalLink">Open</MenuItem>
            <MenuItem Submit Name="duplicate" Value="{0}" OnClick="() => _pressed = (_file, false)" Icon="Lucide.Copy">Duplicate</MenuItem>
            <MenuDivider />
            <MenuItem Submit Name="delete" Value="{0}" OnClick="() => _pressed = (_file, true)" Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
        </ContextMenu>
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Result</TextBlock>
    </Stack>
</form>

@code {
    [SupplyParameterFromQuery(Name = "open")] private string? Opened { get; set; }

    // Static pages: the chosen item posts the pressed card's value.
    [SupplyParameterFromForm(FormName = "shared-files", Name = "duplicate")] private string? Duplicated { get; set; }

    [SupplyParameterFromForm(FormName = "shared-files", Name = "delete")] private string? Deleted { get; set; }

    // Interactive pages post nothing: OnOpen says which card, OnClick which item.
    private string _file = "";
    private (string File, bool Delete)? _pressed;
    private string? _posted;

    private string Result => _posted ?? (Opened is not null ? $"Opened {Opened}." : "Right-click a file.");

    private void Posted()
    {
        var (file, delete) = _pressed ?? (Deleted ?? Duplicated ?? "", Deleted is not null);
        _posted = delete ? $"Deleted {file}." : $"Duplicated {file}.";
    }

    @* hide *@
    private sealed record FileInfo(string Name, string Size, IconData Icon);

    private static readonly FileInfo[] Files =
    [
        new("Q3 report.pdf", "2.4 MB", Lucide.FileText),
        new("Budget 2027.xlsx", "860 KB", Lucide.FileSpreadsheet),
        new("Logo.svg", "12 KB", Lucide.Image),
    ];
    @* /hide *@
}
