@* A developer's commits on each day of 2025: steady weekdays, few weekends, two weeks off in August, a quiet holiday week. *@
<CalendarHeatmap Items="_days" Date="d => d.Day" Value="d => d.Commits"
                 From="new DateOnly(2025, 1, 1)" To="new DateOnly(2025, 12, 31)"
                 Title="Commits in 2025" />

@code {
    private record DayCommits(DateOnly Day, int Commits);

    private readonly DayCommits[] _days = Build();

    private static DayCommits[] Build()
    {
        var start = new DateOnly(2025, 1, 1);
        var days = new List<DayCommits>();
        for (var d = 0; d < 365; d++)
        {
            var day = start.AddDays(d);
            var weekend = day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
            var away = day >= new DateOnly(2025, 8, 4) && day <= new DateOnly(2025, 8, 15) || day >= new DateOnly(2025, 12, 24);
            // A spread from quiet days to busy ones; a weekend now and then.
            var noise = (d * 7919 + 13) % 97 / 97.0;
            var commits = away ? 0
                : weekend ? (noise > 0.8 ? (int)(noise * 6) : 0)
                : (int)(1 + 11 * noise * noise + (day.Month is 3 or 10 ? 4 : 0));
            // Days without commits aren't in the data, as a query by day would return them.
            if (commits > 0) days.Add(new DayCommits(day, commits));
        }

        return [.. days];
    }
}
