@* Two phones' review scores, out of 10, in six qualities. *@
<RadarChart Items="_scores" Argument="s => s.Quality" Max="10" Title="Review scores, out of 10">
    <RadarSeries Value="s => s.Pixel" Name="Pixel 10" />
    <RadarSeries Value="s => s.Galaxy" Name="Galaxy A56" />
</RadarChart>

@code {
    private record Score(string Quality, double Pixel, double Galaxy);

    private readonly Score[] _scores =
    [
        new("Camera", 9.2, 7.6),
        new("Display", 8.8, 8.0),
        new("Speed", 9.0, 7.8),
        new("Build", 8.7, 7.5),
        new("Price", 6.0, 8.9),
        new("Battery", 8.5, 9.1),
    ];
}
