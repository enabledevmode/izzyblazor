@* Average rainfall by month, in inches (1991–2020 normals). *@
<RadarChart Items="_months" Argument="m => m.Month" Grid="RadarGrid.Circle" ValueFormat="0.0"
            Title="Average rainfall (inches)">
    <RadarSeries Value="m => m.Seattle" Fill="true" />
    <RadarSeries Value="m => m.Phoenix" Fill="true" />
</RadarChart>

@code {
    private record MonthRain(string Month, double Seattle, double Phoenix);

    private readonly MonthRain[] _months =
    [
        new("Jan", 5.78, 0.87), new("Feb", 3.76, 0.87), new("Mar", 4.17, 0.83), new("Apr", 3.18, 0.25),
        new("May", 1.89, 0.16), new("Jun", 1.49, 0.02), new("Jul", 0.57, 1.05), new("Aug", 0.97, 1.00),
        new("Sep", 1.58, 0.64), new("Oct", 3.86, 0.58), new("Nov", 6.31, 0.65), new("Dec", 5.94, 0.88),
    ];
}
