@* A changelog post: the page's own header (version, title, summary, byline) and the links around
   it are components, and the body is HTML from Markdown, styled by Prose at the large size, all in
   a column at article width. *@
<Container Size="ContainerSize.Md" PaddingY="new() { Base = 4, Md = 10 }" Grow>
    <Stack Gap="8">
        <Stack Gap="4">
            <TextBlock Size="TextSize.Sm"><Anchor Href="https://example.com/releases" Underline="AnchorUnderline.Hover">← All releases</Anchor></TextBlock>
            <Row Gap="2" Align="Align.Center" Wrap>
                <Badge Accent="Accent.Primary">Version 2.4</Badge>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">October 14, 2026</TextBlock>
            </Row>
            <Heading Level="1" Size="TextSize.Xl4">Offline drafts</Heading>
            <TextBlock Size="TextSize.Lg" Color="Color.Muted">Write anywhere: drafts save on your device and sync when you're back online.</TextBlock>
            <Row Gap="3" Align="Align.Center">
                <Avatar Name="Ada Lovelace" Decorative />
                <Stack Gap="0">
                    <TextBlock Size="TextSize.Sm" Weight="FontWeight.Medium">Ada Lovelace</TextBlock>
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Product · 4 min read</TextBlock>
                </Stack>
            </Row>
        </Stack>
        <Divider />
        <Prose Size="ProseSize.Lg" As="article">@((MarkupString)Html)</Prose>
        <Divider />
        <Stack Gap="4">
            <TextBlock Color="Color.Muted">Questions or feedback? <Anchor Href="https://example.com/forum" External>Discuss in the forum</Anchor></TextBlock>
            <PrevNext PreviousHref="https://example.com/releases/2.3" PreviousTitle="Version 2.3: shared folders" />
        </Stack>
    </Stack>
</Container>

@* hide *@
@code {
    private const string Html =
        """
        <p>Drafts now save on your device as you type, so a dropped connection never costs you a paragraph. When you're back online they sync, and you pick up where you left off on any device.</p>
        <h2>What's new</h2>
        <ul>
          <li><strong>Offline drafts.</strong> Everything you write is kept until it syncs.</li>
          <li><strong>Conflict view.</strong> When two devices edit the same draft, you see both and choose.</li>
          <li><strong>Faster search.</strong> Results show as you type, even in archives with thousands of posts.</li>
        </ul>
        <h2>Upgrading</h2>
        <p>Nothing to do for most teams. If you call the API directly, the <code>drafts</code> endpoint now returns a <code>syncedAt</code> field:</p>
        <pre><code>{ "id": "d_812", "title": "Q4 plan", "syncedAt": "2026-10-14T09:12:00Z" }</code></pre>
        <blockquote>We moved our own team to offline drafts a month ago, and nobody has lost a draft since.</blockquote>
        <h2>Fixed</h2>
        <ol>
          <li>Pasting a table from a spreadsheet keeps its header row.</li>
          <li>The editor no longer jumps to the top after an image upload.</li>
        </ol>
        <p>Read the full list in the <a href="https://example.com/changelog">changelog</a>.</p>
        """;
}
@* /hide *@
