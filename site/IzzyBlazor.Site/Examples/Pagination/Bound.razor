<Stack Gap="3" Align="Align.Start" Grow>
    <Pagination @bind-Page="_page" PageCount="8" Label="Results pages" />
    <TextBlock Size="TextSize.Sm" Color="Color.Muted">C# has page <Code>@_page</Code></TextBlock>
</Stack>

@code {
    // Static pages have no C# to update, so the pages stay links that set ?page=: start from it.
    [SupplyParameterFromQuery(Name = "page")]
    private int? QueryPage { get; set; }

    private int _page;

    protected override void OnInitialized() => _page = QueryPage ?? 1;
}
