@using System.ComponentModel.DataAnnotations

<Form Model="Model" FormName="calendar-limits" OnValidSubmit="Save">
    <Calendar @bind-Value="Model!.Delivery" Hint="In March 2027." />
    <Calendar @bind-Value="Model!.Pickup" Min="@(new DateOnly(2027, 3, 8))" Max="@(new DateOnly(2027, 3, 19))" Hint="From March 8 to 19." />
    <Row><Button Submit>Book</Button></Row>
    @if (_saved is { } saved)
    {
        <Alert Status="Status.Success">Booked: delivery @saved.Delivery, pickup @saved.Pickup.</Alert>
    }
</Form>

@code {
    [SupplyParameterFromForm(FormName = "calendar-limits")]
    private Booking? Model { get; set; }

    // What was saved, not the fields: on an interactive page they follow typing.
    private (DateOnly? Delivery, DateOnly Pickup)? _saved;

    protected override void OnInitialized() => Model ??= new();

    private void Save() => _saved = (Model!.Delivery, Model.Pickup);

    public sealed class Booking
    {
        [Range(typeof(DateOnly), "2027-03-01", "2027-03-31", ErrorMessage = "Pick a day in March 2027.")]
        public DateOnly? Delivery { get; set; } = new(2027, 3, 3);

        public DateOnly Pickup { get; set; } = new(2027, 3, 10);
    }
}
