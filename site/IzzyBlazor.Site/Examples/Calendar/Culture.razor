@using System.Globalization

<Form Model="Model" FormName="calendar-culture">
    <Row Gap="10" Wrap Align="Align.Start">
        <Calendar @bind-Value="Model!.Day" Label="German, with week numbers" Culture="@(new CultureInfo("de-DE"))" ShowWeekNumbers />
        <Calendar @bind-Value="Model!.Other" Label="Monday first, this month only" FirstDayOfWeek="DayOfWeek.Monday" ShowAdjacentDays="false" />
    </Row>
</Form>

@code {
    [SupplyParameterFromForm(FormName = "calendar-culture")]
    private Dates? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Dates
    {
        public DateOnly Day { get; set; } = new(2027, 1, 14);
        public DateOnly Other { get; set; } = new(2027, 1, 14);
    }
}
