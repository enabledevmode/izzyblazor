<Form Model="Model" FormName="calendar-states">
    <Row Gap="10" Wrap Align="Align.Start">
        <Calendar @bind-Value="Model!.Small" Label="Small" Size="ControlSize.Sm" />
        <Calendar @bind-Value="Model!.Large" Label="Large" Size="ControlSize.Lg" />
    </Row>
    <Row Gap="10" Wrap Align="Align.Start">
        <Calendar @bind-Value="Model!.Signed" Label="Signed on" ReadOnly Hint="Read-only: posted, but can't be changed." />
        <Calendar @bind-Value="Model!.Renews" Label="Renews on" Disabled Hint="Disabled: not posted." />
    </Row>
</Form>

@code {
    [SupplyParameterFromForm(FormName = "calendar-states")]
    private Contract? Model { get; set; }

    protected override void OnInitialized() => Model ??= new();

    public sealed class Contract
    {
        public DateOnly Small { get; set; } = new(2027, 5, 12);
        public DateOnly Large { get; set; } = new(2027, 5, 12);
        public DateOnly Signed { get; set; } = new(2027, 5, 12);
        public DateOnly Renews { get; set; } = new(2027, 5, 12);
    }
}
