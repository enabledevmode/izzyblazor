@inject ToastService Toasts
@inject NavigationManager Navigation

@* Once per app, in the layout (the docs layout has it): <ToastRegion /> *@

<form method="post" @formname="toast-redirect" @onsubmit="Send" data-enhance>
    <AntiforgeryToken />
    <Button Submit StartIcon="Lucide.Send">Send invoice</Button>
</form>

@code {
    private void Send()
    {
        // Post, then redirect: the toast follows in a short-lived cookie.
        Toasts.Success("INV-1042 is on its way to Ada Lovelace.", "Invoice sent");
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("sent", "INV-1042"));
    }
}
