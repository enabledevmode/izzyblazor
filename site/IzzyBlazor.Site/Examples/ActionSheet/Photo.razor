@* A photo's actions on a phone. The sheet is inside the form its items post. *@
<form method="post" @onsubmit="Chosen" @formname="photo-actions" data-enhance>
    <AntiforgeryToken />
    <Row Gap="3" Wrap Align="Align.Center">
        <DialogTrigger For="photo-actions" StartIcon="Lucide.Ellipsis" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">IMG_2041.jpg</DialogTrigger>
        <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">@_result</TextBlock>
    </Row>

    <ActionSheet Id="photo-actions" Title="IMG_2041.jpg" Description="Taken Oct 12 in Lisbon, 3.2 MB">
        @* Static pages post the chosen item's Name=Value; interactive ones run OnClick. *@
        <ActionSheetItem Submit Name="choice" Value="Shared" OnClick='() => _pressed = "Shared"'
                         Icon="Lucide.Share2">Share</ActionSheetItem>
        <ActionSheetItem Submit Name="choice" Value="Duplicated" OnClick='() => _pressed = "Duplicated"'
                         Icon="Lucide.Copy">Duplicate</ActionSheetItem>
        <ActionSheetItem Submit Name="choice" Value="Deleted" OnClick='() => _pressed = "Deleted"'
                         Accent="Accent.Danger" Icon="Lucide.Trash">Delete</ActionSheetItem>
    </ActionSheet>
</form>

@code {
    [SupplyParameterFromForm(FormName = "photo-actions", Name = "choice")]
    private string? Choice { get; set; }

    private string? _pressed;
    private string _result = "Nothing chosen yet";

    private void Chosen() => _result = $"{Choice ?? _pressed} IMG_2041.jpg";
}
