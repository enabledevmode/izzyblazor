@* Two years of a share's closing prices on trading days, with a range selector and buttons for
   common spans back from the last close. *@
<Chart Items="_closes" Argument="c => c.Date" Title="Acme Corp. share price, daily close">
    <ChartValueAxis Format="C2" />
    <ChartLineSeries Value="c => c.Price" Name="Close" />
    <ChartRangeSelector Ranges />
</Chart>

@code {
    private record Close(DateOnly Date, decimal Price);

    private readonly Close[] _closes = Closes();

    // A random walk with a slow climb, on weekdays from November 2024 to October 2026.
    private static Close[] Closes()
    {
        var random = new Random(7);
        var price = 42.0;
        var closes = new List<Close>();
        for (var date = new DateOnly(2024, 11, 1); date <= new DateOnly(2026, 10, 30); date = date.AddDays(1))
        {
            if (date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
            {
                continue;
            }

            price *= 1.0006 + (random.NextDouble() - 0.5) * 0.034;
            closes.Add(new Close(date, Math.Round((decimal)price, 2)));
        }

        return [.. closes];
    }
}
