@* The three looks. They share the reader's choice (the ib-scheme cookie), so picking one here
   changes the scheme of this site too. *@
<Row Gap="6" Align="Align.Center" Wrap>
    <Stack Gap="2" Align="Align.Start">
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Menu</TextBlock>
        <ColorSchemeSwitch />
    </Stack>
    <Stack Gap="2" Align="Align.Start">
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Toggle</TextBlock>
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Toggle" />
    </Stack>
    <Stack Gap="2" Align="Align.Start">
        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Segmented</TextBlock>
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Segmented" />
    </Stack>
</Row>
