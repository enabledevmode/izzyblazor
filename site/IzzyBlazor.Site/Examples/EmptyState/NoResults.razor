@* A search that found nothing: the search stays above, so people see what they looked for, and
   the one way on clears it. *@
<Column Gap="4" Grow>
    <TextField @bind-Value="_search" Label="Search customers" Type="TextFieldType.Search" StartIcon="Lucide.Search" MaxWidth="20.Rem" />
    <EmptyState Bordered Icon="Lucide.SearchX" Title="No customers match “acme”" Description="Check the spelling, or clear the search to see every customer.">
        <EmptyStateActions>
            <Button Href="#" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Clear search</Button>
        </EmptyStateActions>
    </EmptyState>
</Column>

@code {
    private string? _search = "acme";
}
