<Column Grow Radius="Radius.Lg" Border="1" Overflow="Overflow.Hidden">
    <Box Bg="Color.FillStrong" PaddingY="3">
        <Container Size="ContainerSize.Sm">
            <Row Gap="3" Align="Align.Center">
                <TextBlock Weight="FontWeight.Semibold" Grow>Acme</TextBlock>
                <Button Size="ControlSize.Sm">Sign up</Button>
            </Row>
        </Container>
    </Box>
    <Box PaddingY="6">
        <Container Size="ContainerSize.Sm">
            <Column Gap="2">
                <Heading Level="3">Plans for every team</Heading>
                <TextBlock Color="Color.Muted">Start free, and pay per seat once your team grows past five people.</TextBlock>
            </Column>
        </Container>
    </Box>
    <Box Bg="Color.FillSubtle" PaddingY="3">
        <Container Size="ContainerSize.Sm">
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">© 2026 Acme</TextBlock>
        </Container>
    </Box>
</Column>
