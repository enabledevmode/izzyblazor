@* A project plan: phases, their tasks, and the steps under some tasks. Filter by owner or status, or
   search, and each match keeps the phase and task above it, muted, so it's clear where it belongs. *@
<TreeList Items="_tasks" ItemKey="t => t.Id.ToString()" ItemParentKey="t => t.ParentId?.ToString()"
          Searchable QueryPrefix="plan-" Caption="Launch plan" Grow>
    <Columns>
        <PropertyColumn Property="t => t.Name" Title="Task" Filterable />
        <PropertyColumn Property="t => t.Owner" Filterable Width="10.Rem" />
        <PropertyColumn Property="t => t.Status" Filterable Width="9.Rem" />
        <PropertyColumn Property="t => t.Due" Format="MMM d" Sortable Width="7.Rem" />
    </Columns>
</TreeList>

