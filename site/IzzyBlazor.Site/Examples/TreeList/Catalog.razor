@* A store's catalog: departments, categories and products. FilterBranch keeps everything under a
   match, so a search for a category lists its products. *@
<TreeList Items="_catalog" ItemKey="c => c.Sku" ItemParentKey="c => c.Parent" FilterBranch
          Searchable QueryPrefix="shop-" Caption="Catalog" Grow>
    <Columns>
        <PropertyColumn Property="c => c.Name" Sortable />
        <PropertyColumn Property="c => c.Sku" Title="SKU" Width="8.Rem" />
        <PropertyColumn Property="c => c.Price" Format="C" Sortable Width="7.Rem" />
        <PropertyColumn Property="c => c.Stock" Sortable Width="6.Rem" />
    </Columns>
</TreeList>

