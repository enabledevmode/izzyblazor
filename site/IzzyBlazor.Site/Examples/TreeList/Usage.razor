@* A flat list of people, each with a manager's id, as an HR table holds them; the top level open. *@
<TreeList Items="_people" ItemKey="p => p.Id.ToString()" ItemParentKey="p => p.ManagerId?.ToString()"
          ItemExpanded="p => p.ManagerId is null" QueryPrefix="org-" Caption="People">
    <Columns>
        <PropertyColumn Property="p => p.Name" Sortable Filterable />
        <PropertyColumn Property="p => p.Title" Sortable />
        <PropertyColumn Property="p => p.Location" Sortable Filterable />
        <PropertyColumn Property="p => p.Started" Format="MMM yyyy" Sortable />
    </Columns>
</TreeList>

