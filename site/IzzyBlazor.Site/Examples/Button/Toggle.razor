@* Toggle buttons: @bind-Pressed turns each on and off, and screen readers hear "pressed". *@
<Stack Gap="3" Align="Align.Center">
    <Row Gap="2" Wrap Justify="Justify.Center">
        <Button StartIcon="Lucide.Star" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" @bind-Pressed="_starred">Starred</Button>
        <Button StartIcon="Lucide.Paperclip" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" @bind-Pressed="_attachments">Has attachments</Button>
        <Button StartIcon="Lucide.Mail" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm" @bind-Pressed="_unread">Unread</Button>
    </Row>
    <TextBlock Size="TextSize.Sm" Color="Color.Muted">@Shown.Count() of @Messages.Length messages</TextBlock>
</Stack>

@code {
    private bool _starred;
    private bool _attachments;
    private bool _unread = true;

    private IEnumerable<Message> Shown => Messages.Where(m => (!_starred || m.Starred) && (!_attachments || m.Attachments) && (!_unread || m.Unread));

    @* hide *@
    private sealed record Message(bool Starred, bool Attachments, bool Unread);

    private static readonly Message[] Messages =
    [
        new(true, true, true), new(false, true, false), new(false, false, true), new(true, false, false),
        new(false, false, false), new(false, true, true), new(true, true, false), new(false, false, true),
        new(false, false, false), new(true, false, true), new(false, true, false), new(false, false, false),
    ];
    @* /hide *@
}
