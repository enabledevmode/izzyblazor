@* file: TopCustomers.cs *@
@* A dashboard whose customer list comes from a CRM that's down. The guard keeps the failure to that
   card: the revenue beside it and the rest of the page work. On a live page Try again loads the
   card again (and fails again, as the CRM is still down); on a static page Reload loads the page. *@
<Grid Columns="new() { Base = 1, Md = 2 }" Gap="4">
    <Card TitleLevel="2" Title="Revenue">
        <Stat Label="This month" Value="$48,210" Change="12%" Trend="StatTrend.Up" />
    </Card>
    <Card TitleLevel="2" Title="Top customers">
        <ErrorGuard>
            <TopCustomers />
        </ErrorGuard>
    </Card>
</Grid>
