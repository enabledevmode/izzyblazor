// The library's public CSS variables: each one's group, type and description, for izzy describe tokens
// (DocsGen's CliData). Values come from the library's CSS, not from here: tokens.css for the variables it
// declares, and "default" in words for those it doesn't (a component's own variables, and those made from
// other colors where they're used). Every variable tokens.css declares is listed, public or internal (a
// build checks), and every name here must be one the library's CSS uses. A name ending in * is a family:
// every variable tokens.css declares that starts with it, each with its own value. A name of its own, or
// the longer family, comes before a shorter family.
//
// "type" is color, length, font, number, shadow, time, easing or other. The groups follow the Tokens
// page's tables (Docs/Articles/Theming/Tokens.razor); keep the two in step.
{
  "format": 1,
  "groups": [
    { "group": "Page and surfaces", "type": "color", "tokens": {
      "--ib-color-background": "The page behind everything.",
      "--ib-color-surface": "Cards, panels, tables and bars: anything on the page.",
      "--ib-color-surface-sunken": "An area in a surface that holds surfaces of its own, such as a board's columns.",
      "--ib-color-surface-overlay": "Menus, popovers and toasts, above the page.",
      "--ib-color-overlay-border": "An overlay's edge, which shows in dark mode.",
      "--ib-color-fill-subtle": "Large quiet fills inside a surface: a filled card, a panel, a band.",
      "--ib-color-fill": "Small fills that must show: table heads, code, wells.",
      "--ib-color-fill-strong": "Selected and pressed fills, chips, tracks and skeletons."
    } },
    { "group": "Text and lines", "type": "color", "tokens": {
      "--ib-color-on-surface": "Text on the page and its surfaces.",
      "--ib-color-muted": "Secondary text, such as hints and captions.",
      "--ib-color-subtle": "Quiet text, such as placeholders.",
      "--ib-color-disabled": "Text and icons of disabled controls.",
      "--ib-color-border": "Borders of cards, tables and dividers.",
      "--ib-color-outline": "The edges of controls, such as an empty field.",
      "--ib-color-backdrop": "The shade behind a dialog or drawer."
    } },
    { "group": "Brand", "type": "color", "tokens": {
      "--ib-color-primary": "The brand fill: primary buttons, the selected switch, the focus ring.",
      "--ib-color-on-primary": "Text on the brand fill.",
      "--ib-color-primary-text": "The brand color as text on a surface, such as a link.",
      "--ib-color-primary-soft": "A soft tint of the brand: soft buttons, the current page, selected things."
    } },
    { "group": "Status", "type": "color", "tokens": {
      "--ib-color-success": "The success fill.",
      "--ib-color-on-success": "Text on the success fill.",
      "--ib-color-success-text": "Success as text on a surface.",
      "--ib-color-success-soft": "A soft tint of success.",
      "--ib-color-warning": "The warning fill.",
      "--ib-color-on-warning": "Text on the warning fill.",
      "--ib-color-warning-text": "Warning as text on a surface.",
      "--ib-color-warning-soft": "A soft tint of warning.",
      "--ib-color-danger": "The danger fill.",
      "--ib-color-on-danger": "Text on the danger fill.",
      "--ib-color-danger-text": "Danger as text on a surface.",
      "--ib-color-danger-soft": "A soft tint of danger.",
      "--ib-color-info": "The info fill.",
      "--ib-color-on-info": "Text on the info fill.",
      "--ib-color-info-text": "Info as text on a surface.",
      "--ib-color-info-soft": "A soft tint of info.",
      "--ib-color-neutral": "The neutral fill, such as a neutral badge.",
      "--ib-color-on-neutral": "Text on the neutral fill."
    } },
    { "group": "Made from other colors", "type": "color", "tokens": {
      "--ib-color-focus": { "description": "The focus ring and a focused field's edge.", "default": "the primary color" },
      "--ib-color-halo": { "description": "The glow around a focused field.", "default": "the focus color, faint" },
      "--ib-color-selected": { "description": "A selected row's fill.", "default": "the primary color, very faint" },
      "--ib-state-hover": { "description": "The wash over a hovered row or button.", "default": "the text color at 6%" },
      "--ib-state-pressed": { "description": "The wash over a pressed button.", "default": "the text color at 10%" },
      "--ib-color-segment": { "description": "The chosen segment of a segmented control.", "default": "the overlay surface; lighter in dark mode" },
      "--ib-color-on-segment": { "description": "Text on the chosen segment.", "default": "the text color" },
      "--ib-color-segment-edge": { "description": "The chosen segment's edge.", "default": "the border color; white at 8% in dark mode" },
      "--ib-color-segment-track": { "description": "A segmented control's track.", "default": "the fill; the subtle fill in dark mode" },
      "--ib-color-scrollbar": { "description": "A scrollbar's thumb.", "default": "the text color at 26%" },
      "--ib-color-scrollbar-hover": { "description": "A hovered scrollbar thumb.", "default": "the text color at 42%" }
    } },
    { "group": "Shape", "type": "length", "tokens": {
      "--ib-radius-none": "No rounding.",
      "--ib-radius-sm": "Small parts, such as chips and checkboxes.",
      "--ib-radius-md": "Controls, such as buttons and fields.",
      "--ib-radius-lg": "Cards and dialogs.",
      "--ib-radius-xl": "Large panels.",
      "--ib-radius-full": "A pill or a circle.",
      "--ib-radius-control": { "description": "Buttons, fields and tags, when a theme rounds them apart from the scale.", "default": "--ib-radius-md" },
      "--ib-radius-control-sm": { "description": "Badges, when a theme rounds them apart from the scale.", "default": "--ib-radius-sm" }
    } },
    { "group": "Density", "type": "length", "tokens": {
      "--ib-control-h-sm": "The height of small controls.",
      "--ib-control-h-md": "The height of medium controls, the default.",
      "--ib-control-h-lg": "The height of large controls.",
      "--ib-control-font-sm": "Text in small controls.",
      "--ib-control-icon-sm": "Icons in small controls.",
      "--ib-control-icon-md": "Icons in medium controls.",
      "--ib-control-icon-lg": "Icons in large controls.",
      "--ib-table-cell-py": "The space above and below a table cell's content.",
      "--ib-card-padding": "The space inside a card.",
      "--ib-space-*": "A step of the spacing scale: one step is 4px at the default text size."
    } },
    { "group": "Sizes", "type": "length", "tokens": {
      "--ib-size-sm": "The small breakpoint's width.",
      "--ib-size-md": "The medium breakpoint's width.",
      "--ib-size-lg": "The large breakpoint's width.",
      "--ib-size-xl": "The extra-large breakpoint's width.",
      "--ib-size-prose": "A readable line length."
    } },
    { "group": "Type", "type": "font", "tokens": {
      "--ib-font-body": "The font of body text and controls.",
      "--ib-font-heading": "The font of headings and of card and dialog titles.",
      "--ib-font-mono": "The font of code and keyboard keys."
    } },
    { "group": "Type", "type": "length", "tokens": {
      "--ib-text-*": "A step of the text size scale.",
      "--ib-tracking-*": "Letter spacing."
    } },
    { "group": "Type", "type": "number", "tokens": {
      "--ib-weight-heading": "The weight of headings.",
      "--ib-weight-*": "A font weight.",
      "--ib-leading-*": "Line height, as a multiple of the text size."
    } },
    { "group": "Depth", "type": "shadow", "tokens": {
      "--ib-shadow-none": "No shadow.",
      "--ib-shadow-xs": "The faint lift under a card.",
      "--ib-shadow-sm": "A small lift.",
      "--ib-shadow-md": "Menus and popovers.",
      "--ib-shadow-lg": "Dialogs and drawers."
    } },
    { "group": "Motion", "type": "time", "tokens": {
      "--ib-duration-fast": "Quick changes, such as a hover.",
      "--ib-duration-normal": "Opening and closing, such as a menu."
    } },
    { "group": "Motion", "type": "easing", "tokens": {
      "--ib-ease": "The easing of every transition."
    } },
    { "group": "Charts", "type": "color", "tokens": {
      "--ib-chart-of*": "A color of the set a chart of exactly two, three or four series uses.",
      "--ib-chart-contrast-*": "A color of the Contrast palette.",
      "--ib-chart-okabe-ito-*": "A color of the Okabe-Ito palette.",
      "--ib-chart-calm-*": "A color of the Calm palette.",
      "--ib-chart-*": "A series color of the app's chart palette, in order."
    } },
    { "group": "Code", "type": "color", "tokens": {
      "--ib-code-comment": "Comments in a code block.",
      "--ib-code-keyword": "Keywords in a code block.",
      "--ib-code-string": "Strings in a code block.",
      "--ib-code-number": "Numbers in a code block.",
      "--ib-code-type": "Types in a code block.",
      "--ib-code-function": "Functions in a code block.",
      "--ib-code-tag": "Tags in a code block.",
      "--ib-code-attr": "Attributes in a code block.",
      "--ib-code-meta": "Directives and other meta text in a code block.",
      "--ib-code-component": { "description": "Component names in a code block.", "default": "--ib-code-type" },
      "--ib-code-member": { "description": "Members in a code block.", "default": "--ib-code-attr" }
    } },

    { "group": "Button", "components": ["Button", "IconButton"], "type": "length", "tokens": {
      "--ib-btn-px": { "description": "A button's side padding (Button only).", "default": "the padding for its size" },
      "--ib-btn-radius": { "description": "A button's corner radius.", "default": "--ib-radius-control" }
    } },
    { "group": "Fields", "type": "length", "tokens": {
      "--ib-field-radius": { "description": "A field's corner radius.", "default": "--ib-radius-control" }
    } },
    { "group": "FileUpload", "components": ["FileUpload"], "type": "color", "tokens": {
      "--ib-upload-bg": { "description": "The drop area's background.", "default": "--ib-color-fill-subtle" },
      "--ib-upload-border-color": { "description": "The drop area's border color.", "default": "the outline color, a little darker" },
      "--ib-upload-border-style": { "description": "The drop area's border style.", "type": "other", "default": "dashed" }
    } },
    { "group": "Table", "components": ["Table", "DataGrid"], "type": "length", "tokens": {
      "--ib-table-cell-px": { "description": "The space beside a table cell's content.", "default": "--ib-space-4" }
    } },
    { "group": "AppShell", "components": ["AppShell"], "type": "color", "tokens": {
      "--ib-shell-header-bg": { "description": "The header's background.", "default": "--ib-color-surface" },
      "--ib-shell-header-fg": { "description": "The header's text.", "default": "--ib-color-on-surface" },
      "--ib-shell-sidebar-bg": { "description": "The sidebar's background.", "default": "--ib-color-surface" },
      "--ib-shell-sidebar-fg": { "description": "The sidebar's text.", "default": "--ib-color-on-surface" },
      "--ib-shell-main-bg": { "description": "The main area's background.", "default": "--ib-color-background" },
      "--ib-shell-main-fg": { "description": "The main area's text.", "default": "--ib-color-on-surface" },
      "--ib-shell-aside-bg": { "description": "The aside's background.", "default": "--ib-color-surface" },
      "--ib-shell-aside-fg": { "description": "The aside's text.", "default": "--ib-color-on-surface" },
      "--ib-shell-footer-bg": { "description": "The footer's background.", "default": "--ib-color-surface" },
      "--ib-shell-footer-fg": { "description": "The footer's text.", "default": "--ib-color-on-surface" },
      "--ib-shell-divider": { "description": "The lines between the shell's areas.", "default": "--ib-color-border" }
    } },
    { "group": "AppShell", "components": ["AppShell"], "type": "length", "tokens": {
      "--ib-shell-header-h": { "description": "The header's height.", "default": "3.5rem" },
      "--ib-shell-footer-h": { "description": "The footer's height.", "default": "3.5rem" },
      "--ib-banner-h": { "description": "A banner's height above the header.", "default": "2.3125rem" }
    } },
    { "group": "Icon", "components": ["Icon"], "type": "number", "tokens": {
      "--ib-icon-stroke": { "description": "The width of an icon's lines.", "default": "2" }
    } },
    { "group": "Icon", "components": ["Icon", "Spinner"], "type": "time", "tokens": {
      "--ib-spin-duration": { "description": "How long one turn of a spinning icon or spinner takes.", "default": "1s" }
    } },
    { "group": "AvatarGroup", "components": ["AvatarGroup"], "type": "color", "tokens": {
      "--ib-avatar-ring": { "description": "The ring that sets each avatar apart from the next.", "default": "--ib-color-surface" }
    } },
    { "group": "Timeline", "components": ["Timeline"], "type": "color", "tokens": {
      "--ib-timeline-bg": { "description": "The background behind a timeline's markers.", "default": "--ib-color-surface" }
    } }
  ],
  // Declared in tokens.css for the library's own use: may change without notice.
  "internal": ["--ib-on-light", "--ib-on-dark"]
}
