@* Toolbars for ToolbarTests, by Kind. *@
@switch (Kind)
{
    case "controls":
        <Toolbar Label="Editor">
            <ToolbarButtonGroup Label="History">
                <ToolbarIconButton Icon="Lucide.Undo2" Label="Undo" />
                <ToolbarIconButton Icon="Lucide.Redo2" Label="Redo" />
            </ToolbarButtonGroup>
            <ToolbarSeparator />
            <ToolbarButton Submit Name="intent" Value="archive" FormAction="/mail/archive" StartIcon="Lucide.Archive" id="archive">Archive</ToolbarButton>
            <ToolbarButton Href="/help">Help</ToolbarButton>
            <ToolbarMenu Label="Export" Position="ToolbarPosition.End">
                <MenuItem Href="/export.csv">CSV</MenuItem>
            </ToolbarMenu>
            <ToolbarButton Position="ToolbarPosition.End" Overflow="ToolbarOverflow.Never">Publish</ToolbarButton>
            <ToolbarText Position="ToolbarPosition.Center">Untitled</ToolbarText>
            <ToolbarButton Position="ToolbarPosition.End" Overflow="ToolbarOverflow.Always">Print</ToolbarButton>
        </Toolbar>
        break;
    case "stays":
        <Toolbar Label="Stays">
            <ToolbarButton Reset>Reset</ToolbarButton>
            <ToolbarItem Width="Length.Rem(10)">
                <input name="q" />
            </ToolbarItem>
            <ToolbarItem>
                <DialogTrigger For="d">Open</DialogTrigger>
            </ToolbarItem>
            <ToolbarItem>
                <Popover Label="Filters">
                    <Button>Inside the popover</Button>
                </Popover>
            </ToolbarItem>
            <ToolbarText>3 selected</ToolbarText>
            <ToolbarButton>Plain</ToolbarButton>
        </Toolbar>
        break;
    case "defaults":
        <Toolbar Label="Defaults">
            <ToolbarButton>Ghost</ToolbarButton>
            <ToolbarButton Variant="ButtonVariant.Solid" Accent="Accent.Primary">Solid</ToolbarButton>
            <ToolbarButtonGroup Label="Group">
                <ToolbarButton>In a group</ToolbarButton>
            </ToolbarButtonGroup>
            <ToolbarMenu Label="Menu">
                <MenuItem>One</MenuItem>
            </ToolbarMenu>
            <ToolbarItem>
                <Button>In an item</Button>
            </ToolbarItem>
        </Toolbar>
        break;
    case "wrap":
        <Toolbar Label="Wrap" Wrap>
            <ToolbarButton>One</ToolbarButton>
            <ToolbarButton>Two</ToolbarButton>
        </Toolbar>
        break;
    case "wrapped":
        <Toolbar Label="Wrapped">
            <WrapProbe><ToolbarButton>Inside</ToolbarButton></WrapProbe>
            <ToolbarButton>After</ToolbarButton>
        </Toolbar>
        break;
    case "nonce":
        <Toolbar Label="Nonce" Nonce="abc123">
            <ToolbarButton>One</ToolbarButton>
        </Toolbar>
        break;
    case "button":
        <Toolbar><Button>Raw</Button></Toolbar>
        break;
    case "icon-button":
        <Toolbar><IconButton Icon="Lucide.Bold" Label="Bold" /></Toolbar>
        break;
    case "button-group":
        <Toolbar><ButtonGroup Label="Raw"><ToolbarButton>One</ToolbarButton></ButtonGroup></Toolbar>
        break;
    case "menu":
        <Toolbar><Menu Label="Raw"><MenuItem>One</MenuItem></Menu></Toolbar>
        break;
    case "tooltip":
        <Toolbar><Tooltip Text="Raw"><ToolbarIconButton Icon="Lucide.Bold" Label="Bold" /></Tooltip></Toolbar>
        break;
    case "in-group":
        <Toolbar><ToolbarButtonGroup Label="Group"><Button>Raw</Button></ToolbarButtonGroup></Toolbar>
        break;
    case "placed-in-group":
        <Toolbar><ToolbarButtonGroup Label="Group"><ToolbarButton Overflow="ToolbarOverflow.Never">One</ToolbarButton></ToolbarButtonGroup></Toolbar>
        break;
    case "toolbar-button-in-item":
        <Toolbar><ToolbarItem><ToolbarButton>Nested</ToolbarButton></ToolbarItem></Toolbar>
        break;
    case "outside":
        <ToolbarButton>Alone</ToolbarButton>
        break;
}

@code {
    [Parameter] public string Kind { get; set; } = "controls";
}
