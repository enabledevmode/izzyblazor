@* Quarters over their revenue and margin, a column outside any band, and a band holding a band and a column; ColumnBandTests renders it. *@
<DataGrid Items="Rows" TItem="Sales" Layout="Layout">
    <PropertyColumn Property="r => r.Region" />
    <ColumnBand Title="Q1">
        <PropertyColumn Property="r => r.Q1" Title="Revenue" Sortable SortKey="q1" />
        <PropertyColumn Property="r => r.Q1Margin" Title="Margin" />
    </ColumnBand>
    <ColumnBand Title="Year">
        <ColumnBand Title="H2">
            <PropertyColumn Property="r => r.Q3" Title="Q3" />
        </ColumnBand>
        <PropertyColumn Property="r => r.Total" />
    </ColumnBand>
</DataGrid>

@code {
    [Parameter] public DataGridLayout? Layout { get; set; }

    public sealed record Sales(string Region, int Q1, double Q1Margin, int Q3, int Total);

    private static readonly Sales[] Rows = [new("North", 10, 0.1, 30, 40), new("South", 50, 0.2, 10, 60), new("West", 30, 0.3, 20, 50)];
}
