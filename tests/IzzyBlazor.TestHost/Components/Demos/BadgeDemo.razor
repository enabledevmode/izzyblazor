@inject NavigationManager Navigation

<Stack Gap="8">

    <Example Title="Statuses and variants" Code="@VariantsCode">
        <Stack Gap="3">
            @foreach (var variant in Enum.GetValues<BadgeVariant>())
            {
                <Row Gap="2" Align="Align.Center" Wrap>
                    <TextBlock As="span" Class="host-label">@variant</TextBlock>
                    @foreach (var status in Enum.GetValues<Status>())
                    {
                        <Badge Status="status" Variant="variant">@status</Badge>
                    }
                    <Badge Accent="Accent.Primary" Variant="variant">Primary (Color)</Badge>
                </Row>
            }
        </Stack>
    </Example>

    <Example Title="Statuses, counts and icons" Code="@UsesCode">
        <Row Gap="3" Align="Align.Center" Wrap>
            <Badge Status="Status.Success" Dot>Published</Badge>
            <Badge Status="Status.Warning" Dot>In review</Badge>
            <Badge Status="Status.Neutral" Dot>Draft</Badge>
            <Badge Status="Status.Danger" Variant="BadgeVariant.Solid" Pill>3</Badge>
            <Badge Accent="Accent.Primary" Variant="BadgeVariant.Solid" Pill Size="BadgeSize.Sm">12</Badge>
            <Badge Status="Status.Info" StartIcon="Lucide.Sparkles">New</Badge>
        </Row>
    </Example>

    <Example Title="Inside text and buttons" Code="@InlineCode">
        <Stack Gap="3">
            <Heading Level="3" Size="TextSize.Lg">Release notes <Badge Accent="Accent.Primary">v0.1</Badge></Heading>
            <Row Gap="2">
                <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Inbox">Inbox <Badge Accent="Accent.Primary" Variant="BadgeVariant.Solid" Pill Size="BadgeSize.Sm">4</Badge></Button>
            </Row>
        </Stack>
    </Example>

    <Example Title="Tag" Note="Larger than a badge, for keywords, categories and applied filters. Href makes the text a link." Code="@TagCode">
        <Stack Gap="3">
            @foreach (var variant in Enum.GetValues<TagVariant>())
            {
                <Row Gap="2" Wrap>
                    @foreach (var status in Enum.GetValues<Status>())
                    {
                        <Tag Label="@status.ToString()" Status="status" Variant="variant" />
                    }
                </Row>
            }
            <Row Gap="2" Wrap Align="Align.Center">
                <Tag Label="Blazor" Href="static/badge" StartIcon="Lucide.Hash" />
                <Tag Label="Brand" Accent="Accent.Primary" Variant="TagVariant.Solid" />
                <Tag Label="Small" Size="ControlSize.Sm" />
                <Tag Label="Medium" />
                <Tag Label="Large" Size="ControlSize.Lg" />
            </Row>
        </Stack>
    </Example>

    <Example Title="Removable tags" Note="@RemoveNote" Code="@RemoveCode">
        <Row Gap="2" Wrap Align="Align.Center" data-testid="filter-tags">
            @foreach (var filter in Filters.Where(f => !_removed.Contains(f)))
            {
                <Tag Label="@filter" RemoveHref="@RemoveUrl(filter)" OnRemove="() => _removed.Add(filter)" />
            }
            @if (_removed.Count > 0)
            {
                @if (RendererInfo.IsInteractive)
                {
                    <Button Variant="ButtonVariant.Link" Size="ControlSize.Sm" OnClick="() => _removed.Clear()">Reset</Button>
                }
                else
                {
                    <Button Href="@Navigation.GetUriWithQueryParameter("removed", (string?)null)" Variant="ButtonVariant.Link" Size="ControlSize.Sm">Reset</Button>
                }
            }
        </Row>
    </Example>

</Stack>

@code {
    private static readonly string[] Filters = ["Status: Paid", "Region: Europe", "Amount over $100", "This quarter"];

    [SupplyParameterFromQuery(Name = "removed")] public string[]? RemovedQuery { get; set; }

    private HashSet<string> _removed = [];

    protected override void OnInitialized() => _removed = [.. RemovedQuery ?? []];

    private string RemoveUrl(string filter) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["removed"] = _removed.Append(filter).ToArray() });

    private string RemoveNote => RendererInfo.IsInteractive
        ? "On interactive pages the remove button runs OnRemove in C#."
        : "On static pages the remove button is a link (RemoveHref), here to this page with that filter removed, so it works with JavaScript off. On interactive pages it runs OnRemove instead.";

    private const string TagCode =
        """
        <Tag Label="Blazor" Href="/topics/blazor" StartIcon="Lucide.Hash" />
        <Tag Label="Brand" Accent="Accent.Primary" Variant="TagVariant.Solid" />
        """;

    private const string RemoveCode =
        """
        <Tag Label="Status: Paid" RemoveHref="@UrlWithout("status")" OnRemove="ClearStatus" />
        """;

    private const string VariantsCode = """<Badge Status="Status.Success" Variant="BadgeVariant.Soft">Published</Badge>""";

    private const string UsesCode =
        """
        <Badge Status="Status.Success" Dot>Published</Badge>
        <Badge Status="Status.Danger" Variant="BadgeVariant.Solid" Pill>3</Badge>
        <Badge Status="Status.Info" StartIcon="Lucide.Sparkles">New</Badge>
        """;

    private const string InlineCode =
        """<Heading Level="3">Release notes <Badge Accent="Accent.Primary">v0.1</Badge></Heading>""";
}
