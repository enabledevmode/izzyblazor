@inject NavigationManager Navigation

@* Stepper. No script: the current step comes from ?step= in the URL. *@

<Stack Gap="8">

    <Example Title="Checkout" Note="Steps before Current show as done, with a check that screen readers hear as &quot;(completed)&quot;; the current one has aria-current=&quot;step&quot;. Finished steps here are links back. Back and Next are links that change ?step=, so it works with JavaScript off. Phones get a column." Code="@CheckoutCode">
        <Stack Gap="5">
            <Stepper Current="_step" data-testid="steps-checkout">
                @foreach (var (label, number) in Checkout.Select((l, i) => (l, i + 1)))
                {
                    <Step Label="@label" Href="@(number < _step ? StepUrl(number) : null)" />
                }
            </Stepper>
            <Row Gap="2">
                <LinkButton Href="@StepUrl(Math.Max(1, _step - 1))" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Hugeicons.ArrowLeft02" Disabled="_step <= 1">Back</LinkButton>
                <LinkButton Href="@StepUrl(Math.Min(Checkout.Length + 1, _step + 1))" EndIcon="Hugeicons.ArrowRight02">@(_step >= Checkout.Length ? "Finish" : "Next")</LinkButton>
            </Row>
        </Stack>
    </Example>

    <Example Title="With descriptions, vertical" Note="Orientation.Vertical keeps the column on every screen. Icon replaces a step's number until it's done." Code="@VerticalCode">
        <Stepper Current="2" Orientation="Orientation.Vertical">
            <Step Label="Create the project" Description="Name, region and plan" />
            <Step Label="Connect a repository" Description="GitHub, GitLab or Bitbucket" Icon="Hugeicons.GitBranch" />
            <Step Label="Deploy" Description="Builds on every push to main" Icon="Hugeicons.Rocket01" />
        </Stepper>
    </Example>

    <Example Title="Sizes" Code="@SizesCode">
        <Stack Gap="6">
            @foreach (var size in new[] { ControlSize.Sm, ControlSize.Md, ControlSize.Lg })
            {
                <Stepper Current="2" Size="size" Label="@($"{size} steps")">
                    <Step Label="Account" />
                    <Step Label="Profile" />
                    <Step Label="Review" />
                </Stepper>
            }
        </Stack>
    </Example>

</Stack>

@code {
    [SupplyParameterFromQuery(Name = "step")] public int? StepQuery { get; set; }

    private static readonly string[] Checkout = ["Cart", "Shipping", "Payment", "Review"];

    private int _step;

    protected override void OnParametersSet() => _step = Math.Clamp(StepQuery ?? 2, 1, Checkout.Length + 1);

    private string StepUrl(int step) => Navigation.GetUriWithQueryParameter("step", step);

    private const string CheckoutCode =
        """
        <Stepper Current="Step">
            <Step Label="Cart" Href="?step=1" />
            <Step Label="Shipping" />
            <Step Label="Payment" />
            <Step Label="Review" />
        </Stepper>
        """;

    private const string VerticalCode =
        """
        <Stepper Current="2" Orientation="Orientation.Vertical">
            <Step Label="Create the project" Description="Name, region and plan" />
            <Step Label="Connect a repository" Description="GitHub, GitLab or Bitbucket" Icon="Hugeicons.GitBranch" />
            <Step Label="Deploy" Description="Builds on every push to main" Icon="Hugeicons.Rocket01" />
        </Stepper>
        """;

    private const string SizesCode =
        """
        <Stepper Current="2" Size="ControlSize.Sm">...</Stepper>
        <Stepper Current="2" Size="ControlSize.Lg">...</Stepper>
        """;
}
