@* A visible block for layout demos. *@

<Box Class="host-tile" Padding="3" Radius="Radius.Sm" Bg="Bg" Color="Fg" Grow="Grow" Basis="Basis" Style="@Style">
    @ChildContent
</Box>

@code {
    [Parameter] public Responsive<Color> Bg { get; set; } = Color.SurfaceContainerHigh;
    [Parameter] public Responsive<Color> Fg { get; set; }
    [Parameter] public bool Grow { get; set; }
    [Parameter] public Responsive<Length> Basis { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
