@* A visible block for layout demos: a raised surface with an edge, so it reads on the white
   canvas and inside the gray tracks (container fills) the layout demos put around it. *@

<Box Class="@(Equals(Bg.Base, Color.Surface) ? "host-tile host-tile-plain" : "host-tile")" Padding="3" Radius="Radius.Sm" Bg="Bg" Color="Fg" Grow="Grow" Basis="Basis" Style="@Style">
    @ChildContent
</Box>

@code {
    [Parameter] public Responsive<Color> Bg { get; set; } = Color.Surface;
    [Parameter] public Responsive<Color> Fg { get; set; }
    [Parameter] public bool Grow { get; set; }
    [Parameter] public Responsive<Length> Basis { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
