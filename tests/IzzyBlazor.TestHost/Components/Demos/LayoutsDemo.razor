@* Real screens for each kind of content, each in the shell variant that suits it and in an
   alternative, so the layering can be judged on content rather than placeholders. The header's
   theme and light/dark choices apply inside the frames. *@

<Stack Gap="8">
    <TextBlock Color="Color.Muted" MaxWidth="Length.Prose">
        The layering rule: raised things are lighter than what they sit on. Which part takes the page
        tint depends on the content. Content made of sections (settings, dashboards) reads best as
        white cards on a tinted canvas. Content that fills the page (a table, a document) reads best on
        white, with the navigation tinted so it recedes.
    </TextBlock>

    @foreach (var kind in Kinds)
    {
        <Example Title="@kind.Title" Note="@kind.Note">
            <Stack Gap="4">
                @foreach (var (variant, why) in kind.Variants)
                {
                    <TextBlock As="span" Class="host-label">@Label(variant) · @why</TextBlock>
                    <iframe class="host-frame" style="width:100%;height:36rem" src="preview/layout/@kind.Slug?variant=@variant" title="@kind.Title, @Label(variant) variant"></iframe>
                }
                <Row Gap="2">
                    <LinkButton Href="@($"preview/layout/{kind.Slug}?variant={kind.Variants[0].Variant}")" External Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Open full page</LinkButton>
                </Row>
            </Stack>
        </Example>
    }
</Stack>

@code {
    private sealed record Kind(string Slug, string Title, string Note, (string Variant, string Why)[] Variants);

    private static readonly Kind[] Kinds =
    [
        new("settings", "Settings: forms in sections",
            "Groups of fields, each a card. The cards need something to sit on, so the canvas takes the tint.",
            [("canvas", "recommended: white cards on the tint"), ("tinted", "the default: the cards rely on their borders alone")]),
        new("dashboard", "Dashboard: stats and panels",
            "Many small cards. Canvas gives each one an edge of contrast; Inset keeps the frame quiet and raises the whole work area.",
            [("canvas", "recommended"), ("inset", "alternative: the work area as one raised panel")]),
        new("list", "List: a full-width table",
            "The table is the page. On white it needs no card around it, and its header and lines carry the structure.",
            [("tinted", "recommended: the default"), ("canvas", "alternative: the table is its own white surface on the tint")]),
        new("document", "Document: long-form reading",
            "Text reads best on the brightest surface with nothing competing; the navigation recedes.",
            [("tinted", "recommended: the default"), ("inset", "alternative: the page as a raised sheet")]),
        new("reading", "Reading site: one centered column",
            "No sidebar. AppShell's ContentWidth centers the header, the article and the footer on one column, so their edges line up, while the bars and their lines stay full width.",
            [("flat", "recommended: one white page"), ("inset", "alternative: the article as a raised sheet")]),
        new("marketing", "Content site: hero, cards, bands",
            "No sidebar, a wider column (72rem). Sections stack down the page: a hero with a video, a tinted band of project cards, a check list, and an accent band for the newsletter, each full bleed with its content on the column. The footer holds link columns.",
            [("flat", "recommended: sections carry the color"), ("inset", "alternative: the page as one raised sheet")]),
    ];

    private static string Label(string variant) => char.ToUpperInvariant(variant[0]) + variant[1..];
}
