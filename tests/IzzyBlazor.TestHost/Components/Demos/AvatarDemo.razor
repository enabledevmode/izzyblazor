@* Avatar and AvatarGroup. No script needed; a broken image falls back to initials either way. *@

<Stack Gap="8">

    <Example Title="Image, initials, icon" Note="Initials and their color come from Name, so a person looks the same everywhere. A broken image shows the initials." Code="@BasicsCode">
        <Row Gap="4" Align="Align.Center" Wrap data-testid="avatar-basics">
            <Avatar Name="Grace Hopper" Src="img/avatar-1.jpg" />
            <Avatar Name="Alan Turing" Src="img/avatar-2.jpg" />
            <Avatar Name="Ada Lovelace" />
            <Avatar Name="Katherine Johnson" />
            <Avatar Name="Linus" />
            <Avatar Name="Broken Image" Src="img/missing.jpg" data-testid="avatar-broken" />
            <Avatar />
            <Avatar Name="Acme Corp" Square Accent="Accent.Primary" />
            <Avatar Name="Design team" Square Icon="Lucide.Palette" Initials="" />
        </Row>
    </Example>

    <Example Title="Sizes and status" Code="@SizesCode">
        <Stack Gap="4">
            <Row Gap="4" Align="Align.End" Wrap>
                @foreach (var size in Enum.GetValues<AvatarSize>())
                {
                    <Avatar Name="Margaret Hamilton" Src="img/avatar-3.jpg" Size="size" />
                }
            </Row>
            <Row Gap="4" Align="Align.Center" Wrap>
                <Avatar Name="Grace Hopper" Src="img/avatar-1.jpg" Status="Status.Success" StatusLabel="Online" data-testid="avatar-online" />
                <Avatar Name="Alan Turing" Status="Status.Warning" StatusLabel="Away" />
                <Avatar Name="Ada Lovelace" Status="Status.Danger" StatusLabel="Busy" Size="AvatarSize.Lg" />
                <Avatar Name="Acme Corp" Square Status="Status.Neutral" StatusLabel="Offline" Size="AvatarSize.Lg" />
            </Row>
        </Stack>
    </Example>

    <Example Title="Beside a name" Note="Decorative hides the avatar from screen readers when the name is written next to it." Code="@BesideCode">
        <Row Gap="3" Align="Align.Center">
            <Avatar Name="Grace Hopper" Src="img/avatar-1.jpg" Decorative />
            <Stack Gap="0">
                <TextBlock Weight="FontWeight.Medium">Grace Hopper</TextBlock>
                <TextBlock Size="TextSize.Sm" Color="Color.Muted">grace@example.com</TextBlock>
            </Stack>
        </Row>
    </Example>

    <Example Title="Group" Note="@GroupNote" Code="@GroupCode">
        <Stack Gap="4">
            <AvatarGroup Max="3" Label="Project members" data-testid="avatar-group">
                @foreach (var person in _people)
                {
                    <Avatar Name="@person.Name" Src="@person.Photo" />
                }
            </AvatarGroup>
            <AvatarGroup Size="AvatarSize.Sm" Label="Reviewers">
                <Avatar Name="Grace Hopper" Src="img/avatar-1.jpg" />
                <Avatar Name="Alan Turing" />
                <Avatar Name="Ada Lovelace" />
            </AvatarGroup>
            @if (RendererInfo.IsInteractive)
            {
                <Row Gap="2">
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" OnClick="Remove" data-testid="avatar-remove">Remove one</Button>
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" OnClick="Add" data-testid="avatar-add">Add one</Button>
                </Row>
            }
        </Stack>
    </Example>

</Stack>

@code {
    private sealed record Person(string Name, string? Photo = null);

    private static readonly Person[] Everyone =
    [
        new("Grace Hopper", "img/avatar-1.jpg"),
        new("Alan Turing", "img/avatar-2.jpg"),
        new("Ada Lovelace"),
        new("Margaret Hamilton", "img/avatar-3.jpg"),
        new("Katherine Johnson"),
        new("Dennis Ritchie"),
        new("Barbara Liskov"),
    ];

    private readonly List<Person> _people = Everyone.Take(6).ToList();

    private void Remove()
    {
        if (_people.Count > 0)
        {
            _people.RemoveAt(_people.Count - 1);
        }
    }

    private void Add()
    {
        if (_people.Count < Everyone.Length)
        {
            _people.Add(Everyone[_people.Count]);
        }
    }

    private string GroupNote => RendererInfo.IsInteractive
        ? "Max shows the first few and counts the rest. Add and remove people to see the count follow."
        : "Max shows the first few and counts the rest in a +N avatar.";

    private const string BasicsCode =
        """
        <Avatar Name="Grace Hopper" Src="img/grace.jpg" />
        <Avatar Name="Ada Lovelace" />
        <Avatar />
        <Avatar Name="Acme Corp" Square Accent="Accent.Primary" />
        """;

    private const string SizesCode =
        """
        <Avatar Name="Margaret Hamilton" Size="AvatarSize.Xl" />
        <Avatar Name="Grace Hopper" Status="Status.Success" StatusLabel="Online" />
        """;

    private const string BesideCode =
        """
        <Avatar Name="Grace Hopper" Src="img/grace.jpg" Decorative />
        <TextBlock>Grace Hopper</TextBlock>
        """;

    private const string GroupCode =
        """
        <AvatarGroup Max="3" Label="Project members">
            @foreach (var person in People)
            {
                <Avatar Name="@person.Name" Src="@person.Photo" />
            }
        </AvatarGroup>
        """;
}
