@* One labeled example on a demo page: a title, an optional note, the live result, and the code. *@

<section class="host-example">
    <Stack Gap="1">
        <h2 class="host-example-title">@Title</h2>
        @if (Note is not null)
        {
            <p class="host-example-note">@Note</p>
        }
    </Stack>
    @* The library's CodeExample: the live result and its source, colored, with a copy button. *@
    <CodeExample Code="@Code" Language="@CodeLanguage">@ChildContent</CodeExample>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The code's language for coloring. Defaults to razor.</summary>
    [Parameter] public string CodeLanguage { get; set; } = "razor";
}
