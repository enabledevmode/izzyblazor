@* One labelled example on a demo page: a title, an optional note, the live result, and the code. *@

<section class="host-example">
    <Stack Gap="1">
        <h2 class="host-example-title">@Title</h2>
        @if (Note is not null)
        {
            <p class="host-example-note">@Note</p>
        }
    </Stack>
    <div class="host-example-frame">
        @if (ChildContent is not null)
        {
            <div class="host-example-canvas">
                @ChildContent
            </div>
        }
        @if (Code is not null)
        {
            @* Colored with the library's highlighter, the same spans Code renders. *@
            <pre class="host-example-code"><code>@foreach (var token in Tokens)
            {
                if (token.Kind == CodeTokenKind.Text)
                {
                    <text>@token.Text</text>
                }
                else
                {
                    <span class="ib-tok-@(token.Kind == CodeTokenKind.Attribute ? "attr" : token.Kind.ToString().ToLowerInvariant())">@token.Text</span>
                }
            }</code></pre>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The code's language for coloring. Defaults to razor.</summary>
    [Parameter] public string CodeLanguage { get; set; } = "razor";

    private IEnumerable<CodeToken> Tokens =>
        IzzyCodeHighlighter.Instance.TryHighlight(Code!, CodeLanguage, out var tokens) ? tokens : [new CodeToken(CodeTokenKind.Text, Code!)];
}
