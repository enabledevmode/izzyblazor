@* Tabs. Every example also works with JavaScript off. *@

<Stack Gap="8">

    <Example Title="Variants" Note="Line (the default), Soft and Segmented. With JavaScript off each tab is a radio button and CSS shows its panel, so switching is instant and arrow keys work." Code="@VariantsCode">
        <Stack Gap="6">
            @foreach (var variant in Enum.GetValues<TabsVariant>())
            {
                <Stack Gap="2">
                    <TextBlock As="span" Class="host-label">@variant</TextBlock>
                    <Tabs Variant="variant" Label="@($"{variant} example")" Id="@($"tabs-{variant.ToString().ToLowerInvariant()}")">
                        <Tab Label="Overview" Icon="Lucide.LayoutDashboard">
                            <TextBlock>Everything at a glance.</TextBlock>
                        </Tab>
                        <Tab Label="Activity" Badge="3">
                            <TextBlock>Three new events since yesterday.</TextBlock>
                        </Tab>
                        <Tab Label="Settings" Icon="Lucide.Settings">
                            <TextBlock>Preferences for this project.</TextBlock>
                        </Tab>
                        <Tab Label="Archive" Disabled="true">Not yet.</Tab>
                    </Tabs>
                </Stack>
            }
        </Stack>
    </Example>

    <Example Title="Sizes and full width" Note="Size matches buttons and fields. FullWidth stretches the tabs to share the width, like Button FullWidth." Code="@SizesCode">
        <Stack Gap="6">
            @foreach (var size in Enum.GetValues<ControlSize>())
            {
                <Tabs Size="size" Variant="TabsVariant.Segmented" FullWidth Label="@($"Size {size}")">
                    <Tab Label="Day">Today's numbers.</Tab>
                    <Tab Label="Week">This week's numbers.</Tab>
                    <Tab Label="Month">This month's numbers.</Tab>
                </Tabs>
            }
        </Stack>
    </Example>

    <Example Title="Vertical" Note="Orientation.Vertical puts the tabs in a column beside the panels from 640px up; Up and Down arrows move between them. On phones the tabs stay a scrolling row above the panels, so the content keeps its width." Code="@VerticalCode">
        <Stack Gap="10">
            <Tabs Orientation="Orientation.Vertical" Label="Project settings" Id="tabs-vertical">
                <Tab Label="General" Icon="Lucide.Settings">
                    <Stack Gap="2">
                        <TextBlock Weight="FontWeight.Medium">General</TextBlock>
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Name, description and visibility.</TextBlock>
                    </Stack>
                </Tab>
                <Tab Label="Members" Icon="Lucide.UsersRound" Badge="4">
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Four people have access.</TextBlock>
                </Tab>
                <Tab Label="Integrations" Icon="Lucide.Plug">
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Connected services.</TextBlock>
                </Tab>
                <Tab Label="Danger zone" Icon="Lucide.TriangleAlert">
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Transfer or delete the project.</TextBlock>
                </Tab>
            </Tabs>
            <Tabs Orientation="Orientation.Vertical" Variant="TabsVariant.Soft" Label="Help topics" Id="tabs-vertical-soft">
                <Tab Label="Getting started">Install the package and add the stylesheet.</Tab>
                <Tab Label="Billing">Plans, invoices and refunds.</Tab>
                <Tab Label="Accounts">Sign-in, two-factor and recovery.</Tab>
            </Tabs>
        </Stack>
    </Example>

    <Example Title="Tabs as links" Note="TabLink makes each tab a link to its own page, for sections split across routes. The Tabs renders a nav of real links with no panels and no script, and the tab for the current page is marked (aria-current) from the URL on the server. These link to other demo pages; this page's tab is selected." Code="@LinksCode">
        <Stack Gap="6">
            <Tabs Label="Demo pages">
                <TabLink Href="@($"{Mode}/tabs")" Label="Tabs" Icon="Lucide.PanelTop" />
                <TabLink Href="@($"{Mode}/buttons")" Label="Buttons" Icon="Lucide.MousePointerClick" />
                <TabLink Href="@($"{Mode}/forms")" Label="Forms" Icon="Lucide.TextCursorInput" />
                <TabLink Href="@($"{Mode}/billing")" Label="Billing" Disabled />
            </Tabs>
            <Tabs Label="Demo pages" Variant="TabsVariant.Segmented">
                <TabLink Href="@($"{Mode}/tabs")" Label="Tabs" />
                <TabLink Href="@($"{Mode}/buttons")" Label="Buttons" />
                <TabLink Href="@($"{Mode}/forms")" Label="Forms" />
            </Tabs>
        </Stack>
    </Example>

    <Example Title="In the URL" Note="QueryKey keeps the selected tab in the query string: a link to ?tab=billing opens Billing, and with JavaScript switching tabs updates the address so it can be shared." Code="@UrlCode">
        <Stack Gap="3">
            <Tabs QueryKey="tab" Label="Account" Id="account-tabs">
                <Tab Label="Profile" Icon="Lucide.User">
                    <TextBlock>Your name and photo.</TextBlock>
                </Tab>
                <Tab Label="Billing" Icon="Lucide.CreditCard">
                    <TextBlock>Plan and invoices.</TextBlock>
                </Tab>
                <Tab Label="Security" Icon="Lucide.ShieldCheck">
                    <TextBlock>Password and two-factor sign-in.</TextBlock>
                </Tab>
            </Tabs>
            <Row Gap="2">
                <Button Href="@($"{_path}?tab=billing")" Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Link to Billing</Button>
            </Row>
        </Stack>
    </Example>

    <Example Title="Following state on interactive pages" Note="@BindNote" Code="@BindCode">
        <Stack Gap="3">
            <Tabs @bind-Selected="_plan" Label="Plan" Variant="TabsVariant.Soft" Id="plan-tabs">
                <Tab Label="Free">For trying it out.</Tab>
                <Tab Label="Pro">For small teams.</Tab>
                <Tab Label="Enterprise">For everyone else.</Tab>
            </Tabs>
            <Row Gap="2" Align="Align.Center">
                <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" OnClick='() => _plan = "enterprise"' data-testid="pick-enterprise">Pick Enterprise from C#</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Selected in C#: <strong data-testid="plan">@(_plan ?? "(default)")</strong></TextBlock>
            </Row>
        </Stack>
    </Example>

    <Example Title="Forms keep their input" Note="All panels are on the page, so text typed in one tab is still there after switching, and one form can span several tabs." Code="@FormCode">
        <Tabs Label="Profile form">
            <Tab Label="Name"><input class="ib-field-input" style="max-width:20rem" placeholder="Type something, then switch tabs" aria-label="Name" /></Tab>
            <Tab Label="Address"><input class="ib-field-input" style="max-width:20rem" placeholder="Street" aria-label="Street" /></Tab>
        </Tabs>
    </Example>

</Stack>

@code {
    // "static" or "interactive", so the link tabs stay in the current mode.
    private string Mode => Navigation.ToBaseRelativePath(Navigation.Uri).Split('/', '?')[0];

    private const string VerticalCode =
        """
        <Tabs Orientation="Orientation.Vertical" Label="Project settings">
            <Tab Label="General" Icon="Lucide.Settings">...</Tab>
            <Tab Label="Members" Icon="Lucide.UsersRound" Badge="4">...</Tab>
            <Tab Label="Integrations" Icon="Lucide.Plug">...</Tab>
        </Tabs>
        """;

    private const string LinksCode =
        """
        <Tabs Label="Settings">
            <TabLink Href="settings/profile" Label="Profile" Icon="Lucide.User" />
            <TabLink Href="settings/billing" Label="Billing" />
            <TabLink Href="settings/security" Label="Security" />
        </Tabs>
        """;

    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string? _plan;
    private string _path = "";

    protected override void OnInitialized() => _path = new Uri(Navigation.Uri).AbsolutePath.TrimStart('/');

    private string BindNote => RendererInfo.IsInteractive
        ? "Pick a tab, then use the button: C# and the page stay in step."
        : "On this static page the tabs still switch; switch to Interactive to see C# follow along.";

    private const string VariantsCode =
        """
        <Tabs Label="Project">
            <Tab Label="Overview" Icon="Lucide.LayoutDashboard">...</Tab>
            <Tab Label="Activity" Badge="3">...</Tab>
            <Tab Label="Archive" Disabled="true">...</Tab>
        </Tabs>

        <Tabs Label="Project" Variant="TabsVariant.Segmented">...</Tabs>
        """;

    private const string SizesCode =
        """
        <Tabs Label="Plan" Size="ControlSize.Sm" Variant="TabsVariant.Segmented" FullWidth>...</Tabs>
        """;

    private const string UrlCode =
        """
        <Tabs Label="Account" QueryKey="tab">
            <Tab Label="Profile">...</Tab>
            <Tab Label="Billing">...</Tab>   <!-- ?tab=billing -->
        </Tabs>
        """;

    private const string BindCode =
        """
        <Tabs Label="Plan" @bind-Selected="plan">
            <Tab Label="Free">...</Tab>
            <Tab Label="Pro">...</Tab>
        </Tabs>
        """;

    private const string FormCode =
        """
        <Tabs Label="Details">
            <Tab Label="Name"><TextField ... /></Tab>
            <Tab Label="Address"><TextField ... /></Tab>
        </Tabs>
        """;
}
