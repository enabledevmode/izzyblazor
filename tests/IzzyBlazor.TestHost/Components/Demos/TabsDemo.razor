@* Tabs. Every example also works with JavaScript off. *@

<Stack Gap="8">

    <Example Title="Variants" Note="Line (the default), Soft and Segmented. With JavaScript off each tab is a radio button and CSS shows its panel, so switching is instant and arrow keys work." Code="@VariantsCode">
        <Stack Gap="6">
            @foreach (var variant in Enum.GetValues<TabsVariant>())
            {
                <Stack Gap="2">
                    <TextBlock As="span" Class="host-label">@variant</TextBlock>
                    <Tabs Variant="variant" Label="@($"{variant} example")" Id="@($"tabs-{variant.ToString().ToLowerInvariant()}")">
                        <Tab Label="Overview" Icon="Lucide.LayoutDashboard">
                            <TextBlock>Everything at a glance.</TextBlock>
                        </Tab>
                        <Tab Label="Activity" Badge="3">
                            <TextBlock>Three new events since yesterday.</TextBlock>
                        </Tab>
                        <Tab Label="Settings" Icon="Lucide.Settings">
                            <TextBlock>Preferences for this project.</TextBlock>
                        </Tab>
                        <Tab Label="Archive" Disabled="true">Not yet.</Tab>
                    </Tabs>
                </Stack>
            }
        </Stack>
    </Example>

    <Example Title="Sizes and full width" Note="Size matches buttons and fields. FullWidth stretches the tabs to share the width, like Button FullWidth." Code="@SizesCode">
        <Stack Gap="6">
            @foreach (var size in Enum.GetValues<ControlSize>())
            {
                <Tabs Size="size" Variant="TabsVariant.Segmented" FullWidth Label="@($"Size {size}")">
                    <Tab Label="Day">Today's numbers.</Tab>
                    <Tab Label="Week">This week's numbers.</Tab>
                    <Tab Label="Month">This month's numbers.</Tab>
                </Tabs>
            }
        </Stack>
    </Example>

    <Example Title="In the URL" Note="QueryKey keeps the selected tab in the query string: a link to ?tab=billing opens Billing, and with JavaScript switching tabs updates the address so it can be shared." Code="@UrlCode">
        <Stack Gap="3">
            <Tabs QueryKey="tab" Label="Account" Id="account-tabs">
                <Tab Label="Profile" Icon="Lucide.User">
                    <TextBlock>Your name and photo.</TextBlock>
                </Tab>
                <Tab Label="Billing" Icon="Lucide.CreditCard">
                    <TextBlock>Plan and invoices.</TextBlock>
                </Tab>
                <Tab Label="Security" Icon="Lucide.Shield">
                    <TextBlock>Password and two-factor sign-in.</TextBlock>
                </Tab>
            </Tabs>
            <Row Gap="2">
                <LinkButton Href="@($"{_path}?tab=billing")" Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Link to Billing</LinkButton>
            </Row>
        </Stack>
    </Example>

    <Example Title="Following state on interactive pages" Note="@BindNote" Code="@BindCode">
        <Stack Gap="3">
            <Tabs @bind-Selected="_plan" Label="Plan" Variant="TabsVariant.Soft" Id="plan-tabs">
                <Tab Label="Free">For trying it out.</Tab>
                <Tab Label="Pro">For small teams.</Tab>
                <Tab Label="Enterprise">For everyone else.</Tab>
            </Tabs>
            <Row Gap="2" Align="Align.Center">
                <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" OnClick='() => _plan = "enterprise"' data-testid="pick-enterprise">Pick Enterprise from C#</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Selected in C#: <strong data-testid="plan">@(_plan ?? "(default)")</strong></TextBlock>
            </Row>
        </Stack>
    </Example>

    <Example Title="Forms keep their input" Note="All panels are on the page, so text typed in one tab is still there after switching, and one form can span several tabs." Code="@FormCode">
        <Tabs Label="Profile form">
            <Tab Label="Name"><input class="ib-field-input" style="max-width:20rem" placeholder="Type something, then switch tabs" aria-label="Name" /></Tab>
            <Tab Label="Address"><input class="ib-field-input" style="max-width:20rem" placeholder="Street" aria-label="Street" /></Tab>
        </Tabs>
    </Example>

</Stack>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string? _plan;
    private string _path = "";

    protected override void OnInitialized() => _path = new Uri(Navigation.Uri).AbsolutePath.TrimStart('/');

    private string BindNote => RendererInfo.IsInteractive
        ? "Pick a tab, then use the button: C# and the page stay in step."
        : "On this static page the tabs still switch; switch to Interactive to see C# follow along.";

    private const string VariantsCode =
        """
        <Tabs Label="Project">
            <Tab Label="Overview" Icon="Lucide.LayoutDashboard">...</Tab>
            <Tab Label="Activity" Badge="3">...</Tab>
            <Tab Label="Archive" Disabled="true">...</Tab>
        </Tabs>

        <Tabs Variant="TabsVariant.Segmented">...</Tabs>
        """;

    private const string SizesCode =
        """
        <Tabs Size="ControlSize.Sm" Variant="TabsVariant.Segmented" FullWidth>...</Tabs>
        """;

    private const string UrlCode =
        """
        <Tabs QueryKey="tab">
            <Tab Label="Profile">...</Tab>
            <Tab Label="Billing">...</Tab>   <!-- ?tab=billing -->
        </Tabs>
        """;

    private const string BindCode =
        """
        <Tabs @bind-Selected="plan">
            <Tab Label="Free">...</Tab>
            <Tab Label="Pro">...</Tab>
        </Tabs>
        """;

    private const string FormCode =
        """
        <Tabs>
            <Tab Label="Name"><TextField ... /></Tab>
            <Tab Label="Address"><TextField ... /></Tab>
        </Tabs>
        """;
}
