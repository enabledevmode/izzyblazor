@* Stat, DescriptionList, EmptyState and Kbd. No script involved. *@

<Stack Gap="8">

    <Example Title="Stat" Note="A label, the figure, and how it changed. Up is green and down is red unless ChangeStatus says otherwise, as for response times. The arrow is hidden from screen readers; TrendLabel is read in its place." Code="@StatCode">
        <Grid Columns="new() { Base = 1, Sm = 2, Lg = 4 }" Gap="4">
            <Card><Stat Label="Revenue" Value="$48,210" Change="12%" Trend="StatTrend.Up" Description="vs last month" Icon="Lucide.DollarSign" data-testid="stat-revenue" /></Card>
            <Card><Stat Label="Active users" Value="2,340" Change="3.1%" Trend="StatTrend.Down" Description="vs last week" Icon="Lucide.UsersRound" /></Card>
            <Card><Stat Label="Response time" Value="182 ms" Change="24 ms" Trend="StatTrend.Down" ChangeStatus="Status.Success" Description="faster" Icon="Lucide.Timer" /></Card>
            <Card><Stat Label="Uptime" Value="99.98%" Change="0%" Trend="StatTrend.Flat" Description="30 days" Icon="Lucide.Activity" /></Card>
        </Grid>
    </Example>

    <Example Title="Stat sizes" Code="@StatSizesCode">
        <Row Gap="10" Wrap Align="Align.End">
            <Stat Size="ControlSize.Sm" Label="Orders" Value="128" Change="+8" Trend="StatTrend.Up" />
            <Stat Label="Orders" Value="128" Change="+8" Trend="StatTrend.Up" />
            <Stat Size="ControlSize.Lg" Label="Orders" Value="128" Change="+8" Trend="StatTrend.Up" />
        </Row>
    </Example>

    <Example Title="DescriptionList" Note="Terms beside their details from 640px up, the term column as wide as the longest term; stacked on phones. Divided adds lines between items." Code="@ListCode">
        <Box MaxWidth="40.Rem">
            <Card Title="Invoice INV-1042">
                <DescriptionList Divided data-testid="dl-invoice">
                    <DescriptionItem Term="Status"><Badge Status="Status.Success" Dot>Paid</Badge></DescriptionItem>
                    <DescriptionItem Term="Customer">Grace Hopper</DescriptionItem>
                    <DescriptionItem Term="Email">grace@example.com</DescriptionItem>
                    <DescriptionItem Term="Amount">$1,280.00</DescriptionItem>
                    <DescriptionItem Term="Billing address">1 Navy Yard, Arlington, VA 22202</DescriptionItem>
                </DescriptionList>
            </Card>
        </Box>
    </Example>

    <Example Title="Vertical, in columns" Note="Vertical puts each term above its detail; Columns flows the items into up to four columns from 640px up." Code="@ColumnsCode">
        <DescriptionList Orientation="Orientation.Vertical" Columns="3">
            <DescriptionItem Term="Plan">Pro, yearly</DescriptionItem>
            <DescriptionItem Term="Seats">12 of 20</DescriptionItem>
            <DescriptionItem Term="Renews">March 3, 2027</DescriptionItem>
            <DescriptionItem Term="Region">US East</DescriptionItem>
            <DescriptionItem Term="Created">Oct 12, 2026</DescriptionItem>
            <DescriptionItem Term="Owner">Ada Lovelace</DescriptionItem>
        </DescriptionList>
    </Example>

    <Example Title="EmptyState" Note="An icon, a title, why it's empty, and the action that fills it. Bordered draws a dashed outline for an empty area inside a page." Code="@EmptyCode">
        <Grid Columns="new() { Base = 1, Md = 2 }" Gap="4">
            <EmptyState Bordered Icon="Lucide.Inbox" Title="No invoices yet" Description="Invoices you send appear here, with their payment status." data-testid="empty-invoices">
                <EmptyStateActions>
                    <Button Href="static/display" StartIcon="Lucide.Plus">New invoice</Button>
                </EmptyStateActions>
            </EmptyState>
            <EmptyState Bordered Size="ControlSize.Sm" Icon="Lucide.SearchX" Title="No results for “quarterly”" Description="Try a different word, or clear the filters.">
                <EmptyStateActions>
                    <Button Href="static/display" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Size="ControlSize.Sm">Clear filters</Button>
                </EmptyStateActions>
            </EmptyState>
        </Grid>
    </Example>

    <Example Title="Kbd" Note="A key, or a combination with Keys. Sized in em, so it fits the text around it." Code="@KbdCode">
        <Stack Gap="3">
            <TextBlock>Press <Kbd>Esc</Kbd> to close the dialog.</TextBlock>
            <TextBlock>Search with <Kbd Keys="Ctrl+K" data-testid="kbd-combo" />, or open the command list with <Kbd Keys="Ctrl+Shift+P" />.</TextBlock>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">Zoom in with <Kbd Keys="Ctrl++" />.</TextBlock>
        </Stack>
    </Example>

    <Example Title="Image and VideoEmbed" Note="Image loads lazily and keeps its space: a Ratio gives it a shape it fills (Cover) or fits (Contain). VideoEmbed is a poster that links to the video on YouTube; with JavaScript, clicking plays it in place from youtube-nocookie.com, so YouTube loads only when wanted. With no YouTubeId it keeps the space for a video that isn't out yet." Code="@MediaCode">
        <Grid Columns="new() { Base = 1, Md = 2 }" Gap="4">
            <Image Src="img/avatar-1.jpg" Alt="A portrait, cropped to 16:9" Ratio="16 / 9.0" Radius="Radius.Lg" Caption="Ratio 16:9, Cover" />
            <Image Src="img/avatar-2.jpg" Alt="A portrait, fitted into 16:9" Ratio="16 / 9.0" Fit="ImageFit.Contain" Radius="Radius.Lg" Bg="Color.SurfaceContainer" Caption="Ratio 16:9, Contain" />
            <VideoEmbed YouTubeId="aqz-KE-bpKQ" Label="Big Buck Bunny" />
            <VideoEmbed Label="Deploying to Azure" EmptyText="Coming Friday" />
        </Grid>
    </Example>

    <Example Title="Timeline" Note="A commit log, an order's history or a changelog. Each item has a marker on a rail, a title (a link with Href), a time and any content. Icon and Status change the marker; Current marks where things stand, with aria-current." Code="@TimelineCode">
        <Grid Columns="new() { Base = 1, Md = 2 }" Gap="8">
            <Timeline>
                <TimelineItem Title="Add a full-bleed Section" Href="#" Time="2 hours ago" DateTime="2026-10-13T20:00Z" Current>
                    <Row Gap="3" Align="Align.Center" Wrap>
                        <Code>93c85d4</Code>
                        <Anchor Href="#">Watch from here</Anchor>
                        <Anchor Href="#">Code at this step</Anchor>
                    </Row>
                </TimelineItem>
                <TimelineItem Title="List and Prose" Href="#" Time="Yesterday" DateTime="2026-10-12">
                    <Code>010d08e</Code>
                </TimelineItem>
                <TimelineItem Title="Syntax highlighting" Href="#" Time="Oct 10" DateTime="2026-10-10">
                    <Code>933584a</Code>
                </TimelineItem>
            </Timeline>
            <Timeline>
                <TimelineItem Title="Delivered" Time="Oct 13, 2:14 PM" Icon="Lucide.PackageCheck" Status="Status.Success">Left at the front door.</TimelineItem>
                <TimelineItem Title="Out for delivery" Time="Oct 13, 8:02 AM" Icon="Lucide.Truck" />
                <TimelineItem Title="Delayed in transit" Time="Oct 12" Icon="Lucide.TriangleAlert" Status="Status.Warning">Weather at the regional hub.</TimelineItem>
                <TimelineItem Title="Order placed" Time="Oct 10" Icon="Lucide.ShoppingCart" />
            </Timeline>
        </Grid>
    </Example>

</Stack>

