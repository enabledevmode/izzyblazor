@* Spinner, Progress, Skeleton. Pure CSS; Progress values come from the server. *@

<Stack Gap="8">

    <Example Title="Spinner" Note="Sized like an icon, so it matches the text beside it. Screen readers hear its Label." Code="@SpinnerCode">
        <Row Gap="6" Align="Align.Center" Wrap>
            <Spinner Size="IconSize.Sm" />
            <Spinner />
            <Spinner Size="IconSize.Lg" Color="Color.Primary" />
            <Spinner Size="IconSize.Xl2" Color="Color.Primary" Label="Loading orders" data-testid="spinner-xl" />
            <Row Gap="2" Align="Align.Center">
                <Spinner Color="Color.Primary" />
                <TextBlock As="span" Color="Color.Muted">Syncing&hellip;</TextBlock>
            </Row>
        </Row>
    </Example>

    <Example Title="Progress" Note="@ProgressNote" Code="@ProgressCode">
        <Stack Gap="5" MaxWidth="28.Rem">
            <Progress Value="_upload" Label="Uploading" ShowValue data-testid="progress-upload" />
            <Progress Value="3" Max="5" Label="Files" ValueText="3 of 5 files" Color="Color.Success" />
            <Progress Value="80" Size="ControlSize.Sm" Color="Color.Warning" aria-label="Storage used" />
            <Progress Label="Preparing export" Size="ControlSize.Lg" data-testid="progress-indeterminate" />
            @if (RendererInfo.IsInteractive)
            {
                <Row Gap="2">
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => _upload = Math.Max(0, _upload - 20)">Less</Button>
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => _upload = Math.Min(100, _upload + 20)">More</Button>
                </Row>
            }
        </Stack>
    </Example>

    <Example Title="Skeleton" Note="Placeholders in the shape of what's loading. Loaded swaps in the real content." Code="@SkeletonCode">
        <Row Gap="4" Wrap Align="Align.Stretch">
            <Card Grow Basis="18.Rem" data-testid="skeleton-card">
                <Stack Gap="4">
                    <Row Gap="3" Align="Align.Center">
                        <Skeleton Circle />
                        <Skeleton Lines="2" Grow />
                    </Row>
                    <Skeleton Height="Length.Rem(8)" />
                    <Skeleton Lines="3" />
                </Stack>
            </Card>
            <Card Grow Basis="18.Rem" Title="Loaded">
                <Skeleton Loaded Lines="3">
                    <TextBlock>Static pages, fast first paint, and interactivity where you need it.</TextBlock>
                </Skeleton>
            </Card>
        </Row>
    </Example>

</Stack>

@code {
    private double _upload = 40;

    private string ProgressNote => RendererInfo.IsInteractive
        ? "Value comes from C#; the buttons change it. Leave Value out for a bar that sweeps."
        : "Rendered on the server, so it shows on static pages. Leave Value out for a bar that sweeps.";

    private const string SpinnerCode =
        """
        <Spinner />
        <Spinner Size="IconSize.Xl2" Color="Color.Primary" Label="Loading orders" />
        """;

    private const string ProgressCode =
        """
        <Progress Value="_upload" Label="Uploading" ShowValue />
        <Progress Value="3" Max="5" Label="Files" ValueText="3 of 5 files" Color="Color.Success" />
        <Progress Label="Preparing export" />   @* indeterminate *@
        """;

    private const string SkeletonCode =
        """
        <Skeleton Circle />
        <Skeleton Lines="2" />
        <Skeleton Height="Length.Rem(8)" />
        <Skeleton Loaded="_order is not null" Lines="3">@_order.Summary</Skeleton>
        """;
}
