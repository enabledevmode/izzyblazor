@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation

@* IzzyTheme: one brand color, the whole accent derived from it. The page's own <head> gets the
   IzzyTheme through HeadContent, so everything here (and the header and sidebar) takes the color. *@

@if (Palette is not null)
{
    <HeadContent><IzzyTheme Brand="@Chosen" /></HeadContent>
}

<Stack Gap="8">
    <Example Title="Color scheme switch" Note="Menu (the default): an icon button showing the page's scheme, with System, Light and Dark. Toggle: one button that flips light and dark. Segmented: all three side by side, for a settings page. The choice is a cookie IzzyTheme reads, so pages arrive in it; with JavaScript off each option is a link through app.MapIzzyBlazor()." Code="@SwitchCode">
        <Row Gap="6" Align="Align.Center" Wrap>
            <Stack Gap="2"><TextBlock As="span" Class="host-label">Menu</TextBlock><ColorSchemeSwitch /></Stack>
            <Stack Gap="2"><TextBlock As="span" Class="host-label">Toggle</TextBlock><ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Toggle" /></Stack>
            <Stack Gap="2"><TextBlock As="span" Class="host-label">Segmented</TextBlock><ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Segmented" /></Stack>
        </Row>
    </Example>

    @if (RendererInfo.IsInteractive)
    {
        <Example Title="Bound from C#" Note="@BoundNote">
            <Row Gap="3" Align="Align.Center" Wrap>
                <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Segmented" @bind-Value="_scheme" id="bound-scheme" />
                <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" OnClick="() => _scheme = ColorScheme.Dark" id="set-dark">Dark from C#</Button>
                <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" OnClick="() => _scheme = ColorScheme.Auto" id="set-system">System from C#</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted" id="bound-value">Value: @_scheme</TextBlock>
            </Row>
        </Example>
    }

    <Example Title="Your brand color" Note="Pick a color: the server derives the fill, the text on it, the accent as text and the soft tint, in light and dark, each pair checked for 4.5:1. A light color gets dark text; a dark one is lifted in dark mode." Code="@ThemeCode">
        <Stack Gap="5">
            @* The library's ColorPicker in a plain GET form: its name posts ?brand=#hex. *@
            <form method="get" class="host-brand-form">
                <Box Width="Length.Rem(20)" MaxWidth="Length.Full">
                    <ColorPicker @bind-Value="_pick" name="brand" Label="Brand" Presets="PresetHexes" Size="ControlSize.Sm" />
                </Box>
                <Row Gap="3" Align="Align.Center">
                    <Button Type="ButtonType.Submit" Size="ControlSize.Sm">Apply</Button>
                    <a href="@Navigation.GetUriWithQueryParameter("brand", (string?)null)" class="host-label">Reset</a>
                </Row>
            </form>

            @if (Palette is { } p)
            {
                <Grid Columns="new() { Base = 1, Md = 2 }" Gap="4">
                    @foreach (var (mode, fill, on, text, soft) in new[] { ("Light", p.Fill, p.OnFill, p.Text, p.Soft), ("Dark", p.DarkFill, p.DarkOnFill, p.DarkText, p.DarkSoft) })
                    {
                        <Stack Gap="2">
                            <TextBlock As="span" Class="host-label">@mode</TextBlock>
                            <Row Gap="2" Wrap>
                                <code class="host-chip" style="background:@fill;color:@on">fill @fill</code>
                                <code class="host-chip" style="background:@soft;color:@text">text @text on soft @soft</code>
                            </Row>
                        </Stack>
                    }
                </Grid>
            }

            <Grid Columns="new() { Base = 1, Lg = 2 }" Gap="4">
                <Box ColorScheme="ColorScheme.Light" Padding="5" Radius="Radius.Lg">@Sample("brand-light")</Box>
                <Box ColorScheme="ColorScheme.Dark" Padding="5" Radius="Radius.Lg">@Sample("brand-dark")</Box>
            </Grid>
        </Stack>
    </Example>
</Stack>

@code {
    [SupplyParameterFromQuery(Name = "brand")] public string? Brand { get; set; }

    private BrandPalette? Palette;
    private string Chosen => Palette is null ? "#2563eb" : Brand!.Trim();

    private string? _pick;

    private ColorScheme _scheme;

    private const string BoundNote = "On interactive pages @bind-Value follows the user's choice, and setting the value from C# applies it to the page, the cookie and other tabs.";

    private static IEnumerable<string> PresetHexes => Presets.Select(p => p.Hex);

    protected override void OnParametersSet()
    {
        try
        {
            Palette = string.IsNullOrWhiteSpace(Brand) ? null : BrandPalette.From(Brand);
        }
        catch (ArgumentException)
        {
            Palette = null;
        }

        _pick = Chosen;
    }

    private static readonly (string Name, string Hex)[] Presets =
    [
        ("Green", "#0a7d5a"), ("Purple", "#7c3aed"), ("Red", "#e11d48"), ("Navy", "#1e3a8a"),
        ("Sky", "#0ea5e9"), ("Yellow", "#facc15"), ("Orange", "#ff6a00"), ("Black", "#000000"),
    ];

    public enum Plan { Starter, Team, Enterprise }

    public sealed class SampleModel
    {
        [Display(Name = "Email me updates")] public bool Updates { get; set; } = true;
        [Display(Name = "Remember this device")] public bool Remember { get; set; } = true;
        public int Volume { get; set; } = 60;
        public Plan Plan { get; set; } = Plan.Team;
    }

    private readonly Dictionary<string, SampleModel> _models = new() { ["brand-light"] = new(), ["brand-dark"] = new() };

    private RenderFragment Sample(string name) =>
        @<Stack Gap="4">
            <Row Gap="2" Wrap>
                <Button>Save</Button>
                <Button Variant="ButtonVariant.Soft">Soft</Button>
                <Button Variant="ButtonVariant.Outline">Outline</Button>
                <Button Variant="ButtonVariant.Ghost">Ghost</Button>
            </Row>
            <Tabs Label="@($"Sample tabs {name}")">
                <Tab Label="Overview">Text with a <Anchor Href="static/brand">link in the accent</Anchor>.</Tab>
                <Tab Label="Activity" Badge="3">Activity.</Tab>
            </Tabs>
            <Form Model="_models[name]" FormName="@name" OnValidSubmit="() => { }">
                <Switch @bind-Value="_models[name].Updates" />
                <Checkbox @bind-Value="_models[name].Remember" />
                <RadioGroup @bind-Value="_models[name].Plan" Orientation="Orientation.Horizontal" />
                <Slider @bind-Value="_models[name].Volume" ShowValue />
            </Form>
            <Row Gap="3" Align="Align.Center" Wrap>
                <Badge Accent="Accent.Primary">Primary</Badge>
                <Badge Accent="Accent.Primary" Variant="BadgeVariant.Solid">Solid</Badge>
                <Pagination PageCount="5" Page="2" Size="ControlSize.Sm" Label="@($"Sample pages {name}")" />
            </Row>
            <Progress Value="64" Label="Upload" />
        </Stack>;

    private const string SwitchCode =
        """
        <ColorSchemeSwitch />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Toggle" />
        <ColorSchemeSwitch Variant="ColorSchemeSwitchVariant.Segmented" IconOnly />
        """;

    private const string ThemeCode =
        """
        @* App.razor, in <head> *@
        <IzzyTheme Brand="#0a7d5a" />
        """;
}
