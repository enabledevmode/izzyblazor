@* Anchor and Code. *@

<Stack Gap="8">

    <Example Title="Anchor" Note="Underlined by default, which is clearest in running text. External opens a new tab, with an icon and a note for screen readers." Code="@AnchorCode">
        <Stack Gap="3">
            <TextBlock>Read the <Anchor Href="static/anchor">getting started guide</Anchor> before you begin.</TextBlock>
            <TextBlock>The source is on <Anchor Href="https://github.com/" External data-testid="external">GitHub</Anchor>.</TextBlock>
            <TextBlock Color="Color.Muted" Size="TextSize.Sm">Muted text with an <Anchor Href="static/anchor" Inherit>inherited-color link</Anchor>.</TextBlock>
            <Row Gap="4"><Anchor Href="static/anchor" Underline="AnchorUnderline.Hover">Underline on hover</Anchor><Anchor Href="static/anchor" Underline="AnchorUnderline.None">No underline</Anchor></Row>
        </Stack>
    </Example>

    <Example Title="Code" Note="Inline code for names in text, and blocks that scroll sideways. A block's copy button appears only with JavaScript, since copying needs it." Code="@CodeCode">
        <Stack Gap="4">
            <TextBlock>Call <Code>AddIzzyBlazor()</Code> in <Code>Program.cs</Code>.</TextBlock>
            <Code Block Language="bash" data-testid="code-block">@Install</Code>
            <Code Block Language="razor">@Snippet</Code>
        </Stack>
    </Example>

</Stack>

@code {
    private const string Install = "dotnet add package IzzyBlazor";

    private const string Snippet =
        """
        <Table Items="orders" PageSize="10">
            <PropertyColumn Property="o => o.Customer" Sortable />
            <PropertyColumn Property="o => o.Total" Format="C" Sortable />
        </Table>
        """;

    private const string AnchorCode =
        """
        Read the <Anchor Href="/docs">guide</Anchor>.
        <Anchor Href="https://github.com/..." External>GitHub</Anchor>
        <Anchor Href="..." Inherit>...</Anchor>
        """;

    private const string CodeCode =
        """
        Call <Code>AddIzzyBlazor()</Code> in <Code>Program.cs</Code>.
        <Code Block Language="bash">@install</Code>
        """;
}
