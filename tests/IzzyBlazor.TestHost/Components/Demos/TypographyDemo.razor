<Stack Gap="8">

    <Example Title="Headings" Note="Level sets the element and a default size. Bold, tight and balanced by default." Code="@HeadingsCode">
        <Stack Gap="3">
            @foreach (var level in Enumerable.Range(1, 6))
            {
                <Heading Level="level">Heading level @level</Heading>
            }
        </Stack>
    </Example>

    <Example Title="Size separate from level" Note="An h2 for the document outline that looks like a small label, and a responsive display heading." Code="@SizeCode">
        <Stack Gap="4">
            <Heading Level="2" Size="TextSize.Sm" Color="Color.Muted" Transform="TextTransform.Uppercase" LetterSpacing="LetterSpacing.Wider">Section label</Heading>
            <Heading Level="1" Size="new() { Base = TextSize.Xl3, Md = TextSize.Xl5 }" LetterSpacing="LetterSpacing.Tight">Responsive display heading</Heading>
        </Stack>
    </Example>

    <Example Title="Size scale" Code="@ScaleCode">
        <Stack Gap="2">
            @foreach (var size in Enum.GetValues<TextSize>())
            {
                <Row Gap="4" Align="Align.Baseline">
                    <TextBlock As="span" Size="TextSize.Xs" Color="Color.Muted" Width="3.Rem" TabularNums>@size</TextBlock>
                    <TextBlock As="span" Size="size" Truncate>The quick brown fox</TextBlock>
                </Row>
            }
        </Stack>
    </Example>

    <Example Title="Weight, family, italic, decoration" Code="@StyleCode">
        <Row Gap="6" Wrap>
            @foreach (var weight in Enum.GetValues<FontWeight>())
            {
                <TextBlock As="span" Weight="weight">@weight</TextBlock>
            }
        </Row>
        <Row Gap="6" Wrap MarginY="4">
            <TextBlock As="span" Family="FontFamily.Sans">Sans</TextBlock>
            <TextBlock As="span" Family="FontFamily.Serif">Serif</TextBlock>
            <TextBlock As="span" Family="FontFamily.Mono">Mono</TextBlock>
            <TextBlock As="span" Italic>Italic</TextBlock>
            <TextBlock As="span" Decoration="TextDecoration.Underline">Underline</TextBlock>
            <TextBlock As="span" Decoration="TextDecoration.LineThrough" Color="Color.Muted">Line through</TextBlock>
        </Row>
    </Example>

    <Example Title="Alignment" Note="Centered on small screens, start-aligned from Md." Code="@AlignCode">
        <TextBlock Align="new() { Base = TextAlign.Center, Md = TextAlign.Start }" MaxWidth="Length.Prose">
            Responsive alignment is common for hero text: centered on phones, left-aligned on wider screens.
        </TextBlock>
    </Example>

    <Example Title="Truncate and line clamp" Note="One line with an ellipsis, or at most two lines." Code="@ClampCode">
        <Stack Gap="4" MaxWidth="24.Rem">
            <TextBlock Truncate>Truncate keeps a long title like this one on a single line and ends it with an ellipsis.</TextBlock>
            <TextBlock LineClamp="2" Color="Color.Muted">
                LineClamp limits a description to a set number of lines. Anything beyond the second line is
                hidden and the last visible line ends with an ellipsis, which keeps card grids even.
            </TextBlock>
        </Stack>
    </Example>

    <Example Title="Readable paragraphs" Note="Prose width, relaxed line height and pretty wrapping (no lone last word)." Code="@ProseCode">
        <TextBlock MaxWidth="Length.Prose" LineHeight="LineHeight.Relaxed" Wrap="TextWrap.Pretty" Size="TextSize.Lg">
            Good body text needs three things: a line length the eye can follow, enough space between lines,
            and wrapping that does not leave a single word stranded at the end. All three are one prop each.
        </TextBlock>
    </Example>

    <Example Title="Text emphasis" Note="Four levels of text, all readable in light and dark mode." Code="@EmphasisCode">
        <Stack Gap="1">
            <TextBlock>OnSurface (default): primary text</TextBlock>
            <TextBlock Color="Color.Muted">Muted: descriptions and metadata</TextBlock>
            <TextBlock Color="Color.Subtle">Subtle: captions, hints and placeholders</TextBlock>
            <TextBlock Color="Color.Disabled">Disabled: text of disabled controls</TextBlock>
        </Stack>
    </Example>

    <Example Title="Accent text" Note="The *Text tokens are tuned for at least 4.5:1 contrast on surfaces; the plain accents are tuned as backgrounds." Code="@AccentCode">
        <Row Gap="6" Wrap>
            <TextBlock As="span" Color="Color.PrimaryText" Weight="FontWeight.Medium">PrimaryText</TextBlock>
            <TextBlock As="span" Color="Color.SuccessText" Weight="FontWeight.Medium">SuccessText</TextBlock>
            <TextBlock As="span" Color="Color.WarningText" Weight="FontWeight.Medium">WarningText</TextBlock>
            <TextBlock As="span" Color="Color.DangerText" Weight="FontWeight.Medium">DangerText</TextBlock>
            <TextBlock As="span" Color="Color.InfoText" Weight="FontWeight.Medium">InfoText</TextBlock>
        </Row>
    </Example>

    <Example Title="Tabular numbers" Note="Equal-width digits line up in columns." Code="@NumbersCode">
        <Row Gap="8">
            <Stack>
                <TextBlock Weight="FontWeight.Semibold" Size="TextSize.Sm">Default</TextBlock>
                <TextBlock>1,111.11</TextBlock>
                <TextBlock>8,888.88</TextBlock>
            </Stack>
            <Stack>
                <TextBlock Weight="FontWeight.Semibold" Size="TextSize.Sm">TabularNums</TextBlock>
                <TextBlock TabularNums>1,111.11</TextBlock>
                <TextBlock TabularNums>8,888.88</TextBlock>
            </Stack>
        </Row>
    </Example>

</Stack>

@code {
    private const string HeadingsCode =
        """
        <Heading Level="1">Heading level 1</Heading>
        <Heading Level="2">Heading level 2</Heading>
        """;

    private const string SizeCode =
        """
        <Heading Level="2" Size="TextSize.Sm" Color="Color.Muted"
                 Transform="TextTransform.Uppercase" LetterSpacing="LetterSpacing.Wider">Section label</Heading>
        <Heading Level="1" Size="new() { Base = TextSize.Xl3, Md = TextSize.Xl5 }">...</Heading>
        """;

    private const string ScaleCode = """<TextBlock Size="TextSize.Xl2">...</TextBlock>""";

    private const string StyleCode =
        """
        <TextBlock Weight="FontWeight.Semibold">...</TextBlock>
        <TextBlock Family="FontFamily.Mono" Italic Decoration="TextDecoration.Underline">...</TextBlock>
        """;

    private const string AlignCode =
        """<TextBlock Align="new() { Base = TextAlign.Center, Md = TextAlign.Start }">...</TextBlock>""";

    private const string ClampCode =
        """
        <TextBlock Truncate>...</TextBlock>
        <TextBlock LineClamp="2">...</TextBlock>
        """;

    private const string ProseCode =
        """<TextBlock MaxWidth="Length.Prose" LineHeight="LineHeight.Relaxed" Wrap="TextWrap.Pretty">...</TextBlock>""";

    private const string EmphasisCode =
        """
        <TextBlock>Primary text</TextBlock>
        <TextBlock Color="Color.Muted">Secondary text</TextBlock>
        <TextBlock Color="Color.Subtle">Caption</TextBlock>
        """;

    private const string AccentCode =
        """<TextBlock Color="Color.DangerText">Payment failed</TextBlock>""";

    private const string NumbersCode = """<TextBlock TabularNums>8,888.88</TextBlock>""";
}
