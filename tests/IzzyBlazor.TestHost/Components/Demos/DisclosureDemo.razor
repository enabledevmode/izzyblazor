@* Accordion, AccordionItem and Collapsible. Every example also works with JavaScript off. *@

<Stack Gap="8">

    <Example Title="Variants" Note="Separated (the default), Bordered and Flush. Each item is a native details element." Code="@VariantsCode">
        <Stack Gap="6">
            @foreach (var variant in Enum.GetValues<AccordionVariant>())
            {
                <Stack Gap="2">
                    <TextBlock As="span" Class="host-label">@variant</TextBlock>
                    <Accordion Variant="variant">
                        <AccordionItem Title="What is static SSR?" Icon="Lucide.Server">
                            The server renders HTML and sends it. No SignalR circuit and no WebAssembly.
                        </AccordionItem>
                        <AccordionItem Title="Does this accordion need JavaScript?" Open="true">
                            No. It is built on details and summary, so the browser opens and closes it.
                        </AccordionItem>
                        <AccordionItem Title="Can it animate?">
                            Yes, in browsers that support interpolate-size, with no script.
                        </AccordionItem>
                    </Accordion>
                </Stack>
            }
        </Stack>
    </Example>

    <Example Title="One open at a time" Note="Exclusive gives every item the same name, so the browser closes the others. No script involved." Code="@ExclusiveCode">
        <Accordion Exclusive Variant="AccordionVariant.Bordered">
            <AccordionItem Title="Shipping" Open="true">Orders ship within two business days.</AccordionItem>
            <AccordionItem Title="Returns">Return anything within 30 days.</AccordionItem>
            <AccordionItem Title="Warranty">Two years on all hardware.</AccordionItem>
            <AccordionItem Title="Gift cards (coming soon)" Disabled="true">Not yet.</AccordionItem>
        </Accordion>
    </Example>

    <Example Title="Following state on interactive pages" Note="@BindNote" Code="@BindCode">
        <Stack Gap="3">
            <Accordion>
                <AccordionItem Title="Release notes" @bind-Open="_notesOpen">
                    Version 0.1 adds disclosures and overlays.
                </AccordionItem>
            </Accordion>
            <Row Gap="2" Align="Align.Center">
                <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" OnClick="() => _notesOpen = !_notesOpen">Toggle from C#</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Open in C#: <strong data-testid="notes-open">@_notesOpen</strong></TextBlock>
            </Row>
        </Stack>
    </Example>

    <Example Title="Sizes" Note="Size scales the title and the content spacing together: Sm for sidebars, Lg for FAQ pages." Code="@SizesCode">
        <Stack Gap="6">
            @foreach (var size in Enum.GetValues<ControlSize>())
            {
                <Stack Gap="2">
                    <TextBlock As="span" Class="host-label">@size</TextBlock>
                    <Accordion Size="size" Variant="AccordionVariant.Bordered">
                        <AccordionItem Title="Billing" Icon="Lucide.CreditCard" Open="true">
                            Invoices go out on the first of the month.
                        </AccordionItem>
                        <AccordionItem Title="Security">Two-factor sign-in is on.</AccordionItem>
                    </Accordion>
                </Stack>
            }
        </Stack>
    </Example>

    <Example Title="Rich content" Note="The content is a column with a gap, so paragraphs, lists and buttons need no wrapper. ContentPadding=&quot;0&quot; lets a table run edge to edge." Code="@ContentCode">
        <Accordion Variant="AccordionVariant.Bordered">
            <AccordionItem Title="Getting started" Open="true">
                <TextBlock>Create a project, then invite your team.</TextBlock>
                <TextBlock Color="Color.Muted" Size="TextSize.Sm">You can change these settings later.</TextBlock>
                <Row Gap="2">
                    <Button Size="ControlSize.Sm">Create project</Button>
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral">Read the guide</Button>
                </Row>
            </AccordionItem>
            <AccordionItem Title="Usage this month" ContentPadding="0" Open="true">
                <table class="host-table">
                    <thead><tr><th>Resource</th><th>Used</th><th>Limit</th></tr></thead>
                    <tbody>
                        <tr><td>Builds</td><td>132</td><td>500</td></tr>
                        <tr><td>Storage</td><td>4.1 GB</td><td>10 GB</td></tr>
                    </tbody>
                </table>
            </AccordionItem>
        </Accordion>
    </Example>

    <Example Title="Collapsible" Note="One disclosure without the accordion styling, for 'show more' and advanced settings." Code="@CollapsibleCode">
        <Stack Gap="3">
            <Collapsible Label="Advanced options">
                <TextBlock Color="Color.Muted">Hidden until you ask for it.</TextBlock>
            </Collapsible>
            <Collapsible>
                <Trigger><Badge Status="Status.Info" StartIcon="Lucide.Info">Why is this free?</Badge></Trigger>
                <ChildContent><TextBlock Color="Color.Muted">Because it is open source.</TextBlock></ChildContent>
            </Collapsible>
        </Stack>
    </Example>

</Stack>

@code {
    private bool _notesOpen;

    private string BindNote => RendererInfo.IsInteractive
        ? "Open and close the item, then use the button: C# and the page stay in step."
        : "On this static page the item still opens and closes; switch to Interactive to see C# follow along.";

    private const string VariantsCode =
        """
        <Accordion Variant="AccordionVariant.Bordered">
            <AccordionItem Title="What is static SSR?" Icon="Lucide.Server">...</AccordionItem>
            <AccordionItem Title="Does this need JavaScript?" Open="true">...</AccordionItem>
        </Accordion>
        """;

    private const string ExclusiveCode =
        """
        <Accordion Exclusive>
            <AccordionItem Title="Shipping" Open="true">...</AccordionItem>
            <AccordionItem Title="Returns">...</AccordionItem>
            <AccordionItem Title="Gift cards" Disabled="true">...</AccordionItem>
        </Accordion>
        """;

    private const string BindCode =
        """
        <AccordionItem Title="Release notes" @bind-Open="notesOpen">...</AccordionItem>
        """;

    private const string SizesCode =
        """
        <Accordion Size="ControlSize.Sm">...</Accordion>
        """;

    private const string ContentCode =
        """
        <AccordionItem Title="Getting started">
            <TextBlock>Create a project, then invite your team.</TextBlock>
            <Row Gap="2"><Button>Create project</Button></Row>
        </AccordionItem>
        <AccordionItem Title="Usage this month" ContentPadding="0">
            <table>...</table>
        </AccordionItem>
        """;

    private const string CollapsibleCode =
        """
        <Collapsible Label="Advanced options">...</Collapsible>

        <Collapsible>
            <Trigger><Badge StartIcon="Lucide.Info">Why is this free?</Badge></Trigger>
            <ChildContent>...</ChildContent>
        </Collapsible>
        """;
}
