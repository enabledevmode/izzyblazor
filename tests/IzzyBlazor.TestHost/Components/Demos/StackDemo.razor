<Stack Gap="8">

    <Example Title="Stack, Row, Column" Note="Row is always horizontal and Column always vertical. Stack is the general one: vertical by default, any direction with Direction, which can change per breakpoint (next example). Setting Direction on a Row or Column is a build error, so a horizontal Column can&#39;t happen." Code="@BasicsCode">
        <Row Gap="6" Wrap Align="Align.Start">
            <Stack Gap="2">
                <Tile>Stack 1</Tile>
                <Tile>Stack 2</Tile>
                <Tile>Stack 3</Tile>
            </Stack>
            <Row Gap="2">
                <Tile>Row 1</Tile>
                <Tile>Row 2</Tile>
                <Tile>Row 3</Tile>
            </Row>
            <Column Gap="2">
                <Tile>Column 1</Tile>
                <Tile>Column 2</Tile>
            </Column>
            <Stack Direction="Direction.Row" Gap="2">
                <Tile>Stack, Direction.Row</Tile>
                <Tile>2</Tile>
            </Stack>
        </Row>
    </Example>

    <Example Title="Responsive direction" Note="Column on small screens, row from Md (768px). Resize the window." Code="@ResponsiveCode">
        <Stack Direction="new() { Base = Direction.Column, Md = Direction.Row }" Gap="4">
            <Tile Grow>One</Tile>
            <Tile Grow>Two</Tile>
            <Tile Grow>Three</Tile>
        </Stack>
    </Example>

    <Example Title="Gap" Note="A single step, or a breakpoint map." Code="@GapCode">
        <Stack Gap="4">
            @foreach (var (label, gap) in Gaps)
            {
                <Row Gap="gap" Align="Align.Center">
                    <span class="host-label">@label</span>
                    <Tile /> <Tile /> <Tile />
                </Row>
            }
        </Stack>
    </Example>

    <Example Title="Align (cross axis)" Code="@AlignCode">
        <Stack Gap="3">
            @foreach (var align in Enum.GetValues<Align>())
            {
                <Row Gap="2" Align="align" Padding="2" Bg="Color.SurfaceContainer" Radius="Radius.Sm" MinHeight="5.Rem">
                    <span class="host-label">@align</span>
                    <Tile>A</Tile>
                    <Tile Style="padding-block: 1.5rem">Tall</Tile>
                    <Tile>C</Tile>
                </Row>
            }
        </Stack>
    </Example>

    <Example Title="Justify (main axis)" Code="@JustifyCode">
        <Stack Gap="3">
            @foreach (var justify in Enum.GetValues<Justify>())
            {
                <Stack Gap="1">
                    <span class="host-label">@justify</span>
                    <Row Justify="justify" Padding="2" Bg="Color.SurfaceContainer" Radius="Radius.Sm">
                        <Tile>A</Tile>
                        <Tile>B</Tile>
                        <Tile>C</Tile>
                    </Row>
                </Stack>
            }
        </Stack>
    </Example>

    <Example Title="Wrap and grow" Note="Children wrap onto new lines; Grow and Basis share the space." Code="@WrapCode">
        <Row Gap="3" Wrap>
            @foreach (var i in Enumerable.Range(1, 8))
            {
                <Tile Grow Basis="10.Rem">Item @i</Tile>
            }
        </Row>
    </Example>

    <Example Title="Spacer pattern: toolbar" Note="A growing Box pushes the actions to the end." Code="@ToolbarCode">
        <Row Gap="2" Align="Align.Center" Padding="3" Bg="Color.SurfaceContainer" Radius="Radius.Md">
            <strong>Projects</strong>
            <Box Grow />
            <Tile>Filter</Tile>
            <Tile Bg="Color.Primary">New project</Tile>
        </Row>
    </Example>

    <Example Title="Nesting" Note="Layout values never leak into children: the inner Stack stays a column inside a Row." Code="@NestingCode">
        <Row Gap="4" Padding="3" Bg="Color.SurfaceContainer" Radius="Radius.Md">
            <Tile>Left</Tile>
            <Stack Gap="2">
                <Tile>Inner 1</Tile>
                <Tile>Inner 2</Tile>
            </Stack>
            <Tile>Right</Tile>
        </Row>
    </Example>

    <Example Title="Interactive re-render"
             Note="On an interactive page these buttons change Direction and Gap from C#. On a static page they do nothing, by design: static pages get their behavior from HTML, CSS and custom elements, not C# events.">
        <Stack Gap="4">
            <Row Gap="2" Wrap>
                <button type="button" class="host-button" @onclick="() => _direction = Direction.Row">Row</button>
                <button type="button" class="host-button" @onclick="() => _direction = Direction.Column">Column</button>
                <button type="button" class="host-button" @onclick="() => _direction = Direction.RowReverse">Row reverse</button>
                <button type="button" class="host-button" @onclick="() => _gap = (_gap + 2) % 12">Gap: @_gap</button>
            </Row>
            <Stack Direction="_direction" Gap="_gap">
                <Tile>One</Tile>
                <Tile>Two</Tile>
                <Tile>Three</Tile>
            </Stack>
        </Stack>
    </Example>

</Stack>

@code {
    private Direction _direction = Direction.Row;
    private int _gap = 2;

    private static readonly (string Label, Responsive<int> Gap)[] Gaps =
    [
        ("0", 0),
        ("1", 1),
        ("3", 3),
        ("6", 6),
        ("2, Md 8", new() { Base = 2, Md = 8 }),
    ];

    private const string BasicsCode =
        """
        <Stack Gap="2">...</Stack>                            @* vertical by default *@
        <Row Gap="2">...</Row>                                @* always horizontal *@
        <Column Gap="2">...</Column>                          @* always vertical *@
        <Stack Direction="Direction.Row" Gap="2">...</Stack>  @* any direction *@
        """;

    private const string ResponsiveCode =
        """
        <Stack Direction="new() { Base = Direction.Column, Md = Direction.Row }" Gap="4">
            <Box Grow>One</Box>
            ...
        </Stack>
        """;

    private const string GapCode =
        """
        <Row Gap="3">...</Row>
        <Row Gap="new() { Base = 2, Md = 8 }">...</Row>
        """;

    private const string AlignCode = """<Row Gap="2" Align="Align.Center">...</Row>""";

    private const string JustifyCode = """<Row Justify="Justify.Between">...</Row>""";

    private const string WrapCode =
        """
        @using IzzyBlazor.Units   @* enables 10.Rem; Length.Rem(10) works without it *@

        <Row Gap="3" Wrap>
            <Box Grow Basis="10.Rem">Item</Box>
            ...
        </Row>
        """;

    private const string ToolbarCode =
        """
        <Row Gap="2" Align="Align.Center">
            <strong>Projects</strong>
            <Box Grow />
            <Button>Filter</Button>
            <Button Accent="Accent.Primary">New project</Button>
        </Row>
        """;

    private const string NestingCode =
        """
        <Row Gap="4">
            <Box>Left</Box>
            <Stack Gap="2">...</Stack>
            <Box>Right</Box>
        </Row>
        """;
}
