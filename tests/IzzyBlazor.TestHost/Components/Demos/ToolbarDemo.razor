@* Toolbar. Drag a box's corner to narrow it: what doesn't fit moves into the … menu. *@

<Stack Gap="8">

    <Example Title="Editor" Note="Without script, widths worked out on the server choose what moves (container queries); with it, the toolbar measures, and Tab reaches it once with the arrows moving along it. Publish never moves; Text style (Priority 1) stays longest." Code="@EditorCode">
        <Box Padding="3" Border="1" Radius="Radius.Md" Style="resize: horizontal; overflow: hidden; min-width: 12rem; max-width: 100%">
            <Toolbar Label="Editor">
                <ToolbarButtonGroup Label="History">
                    <ToolbarIconButton Icon="Lucide.Undo2" Label="Undo" />
                    <ToolbarIconButton Icon="Lucide.Redo2" Label="Redo" />
                </ToolbarButtonGroup>
                <ToolbarButtonGroup Label="Text style" Variant="ButtonVariant.Outline" Priority="1">
                    <ToolbarIconButton Icon="Lucide.Bold" Label="Bold" />
                    <ToolbarIconButton Icon="Lucide.Italic" Label="Italic" />
                    <ToolbarIconButton Icon="Lucide.Underline" Label="Underline" />
                </ToolbarButtonGroup>
                <ToolbarSeparator />
                <ToolbarButton StartIcon="Lucide.Link">Link</ToolbarButton>
                <ToolbarButton StartIcon="Lucide.Image">Image</ToolbarButton>
                <ToolbarButton StartIcon="Lucide.Eye" Position="ToolbarPosition.End">Preview</ToolbarButton>
                <ToolbarButton StartIcon="Lucide.Send" Accent="Accent.Primary" Variant="ButtonVariant.Solid" Position="ToolbarPosition.End" Overflow="ToolbarOverflow.Never">Publish</ToolbarButton>
            </Toolbar>
        </Box>
    </Example>

    <Example Title="Posting from the menu" Note="Each button posts intent=… with the form, from the bar or the … menu, with JavaScript off too. Print is only ever in the menu (Overflow.Always). Empty asks in a dialog first, which keeps its own Tab order inside the toolbar." Code="@PostCode">
        <Stack Gap="3">
            <Box Padding="3" Border="1" Radius="Radius.Md" Style="resize: horizontal; overflow: hidden; min-width: 12rem; max-width: 100%">
                <form method="post" @formname="demo-toolbar" @onsubmit="Post" data-enhance>
                    <AntiforgeryToken />
                    <Toolbar Label="Selected messages">
                        <ToolbarButton Submit Name="intent" Value="archive" StartIcon="Lucide.Archive" OnClick='() => _pressed = "archive"'>Archive</ToolbarButton>
                        <ToolbarButton Submit Name="intent" Value="read" StartIcon="Lucide.MailOpen" OnClick='() => _pressed = "read"'>Mark read</ToolbarButton>
                        <ToolbarButton Submit Name="intent" Value="delete" StartIcon="Lucide.Trash" Accent="Accent.Danger" OnClick='() => _pressed = "delete"'>Delete</ToolbarButton>
                        <ToolbarItem Width="Length.Rem(5.5)">
                            <ConfirmButton Title="Empty the trash?" Message="Deleted messages can't be restored." Name="intent" Value="empty"
                                           Accent="Accent.Danger" ConfirmText="Empty trash">Empty</ConfirmButton>
                        </ToolbarItem>
                        <ToolbarButton Submit Name="intent" Value="print" StartIcon="Lucide.Printer" Overflow="ToolbarOverflow.Always" OnClick='() => _pressed = "print"'>Print</ToolbarButton>
                    </Toolbar>
                </form>
            </Box>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted" data-testid="toolbar-posted">Posted: @(_posted ?? "nothing yet")</TextBlock>
        </Stack>
    </Example>

</Stack>

@code {
    [SupplyParameterFromForm(FormName = "demo-toolbar", Name = "intent")]
    private string? Intent { get; set; }

    private string? _pressed;
    private string? _posted;

    private void Post() => _posted = Intent ?? _pressed;

    private const string EditorCode =
        """
        <Toolbar Label="Editor">
            <ToolbarButtonGroup Label="History">...</ToolbarButtonGroup>
            <ToolbarButtonGroup Label="Text style" Priority="1">...</ToolbarButtonGroup>
            <ToolbarSeparator />
            <ToolbarButton StartIcon="Lucide.Link">Link</ToolbarButton>
            <ToolbarButton StartIcon="Lucide.Image">Image</ToolbarButton>
            <ToolbarButton StartIcon="Lucide.Eye" Position="ToolbarPosition.End">Preview</ToolbarButton>
            <ToolbarButton Position="ToolbarPosition.End" Overflow="ToolbarOverflow.Never" Accent="Accent.Primary" Variant="ButtonVariant.Solid">Publish</ToolbarButton>
        </Toolbar>
        """;

    private const string PostCode =
        """
        <form method="post" @formname="mail" @onsubmit="Post">
            <AntiforgeryToken />
            <Toolbar Label="Selected messages">
                <ToolbarButton Submit Name="intent" Value="archive">Archive</ToolbarButton>
                <ToolbarButton Submit Name="intent" Value="delete" Accent="Accent.Danger">Delete</ToolbarButton>
                <ToolbarButton Submit Name="intent" Value="print" Overflow="ToolbarOverflow.Always">Print</ToolbarButton>
            </Toolbar>
        </form>
        """;
}
