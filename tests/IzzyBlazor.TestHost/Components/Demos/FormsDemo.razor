@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Http
@inject NavigationManager Navigation

<Stack Gap="8">

    <Example Title="Sign-up form" Note="A real form. On the static page it posts to the server and re-renders with errors, even with JavaScript off. Labels, required markers, lengths and input types all come from the model's DataAnnotations." Code="@SignupCode">
        @if (_submitted)
        {
            <Stack Gap="3" Padding="4" Bg="Color.Success" Radius="Radius.Md" MarginY="0">
                <Row Gap="2" Align="Align.Center">
                    <Icon Role="IconRole.Success" Size="IconSize.Lg" />
                    <Heading Level="3" Size="TextSize.Lg">Welcome, @Signup!.Name</Heading>
                </Row>
                <TextBlock Size="TextSize.Sm">The server validated and accepted the form: @Signup!.Email on the @Signup!.Plan plan.</TextBlock>
            </Stack>
        }
        <Box MaxWidth="32.Rem" MarginY="new() { Base = 4 }">
            <Form Model="Signup" FormName="signup" OnValidSubmit="SubmitAsync">
                <FormErrors />
                <TextField @bind-Value="Signup!.Name" AutoComplete="name" StartIcon="Lucide.User" />
                <TextField @bind-Value="Signup!.Email" AutoComplete="email" StartIcon="Lucide.Mail" Placeholder="you@example.com" Hint="We'll never share your email." />
                <TextField @bind-Value="Signup!.Password" AutoComplete="new-password" Hint="At least 8 characters." />
                <Select @bind-Value="Signup!.Plan" Placeholder="Choose a plan" />
                <RadioGroup @bind-Value="Signup!.Contact" Orientation="Orientation.Horizontal" />
                <TextArea @bind-Value="Signup!.Bio" Rows="3" AutoGrow ShowCount Placeholder="Tell us a little about yourself" />
                <Switch @bind-Value="Signup!.Newsletter" />
                <Checkbox @bind-Value="Signup!.AcceptTerms">I agree to the <a href="static/forms">terms of service</a></Checkbox>
                <Row Gap="2">
                    <Button Submit StartIcon="Lucide.UserPlus">Create account</Button>
                    <Button Reset Variant="ButtonVariant.Ghost" Accent="Accent.Neutral">Reset</Button>
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Rich options" Note="ItemTemplate puts icons and a second line in the options. Where the browser supports the customizable select (Chrome and Edge 135+), the list is themed and shows the markup, and the closed field shows the chosen option without its hint. Other browsers, and iPhones, use their own list with ItemText." Code="@RichCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Rich" FormName="rich" OnValidSubmit="() => { }">
                <Select @bind-Value="Rich!.Plan" Placeholder="Choose a plan" ItemText="PlanName">
                    <ItemTemplate Context="plan">
                        <Icon Name="PlanIcon(plan)" />
                        <span>@PlanName(plan) <span class="ib-option-hint">@PlanHint(plan)</span></span>
                    </ItemTemplate>
                </Select>
                <Select @bind-Value="Rich!.Priority">
                    <ItemTemplate Context="priority">
                        <span class="host-dot" style="--dot: var(--ib-color-@(PriorityColor(priority)))"></span>
                        @priority
                    </ItemTemplate>
                </Select>
            </Form>
        </Box>
    </Example>

    <Example Title="Combobox" Note="A select you can type in. Without JavaScript it's a native select, so the form still works; with it, typing filters the list (accents and case ignored), arrow keys move, Enter chooses and Escape closes. On interactive pages, Search runs on the server as you type; on static pages, Search(&quot;&quot;) fills the list once and it filters in the browser." Code="@ComboCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Combo" FormName="combo" OnValidSubmit="() => _comboSaved = true">
                <Combobox @bind-Value="Combo!.Country" Items="Countries.Keys" ItemText="code => Countries[code!]" Placeholder="Search countries">
                    <ItemTemplate Context="code">
                        <span class="host-flag" aria-hidden="true">@Flag(code!)</span> @Countries[code!]
                    </ItemTemplate>
                </Combobox>
                <Combobox @bind-Value="Combo!.OwnerId" Search="FindPeople" ItemText="id => P(id).Name" Placeholder="Search people"
                          Hint="Search runs on the server on interactive pages.">
                    <ItemTemplate Context="id">
                        <span class="host-avatar" aria-hidden="true">@P(id).Initials</span>
                        <span>@P(id).Name <span class="ib-option-hint">@P(id).Role</span></span>
                    </ItemTemplate>
                </Combobox>
                <Row Gap="2" Align="Align.Center">
                    <Button Submit>Save</Button>
                    @if (_comboSaved)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Saved: @(Combo!.Country is { } c ? Countries[c] : "no country"), @(Combo!.OwnerId is { } o ? P(o).Name : "no owner")</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Several choices" Note="CheckboxGroup shows a short list as checkboxes; MultiSelect suits a longer one. Both bind to a collection (an array, List or HashSet) and post repeated form fields, which Blazor binds back, so they work with JavaScript off. With it, MultiSelect becomes a field of chips you can type in: choosing toggles an option and the list stays open, and Backspace removes the last chip." Code="@ChoicesCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Choices" FormName="choices" OnValidSubmit="() => _choicesSaved = true">
                <CheckboxGroup @bind-Value="Choices!.Toppings" Items="Enum.GetValues<Topping>()" Orientation="Orientation.Horizontal" />
                <MultiSelect @bind-Value="Choices!.Skills" Items="Skills" Placeholder="Add skills" Hint="Up to 5." />
                <Row Gap="2" Align="Align.Center">
                    <Button Submit>Save</Button>
                    @if (_choicesSaved)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted" data-testid="choices-saved">Saved: @(Choices!.Toppings is not { Count: > 0 } ? "no toppings" : string.Join(", ", Choices.Toppings)); @(Choices.Skills is not { Length: > 0 } ? "no skills" : string.Join(", ", Choices.Skills))</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Checkboxes and radios" Note="Drawn with the field colors, so they match fields and switches in every browser and in dark mode, and sized by ControlSize. Indeterminate shows a dash: here the server works out Select all from the three boxes, so it's right after a post with JavaScript off, and live on the interactive page. It's display only; choosing the box clears it." Code="@ChecksCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Checks" FormName="checks" OnValidSubmit="() => { }">
                <Stack Gap="2">
                    <Checkbox Value="AllNotify" ValueChanged="SetAllNotify" ValueExpression="() => Checks!.AllNotify" Indeterminate="SomeNotify" Label="Notify me about everything" />
                    <Box PaddingStart="6">
                        <Stack Gap="2">
                            <Checkbox @bind-Value="Checks!.Comments" />
                            <Checkbox @bind-Value="Checks!.Mentions" />
                            <Checkbox @bind-Value="Checks!.Releases" />
                        </Stack>
                    </Box>
                </Stack>
                <RadioGroup @bind-Value="Checks!.Digest" Orientation="Orientation.Horizontal" />
                <Row Gap="5" Wrap>
                    <Checkbox @bind-Value="Checks!.Small" Size="ControlSize.Sm" />
                    <Checkbox @bind-Value="Checks!.Medium" />
                    <Checkbox @bind-Value="Checks!.Large" Size="ControlSize.Lg" />
                </Row>
                <Row Gap="5" Wrap>
                    <Checkbox @bind-Value="Checks!.Locked" Disabled />
                    <Checkbox @bind-Value="Checks!.LockedOn" Disabled />
                </Row>
                <Button Submit>Save</Button>
            </Form>
        </Box>
    </Example>

    <Example Title="Settings list" Note="ControlPosition.End puts a switch (or checkbox) at the end of the row, with the hint under the label; the label text still toggles it. Dividers on the Fieldset draws a line between rows, with the gap above and below it. In a horizontal form it takes the whole row (see Horizontal layout)." Code="@SettingsCode">
        <Box MaxWidth="36.Rem">
            <Form Model="Notifications" FormName="notifications" OnValidSubmit="() => { }">
                <Fieldset Label="Email notifications" Description="Choose what we email you about." Dividers Gap="3">
                    <Switch @bind-Value="Notifications!.NewDevice" ControlPosition="ControlPosition.End" Hint="An email each time, with a link to sign that device out." />
                    <Switch @bind-Value="Notifications!.Mentions" ControlPosition="ControlPosition.End" Hint="When someone mentions you or replies to you." />
                    <Switch @bind-Value="Notifications!.ProductUpdates" ControlPosition="ControlPosition.End" Hint="A short email when something new ships, about once a month." />
                    <Checkbox @bind-Value="Notifications!.Digest" ControlPosition="ControlPosition.End" />
                </Fieldset>
                <Button Submit>Save</Button>
            </Form>
        </Box>
    </Example>

    <Example Title="Icons on rows or sections" Note="Icon on a Switch or Checkbox goes at the start of the row, centered on the label and hint; Icon on a Fieldset goes at the start of its heading. Both are decorative. Use one or the other on a page, not both." Code="@IconsCode">
        <Row Gap="8" Wrap Align="Align.Start">
            <Box MaxWidth="30.Rem" Grow>
                <Form Model="Notifications" FormName="notifications-icons" OnValidSubmit="() => { }">
                    <Fieldset Label="Email notifications" Description="Icons on the rows." Dividers Gap="3">
                        <Switch @bind-Value="Notifications!.NewDevice" Icon="Lucide.KeyRound" ControlPosition="ControlPosition.End" Hint="An email each time, with a link to sign that device out." />
                        <Switch @bind-Value="Notifications!.Mentions" Icon="Lucide.MessageSquareCheck" ControlPosition="ControlPosition.End" Hint="When someone mentions you or replies to you." />
                        <Switch @bind-Value="Notifications!.ProductUpdates" Icon="Lucide.LayersPlus" ControlPosition="ControlPosition.End" Hint="A short email when something new ships, about once a month." />
                    </Fieldset>
                </Form>
            </Box>
            <Box MaxWidth="30.Rem" Grow>
                <Form Model="Notifications" FormName="notifications-section" OnValidSubmit="() => { }">
                    <Fieldset Label="Email notifications" Description="An icon on the section." Icon="Lucide.Bell" Dividers Gap="3">
                        <Switch @bind-Value="Notifications!.NewDevice" ControlPosition="ControlPosition.End" Hint="An email each time, with a link to sign that device out." />
                        <Switch @bind-Value="Notifications!.Mentions" ControlPosition="ControlPosition.End" Hint="When someone mentions you or replies to you." />
                    </Fieldset>
                </Form>
            </Box>
        </Row>
    </Example>

    <Example Title="Groups and sizes" Note="Fieldset groups related fields. ControlSize matches the button sizes, so fields and buttons line up." Code="@GroupsCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Address" FormName="address" OnValidSubmit="() => { }">
                <Fieldset Label="Shipping address" Description="Where we send your order.">
                    <TextField @bind-Value="Address!.Street" AutoComplete="street-address" />
                    <Row Gap="3">
                        <TextField @bind-Value="Address!.City" Class="host-grow" />
                        <TextField @bind-Value="Address!.PostalCode" />
                    </Row>
                </Fieldset>
                <Row Gap="2" Align="Align.End">
                    <TextField @bind-Value="Address!.Coupon" Size="ControlSize.Sm" Placeholder="Coupon code" Class="host-grow" />
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Apply</Button>
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Numbers" Note="NumberField is a native number input: it posts with the form, the browser checks min, max and step, and phones show a number keyboard. Min and Max come from [Range]. With JavaScript, stepper buttons appear, stacked or split (hold to repeat); without it, the browser's own spin buttons show instead, and arrow keys step either way. Values use invariant formatting (1.5), whatever the page's culture." Code="@NumbersCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Numbers" FormName="numbers" OnValidSubmit="() => _numbersSaved = true">
                <NumberField @bind-Value="Numbers!.Quantity" />
                <NumberField @bind-Value="Numbers!.Price" Step="0.01" Placeholder="0.00">
                    <StartAddon>$</StartAddon>
                </NumberField>
                <NumberField @bind-Value="Numbers!.Discount" Step="5">
                    <EndAddon>%</EndAddon>
                </NumberField>
                <NumberField @bind-Value="Numbers!.Guests" StepButtons="StepButtons.Split" Hint="Split steppers: easier to tap." />
                <NumberField @bind-Value="Numbers!.Seats" StepButtons="StepButtons.None" Hint="No steppers: type a number, or use the arrow keys." />
                <Row Gap="2" Align="Align.Center">
                    <Button Submit>Save</Button>
                    @if (_numbersSaved)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Saved: @Numbers!.Quantity × @(Numbers.Price?.ToString("0.00") ?? "no price"), @Numbers.Discount% off, @Numbers.Guests guests, @(Numbers.Seats?.ToString() ?? "no") seats</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Segmented control" Note="One choice from a few, as joined buttons. They're real radio buttons, so the choice posts with the form and arrow keys move it, with JavaScript off. HideLabel keeps the label for screen readers only; IconOnly shows just the icons, with the text as a tooltip." Code="@SegmentsCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Segments" FormName="segments" OnValidSubmit="() => _segmentsSaved = true">
                <SegmentedControl @bind-Value="Segments!.View" data-testid="segmented-view" />
                <SegmentedControl @bind-Value="Segments!.Align" ItemIcon="AlignIcon" IconOnly />
                <SegmentedControl @bind-Value="Segments!.Billing" FullWidth HideLabel />
                <Row Gap="3" Wrap Align="Align.End">
                    <SegmentedControl @bind-Value="Segments!.Small" Size="ControlSize.Sm" />
                    <SegmentedControl @bind-Value="Segments!.Large" Size="ControlSize.Lg" />
                </Row>
                <Row Gap="2" Align="Align.Center">
                    <Button Submit>Save</Button>
                    @if (_segmentsSaved)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Saved: @Segments!.View, @Segments.Align, @Segments.Billing</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Sliders" Note="Slider is a native range input: it posts with the form and takes arrow keys, Page Up/Down and Home/End with no script. With JavaScript the track fills to the thumb and the value follows as you drag. ValueFormat sets how the value reads, shown and announced. On interactive pages, Live updates the bound value while dragging; here the sample below follows it." Code="@SlidersCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Sliders" FormName="sliders" OnValidSubmit="() => _slidersSaved = true">
                <Slider @bind-Value="Sliders!.Volume" ShowValue />
                <Slider @bind-Value="Sliders!.Discount" Step="5" ShowValue ValueFormat="{0}%" Hint="Steps of 5, up to 50%." />
                <Slider @bind-Value="Sliders!.Opacity" Min="0" Max="1" Step="0.05" ShowValue Live />
                <div style="@($"height: 2rem; border-radius: var(--ib-radius-md); background: var(--ib-color-primary); opacity: {Sliders!.Opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)}")"></div>
                <Row Gap="3">
                    <Slider @bind-Value="Sliders!.Small" Size="ControlSize.Sm" Class="host-grow" />
                    <Slider @bind-Value="Sliders!.Large" Size="ControlSize.Lg" Class="host-grow" />
                </Row>
                <Slider @bind-Value="Sliders!.Locked" Disabled ShowValue />
                <Row Gap="2" Align="Align.Center">
                    <Button Submit>Save</Button>
                    @if (_slidersSaved)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Saved: volume @Sliders!.Volume, @Sliders.Discount% off, opacity @Sliders.Opacity</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Color picker" Note="A native color input underneath: it posts with the form and opens the browser's picker with JavaScript off, where the swatch fills the field (Chrome and Edge offer the presets in a menu first). With JavaScript the swatch moves to the start and opens the picker directly, a hex box appears for typing or pasting, and the presets show as swatches. The value is kept as #rrggbb." Code="@ColorsCode">
        <Box MaxWidth="Length.Rem(24)">
            <Form Model="Colors" FormName="colors" OnValidSubmit="() => _colorsSaved = true">
                <ColorPicker @bind-Value="Colors!.Brand" Presets="BrandPresets" Hint="Used for buttons, links and focus." />
                <ColorPicker @bind-Value="Colors!.Highlight" ShowHex="false" />
                <Row Gap="3">
                    <ColorPicker @bind-Value="Colors!.Small" Size="ControlSize.Sm" Class="host-grow" />
                    <ColorPicker @bind-Value="Colors!.Large" Size="ControlSize.Lg" Class="host-grow" />
                </Row>
                <ColorPicker @bind-Value="Colors!.Locked" Disabled />
                <Row Gap="2" Align="Align.Center">
                    <Button Submit>Save</Button>
                    @if (_colorsSaved)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">Saved: brand @Colors!.Brand, highlight @Colors.Highlight</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="File upload" Note="A drop zone around a real file input. &quot;Choose a file&quot; is a label for the input, so it opens the picker with JavaScript off too; the browser then names the chosen file, and it posts with the form (Multipart on the Form); the page binds it as IFormFile. The hint comes from Accept and MaxFileSize. With JavaScript, files can be dropped on the zone, the chosen file's name and size replace the hint, and a file over MaxFileSize is flagged before posting. On interactive pages, OnChange gets IBrowserFile streams instead." Code="@UploadCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Upload" FormName="upload" Multipart OnValidSubmit="UploadedAsync">
                <FileUpload Name="Avatar" Label="Profile photo" Accept="image/png,image/jpeg" MaxFileSize="2_000_000" Hint="Square images work best." OnChange="files => ShowChosen(files)" />
                <FileUpload Name="Attachments" Label="Attachments" Multiple Hint="Several files at once." OnChange="files => ShowChosen(files)" />
                <TextField @bind-Value="Upload!.Note" />
                <Row Gap="2" Align="Align.Center">
                    <Button Submit StartIcon="Lucide.Upload">Upload</Button>
                    @if (_uploaded is not null)
                    {
                        <TextBlock Size="TextSize.Sm" Color="Color.Muted">@_uploaded</TextBlock>
                    }
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Add-ons" Note="StartAddon and EndAddon attach text, a button or another field to the control, outside its border. A nested field keeps its label for screen readers only. Add-on text isn't part of the field's accessible name, so put units that matter in the label too. Everything here posts with the form, JavaScript or not." Code="@AddonsCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Addons" FormName="addons" OnValidSubmit="() => _addonsSaved = true">
                <TextField @bind-Value="Addons!.Website" Placeholder="example.com">
                    <StartAddon>https://</StartAddon>
                </TextField>
                <TextField @bind-Value="Addons!.Price" Placeholder="0.00" StartIcon="Lucide.Banknote">
                    <EndAddon><Select @bind-Value="Addons!.Currency" /></EndAddon>
                </TextField>
                <TextField @bind-Value="Addons!.Weight">
                    <EndAddon>kg</EndAddon>
                </TextField>
                <TextField @bind-Value="Addons!.Invite" Type="TextFieldType.Email" Placeholder="teammate@example.com">
                    <EndAddon><Button Submit StartIcon="Lucide.Send">Invite</Button></EndAddon>
                </TextField>
                @if (_addonsSaved)
                {
                    <TextBlock Size="TextSize.Sm" Color="Color.Muted">Saved: https://@Addons!.Website, @Addons.Price @Addons.Currency, @Addons.Weight kg, invite to @Addons.Invite</TextBlock>
                }
                <Row Gap="2" Align="Align.End">
                    <TextField @bind-Value="Addons!.Small" Size="ControlSize.Sm" Placeholder="Search" HideLabel Class="host-grow">
                        <EndAddon><Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Go</Button></EndAddon>
                    </TextField>
                    <TextField @bind-Value="Addons!.Large" Size="ControlSize.Lg" Placeholder="Search" Class="host-grow">
                        <StartAddon>@@</StartAddon>
                    </TextField>
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Sizes" Note="Label, text and hint scale with ControlSize, and each field lines up with a button of the same size. On touch screens field text is at least 16px, so iPhones don't zoom in." Code="@SizesCode">
        <Box MaxWidth="32.Rem">
            <Form Model="Sizes" FormName="sizes" OnValidSubmit="() => { }">
                <Row Gap="2" Align="Align.End">
                    <TextField @bind-Value="Sizes!.Small" Size="ControlSize.Sm" Hint="A hint below the field." Placeholder="Search" StartIcon="Lucide.Search" Class="host-grow" />
                    <Button Size="ControlSize.Sm" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Class="host-hint-offset">Go</Button>
                </Row>
                <Row Gap="2" Align="Align.End">
                    <TextField @bind-Value="Sizes!.Medium" Hint="A hint below the field." Placeholder="Search" StartIcon="Lucide.Search" Class="host-grow" />
                    <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Class="host-hint-offset">Go</Button>
                </Row>
                <Row Gap="2" Align="Align.End">
                    <TextField @bind-Value="Sizes!.Large" Size="ControlSize.Lg" Hint="A hint below the field." Placeholder="Search" StartIcon="Lucide.Search" Class="host-grow" />
                    <Button Size="ControlSize.Lg" Variant="ButtonVariant.Outline" Accent="Accent.Neutral" Class="host-hint-offset-lg">Go</Button>
                </Row>
            </Form>
        </Box>
    </Example>

    <Example Title="Read-only and optional marks" Note="ReadOnly on the Form shows a record without letting it change. Every field can still be focused and reads as read-only: the select shows its value as text, and the radios and switch don't change (without JavaScript they're disabled). Their values post from hidden inputs. Edit turns it into a normal form. Disabled on the Form works the same way, but posts nothing. RequiredMark.Optional marks the fields that aren't required, instead of starring the ones that are: clearer when most fields are required." Code="@AccountCode">
        <Form Model="Account" FormName="account" Columns="2" ReadOnly="!EditAccount" RequiredMark="RequiredMark.Optional" OnValidSubmit="() => { }">
            <TextField @bind-Value="Account!.DisplayName" />
            <TextField @bind-Value="Account!.Email" />
            <Select @bind-Value="Account!.Plan" />
            <TextField @bind-Value="Account!.Company" />
            <RadioGroup @bind-Value="Account!.Contact" Orientation="Orientation.Horizontal" />
            <Switch @bind-Value="Account!.Newsletter" />
            <FormActions>
                @if (EditAccount)
                {
                    <Button Href="@Navigation.GetUriWithQueryParameter("edit-account", (bool?)null)" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Cancel</Button>
                    <Button Submit>Save</Button>
                }
                else
                {
                    <Button Href="@Navigation.GetUriWithQueryParameter("edit-account", true)" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Edit</Button>
                }
            </FormActions>
        </Form>
    </Example>

    <Example Title="Tabs in a form" Note="A form can spread over Tabs: every panel is in the form, so every field posts. After a submit that fails, the first tab with errors opens (unless the open one has some) and each tab shows how many errors it holds, read out with its name. Here the profile is filled in, so Save opens Address. With JavaScript off, both panels show, one under the other, so the browser can point at any field. Only a submit switches tabs; errors that appear while typing don't." Code="@TabbedCode">
        <Box MaxWidth="36.Rem">
            <Form Model="Tabbed" FormName="tabbed" OnValidSubmit="() => { }">
                <FormErrors />
                <Tabs Label="Account details">
                    <Tab Label="Profile">
                        <Stack Gap="4">
                            <TextField @bind-Value="Tabbed!.Name" />
                            <TextField @bind-Value="Tabbed!.Email" />
                        </Stack>
                    </Tab>
                    <Tab Label="Address">
                        <Stack Gap="4">
                            <TextField @bind-Value="Tabbed!.Street" />
                            <TextField @bind-Value="Tabbed!.City" />
                        </Stack>
                    </Tab>
                </Tabs>
                <FormActions><Button Submit>Save</Button></FormActions>
            </Form>
        </Box>
    </Example>

    <Example Title="Horizontal layout" Note="Labels in a column from 640px up; stacked on phones." Code="@HorizontalCode">
        <Box MaxWidth="36.Rem">
            <Form Model="Profile" FormName="profile" Layout="FormLayout.Horizontal" OnValidSubmit="() => { }">
                <TextField @bind-Value="Profile!.DisplayName" />
                <TextField @bind-Value="Profile!.Website" StartIcon="Lucide.Globe" />
                <Select @bind-Value="Profile!.Language" />
                <TextField @bind-Value="Profile!.Username" ReadOnly Hint="Usernames can't be changed." />
                <Switch @bind-Value="Profile!.PublicProfile" ControlPosition="ControlPosition.End" Hint="Anyone with the link can see your name and photo." />
            </Form>
        </Box>
    </Example>

    <Example Title="Columns" Note="Columns lays fields out in up to that many columns, by the form's own width rather than the screen's: narrow the window and this one goes from three to two to one, as it would in a dialog. Fields take a column; ColSpan widens one (never past the columns shown) and GridSpan.Full takes the row. A Fieldset takes the row and can have its own Columns. Anything that isn't a field takes the row too, such as FormActions, which puts the buttons at the end. The first name's message is the model's own ErrorMessage, in the browser's check as well as after posting." Code="@ColumnsCode">
        <Form Model="Contact" FormName="columns" Columns="3" OnValidSubmit="() => { }">
            <TextField @bind-Value="Contact!.FirstName" />
            <TextField @bind-Value="Contact!.LastName" />
            <TextField @bind-Value="Contact!.Email" />
            <Fieldset Label="Address" Columns="3">
                <TextField @bind-Value="Contact!.Street" ColSpan="GridSpan.Full" />
                <TextField @bind-Value="Contact!.City" />
                <TextField @bind-Value="Contact!.Region" />
                <TextField @bind-Value="Contact!.PostalCode" />
            </Fieldset>
            <TextArea @bind-Value="Contact!.Notes" ColSpan="2" />
            <FormActions><Button Submit>Save</Button></FormActions>
        </Form>
    </Example>

</Stack>

@code {
    [SupplyParameterFromForm(FormName = "signup")] public SignupModel? Signup { get; set; }
