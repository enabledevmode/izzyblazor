    private bool AllNotify => Checks!.Comments && Checks.Mentions && Checks.Releases;
    private bool SomeNotify => !AllNotify && (Checks!.Comments || Checks.Mentions || Checks.Releases);

    // "Select all": on static pages it posts like any box, and the three below decide it; on
