@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Navigation

@* Menu, Popover, Tooltip and Dialog. Native top-layer elements, enhanced by small custom elements. *@

<Stack Gap="8">

    @if (_chosen is not null || _invited is not null)
    {
        <Box Padding="3" Radius="Radius.Md" Bg="Color.SurfaceContainer" data-testid="server-result">
            <TextBlock Size="TextSize.Sm">
                The server received:
                @if (_chosen is not null) { <strong>action=@_chosen</strong> }
                @if (_invited is not null) { <strong>invite=@_invited</strong> }
            </TextBlock>
        </Box>
    }

    <Example Title="Menu" Note="Links, form posts and C# actions. Open, Escape and click-outside are native; the script adds arrow keys, Home, End and type-ahead." Code="@MenuCode">
        <form method="get" action="@_path">
            <Row Gap="3" Wrap Align="Align.Center">
                <Menu Label="Project" StartIcon="Lucide.Folder" Id="project-menu">
                    <MenuItem Href="@($"{_path}#settings")" Icon="Lucide.Settings" Shortcut="⌘,">Settings</MenuItem>
                    <MenuItem Icon="Lucide.Copy" Shortcut="⌘D" OnClick="@(() => _clicked = "duplicate")">Duplicate</MenuItem>
                    <MenuItem Icon="Lucide.Share2" Disabled="true">Share (soon)</MenuItem>
                    <MenuDivider />
                    <MenuGroup Label="Posts the form">
                        <MenuItem Submit Name="action" Value="archive" Icon="Lucide.Archive">Archive</MenuItem>
                        <MenuItem Submit Name="action" Value="delete" Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
                    </MenuGroup>
                </Menu>

                <Menu Placement="Placement.BottomEnd" Id="more-menu">
                    <Trigger>
                        <IconButton Icon="Lucide.Ellipsis" Label="More actions" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" @attributes="context" />
                    </Trigger>
                    <ChildContent>
                        <MenuItem Icon="Lucide.Pencil">Rename</MenuItem>
                        <MenuItem Icon="Lucide.Download">Export</MenuItem>
                    </ChildContent>
                </Menu>

                @if (RendererInfo.IsInteractive)
                {
                    <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Last C# action: <strong data-testid="clicked">@(_clicked ?? "none")</strong></TextBlock>
                }
            </Row>
        </form>
    </Example>

    <Example Title="Checkable items and submenus" Note="@CheckableNote" Code="@CheckableCode">
        <Row Gap="3" Wrap Align="Align.Center">
            <Menu Label="View" StartIcon="Lucide.SlidersHorizontal" Id="view-menu">
                <MenuRadioGroup Label="Sort by" QueryKey="sort">
                    <MenuItem Value="name">Name</MenuItem>
                    <MenuItem Value="date">Date modified</MenuItem>
                    <MenuItem Value="size">Size</MenuItem>
                </MenuRadioGroup>
                <MenuDivider />
                <MenuItem Checked="Compact" Href="@CompactHref">Compact rows</MenuItem>
                @if (RendererInfo.IsInteractive)
                {
                    <MenuItem @bind-Checked="_showDone">Show completed</MenuItem>
                }
            </Menu>

            <Menu Label="Actions" Id="actions-menu">
                <MenuItem Icon="Lucide.Pencil">Rename</MenuItem>
                <MenuSub Label="Move to" Icon="Lucide.FolderInput">
                    <MenuItem Icon="Lucide.Inbox">Inbox</MenuItem>
                    <MenuItem Icon="Lucide.Archive">Archive</MenuItem>
                    <MenuSub Label="Projects" Icon="Lucide.Folder">
                        <MenuItem>Website</MenuItem>
                        <MenuItem>Course app</MenuItem>
                    </MenuSub>
                </MenuSub>
                <MenuSub Label="Share" Icon="Lucide.Share2">
                    <MenuItem Icon="Lucide.Link">Copy link</MenuItem>
                    <MenuItem Icon="Lucide.Mail">Email</MenuItem>
                </MenuSub>
                <MenuDivider />
                <MenuItem Icon="Lucide.Trash" Accent="Accent.Danger">Delete</MenuItem>
            </Menu>

            <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">
                Sorted by <strong>@(Sort ?? "default")</strong>@(Compact ? ", compact rows" : "")@(RendererInfo.IsInteractive ? (_showDone ? ", showing completed" : ", hiding completed") : "")
            </TextBlock>
        </Row>
    </Example>

    <Example Title="Placement" Note="CSS anchor positioning places each panel and flips it when there is no room. Older browsers get the same result from a small script." Code="@PlacementCode">
        <Row Gap="2" Wrap>
            @foreach (var placement in Enum.GetValues<Placement>())
            {
                <Menu Label="@placement.ToString()" Placement="placement" Size="ControlSize.Sm">
                    <MenuItem>First</MenuItem>
                    <MenuItem>Second</MenuItem>
                </Menu>
            }
        </Row>
    </Example>

    <Example Title="Popover" Note="Non-modal content next to its trigger. Auto mode closes on Escape and outside clicks; Manual stays until closed." Code="@PopoverCode">
        <Row Gap="3" Wrap>
            <Popover Label="Filters" StartIcon="Lucide.SlidersHorizontal" Title="Filter results" Id="filters">
                <Stack Gap="2">
                    <label class="ib-check"><input type="checkbox" class="ib-check-input" checked /> Open issues</label>
                    <label class="ib-check"><input type="checkbox" class="ib-check-input" /> Closed issues</label>
                    <label class="ib-check"><input type="checkbox" class="ib-check-input" /> Assigned to me</label>
                </Stack>
            </Popover>
            <Popover Label="Pinned note" Mode="PopoverMode.Manual" Title="Pinned" Placement="Placement.End" Id="pinned" @bind-Open="_pinnedOpen">
                <TextBlock Size="TextSize.Sm" MaxWidth="16.Rem">Manual popovers stay open while you work elsewhere on the page.</TextBlock>
            </Popover>
            @if (RendererInfo.IsInteractive)
            {
                <Button Size="ControlSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => _pinnedOpen = !_pinnedOpen">Toggle pinned from C#</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Pinned open: <strong data-testid="pinned-open">@_pinnedOpen</strong></TextBlock>
            }
        </Row>
    </Example>

    <Example Title="Tooltip" Note="Pure CSS with JavaScript off. With it, tooltips move to the top layer, so the clipped box below can't cut them off." Code="@TooltipCode">
        <Row Gap="3" Align="Align.Center" Wrap>
            <Tooltip Text="Saved to your drafts"><Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Hover me</Button></Tooltip>
            <Tooltip Text="Bottom" Placement="Placement.Bottom"><Button Variant="ButtonVariant.Soft">Bottom</Button></Tooltip>
            <Tooltip Text="Start side" Placement="Placement.Start"><Button Variant="ButtonVariant.Soft">Start</Button></Tooltip>
            <Tooltip Text="End side" Placement="Placement.End"><Button Variant="ButtonVariant.Soft">End</Button></Tooltip>
            <Box Padding="2" Radius="Radius.Md" Class="host-dashed" Style="overflow:hidden">
                <Tooltip Text="Notifications: 3 unread" Delay="0"><IconButton Icon="Lucide.Bell" Label="Notifications" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" /></Tooltip>
            </Box>
        </Row>
    </Example>

    <Example Title="Dialog" Note="A native modal dialog: focus is trapped, the page behind is inert, Escape closes it. Opened by DialogTrigger (commandfor), by a ?dialog= link rendered open on the server, or from C#." Code="@DialogCode">
        <Row Gap="3" Wrap>
            <DialogTrigger For="invite" StartIcon="Lucide.UserPlus">Invite people</DialogTrigger>
            <DialogTrigger For="confirm-delete" Accent="Accent.Danger" Variant="ButtonVariant.Outline">Delete project</DialogTrigger>
            <DialogTrigger For="rename" Accent="Accent.Neutral" Variant="ButtonVariant.Outline" StartIcon="Lucide.Pencil">Rename</DialogTrigger>
            @if (_renamed is not null)
            {
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted" data-testid="renamed">Renamed to @_renamed</TextBlock>
            }
            <Button Href="@($"{_path}?dialog=confirm-delete")" Variant="ButtonVariant.Link">Open with a link (?dialog=)</Button>
            @if (RendererInfo.IsInteractive)
            {
                <Button Variant="ButtonVariant.Ghost" OnClick="() => _confirmOpen = true">Open from C#</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Confirm open: <strong data-testid="confirm-open">@_confirmOpen</strong></TextBlock>
            }
        </Row>

        <Dialog Id="invite" Title="Invite people">
            <form method="get" action="@_path" id="invite-form">
                <Stack Gap="3">
                    <TextBlock Color="Color.Muted" Size="TextSize.Sm">They'll get an email with a link to join.</TextBlock>
                    <div class="ib-field">
                        <label class="ib-field-label" for="invite-email">Email</label>
                        <ib-field-control class="ib-field-control">
                            <input id="invite-email" class="ib-field-input" type="email" name="invite" required autofocus />
                        </ib-field-control>
                    </div>
                </Stack>
                @* Last in the form, the footer's submit button submits it. *@
                <DialogFooter>
                    <DialogClose>Cancel</DialogClose>
                    <Button Submit StartIcon="Lucide.Mail">Send invite</Button>
                </DialogFooter>
            </form>
        </Dialog>

        <Dialog Id="rename" Title="Rename project" Size="DialogSize.Sm" @bind-Open="_renameOpen">
            <Form Model="Rename" FormName="rename" OnValidSubmit="RenameSaved">
                <TextField @bind-Value="Rename!.Name" Hint="3 to 40 characters." />
                @* Last in a form that fills the dialog, FormActions becomes the dialog's footer. *@
                <FormActions>
                    <DialogClose>Cancel</DialogClose>
                    <Button Submit>Rename</Button>
                </FormActions>
            </Form>
        </Dialog>

        <Dialog Id="confirm-delete" Title="Delete this project?" Size="DialogSize.Sm" CloseOnBackdrop="false" @bind-Open="_confirmOpen">
            <TextBlock>This removes the project and its history. It can't be undone.</TextBlock>
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <form method="get" action="@_path" style="display:contents">
                    <Button Submit Name="action" Value="delete" Accent="Accent.Danger">Delete</Button>
                </form>
            </DialogFooter>
        </Dialog>

    </Example>

    <Example Title="Dialogs from code" Note="@ServiceNote" Code="@ServiceCode">
        <DialogHost />
        @if (RendererInfo.IsInteractive)
        {
            <Row Gap="3" Wrap Align="Align.Center">
                <Button StartIcon="Lucide.Pencil" OnClick="EditFromCode">Edit name</Button>
                <Button Accent="Accent.Danger" Variant="ButtonVariant.Outline" OnClick="ConfirmFromCode">Remove member</Button>
                <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted" data-testid="service-result">@_serviceResult</TextBlock>
            </Row>
        }
    </Example>

    <Example Title="Drawer" Note="A dialog that slides in from an edge: the end side by default, the start side, or a sheet along the bottom (good on phones) or top. It behaves like Dialog, so it traps focus, closes on Escape and opens the same ways. Size sets a side drawer's width; sides flip in right-to-left languages." Code="@DrawerCode">
        <Row Gap="3" Wrap>
            <DialogTrigger For="details-drawer" Accent="Accent.Neutral" Variant="ButtonVariant.Outline" StartIcon="Lucide.PanelRight">End</DialogTrigger>
            <DialogTrigger For="nav-drawer" Accent="Accent.Neutral" Variant="ButtonVariant.Outline" StartIcon="Lucide.PanelLeft">Start, small</DialogTrigger>
            <DialogTrigger For="share-sheet" Accent="Accent.Neutral" Variant="ButtonVariant.Outline" StartIcon="Lucide.PanelBottom">Bottom sheet</DialogTrigger>
        </Row>

        <Drawer Id="details-drawer" Title="Project details" Size="DialogSize.Lg">
            @* DialogBody fills the drawer, so the footer sits at its bottom. *@
            <DialogBody>
                <DescriptionList Orientation="Orientation.Vertical" Divided>
                    <DescriptionItem Term="Owner">Israel</DescriptionItem>
                    <DescriptionItem Term="Visibility">Private</DescriptionItem>
                    <DescriptionItem Term="Created">Oct 12, 2026</DescriptionItem>
                </DescriptionList>
            </DialogBody>
            <DialogFooter>
                <DialogClose>Close</DialogClose>
            </DialogFooter>
        </Drawer>

        <Drawer Id="nav-drawer" Title="Navigate" Placement="DialogPlacement.Start" Size="DialogSize.Sm">
            <nav aria-label="Drawer navigation"><NavMenu>
                <NavItem Href="static/overlays" Icon="Lucide.House">Home</NavItem>
                <NavItem Href="static/overlays" Icon="Lucide.FolderKanban">Projects</NavItem>
                <NavItem Href="static/overlays" Icon="Lucide.Settings">Settings</NavItem>
            </NavMenu></nav>
        </Drawer>

        <Drawer Id="share-sheet" Title="Share" Placement="DialogPlacement.Bottom">
            <Stack Gap="3">
                <TextBlock Color="Color.Muted" Size="TextSize.Sm">Anyone with the link can view this project.</TextBlock>
                <Row Gap="2" Wrap>
                    <Button StartIcon="Lucide.Link">Copy link</Button>
                    <Button Variant="ButtonVariant.Outline" Accent="Accent.Neutral" StartIcon="Lucide.Mail">Email</Button>
                </Row>
            </Stack>
        </Drawer>
    </Example>

    <Example Title="ConfirmButton" Note="@ConfirmNote" Code="@ConfirmCode">
        <form method="get" action="@_path" id="project-form" data-testid="confirm-form">
            <Row Gap="3" Align="Align.Center" Wrap>
                <TextBlock As="span">Website redesign</TextBlock>
                <ConfirmButton Id="confirm-archive"
                               Title="Archive this project?"
                               Message="It moves to Archived, where you can restore it."
                               ConfirmText="Archive"
                               Accent="Accent.Neutral"
                               Variant="ButtonVariant.Outline"
                               Size="ControlSize.Sm"
                               Name="action"
                               Value="archive">Archive</ConfirmButton>
                <ConfirmButton Id="confirm-delete-project"
                               Title="Delete this project?"
                               Message="This removes the project and its history. It can't be undone."
                               ConfirmText="Delete"
                               Accent="Accent.Danger"
                               Variant="ButtonVariant.Outline"
                               Size="ControlSize.Sm"
                               StartIcon="Lucide.Trash"
                               Name="action"
                               Value="delete">Delete</ConfirmButton>
                @if (RendererInfo.IsInteractive)
                {
                    <ConfirmButton Id="confirm-csharp"
                                   Title="Reset the counter?"
                                   ConfirmText="Reset"
                                   Variant="ButtonVariant.Ghost"
                                   Size="ControlSize.Sm"
                                   OnConfirm="() => _resets++">Reset from C#</ConfirmButton>
                    <TextBlock As="span" Size="TextSize.Sm" Color="Color.Muted">Resets: <strong data-testid="resets">@_resets</strong></TextBlock>
                }
            </Row>
        </form>
    </Example>

</Stack>

@code {
    // In a C# string: some Razor compilers reject an escaped @@ inside component attribute text.
    private const string CheckableNote = "MenuRadioGroup with QueryKey makes each option a link that sets ?sort=, and the checked one comes from the URL, so it works with JavaScript off. A checkbox item takes @bind-Checked on interactive pages; on static pages its action is a link or form post, as with Compact here. MenuSub opens a submenu: click with no script; with it, hover or the right arrow, and the left arrow or Escape to go back. Choosing an item closes the whole menu.";

    private const string DrawerCode =
        """
        <DialogTrigger For="details">Details</DialogTrigger>
        <Drawer Id="details" Title="Project details" Size="DialogSize.Lg">...</Drawer>

        <Drawer Id="share" Title="Share" Placement="DialogPlacement.Bottom">...</Drawer>
        """;

    private int _resets;

    [Inject] private DialogService Dialogs { get; set; } = default!;
    private string _projectName = "Website";
    private string? _serviceResult;

    private async Task EditFromCode()
    {
        var result = await Dialogs.OpenAsync<EditNameDialog>("Edit name", new() { ["Name"] = _projectName }, new() { Size = DialogSize.Sm });
        if (!result.Canceled && result.DataAs<string>() is { } name)
        {
            _projectName = name;
        }

        _serviceResult = result.Canceled ? "Edit canceled" : $"Name: {_projectName}";
    }

    private async Task ConfirmFromCode()
    {
        var yes = await Dialogs.ConfirmAsync("Ada Lovelace loses access to this project.", "Remove member?", new() { ConfirmText = "Remove", Accent = Accent.Danger });
        _serviceResult = yes ? "Removed" : "Kept";
    }

    private string ServiceNote => RendererInfo.IsInteractive
        ? "DialogService opens a component in a dialog from code and awaits how it ends; ConfirmAsync asks yes or no. The content gets a DialogInstance to close with data or cancel; Escape, the backdrop and the close button cancel. Needs a DialogHost on the interactive page or layout."
        : "DialogService opens dialogs from code on interactive pages; see the interactive version of this page. Static pages can't open anything from code, so they use Dialog with DialogTrigger or a ?dialog= link, or ConfirmButton.";

    private const string ServiceCode =
        """
        @inject DialogService Dialogs

        var result = await Dialogs.OpenAsync<EditNameDialog>("Edit name", new() { ["Name"] = name });
        if (!result.Canceled) name = result.DataAs<string>()!;

        if (await Dialogs.ConfirmAsync("Ada loses access.", "Remove member?",
                new() { ConfirmText = "Remove", Accent = Accent.Danger })) { ... }

        @* In the dialog's component *@
        [CascadingParameter] public DialogInstance Dialog { get; set; }
        Dialog.Close(newName);   // or Dialog.Cancel()
        <DialogFooter>...buttons...</DialogFooter>
        """;

    [SupplyParameterFromForm(FormName = "rename")] public RenameModel? Rename { get; set; }
    private string? _renamed;
    private bool _renameOpen;

    // On interactive pages the dialog stays open after a submit until C# closes it.
    private void RenameSaved()
    {
        _renamed = Rename!.Name;
        _renameOpen = false;
    }

    public class RenameModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Enter a name.")]
        [System.ComponentModel.DataAnnotations.StringLength(40, MinimumLength = 3, ErrorMessage = "Use 3 to 40 characters.")]
        [System.ComponentModel.DataAnnotations.Display(Name = "Project name")]
        public string? Name { get; set; } = "Website";
    }

    private string ConfirmNote => RendererInfo.IsInteractive
        ? "Archive and Delete submit the form they're in once confirmed; Reset runs C# with OnConfirm. Cancel is focused first."
        : "The buttons sit inside a form; confirming submits it with action=archive or action=delete. Works with JavaScript off. Cancel is focused first.";

    private const string ConfirmCode =
        """
        <form method="post" @formname="project" @onsubmit="Save">
            ...
            <ConfirmButton Title="Delete this project?" Message="It can't be undone."
                           ConfirmText="Delete" Accent="Accent.Danger"
                           Name="action" Value="delete">Delete</ConfirmButton>
        </form>

        <ConfirmButton Title="Reset the counter?" OnConfirm="Reset">Reset</ConfirmButton>   @* interactive *@
        """;

    private bool _showDone = true;

    // Read from the URL as the page renders, so it follows link navigation on interactive pages too.
    private Dictionary<string, Microsoft.Extensions.Primitives.StringValues> Query => QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
    private string? Sort => Query.TryGetValue("sort", out var sort) ? sort.ToString() : null;
    private bool Compact => Query.TryGetValue("compact", out var compact) && compact == "1";
    private string CompactHref => Navigation.GetUriWithQueryParameter("compact", Compact ? null : "1");

    private const string CheckableCode =
        """
        <Menu Label="View">
            <MenuRadioGroup Label="Sort by" QueryKey="sort">      @* links: ?sort=name *@
                <MenuItem Value="name">Name</MenuItem>
                <MenuItem Value="date">Date modified</MenuItem>
            </MenuRadioGroup>
            <MenuDivider />
            <MenuItem Checked="Compact" Href="@CompactHref">Compact rows</MenuItem>
            <MenuItem @bind-Checked="showDone">Show completed</MenuItem>   @* interactive *@
        </Menu>

        <Menu Label="Actions">
            <MenuSub Label="Move to" Icon="Lucide.FolderInput">
                <MenuItem>Inbox</MenuItem>
                <MenuItem>Archive</MenuItem>
            </MenuSub>
        </Menu>
        """;

    private string _path = "";
    private string? _chosen;
    private string? _invited;
    private string? _clicked;
    private bool _pinnedOpen;
    private bool _confirmOpen;

    protected override void OnParametersSet()
    {
        Rename ??= new();
        var uri = new Uri(Navigation.Uri);
        _path = uri.AbsolutePath;
        var query = QueryHelpers.ParseQuery(uri.Query);
        _chosen = query.TryGetValue("action", out var action) ? action.ToString() : null;
        _invited = query.TryGetValue("invite", out var invite) ? invite.ToString() : null;
    }

    private const string MenuCode =
        """
        <Menu Label="Project" StartIcon="Lucide.Folder">
            <MenuItem Href="/settings" Icon="Lucide.Settings">Settings</MenuItem>
            <MenuItem Icon="Lucide.Copy" OnClick="Duplicate">Duplicate</MenuItem>
            <MenuDivider />
            <MenuGroup Label="Posts the form">
                <MenuItem Submit Name="action" Value="delete" Accent="Accent.Danger">Delete</MenuItem>
            </MenuGroup>
        </Menu>

        <Menu Placement="Placement.BottomEnd">
            <Trigger><IconButton Icon="Lucide.Ellipsis" Label="More actions" @attributes="context" /></Trigger>
            <ChildContent>...</ChildContent>
        </Menu>
        """;

    private const string PlacementCode = """<Menu Label="Top end" Placement="Placement.TopEnd">...</Menu>""";

    private const string PopoverCode =
        """
        <Popover Label="Filters" Title="Filter results">...</Popover>
        <Popover Label="Pinned note" Mode="PopoverMode.Manual" Placement="Placement.End" @bind-Open="pinned">...</Popover>
        """;

    private const string TooltipCode =
        """
        <Tooltip Text="Saved to your drafts">
            <Button>Hover me</Button>
        </Tooltip>
        """;

    private const string DialogCode =
        """
        <DialogTrigger For="confirm-delete" Accent="Accent.Danger">Delete project</DialogTrigger>
        <Button Href="?dialog=confirm-delete">Open with a link</Button>

        <Dialog Id="confirm-delete" Title="Delete this project?" Size="DialogSize.Sm" @bind-Open="confirmOpen">
            It can't be undone.
            <DialogFooter>
                <DialogClose>Cancel</DialogClose>
                <Button Submit Form="delete-form" Accent="Accent.Danger">Delete</Button>
            </DialogFooter>
        </Dialog>

        <Dialog Id="details" Title="Project details" Placement="DialogPlacement.End">...</Dialog>
        """;
}
