@using System.Reflection
@inject NavigationManager Navigation

<Stack Gap="8">

    <Example Title="Icons beside text" Note="Icons size in em and paint with currentColor, so they match the text next to them." Code="@InlineCode">
        <Stack Gap="3">
            <Row Gap="2" Align="Align.Center"><Icon Name="Tabler.Home" /><TextBlock As="span">Home</TextBlock></Row>
            <Row Gap="2" Align="Align.Center"><Icon Name="Tabler.Settings" /><TextBlock As="span" Size="TextSize.Lg">Settings, larger text</TextBlock></Row>
            <Row Gap="2" Align="Align.Center" Color="Color.Muted"><Icon Name="Tabler.Clock" /><TextBlock As="span" Size="TextSize.Sm">Muted text, muted icon</TextBlock></Row>
            <TextBlock>An icon <Icon Name="Tabler.Sparkles" Color="Color.PrimaryText" /> inside a sentence sits on the text baseline.</TextBlock>
        </Stack>
    </Example>

    <Example Title="Sizes" Code="@SizesCode">
        <Row Gap="5" Align="Align.End" Wrap>
            @foreach (var size in Enum.GetValues<IconSize>())
            {
                <Stack Gap="1" Align="Align.Center">
                    <Icon Name="Tabler.Rocket" Size="size" />
                    <TextBlock As="span" Size="TextSize.Xs" Color="Color.Muted">@size</TextBlock>
                </Stack>
            }
        </Row>
    </Example>

    <Example Title="Color, stroke width, spin" Code="@StyleCode">
        <Row Gap="5" Align="Align.Center" Wrap>
            <Icon Name="Tabler.CircleCheck" Size="IconSize.Xl" Color="Color.SuccessText" Label="Done" />
            <Icon Name="Tabler.AlertTriangle" Size="IconSize.Xl" Color="Color.WarningText" Label="Warning" />
            <Icon Name="Tabler.AlertCircle" Size="IconSize.Xl" Color="Color.DangerText" Label="Error" />
            <Icon Name="Tabler.Heart" Size="IconSize.Xl" StrokeWidth="1" />
            <Icon Name="Tabler.Heart" Size="IconSize.Xl" StrokeWidth="3" />
            <Icon Role="IconRole.Loading" Size="IconSize.Xl" Spin Label="Loading" />
        </Row>
    </Example>

    <Example Title="Semantic roles" Note="IzzyBlazor's own components ask for a role, not a specific icon, so the whole library can change icon sets in one place." Code="@RolesCode">
        <Row Gap="3" Wrap>
            @foreach (var role in Enum.GetValues<IconRole>())
            {
                <Row Gap="2" Align="Align.Center" Basis="12.Rem" Grow>
                    <Icon Role="role" />
                    <TextBlock As="span" Size="TextSize.Sm">@role</TextBlock>
                </Row>
            }
        </Row>
    </Example>

    <Example Title="Filled variants" Note="TablerFilled has solid versions of about a thousand icons, for a selected or active state: a starred item, a liked post, the current tab." Code="@FilledCode">
        <Row Gap="5" Align="Align.Center" Wrap>
            @foreach (var (name, outline, filled) in FilledPairs)
            {
                <Stack Gap="1" Align="Align.Center">
                    <Row Gap="2"><Icon Name="outline" Size="IconSize.Xl" /><Icon Name="filled" Size="IconSize.Xl" Color="Color.PrimaryText" /></Row>
                    <TextBlock Size="TextSize.Xs" Color="Color.Muted">@name</TextBlock>
                </Stack>
            }
        </Row>
    </Example>

    <Example Title="Brand logos" Note="A short list of the logos sites link to most, as outlines that match the rest of the set: from Tabler, with NuGet and .NET drawn to match. Tabler has hundreds more as Tabler.Brand*. Give a logo a Label when it stands alone, as in an icon-only link." Code="@BrandsCode">
        <Row Gap="5" Align="Align.Center" Wrap>
            @foreach (var (name, icon) in BrandIcons)
            {
                <Stack Gap="1" Align="Align.Center">
                    <Icon Name="icon" Size="IconSize.Xl" />
                    <TextBlock Size="TextSize.Xs" Color="Color.Muted">@name</TextBlock>
                </Stack>
            }
        </Row>
    </Example>

    <Example Title="Browse Tabler" Note="@($"All {Icons.Count} {(Filled ? "filled" : "outline")} icons. The search is a plain GET form, so it works on static pages with JavaScript off.")">
        <Stack Gap="4">
            <form method="get" class="host-search">
                <Row Gap="2" Align="Align.Center" Wrap>
                    <Icon Name="Tabler.Search" Color="Color.Muted" />
                    <input type="search" name="q" value="@Query" placeholder="Search icons, such as arrow or user" aria-label="Search icons" />
                    <label><input type="checkbox" name="style" value="filled" checked="@Filled" /> Filled</label>
                    <button type="submit" class="host-button">Search</button>
                </Row>
            </form>
            <TextBlock Size="TextSize.Sm" Color="Color.Muted">
                @(Matches.Count == 0 ? "No icons match." : $"Showing {Math.Min(Matches.Count, MaxShown)} of {Matches.Count}.")
            </TextBlock>
            <Row Gap="2" Wrap>
                @foreach (var (name, icon) in Matches.Take(MaxShown))
                {
                    <Stack Gap="1" Align="Align.Center" Padding="3" Radius="Radius.Md" Bg="Color.SurfaceContainer" Width="7.5.Rem" title="@icon.Name">
                        <Icon Name="icon" Size="IconSize.Xl" />
                        <TextBlock As="span" Size="TextSize.Xs" Color="Color.Muted" Truncate MaxWidth="Length.Full">@name</TextBlock>
                    </Stack>
                }
            </Row>
        </Stack>
    </Example>

</Stack>

@code {
    private static readonly (string Name, IconData Icon)[] BrandIcons =
    [
        ("GitHub", Brands.GitHub), ("GitLab", Brands.GitLab), ("YouTube", Brands.YouTube), ("X", Brands.X),
        ("Bluesky", Brands.Bluesky), ("Mastodon", Brands.Mastodon), ("Discord", Brands.Discord), ("Reddit", Brands.Reddit),
        ("Instagram", Brands.Instagram), ("Facebook", Brands.Facebook), ("NuGet", Brands.NuGet), ("Npm", Brands.Npm), ("DotNet", Brands.DotNet),
    ];

    private static readonly (string Name, IconData Outline, IconData Filled)[] FilledPairs =
    [
        ("Star", Tabler.Star, TablerFilled.Star), ("Heart", Tabler.Heart, TablerFilled.Heart), ("Bell", Tabler.Bell, TablerFilled.Bell),
        ("Bookmark", Tabler.Bookmark, TablerFilled.Bookmark), ("Home", Tabler.Home, TablerFilled.Home), ("CircleCheck", Tabler.CircleCheck, TablerFilled.CircleCheck),
    ];

    private const string FilledCode =
        """
        <Icon Name="@(starred ? TablerFilled.Star : Tabler.Star)" Label="Starred" />
        """;

    private const string BrandsCode =
        """
        <IconButton Icon="Brands.GitHub" Label="GitHub" Href="https://github.com/..." />
        <Icon Name="Brands.YouTube" Label="YouTube" />
        """;

    private const int MaxShown = 120;

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "style")] public string? Style { get; set; }

    private bool Filled => string.Equals(Style, "filled", StringComparison.OrdinalIgnoreCase);

    private static IReadOnlyList<(string Name, IconData Icon)> Load(Type set) =>
        set.GetProperties(BindingFlags.Public | BindingFlags.Static)
            .Where(p => p.PropertyType == typeof(IconData))
            .Select(p => (p.Name, (IconData)p.GetValue(null)!))
            .ToList();

    private static readonly IReadOnlyList<(string Name, IconData Icon)> OutlineIcons = Load(typeof(Tabler));
    private static readonly IReadOnlyList<(string Name, IconData Icon)> FilledIcons = Load(typeof(TablerFilled));

    private IReadOnlyList<(string Name, IconData Icon)> Icons => Filled ? FilledIcons : OutlineIcons;

    private IReadOnlyList<(string Name, IconData Icon)> Matches = [];

    protected override void OnParametersSet()
    {
        var q = Query?.Trim();
        Matches = string.IsNullOrEmpty(q)
            ? Icons
            : Icons.Where(i => i.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                               || i.Icon.Name.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private const string InlineCode =
        """
        <Row Gap="2" Align="Align.Center">
            <Icon Name="Tabler.Home" />
            <TextBlock As="span">Home</TextBlock>
        </Row>
        """;

    private const string SizesCode = """<Icon Name="Tabler.Rocket" Size="IconSize.Xl" />""";

    private const string StyleCode =
        """
        <Icon Name="Tabler.CircleCheck" Color="Color.SuccessText" Label="Done" />
        <Icon Name="Tabler.Heart" StrokeWidth="1" />
        <Icon Role="IconRole.Loading" Spin Label="Loading" />
        """;

    private const string RolesCode =
        """
        <Icon Role="IconRole.Close" />      @* resolves through IconSet.Current *@
        """;
}
