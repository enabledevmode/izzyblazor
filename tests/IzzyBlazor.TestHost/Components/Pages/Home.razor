@page "/"

<PageTitle>IzzyBlazor dev host</PageTitle>

<Stack Gap="6" MaxWidth="Length.Prose">
    <h1 class="host-title">IzzyBlazor dev host</h1>

    <p>
        Full-page previews built only from IzzyBlazor components: realistic screens for judging the
        shell variants and layering, and the README's screenshot. Component examples are on the docs
        site (<code>site/IzzyBlazor.Site</code>, <code>npm run dev</code>).
    </p>

    <Stack Gap="2">
        <h2 class="host-subtitle">Previews</h2>
        <ul class="host-list">
            @foreach (var (href, title, note) in Previews)
            {
                <li><Anchor Href="@href">@title</Anchor>: @note</li>
            }
        </ul>
    </Stack>

    <Stack Gap="2">
        <h2 class="host-subtitle">Shell variants</h2>
        <p>The layout previews take <code>?variant=tinted</code>, <code>inset</code>, <code>flat</code> or <code>canvas</code>.</p>
    </Stack>
</Stack>

@code {
    internal static readonly (string Href, string Title, string Note)[] Previews =
    [
        ("preview/showcase", "Showcase", "the README screenshot, at 1280×860 with a device scale factor of 2, in light and dark"),
        ("preview/app-shell", "App shell", "a full-page AppShell, static"),
        ("preview/app-shell-live", "App shell, interactive", "a collapsible sidebar bound to C#"),
        ("preview/layout/settings", "Settings", "forms in sections"),
        ("preview/layout/list", "List", "a full-width table"),
        ("preview/layout/dashboard", "Dashboard", "stats and panels"),
        ("preview/layout/document", "Document", "long-form reading"),
        ("preview/layout/marketing", "Marketing site", "no sidebar, a hero, full-bleed bands"),
    ];
}
