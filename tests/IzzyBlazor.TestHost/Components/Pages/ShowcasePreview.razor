@page "/preview/showcase"
@page "/preview/showcase/{*Rest}"
@layout BareLayout

@*
    A small but realistic screen built only from IzzyBlazor components, for the README
    screenshots. Static SSR: sorting, paging and filtering all go through the URL.
*@

<PageTitle>Orders · Acme</PageTitle>

<AppShell Dividers="true">
    <AppHeader>
        <SidebarToggle />
        <Row Gap="2" Align="Align.Center">
            <Icon Name="Lucide.Zap" Color="Color.PrimaryText" Size="IconSize.Lg" />
            <TextBlock As="span" Weight="FontWeight.Bold">Acme</TextBlock>
        </Row>
        <Box Grow />
        <NavMenu Orientation="Orientation.Horizontal" VisibleFrom="Breakpoint.Lg">
            <NavItem Href="preview/showcase/docs">Docs</NavItem>
            <NavItem Href="preview/showcase/support">Support</NavItem>
        </NavMenu>
        <IconButton Icon="Lucide.Bell" Label="Notifications" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral" />
        <Menu Label="Izzy" Placement="Placement.BottomEnd" Variant="ButtonVariant.Ghost" Accent="Accent.Neutral">
            <MenuItem Href="preview/showcase/profile" Icon="Lucide.User">Profile</MenuItem>
            <MenuItem Href="preview/showcase/settings" Icon="Lucide.Settings">Settings</MenuItem>
            <MenuDivider />
            <MenuItem Href="preview/showcase" Icon="Lucide.LogOut">Sign out</MenuItem>
        </Menu>
    </AppHeader>

    <AppSidebar Collapsible="true">
        <NavMenu>
            <NavItem Href="preview/showcase/home" Icon="Lucide.LayoutDashboard">Overview</NavItem>
            <NavItem Href="preview/showcase" Icon="Lucide.ShoppingCart" Match="NavLinkMatch.All" Badge="12" BadgeColor="Color.Primary">Orders</NavItem>
            <NavItem Href="preview/showcase/customers" Icon="Lucide.Users">Customers</NavItem>
            <NavGroup Label="Catalog" Icon="Lucide.Package" ActivePrefix="preview/showcase/catalog">
                <NavItem Href="preview/showcase/catalog/products">Products</NavItem>
                <NavItem Href="preview/showcase/catalog/collections">Collections</NavItem>
            </NavGroup>
            <NavItem Href="preview/showcase/reports" Icon="Lucide.ChartColumn">Reports</NavItem>
            <NavDivider />
            <NavLabel>Workspace</NavLabel>
            <NavItem Href="preview/showcase/team" Icon="Lucide.UsersRound">Team</NavItem>
            <NavItem Href="preview/showcase/billing" Icon="Lucide.CreditCard" Badge="New" BadgeStatus="Status.Success">Billing</NavItem>
        </NavMenu>
    </AppSidebar>

    <AppMain>
        <Stack Gap="6" Padding="new() { Base = 4, Md = 8 }">
            <Row Gap="3" Align="Align.Center" Wrap>
                <Stack Gap="1" Grow>
                    <Heading Level="1" Size="TextSize.Xl2">Orders</Heading>
                    <TextBlock Color="Color.Muted" Size="TextSize.Sm">Every order across your stores, newest first.</TextBlock>
                </Stack>
                <LinkButton Href="preview/showcase/export" StartIcon="Lucide.Download" Variant="ButtonVariant.Outline" Accent="Accent.Neutral">Export</LinkButton>
                <Button StartIcon="Lucide.Plus">New order</Button>
            </Row>

            <Grid Columns="new() { Base = 1, Sm = 3 }" Gap="4">
                @foreach (var (label, value, change, up) in Stats)
                {
                    <Card>
                        <Stack Gap="1">
                            <TextBlock Size="TextSize.Sm" Color="Color.Muted">@label</TextBlock>
                            <Row Gap="2" Align="Align.Center">
                                <TextBlock Size="TextSize.Xl2" Weight="FontWeight.Semibold" TabularNums="true">@value</TextBlock>
                                <Badge Status="@(up ? Status.Success : Status.Danger)">@change</Badge>
                            </Row>
                        </Stack>
                    </Card>
                }
            </Grid>

            <Stack Gap="3">
                <FilterForm Label="Filter orders" id="showcase-filters">
                    <FilterSearch Placeholder="Search customers" />
                    <FilterSelect Name="status" Label="Status" Items="Statuses" />
                    <FilterCheckbox Name="large" Label="Over $300" />
                </FilterForm>
                <Table Items="Filtered" PageSize="8" InitialSort="-date" Caption="Orders" EmptyText="No orders match" id="showcase-orders">
                    <PropertyColumn Property="o => o.Number" Title="Order" />
                    <PropertyColumn Property="o => o.Customer" Sortable />
                    <PropertyColumn Property="o => o.Date" Format="MMM d, yyyy" Sortable />
                    <TemplateColumn Title="Status" SortBy="o => o.Status" SortKey="status" Sortable>
                        <Badge Status="StatusOf(context.Status)" Dot>@context.Status</Badge>
                    </TemplateColumn>
                    <PropertyColumn Property="o => o.Total" Format="C" Sortable />
                </Table>
            </Stack>
        </Stack>
    </AppMain>
</AppShell>

@code {
    [Parameter] public string? Rest { get; set; }

    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "status")] public string? StatusFilter { get; set; }
    [SupplyParameterFromQuery(Name = "large")] public bool Large { get; set; }

    private sealed record Order(string Number, string Customer, DateOnly Date, string Status, decimal Total);

    private static readonly string[] Customers = ["Ada Lovelace", "Grace Hopper", "Alan Turing", "Katherine Johnson", "Linus Torvalds", "Margaret Hamilton", "Dennis Ritchie", "Barbara Liskov"];
    private static readonly string[] Statuses = ["Paid", "Pending", "Refunded", "Failed"];

    private static readonly IReadOnlyList<Order> Orders = Enumerable.Range(1, 57)
        .Select(i => new Order($"#{1000 + i}", Customers[i * 7 % Customers.Length], new DateOnly(2026, 1, 1).AddDays(i * 5 % 280), Statuses[i * 3 % 7 % Statuses.Length], Math.Round(19.5m + i * 37.25m % 480m, 2)))
        .ToList();

    private static readonly (string Label, string Value, string Change, bool Up)[] Stats =
    [
        ("Revenue", "$18,420", "+12%", true),
        ("Orders", "57", "+8%", true),
        ("Refund rate", "2.1%", "+0.4%", false),
    ];

    private IEnumerable<Order> Filtered => Orders
        .Where(o => string.IsNullOrWhiteSpace(Search) || o.Customer.Contains(Search, StringComparison.OrdinalIgnoreCase))
        .Where(o => string.IsNullOrEmpty(StatusFilter) || o.Status == StatusFilter)
        .Where(o => !Large || o.Total > 300);

    private static Status StatusOf(string status) => status switch
    {
        "Paid" => Status.Success,
        "Pending" => Status.Warning,
        "Failed" => Status.Danger,
        _ => Status.Neutral,
    };
}
