@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

@* The dev host's chrome, built with AppShell and NavMenu. It renders statically. *@

<AppShell>
    @* A real Banner in the shell's top row, sticky above the header. Not remembered, so it comes
       back on the next page. *@
    <Banner Title="Alpha:" Dismissible Position="BarPosition.Sticky">
        <ChildContent>IzzyBlazor is in alpha; component APIs may change before 1.0.</ChildContent>
        <Actions><Anchor Href="static/alerts">Banner demos</Anchor></Actions>
    </Banner>
    <AppHeader>
        <SidebarToggle />
        <a href="/" class="host-brand">IzzyBlazor <span>dev host</span></a>
        <Box Grow />
        @if (_counterpart is not null)
        {
            <Tabs Label="Render mode" Variant="TabsVariant.Segmented" Class="host-mode">
                <TabLink Href="@_staticUrl" Label="Static" />
                <TabLink Href="@_interactiveUrl" Label="Interactive" />
            </Tabs>
        }
        <Row Inline Gap="2" Align="Align.Center" VisibleFrom="Breakpoint.Md" Class="host-sets">
            <span class="host-select-wrap"><select class="host-select" data-host-set="preset" aria-label="Preset">
                <option value="">Standard</option><option value="compact">Compact</option><option value="soft">Soft</option><option value="editorial">Editorial</option>
            </select></span>
            <span class="host-select-wrap"><select class="host-select" data-host-set="brand" aria-label="Brand">
                <option value="">Preset's brand</option><option value="blue">Blue</option><option value="ink">Ink</option><option value="indigo">Indigo</option><option value="violet">Violet</option>
                <option value="teal">Teal</option><option value="green">Green</option><option value="rose">Rose</option>
            </select></span>
        </Row>
        <ColorSchemeSwitch VisibleFrom="Breakpoint.Sm" />
    </AppHeader>

    <AppSidebar>
        <NavMenu aria-label="Components">
            <NavItem Href="/" Icon="Hugeicons.Home03" Match="NavLinkMatch.All">Overview</NavItem>
            @foreach (var group in DemoCatalog.All.GroupBy(d => d.Group))
            {
                <NavLabel>@group.Key</NavLabel>
                @foreach (var demo in group)
                {
                    <NavItem Href="@($"{(_isStatic ? "static" : "interactive")}/{demo.Slug}")">@demo.Title</NavItem>
                }
            }
        </NavMenu>
    </AppSidebar>

    <AppMain>
        <Box Padding="new() { Base = 4, Md = 8 }" MaxWidth="72.Rem">
            @Body
        </Box>
    </AppMain>
</AppShell>

<ToastRegion />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isStatic = true;
    private string? _counterpart;
    private string? _staticUrl;
    private string? _interactiveUrl;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Update();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Update();
        StateHasChanged();
    }

    private void Update()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        var parts = path.Split('/', 2);
        _counterpart = null;

        if (parts.Length == 2 && parts[0] is "static" or "interactive")
        {
            _isStatic = parts[0] == "static";
            _counterpart = parts[1];
            _staticUrl = $"static/{parts[1]}";
            _interactiveUrl = $"interactive/{parts[1]}";
        }
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
